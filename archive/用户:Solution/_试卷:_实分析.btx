\section{21--22春 期末B卷(沈维孝)}

\subsection{原卷}
\begin{itemize}
\item[一、](20分)

设 $E$ 是 $\mathbb{R}$ 的有界子集, 满足
$$
m^*(E)=\sup \left\{m^*(F): F \subset E, F \text { 是 } \mathbb{R} \text { 的闭子集}\right\},
$$

其中 $m^*$ 表示Lebesgue外测度. 证明 $E$ 是Lebesgue可测集.

\item[二、](20分)

设$ f\colon\mathbb{R} \to \mathbb{R}  $是Lebesgue可积函数,求极限
$$
\lim_{n\rightarrow \infty}n\int_{\frac{1}{n^2}}^{n^2}{f( nx ) \text{e}^{-x}\text{d}x}.
$$

\item[三、](20分)

设$ f_{n}\colon\mathbb{R} \to \mathbb{R}  $是Lebesgue可测函数,
几乎处处收敛到$ f\colon\mathbb{R} \to \mathbb{R} $且满足
$$\int_{\mathbb{R}}{|f_n(x)|^3\log (|x|+2)\,\text{d}x}<10,$$
$$\int_{\mathbb{R}}{|f_n(x)|\,\text{d}x}<10.$$

证明$ f_{n} $依$ L^{2} $收敛到$ f $.

注:原题的$ \log $中是$ 1 $不是$ 2 $,这样就是错题,反例可考虑$ f_{n}=\sqrt{n}\chi_{(0,1/n)} $.

\item[四、](20分)

设$ f\colon[0,1]\to [0,1] $，定义$ f(0)=0 $，
当$ 0<x\le 1 $时，设正整数$ n $使得$ 1/(n+1)<x\le 1/n $,则定义$ f(x)=1/x-n $.

设$ \mu $是$ [0,1] $上的概率测度,即对$ [0,1] $任意Borel子集$ E $，定义
$$\mu(E) =\frac{1}{\log 2}\int_E\frac{1}{1+x}\,\text{d}x.$$

对任意$ \varphi\colon[0,1]\to \mathbb{R}  $是连续函数，证明
$$\int_0^1{\varphi \circ f(x) \,\text{d}\mu(x)}
=\int_0^1{\varphi (x) \,\text{d}\mu(x)}.$$

\item[五、](20分)

Let $ f\colon\mathbb{R} \to \mathbb{R}  $ be Lebesgue integrable. 
Then for $ x\in \mathbb{R}  $ a.e. the series converges:
$$
\sum_{n=1}^{\infty}{\frac{1}{\sqrt{n}}f( x-\sqrt{n} )}.
$$

\end{itemize}

\subsection{带答案}
\begin{itemize}
\item[一、](20分)

设 $E$ 是 $\mathbb{R}$ 的有界子集, 满足
$$
m^*(E)=\sup \left\{m^*(F): F \subset E, F \text { 是 } \mathbb{R} \text { 的闭子集}\right\},
$$

其中 $m^*$ 表示Lebesgue外测度. 证明 $E$ 是Lebesgue可测集.
\begin{proof}
对任意 $n=1,2, \ldots$, 存在 $\mathbb{R}$ 的闭子集 $F_n$, 满足 $F_n \subset E$,
$$
m^*(E) \leq m^*(F_n)+\frac{1}{n}.
$$

令 $F=\bigcup_{n=1}^{\infty} F_n$. 则 $F$ 是Lebesgue可测集. 由于 $m^*(E) \leq m(F)+1 / n$ 对 任意 $n=1,2, \ldots$ 成立, 从而 $m^*(E) \leq m(F)$. 另一方面, $F \subset E$, 从 而 $m(F) \leq m^*(E)$. 因此 $m^*(E)=m(F)$.

设 $U$ 是满足 $U \supset E, m(U)=m^*(E)$ 的可测集.则有
$$
m^*(F)+m^*(U \backslash F)=m(U) = m^*(E)
$$
故
$
m(U \backslash F)=0
$
从而 $m^*(E \backslash F)=0$. 因此 $E \backslash F$ 是可测集, 从而
$
E=F \cap(E \backslash F)
$
也是可测集。

事实上,此即Lebesgue内测度等于外测度.它与Carathéodory条件是等价的.
\end{proof}

\item[二、](20分)

设$ f\colon\mathbb{R} \to \mathbb{R}  $是Lebesgue可积函数,求极限
$$
\lim_{n\rightarrow \infty}n\int_{\frac{1}{n^2}}^{n^2}{f( nx ) \text{e}^{-x}\text{d}x}.
$$

\begin{proof}
易见
$$
I_n=\int_{\frac{1}{n}}^{n^3}{f( y ) \text{e}^{-\frac{y}{n}}\text{d}y}=\int_{\mathbb{R}}{g_n}.
$$

其中$ g_{n}=f( y ) \text{e}^{-y/n}\chi_{[1/n,n^{3}]} $,可见$ x>0 $时, $ g_{n}\to f $,而$ x\le 0 $时, $ g_{n}=0 $.

考虑Lebesgue控制收敛定理，以及$ |g_{n}|\le f $，可知极限即为
$$
\lim_{n\rightarrow \infty}\int_{\mathbb{R}}^{}{g_n}=\int_0^{\infty}{f( x ) \text{d}x}.\qedhere
$$
\end{proof}

\item[三、](20分)

设$ f_{n}\colon\mathbb{R} \to \mathbb{R}  $是Lebesgue可测函数,
几乎处处收敛到$ f\colon\mathbb{R} \to \mathbb{R} $且满足
$$\int_{\mathbb{R}}{|f_n(x)|^3\log(|x|+2)\,\text{d}x}<10,$$
$$\int_{\mathbb{R}}{|f_n(x)|\,\text{d}x}<10.$$

证明$ f_{n} $依$ L^{2} $收敛到$ f $.

注:原题的$ \log $中是$ 1 $不是$ 2 $,这样就是错题,反例可考虑$ f_{n}=\sqrt{n}\chi_{(0,1/n)} $.


\item[四、](20分)

设$ f\colon[0,1]\to [0,1] $，定义$ f(0)=0 $，
当$ 0<x\le 1 $时，设正整数$ n $使得$ 1/(n+1)<x\le 1/n $,则定义$ f(x)=1/x-n $.

设$ \mu $是$ [0,1] $上的概率测度,即对$ [0,1] $任意Borel子集$ E $，定义
$$\mu(E) =\frac{1}{\log 2}\int_E\frac{1}{1+x}\,\text{d}x.$$

对任意$ \varphi\colon[0,1]\to \mathbb{R}  $是连续函数，证明
$$\int_0^1{\varphi \circ f(x) \,\text{d}\mu(x)}
=\int_0^1{\varphi (x) \,\text{d}\mu(x)}.$$

\begin{proof}
因为$ \varphi $可以被阶梯函数一致逼近,不妨就设它是$ \chi_{(a,b)} $,其中$ 0\le a<b\le 1 $.
右边即为
$$\int_0^1{\varphi (x) \,\text{d}\mu(x)}
=\frac{1}{\log 2}\int_a^b{\frac{\text{d}x}{1+x}}
=\frac{1}{\log 2}\log \frac{1+b}{1+a}.$$

而左边
$$I=\int_0^1{\varphi \circ f(x) \,\text{d}\mu(x)}
=\frac{1}{\log 2}\int_E\frac{\text{d}x}{1+x}
=\frac{1}{\log 2}\sum_{n=1}^{\infty}\int_{E_n}\frac{\text{d}x}{1+x},$$

其中
$$E=\{x\in (0,1) \mid a<f(x)<b\} =\bigcup_{n=1}^{\infty}{E_n},$$
$$E_n=\left\{ x\in \left( \frac{1}{n+1},\frac{1}{n} \right) \biggm| a<\frac{1}{x}-n<b \right\} 
=\left( \frac{1}{n+b},\frac{1}{n+a} \right).$$

最终有
\begin{align*}
I&=\frac{1}{\log 2}\sum_{n=1}^{\infty}\int_{\frac{1}{n+b}}^{\frac{1}{n+a}}\frac{\text{d}x}{1+x}
=\frac{1}{\log 2}\sum_{n=1}^{\infty}\log\frac{1+\frac{1}{n+a}}{1+\frac{1}{n+b}}\\
&=\frac{1}{\log 2}\sum_{n=1}^{\infty}\left[\log\frac{n+b}{n+a}-\log\frac{n+1+b}{n+1+a}\right]
=\frac{1}{\log 2}\log\frac{1+b}{1+a}.
\end{align*}
\end{proof}

\item[五、](20分)

Let $ f\colon\mathbb{R} \to \mathbb{R}  $ be Lebesgue integrable. 
Then for $ x\in \mathbb{R}  $ a.e. the series converges:
$$
\sum_{n=1}^{\infty}{\frac{1}{\sqrt{n}}f( x-\sqrt{n} )}.
$$

\begin{proof}
	We prove that for any $ a<b $, the series is integrable on $ [a,b] $. Observe that
	$$
	\int_a^b{\sum_{n=1}^{\infty}{\frac{1}{\sqrt{n}}f( x-\sqrt{n} )}\mathrm{d} x}=\sum_{n=1}^{\infty}{\frac{1}{\sqrt{n}}\int_a^b{f( x-\sqrt{n} ) \mathrm{d} x}}
	$$
	$$
	=\sum_{n=1}^{\infty}{\frac{1}{\sqrt{n}}\int_{\mathbb{R}}^{}{f( x ) \chi _{\left[ a-\sqrt{n},b+\sqrt{n} \right]}\mathrm{d} x}=\int_{\mathbb{R}}^{}{f( x ) S( x ) \mathrm{d} x}},
	$$
	
	where we denote
    \[S( x ) =\sum_{n=1}^{\infty}{\frac{1}{\sqrt{n}}\chi _{\left[ a-\sqrt{n},b-\sqrt{n} \right]}}.\] 
    We claim that $ S(x) $ is bounded by $ C=C(a,b) $ independent of $ x $:
	
	For any $ x\in \mathbb{R}  $, the sum is taken over those $ n $ with $ a-\sqrt{n}\le x\le b-\sqrt{n} $, namely:
    $$
	S( x ) =\sum_{a-x\le \sqrt{n}\le b-x}^{}{\frac{1}{\sqrt{n}}}.
	$$
	
	If $ a-x\le 1 $, we have
	\begin{align*}
	S( x ) &=\sum_{1\le n\le \left( b-x \right) ^2}{\frac{1}{\sqrt{n}}}
    \le \int_0^{( b-x ) ^2}{\frac{\mathrm{d} t}{\sqrt{t}}}\\
    &=2( b-x ) \le 2( b-a+1 ) 
	\end{align*}
	
	If $ a-x>1 $, we have
	\begin{align*}
	S( x ) &=\sum_{( a-x ) ^2\le n\le ( b-x ) ^2}^{}{\frac{1}{\sqrt{n}}}
    \le \int_{( a-x ) ^2-1}^{( b-x ) ^2}{\frac{\mathrm{d} t}{\sqrt{t}}}\\
	&=2\left( ( b-x ) -\sqrt{( a-x ) ^2-1} \right) \le 2( b-a+1 ) 
	\end{align*}
	
	The last inequality by the monotonicity.
\end{proof}
\end{itemize}

\section{18--19春 B卷(沈维孝)}

\subsection{原卷}
\begin{itemize}
\item[一、](20分)判断正误。以下论断正确的在前面的括号中填T,错误的填F:

1. 设 $\mathcal{Z}$ 是整数集 $\mathbb{Z}$ 的全体子集构成的集合.则存在从 $\mathbb{R}$ 到 $\mathcal{Z}$ 上的 一一映射.

2. $\mathbb{R}$ 的紧子集全体构成的集合是不可数集.

3. $\mathbb{R}$ 的不可数闭子集中必然有一个有理数.

4. 若 $E$ 是 $\mathbb{R}$ 的Lebesgue不可测子集,则 $E$ 的外测度必大于零.

5. 若 $f: \mathbb{R} \rightarrow \mathbb{R}$ 是Lebesgue可测函数, $g: \mathbb{R} \rightarrow \mathbb{R}$ 是连续的一一 映射, 则 $g \circ f$ 是Lebesgue 可测的.

6. 设 $f:[0,1] \rightarrow \mathbb{R}$ 是几乎处处可微的函数, $E \subset \mathbb{R}$ 是Lebesgue零测集,那么 $f(E)$ 也是Lebesgue零测集.

7. 若 $f_n: \mathbb{R} \rightarrow \mathbb{R}, n=1,2, \ldots$ 是一列Lebesgue可测函数, 满 足 $\lim _{n \rightarrow \infty} \int_{\mathbb{R}}\left|f_n(x)-f(x)\right| d x=0$. 那么存在 $n_k \rightarrow \infty$ 使得 $f_{n_k}$ 几 乎处处收敛到 $f$.

8. 设 $f:[0,1] \rightarrow \mathbb{R}$ 是有界函数. 则 $f$ 黎曼可积的 充分必要条件是 $f^{2}$ 黎曼可积.

9. 设 $E_1, E_2$ 是 $\mathbb{R}$ 的非Borel子集. 则 $E_1 \times E_2$ 必不是 $\mathbb{R}^2$ 的Borel子集.

10. 若 $f: \mathbb{R} \rightarrow \mathbb{R}$ 是Lebesgue可测函数, 则存在 $x_0 \in \mathbb{R}$, 使得对任 意 $\delta>0$,
$$
\lim_{r \rightarrow 0} \frac{m(\left\{x \in\left(x_0-r, x_0+r\right):\left|f(x)-f(x_0)\right|>\delta\right\})}{2r}=0.
$$

\item[二、](15分)

1.对任意$ x\in\left(0,1\right] $，设$ x=0.x_{1}x_{2}\cdots $是$ x $的无穷十进制表示，
定义$ f(x)=\max\limits_n x_{n} $,证明$ f(x) $在$ \left(0,1\right] $上Borel可测.

2.对$ k=0,1,\cdots,9 $,求$ f^{-1}(k) $的测度.

\item[三、](15分)

1.叙述Lebesgue控制收敛定理.

2.求极限
$$
\lim_{n\rightarrow \infty}\int_0^{n^2}{\frac{x^{1/n}\cos x}{1+x^n}\text{d}x}.
$$

\item[四、](15分)

对 $f \in C^1(\mathbb{R})$ 以及 $t>0$, 定义
$$I_t(f)=\frac{1}{t^2} \int_{\mathbb{R}}|f(x+t)-f(x)|^2 \text{d} x.$$
证明:
$$\lim_{t \rightarrow 0} I_t(f)=\int_{\mathbb{R}}|f^{\prime}(x)|^2 \text{d} x.$$


\item[五、](15分)

设$ f\colon \mathbb{R} \to \mathbb{R}  $是Lebesgue可测函数,满足如下性质:
对任意$\varphi\in \mathcal{L}^{2}(\mathbb{R})$,
都成立$f\varphi\in \mathcal{L}^{1}(\mathbb{R})$.
证明: $f\in \mathcal{L}^{2}(\mathbb{R})$.

\item[六、](20分)

Let $ A=(a_{ij})_{1\le i,j\le n} $ be an $ n$-order real square symmetric matrix, and define
$$ f( x_1,x_2,\cdots ,x_n ) =\exp \left( -\sum_{j,k=1}^n{x_{jk}a_ja_k} \right)  $$
\begin{enumerate}
\item Prove that $ f\in L^{1}(\mathbb{R} ^{n}) $ iff $ A $ is positive definite.
\item Assuming $ A $ is positive definite, compute $ \int_{\mathbb{R} ^{n}}f(x)dx $.
\end{enumerate}

\end{itemize}

\subsection{带答案}
\begin{itemize}
\item[一、](20分)判断正误。以下论断正确的在前面的括号中填T,错误的填F:

1. (T) 设 $\mathcal{Z}$ 是整数集 $\mathbb{Z}$ 的全体子集构成的集合.
则存在从 $\mathbb{R}$ 到 $\mathcal{Z}$ 上的 一一映射.

\begin{proof}[解答]
易见$ \mathcal{Z}  $的势是$ 2^{\aleph_{0}}=\aleph $.
\end{proof}

2. (T) $\mathbb{R}$ 的紧子集全体构成的集合是不可数集.

\begin{proof}[解答]
易见每一无理数都是一个紧子集.
\end{proof}

3. (F) $\mathbb{R}$ 的不可数闭子集中必然有一个有理数.

\begin{proof}[解答]
设$ r_{n} $是有理数的排布.又$ \mathbb{R} \backslash \bigcup_{n=1}^{\infty}(r_{n}-1/2^{n},r_{n}+1/2^{n}) $是闭集,不可数,不含有理数.
\end{proof}

4. (T) 若 $E$ 是 $\mathbb{R}$ 的Lebesgue不可测子集,则 $E$ 的外测度必大于零.

\begin{proof}[解答]
如果$ m^{*}(E)=0 $,我们将证明$ E $符合Carathéodory条件,从而Lebesgue可测.对任意测试集$ T $,有$ m^{*}(T\cap E)\le m^{*}(E)=0 $,此外$ m^{*}(T\cap E^{c})\le m^{*}(T) $,相加有$ m^{*}(T\cap E)+m^{*}(T\cap E^{c})\le m^{*}(T)  $,证完.
\end{proof}

5. (T) 若 $f: \mathbb{R} \rightarrow \mathbb{R}$ 是Lebesgue可测函数, $g: \mathbb{R} \rightarrow \mathbb{R}$ 是连续的一一 映射, 则 $g \circ f$ 是Lebesgue 可测函数.

\begin{proof}[解答]
对开集$U$，$g^{-1}(U)$是开集，则$(g\circ f)^{-1}(U)=f^{-1}(g^{-1}(U))$可测。

因$ f $可测, $ f $有简单函数逼近$ \varphi_{k} $,使
%$ 0\le |\varphi_{k}|\le |\varphi_{k+1}| $2
$ \varphi_{k}\to f $.由此$ g(f(x))=g(\lim \varphi_{k}(x))=\lim g(\varphi_{k}(x)) $.现在将$ \varphi $写为特征函数形式$ \varphi_{k}=\sum c\chi $,则有$ g(f(x))=\lim \sum g(c)\chi $.这是简单函数之极限,仍可测.
\end{proof}

6. (F) 设 $f:[0,1] \rightarrow \mathbb{R}$ 是几乎处处可微的函数, $E \subset \mathbb{R}$ 是Lebesgue零测集,那么 $f(E)$ 也是Lebesgue零测集.

\begin{proof}[解答]
考虑Devil阶梯函数,将Cantor集映到$ [0,1] $.它单调,自然几乎处处可微,但Cantor集零测, $[0,1]$不是零测的.
\end{proof}

7. (T) 若 $f_n: \mathbb{R} \rightarrow \mathbb{R}, n=1,2, \ldots$ 是一列Lebesgue可测函数, 满 足 $\lim _{n \rightarrow \infty} \int_{\mathbb{R}}\left|f_n(x)-f(x)\right| d x=0$. 那么存在 $n_k \rightarrow \infty$ 使得 $f_{n_k}$ 几 乎处处收敛到 $f$.

\begin{proof}[解答]
$ L^{1} $收敛蕴含依测度收敛,而依测度收敛又蕴含了几乎处处收敛的子列.
\end{proof}

8. (F) 设 $f:[0,1] \rightarrow \mathbb{R}$ 是有界函数. 
则 $f$ 黎曼可积的 充分必要条件是 $f^{2}$ 黎曼可积.
\begin{proof}[解答]
考虑Dirichlet函数与$ 1/2 $之差,则其不黎曼可积,但其平方黎曼可积.
\end{proof}

9. (T) 设 $E_1, E_2$ 是 $\mathbb{R}$ 的非Borel子集. 则 $E_1 \times E_2$ 必不是 $\mathbb{R}^2$ 的Borel子集.

\begin{proof}[解答]
若$ E_{1}\times E_{2} $是Borel集,其任一投影也是Borel集,从而$ E_{1},E_{2} $是Borel集,矛盾.
\end{proof}

10. (T) 若 $f: \mathbb{R} \rightarrow \mathbb{R}$ 是Lebesgue可测函数, 则存在 $x_0 \in \mathbb{R}$, 使得对任 意 $\delta>0$,
$$
\lim_{r \rightarrow 0} \frac{m(\left\{x \in\left(x_0-r, x_0+r\right):\left|f(x)-f(x_0)\right|>\delta\right\})}{2r}=0.
$$

\begin{proof}[解答]
%变形为$$
%\lim _{r \rightarrow 0} \frac{m(\left\{x \in\left(x_0-r, x_0+r\right):\left|f(x)-f\left(x_0\right)\right|\le\delta\right\})}{2 r}=1
%$$
%
%考虑Lebesgue密度点之类的.
题中的$ x_{0} $即为$ f $的一个几乎连续点.事实上有结论:可测函数是几乎连续a.e.的.如此$ x_{0} $不仅存在,而且a.e.都满足.
\end{proof}

\item[二、](15分)

1.对任意$ x\in\left(0,1\right] $，设$ x=0.x_{1}x_{2}\cdots $是$ x $的无穷十进制表示，
定义$ f(x)=\max\limits_n x_{n} $,证明$ f(x) $在$ \left(0,1\right] $上Borel可测.

2.对$ k=0,1,\cdots,9 $,求$ f^{-1}(k) $的测度.

\begin{proof}
1.考虑$ f_{n}(x)=x_{n} $,则$ f(x)=\sup f_{n}(x) $.
只需证明$ f_{n} $是Borel可测的,就有$ f $也是Borel可测的.

注意到$ f_{n}(x)=[10^{n}x]-10[10^{n-1}x] $是简单函数,自然可测,证完.

2.对任意$ x\in f^{-1}(9) $, $ x $的十进制展开含有$ 9 $,
即$ f^{-1}(9)=\bigcup_{n=1}^{\infty}A_{n} $,
其中$ A_{n} $即第$ n $位是$ 9 $,而前$ n-1 $位不是$ 9 $的数构成的集合.
易见这是个无交并,又$ m(A_{n})=9^{n-1}10^{-n} $,可得$ m(f^{-1}(9))=1 $.
从而$ k\le 8 $时其测度为$ 0 $.
\end{proof}

\item[三、](15分)

1.叙述Lebesgue控制收敛定理.

2.求极限
$$
\lim_{n\rightarrow \infty}\int_0^{n^2}{\frac{x^{1/n}\cos x}{1+x^n}\text{d}x}.
$$

\begin{proof}
1.略

2.对$$
f_n( x ) =\frac{x^{1/n}\cos x}{1+x^n}\chi _{\left[ 0,n^2 \right]},
$$

其极限函数为
$$
f( x ) =\left\{ \begin{array}{ll}
	0, & x\le 0 \text{ or } x>1\\
	\cos x,&0<x<1\\
	\frac{\cos 1}{2}, & x=1\\
\end{array} \right. .
$$

考虑控制函数
$$
g( x ) =\left\{ \begin{array}{ll}
	0,&x\le 0\\
	1,&0<x<1\\
	\frac{\sqrt{x}}{1+x^2},&x\ge 1\\
\end{array} \right. ,
$$

因此可以直接换序算得
$$
\lim_{n\rightarrow \infty}\int_0^{n^2}{\frac{x^{1/n}\cos x}{1+x^n}\text{d}x}
=\int_{\mathbb{R} }f(x)\mathrm{d} x=\sin1.\qedhere
$$
\end{proof}

\item[四、](15分)

对 $f \in C^1(\mathbb{R})$ 以及 $t>0$, 定义
$$I_t(f)=\frac{1}{t^2} \int_{\mathbb{R}}|f(x+t)-f(x)|^2 \text{d} x.$$
证明:
$$\lim_{t \rightarrow 0} I_t(f)=\int_{\mathbb{R}}|f^{\prime}(x)|^2 \text{d} x.$$

\begin{proof}
由Fatou引理,
$$\int_{\mathbb{R}}|f^{\prime}(x)|^2 \text{d} x
=\int_{\mathbb{R}} \liminf_{t \rightarrow 0} \frac{|f(x+t)-f(x)|^2}{t^2} \text{d} x 
\leq \liminf_{t \rightarrow 0} I_t(f).$$
另一方面, 由Cauchy--Schwarz不等式,
$$|f(x+t)-f(x)|^2=\left|\int_x^{x+t} f^{\prime}(y) \text{d}y\right|^2 
\leq t \int_x^{x+t} f^{\prime}(y)^2 \text{d}y.$$
故
$$I_t(f) \leq \int_{\mathbb{R}} \int_x^{x+t} \frac{f^{\prime}(y)^2}{t} \text{d}y \text{d}x.$$
由Tonelli (Fubini)定理, 上式右边
$$
	=\frac{1}{t} \int_{\mathbb{R}} f^{\prime}(y)^2\left(\int_{y-t \leq x \leq y} d x\right) \text{d} y=\int_{\mathbb{R}} f^{\prime}(y)^2 \text{d} y .
$$
因此 $I_t(f) \leq \int_{\mathbb{R}}|f^{\prime}(y)|^2 \text{d} y$ 对所有的 $t>0$ 成立. 故待证等式成立.
\end{proof}

\item[五、](15分)

设$ f\colon \mathbb{R} \to \mathbb{R}  $是Lebesgue可测函数,满足如下性质:
对任意$\varphi\in \mathcal{L}^{2}(\mathbb{R})$,
都成立$f\varphi\in \mathcal{L}^{1}(\mathbb{R})$.
证明: $f\in \mathcal{L}^{2}(\mathbb{R})$.

\begin{proof}
可以考虑Riesz表示定理.

对$ \mathcal{L}^{2}(\mathbb{R}) $上的线性泛函$ T(\varphi)=\int f\varphi $，先验证它是有界的.
如果不如此,可取得一列$ \varphi_{n} $使得$ \Vert \varphi_{n} \Vert_{2}=1/n $,同时$ |T(\varphi_{n})|>2^{n} $.
现在对$\varphi=\sum \varphi_{n}/n$,它属于$\mathcal{L}^{2}(\mathbb{R})$：
\begin{align*}
    \int{\varphi ^2}&=\int{\bigg( \sum{\frac{\varphi_n}{n}} \bigg)^2}\\
    &\le \int{\Big( \sum{\varphi_{n}^{2}} \Big) \bigg( \sum{\frac{1}{n^2}} \bigg)}\\
    &=\frac{\pi^2}{6}\sum{\int{\varphi_{n}^{2}}}=\frac{\pi^4}{36}
\end{align*}
但我们有
$$\int{|f\varphi|}=\sum{\frac{1}{n}\int{|f\varphi_n|}}
\ge \sum{\frac{1}{n}\bigg|\int_{}^{}{f\varphi_n}\bigg|}
\ge \sum{\frac{2^n}{n}}=\infty $$

因而$ f\varphi\notin \mathcal{L} ^{1}(\mathbb{R} ) $,这与题设矛盾.

由Riesz表示定理,存在唯一的$ g\in \mathcal{L} ^{2}(\mathbb{R} ) $,使得$ T(\varphi)=\int g\varphi  $.易得$ f\in \mathcal{L} ^{2}(\mathbb{R}) $.

此外,还可以用常规的反证法.

如果$ \int f^{2}=\infty $,
%考虑$ E_{n}=\{1/n\le |f| \le n\} $,必然存在$ N $,使$ \int _{E_{N}}f^{2}>3 $.现在取$ F $是$ E_{N} $的有限测度子集,保持$ \int _{F}f^{2}>3 $.
取一列两两不交的可测集$ E_{k} $,使得$
1\le \int_{E_k}^{}{f^2}\le 2$，现在取$ \varphi=f\sum \chi _{E_{k}}/k $，其属于$ \mathcal{L} ^{2}(\mathbb{R}) $:
$$
\int_{}^{}{\varphi ^2}=\sum_{}^{}{\frac{1}{k^2}\int_{E_k}^{}{f^2}\le 2\sum_{}^{}{\frac{1}{k^2}}=\frac{\pi ^2}{3}}
$$

但我们有
$$
\int_{}^{}{f\varphi}=\sum_{}^{}{\frac{1}{k}\int_{E_k}^{}{f^2}\ge \sum_{}^{}{\frac{1}{k}}=\infty}
$$

这与题设矛盾.

最后，还可以用[[闭图像定理]]。考虑$M_f\colon \mathcal{L}^{2}(\mathbb{R}) \rightarrow \mathcal{L}^{1}(\mathbb{R}) ,\varphi\mapsto f\varphi$.
它是闭算子，这是因为设
\[\varphi_n\stackrel{\mathcal{L}^{2}}{\longrightarrow}\varphi,
\quad f\varphi_n\stackrel{\mathcal{L}^{1}}{\longrightarrow}\psi,\]
有$\varphi_n,f\varphi_n$依测度收敛于$\varphi,\psi$，
又不难说明$f\varphi_n$依测度收敛于$f\varphi$，从而$f\varphi=\psi$.
于是由闭图像定理，$M_f$是有界算子，即$\|M_f\|<\infty$。
那么取$\varphi=f\chi_{[-n,n]\cap\{|f|\leq n\}}$，得到
\[\|f\chi_{[-n,n]\cap\{|f|\leq n\}}\|_2
=\dfrac{\|f\varphi\|_1}{\|\varphi\|_2}\leq\|M_f\|,\]
故$\|f\|_2\leq\|M_f\|$.
\end{proof}

\item[六、](20分)

Let $ A=(a_{ij})_{1\le i,j\le n} $ be an $ n$-order real square symmetric matrix, and define
$$ f( x_1,x_2,\cdots ,x_n ) =\exp \left( -\sum_{j,k=1}^n{x_{jk}a_ja_k} \right)  $$
\begin{enumerate}
\item Prove that $ f\in L^{1}(\mathbb{R} ^{n}) $ iff $ A $ is positive definite.
\item Assuming $ A $ is positive definite, compute $ \int_{\mathbb{R} ^{n}}f(x)dx $.
\end{enumerate}

\begin{proof}
	\begin{enumerate}
	\item Since $ A $ is real and symmetric, it can be orthogonal diagonalized. Assume $ Q $ is orthogonal with $ \det Q=1 $, such that $ QAQ^{-1}=D=\mathrm{diag} \{\lambda_{1},\lambda_{2},\cdots,\lambda_{n}\} $, where each $ \lambda_{i} $ is an eigenvalue of $ A $.
	
	Then $ f(x)=\exp(-x^{T}Ax)=\exp(-x^{T}Q^{T}DQx)=\exp(-y^{T}Dy) $, where we denote $ y=Qx $.
	
	Thus 
	\begin{align*}
	\int_{\mathbb{R}^n}{f(x)\,\mathrm{d}x}
    &=\int_{\mathbb{R}^n}{\exp(-y^TDy)\,\mathrm{d}x}
    =\int_{\mathbb{R}^n}{\exp(-y^TDy)\,\mathrm{d}y}\\
    &=\int_{\mathbb{R}^n}{\exp \left( -\sum_{k=1}^n{\lambda _ky_{k}^{2}} \right) \mathrm{d} y_1\cdots \mathrm{d} y_n}.
	\end{align*}
	
	Therefore, $ f\in L^{1}(\mathbb{R} ^{n}) $ iff $ \forall i=1,2,\cdots n,\lambda_{i}>0  $ iff $ A $ is positive definite.
	\item By the above discussions, using Tonelli's theorem we have 
	$$\int_{\mathbb{R}^n}{f(x)\,\mathrm{d}x}
    =\int_{\mathbb{R}^n}{\exp \left( -\sum_{k=1}^n{\lambda _ky_{k}^{2}} \right) \mathrm{d}y_1 \cdots \mathrm{d}y_n}
    =\prod_{k=1}^n{\int_{\mathbb{R}}{\exp(-\lambda_kt^2)\,\mathrm{d}t}}
    =\sqrt{\frac{\pi^{n}}{\det A}}.\qedhere$$
	\end{enumerate}
\end{proof}

\end{itemize}

\section{15--16春 A卷(沈维孝)}

\subsection{原卷}
\begin{itemize}
\item[一、](20分)判断正误。以下论断正确的在前面的括号中填T,错误的填F:

1.可数集的有限子集全体构成的集合是可数的.

2.设$ \mathcal{L}  $是$ \mathbb{R}  $的全体Lebesgue可测子集构成的集合。
则存在$ \mathcal{L}  $到$ \mathbb{R}  $的双射，但不存在$ \mathcal{L}  $到$ \mathbb{Q}  $的双射.

3. $ \mathbb{R}  $的非空开子集的Lebesgue测度必大于零.

4. Lebesgue外测度为正的$ \mathbb{R}  $的子集必是不可数集.

5.若$ E $是$ \mathbb{R}  $的Lebesgue可测子集，则 $\ell(E)=
 \sup\{\ell(K):K \text{ 是 }E\text{ 的紧子集}\}$.
 
6.若 $f,g\colon\mathbb{R} \to \mathbb{R} $ 都是Lebesgue可测函数，
则 $g\circ f$ 也是.

7.若 $f\colon[0,1]\to \mathbb{R} $ 是绝对连续函数，
则存在单调递增的绝对连续函数 $g,h\colon[0,1]\to \mathbb{R}$，使得 $f=g-h$。 

8.若$ f $是$ \mathbb{R}  $上的Lebesgue可积函数, $ E_{n}=\{x\colon f(x)>n\},n=1,2,\cdots $,则$ \int_{E_{n}}f(x)\mathrm{d} x\to 0 $.

9.设 $f\colon[0,1]\to \mathbb{R} $ 是有界函数.那么 $f(x)$ 是Riemann可
积函数当且仅当 $f(x^{2})$ 是Riemann可积函数.

10.设 $\ f_{n} \colon \mathbb{R} \to \mathbb{R} ,n=1,2,\cdots$是一列
非负 Lebesgue 可测函数,满足$ \int _{\mathbb{R} }f_{n}(x)\mathrm{d} x=1 $.
若 $f_{n}$ 依测度收敛于某个非负 Lebesgue可测函数$ f\colon\R \to \R$，
则$ \int_{\mathbb{R} }f(x)\mathrm{d} x\le1 $.

\item[二、](15分)设 $E$ 是十进制表示中不出现数字 $8$ 的 $[0,1]$ 中的无理数全体，
证明 $E$ 是 $\mathbb{R}$ 的 Borel 子集，并求出 $E$ 的 Lebesgue 测度.

\item[三、](15分)请准确叙述 Lebesgue 控制收敛定理，并求下面的极限:
$$ \lim_{n\to \infty}\int_{0}^{n}\Big(1+\frac{x}{n}\Big)^{n}e^{-2x}\mathrm{d} x. $$

\item[四、](15分)求积分
$$\iint_E\left(x^2+y^2\right) \mathrm{d} x \mathrm{d} y,$$
其中 $E=\{(x, y)\in \mathbb{R} ^{2}:|x| \leqslant \pi,|y| \leqslant \pi,|\sin x| \leqslant \frac{1}{2}, \cos (x+y) \text{ 是无理数} \}$.

\item[五、] (15分)设$f\colon\mathbb{R}\rightarrow\R$是一致连续的Lebesgue可积函数。证明
$$\lim_{x \rightarrow+\infty} f(x)=0.$$

\item[六、](20分)设 $\left\{f_n(x)\right\}\colon[0,1]\rightarrow\R$
是一列Lebesgue可测函数，且几乎处处收敛于 $0$，
且 $\int_0^1 |f_n(x)|^2 \mathrm{d}x \leq 1$ 对所有的$n$成立.

(1)证明或举反例否定: 存在子列 $\left\{f_{n_k}\right\}_{k=1}^{\infty}$使得
$$\lim_{n_k \rightarrow \infty} \int_0^1 |f_{n_k}(x)|^2 \mathrm{d}x=0.$$

(2)证明或举反例否定:
$$\lim_{n \rightarrow \infty} \int_0^1 |f_n(x)| \mathrm{d}x=0.$$

\end{itemize}

\subsection{带答案}

因未找到参考答案,以下内容由本人随便猜的,如果错了请直接改正或者联系我.
\begin{itemize}
\item[一、](20分)判断正误。以下论断正确的在前面的括号中填T,错误的填F:

1.可数集的有限子集全体构成的集合是可数的.

\begin{proof}[解答]
T. 对子集的大小排序即可.
\end{proof}

2.设$ \mathcal{L} $是$ \mathbb{R} $的全体Lebesgue可测子集构成的集合。
则存在$ \mathcal{L} $到$ \mathbb{R} $的双射, 但不存在$ \mathcal{L} $到$ \mathbb{Q} $的双射.

\begin{proof}[解答]
F.我们来证明全体Lebesgue可测集的势为$2^\aleph.$左受制于右显然.右受制于左:
考虑Cantor三分集,其外测度为$0$,势为$\aleph.$它的任一子集外测度也为$0$,从而由完备性知是Lebesgue可测集.三分集的幂集具有势$2^\aleph.$
\end{proof}

3. $ \mathbb{R}  $的非空开子集的Lebesgue测度必大于零.

\begin{proof}[解答]
T. 非空开集必存在内点以及它的邻域,使测度大于零.
\end{proof}

4. Lebesgue外测度为正的$ \mathbb{R}  $的子集必是不可数集.

\begin{proof}[解答]
T. 若其可数,必有测度为$ 0 $.
\end{proof}

5.若$ E $是$ \mathbb{R}  $的Lebesgue可测子集，则 
$\ell(E)=\sup\{\ell(K):K \text{ 是 }E\text{ 的紧子集}\}$.
 
\begin{proof}[解答]
待补
\end{proof}
 
6.若 $f,g\colon\mathbb{R} \to \mathbb{R} $ 都是Lebesgue可测函数，
则 $g\circ f$ 也是.

\begin{proof}[解答]
F. 讲义中定理4.18给出了一个同胚$F\colon[0,1]\rightarrow[0,2]$，
它把Cantor三分集$\mathbf{K}$映到了测度为$1$的集合$F(\mathbf{K})$。
设$N$是$F(\mathbf{K})$的一个不可测子集，令$A=F^{-1}(N)$，
由$A\subset\mathbf{K}$以及$\mathbf{K}$零测得到$A$是可测集。
取连续函数$f$使之限制在$[0,2]$上是$F^{-1}$，$g=\chi_A$，
那么$g\circ f$在$[0,2]$上就是$\chi_N$，不是可测函数。
\end{proof}
Remark:这一反例说明，即使加强条件为$f$连续，命题仍然不成立.

7.若 $f\colon[0,1]\to \mathbb{R} $ 是绝对连续函数，
则存在单调递增的绝对连续函数 $g,h\colon[0,1]\to \mathbb{R}$，使得 $f=g-h$. 

\begin{proof}[解答]
T.由于$f$绝对连续，$f(x)=f(0)+\int_0^x f'(t) \mathrm{d} t$且$f'(x)\in L^1([0,1]).$注意到这一点之后，取$h(x)=\int_0^x |f'(t)| \mathrm{d} t$便是自然的.
\end{proof}

8.若$ f $是$ \mathbb{R}  $上的Lebesgue可积函数, $ E_{n}=\{x\colon f(x)>n\},n=1,2,\cdots $,则$ \int_{E_{n}}f(x)\mathrm{d} x\to 0 $.

\begin{proof}[解答]
T. 可从积分的绝对连续性理解:因$ E_{n} $测度可足够小,在其上的积分也可足够小.
\end{proof}

9.设 $f\colon[0,1]\to \mathbb{R} $ 是有界函数.
那么 $f(x)$ 是Riemann可积函数当且仅当 $f(x^{2})$ 是Riemann可积函数.

\begin{proof}[解答]
我猜T. 它们应该共享不连续点集?然后同时Riemann可积?但有界条件不知道作用.

(afsd) 看不连续点集是正确的。有界性的要求在于，我们用“不连续点全体零测 $\Leftrightarrow$ Riemann可积”的这个判据时，它的前提就是要求函数是有界的，因为Riemann可积性天然要求有界。
\end{proof}

10.设 $\ f_{n} \colon \mathbb{R} \to \mathbb{R} ,n=1,2,\cdots$是一列
非负 Lebesgue 可测函数,满足$ \int _{\mathbb{R} }f_{n}(x)\mathrm{d} x=1 $.若 $f_{n}$ 依测度收敛于某个非负 Lebesgue可测函
数$ f\colon\mathbb{R} \to \mathbb{R}  $,则$ \int _{\mathbb{R} }f(x)\mathrm{d} x\le1 $.

\begin{proof}[解答]
T. 因$f_n$依测度收敛,其存在子列几乎处处收敛到$f$.此时在子列中使用Fatou引理即可.
\end{proof}

\item[二、](15分)设 $E$ 是十进制表示中不出现数字 $8$ 的 $[0,1]$ 中的无理数全体, 
证明 $E$ 是 $\mathbb{R}$ 的 Borel 子 集, 并求出 $E$ 的 Lebesgue 测度.
\begin{proof}
前半段与一道作业题相同.后半段swx老师在课堂上讲过:只需要考虑每一次挖去区间的长度(求得为$\frac{9^{n-1}}{10^n}$),累加后取补即可.答案是$0$.
\end{proof}

\item[三、](15分)请准确叙述 Lebesgue 控制收敛定理，并求下面的极限:
$$ \lim_{n\to \infty}\int_{0}^{n}\Big(1+\frac{x}{n}\Big)^{n}e^{-2x}\mathrm{d} x. $$

\begin{proof}
叙述略.被$e^{-x}\chi_{(0,+\infty)}$控制,极限是$\int_0^\infty e^{-x} \mathrm{d} x=1$.
\end{proof}
\item[四、](15分)求积分
$$\iint_E\left(x^2+y^2\right) \mathrm{d} x \mathrm{d} y,$$
其中 $E=\{(x, y)\in \mathbb{R} ^{2}:|x| \leqslant \pi,|y| \leqslant \pi,|\sin x| \leqslant \frac{1}{2}, \cos (x+y) \text{ 是无理数} \}$.
\begin{proof}
核心在于说明$\{(x, y)\in [-\pi,\pi]^2 \mid \cos(x+y) \in \mathbb{Q}\}$是零测集.

直接将$ E $替换,算得$ 82\pi^{4}/81 $.
\end{proof}

\item[五、] (15分)设$f\colon\mathbb{R}\rightarrow\R$是一致连续的Lebesgue可积函数。证明
$$\lim_{x \rightarrow+\infty} f(x)=0.$$
\begin{proof}
若结论不成立，存在$ \alpha>0 $以及一列$ x_{n}\to +\infty $，满足$ x_{n+1}\ge x_{n}+1,|f(x_{n})|>\alpha $.

因$ f $一致连续，存在$ 1>\delta>0 $，只要$ |x-y|<\delta $就有$ |f(x)-f(y)|<\alpha/2 $.由此得
$$
\bigg|\int_{x_n-\frac{\delta}{2}}^{x_n+\frac{\delta}{2}}{f(x)\,\text{d}x}\bigg|\ge \frac{\alpha}{2}\delta, 
$$

从而$ \int |f|=\infty $,矛盾.
\end{proof}

\item[六、](20分)设 $\left\{f_n(x)\right\}\colon[0,1]\rightarrow\R$是一列Lebesgue可测函数，
且几乎处处收敛于 $0$，且 
$\int_0^1 |f_n(x)|^2 \mathrm{d}x \leq 1$ 对所有的$n$成立.

(1)证明或举反例否定: 存在子列 $\left\{f_{n_k}\right\}_{k=1}^{\infty}$使得
$$\lim_{n_k \rightarrow \infty} \int_0^1 |f_{n_k}(x)|^2 \mathrm{d}x=0.$$

(2)证明或举反例否定:
$$\lim_{n \rightarrow \infty} \int_0^1 |f_n(x)| \mathrm{d}x=0.$$
\begin{proof}
(1)是错的,反例取$f_n = \sqrt{n}\chi_{[0,\frac{1}{n}]}$.

(2)是对的:
    利用Egoroff定理, $\forall \varepsilon >0$, 存在可测集$E$,
    使得$\mu(E)<\varepsilon $且在$E^{c}$上$f_k$一致收敛到$0$,
    即$ n $足够大时$ |f_{n}|<\varepsilon $.
    $$\int_0^1{|f_n|}=\int_E{|f_n|}+\int_{E^c}{|f_n|}
    \le \left( \int_E{f_{n}^{2}}\int_E{1} \right) ^{\frac{1}{2}}+\varepsilon \int_{E^c}^{}{1}
    \le \varepsilon^{\frac{1}{2}}+\varepsilon \qedhere$$
\end{proof}

\end{itemize}