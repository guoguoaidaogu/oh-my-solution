\section{25--26春 期末(H) (吴健超、章嘉雯)}
\begin{enumerate}
\item 在承认选择公理的前提下求\\(1) (4分) 实系数多项式全体构成的集合的势；\\(2) (6分) 全体$\mathbb{R}$到$\mathbb{R}$的单调函数构成的集合的势。
\item 对每个自然数 $M$，定义 $\mathcal{D}_{M} = \big\{ \big[\frac{k}{2^{M}}, \frac{k + 1}{2^{M}}\big] \mid k = 0, 1, \cdots, 2^{M} - 1 \big\}$ 为所有二进区间全体组成的集合。\\
(1) (8分)求证：对任意 Lebesgue 可测集 $A \subseteq [0, 1]$ 和任意 $\varepsilon > 0$，
存在有限个二进区间 $I_{j} \in \mathcal{D}_{M}$ 使得 
\[m(A \mathop{\triangle} \bigcup_{j = 1}^{n}I_{j}) < \varepsilon.\]
(2) (12分)设 $r_{n}(x) = \mathrm{sgn}(\sin(2^{n}\pi x))$，$f$ 是 $[0, 1]$ 上的 Lebesgue 有界可测函数，求证：
$$\lim_{n \to \infty}\int_{0}^{1}f(x)r_{n}(x)\,\text{d} x = 0.$$
\item $(X,\mathcal{B},\mu)$是测度空间，设函数列$\{f_n\},f$都是取值在$\mathbb{R}$上的可测函数，函数$F:\mathbb{R}\to\mathbb{R}$是连续函数.\\
(1) (2分)叙述$f_n$在$X$上依测度收敛收敛到$f$的定义。\\(2) (6分)若$F$一致连续，求证$F(f_n)$依测度收敛于$F(f)$。\\(3) （12分)若$F$只是连续（不一定一致连续）且$f$可积，求证$F(f_n)$依测度收敛于$F(f)$。
\item 设 $K(x)$ 是 $\mathbb{R}$ 上非负的 Lebesgue 可积函数，满足
\[\int_{\mathbb{R}}K(x)\,\text{d} m(x) = 1,\]
定义 $K_{n}(x) = nK(nx)$。\\
(1) (2分) 求证：\[\int_{\mathbb{R}}K_{n}(x)\,\text{d} m(x) = 1.\]
(2) (4分) 证明：对任意 $\delta > 0$，有 \[\lim_{n \rightarrow \infty}\int_{|x| > \delta}K_{n}(x)\,\text{d} m(x) = 0.\]
(3) (6分) 设 $f$ 是 $\mathbb{R}$ 上的有界 Lebesgue 可测函数，且 $f$ 在 $0$ 处连续，证明：
\[\lim_{n \to \infty}\int_{\mathbb{R}}K_{n}(x)f(x)\,\text{d} m(x) = f(0).\]
(4) (8分) 进一步假设 $K(x)$ 有界且存在 $M > 0$ 使得当 $|x| > M$ 时，有 $K(x) = 0$，
设 $g$ 是 $\mathbb{R}$ 上的 Lebesgue 可积函数，叙述 $g$ 的 Lebesgue 点的定义，并证明 
\[\lim_{n \to \infty}(K_{n} * g)(x) = g(x)\]
对几乎处处的 $x$ 成立，其中
\[(K_{n} * g)(x) = \int_{\mathbb{R}}K_{n}(x - y)g(y)\,\text{d} y.\]
\item (10分) 求无穷级数$$\sum_{n=0}^{\infty}\int_0^{\pi/3}\big(1-\sqrt{\sin x}\big)^n\cos x \,\text{d}x.$$
\item 设$f$是$(a,b)$上的单调递增函数，$E\subset(a,b)$，$t>0$为一常数，对于任意$x\in E$，$\overline{D}(f)>t$.\\
(1) (4分) $E'=\{x\in E \mid f\text{ 在 }x\text{ 处连续}\}$，证明$m^*(E)=m^*(E'),m^*(f(E))=m^*(f(E'))$;\\
(2) (6分) 对任意$\varepsilon>0$，存在一开集$O$包含$f(E')$满足$m(O)\leqslant m^*(f(E'))+\varepsilon$，记
\[\mathcal{F}_0=\bigg\{[c,d]\subset[a,b]\biggm|\frac{f(d)-f(c)}{d-c}>t,\,[f(c),f(d)]\subset O\bigg\},\]
求证$\mathcal{F}_0$是$E'$的Vitali覆盖;\\
(3) (10分) 证明：$t\cdot m^*(E)\leqslant m^*(f(E))$.
\end{enumerate}

\section{25--26春 期末(王凯)}
\begin{enumerate}
\item (1) 叙述可数集的定义。
(2) 固定$p$，求所有$p$进制有限小数的势。

\item (1) 叙述Lusin定理。\\
(2) 证明：$f$是$[0,2\pi]$上的Lebesgue可测函数等价于存在多项式序列$\{p_n\}_{n\geqslant1}$，
使得$p_n\stackrel{a.e.}{\longrightarrow}f$。


\item 设$E$是直线中 Lebesgue 可测集，$1\leqslant p,q\leqslant\infty,\frac{1}{p}+\frac{1}{q}=1$. 
若$L^p(E)$中函数列$\{f_n\}$依$L^p$意义收敛于函数$f$，$L^q(E)$中函数列$\{g_n\}$依$L^q$意义收敛于函数$g$,那么 $\{f_ng_n\}$依$L^1$意义收敛于函数$fg$.

\item (1) 依测度收敛的定义。\\
(2) 设$E$是直线中的Lebesgue可测集，$\{fₙ\}$和$\{gₙ\}$是$E$上的两列Lebesgue可测函数，$f$和$g$是$E$上的几乎处处有限的Lebesgue可测函数，
$f_n\stackrel{m}{\longrightarrow}f, g_n\Longrightarrow g$，$m(E)<\infty$，证明$f_ng_n\Longrightarrow fg$。

\item (1) 叙述Tonelli定理。\\
(2) 设$f:[0,1]\rightarrow[1,\infty)$是Lebesgue可测函数，证明
\[\int_{[0,1]}f(x)\,dm(x)\int_{[0,1]}\ln f(x)\,dm(x)\leqslant\int_{[0,1]}f(x)\ln f(x)\,dm(x).\]

\item (1) 叙述Levi定理。\\
(2) 如果\[\lim_{n\to\infty}\int_{\R} f^n\,dm=\int_{\R} f\,dm,\]证明$f=\chi_A$.

\item 回忆缺失，期待补全：
$f$满足?证明$\lim\limits_{y\to 0}f(x,y)$连续；
叙述绝对连续的定义……
\end{enumerate}

\section{24--25春 期末(H) (林华新)}
\begin{enumerate}
\item 设$E_1,\cdots,E_n,\cdots$是$(X,\mathcal{R},\mu)$中的一列集合，
$F_1,\cdots,F_n,\cdots$为一列两两不交的可测集，且$E_n \subset F_n$。
证明：$\mu^*\Big(\bigcup\limits_{n=1}^{\infty}E_n\Big)=\sum\limits_{n=1}^{\infty}\mu^*(E_n)$。

\item 设有限闭区间$[a,b]$上的$\mu$-可测函数$f$几乎处处有限，证明：存在连续函数列$\{f_n\}$，
使得$f_n\underset{\mu}{\stackrel{.}{\longrightarrow}}f$。

\item 设可测函数列$f_n\underset{m}{\stackrel{.}{\longrightarrow}}0$，$0<f_n\le1$，
求$\displaystyle\lim_{n\to\infty}\int_0^1\frac{1-\cos f_n(x)}{x^\frac{1}{2}f_n(x)^\frac{3}{2}}\,{\rm d}m$。

\item 设$f_1,\cdots,f_n,\cdots$为$[0,1]$上的单调递增的绝对连续函数，
$f(x)=\sum\limits_{n=1}^{\infty}f_n(x)$几乎处处有限,
证明：$f(x)$也是绝对连续的。

\begin{remark*}
    本题疑似有误, 若``单调递增''指$f_1,\cdots,f_n,\cdots$均是单调递增的, 
    则函数 $\frac{1}{1-x}$ 的幂级数展开是一个反例.
\end{remark*}

\item 设$M=\{(x,y)\in\R^2:0 \le x \le y \le 1\}$，
求$\displaystyle\iint_M e^{-y^2}\,{\rm d}x{\rm d}y$。

\item (1) 叙述Radon--Nikodym定理。\\
(2) 对于复测度空间$(X,\mathcal{R},\mu)$，证明：存在可测函数$h$，
$\forall\,x \in X$有$|h(x)|=1$，使得对于所有可测集$E$,都有$\mu(E)=\int_Eh\,{\rm d}|\mu|$。
\end{enumerate}

\section{24--25春 期末(王凯)}
\begin{enumerate}
\item (8分)\\
(1)叙述可数集的定义.\\
(2)设$A$是平面上有理点(即横纵坐标都是有理数的点)为中心、有理数为半径的圆的全体，证明：$A$是可列集.

\item (8分)\\
(1)叙述有界变差函数的定义.\\
(2)设$[0,1]$上的函数$f$为
\[f(x)=
\begin{cases}
\dfrac{\pi}{2}x\,\sin\dfrac{1}{x} & \text{ 若 }x\in (0,1];\\ \\
0 &\text{ 若 }x=0.
\end{cases}\]
证明：$f$不是有界变差函数.

\item (10分)\\
(1)叙述Lebesgue控制收敛定理.\\
(2)设$f$是$[0,1]$上Lebesgue可积函数,证明:
\[\lim_{n\rightarrow \infty}\int_{[0,1]}n \ln\left(1+\frac{|f^{2}(x)|}{n^{2}}\right) \mathrm{d}m(x)=0.\]

\item (10分)\\
(1)叙述直线上Borel可测函数的定义.\\
(2)设$\{f_{j}:j\in J\}$是直线上的连续函数族,证明:
\[g(x)=\sup\{f_{j}(x):j \in J\}\]
是Borel可测函数.若每个$f_{j}$只是Borel可测函数,问$g$是否是Borel可测函数?

\item (10分)\\
(1)叙述依测度收敛的定义.\\
(2)设$E$是直线中的Lebesgue可测集，$m(E)<\infty$，${g_{n}}$是$E$上可测函数列，
$g_{n}\,{\overset{m}{\Longrightarrow}}\,g$，并且$g_{n},g$在$E$上几乎处处不为零.
证明：$\dfrac{1}{g_{n}}\,{\overset{m}{\Longrightarrow}}\,\dfrac{1}{g}$.
又若$m(E)=\infty$,结论是否还成立?证明你的结论.

\item (10分)\\
(1)叙述Lusin定理及其逆定理.\\
(2)证明Lusin定理的逆定理.

\item (10分)\\
(1)叙述直线上Lebesgue外测度以及Lebesgue可测集的定义.\\
(2)设直线上的函数$g(x)=x^{2}$,证明:对$[a,b]$中的可测集$E$,像集$g(E)$是Lebesgue可测集.

\item (10分)\\
(1)证明:当$f$在$\mathbb{R}$上是Lebesgue可积函数时,
\[\lim_{n \rightarrow \infty} \int_{\mathbb{R}}f(x)\cos(nx)\,\mathrm{d}m(x)=0.\]
(2)设$\{n_{j}\}$是一个单调递增趋于无穷的正整数列,令$E=\{x\in [0,2\pi]:\sin(n_{j}x)\text{ 收敛}\}$，证明：其Lebesgue测度$m(E)=0$。

\item (12分)设$F$是直线上的闭集，$m(\mathbb{R} \setminus F) < \infty$，
定义距离函数$\delta(x)=\inf\{|x-y|:y\in F\}$.\\
(1)证明：$\delta(x)$是$\mathbb{R}$上的连续函数.\\
(2)考虑积分
\[I(x)=\int_{\mathbb{R}}\frac{\delta(y)}{|x-y|^{2}}\,\mathrm{d}y.\]
证明:对于任意$ x\in \mathbb{R} \setminus F$，$I(x)=\infty$；
对几乎处处的$x \in F$，$I(x) < \infty$。

\item (12分)\\
设$A,B$是$[0,1]$的Lebesgue可测子集，
证明：$\forall \, n \geq 2$，存在$0\leq x \leq y \leq1$，使得
\[m(A\cap[x,y])=\frac{1}{n}m(A); \quad m(B\cap[x,y])=\frac{1}{n}m(B).\]
\end{enumerate}

\section{24--25春 期末(徐胜芝)}

\begin{enumerate}
	\item 证明映射集$\{f : A\to B\mid A \subseteq X, B \subseteq Y\}$中有偏序$\subseteq$. 
	其中对$f_1:A_1 \to B_1$, $f_2:A_2 \to B_2$, $f_1 \subseteq f_2$表示$A_1 \subseteq A_2$, 
	$B_1 \subseteq B_2$, 且$f_1(x)=f_2(x)(\forall x \in A_1)$. 
    并证明该映射集的任意非空上有界子集有上确界. 
	 
	\item 证明单增的测度网$(\mu_i)_{i \in \beta}$的极限$\mu = \lim\limits_{i \uparrow \beta}\mu_i$为测度. 
    且对$X$上任意非负可测函数$f$, 有$\int_{X}f d\mu = \lim\limits_{i \uparrow \beta}\int_X f d\mu_i$.
	
	\item 将$m \times n$阶方阵全体$\mathbb{R}(m,n)$视为Euclid空间$\mathbb{R}^{mn}$, 
    对应的同构为$[x_1, x_2, \cdots, x_n] \to [x_1^t, x_2^t, \cdots, x_n^t]^t$. 
    $\mathbb{R}(m,n)$上的Lebesgue测度记为$\lambda_m^n$, 以$T: x \to x^t$表示矩阵的转置. 
	\begin{itemize}
		\item[(1)] 任取Borel集$E \subseteq \mathbb{R}(m,n)$, 有$\lambda_n^m(T(E))=\lambda_m^n(E)$.
		
		\item[(2)] 对$a \in \mathbb{R}(m), b \in \mathbb{R}(n)$, 证明$\lambda_m^n(aE)=|\det(a)|^n\lambda_m^n(E)$,  $\lambda_m^n(Eb)=|\det(b)|^m\lambda_m^n(E)$.
		
		\item[(3)] 证明$n$阶可逆阵$\mathsf{GL}_n(\mathbb{R})$全体是一个开集, 对于其上的连续函数$f$, 记$\mu(dx)=f(x)\lambda_n^n(dx)$.
		
		\item[(4)] 找些$\mathsf{GL}_n(\mathbb{R})$上的连续函数, 使得对任意的$a \in \mathsf{GL}_n(\mathbb{R})$与Borel集$E$满足$\mu(aE)=\mu(E)=\mu(E^{-1})=\mu(Ea)$.
	\end{itemize}
	
	\item 证明实轴中子集$A$为一个Lebesgue零集当且仅当有包含$A$的递减开集列$(B_k)_{k \geqslant 1}$使得级数
	$\sum\limits_{k \geqslant 1}\mathfrak{m}(B_k)$可和. 函数$g_k(x)=\mathfrak{m}(B_k \cap (-\infty, x])$,
    $g_A(x)=\sum\limits_{k \geqslant 1} g_k(x)$均连续且单调递增, 并且$g_A$在某闭区间$[a,b]$上绝对连续.
\end{enumerate}

\section{23--24春 期末(吴健超、章嘉雯)}

\begin{enumerate}
    \item[I](1)求$\{\mathbb{R}$到$\mathbb{R}$的连续函数$\!\}$的势.（提示：考虑$\mathbb{Q}$到$\mathbb{R}$的函数的势）\\
    (2) Cantor集$C$的势(不需要证明).\\
    (3) $\{f:\mathbb{R}\to \mathbb{R}\mid$存在$\mathbb{R}$到$\mathbb{R}$的连续函数列几乎处处收敛到$f\}$的势.（提示：考虑$\{\chi_E\mid E\subset C\}$）

    \item[II](1)叙述Levi引理.\\
    (2) $f_n,f$是$\mathbb{R}$上的可积函数，对任意$\mathbb{R}$的Lebesgue可测集$E$，
    $\{\int_E f_n(x)\,\mathrm{d}m(x)\}_{n=1}^\infty$单调收敛到$\{\int_E f(x)\,\mathrm{d}m(x)\}$. 
    试证明：$\{f_n\}$几乎处处递增到$f$.

    \item[III]$(X,\mathcal{R},\mu)$为概率空间($\mu(X)=1$)，
    集列$\{E_n\}$满足$\mu(E_n)\geq 0.2,\forall n\in \mathbb{N}$.
    对于非负数列$\{a_n\}$，$\sum\limits_{n=1}^\infty a_n\chi_{E_n}$几乎处处收敛. 
    试证明：$\sum\limits_{n=1}^\infty a_n$收敛.

    \item[IV](1)叙述绝对连续函数的定义.\\
    (2) 对于$[0,1]$的任何Lebesgue可测子集$E$，试证明：存在一列绝对连续函数列$\{f_n\}$，满足$\lim\limits_{n\to \infty} \int_{0}^{1}\left|f_n(x)-\chi_E \right| \mathrm{d}m(x)=0$.

    \item[V](1)叙述$(\mathbb{R},m)\times (\mathbb{R},m)$上的Fubini定理.\\
    (2) 设$E,F\subset\mathbb{R}$ Lebesgue可测，且$m(E),m(F)<\infty$，$G=\{(x,y)\in \mathbb{R}^2\mid x\in E, y-x\in F\}$，求证：$m(G)=m(E)\cdot m(F)$.\\
    (3) 设$E,F\subset\mathbb{R}$ Lebesgue可测，且$m(E),m(F)>0$，证明：存在$c\in \mathbb{R}$，使得
    \[ m(E\cap (F+c))>0.\]
    (4) $A\subset \mathbb{R}$为Lebesgue可测集，求证：若对任意的$c\in \mathbb{R}$，
    \[m(A\,\triangle\,(A+c))=0,\]
    则$A$与$\mathbb{R} \setminus A$其中之一零测.\\
    (5) 对于直线上的Lebesgue可测函数，定义$f_c=f(x-c),c\in \mathbb{R}$. 
    若对任意$c\in \mathbb{R}$，$f$几乎处处等于$f_c$，求证：$f$几乎处处等于一个常值函数.
\end{enumerate}


\section{23--24春 期末(H) (王凯)} 
本节为实分析(H)（王凯）的试卷.一共7道大题,时间为120分钟,满分100分.\\
    如果未特殊说明,本试卷中提到的测度均为$\sigma$-有限的正测度.

\begin{itemize}
   
    \item[一、]
    (证明Riesz定理)设可测函数列$\{f_n\}$依测度Cauchy,证明:\\
    (i)存在可测函数$f$,使得$\{f_n\}$依测度收敛于$f$;\\
    (ii)存在$\{f_n\}$的子列$\{f_{n_k}\}$,使得$\{f_{n_k}\}$几乎处处收敛于$f$.
    
    \item[二、]
    设$X$上的测度$\mu,\lambda,\sigma$满足$\mu \ll \lambda, \lambda \ll \sigma$,证明:
    $$ \frac{\mathrm{d}\mu}{\mathrm{d}\lambda} \cdot \frac{\mathrm{d}\lambda}{\mathrm{d} \sigma} = \frac{\mathrm{d} \mu}{\mathrm{d} \sigma}, \quad\sigma \text{-} a.e.$$

    \item[三、]
    设函数$f(x)=x^3$,证明:对于任何Lebesgue可测集$E$, $f(E)$为Lebesgue可测集.
    
    \item[四、]
    设$f$是$\mathbb{R}^2$上的可测函数,对$1\leqslant p,r<\infty$, 定义范数:
    \[\| f\|_{p,r} = \bigg(\int_{\mathbb{R}}  \bigg(\int_{\mathbb{R}} |f(x,y)|^p \,\mathrm{d}m(x)\bigg)^\frac{r}{p}\mathrm{d}m(y)\bigg)^{\frac{1}{r}},\]
    证明:如果$\| f\|_{p,r} < \infty$, 
    那么对于任意$\varepsilon > 0$,存在$g \in C_c^{\infty}(\mathbb{R}^2)$, 
    使得$\| f-g\|_{p,r} < \varepsilon$.

    \begin{proofc}[解答]
        \textbf{第一步}：用有界紧支撑函数逼近$f$。\\
        对$n\in\N$，定义
        \[f_n(x,y)=f(x,y)\cdot\chi_{|x|\leqslant n}\cdot\chi_{|y|\leqslant n}\cdot\chi_{|f(x,y)|\leqslant n},\]
        则$\{f_n\}_n$几乎处处收敛到$f$。对任意$y\in\R$，定义
        \[F_n(y)=\bigg( \int_{\R}|f(x,y)-f_n(x,y)|^p\,\mathrm{d}m(x) \bigg)^{\frac{r}{p}}.\]
        由控制收敛定理与$\| f\|_{p,r} < \infty$知，对几乎所有$y\in\R$，$\lim_{n\to\infty}F_n(y)=0$。此外，
        \[F_n(y)\leqslant\bigg( \int_{\R}|f(x,y)|^p\,\mathrm{d}m(x) \bigg)^{\frac{r}{p}}\in L^1(\R,\mathrm{d}m(y)),\]
        因而由控制收敛定理知
        \[\lim_{n\to\infty}\|f-f_n\|_{p,r}^r=\lim_{n\to\infty}\int_{\R}F_n(y)\,\mathrm{d}m(y)=0,\]
        取$N$充分大使$\|f-f_N\|_{p,r}<\frac{\varepsilon}{2}$。\\
        \textbf{第二步}：用$C_c^{\infty}(\mathbb{R}^2)$函数逼近$f_N$。\\
        取$g\in C_c^{\infty}(\mathbb{R}^2)$使得$\operatorname{supp}g\subseteq[-2N,2N]^2$且$\|f_N-g\|_{L^p(\R^2)}<\delta$，
        其中$\delta>0$待定。由于$f_N$有界，故
        \[M:=\|f_N-g\|_{L^{\infty}(\R^2)}<\infty.\]
        记
        \[F(y)=\bigg(\int_{\R}|f_N(x,y)-g(x,y)|^p\,\mathrm{d}m(x)\bigg)^{\frac{1}{p}},\]
        则$\operatorname{supp}(F)\subseteq[-2N,2N]$，$\|f_N-g\|_{p,r}=\|F\|_{L^r[-2N,2N]}$，且对任意$y\in[-2N,2N]$，
        \[F(y)\leqslant\bigg(\int_{-2N}^{2N}|f_N(x,y)-g(x,y)|^p\,\mathrm{d}m(x)\bigg)^{\frac{1}{p}}\leqslant(4N)^{\frac{1}{p}}M.\]
        若$r\geqslant p$，则
        \[\int_{-2N}^{2N}F(y)^r\,\mathrm{d}m(y)\leqslant((4N)^{\frac{1}{p}}M)^{r-p}\int_{-2N}^{2N}F(y)^p\,\mathrm{d}m(y)<((4N)^{\frac{1}{p}}M)^{r-p}\delta^p.\]
        若$r<p$，由H\"older不等式可知
        \[\int_{-2N}^{2N}F(y)^r\,\mathrm{d}m(y)\leqslant\bigg(\int_{-2N}^{2N}F(y)^p\,\mathrm{d}m(y)\bigg)^{\frac{r}{p}}\bigg(\int_{-2N}^{2N}1\,\mathrm{d}m(y)\bigg)^{\frac{p-r}{p}}<\delta^r(4N)^{\frac{p-r}{p}}.\]
        总之，可取$\delta>0$充分小使得$\|f_N-g\|_{p,r}<\frac{\varepsilon}{2}$，从而$\|f-g\|_{p,r}<\varepsilon$。
    \end{proofc}
    
    \item[五、]
    设$\mu$是复测度,定义$\mu$的测度Fourier变换为:
    \[\hat{\mu}(\xi) = \int_\mathbb{R} e^{-2\pi i \xi \cdot x} \,\mathrm{d} \mu(x).\]
    证明:\\
    (i)\ $\displaystyle \lim_{r \to \infty} \frac{1}{2r} \int_{-r}^{r} \hat{\mu} (\xi) \,\mathrm{d} m(\xi) = \mu (\{0\})$.\\
    (ii) $\displaystyle \lim_{r \to \infty} \frac{1}{2r} \int_{-r}^{r} |\hat{\mu} (\xi)|^2 \,\mathrm{d} m(\xi) = \sum_{r\in \mathbb{R}}|\mu (\{r\})|^2$.

    \begin{proofc}[(ii)的提示]
        定义复测度$\nu=\mu\ast\tilde{\mu}$，其中$\tilde{\mu}(E)=\overline{\mu(-E)}$，则$\hat{\nu}=|\hat{\mu}|^2$，从而由(i)知
        \[\lim_{r\to\infty}\frac{1}{2r}\int_{-r}^{r}|\hat{\mu}(\xi)|^2\,\mathrm{d}m(\xi)
        =\lim_{r\to\infty}\frac{1}{2r}\int_{-r}^{r}\hat{\nu}(\xi)\,\mathrm{d}m(\xi)
        =\nu(\{0\})=\int_{\R}\mu({r})\,\mathrm{d}\bar{\mu}(r).\qedhere\]
    \end{proofc}
    
    \item[六、]
    设$H$是$\mathbb{R}_+$的乘法子群, $H$为Lebesgue可测集且测度为正,证明: $H=\mathbb{R}_+$.
    
    \item[七、]
    对于一个实数集上的Lebesgue可测函数$f$, 定义其重排函数为:
    $$f^*(x) = \inf \{y\mid\lambda_f(y) \leq x\}.$$
    求证:如果$f,g\in  L^1(\mathbb{R})$, 则
    \[\int_{\mathbb{R}} fg \leq \int_0^{+\infty} f^* g^*.\]
\end{itemize}



\section{22--23春 期中(沈维孝)}

\begin{itemize}
    \item[一、]
    设$E$为$\mathbb{R}$中的有界闭集, $f:E\to \mathbb{R}$是连续函数,
    满足: $\forall x\in\mathbb{R}$, $f^{-1}(x)$至多包含两个元素.
    记$B_n=\{x\in\mathbb{R}\mid |f^{-1}(x)|=n\}\,(n=0,1,2)$.
    证明: $\forall n\in \{0,1,2\}$, $B_n$为Borel集.
    \item[二、]
    (i)叙述Egoroff定理.\\
    (ii)给定有限测度空间$(X,\mathcal{X},\mu)$,设$f_n:X\to\mathbb{R}$为可测函数,
    满足: $\limsup\limits_{n\to\infty} f_n\le 0$.
    证明: $\forall \varepsilon >0$, 存在$E\in\mathcal{X}$和$N\in\mathbb{N}^*$,
    使得$\mu(X\backslash E)<\varepsilon$且
    $\forall x\in E, n\ge N,f_n(x)<\varepsilon.$
    \item[三、]
    测度空间$(X,\mathcal{X},\mu)$满足: $\forall E\in \mathcal{X}$,
    要么$\mu(E)=0$要么$\mu(X\backslash E)=0.$设$f:X\to\mathbb{R}$为可测函数,
    证明: $\exists\: c\in\mathbb{R},f(x)=c \text{ a.e.}$
    \item[四、]
    求
    $$ \lim_{n\to\infty} \int_0^n \frac{x^\frac{1}{n} \sin \pi x}{1+x^{2n}} \,\mathrm{d} x.$$
    \item[五、]
    (i)叙述Carathéodory条件.\\
    (ii)设$U_i$ $(i=1,2,\ldots,n)$是一列互不相交的开集, $A_i \subset U_i$,
    是否有$\mu^*(\bigcup\limits_{i=1}^n A_i)
    =\sum\limits_{i=1}^n \mu^*(A_i)$成立?若是,请证明;若否,请举出反例.
\end{itemize}

\section{22--23春 期末A卷(沈维孝)}

\subsection{原卷}
\begin{itemize}
\item[一、]
对$ f\colon\mathbb{R} \to \mathbb{R}  $是可积函数,当$ r>0 $时定义
$$F_r( x ) =\frac{1}{2r}\int_{x-r}^{x+r}{f( x ) \text{d}x},$$
$$F( x ) =\limsup_{r\to0} F_r( x ).$$

(1)证明$ F_{r}(x) $对$ x $是实值连续函数.

(2)证明$ F(x) : \mathbb{R} \to \overline{\mathbb{R}}$是Borel可测函数.

\item[二、]
对$f\colon\mathbb{R} \to \mathbb{R}$是可积函数,求极限
$$\lim_{k\rightarrow \infty}\lim_{n\rightarrow \infty}
n\int_{1/n^2}^1{\frac{f(nx) \cos kx}{1+x^2}\text{d}x}.$$

\item[三、]
(1)叙述Lusin定理.\\
(2)设$f\colon[0,1]\rightarrow [0,1]$是Lebesgue可测函数.
证明：存在紧集$K_n \subset f([0,1]),n=1,2,\cdots$,满足
\[m(\bigcup_{n=1}^{\infty}f^{-1}(K_n))=1.\]

\item[四、]设$f\colon[0,1]\rightarrow \mathbb{R}$是Borel可测函数，
满足对任意Borel可测集$E\subset[0,1]$均成立
\[\int_{E}|f|\leq\sqrt{m(E)}.\]
(1)设$1<p<2$，证明$f\in L^{p}([0,1])$.\\
(2)举例说明$p=2$时(1)中结论不成立.



\item[五、]
Let $ f,f_{n},g\in \mathcal{L} ^{2}(\mathbb{R} ),n=1,2,\cdots $, 
$ f_{n} $ converges to $ f $ a.e. and
$$\int_{\mathbb{R}}|f_n(x)|^2\mathrm{d}x\le 1.$$
Then
$$\lim_{n\rightarrow \infty}\int_{\mathbb{R}}|f_n(x)-f(x)||g(x)|\mathrm{d}x=0.$$
\end{itemize}

\subsection{带答案}
\begin{itemize}
\item[一、]
对$ f\colon\mathbb{R} \to \mathbb{R}  $是可积函数,当$ r>0 $时定义
$$F_r(x) =\frac{1}{2r}\int_{x-r}^{x+r}{f(x) \text{d}x},$$
$$F(x) =\limsup_{r\to0} F_r(x).$$

(1)证明$ F_{r}(x) $对$ x $是实值连续函数.

(2)证明$ F(x) : \mathbb{R} \to \overline{\mathbb{R}}$是Borel可测函数.
\begin{proof}
    (1) 由$f$的可积性知$\forall \varepsilon > 0$，
    存在$\delta > 0$使得对任何测度小于$\delta$的可测集$A$成立
    $\int_A |f(x)| \mathrm{d} x < r\varepsilon$。

    不妨令上述$\delta < r$，此时$\forall x \in \mathbb{R}$及$\Delta x$
    使得$|\Delta x| < \delta$，有
    \[|F_r(x+\Delta x) - F_r(x)| 
    \le \frac{1}{2r}\bigg(\bigg|\int_{x+r}^{x+\Delta x +r} f(x) \mathrm{d} x\bigg| 
    + \bigg|\int_{x-r}^{x+\Delta x -r} f(x) \mathrm{d} x\bigg|\bigg) < \varepsilon.\]
    (2) 不妨取$\bar{F}_n(x) = \text{sup}_{r < \frac{1}{n}} F_r(x)$，
    那么$\bar{F}_n(x) \to F(x),n\to \infty$。
    只需证明每个$\bar{F}_n(x)$是Borel可测函数。
    进一步，我们来证明$\forall c \in \mathbb{R}$，$\{\bar{F}_n(x) > c\}$是开集。

    取$x_0$使得$\bar{F}_n(x_0) > c$，
    则存在$r_0 \in \big(0,\frac{1}{n}\big)$使得$F_{r_0}(x_0) > c$。
    由连续性，存在$\delta > 0$
    使得$\forall x \in (x_0-\delta ,x_0+\delta)$，$F_{r_0}(x) > c$。
    进一步，$\forall x \in (x_0-\delta ,x_0+\delta)$有$\bar{F}_n(x) > c$。
\end{proof}
\item[二、]
对$f\colon\mathbb{R} \to \mathbb{R}$是可积函数,求极限
$$\lim_{k\rightarrow \infty}\lim_{n\rightarrow \infty}
n\int_{1/n^2}^1{\frac{f(nx) \cos kx}{1+x^2}\text{d}x}.$$
\begin{proof}
    作变量代换$t=nx$，则原式化作
    $$
        \int_\frac{1}{n}^n \frac{f(t)\cos \frac{kt}{n}}{1+(\frac{t}{n})^2} \mathrm{d}t.
    $$
    令
    $$g_n(t)=\frac{f(t)\cos \frac{kt}{n}}{1+\big(\frac{t}{n}\big)^2} \chi_{(\frac{1}{n},n)}.$$
    则有诸$g_n$可测，$|g_n(t)| \le |f(t)|$且$g_n(t) \to f(t)\chi_{(0,\infty)},n\to\infty$。因此由Lebesgue控制收敛定理，
    $$
        \lim_{k \to \infty}\lim_{n\to \infty } \int_\frac{1}{n}^n \frac{f(t)\cos \frac{kt}{n}}{1+(\frac{t}{n})^2} \mathrm{d}t 
        = \lim_{k \to \infty}\int_0^\infty f(x) \mathrm{d}x 
        = \int_0^\infty f(x) \mathrm{d}x.\qedhere
    $$
\end{proof}
\item[三、]
(1)叙述Lusin定理.\\
(2)设$f\colon[0,1]\rightarrow [0,1]$是Lebesgue可测函数.
证明：存在紧集$K_n \subset f([0,1]),n=1,2,\cdots$,满足
\[m(\bigcup_{n=1}^{\infty}f^{-1}(K_n))=1.\]
\begin{proof}
    (1) 略。\\
    (2) 由Lusin定理，$\forall n \in \mathbb{N}$，
    存在闭集$F_n \subset [0,1]$使得$m([0,1]\backslash F_n) < \frac{1}{n}$
    且$f|_{F_n}$连续。进一步，存在连续函数$f_n(x)$满足$f_n(x)=f(x)$于$F_n$，
    $\sup f_n \le f,\inf f_n \ge f$。
    令$K_n=f_n(F_n)=f(F_n)\subset f([0,1])$。先证明$K_n$闭：\\
    取一列$y_i \in K_n$且$y_i \to y_0$。则存在一列$x_i \in F_n$使得$y_i = f_n(x_i)$。由于$F_n$为紧集，$x_i$有收敛子列，不妨$x_i$本身收敛到$x_0 \in F_n$。此时由$f_n$的连续性，$y_0 = f_n(x_0)$，这说明$y_0 \in K_n$。\\
    此时$F_n \subset f^{-1}(K_n)$，$m(f^{-1}(K_n)) \ge m(F_n) \ge 1-\frac{1}{n}$。因此有$m(\bigcup_{n=1}^{\infty}f^{-1}(K_n))=1.$
\end{proof}

\item[四、]设$f\colon[0,1]\rightarrow \mathbb{R}$是Borel可测函数，
满足对任意Borel可测集$E\subset[0,1]$均成立
\[\int_{E}|f|\leq\sqrt{m(E)}.\]
(1)设$1<p<2$，证明$f\in L^{p}([0,1])$.\\
(2)举例说明$p=2$时(1)中结论不成立.
\begin{proof}
    (1) 固定$1 < p <2$，取$\lambda = \frac{2}{2-p}$。
    考虑$E_n = \{ n^\lambda \leq |f| < (n+1)^\lambda \},n=1,2,\ldots$.
    由题设有
    \[n^\lambda m(E_n) \leq \int_{E_n} |f| 
    \leq \sqrt{m(E_n)} \implies m(E_n)\leq \frac{1}{n^{2\lambda}}.\]
    因此
    \[\int |f|^p \leq 1+\sum\limits_{n=1}^\infty \frac{(n+1)^{p\lambda}}{n^{2\lambda}}.\]
    由于$\frac{(n+1)^{p\lambda}}{n^{2\lambda}}\sim \frac{1}{n^2}$，前述求和有限。

    (2) 考虑$f(x)=\sum\limits_{n=2}^\infty n\chi_{E_n}$，
    其中$E_n$是互不相交、长度为$\frac{1}{10n^3}$的区间。
    显然有$f\not\in L^2([0,1])$，下证明$f$满足题设性质。
    对Borel可测集$E$，不妨假设$m(E) \leq \sum\limits_{n=2}^\infty m(E_n)$，
    否则去掉$\{f = 0\}$后，等式左边不变而右边减小。\\
    记$N \in \mathbb{N}$使得$\sum\limits_{n=N}^\infty m(E_n) \geq m(E)$
    且$\sum\limits_{n=N+1}^\infty m(E_n) < m(E)$。
    此时\[\int_E f \leq N\left(m(E)-\sum_{n=N+1}^\infty \frac{1}{10n^3}\right) 
    + \sum_{n=N+1}^\infty \frac{1}{10n^2}.\]
    我们希望有
    \[N\left(m(E)-\sum_{n=N+1}^\infty \frac{1}{10n^3}\right) 
    + \sum_{n=N+1}^\infty \frac{1}{10n^2} \leq \sqrt{m(E)},\]
    由二次函数的性质只需要对$m(E)$趋于$\sum\limits_{n=N}^\infty m(E_n)$
    和$\sum\limits_{n=N+1}^\infty m(E_n)$时验证不等式，即验证
    \[\sum_{n=N}^\infty \frac{1}{10n^2} 
    \leq \sqrt{\sum_{n=N}^\infty \frac{1}{10n^3}}\]
    对任意$N\geq 2$成立。

    对左右两边用积分放缩，$\text{LHS} \leq \frac{1}{10(N-1)},\text{RHS} \ge \sqrt{\frac{1}{20N^2}}$，而
    \[\frac{1}{10(N-1)} \leq \sqrt{\frac{1}{20N^2}} 
    \iff N^2 \leq 5(N-1)^2 \iff \left(1-\frac{1}{N}\right)^2 \geq \frac{1}{5},\]
    这是显然的。
\end{proof}


\item[五、]
Let $ f,f_{n},g\in \mathcal{L} ^{2}(\mathbb{R} ),n=1,2,\cdots $, $ f_{n} $ converges to $ f $ a.e. and
$$\int_{\mathbb{R}}|f_n(x)|^2\mathrm{d} x\le 1.$$

Then
$$\lim_{n\rightarrow \infty}\int_{\mathbb{R}}|f_n(x)-f(x)||g (x)|\mathrm{d}x=0.$$

\begin{proof}
	For any $ \varepsilon> 0 $, there exists a $ \delta>0 $ such that for any $ m(A)<\delta $ we have
	$$
		\int_A{g^2}<\varepsilon.
	$$


	At the same time, denote $E_n=\left\{ |x|>n \right\}$, then there exists an $N$ such that
	$$\int_{E_N}{g^2}<\varepsilon.$$

	By Egoroff's theorem, there exists a measurable $F$ such that $ m(\mathbb{R} \backslash (E_{N}\cup F))<\delta $, 
    and $ f_{n}(x)\vert_{F}\rightrightarrows f(x)\vert_{F} $. 
    Then there exists an $ N_{1} $ such that for any $k\ge N_{1},x\in F$, 
    we have $|f_{k}-f|^{2}<\varepsilon/m(F)$. Thus
	$$\int_F{|f_k-f|^2}<\frac{\varepsilon}{m(F)}m(F) =\varepsilon.$$
	Again we also have
	$$\int_{\mathbb{R} \backslash (E_{N}\cup F)}^{}{g^2}<\varepsilon 
    \Rightarrow \int_{\mathbb{R} \backslash F}{g^2}<2\varepsilon.$$
	Thus for any $ n\ge N+N_{1} $, we have
	\begin{align*}
        \int_{\mathbb{R}}{|f_n-f|g}&\le \int_{\mathbb{R}-F}{|f_n-f|g}+\int_F{|f_n-f|g}\\
        &\le \sqrt{\int_{\mathbb{R}}{|f_n-f|^2}\int_{\mathbb{R}-F}{g^2}}+\sqrt{\int_F{|f_n-f|^2}\int_{\mathbb{R}}{g^2}}\\
        &\le 2\sqrt{2\varepsilon}+\sqrt{M\varepsilon},
    \end{align*}

	where $M$ denotes a constant dependent on $g\in \mathcal{L}^{2}(\mathbb{R})$. Then we are done.
\end{proof}
\end{itemize}

\section{21--22春期末(王凯)}
\begin{enumerate}
\item（8分）叙述可数集的定义。并求平面中端点坐标均为有理数的长方形全体的势。

\item（8分）叙述 Egoroff 定理。并对 $[0,1]$ 上的函数列 $f_{n}(x)=x^{n}$ 验证 Egoroff 定理。

\item（8分）（1）叙述 Fubini 定理。\\
（2）设 $f(x)$ 是实直线 $\mathbb{R}$ 中 Lebesgue 可测集 $E$ 上的一个 Lebesgue可积函数．对一个正实数 $t$ 记
$$\lambda_{f}(t)=m(E(|f(x)|>t)).$$
证明：$\int_{E}|f(x)| dm(x)=\int_{(0, \infty)} \lambda_{f}(t) dm(t)$。

\item（8分）叙述有限区间 $[a, b]$ 上的绝对连续函数的定义。
设 $f$是 $[0,1]$ 上的 Lebesgue 可积函数，$f(0)=0 ; f(x)=x \sin \frac{\pi}{x}(0< x \leqslant 1)$。
证明：$f$ 不是 $[0,1]$ 上的绝对连续函数。

\item（10分）（1）叙述直线上 Lebesgue 可测集的定义。\\
（2）设 $F$ 是直线上的 Lebesgue 可测集，$m(F)<\infty$。
对 $F$ 的子集 $E$，若 $m^{*}(E)+m^{*}(F \setminus E)=m(F)$，证明 $E$ 也是Lebesgue 可测的。

\item（10分）（1）叙述依测度收敛的定义。\\
（2）设 $E$ 是实直线 $\mathbb{R}$ 中的 Lebesgue 可测集，$\{f_{n}\}$ 是 $E$ 上的实数值 Lebesgue 可测函数列，且对任何 $\epsilon>0$ 有
$$\lim_{n, m \rightarrow \infty} m(E(|f_{n}-f_{m}| \geqslant \epsilon))=0.$$
证明：存在函数 $f$ 使得 $\{f_{n}\}$ 依测度收敛于 $f$。

\item（12分）（1）对于 $1 \leqslant p \leqslant+\infty$，给出 $L^{p}(\mathbb{R})$ 的定义。\\
（2）设 $1 \leqslant p<\infty$, $f \in L^{p}(\mathbb{R})$，证明：
$$\lim_{|h| \rightarrow \infty} \int_{\mathbb{R}}|f(x+h)-f(x)|^{p} dm(x)
=2 \int_{\mathbb{R}}|f(x)|^{p} dm(x).$$

\item（12分）（1）叙述Levi引理；\\
（2）设 $f$ 是直线 $\mathbb{R}$ 上的 Lebesgue 可积函数，证明：
$$\lim_{n \rightarrow+\infty} f(x+n)=0, \text { a.e. } x \in \mathbb{R}.$$

\item（12分）设直线上Lebesgue可积函数列 $f_{n}$ 满足下列条件：\\
（i） $\sup\limits_{n} \int_{\mathbb{R}}|f_{n}(t)|\, dm(t)<\infty$；\\
（ii） $\lim\limits_{M \rightarrow \infty}\left[\sup\limits_{n} \int_{|f_{n}| \geqslant M}|f_{n}(t)|\, dm(t)\right]=0$；\\
（iii） $\lim\limits_{\delta \rightarrow 0}\left[\sup\limits_{n} \int_{|f_{n}| \leqslant \delta}|f_{n}(t)|\, dm(t)\right]=0$。

（1）若 $f_{n}$ 依测度收敛于 $f$，证明：$\lim\limits_{n \rightarrow \infty} \int_{\mathbb{R}}|f_{n}(t)-f(t)|\, dm(t)=0$。\\
（2）若 $f_{n}$ 几乎处处收敛于 $f$，结论是否成立？并说明理由。

\item（12分）将实数全体 $\mathbb{R}$ 看作有理数域 $\mathbb{Q}$ 上的线性空间，取其一组基 $\mathcal{F}$，
即：$\mathcal{F}$ 是一个实数集，且对任意 $x \in \mathbb{R}$，可取唯一一个仅有有限个分量非零的有理数数组 $\{\alpha_{e}(x)\}_{e \in \mathcal{F}}$ 使得
$$x=\sum_{e \in \mathcal{F}} \alpha_{e}(x) e.$$
证明：对每个 $e \in \mathcal{F}$, $\alpha_{e}(x)$ 均不是关于实数 $x$ 的 Lebesgue 可测函数。
\end{enumerate}

\section{21--22春 期末A卷(沈维孝)}

残缺不全的回忆版.

