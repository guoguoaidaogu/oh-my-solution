    \end{enumerate}
    
    \item $Y_{t}=\sum_{j=0}^{\infty}h_{j}X_{t-j}, \sum_{j=0}^{\infty}|h_{j}|<\infty, \{X_{t}\}$ 宽平稳, 证明：
    \[ \gamma_Y(k) = \sum_{l,j=0}^{\infty}h_{j}h_{l}\gamma_{X}(k+l-j) = \sum_{l,j=0}^{\infty}h_{j}h_{l}\gamma_{X}(k+j-l) \]
    
    \item 证明: $MA(2)$ 模型 $Y_{t}=\xi_{t}+\phi_{1}\xi_{t-1}+\phi_{2}\xi_{t-2}, \{\xi_{t}\}\sim WN(0,\sigma^{2})$ 平稳性的参数条件:
    \[ |\phi_{2}|<1, \quad \phi_{2}\pm\phi_{1}>-1 \]
    (注: 分 $\Delta<0$ 和 $\Delta\ge 0$ 两种情况计算特征方程根的模)

\end{enumerate}

