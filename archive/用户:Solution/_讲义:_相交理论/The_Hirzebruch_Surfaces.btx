
\begin{lemma}[20.2.I]
    $X$ is a scheme, $\mathcal{V}$ is a rank 2 locally
free sheaf on $X$. 
$\mathbb{P}\mathcal{V}:=\mathbf{Proj}_{\mathcal{O}_X}(\mathrm{Sym}^{\bullet}\mathcal{V}^{\vee})$.
$\sigma: X \to \mathbb{P}\mathcal{V}$ is a section of the projection $\pi: \mathbb{P}\mathcal{V} \to X$.
Then the normal bundle $\mathcal{N}_{\sigma(X)/\mathbb{P}\mathcal{V}}:= \sigma^*\mathcal{O}_{\mathbb{P}\mathcal{V}}(\sigma(X))$ 
is isomorphic to $\mathcal{L}^{\otimes 2}\otimes \det\mathcal{V}$,
where $\mathcal{L}:= \sigma^*\mathcal{O}_{\mathbb{P}\mathcal{V}}(1)$.
\end{lemma}
\begin{remark}
    In the original description in [FOAG] 20.2.I, 
    by \textbf{17.2.I},
    one section always corresponds to an exact sequence $0\to \mathscr{S}\to \mathscr{V}\to \mathscr{Q}\to 0$.
    $\mathscr{S}$ corresponds to $\mathcal{L}^{\vee}$, 
    $\mathscr{S}^{\vee}\otimes\mathscr{Q}=\mathscr{S}^{\vee \otimes 2}\otimes(\mathscr{S}\otimes\mathscr{Q})=\mathscr{S}^{\vee \otimes 2}\otimes\det \mathscr{V}$ 
    corresponds to $\mathcal{L}^{\otimes 2}\otimes\det\mathcal{V}$ here.
    We will not follow the idea in [FOAG].
    If you first read it, you can skip and acknowledge it.
\end{remark}

\begin{proof}[\textbf{Proof}]
    \textbf{1. Setup and Trivialization} \\
Choose an affine open cover $X = \bigcup U_i$ where $U_i = \operatorname{Spec} A_i$, such that the cover is \textbf{subordinate to both $\mathcal{V}^\vee$ and $\mathcal{L}$}. 
\begin{itemize}
    \item Over $U_i$, $\mathcal{V}^\vee$ is trivialized with basis $(s_{i0}^\vee, s_{i1}^\vee)$. On the overlap $U_i \cap U_j$, the transition matrix is $M_{ij} = \begin{pmatrix} A & B \\ C & D \end{pmatrix}$. Thus:
    \begin{align*}
    s_{i0}^\vee &= A s_{j0}^\vee + C s_{j1}^\vee \\
    s_{i1}^\vee &= B s_{j0}^\vee + D s_{j1}^\vee
    \end{align*}
    The transition function for $\det \mathcal{V}^\vee$ is $\det(M_{ij}) = AD - BC$.
    \item Over $U_i$, $\mathcal{L}$ is trivialized with basis $e_i$. On the overlap, $e_i = c_{ij} e_j$, meaning the transition function for $\mathcal{L}$ is $c_{ij}$.
\end{itemize}


\textbf{2. The Section and its Compatibility} \\
Locally over $U_i$, this acts on the basis as:
\[
s_{i0}^\vee \mapsto b_{i0} e_i, \quad s_{i1}^\vee \mapsto b_{i1} e_i
\]
To be compatible with the transition functions on $U_i \cap U_j$, substituting $e_i = c_{ij}e_j$ yields the relations for the coefficients:
\begin{align*}
c_{ij} b_{i0} &= A b_{j0} + C b_{j1} \\
c_{ij} b_{i1} &= B b_{j0} + D b_{j1}
\end{align*}
Because $\mathcal{O}_{\mathbb{P}\mathcal{V}}(1)|_{D_+(s_{i0}^\vee)} = \widetilde{A_i\left[\frac{s_{i1}^{\vee}}{s_{i0}^\vee}\right]\cdot s_{i0}^\vee}$,
$\sigma^* s_{i0}^{\vee}$ is also a generator of $\mathcal{L}|_{\sigma^{-1}(D_+(s_{i0}^\vee)}$,
hence $b_{i0}$ is a unit in $\Gamma(\sigma^{-1}(D_+(s_{i0}^\vee)), \mathcal{O}_{U_i})$.
Similarly, $b_{i1}$ is a unit in $\Gamma(\sigma^{-1}(D_+(s_{i1}^\vee)), \mathcal{O}_{U_i})$.


\textbf{3. The Homogeneous Ideal of the Section} \\
In the projective bundle $\mathbb{P}\mathcal{V}$, the section $\sigma(X)$ is defined locally over $U_i$ by the kernel of the surjection, which is generated by the homogeneous linear form:
\[
F_i = b_{i1}s_{i0}^\vee - b_{i0}s_{i1}^\vee
\]
Let us compute the relation between $F_i$ and $F_j$ on overlaps. Expanding $c_{ij}F_i$:
\[
c_{ij} F_i = (c_{ij} b_{i1})s_{i0}^\vee - (c_{ij} b_{i0})s_{i1}^\vee
\]
Substitute the transition relations for $s^\vee$ and $b$:
\[
c_{ij} F_i = (B b_{j0} + D b_{j1})(A s_{j0}^\vee + C s_{j1}^\vee) - (A b_{j0} + C b_{j1})(B s_{j0}^\vee + D s_{j1}^\vee)
\]
Expanding and canceling the $AB$ and $CD$ terms leaves:
\[
c_{ij} F_i = (AD - BC)(b_{j1}s_{j0}^\vee - b_{j0}s_{j1}^\vee) = \det(M_{ij}) F_j
\]
Thus, the transition relation for the homogeneous generator is:
\[
F_i = c_{ij}^{-1} \det(M_{ij}) F_j
\]

\textbf{4. Local Affine Generators of the Conormal Bundle} \\
To find the conormal bundle $\mathcal{I}/\mathcal{I}^2$, we must pass to affine charts. 
\begin{itemize}
    \item In the standard affine chart $D_+(s_{i0}^\vee) \cong \operatorname{Spec} A_i\left[\frac{s_{i1}^\vee}{s_{i0}^\vee}\right]$, we divide $F_i$ by the invertible element $s_{i0}^\vee$ to get the local generator:
    \[
    \Upsilon_{i0} = \frac{F_i}{s_{i0}^\vee} = b_{i1} - b_{i0}\frac{s_{i1}^\vee}{s_{i0}^\vee}
    \]
    \item In the other affine chart $D_+(s_{i1}^\vee) \cong \operatorname{Spec} A_i\left[\frac{s_{i0}^\vee}{s_{i1}^\vee}\right]$, we divide by $s_{i1}^\vee$:
    \[
    \Upsilon_{i1} = \frac{F_i}{s_{i1}^\vee} = b_{i1}\frac{s_{i0}^\vee}{s_{i1}^\vee} - b_{i0}
    \]
\end{itemize}
On their overlap $D_+(s_{i0}^\vee s_{i1}^\vee)$, they are related by:
\[
\Upsilon_{i0} = \frac{s_{i1}^\vee}{s_{i0}^\vee} \Upsilon_{i1}
\]

\textbf{5. Gluing the Global Generator over $\operatorname{Spec} A_i$} \\
We pull these generators back to the base space $X$ via $\sigma^*$. Since $\sigma^*(s_{i0}^\vee) = b_{i0}$ and $\sigma^*(s_{i1}^\vee) = b_{i1}$, the relation becomes:
\[
\sigma^*\Upsilon_{i0} = \frac{b_{i1}}{b_{i0}} \sigma^*\Upsilon_{i1}
\]
Cross-multiplying eliminates the fractions:
\[
b_{i0} \sigma^*\Upsilon_{i0} = b_{i1} \sigma^*\Upsilon_{i1}
\]
Let us define this common element as \textbf{$\Phi_i$}. 
Because $b_{i0}$ (resp. $b_{i1}$) is a unit in $\Gamma(\sigma^{-1}(D_+(s_{i0}^\vee)), \mathcal{O}_{U_i})$ (resp. $\Gamma(\sigma^{-1}(D_+(s_{i1}^\vee)), \mathcal{O}_{U_i})$), 
$b_{i0} \sigma^*\Upsilon_{i0}$ and $b_{i1} \sigma^*\Upsilon_{i1}$ are both generators of the conormal bundle over their respective affine charts.
Since they agree on the intersection, \textbf{$\Phi_i$ is a nowhere-vanishing global generator for the conormal bundle over the entirety of $\operatorname{Spec} A_i$}.

\textbf{6. Calculating the Transition Function for the Conormal Bundle} \\
Now we determine how $\Phi_i$ transforms to $\Phi_j$ on $U_i \cap U_j$. We first relate the local affine generators $\Upsilon_{i0}$ and $\Upsilon_{j0}$:
\begin{align*}
\Upsilon_{i0} = \frac{F_i}{s_{i0}^\vee} &= \frac{c_{ij}^{-1} \det(M_{ij}) F_j}{s_{i0}^\vee} \\
&= c_{ij}^{-1} \det(M_{ij}) \frac{s_{j0}^\vee}{s_{i0}^\vee} \left(\frac{F_j}{s_{j0}^\vee}\right) \\
&= c_{ij}^{-1} \det(M_{ij}) \frac{s_{j0}^\vee}{s_{i0}^\vee} \Upsilon_{j0}
\end{align*}
Pulling back to the section $\sigma(X)$, and noting that $\sigma^*\left(\frac{s_{j0}^\vee}{s_{i0}^\vee}\right) = \frac{b_{j0}}{c_{ij} b_{i0}}$, we get:
\[
\sigma^*\Upsilon_{i0} = c_{ij}^{-1} \det(M_{ij}) \left( \frac{b_{j0}}{c_{ij} b_{i0}} \right) \sigma^*\Upsilon_{j0} = c_{ij}^{-2} \det(M_{ij}) \frac{b_{j0}}{b_{i0}} \sigma^*\Upsilon_{j0}
\]
To recover our glued global generators $\Phi$, we multiply both sides by $b_{i0}$:
\[
b_{i0} \sigma^*\Upsilon_{i0} = c_{ij}^{-2} \det(M_{ij}) b_{j0} \sigma^*\Upsilon_{j0}
\]
Substituting the definition of $\Phi$, the local variables $b_{i0}$ and $b_{j0}$ are perfectly absorbed:
\[
\Phi_i = c_{ij}^{-2} \det(M_{ij}) \Phi_j
\]

\textbf{7. Conclusion} \\
The element $\Phi_i$ generates the conormal bundle $\mathcal{O}(-\sigma(X))|_X$ (the ideal sheaf modulo its square) over $U_i$. The transition function $g_{ij}^{\text{conormal}}$ is therefore $c_{ij}^{-2} \det(M_{ij})$. 
\begin{itemize}
    \item $c_{ij}^{-2}$ is the transition function for $\mathcal{L}^{\otimes -2}$.
    \item $\det(M_{ij})$ is the transition function for $\det \mathcal{V}^\vee$.
\end{itemize}
Thus, $\mathcal{O}(-\sigma(X))|_X \cong \mathcal{L}^{\otimes -2} \otimes \det \mathcal{V}^\vee$.
Therefore, $\mathcal{N}_{\sigma(X)/\mathbb{P}\mathcal{V}} \cong \mathcal{L}^{\otimes 2} \otimes \det \mathcal{V}$.
\end{proof}

\begin{definition}[Hirzebruch surface]
We define the \textbf{Hirzebruch surface} $\mathbb{F}_n$ as the projective bundle 
\[
\mathbb{F}_n := \mathbb{P}(\mathcal{O}_{\mathbb{P}^1} \oplus \mathcal{O}_{\mathbb{P}^1}(n))
\]
equipped with the natural projection $\pi: \mathbb{F}_n \to \mathbb{P}^1$.
\end{definition}


Consider a section $\sigma: \mathbb{P}^1 \to \mathbb{F}_n$ such that $\sigma^*\mathcal{O}_{\mathbb{F}_n}(1) = \mathcal{O}_{\mathbb{P}^1}(-n)$, which yields the following natural short exact sequence:
\[
0 \to \mathcal{O}_{\mathbb{P}^1}(n) \to \mathcal{O}_{\mathbb{P}^1} \oplus \mathcal{O}_{\mathbb{P}^1}(n) \to \mathcal{O}_{\mathbb{P}^1} \to 0
\]
(The existence follows from \textbf{17.2.I}.)

Let $\mathcal{N}$ denote the normal bundle of this section. By applying the previously established isomorphism for normal bundles of sections in projective bundles, we find that:
\[
\mathcal{N} \cong \mathcal{O}_{\mathbb{P}^1}(-n)
\]
We define the curve $E \subseteq \mathbb{F}_n$ to be the image of this section, namely $E := \sigma(\mathbb{P}^1)$. The self-intersection number of the curve $E$ on the surface $\mathbb{F}_n$ is given by the degree of its normal bundle. Therefore, we obtain:
\[
(E \cdot E) = -n
\]

Let us consider another section $\sigma': \mathbb{P}^1 \to \mathbb{F}_n$ such that $\sigma'^*\mathcal{O}_{\mathbb{F}_n}(1) = \mathcal{O}_{\mathbb{P}^1}$. This corresponds to the following exact sequence:
\[
0 \to \mathcal{O}_{\mathbb{P}^1} \to \mathcal{O}_{\mathbb{P}^1} \oplus \mathcal{O}_{\mathbb{P}^1}(n) \to \mathcal{O}_{\mathbb{P}^1}(n) \to 0
\]
Let $C$ denote the image of this section. Its self-intersection number is given by:
\[
(C \cdot C) = \deg(\mathcal{O}_{\mathbb{P}^1}^\vee \otimes \mathcal{O}_{\mathbb{P}^1}(n)) = n
\]

Let $p$ be any $k$-point of $\mathbb{P}^1$, and let $F = \pi^{-1}(p)$ denote the fiber over $p$.



There is an \textbf{observation (20.2.K)} that:
The line bundle $\mathcal{O}(F)$ is independent of the choice of the point $p$.

\begin{proof}[\textbf{Proof of the observation}]
    Since the projection morphism $\pi$ is flat, 
    the pullback of the Weil divisor $\pi^*\{p\}$ is well-defined\footnote{You can refer to Liu Qing's textbook.}. 
    We have $\mathcal{O}(F) = \mathcal{O}(\pi^*\{p\}) \cong \pi^*\mathcal{O}_{\mathbb{P}^1}(\{p\}) \cong \pi^*\mathcal{O}_{\mathbb{P}^1}(1)$. This shows that $\mathcal{O}(F)$ depends only on the degree of the point, making it independent of the specific choice of $p$.
\end{proof}

\begin{proposition}[20.2.L]
The Picard group $\operatorname{Pic}(\mathbb{F}_n)$ is generated by the classes of $E$ and $F$.
\end{proposition}

\begin{proof}[\textbf{Proof Sketch}]
We outline the idea of the proof. The base $\mathbb{P}^1$ can be covered by two affine open patches $\operatorname{Spec} k[x]$ and $\operatorname{Spec} k[y]$, glued together via $x \leftrightarrow y^{-1}$. Over $\operatorname{Spec} k[x]$, the projective bundle is locally given by $\operatorname{Proj} k[x][Z_0, Z_1]$, where $Z_0$ corresponds to the dual of $1 \in \Gamma(\operatorname{Spec} k[x], \mathcal{O}_{\mathbb{P}^1})$ and $Z_1$ corresponds to the dual of a local generator in $\Gamma(\operatorname{Spec} k[x], \mathcal{O}_{\mathbb{P}^1}(n))$. 

We can restrict our attention to an affine open subscheme $\operatorname{Spec} k[x, Z_1/Z_0] \subseteq \operatorname{Proj} k[x][Z_0, Z_1] \subseteq \mathbb{F}_n$. The closed subset defined by $V_+(Z_0)$ corresponds to the subbundle $\mathcal{O}_{\mathbb{P}^1}(n) \hookrightarrow \mathcal{O}_{\mathbb{P}^1} \oplus \mathcal{O}_{\mathbb{P}^1}(n)$, which is exactly the negative section $E$.

Note that the complement of this affine chart in $\mathbb{F}_n$, namely $\mathbb{F}_n \setminus \operatorname{Spec} k[x, Z_1/Z_0]$, 
consists of $E = V_+(Z_0)$ union the preimage under $\pi$ of the point at infinity of $\mathbb{P}^1$ (which corresponds to the origin in $\operatorname{Spec} k[y]$). This preimage is simply a fiber $F$. 

Since the Picard group of the affine space $\operatorname{Spec} k[x, Z_0/Z_1]$ is trivial, the excision exact sequence implies that $\operatorname{Pic}(\mathbb{F}_n)$ is generated by the classes of the irreducible components of the complement, which are $E$ and $F$. By a similar argument, the Picard group is also generated by $C$ and $F$.
\end{proof}



Now let's \textbf{calculate (20.2.M)} the intersection numbers for these classes.

By choosing two distinct points $p, q \in \mathbb{P}^1$ (for example, the origin of $\operatorname{Spec} k[x]$ and the origin of $\operatorname{Spec} k[y]$), their corresponding fibers $F_p$ and $F_q$ are disjoint, meaning $F_p \cap F_q = \emptyset$. Therefore, the self-intersection of the fiber class is zero:
\[
(F \cdot F) = (F_p \cdot F_q) = 0
\]

From previous results, we already know that the self-intersection of the negative section is:
\[
(E \cdot E) = -n
\]

Finally, since the embedding $E \hookrightarrow \mathbb{F}_n$ acts as a section of the projection $\pi$, it intersects every fiber in exactly one point. Therefore, the intersection number is:
\[
(E \cdot F) = \#(E \cap F) = 1
\]
This intersection corresponds to a single point on $E \cong \mathbb{P}^1$.

Since the Picard group is generated by $E$ and $F$,
by linear independence gained by the computation above,
we have an isomorphism $\operatorname{Pic}(\mathbb{F}_n) \cong \mathbb{Z}[E] \oplus \mathbb{Z}[F]$. Thus, we can write the class of the curve $C$ as:
\[
[C] = a[E] + b[F]
\]
Using the intersection numbers, we can solve for $a$ and $b$:
\begin{align*}
(C \cdot F) &= 1 \implies a(E \cdot F) + b(F \cdot F) = a = 1 \\
(C \cdot C) &= n \implies a^2(E \cdot E) + 2ab(E \cdot F) + b^2(F \cdot F) = 1(-n) + 2b(1) = n \implies b = n
\end{align*}
Therefore, the class of $C$ is $[C] = [E] + n[F]$.

\begin{corollary}[20.2.O]
The dimension of the space of global sections satisfies $h^0(\mathbb{F}_n, \mathcal{O}_{\mathbb{F}_n}(C)) > 1$.
\end{corollary}

\begin{proof}[\textbf{Proof}]
This follows because $C$ is an effective curve with linear equivalence class $C \sim E + nF$.
\end{proof}

\begin{proposition}[20.2.P]
Every effective curve on $\mathbb{F}_n$ is a non-negative linear combination of $E$ and $F$. That is, for every effective curve $D$, there exist non-negative integers $a, b \in \mathbb{Z}_{\ge 0}$ such that $D \sim aE + bF$.
\end{proposition}

\begin{proof}[\textbf{Proof}]
It suffices to show the case when $D$ is irreducible.

If there exists a closed point $p$ such that $D = \pi^{-1}(p)$, then $D \sim F$ and we are done.

Otherwise, since $\operatorname{Pic}(\mathbb{F}_n) \cong \mathbb{Z}[E] \oplus \mathbb{Z}[F]$, we can write the class of $D$ as $D \sim aE + bF$. Because $D$ is not a fiber, its intersection with a general fiber $F$ is non-negative:
\[
(D \cdot F) \ge 0 \implies a(E \cdot F) + b(F \cdot F) = a \ge 0
\]
By Corollary 20.2.O, we can find another effective curve $C' \sim C$ different from $D$, 
hence such that $(D \cdot C') \ge 0$. 
Since $C'$ is linearly equivalent to $C$, we have $(D \cdot C) \ge 0$. Calculating this intersection yields:
\[
(D \cdot C) = (aE + bF) \cdot (E + nF) = a(-n) + an + b = b
\]
Thus, we conclude that $b \ge 0$.
\end{proof}

\begin{corollary}[20.2.Q]
The Hirzebruch surfaces $\mathbb{F}_n$ are pairwise non-isomorphic.
\end{corollary}

\begin{proof}[\textbf{Proof}]
Suppose there exists an isomorphism $\psi: \mathbb{F}_n \xrightarrow{\cong} \mathbb{F}_m$. 

We know the structure of their respective Picard groups and intersection pairings:
\begin{itemize}
    \item $\operatorname{Pic}(\mathbb{F}_n) = \mathbb{Z}[E_n] \oplus \mathbb{Z}[F_n]$ with $(E_n \cdot E_n) = -n$, $(E_n \cdot F_n) = 1$, and $(F_n \cdot F_n) = 0$.
    \item $\operatorname{Pic}(\mathbb{F}_m) = \mathbb{Z}[E_m] \oplus \mathbb{Z}[F_m]$ with $(E_m \cdot E_m) = -m$, $(E_m \cdot F_m) = 1$, and $(F_m \cdot F_m) = 0$.
\end{itemize}

The isomorphism $\psi$ induces an invertible linear map on the Picard groups:
\[
\begin{bmatrix} \psi^* E_m \\ \psi^* F_m \end{bmatrix} = \begin{bmatrix} a & b \\ c & d \end{bmatrix} \begin{bmatrix} E_n \\ F_n \end{bmatrix}
\]
and its inverse map gives:
\[
\begin{bmatrix} (\psi^{-1})^* E_n \\ (\psi^{-1})^* F_n \end{bmatrix} = \begin{bmatrix} d & -b \\ -c & a \end{bmatrix} \begin{bmatrix} E_m \\ F_m \end{bmatrix}
\]
where the determinant $ad - bc = 1$.

By Proposition 20.2.P, isomorphisms map effective curves to effective curves, so all coefficients in both transformation matrices must be non-negative. Therefore, we must have $a, b, c, d \ge 0$ as well as $-b \ge 0$ and $-c \ge 0$.

This implies $b = c = 0$. Since $ad - bc = 1$ and $a, d \ge 0$, it follows that $a = d = 1$. 

Thus, $\psi^* E_m = E_n$. Since isomorphisms preserve intersection numbers, we have:
\[
(E_m \cdot E_m) = (\psi^* E_m \cdot \psi^* E_m) = (E_n \cdot E_n)
\]
Substituting the self-intersection values yields $-m = -n$, which forces $m = n$.
\end{proof}

\begin{proposition}[20.2.S]
The nef cone of the Hirzebruch surface $\mathbb{F}_n$, denoted $\operatorname{Nef}(\mathbb{F}_n)$, is generated by the classes $C$ and $F$.
\end{proposition}

\begin{proof}[\textbf{Proof}]
By the definition of a nef divisor, a divisor class $D$ is nef if and only if its intersection number with every irreducible curve $I$ is non-negative, that is, $(D \cdot I) \ge 0$.

By Proposition 20.2.P, every effective curve (and thus every irreducible curve) $I$ can be expressed as a non-negative linear combination of $E$ and $F$. 

Therefore, by linearity of the intersection product, to check if a divisor $D$ is nef, it suffices to check its intersection with the base generators $E$ and $F$. Thus, $D$ is nef if and only if:
\[
(D \cdot E) \ge 0 \quad \text{and} \quad (D \cdot F) \ge 0
\]

Since the Picard group $\operatorname{Pic}(\mathbb{F}_n)$ is generated by $E$ and $F$, and we know that $C \sim E + nF$, the classes $C$ and $F$ also form a basis. We can therefore write any divisor class $D$ as a linear combination of $C$ and $F$:
\[
D \sim aC + bF
\]
which is linearly equivalent to $aE + (b+an)F$. 

Let us compute the intersection numbers of $D$ with $F$ and $E$:
\begin{align*}
(D \cdot F) &= (aC + bF) \cdot F = a(C \cdot F) + b(F \cdot F) = a(1) + 0 = a \\
(D \cdot E) &= (aC + bF) \cdot E = a(C \cdot E) + b(F \cdot E) = a(0) + b(1) = b
\end{align*}
(Note that we used the relation $(C \cdot E) = (E + nF) \cdot E = (E \cdot E) + n(F \cdot E) = -n + n(1) = 0$).

Consequently, the nef conditions $(D \cdot F) \ge 0$ and $(D \cdot E) \ge 0$ are exactly equivalent to:
\[
a \ge 0 \quad \text{and} \quad b \ge 0
\]

This proves that a divisor $D$ is nef if and only if it is a non-negative linear combination of $C$ and $F$. Hence, the nef cone is generated by $C$ and $F$.
\end{proof}