		\coordinate (G) at (3,-1);
		\coordinate (M) at (1,1); % AC 中点
		\coordinate (E) at (3,2); % BM 延长取 E
		
		% 三角形 ABC
		\draw (A)--(B)--(C)--cycle;
		% 中点连线
		\draw (B)--(E)--(C);
		\draw (A)--(G);
		\draw (B)--(D);
		% 点标
		\fill (A) circle (1pt) node[above] {$A$};
		\fill (B) circle (1pt) node[left] {$B$};
		\fill (C) circle (1pt) node[below left] {$C$};
		\fill (M) circle (1pt) node[below] {$M$};
		\fill (E) circle (1pt) node[right] {$E$};
		\fill (D) circle (1pt) node[right] {$D$};
		\fill (G) circle (1pt) node[below left] {$G$};
	\end{tikzpicture}
\end{figure}
