=== 5.1 曲面的基本方程 ===
\begin{tabular}{ccccc}
    !1&!2&!3&!4(1)&!4(2)--(4)\\2.9.1&2.9.2&2.9.3&例2.9.1&2.9.5\\
    !5&!6&!7&!9&!10\\2.9.4&2.9.9&2.9.10&2.9.16&2.9.17
\end{tabular}
\begin{itemize}
    \item[4.] (1) 记$\rho=\sqrt{E}=\sqrt{G}=\dfrac{1}{1+\frac{k}{4}(u^2+v^2)}$，
    则$\rho_u=-\dfrac{k}{2}u\rho^2$，从而
    \[\Big(\frac{\rho_u}{\rho}\Big)_u=-\frac{k}{2}(u\rho)_u
    =-\frac{k}{2}(\rho+u\rho_u)=-\frac{k}{2}\Big(\rho-\frac{k}{2}u^2\rho^2\Big).\]
    由此，\begin{align*}
        K&=-\frac{1}{\rho^2}\bigg[\Big(\frac{\rho_u}{\rho}\Big)_u
        +\Big(\frac{\rho_v}{\rho}\Big)_v\bigg]\\
        &=\frac{k}{2\rho^2}\Big(\rho-\frac{k}{2}u^2\rho^2+\rho-\frac{k}{2}v^2\rho^2\Big)\\
        &=k\bigg[\frac{1}{\rho}-\frac{k}{4}(u^2+v^2)\bigg]\\
        &=k.
    \end{align*}
    (2) 记$\rho=\sqrt{E}=\sqrt{G}=a/v$，则
    \[K=-\frac{1}{(a/v)^2}\bigg(\frac{-a/v^2}{a/v}\bigg)_v=-\frac{1}{a^2}.\]
    (3) $\sqrt{E}=1$，$\sqrt{G}=e^{\frac{u}{a}}$，则
    \[K=-e^{-\frac{u}{a}}\big(e^{\frac{u}{a}}\big)_{uu}=-\frac{1}{a^2}.\]
    (4) $\sqrt{E}=1$，$\sqrt{G}=\ch\dfrac{u}{a}$，则
    \[K=-\ch^{-1}\frac{u}{a}\Big(\ch\frac{u}{a}\Big)_{uu}=-\frac{1}{a^2}.\]

    \item[8.] 球面$K>0$，柱面$K=0$，鞍面
    \[K=\frac{z_{xx}z_{yy}-z_{xy}^2}{(1+z_x^2+z_y^2)^2}=\frac{-4}{(1+4(x^2+y^2))^2}<0.\]
\end{itemize}

