    \coordinate [label=center:$y$] (y) at (2.75,-0.03);
    \coordinate [label=center:$O$] (O) at (-0.16,0.13);
    \coordinate [label=center:$\varPi(x)$] (Pix) at (-2.41,0.27);
    \coordinate [label=center:$\varPi(y)$] (Piy) at (2.1,0.77);
    \draw (0,0) circle (60pt);
    \draw[dashed] (0,2.1)--(0,-2.1);
    \draw (-2.06,0.5)--(-2.5,0.5)--(-4,-1)--(2.5,-1)--(4,0.5)--(2.06,0.5);
    \draw[dashed] (-2.1,0.5)--(2.1,0.5);
    \draw[dashed] (-2,-0.4)--(0,0)--(2.1,0);
    \draw (-2,-0.4)--(-3,-0.6)--(2.6,0)--(2.1,0);
    \draw (-2,0.31)--(-3,-0.6);
    \draw[dashed] (0,2.1)--(-2,0.31)--(0,-2.1);
    \draw (1.7,0.8)--(2.6,0);
    \draw[dashed] (0,2.1)--(1.7,0.8)--(0,-2.1);
    \draw[dashed] (1.7,0.8)--(-2,0.31);
