\setdisplaytitle{Solution\ to\ GTM249\ Chapter\ 2\ Part\ II}
\sethtmltitle{Solution\ to\ GTM249\ Chapter\ 2\ Part\ II}

\section*{2.4 More About Distributions and the Fourier Transform}
\begin{itemize}
\item[2.4.1]

Any sequence of functions
$$g(x)\frac{e^{-2\pi ix\cdot(\xi+h_ne_j)}-e^{-2\pi ix\cdot\xi}}{h_n}$$
where $e_j$ is the unit vector with $1$ in the $j$th entry and
 $h_n\rightarrow0$ as $n\rightarrow\infty$ converges pointwise to
$$g(x)(-2\pi ix_j)e^{-2\pi ix\cdot\xi},$$
and is bounded by (use $|e^{ia}-e^{ib}|\le|a-b|$)
$$|g(x)(-2\pi ix_j)|,$$
which is expected to be integrable.
Under such assumption, it follows from the Lebesgue dominated convergence theorem that
$$\int_{\R^n} g(x)\frac{e^{-2\pi ix\cdot(\xi+h_ne_j)}-e^{-2\pi ix\cdot\xi}}{h_n}\,dx
\rightarrow\int_{\R^n} g(x)(-2\pi ix_j)e^{-2\pi ix\cdot\xi}\,dx.$$
In other words,
$$\frac{\partial\widehat{g}}{\partial \xi_j}(\xi)
=\int_{\R^n} g(x)(-2\pi ix_j)e^{-2\pi ix\cdot\xi}\,dx.$$

Take $g(x)=f(x)(-2\pi ix)^\alpha$ for all multi--indices $\alpha$ 
with sizes $|\alpha|=0,\cdots,M-1$ consecutively, 
which all satisfy the integrability hypothesis since
$$|g(x)(-2\pi ix_j)|=|f(x)(-2\pi ix)^{\alpha+e_j}|
\leq\frac{(2\pi)^{|\alpha|+1}C}{(1+|x|)^{N-(|\alpha|+1)}}$$
where $N-(|\alpha|+1)>(M+n)-M=n$.

Now we get the expression for $\widehat{f}^{(M)}$, 
and therefore $\widehat{f}\in\mathscr{C}^M$.

\item[2.4.2]

A bounded harmonic function, which is surely a tempered distribution, 
must be a polynomial by Corollary 2.4.3, 
and is a constant as all polynomials tend to $\infty$ as $x\rightarrow\infty$.

Suppose that $p(z)$ is a polynomial on $\mathbb{C}$ without any complex root. 
Then the entire function  $\frac{1}{p(z)}$, 
which is a complex--valued harmonic function on $\R^2$, 
is bounded as it tends to $0$ as $z\rightarrow\infty$, 
and is therefore a constant by Liouville's theorem for harmonic functions, 
yielding a contradiction.

\item[2.4.3]

$e^x$ is not in $\mathscr{S}'(\R)$, as $e^{-x}\eta\in\mathscr{S}(\R)$ where 
$\eta$ is a smooth function that equals $1$ for $x>0$ and vanishes for $x<-1$, 
but $\langle e^x,e^{-x}\eta\rangle=\int\eta$ does not converge.

For all $f\in\mathscr{S}(\R)$,
$$|\langle e^xe^{ie^x},f\rangle|=|\langle e^{ie^x}\!/i,f'\rangle|
\leq\|f'\|_{L^1}\leq C\sum_{\alpha\leq3}\rho_{\alpha,1}(f)$$
by Proposition 2.2.6, so $e^xe^{ie^x}$ is in $\mathscr{S}'(\R)$ by Proposition 2.3.4 (b).

\item[2.4.4]

Recall that $\operatorname{sech}(x)=\frac{1}{\cosh(x)}=\frac{2}{e^{x}+e^{-x}}$. 
We need to show that
$$I=\int_\R\frac{2}{e^{\pi x}+e^{-\pi x}}e^{-2\pi ix\xi}\,dx=\frac{2}{e^{\pi\xi}+e^{-\pi\xi}}.$$
Let $$f(z)=\frac{2}{e^{\pi z}+e^{-\pi z}}e^{-2\pi iz\xi}.$$
Integrate $f(z)$ over the rectangle contour $\gamma_R$ 
with corners $(-R,0)$, $(R,0)$, $(-R,i)$ and $(R,i)$, 
using that $f(z+i)=-e^{2\pi\xi}f(z)$ and that the integral of $f$ 
over the two vertical sides goes to $0$ as $R\rightarrow\infty$ 
since $|f(z)|\leq \frac{2}{e^{\pi R}}e^{2\pi|\xi|}$ 
when $\operatorname{Re}z=\pm R$, we get
$$\big(1-(-e^{2\pi\xi})\big)I=\lim_{R\rightarrow\infty}\int_{\gamma_R}f(z)\,dz
=2\pi i\operatorname{Res}\Big(f,\frac{i}{2}\Big),$$
and proceed our calculation as follows:
\begin{align*}
    I&=\frac{1}{1+e^{2\pi\xi}}\,2\pi i\lim_{z\rightarrow\frac{i}{2}}\frac{2(z-\frac{i}{2})}{e^{\pi z}+e^{-\pi z}}e^{-2\pi i\frac{i}{2}\xi}\\
    &=\frac{2}{e^{\pi\xi}+e^{-\pi\xi}}\,2\pi i\,\frac{1}{(e^{\pi z}+e^{-\pi z})'|_{z=\frac{i}{2}}}\\
    &=\frac{2}{e^{\pi\xi}+e^{-\pi\xi}}.
\end{align*}

\item[2.4.5]

Let $w$ be a smooth function the support of whose Fourier transform is $[-1/2,1/2]$ 
and let $\phi$ be a real-valued smooth nonconstant periodic function with period $1$, 
which we can make further assumptions upon later. 
Then take a family of Schwartz functions
$$f_a(x)=w(x)e^{i\phi(x-a)}\quad\textup{for }a\in(0,1/3).$$
Clearly it is an uncountable family of Schwartz functions 
such that $|f_a|=|f_b|$ for all $a$ and $b$, and we will show that 
the $f_a$'s are linearly independent, which will be addressed later, 
and that $|\widehat{f_a}|=|\widehat{f_b}|$. 
To this end, we expand the function $e^{i\phi(x)}$ in the Fourier series
$$e^{i\phi(x)}=\sum_{k=-\infty}^\infty c_ke^{2\pi ikx}.$$
Then
$$f_a(x)=\sum_{k=-\infty}^\infty c_ke^{-2\pi ika}e^{2\pi ikx}w(x),$$
so
$$\widehat{f_a}(\xi)=\sum_{k=-\infty}^\infty c_ke^{-2\pi ika}\widehat{w}(\xi-k).$$

Since the functions $\widehat{w}(\xi-k)$ are supported in 
mutually disjoint intervals $[k-1/2,k+1/2)$, we have
$$|\widehat{f_a}(\xi)|=|c_k\widehat{w}(\xi-k(\xi))|,$$
where $k(\xi)$ is the integer such that $\xi-k(\xi)\in [-1/2,1/2)$, 
which shows that $|\widehat{f_a}(\xi)|$ is independent of $a$.

Now we return to the linear independence of the $f_a$'s, 
under certain additional assumption on $\phi$. Suppose that
$$\sum_{k=1}^nd_ke^{i\phi(x-a_k)}=0$$
for some distinct $a_k\in(0,1/3)$. Let $\phi(x)$ coincide with $\frac{1}{x}$ on $(1/3,1)$, then
$$\sum_{k=1}^nd_ke^{\frac{i}{z-a_k}}=0$$
by the uniqueness of meromorphic functions 
as the left side equals $0$ for $z\in(2/3,1)$ (hence $z-a_k\in(1/3,1)$). 
Taking $z=i\varepsilon+a_k$ where $\varepsilon\rightarrow0^+$ gives $d_k=0$.

\item[2.4.6]

We are going to verify that $(P_y*f)(x)$ satisfies the mean value property 
and is continuous on $\R_+^{n+1}$. 
The two properties together imply that $f$ is harmonic.
(Sketch: On any ball consider the difference of such a function 
and the harmonic function solving the Dirichlet problem 
where the boundary--value is given by its confinement, 
which supposedly attains its nonzero maximum or minimum on a closed set, 
at the farthest point away from the center of the ball of which 
the mean value property fails.)
%定义平均积分\intbar
\newcommand\tbbint{{-\mkern -16mu\int}}
\newcommand\dbbint{{-\mkern -19mu\int}}
\newcommand\intbar{{\mathchoice{\dbbint}{\tbbint}{\tbbint}{\tbbint}}}

First establish the mean value property: 
for a ball $B$ in $\R_+^{n+1}$ centering at $(x_0,y_0)$,
\begin{align*}
    \intbar_{\!\!\!\!B} (P_y*f)(x)\,d\bar{x}
    &=\intbar_{\!\!\!\!B}\int_{\R^n}\!\!P_y(x-z)f(z)\,dzd\bar{x}\\
    &=\int_{\R^n}\Big(\ \intbar_{\!\!\!\!B}\ P_y(x-z)\,d\bar{x}\Big)f(z)\,dz\\
    &=\int_{\R^n}\!\!P_{y_0}(x_0-z)f(z)\,dz\\
    &=(P_{y_0}*f)(x_0),
\end{align*}
where $\bar{x}=(x,y)$ and a slash through an integral denotes an average.

Then check its continuity:
\begin{align*}
    |(P_{y'}*f)(x')-(P_y*f)(x)|
    \leq\|P_{y'}(x'-x+\,\cdot\,)-P_y(\,\cdot\,)\|_{L^{p'}}\|f\|_{L^p}
    \rightarrow0
\end{align*}
as $(x',y')\rightarrow(x,y)$, where $\frac{1}{p}+\frac{1}{p'}=1$ and 
$\|P_{y'}(x'-x+\,\cdot\,)-P_y(\,\cdot\,)\|_{L^{p'}}\rightarrow0$ 
is easily confirmed by, say, the Lebesgue dominated convergence theorem.

To show that $P_{y_1}*P_{y_2}=P_{y_1+y_2}$, 
it suffices to show that their Fourier transforms agree. 
Indeed, applying Proposition 2.2.11 (8) and Exercise 2.2.11, 
$$\widehat{P_y}=(y^{-n}\delta^y P)^\wedge=\delta^y \widehat{P}=e^{-2\pi y|\xi|},$$
so
$$(P_{y_1}*P_{y_2})^\wedge=\widehat{P_{y_1}}\widehat{P_{y_2}}
=e^{-2\pi y_1|\xi|}e^{-2\pi y_2|\xi|}=e^{-2\pi (y_1+y_2)|\xi|}
=\widehat{P_{y_1+y_2}}.$$

\item[2.4.7]
(a) Observe that $v(x;x_0)$ is harmonic is equivalent to 
$v(x+x_0;x_0)$ is harmonic, where
\begin{align*}
    v(x+x_0;x_0)&=(|x_0|^2-|x+x_0|^2)|x|^{-n}\\
    &=-2x_0\cdot x|x|^{-n}-|x|^{2-n}
\end{align*}
is a linear combination of the harmonic function $|x|^{2-n}$ and 
its partial derivatives $\frac{\partial}{\partial x_j}|x|^{2-n}=(2-n)x_j|x|^{-n}$ 
for $n\geq3$, and $\frac{\partial}{\partial x_j}\log|x|=x_j|x|^{-2}$ for $n=2$.

Alternatively, one may calculate directly as follows:
\begin{align*}
    \Delta v(x+x_0;x_0)
    &=\Delta\big((1-|x+x_0|^2)\cdot|x|^{-n}\big)\\
    &=\Delta(1-|x+x_0|^2)|x|^{-n}+2\nabla(1-|x+x_0|^2)\cdot\nabla(|x|^{-n})
    +(1-|x+x_0|^2)\Delta|x|^{-n}\\
    &=(-2n)|x|^{-n}+2(-2(x+x_0))\cdot(-n|x|^{-n-2}x)
    +(1-|x+x_0|^2)\,2n|x|^{-n-2}\\
    &=2n\,|x|^{-n-2}\big(\!-|x|^2+2(x+x_0)\cdot x+|x_0|^2-|x+x_0|^2\big)\\
    &=0,
\end{align*}
in which the calculation of $\Delta|x|^{-n}$ deserves elaboration:
\begin{align*}
    \Delta|x|^{-n}
    &=\operatorname{div}\big(\!-\!nx|x|^{-n-2}\big)
    =-n\big(\operatorname{div}(x)|x|^{-n-2}+x\cdot\nabla|x|^{-n-2}\big)\\
    &=-n\Big(n|x|^{-n-2}+x\cdot\Big(\frac{-n-2}{2}|x|^{-n-4}2x\Big)\Big)
    =2n|x|^{-n-2}.
\end{align*}

(b) For $\theta\in\mathbf{S}^{n-1}$ such that $|\theta-x_0|>\delta$, we have
\begin{align*}
    v(rx_0;\theta)=\frac{1-r^2}{|rx_0-\theta|^n}
    =\frac{1-r^2}{|(r-1)x_0+(x_0-\theta)|^n}
    \leq\frac{1-r^2}{(\delta-(1-r))^n}.
\end{align*}
Then
\begin{align*}
\int_{\begin{subarray}{c}
\theta\in\mathbf{S}^{n-1} \\ |\theta-x_0|>\delta 
\end{subarray}}v(rx_0;\theta)\,d\theta
\leq\omega_{n-1}\frac{1-r^2}{(\delta-(1-r))^n}
\end{align*}
tends to $0$ uniformly in $x_0$ as $r\uparrow1$.

(c) $$\frac{1}{\omega_{n-1}}\int_{\mathbf{S}^{n-1}}\frac{1-|x|^2}{|x-\theta|^n}\,d\theta
=\intbar_{\!\!\!\mathbf{S}^{n-1}}\frac{1-\big||x|\theta\big|^2}{\big||x|\theta-\frac{x}{|x|}\big|^n}\,d\theta=1,$$
where the first equality is justified by the illustration below, 
and the second by the mean value property of the integrand 
which is the harmonic function $\theta\mapsto v(|x|\theta;\frac{x}{|x|})$
and $v(0;\frac{x}{|x|})=1$.
\begin{center}
    \begin{tikzpicture}[scale=2]
    \coordinate [label=right:$\theta$] (x) at (6.66,0.14);
    \coordinate [label=right:$\frac{x}{|x|}$] (y) at (6.33,0.68);
    \coordinate [label=right:$x$] (z) at (6.0,0.28);
    \coordinate [label=right:$|x|\theta$] (w) at (6.15,-0.07);
    \draw (6,0) circle (20pt);
    \draw (6,0) -- (6.68,0.13) -- (6.2,0.24);
    \draw (6,0) -- (6.45,0.53)  -- (6.305,0.055);
\end{tikzpicture}
\end{center}

(d) The harmonicity of $u$ is easily shown 
by taking the Laplacian inside the integral; 
the continuity of $u$ at the boundary is 
a consequence of the observation in part (b) that 
the Poisson kernel $v(rx_0;\theta)$ is massed at $\theta$ as $r\uparrow1$ 
--- to put it more clearly, by part (c) we have
\begin{align*}
    |u(rx_0)-f(x_0)|
    &=\bigg|\ \intbar_{\!\!\!\mathbf{S}^{n-1}}\big(f(\theta)-f(x_0)\big)v(rx_0;\theta)\,d\theta\bigg|\\
    &\leq\sup_{|\theta-x_0|\leq\delta}\!\!|f(\theta)-f(x_0)|\cdot\intbar_{\!\!\!\mathbf{S}^{n-1}}v(rx_0;\theta)\,d\theta\\
    &+\sup_{\theta\in\mathbf{S}^{n-1}}|f(\theta)-f(x_0)|\cdot\frac{1}{\omega_{n-1}}\int_{\begin{subarray}{c}
    \theta\in\mathbf{S}^{n-1} \\ |\theta-x_0|>\delta \end{subarray}}v(rx_0;\theta)\,d\theta,
\end{align*}
first choose $\delta$ small enough so that 
the first term is vanishingly small by the continuity of $f$, 
and then for the fixed $\delta$, let $r\uparrow1$ 
so that the second term becomes vanishingly small as well by part (b).

\item[2.4.8]

(a) In Appendix D.4 the following identity is obtained:
$$\int_{\mathbf{S}^{n-1}}\frac{d\theta}{|\theta-e_1|^\alpha}
=\frac{\omega_{n-2}}{2^\frac{\alpha}{2}}\int_{-1}^{+1}(1-s)^\frac{n-3-\alpha}{2}(1+s)^{\frac{n-3}{2}}ds.$$

Since $\mathbf{S}^n$ is invariant 
under the rotation that carries $\eta$ to $e_1$, we get
\begin{align*}
    \int_{\mathbf{S}^n}|\xi-\eta|^{-\lambda}\,d\xi
    &=\int_{\mathbf{S}^n}|\xi-e_1|^{-\lambda}\,d\xi\\
    &=\frac{\omega_{n-1}}{2^\frac{\lambda}{2}}\int_{-1}^{+1}(1-s)^{\frac{n-\lambda}{2}-1}(1+s)^{\frac{n}{2}-1}\,ds\\
    &=\frac{\omega_{n-1}}{2^\frac{\lambda}{2}}\int_{-1}^{+1}(2-2t)^{\frac{n-\lambda}{2}-1}(2t)^{\frac{n}{2}-1}\,d(2t-1)\\
    &=\omega_{n-1}2^{n-\lambda-1}\int_{0}^{1}(1-t)^{\frac{n-\lambda}{2}-1}t^{\frac{n}{2}-1}\,dt\\
    &=\omega_{n-1}2^{n-\lambda-1}B\Big(\frac{n-\lambda}{2},\frac{n}{2}\Big)\\
    &=\frac{2\pi^\frac{n}{2}}{\varGamma(\frac{n}{2})}2^{n-\lambda-1}
    \frac{\varGamma(\frac{n-\lambda}{2})\varGamma(\frac{n}{2})}{\varGamma(n-\frac{\lambda}{2})}\\
    &=\pi^\frac{n}{2}2^{n-\lambda}\frac{\varGamma(\frac{n-\lambda}{2})}{\varGamma(n-\frac{\lambda}{2})}.
\end{align*}

(b) Notice that
\begin{align*}
    &\int_{\R^n}|x-y|^{-\lambda}(1+|x|^2)^\frac{\lambda}{2}(1+|y|^2)^\frac{\lambda}{2}(1+|x|^2)^{-n}\,dx\\
    =&\int_{\R^n}(|\varPi(x)-\varPi(y)|/2)^{-\lambda}J_\varPi(x)/2^n\,dx\\
    =&\ 2^{\lambda-n}\int_{\mathbf{S}^{n-1}}|\xi-\eta|^{-\lambda}\,d\xi\\
    =&\ \frac{\pi^\frac{n}{2}\varGamma(\frac{n-\lambda}{2})}{\varGamma(n-\frac{\lambda}{2})},
\end{align*}
where $\varPi$ is the stereographic projection in Appendix D.6, 
in the first equality the so--called interesting formula 
$|\varPi(x)-\varPi(y)|=2|x-y|(1+|x|^2)^{-1/2}(1+|y|^2)^{-1/2}$ is used, 
and the last equality is by (a), from which we deduce that 
the Jacobian of $\varPi$ is $J_\varPi(x)=\big(\frac{2}{1+|x|^2}\big)^n$ 
(instead of $J_\varPi(x)=\big(\frac{2}{1+|x|^2}\big)^{-n}$ as Appendix D.6 claims).

Now we give a proof of the formula for $|\varPi(x)-\varPi(y)|$.
