\section{Fourier级数的唯一性}
\subsection{Cantor引理, Riemann第一定理, Riemann第二定理, Cantor--Lebesgue定理, Du Bois-Reymond-de la Vall\'{e}e-Poussin定理}
\begin{lemma}[Cantor引理]\label{anbn}
设\(\sum_{n=1}^{\infty}\left(a_n\cos nx+b_n\sin nx\right)\)在区间\([a,b]\)上收敛, 
则\(\lim_{n\rightarrow+\infty}a_n=\lim_{n\rightarrow+\infty}b_n=0\).
\end{lemma}
\begin{lemma}[Riemann第二定理]\label{Riemma}
设\(\lim_{n\rightarrow+\infty}c_n=0\), 则\[\lim_{h\rightarrow 0}\sum_{n=1}^{\infty}\frac{c_n\sin^2nh}{n^2h}=0.\]
\end{lemma}
\begin{lemma}\label{end}
设\(\sum_{n=1}^{\infty}c_n=A\), 则\[\lim_{h\rightarrow 0}\sum_{n=1}^{\infty}c_n\left(\frac{\sin nh}{nh}\right)^2=A.\]
\end{lemma}
