\item 试利用闭区间套定理证明引理\ref{anbn}.
\begin{proof}

\end{proof}
\item 利用例12.1.1证明引理\ref{Riemma}.
\begin{proof}

\end{proof}
\end{enumerate}
\end{quiza}
