\end{enumerate}
\end{quizb}

\section{Fourier变换}
\subsection{Fourier变换,速降函数(Schwarz函数), Fourier变换的导数,导数的Fourier变换, Fourier逆变换,卷积的Fourier变换,乘积的Fourier变换, Plancherel定理, Hausdorff--Young不等式,处处连续无处可微函数,处处连续无处H\"{o}lder连续函数,热传导方程求解, Heisenberg不确定性原理, \(L^1(\mathbb{R}^n)+L^2(\mathbb{R}^n)\)上的Fourier变换, Borwein积分}
\begin{theorem}\label{Th:C12ff}
设\(f,g\in\mathscr{S}\), 则\[\begin{split}
&(f*g)^{\land}(\boldsymbol{x})=\widehat{f}(\boldsymbol{x})\widehat{g}(\boldsymbol{x}),\quad\forall\boldsymbol{x}\in\mathbb{R}^n,\\
&(fg)^{\land}(\boldsymbol{x})=(\widehat{f}*\widehat{g})(\boldsymbol{x}),\quad\forall\boldsymbol{x}\in\mathbb{R}^n.
\end{split}\]
\end{theorem}
\begin{theorem}\label{Th:C12fe}
设\(f,g\in\mathscr{S}\), 则\[\int_{\mathbb{R}^n}f(\boldsymbol{x})\overline{g(\boldsymbol{x})}\,\dd\boldsymbol{x}=\int_{\mathbb{R}^n}\widehat{f}(\boldsymbol{x})\overline{\widehat{g}(\boldsymbol{x})}\,\dd\boldsymbol{x}.\]
\end{theorem}
\begin{quiza}
\begin{enumerate}
\item 设\(f\in L^1(\mathbb{R}^n),g(\boldsymbol{x})=f(r\boldsymbol{x})\), 
其中\(r>0\)为给定实数, 试用\(f\)的Fourier变换表示\(g\)的Fourier变换.
\begin{proof}[解答]
	
\end{proof}
\item 设\(f\in C_c^2(\mathbb{R})\), 证明\(\lim_{x\rightarrow\infty}|x^2\widehat{f}(x)|=0\). 
进而对于任何\(g\in L^{\infty}(\mathbb{R})\), 有
\[\lim_{T\rightarrow +\infty}\sum_{n=-\infty}^{+\infty}\frac{1}{T}\widehat{f}\left(\frac{n}{T}\right)g\left(\frac{n}{T}\right)
=\int_{\mathbb{R}}\widehat{f}(x)g(x)\,\dd x.\]
\begin{proof}
	$L^\infty(\R)$函数$g$改变可数个点上的取值还是同一个函数，
    由此等号左边是无意义的表达式，本题当是错题。
\end{proof}
\item 对于\[f\in X_a=\{f\big|f\text{ 非负, 偶, }
\operatorname{supp}f=\left[-\frac{a}{2},\frac{a}{2}\right],\,f\text{ 在}\left(-\frac{a}{2},\frac{a}{2}\right)\text{内 Lipschitz 连续}\},\]
证明: \(\int_{\mathbb{R}}\widehat{f}(x)\,\dd x=f(0).\)
\begin{proof}
	
\end{proof}
\item 设\(f(x)=\pi\ee^{-2\pi |x|}(x\in\mathbb{R})\). 试求\(f\)的Fourier变换.
\begin{proof}[解答]
	\(\hat{f}(\xi)=\frac{1}{1+\xi^2}\)，具体过程见[[用户：Solution/ 解答：GTM249 Chapter 2 Part I|习题2.2.11]]。
\end{proof}
\item 证明: \(g(z)=\int_{-\infty}^{+\infty}\ee^{-\pi y^2}\ee^{2\pi yz}\,\dd y\)复可导.
\begin{proof}
	全纯函数列\(g_n(z)=\int_{-n}^{n}\ee^{-\pi y^2}\ee^{2\pi yz}\,\dd y\)
    在有界区域上一致收敛于$g(z)$。
\end{proof}
\item 试用积分号下求导的方法计算
\[F(x)=\int_{\R}\ee^{-\pi y^2}\ee^{-2\pi\mathrm{i}xy}\,\dd y,\qquad x\in\mathbb{R}.\]
\begin{proof}[解答]
	首先\(F(0)=\int_{\R}\ee^{-\pi y^2}\dd y\), 即
    \[F(0)=\int_{-\infty}^{+\infty}\ee^{-\pi y^2}\dd y
    =\frac{1}{\sqrt{\pi}}\int_{-\infty}^{+\infty}\ee^{-t^2}\dd t=1,\]
    又\[F'(x)=\int_{\R}\ee^{-\pi y^2}\ee^{-2\pi\ii xy}(-2\pi\ii y)\,\dd y
    =-2\pi\ii\ee^{-\pi x^2}\int_{\R}\ee^{-\pi(y+\ii x)^2}y\,\dd y,\]
    由\[\begin{split}
	&\int_{\R}\ee^{-\pi(y+\ii x)^2}y\,\dd y
    =\int_{\R}\ee^{-\pi(y+\ii x)^2}\left(\left(y+\ii x\right)-\ii x\right)\dd y\\
    &=\frac{1}{2}\int_{\R}\ee^{-\pi(y+\ii x)^2}\dd\left(y+\ii x\right)^2-\ii x\int_{\R}\ee^{-\pi(y+\ii x)^2}\dd y=-\ii x,
	\end{split}\]于是\(F'(x)=-2\pi x\ee^{-\pi x^2}\), 可知
    \[F(x)=\int_{0}^{x}F'(t)\,\dd t+F(0)=\ee^{-\pi x^2}.\qedhere\]
\end{proof}
\end{enumerate}
\end{quiza}

\begin{quizb}
\begin{enumerate}
\item 试仿下列等式给出一些类似的等式.

对于正数\(a_1,a_2,\cdots,a_n\), 当且仅当\(a_1+a_2+\cdots+a_n\leqslant 1\)时, 成立
\[\begin{split}
&\int_{0}^{+\infty}\frac{\sin x}{x}\cdot\frac{\pi^2\cos a_1x}{\pi^2-4a_1^2x^2}\cdots\frac{\pi^2\cos a_nx}{\pi^2-4a_n^2x^2}\,\dd x=\frac{\pi}{2},\\
&\frac{1}{2^n\sin^n(1/2)}\int_{0}^{+\infty}\prod_{k=1}^{n}\left(\frac{\sin\frac{2a_kx+1}{2}}{2a_kx+1}+\frac{\sin\frac{2a_kx-1}{2}}{2a_kx-1}\right)\dd x=\frac{\pi}{2},\\
&\int_{0}^{+\infty}\frac{\sin x}{x}\frac{\pi^2-2a_1\pi x\sin a_1x}{\pi^2-4a_1^2x^2}\cdots\frac{\pi^2-2a_n\pi x\sin a_nx}{\pi^2-4a_n^2x^2}\,\dd x=\frac{\pi}{2},\\
&3^n\int_{0}^{+\infty}\frac{\sin x}{x}\frac{\sin a_1x-a_1x\cos a_1x}{a_1^3x^3}\cdots\frac{\sin a_nx-a_nx\cos a_nx}{a_n^3x^3}\,\dd x=\frac{\pi}{2}.\\
\end{split}\]
\begin{proof}[解答]
	
\end{proof}
\item 设\(f\in C^1(\mathbb{R})\), 且\(\int_{\mathbb{R}}\left(f^2(x)+(f'(x))^2\right)\dd x=1\). 
证明: \(\lim_{x\rightarrow\infty}f(x)=0\), 且\(\left\|f\right\|_{\infty}<\frac{\sqrt{2}}{2}\).
\begin{proof}
(1) 由 \(\int_{-\infty}^{+\infty} f^2(x)\,dx\) 的收敛性得到，
存在一列 $x_n \rightarrow+\infty$ 使得 $f(x_n) \rightarrow 0$。
于是当 $x>x_n$ 时，
\begin{align*}
    f^2(x)&=f^2(x_n)+\int_{x_n}^x 2 f(t) f'(t)\,dt\\
    &\leqslant f^2(x_n)+\int_{x_n}^{+\infty}\left(f^2(t)+(f'(t))^2\right) dt.
\end{align*}
所以
\[\varlimsup_{x \rightarrow+\infty} f^2(x) \leqslant f^2(x_n)+\int_{x_n}^{+\infty}\left(f^2(t)+(f'(t))^2\right) dt, \quad \forall n \geqslant 1.\]
在上式中令 $n \rightarrow+\infty$ 得到 \(\varlimsup_{x \rightarrow+\infty} f^2(x) \leqslant 0\)，即 \(\lim_{x \rightarrow+\infty} f(x)=0\)。
类似地有 \(\lim_{x \rightarrow-\infty} f(x)=0\)。从而 \(\lim_{x \rightarrow \infty} f(x)=0\)。

(2) 由 (1)，$f(+\infty)=f(-\infty)=0$。所以
\begin{align*}
f^2(x) & =\frac{1}{2}\left(f^2(x)-f^2(+\infty)\right)+\frac{1}{2}\left(f^2(x)-f^2(-\infty)\right) \\
& =\int_{+\infty}^x f(t) f'(t)\,dt+\int_{-\infty}^x f(t) f'(t)\,dt \\
& \leqslant \frac{1}{2} \int_{-\infty}^{+\infty}\left(f^2(t)+(f'(t))^2\right) d t=\frac{1}{2}.
\end{align*}
进一步，假设\(\|f\|_\infty=\frac{\sqrt{2}}{2}\)，
结合(1)的结论可得$|f|$的最大值在某个$a\in\R$取到，从而上面的不等式是等式，则有
\[f'(x)= \begin{cases}-f(x), & x\in(a,+\infty), \\ f(x), & x\in(-\infty,a),\end{cases}\]
由此得到
\[f(x)= \begin{cases}f(a)\,e^{a-x}, & x\in(a,+\infty), \\ f(a)\,e^{x-a}, & x\in(-\infty,a).\end{cases}\]
于是由条件中的$\|f\|_{H^1}=1$，可得 $f(a) \neq 0$。
而这时上式定义的 $f$ 在 $a$ 点不可导，矛盾。所以\(\|f\|_\infty<\frac{\sqrt{2}}{2}\)。
\end{proof}
\item 设\(\alpha\in\mathbb{R}\), 计算含参变量积分\(\int_{0}^{+\infty}\frac{\cos\left(\alpha\pi x\right)}{1+x^2}\,\dd x,\,\int_{0}^{+\infty}\frac{x\sin\left(\alpha\pi x\right)}{1+x^2}\,\dd x\).
\begin{proof}[解答]
	记\[J(\alpha)=\int_{0}^{+\infty}\frac{\cos\left(\alpha\pi x\right)}{1+x^2}\,\dd x.\]
    显然有\(J(\alpha)=J(-\alpha)\), 为此我们不妨设\(\alpha\geqslant 0\). 注意到
    \[\int_{0}^{+\infty}\ee^{-t(1+x^2)}\dd t=\frac{1}{1+x^2},\]
    于是
    \[\int_{0}^{+\infty}\cos\left(\alpha\pi x\right)\left(\int_{0}^{+\infty}\ee^{-t(1+x^2)}\dd t\right)\dd x
    =\int_{0}^{+\infty}\ee^{-t}\dd t\int_{0}^{+\infty}\ee^{-tx^2}\cos\left(\alpha\pi x\right)\dd x,\]
    记\(I(\alpha,t)=\int_{0}^{+\infty}\ee^{-tx^2}\cos\left(\alpha\pi x\right)\dd x\), 
    如果我们置\(x=\sqrt{\frac{\pi}{t}}p,\alpha=2\sqrt{\frac{t}{\pi}}q\), 则
    \[I(\alpha,t)=\sqrt{\frac{\pi}{t}}\int_{0}^{+\infty}\ee^{-\pi p^2}\cos\left(2\pi pq\right)\dd p,\]
    注意到在12.3.$\mathcal{A}$第6题中算得\[\int_{\R}\ee^{-\pi y^2}\ee^{-2\pi\ii xy}\,\dd y=\ee^{-\pi x^2},\]
    这意味着\[I(\alpha,t)=\frac{1}{2}\sqrt{\frac{\pi}{t}}\ee^{-\pi q^2}=\frac{1}{2}\sqrt{\frac{\pi}{t}}\exp\left(-\frac{\pi^2\alpha^2}{4t}\right).\]
    于是
    \[J(\alpha)=\frac{\sqrt{\pi}}{2}\int_{0}^{+\infty}\exp\left(-t-\frac{\pi^2\alpha^2}{4t}\right)\frac{\dd t}{\sqrt{t}},\]
    置\(t=u^2\), 得
    \[J(\alpha)=\sqrt{\pi}\int_{0}^{+\infty}\exp\left(-\left(u^2+\frac{\pi^2\alpha^2}{4u^2}\right)\right)\dd u
    =\sqrt{\pi}\ee^{-\pi\alpha}\int_{0}^{+\infty}\exp\left(-\left(u-\frac{\pi\alpha}{2u}\right)^2\right)\dd u,\]
    置\(y=u-\frac{\pi\alpha}{2u}\), 有\(\dd y=\left(1+\frac{\pi\alpha}{2u^2}\right)\dd u\), 并且\(u=0,y=-\infty\); \(u=+\infty,y=+\infty\), 于是
    \[\begin{split}
		\int_{-\infty}^{+\infty}\ee^{-y^2}\dd y&=\int_{0}^{+\infty}\exp\left(-\left(u-\frac{\pi\alpha}{2u}\right)^2\right)\left(1+\frac{\pi\alpha}{2u^2}\right)\dd u\\
        &=\int_{0}^{+\infty}\exp\left(-\left(u-\frac{\pi\alpha}{2u}\right)^2\right)\dd u+\frac{\pi\alpha}{2}\int_{0}^{+\infty}\exp\left(-\left(u-\frac{\pi\alpha}{2u}\right)^2\right)\frac{\dd u}{u^2},
	\end{split}\]
	对于\(\frac{\pi\alpha}{2}\int_{0}^{+\infty}\exp\left(-\left(u-\frac{\pi\alpha}{2u}\right)^2\right)\frac{\dd u}{u^2}\), 
    令\(u=-\frac{\pi\alpha}{2w}\), 则\(\dd u=\frac{\pi\alpha}{2}\frac{\dd w}{w^2}\), 于是
    \[\begin{split}
	\frac{\pi\alpha}{2}\int_{0}^{+\infty}\exp\left(-\left(u-\frac{\pi\alpha}{2}\right)^2\right)\frac{\dd u}{u^2}
    &=\frac{\alpha}{2}\int_{-\infty}^{0}\exp\left(-\left(w-\frac{\pi\alpha}{2w}\right)^2\right)\frac{2}{\pi\alpha}\dd w\\
    &=\int_{-\infty}^{0}\exp\left(-\left(w-\frac{\pi\alpha}{2w}\right)^2\right)\dd w,
	\end{split}\]
    即有\[\int_{-\infty}^{+\infty}\ee^{-y^2}\dd y=\int_{-\infty}^{+\infty}\exp\left(-\left(u-\frac{\pi\alpha}{2u}\right)^2\right)\dd u,\]
    从而
    \[\int_{0}^{+\infty}\exp\left(-\left(u-\frac{\pi\alpha}{2u}\right)^2\right)\dd u
    =\int_{0}^{+\infty}\ee^{-y^2}\dd y=\frac{\sqrt{\pi}}{2},\]
	即得\(J(\alpha)=\frac{\pi}{2}\ee^{-\pi|\alpha|}\). 
    对于\(\int_{0}^{+\infty}\frac{x\sin\left(\alpha\pi x\right)}{1+x^2}\,\dd x\), 注意到
    \[J'(\alpha)=-\pi\int_{0}^{+\infty}\frac{x\sin(\alpha\pi x)}{1+x^2}\,\dd x=-\frac{\pi^2}{2}\ee^{-\pi\alpha},\quad \alpha>0,\]
    类似可得其余结果, 最终\(\int_{0}^{+\infty}\frac{x\sin\left(\alpha\pi x\right)}{1+x^2}\,\dd x=\mathrm{sgn}(\alpha)\frac{\pi}{2}\ee^{-\pi|\alpha|}\).
\end{proof}
\item 证明: (12.3.27)式给出了方程(12.3.26)的唯一解.
\begin{proof}
	就是要说明$f=0$时$u\equiv0$。此时考虑（称为\textbf{能量}）
    \[E(t)=\int_{\R^n}u(t,\boldsymbol{x})^2\,\dd\boldsymbol{x},\]
    有\begin{align*}
        E'(t)&=2\int_{\R^n}uu_t=2\int_{\R^n}u\Delta_{\boldsymbol{x}}u\\
        &=-2\int_{\R^n}|\nabla_{\boldsymbol{x}}u|^2\leqslant0,
    \end{align*}
    结合$E(0)=0$得到$E(t)\equiv0$，从而$u\equiv0$。
    可惜这是错误的解答，分部积分产生的边界项未必消失；
    况且本题的结论也是错误的，热传导方程的解$u$并不是唯一的。
\end{proof}
