\setdisplaytitle{第11章\ 曲线积分与曲面积分}
\sethtmltitle{第11章\ 曲线积分与曲面积分}

\section{第一型曲线积分}
\subsection{曲线, Peano曲线,简单曲线,简单闭曲线,曲线的弧长,弧长参数,第一型曲线积分}
\begin{quiza}
\begin{enumerate}
\item 计算以下第一型曲线积分:
\begin{enumerate}[label=(\arabic*)]
\item \(\int_Cxyz\,\dd s,\) 其中\(C\)为空间曲线\(\begin{cases}
x(t)=\cos t,\\y(t)=\sin t,\\z(t)=t
\end{cases}t\in[0,2\pi]\).
\begin{proof}[解答]
由参数方程得
\[\int_Cxyz\,\dd s
=\int_{0}^{2\pi}\cos t\cdot\sin t\cdot t\sqrt{\sin^2 t+\cos^2 t+1}\,\dd t
=-\frac{\sqrt{2}\pi}{2}.\qedhere\]
\end{proof}
\item \(\int_Cx^2\,\dd s\), 其中\(C\)为平面曲线\(x^{2/3}+ y^{2/3}=1.\)
\begin{proof}[解答]
置\(x=\cos^3t,y=\sin^3t,t\in[0,2\pi]\), 从而
\[\int_Cx^2\,\dd s=\int_{0}^{2\pi}\cos^6t\sqrt{9\sin^2t\cos^2t}\,\dd t
=3\int_{0}^{2\pi}\cos^6t\left|\sin t\cos t\right|\dd t=\frac{3}{2}.\qedhere\]
\end{proof}
\item \(\int_C|xy|\,\dd s\), 其中\(C\)为平面曲线\((x^2+y^2)^2=x^2-y^2\).
\begin{proof}[解答]
置\(x=\sqrt{\cos 2t}\cos t,y=\sqrt{\cos 2t}\sin t,t\in\left[0,\frac{\pi}{4}\right]\), 
利用对称性则有\[\int_C|xy|\,\dd s=4\int_{0}^{\pi/4}\frac{\cos 2t\cdot\cos t\cdot\sin t}{\sqrt{\cos 2t}}\,\dd t
=\int_{0}^{\pi/2}\sin x\cos^{1/2}x\,\dd x
=\frac{1}{2}B\left(1,\frac{3}{4}\right)=\frac{2}{3}.\qedhere\]
\end{proof}
\end{enumerate}
\end{enumerate}
\end{quiza}

\begin{quizb}
\begin{enumerate}
\item 试将定积分的一些性质移植到第一型曲线积分.
\end{enumerate}
\begin{proof}[解答]

\end{proof}
\end{quizb}

\section{第一型曲面积分}
\subsection{曲面,同胚, \(k\)维\(C^m\)曲面, Schwarz的例子,集合的面积,分片\(C^m\)曲面, \(\mathbb{R}^n\)中子集的\(k\)维体积(面积),第一型曲面积分,余面积公式,楔积}
\begin{quiza}
\begin{enumerate}
\item 设\(a,b>0\), 计算椭圆柱面\(\frac{x^2}{a^2}+\frac{y^2}{b^2}=1\)
在\(z\geqslant 0,y\geqslant 0\)中夹在平面\(y=z\)和平面\(z=0\)之间部分的侧面积.
\begin{proof}[解答]
记\(L\)为在\(xOy\)平面上的曲线\(\frac{x^2}{a^2}+\dfrac{y^2}{b^2}=1\), 
结合题设有\(\frac{x^2}{a^2}+\frac{z^2}{b^2}=1\), 
即\(z(x)=b\sqrt{1-\frac{x^2}{a^2}}\), 于是面积可以表示成以下第一型曲线积分
\[\int_Lz(x)\,\dd s=\int_{0}^{\pi}b\sqrt{1-\cos^2\theta}\sqrt{a^2\cos^2\theta+b^2\sin^2\theta}\,\dd\theta.\]

选取\(x,z\)为参数, 则由\(\frac{x^2}{a^2}+\frac{y^2}{b^2}=1\)与\(y=z\)
得到题设区域到\(xOz\)面的投影
\[D=\left\lbrace(x,z)\bigg| \frac{x^2}{a^2}+\frac{z^2}{b^2}\leqslant 1, z\geqslant 0 \right\rbrace .\]
又记\(F=\frac{x^2}{a^2}+\frac{y^2}{b^2}-1=0\), 
则有\(y_x=-\frac{F_x}{F_y}=-\frac{b^2x}{a^2y}\), 于是题设区域的面积
\[S=\iint\limits_D\sqrt{1+y_x^2}\,\dd x\dd z,\]
置\(x=ar\cos\theta,z=br\sin\theta\), 
结合\(\frac{x^2}{a^2}+\frac{y^2}{b^2}=1\), 代入\(y_x\), 则有\[\begin{split}
S=\iint\limits_D\sqrt{1+y_x^2}\,\dd x\dd z
=\int_{0}^{\pi}\dd\theta\int_{0}^{1}\sqrt{1+\frac{b^2r^2\cos^2\theta}{a^2\left(1-r^2\cos^2\theta\right)}}\cdot abr\,\dd r
\end{split}\]
\end{proof}

\item 计算螺旋面\(\begin{cases}
x=r\cos\theta,\\y=r\sin\theta,\\z=a\theta
\end{cases}\left(r\in[0,R],\theta\in[0,2\pi]\right)\)的面积.
\begin{proof}[解答]
记\(\boldsymbol{r}(r,\theta)=(r\cos\theta,r\sin\theta,a\theta)\), 
从而\(\boldsymbol{r}_r=(\cos\theta,\sin\theta,0),
\boldsymbol{r}_{\theta}=(-r\sin\theta,r\cos\theta,a)\), 进而
\[\boldsymbol{r}_r\times\boldsymbol{r}_\theta
=\begin{pmatrix}\boldsymbol{i}&\boldsymbol{j}&\boldsymbol{k}\\
\cos\theta&\sin\theta&0\\-r\sin\theta&r\cos\theta&a\end{pmatrix}
=(a\sin\theta,-a\cos\theta,r).\]
记\(D=\left\lbrace(r,\theta)\big|r\in[0,R],\theta\in[0,2\pi]\right\rbrace\), 
于是题设曲面的面积
\[\begin{split}
S&=\iint\limits_{D}\left|\boldsymbol{r}_r\times\boldsymbol{r}_{\theta}\right|\dd r\dd\theta
=\int_{0}^{2\pi}\dd\theta\int_{0}^{R}\sqrt{a^2+r^2}\,\dd r\\
&=\pi R\sqrt{a^2+R^2}+\pi a^2\ln\left(\frac{R+\sqrt{a^2+R^2}}{a}\right).
\end{split}\]
\end{proof}
 
\item 设\(\varSigma\)为三角形\(x+y+z=1\) \((x,y,z\geqslant 0)\), 
计算第一型曲面积分\(\iint\limits_{\varSigma}\frac{1}{x+2y+3z}\,\dd S\). 
计算曲面积分\(\iint\limits_{\varSigma}x^2\,\dd S\).
\begin{proof}[解答]
\begin{align*}
\iint\limits_{\varSigma}\frac{1}{x+2y+3z}\,\dd S
&=\int_{0}^{1}\dd x\int_{0}^{1-x}\frac{\sqrt{3}\,\dd y}{3-2x-y}\\
&=\sqrt{3}\int_{0}^{1}\ln\left(\frac{3-x}{2-x}\right)\dd x\\
&=\sqrt{3}\big[\!-(3-x)\ln(3-x)+(2-x)\ln(2-x)\big]_0^1\\
&=\sqrt{3}\big[\!-2\ln 2+3\ln 3-2\ln 2\big]=\sqrt{3}\ln\frac{27}{16}.
\end{align*}\begin{align*}
\iint\limits_{\varSigma}x^2\,\dd S&=\int_{0}^{1}\dd x\int_{0}^{1-x}x^2\,\dd y\\
&=\int_{0}^{1}x^2(1-x)\,\dd x=\frac{1}{12}.
\end{align*}
\end{proof}

\item 设球面\(x^2+y^2+z^2=R^2\)上均匀分布着单位面积质量为\(\rho\)的物质. 
某质点质量为\(m\), 位于点\((0,0,r),r\ne R\). 
试求球面上的物质的质量以及球面对于该质点的引力.
\begin{proof}[解答]
球面上点$\boldsymbol{x}$处的质量为$M$的物质对于点$\boldsymbol{p}=(0,0,r)$产生的引力势能为
\[U=-\frac{GmM}{|\boldsymbol{x}-\boldsymbol{p}|}.\]
这是个调和函数，从而引力\[\nabla U=GmM\frac{\boldsymbol{x}-\boldsymbol{p}}{|\boldsymbol{x}-\boldsymbol{p}|^3}\]
的各分量亦是调和函数。整个球面对于$\boldsymbol{p}$的引力为
\[\boldsymbol{F}=\int_{\partial B_R}\nabla U\,\dd S=Gm\rho\int_{\partial B_R}\frac{\boldsymbol{x}-\boldsymbol{p}}{|\boldsymbol{x}-\boldsymbol{p}|^3}\,\dd S,\]
由平均值公式，调和函数在固定中心的球面上的平均积分同球面的半径无关，也就是说
\[\boldsymbol{F}=\frac{Gm\rho R^2}{s^2}\int_{\partial B_s}\frac{\boldsymbol{x}-\boldsymbol{p}}{|\boldsymbol{x}-\boldsymbol{p}|^3}\,\dd S,\]
只要$r$不处于$R,s$之间此式就成立，这是为了$\partial B_R$膨胀或收缩成$\partial B_s$的过程中不经过奇点$\boldsymbol{p}$。
那么可以选取特殊的$s$来得出上述积分的值：

(i) 若$\boldsymbol{p}$在球外，即$r>R$，
令$s\to0^+$，则$\boldsymbol{x}\to\boldsymbol{0}$，
实际意义是球面的质量坍缩至其中心，从而
\[\boldsymbol{F}=-\frac{Gm\rho4\pi  R^2}{r^3}\boldsymbol{p};\]
\begin{tikzpicture}
    \draw[->,>=stealth] (-3,0)to(3,0);
    \fill (0,0)circle(0.03);\fill (2.5,0)circle(0.03);
    \draw (0,0)circle(1.5);\draw[dotted,thick] (0,0)circle(0.15);
    \draw[dashed] (0.9,1.2)to(1.7,0.6);\draw[->,>=stealth] (2.5,0)to(1.7,0.6);
    \node at (0,-0.3) {$O$};\node at (3.2,0) {$z$};
    \node at (1.45,-0.2) {$R$};\node at (2.5,-0.2) {$r$};
    \node at (2.55,0.2) {$\boldsymbol{p}$};
    \node at (1,1.35) {$\boldsymbol{x}$}
\end{tikzpicture}
(ii) 若$\boldsymbol{p}$在球内，即$r<R$，令$s\to+\infty$进入外太空，使得$r \ll s$，
从而$|\boldsymbol{x}-\boldsymbol{p}|\approx|\boldsymbol{x}|$，
即$\boldsymbol{p}$的位置对不同方向的引力大小造成的影响微乎其微，
换言之来自四面八方的引力大小无甚区别，相互抵消后$\boldsymbol{F}=\boldsymbol{0}$。
\end{proof}

\item 设\(\ell\)是长为\(L\)且足够光滑的平面闭曲线. 对于\(\delta>0\), 
设\(W_{\delta}\)为所有以\(\ell\)上的点为球心, \(\delta\)为半径的球的并. 
证明: 当\(\delta\)足够小时, \(W_{\delta}\)的表面积为\(2\pi\delta L\).

\begin{proof}
本题是要说明，当\(\delta\)足够小时\(W_{\delta}\)的表面积就\textbf{是}\(2\pi\delta L\)，
而不是两者是等价无穷小。设曲线$\ell$的弧长参数化为$\ell(t)$ $(t\in[0,L))$，即$|\ell'(t)|\equiv1$。
自然地可以猜想，$\delta$充分小时，$W_\delta$的表面就是弯管
\[\bigcup_{t\in[0,L)}\big(\ell(t)+\{v\in\R^3 \mid v\perp\ell'(t),|v|=\delta\}\big),\]
对各个固定的$t$，可把上面加的集合写为$\{v(t,\theta)\mid\theta\in[0,2\pi)\}$；
只要这是对的，$W_\delta$的表面积就是题中说的
\[\int_{0}^{L}\int_{0}^{2\pi}\delta\,\dd\theta\dd t=2\pi\delta L.\]
\begin{tikzpicture}
    \draw (-2,0) .. controls (-3,-2) and (0,-2) .. (3,0);
    \filldraw (-1.5,-1.45) circle (0.02);
    \filldraw (-0.5,-1.46) circle (0.02);
    \draw[red,dashed,opacity=0.3] (-2,0) circle (0.48);
    \draw[red,dashed,opacity=0.3] (3,0) circle (0.48);
    \fill[red,fill opacity=0.08] (-2.5,0) .. controls (-3,-3) and (0.2,-2.1) .. (3.3,-0.4) 
    arc(-53:143:0.5) .. controls (0,-1) and (-2,-1.5) .. (-1.5,0) arc(0:180:0.5);
    \draw (-1.5,-1.67) node {$\scriptstyle\ell(t)$};
    \draw (-0.4,-1.68) node {$\scriptstyle\ell(t+\eta)$};
    \draw[->,>=stealth,violet] (-1.5,-1.45)to(-1,-1);
    \draw[->,>=stealth,violet] (-0.5,-1.46)to(-1,-1);
    \draw[magenta,dashed] (-1.5,-1.45)to(-0.5,-1.46);
    \draw[->,>=stealth,violet] (-2,0)to(-2.4,0.3);
    \draw[thick,dotted,violet] (-2,0)to(-1.5,0);
    \draw (-1.9,0.2) node {$\scriptstyle\theta$};
    \draw (-2.5,0.4) node {$\scriptstyle v$};
    \draw[violet,opacity=0.3] (-1.9,0) arc (0:143:0.1);
    \draw (-1.3,-1.25) node {$\scriptstyle\delta$};
    \draw (-0.7,-1.3) node {$\scriptstyle\delta$};
    \draw (-1,-1.42) node {$\scriptstyle w$}
\end{tikzpicture}
下面来证明这个断言，这只要说明猜测中的这个表面不自交即可。
若否，存在$t,t+\eta$ $(\eta>0)$和$\theta,\vartheta$使得
\[\ell(t)+v(t,\theta)=\ell(t+\eta)+v(t+\eta,\vartheta),\]
亦即\[w:=\ell(t+\eta)-\ell(t)=v(t,\theta)-v(t+\eta,\vartheta).\]
注意$|w|\leqslant|v(t,\theta)|+|v(t+\eta,\vartheta)|=2\delta$，
且$\eta$有正下界时$\min\limits_t|\ell(t+\eta)-\ell(t)|$亦有正下界，
可知$\delta$充分小时$\eta$也充分小。接下来通过算两次$w$的长度导出矛盾：一方面，
\[|w|=|\eta\ell'(t)+o(\eta)|=\eta+o(\eta);\]
另一方面，\begin{align*}|w|^2&=\big(\ell(t+\eta)-\ell(t)\big)\cdot\big(v(t,\theta)-v(t+\eta,\vartheta)\big)\\
&=\big(\ell(t+\eta)-\ell(t)\big)\cdot v(t,\theta)-\big(\ell(t+\eta)-\ell(t)\big)\cdot v(t+\eta,\vartheta)\\
&=\big(\eta\ell'(t)+\eta^2\ell''(t)/2+o(\eta^2)\big) \cdot v(t,\theta)
-\big(\eta\ell'(t+\eta)+\eta^2\ell''(t+\eta)/2+o(\eta^2)\big) \cdot v(t+\eta,\vartheta)\\
&=\eta^2\big((\ell''(t)+o(1)) \cdot v(t,\theta)-(\ell''(t+\eta)+o(1)) \cdot v(t+\eta,\vartheta)\big)/2\lesssim\eta^2\delta;
\end{align*}
两式结合即有$1\lesssim\delta$，不成立。
\end{proof}

\item 设\(\varphi,\psi\)在\([a,b]\)上连续可导. 证明: 曲线\(\begin{cases}
x=\varphi(t),\\y=\psi(t)
\end{cases}(t\in[a,b])\)绕\(x\)轴旋转一周所得到的旋转面的面积为
\(2\pi\int_{a}^{b}|\psi(t)|\sqrt{|\varphi'(t)|^2+|\psi'(t)|^2}\,\dd t\).

\begin{proof}
曲线绕\(x\)轴旋转一周得到旋转面的面积\(S\)正是\[\begin{split}
\sup\left\lbrace\sum_{j=1}^{N}2\pi \alpha_j\left|E_j\right|\Big|
\sum_{j=1}^{N}\alpha_j\chi_{E_j}\text{ 为 }[a,b]\text{ 上的简单函数, }
0\leqslant\sum_{j=1}^{N}\alpha_j\chi_{E_j}\leqslant|y|\right\rbrace,
\end{split}\]记题设曲线为\(L\), 于是\[S=2\pi\int_L|y|\,\dd s
=2\pi\int_{a}^{b}|\psi(t)|\sqrt{|\varphi'(t)|^2+|\psi'(t)|^2}\,\dd t.\qedhere\]
\end{proof}
\end{enumerate}
\end{quiza}

\begin{quizb}
\begin{enumerate}
\item 设\(a,b,c\)为实数, \(A=\sqrt{a^2+b^2+c^2}\), \(f\in L^1[-A,A]\), 
证明Poisson (泊松) 公式\[\iint\limits_{x^2+y^2+z^2=1}f(ax+by+cz)\,\dd S
=2\pi\int_{-1}^{1}f(Au)\,\dd u.\]
\begin{proof}
我们对坐标系\(Oxyz\)进行旋转, 记新坐标系为\(Ouvw\), 
平面\(Ovw\)即为\(ax+by+cz=0\), \(u\)轴垂直于该平面, 
于是有 \[u=\frac{ax+by+cz}{\sqrt{a^2+b^2+c^2}}.\]
则有\[\iint\limits_{x^2+y^2+z^2=1}f(ax+by+cz)\,\dd S
=\iint\limits_{u^2+v^2+w^2=1}f(Au)\,\dd S,\]
于是有\(v^2+w^2=\left(\sqrt{1-u^2}\right)^2\), 则令
\[u=u,\quad v=\sqrt{1-u^2}\cos\theta,\quad w=\sqrt{1-u^2}\sin\theta,\]
\end{proof}
\end{enumerate}
\end{quizb}
\section{第二型曲线积分}
\subsection{第二型曲线积分,第一、二型曲线积分的关系,曲线的方向, Jordan闭曲线定理}

\begin{quiza}
\begin{enumerate}
\item 计算以下第二型曲线积分:
\begin{enumerate}[label=(\arabic*)]
\item \(\int_{C}y\ee^{xy}\cos z\,\dd x+x\ee^{xy}\cos z\,\dd y-\ee^{xy}\sin z\,\dd z\), 
其中\(C\)为曲线\(\begin{cases}
x(t)=\cos t,\\y(t)=\sin t,\\z(t)=t
\end{cases}\)对应于\(t\)从\(0\)到\(2\pi\)的那一段.
\item \(\int_C (3x+2y)\,\dd x+(x^2-y^2)\,\dd y\), 
其中\(C\)为平面闭曲线\(x^{2/3}+y^{2/3}=1\)的逆时针方向.
\end{enumerate}
\begin{proof}[解答]
(1)由题意知
\[\int_{C}y\ee^{xy}\cos z\,\dd x+x\ee^{xy}\cos z\,\dd y-\ee^{xy}\sin z\,\dd z
=\int_{0}^{2\pi}\ee^{\sin t\cos t}\left(\cos 2t-\sin t\right)\dd t,\]
首先有
\[\begin{split}
\int_{0}^{2\pi}\ee^{\sin t\cos t}\sin t\,\dd t
&=\int_{0}^{\pi}\ee^{\sin t\cos t}\sin t\,\dd t
+\int_{\pi}^{2 \pi}\ee^{\sin t\cos t}\sin t\,\dd t\\
&=\int_{0}^{\pi}\ee^{\sin t\cos t}\sin t\,\dd t
-\int_{0}^{\pi}\ee^{\sin x\cos x}\sin x\,\dd x=0,\end{split}\]
其次\[\int_{0}^{\pi}\ee^{\sin t\cos t}\cos 2t\,\dd t
=\left.\ee^{\sin t\cos t}\right|^{2\pi}_0=0,\]于是原积分为\(0\).

(2)置\(x=\cos^3t,y=\sin^3t\), \(t\)从\(0\)到\(2\pi\), 于是
\[\begin{split}
&\int_C (3x+2y)\,\dd x+(x^2-y^2)\,\dd y\\
=&\int_{0}^{2\pi}\left(-3\,(3\cos^3t+2\sin^3t)\cos^2t\sin t+3\,(\cos^6t-\sin^6t)\sin^2t\cos t\right)\dd t\\
=&-6\int_{0}^{2\pi}\sin^4t\cos^2t\,\dd t=-\frac{3}{4}\pi.
\end{split}\]
\end{proof}

\item 设\(C\)为\(\mathbb{R}^2\)中\(C^1\)简单曲线. \(P,Q\)为\(C\)上的连续函数, 
证明\(\left|\int_C P\,\dd x+Q\,\dd y\right|\leqslant \int_C\sqrt{P^2+Q^2}\,\dd s\). 
\begin{proof}
\begin{align*}\left|\int_{C}P\,\dd x+Q\,\dd y\right|
&=\left|\int_C\left(P,Q\right)\cdot \dd \boldsymbol{s}\right|\\
&=\int_C\left|\left(P\cos\alpha+Q\sin\alpha\right)\dd s\right|\\
&\leqslant\int_C\left|P\cos\alpha+Q\sin\alpha\right|\dd s,\end{align*}
由Cauchy不等式知\[|P\cos\alpha+Q\sin\alpha|
\leqslant\sqrt{P^2+Q^2}\cdot\sqrt{\cos^2\alpha+\sin^2\alpha},\]
命题获证.
\end{proof}
\end{enumerate}
\end{quiza}

\begin{quizb}
\begin{enumerate}
\item 对于\(\mathbb{C}\)中的\(C^1\)曲线\(C\)及其上的复值连续函数\(f\), 
记\(f(z)\,\dd z=f(x+\mathrm{i}y)(\dd x+\mathrm{i}\dd y)
=f(x+\mathrm{i}y)\,\dd x+\mathrm{i}f(x+\mathrm{i}y)\,\dd y\). 
若令\(s\)为\(C\)的弧长参数, 
\(C_{s,\Delta s}\)为\(C\)上对应于弧长从\(s\)到\(s+\Delta s\)的那一段, 
则\(\lim_{\Delta s\rightarrow 0}\frac{\left|\int_{C_{s,\Delta s}}\dd z\right|}{|\Delta s|}=1.\)
这样相当于\(|\dd z|=\dd s\). 证明: \(\left|\int_C f(z)\,\dd z\right|\leqslant \int_C|f(z)|\,\dd s\). 
\begin{proof}
利用题设条件与Cauchy不等式有:\[\begin{split}
&\left|\int_Cf(z)\,\dd z\right|
=\left|\int_C f(x+\mathrm{i}y)\,\dd x+\mathrm{i}f(x+\mathrm{i}y)\,\dd y\right|\\
&\leqslant\int_C\left|\left(f(x+\mathrm{i}y),\mathrm{i}f(x+\mathrm{i}y)\right)\cdot (\dd x,\dd y)\right|
\leqslant\int_C|f(z)|\,\dd s.
\end{split}\]
\end{proof}
\end{enumerate}
\end{quizb}

\section{第二型曲面积分}
\subsection{第二型曲面积分,第一、二型曲面积分的关系,通量,曲面的侧}
\begin{quiza}
\begin{enumerate}
\item 计算以下第二型曲面积分:
\begin{enumerate}[label=(\arabic*)]
\item  \(\iint\limits_{\varSigma}(x+y)\,\dd y\dd z+(y+z)\,\dd z\dd x+(z+x)\,\dd x\dd y\), 
其中\(\varSigma\)为曲面\(x^2+\frac{y^2}{4}+\frac{z^2}{9}=1\)的上半部分, 方向取上侧.
\item \(\iint\limits_{\varSigma}x^2\,\dd y\dd z+y^2\,\dd z\dd x+(z+2)^2\,\dd x\dd y\), 
其中\(\varSigma\)为锥面\(z=\sqrt{x^2+y^2}\)
对应于\(0\leqslant z\leqslant 1\)的那部分, 方向取上侧.
\end{enumerate}
\begin{proof}[解答]
(1)为计算\(\iint\limits_{\varSigma}(x+y)\,\dd y\dd z\), 将\(\varSigma\)投影到\(yz\)平面, 其投影为
\[D_1=\left\lbrace(y,z)\big|\frac{y^2}{4}+\frac{z^2}{9}\leqslant 1,z\geqslant 0\right\rbrace.\]
曲面分为两部分:\[\begin{split}
\varSigma_1&=\left\lbrace (x,y,z)\big|x=\sqrt{1-\frac{y^2}{4}-\frac{z^2}{9}},(y,z)\in D_1 \right\rbrace,\text{方向为前侧},\\
\varSigma_2&=\left\lbrace (x,y,z)\big|x=-\sqrt{1-\frac{y^2}{4}-\frac{z^2}{9}},(y,z)\in D_1 \right\rbrace,\text{方向为后侧}.
\end{split}\]于是\[\begin{split}
\iint\limits_{\varSigma}(x+y)\,\dd y\dd z
&=\iint\limits_{\varSigma_1}(x+y)\,\dd y\dd z+\iint\limits_{\varSigma_2}(x+y)\,\dd y\dd z\\
&=\iint\limits_{D_1}\left(\sqrt{1-\frac{y^2}{4}-\frac{z^2}{9}}+y\right)\dd y\dd z
+\iint\limits_{D_1}\left(\sqrt{1-\frac{y^2}{4}-\frac{z^2}{9}}-y\right)\dd y\dd z\\
&=2\iint\limits_{D_1}\sqrt{1-\frac{y^2}{4}-\frac{z^2}{9}}\,\dd y\dd z=4\pi.
\end{split}\]
同理计算可得\(\iint\limits_{\varSigma}(y+z)\,\dd z\dd x=4\pi,
\,\iint\limits_{\varSigma}(z+x)\,\dd x\dd y=4\pi\). 从而
\[\iint\limits_{\varSigma}(x+y)\,\dd y\dd z+(y+z)\,\dd z\dd x+(z+x)\,\dd x\dd y=12\pi.\]

(2)由对称性\[\iint\limits_{\varSigma}x^2\,\dd y\dd z
=\iint\limits_{\varSigma}y^2\,\dd z\dd x=0.\]
于是仅需计算\[\iint\limits_{\varSigma}(z+2)^2\,\dd x\dd y
=\iint\limits_{x^2+y^2\leqslant 1}\left(\sqrt{x^2+y^2}+2\right)^2\dd x\dd y
=\frac{43}{6}\pi.\qedhere\]
\end{proof}

\item 设\(\varSigma\)为\(\mathbb{R}^3\)中的有向\(C^1\)曲面, 
\(P,Q,R\)为\(\varSigma\)上的连续函数. 证明:
\[\left|\iint\limits_{\varSigma}P\,\dd y\dd z+Q\,\dd z\dd x+R\,\dd x\dd y\right|
\leqslant\iint\limits_{\varSigma}\sqrt{P^2+Q^2+R^2}\,\dd S.\]
\begin{proof}
由第一, 第二型曲面积分的关系与Cauchy不等式得到
\begin{align*}\left|\iint\limits_{\varSigma}P\,\dd y\dd z+Q\,\dd z\dd x+R\,\dd x\dd y\right|
&=\left|\iint\limits_{\varSigma}\left(P,Q,R\right)\cdot\boldsymbol{n}(\boldsymbol{x})\,\dd S\right|\\
&\leqslant\iint\limits_{\varSigma}\sqrt{P^2+Q^2+R^2}\,\dd S.\end{align*}
其中\(\boldsymbol{n}\)为\(\varSigma\)对应的单位法向量.
\end{proof}
\end{enumerate}
\end{quiza}

