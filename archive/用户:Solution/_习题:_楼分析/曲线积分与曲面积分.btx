\item 试对于足够光滑的\(f\)和\(\boldsymbol{F}\), 化简以下表达式:
\begin{align*}
(1)\ \nabla\cdot\nabla f;\quad&(2)\ \nabla\times\nabla f;\quad&
(3)\ \nabla\left(\nabla\cdot\boldsymbol{F}\right);\quad&
(4)\ \nabla\cdot\left(\nabla\times\boldsymbol{F}\right);\quad&
(5)\ \nabla\times\left(\nabla\times\boldsymbol{F}\right).
\end{align*}
\begin{proof}[解答]
不妨设\(f=f(x,y,z),\boldsymbol{F}=X(x,y,z)\boldsymbol{i}
+Y(x,y,z)\boldsymbol{j}+Z(x,y,z)\boldsymbol{k}\), 于是
\[\nabla\cdot\nabla f=\nabla\cdot\left(\frac{\partial f}{\partial x}\boldsymbol{i}
+\frac{\partial f}{\partial y}\boldsymbol{j}
+\frac{\partial f}{\partial z}\boldsymbol{k}\right)
=\frac{\partial^2f}{\partial x^2}+\frac{\partial^2f}{\partial y^2}
+\frac{\partial^2f}{\partial z^2}=\Delta f.\]
容易验证\(\nabla\times\nabla f=\boldsymbol{0},
\nabla\cdot\left(\nabla\times\boldsymbol{F}\right)=0\). 此外，下面两个表达式似乎无法继续化简：
\[\nabla\left(\nabla\cdot\boldsymbol{F}\right)
=\left(\frac{\partial}{\partial x}\left(\frac{\partial X}{\partial x}+\frac{\partial Y}{\partial y}+\frac{\partial Z}{\partial z}\right),
\frac{\partial}{\partial y}\left(\frac{\partial X}{\partial x}+\frac{\partial Y}{\partial y}+\frac{\partial Z}{\partial z}\right),
\frac{\partial}{\partial z}\left(\frac{\partial X}{\partial x}+\frac{\partial Y}{\partial y}+\frac{\partial Z}{\partial z}\right)\right),\]
\[\begin{split}
\nabla\times\left(\nabla\times\boldsymbol{F}\right)
&=\nabla\times\left(\frac{\partial Z}{\partial y}
-\frac{\partial Y}{\partial z},\frac{\partial X}{\partial z}
-\frac{\partial Z}{\partial x},\frac{\partial Y}{\partial x}
-\frac{\partial X}{\partial y}\right)\\
&=\left(\frac{\partial^2Y}{\partial x\partial y}-\frac{\partial^2X}{\partial y^2}-\frac{\partial^2X}{\partial z^2}+\frac{\partial^2Z}{\partial x\partial z},
\frac{\partial^2Z}{\partial y\partial z}-\frac{\partial^2Y}{\partial z^2}-\frac{\partial^2Y}{\partial x^2}+\frac{\partial^2X}{\partial y\partial x},
\frac{\partial^2X}{\partial z\partial x}-\frac{\partial^2Z}{\partial x^2}-\frac{\partial^2Z}{\partial y^2}+\frac{\partial^2Y}{\partial z\partial y}\right).
\end{split}\]值得一提的是\(\nabla\left(\nabla\cdot\boldsymbol{F}\right)
-\nabla\times\left(\nabla\times\boldsymbol{F}\right)=\Delta\boldsymbol{F}\).
(不难发现，空间解析几何中出现过这个等式。)
\end{proof}

\item 保守场、无源场和无旋场之间有没有什么关系?
\begin{proof}[解答]
用$\Omega^0(D),\Omega^1(D),\Omega^2(D),\Omega^3(D)$表示$D$上的全体$0,1,2,3$阶$C^\infty$-微分形式，有两组同构关系：
\begin{align*}\{函数\}& &\simeq& &\Omega^0(D)& &\simeq& &\Omega^3(D)\ \ \ \\
f\quad & & \leftrightarrow & & f\quad & & \leftrightarrow & & f\,\dd x\dd y\dd z\end{align*}
和\begin{align*}\{向量场\}\,& &\simeq& &\Omega^1(D)\qquad\ \ \ & &\simeq& &\Omega^2(D)\qquad\qquad\ \ \\
(P,Q,R) & & \leftrightarrow & & P\,\dd x+Q\,\dd y+R\,\dd z & & \leftrightarrow & & P\,\dd y\dd z+Q\,\dd z\dd x+R\,\dd x\dd y\end{align*}
且有如下的链复形：
\[\Omega^0(D)\stackrel{d_0}{\longrightarrow}\Omega^1(D)
\stackrel{d_1}{\longrightarrow}\Omega^2(D)\stackrel{d_2}{\longrightarrow}\Omega^3(D),\]
其中$d_i$是外微分$\dd$限制在$\Omega^i(D)$上。事实上，$d_0$就是梯度$\nabla$，
$d_1$就是旋度$\textbf{curl}$，$d_2$就是散度$\operatorname{div}$（请验证！），
从这个角度来说，保守场全体即是$\operatorname{im}d_0$，无源场全体即是$\ker d_2$，无旋场全体即是$\ker d_1$。
$d_1 \circ d_0=0$等价于$\operatorname{im}d_0\subset\ker d_1$，即保守场一定是无旋场；
反之不对，即无旋场不一定是保守场，两者的商空间$H^1(D):=\ker d_1/\operatorname{im}d_0$称为$D$的$1$阶de Rham上同调群，
反映着$D$的拓扑性质。无源场则同保守场、无旋场均无包含关系。
\end{proof}

\item 用记号\(\nabla\)重写Gauss公式和Stokes公式.
\begin{proof}[解答]
Gauss公式可以表示为\[\iint\limits_{\partial \varOmega}\boldsymbol{F}\cdot\dd\boldsymbol{S}
=\iiint\limits_{\varOmega}\nabla\cdot\boldsymbol{F}\,\dd V,\]Stokes公式可表示为
\[\int_{\partial\varSigma}\boldsymbol{F}\cdot\dd\boldsymbol{s}
=\iint\limits_{\varSigma}\left(\nabla\cdot\boldsymbol{F}\right)\cdot\dd\boldsymbol{S}.\qedhere\]
\end{proof}

\item 验证\[\int_{\partial\varOmega}\omega=\int_{\varOmega}\mathrm{d}\omega\]
适用于Green公式, Ostrogradski\v{\i}--Gauss公式, Stokes公式以及Newton--Leibniz公式.
\begin{proof}[解答]

注：事实上，此式即称为Stokes公式，在几何和拓扑中非常重要。
\end{proof}

\item 试利用Stokes公式计算\(\int_Cy\,\dd x+2z\,\dd y+3x\,\dd z\), 
其中\(C\)为圆周\(\begin{cases}
x^2+y^2+z^2=1,\\x+y+z=0.
\end{cases}\)从\(z\)轴正向\footnote{表示从上往下看.}看去, 曲线是逆时针方向的.
\printfootnotes
\begin{proof}[解答]
平面\(x+y+z=0\)的法线的方向余弦为\(\cos\alpha=\cos\beta=\cos\gamma
=\frac{1}{\sqrt{3}}\), 于是由Stokes公式\[\int_Cy\,\dd x+2z\,\dd y+3x\,\dd z\]
\end{proof}
\end{enumerate}
\end{quiza}

\begin{quizb}
\begin{enumerate}
\item 设\(a,b,c>0\), \(\varSigma\)为曲面
\(\frac{x^2}{a^2}+\frac{y^2}{b^2}+\frac{z^2}{c^2}=1.\) 
利用Gauss公式计算曲面积分
\[\iint\limits_{\varSigma}\frac{\dd S}{(x^2+y^2+z^2)^{\frac{3}{2}}\sqrt{\displaystyle\frac{x^2}{a^4}+\frac{y^2}{b^4}+\frac{z^2}{c^4}}}.\]
\begin{proof}[解答]
记原积分为\(I\), 注意到有\[I=\iint\limits_{\varSigma}\frac{\displaystyle\frac{x^2}{a^2}+\frac{y^2}{b^2}+\frac{z^2}{y^2}}
{(x^2+y^2+z^2)^{3/2}\sqrt{\displaystyle\frac{x^2}{a^4}+\frac{y^2}{b^4}+\frac{z^2}{c^4}}}\,\dd S.\]
注意到曲面\(\varSigma\)的单位法向量为\(\frac{\left(x/a^2,y/b^2,z/c^2\right)}{\sqrt{x^2/a^4+y^2/b^4+z^2/c^4}}\), 
于是有\[I=\iint\limits_{\varSigma}\frac{x\,\dd y\dd z+y\,\dd z\dd x+z\,\dd x\dd y}{(x^2+y^2+z^2)^{3/2}}
=:\iint\limits_{\varSigma}P\,\dd y\dd z+Q\,\dd z\dd x+R\,\dd x\dd y.\]
由于\(P,Q,R\)在原点处不可导, 而在别处有
\[\frac{\partial P}{\partial x}+\frac{\partial Q}{\partial y}
+\frac{\partial R}{\partial z}=0,\]再由Gauss公式有
\[I=\iint\limits_{\varSigma'}\frac{\dd S}{x^2+y^2+z^2}
=\iint\limits_{\varSigma'}\frac{\dd S}{\rho^2}=\frac{4\pi\rho^2}{\rho^2}=4\pi,\]
其中\(\varSigma'\)是半径\(\rho\)充分小从而含于\(\varSigma\)的球面\(x^2+y^2+z^2=\rho^2\).
\end{proof}

\item 设\(\boldsymbol{A}\)是\(n\)阶方阵, 
\(\varOmega\)为\(\mathbb{R}^n\)中具有\(C^1\)边界的有界区域, 
\(\boldsymbol{\varphi}\in C^2_0(\varOmega;\mathbb{R}^n)\). 证明: 
\[\int_{\varOmega}\det(\boldsymbol{A}+\boldsymbol{\varphi_x})\,\dd\boldsymbol{x}
=\det(\boldsymbol{A})|\varOmega|.\]
\begin{proof}
先证明 $\boldsymbol{A}=\boldsymbol{0}$ 的情况。将 $\boldsymbol{\varphi}$ 的 Jacobi 行列式完全展开，
利用分部积分公式和 $\boldsymbol{\varphi}$ 在 $\partial \varOmega$ 上为 $0$ 可知，
\begin{align*}
\int_{\varOmega} \det(\boldsymbol{\varphi}_{\boldsymbol{x}}) \,\dd \boldsymbol{x} 
& =\int_{\varOmega} \sum_{(i_1, i_2, \cdots, i_n) \in S_n}(-1)^{\sigma(i_1, i_2, \cdots, i_n)} \partial_{i_1} \boldsymbol{\varphi}_1 \partial_{i_2} \boldsymbol{\varphi}_2 \cdots \partial_{i_n} \boldsymbol{\varphi}_n \,\dd \boldsymbol{x} \\
& =-\int_{\varOmega} \sum_{(i_1, i_2, \cdots, i_n) \in S_n}(-1)^{\sigma(i_1, i_2, \cdots, i_n)} \boldsymbol{\varphi}_1 \partial_{i_1}(\partial_{i_2} \boldsymbol{\varphi}_2 \cdots \partial_{i_n} \boldsymbol{\varphi}_n) \,\dd \boldsymbol{x},
\end{align*}
其中 $S_n$ 是 $n$ 阶置换群，$\sigma(i_1, i_2, \cdots, i_n)$ 是 $(i_1, i_2, \cdots, i_n)$ 的逆序数。不难知道
\[\sum_{(i_1, i_2, \cdots, i_n) \in S_n}(-1)^{\sigma(i_1, i_2, \cdots, i_n)} \partial_{i_1}(\partial_{i_2} \boldsymbol{\varphi}_2 \cdots \partial_{i_n} \boldsymbol{\varphi}_n)=0,\]
从而
\[\int_{\varOmega} \det(\boldsymbol{\varphi}_{\boldsymbol{x}}) \,\dd \boldsymbol{x}=0.\]
对于一般的 $\boldsymbol{A}$，注意到 $\det(\boldsymbol{A}+\boldsymbol{\varphi_{x}})$ 等于 $\det(\boldsymbol{A})$ 
加上一些以 $\boldsymbol{A}$ 中一些行替代 $\boldsymbol{\varphi_{x}}$ 中相应的行后得到矩阵的行列式，
该行列式又等于这些行所对应的所有子式和对应的所有代数余子式之和。以替换第一行为例，即有
\[\det\begin{pmatrix}
a_{11} & a_{12} & \cdots & a_{1 n} \\
\partial_1 \boldsymbol{\varphi}_2 & \partial_2 \boldsymbol{\varphi}_2 & \cdots & \partial_n \boldsymbol{\varphi}_2 \\
\vdots & \vdots & \ddots & \vdots \\
\partial_1 \boldsymbol{\varphi}_n & \partial_2 \boldsymbol{\varphi}_n & \cdots & \partial_n \boldsymbol{\varphi}_n
\end{pmatrix}=\sum_j(-1)^{1+j} a_{1j} \det(D_{\hat{j}} \boldsymbol{\varphi}_{\hat{1}}).\]
由 $\boldsymbol{A}=\boldsymbol{0}$ 时所证明的结果知道，上面的各项$\det(D_{\hat{j}} \boldsymbol{\varphi}_{\hat{1}})$在 $\varOmega$ 上的积分均为 $0$。因此
\[\int_{\varOmega} \det(\boldsymbol{A}+\boldsymbol{\varphi_{x}}) \,\dd \boldsymbol{x}
=\int_{\varOmega} \det(\boldsymbol{A}) \,\dd \boldsymbol{x}=\det(\boldsymbol{A})|\varOmega|.\qedhere\]
\end{proof}

\item 设\(n\geqslant 1\), \(R\)是仅在点\((0,0)\)为零的\(2n\)次二元多项式, 
\(P,Q\)是不超过\(2n-2\)次的二元多项式. 
若\(\varliminf\limits_{(x,y)\rightarrow\infty}\frac{R(x,y)}{(x^2+y^2)^n}>0\), 
且在点\((0,0)\)之外成立\(\frac{\partial}{\partial x}\frac{Q(x,y)}{R(x,y)}
=\frac{\partial}{\partial y}\dfrac{P(x,y)}{R(x,y)}\), 
证明: 曲线积分\(\int_{C}\frac{P\,\dd x+Q\,\dd y}{R}\)绕点\((0,0)\)的循环常数为零.
\begin{proof}
由Green公式，$C$可换为一个以$(0,0)$为中心半径$r$超级大的圆$C'$。$C'$上成立
\[|P|,|Q| \lesssim r^{2n-2},\quad R \gtrsim r^{2n},\]
从而
\[\int_{C}\frac{P\,\dd x+Q\,\dd y}{R}=\int_{C'}\frac{P\,\dd x+Q\,\dd y}{R}
\lesssim 2\pi r \cdot r^{-2} \to 0.\qedhere\]
\end{proof}

\item 在上一题中, 去掉条件\(\varliminf_{(x,y)\rightarrow\infty}
\frac{R(x,y)}{(x^2+y^2)^n}>0\)后结论是否仍然成立？
\begin{proof}[解答]
不再成立。首先介绍两个术语：微分形式$\omega$称为\textbf{闭}的，是说$\dd\omega=0$；
$1$阶微分形式$\omega$称为\textbf{恰当}的，是说存在函数$f$使得$\omega=\dd f$。
由于$\dd(\dd f)=0$，恰当形式一定是闭的；而闭形式可能不恰当，如11.5.$\mathcal{A}$第1题(1)中的
\[\dd\arctan\frac{y}{x}=\dd\operatorname{Arg}(x+\ii y)=\frac{-y\,\dd x+x\,\dd y}{x^2+y^2},\]
其循环常数非零，从而不可能是恰当形式（换言之$\operatorname{Arg}(x+\ii y)$是个取值可相差$2\pi\Z$的多值函数，
不能定义在整个复平面上）；可是\(\dd\arctan\frac{y}{x}\)在\textbf{局部}上总是恰当形式从而是闭形式，
而闭是一个局部性质，故其是个整体的闭形式。

本题的任务就是找一个合乎要求的\textbf{不恰当的闭形式}，上述的$\omega$无疑是最简单的例子，
不过不能直接搬到这里来，因为其分母只比分子高$1$次，题目要求至少要高$2$次。
下面对这个例子进行修改，主要是为\(\dd\arctan\frac{y}{x}\)中的分母$x$提升次数。

考虑一个扰动: 令$\varepsilon>0$极其小, $f(x,y)$是$n$次的二元多项式并简写为$f$, 算一下
\[\frac{P\,\dd x+Q\,\dd y}{R}:=\dd\arctan\frac{y}{x+\varepsilon f}
=\frac{-(1+\varepsilon f_x)y\,\dd x+(x+\varepsilon(f-f_yy))\,\dd y}{(x+\varepsilon f)^2+y^2},\]
也就是说\[P=-(1+\varepsilon f_x)y, \quad Q=x+\varepsilon(f-f_yy), \quad R=(x+\varepsilon f)^2+y^2.\]
这样一来，$\deg P,\deg Q \leqslant n$且$\deg R=2n$是肯定成立的。
此外，$\varepsilon$很小时这个形式是关于其一致连续的，从而对曲线$C$的积分（即循环常数）是连续的，
$\varepsilon=0$时的循环常数为$2\pi$，则$\varepsilon$很小时循环常数同样非零。
最后还需要的是$R$在$(0,0)$外非零，这无非是$x+\varepsilon f(x,0)=0$的解只有$x=0$，为此取$f(x,y)=x^{n-1}y$即可。
\end{proof}
\end{enumerate}
\end{quizb}

\section{调和函数与解析函数}
\subsection{调和函数,平均值公式,最值原理, Poisson公式,复可导与复解析的等价性, Cauchy定理,最大模原理, Liouville定理,共轭函数,利用解析函数计算}
\begin{quiza}
\begin{enumerate}
\item 利用解析函数的性质证明: \(\int_{0}^{+\infty}\frac{\ee^{-x}-\cos x}{x}\,\dd x=0\).
\begin{proof}
考虑积分\(\int_{L}\frac{\ee^{\ii z}}{z}\,\dd z\), 其中\(L\)是如下图所示的路径:
\begin{figure}
\begin{tikzpicture}[scale=0.8]
\draw[-latex,thick] (-1,0)--(6,0);
\draw[-latex,thick] (0,-1)--(0,6);
\draw[thick,red] (0.8,0) arc (0:45:0.8);
\draw[thick,->,>=stealth,red] (0,0.8) arc (90:42:0.8);
\draw[thick,->,>=stealth,red] (5,0) arc (0:46:5);
\draw[thick,red] (0,5) arc (90:45:5);
\draw[thick,->,>=stealth,red] (0.8,0)--(2.5,0);
\draw[thick,red] (2,0)--(5,0);
\draw[thick,red] (0,0.8)--(0,2.5);
\draw[<-,>=stealth,thick,red] (0,2.4)--(0,5);
\node at (-0.3,-0.3) {$O$};
\node at (6,-0.3) {$x$};
\node at (-0.3,6) {$y$};
\node at (3.5,4) {$\Gamma_R$};
\node at (0.8,0.7) {$\Gamma_r$};
\node at (0.8,-0.3) {$A$};
\node at (5,-0.3) {$B$};
\node at (-0.3,5) {$C$};
\node at (-0.3,0.8) {$D$};
\node at (4.5,5) {$L$};
\end{tikzpicture}
\caption{围道积分}
\end{figure}
其中\(\Gamma_R\)表图中半径为\(R\)的弧. 
由于\(f(z)=\frac{\ee^{\ii z}}{z}\)在\(L\)所围区域内解析, 从而
\[\int_{L}f(z)\,\dd z=0.\]
又\[\int_{L}f(z)\,\dd z=\int_{AB}f(z)\,\dd z+\int_{\Gamma_R}f(z)\,\dd z
+\int_{CD}f(z)\,\dd z+\int_{\Gamma_r}f(z)\,\dd z,\]
注意到\[\begin{split}
&\int_{AB}f(z)\,\dd z+\int_{CD}f(z)\,\dd z 
=\int_{r}^{R}\frac{\ee^{\ii x}}{x}\,\dd x+\int_{R}^{r}\frac{\ee^{-y}}{y}\,\dd y\\
=&\int_{r}^{R}\frac{-\ee^{-x}+\ee^{\ii x}}{x}\,\dd x
=-\int_{r}^{R}\frac{\ee^{-x}-\cos x}{x}\,\dd x
+\ii\int_{r}^{R}\frac{\sin x}{x}\,\dd x,
\end{split}\]

下面我们说明\(\int_{\Gamma_r}f(z)\,\dd z=-\frac{\pi\ii}{2}\), 
由于\(\lim_{r\rightarrow 0}zf(z)=1\), 则\(r\)充分小时, 有
\[|z f(z)-1|<\frac{2}{\pi}\varepsilon,\]
又\[\left|\int_{\Gamma_r}f(z)\,\dd z-\ii\frac{\pi}{2}\right|
=\left|\int_{\Gamma_r}\frac{zf(z)-1}{z}\,\dd z\right|<\varepsilon,\]
从而结论得证. 又由Jordan引理可知
\[\lim_{R\rightarrow+\infty}\int_{\Gamma_R}\frac{\ee^{\ii z}}{z}\,\dd z=0,\]
结合上述结论可知\(\int_{0}^{+\infty}\frac{\ee^{-x}-\cos x}{x}\,\dd x=0\).
\end{proof}

\item 设\(1\leqslant p<+\infty\), \(\varphi\)为\(\mathbb{R}^n\)上的调和函数, 
\(\varphi\in L^p(\mathbb{R}^n)\). 证明\(\varphi\equiv 0\).
\begin{proof}
对任意$\boldsymbol{x}_0\in\R^n$，任取$r>0$，由平均值公式，
\begin{align*}|\varphi(\boldsymbol{x}_0)|
&\leqslant\frac{1}{|B_r|}\int_{B_r(\boldsymbol{x}_0)}|\varphi(\boldsymbol{x})|\,\dd\boldsymbol{x}\\
&\leqslant\bigg(\frac{1}{|B_r|}\int_{B_r(\boldsymbol{x}_0)}|\varphi(\boldsymbol{x})|^p\,\dd\boldsymbol{x}\bigg)^\frac{1}{p}
\leqslant|B_r|^{-\frac{1}{p}}\|\varphi\|_{L^p}\end{align*}
有一致的上界，根据Liouville定理$\varphi\equiv$常数，
再用$\varphi\in L^p(\R^n)$得常数为$0$。
\end{proof}

\item 设\(\varphi\in C^2(\mathbb{R}^n)\)为\textbf{上调和函数}, 
即满足\(-\Delta\varphi\geqslant 0\). 任取\(\boldsymbol{x}_0\in\mathbb{R}^n\), 
证明\(F(r)=\frac{1}{|B_r(\boldsymbol{x}_0)|}
\cdot\int_{B_r(\boldsymbol{x}_0)}\varphi(\boldsymbol{x})\,\dd\boldsymbol{x}\)关于\(r>0\)单减.
\begin{proof}

\end{proof}

\item 设\(f\)在有界复区域\(D\)上复解析, 在\(\overline{D}\)上连续. 
若存在\(z_0\in D\)满足\(|f(z_0)|\leqslant\min_{z\in\partial D}|f(z)|\), 
证明: \(f\)在\(D\)内为常数或有零点.
\begin{proof}
假设\(f\)不为常数且无零点, 则\(\frac{1}{f(z)}\)在\(D\)上解析, 
依条件有\(\left|\frac{1}{f(z_0)}\right|
\geqslant\max_{z\in\partial D}\left|\frac{1}{f(z)}\right|\), 
这与最大模原理矛盾, 从而\(f\)在\(D\)内有零点.
\end{proof}

\item 设\(f\)在\(\mathbb{C}\)上复解析, \(\lim_{z\rightarrow\infty}|f(z)|=+\infty\). 
证明: \(f\)有零点. 进一步, 若存在\(n\geqslant 1\)
使得\(\lim_{z\rightarrow\infty}\frac{|f(z)|}{|z|^n}
=a\in\left(0,+\infty\right]\), 则\(f\)至少有\(n\)个零点(含重数).
\begin{proof}
由条件知\(\lim_{z\rightarrow\infty}\left|\frac{1}{f(z)}\right|=0\), 
若\(f\)无零点, 则\(\frac{1}{f(z)}\)解析, 但依极限知存在\(z_0\), 
使得\(\forall |z|>|z_0|\)时有\(\left|1/f(z)\right|>\left|1/f(z_0)\right|\), 
与最大模原理矛盾, 从而\(f\)有零点. 
进一步, 若\(\lim_{z\rightarrow\infty}\frac{\left|f(z)\right|}{|z|^n}
=a\in\left(0,+\infty\right]\), 
则\(\lim_{z\rightarrow\infty}\left|\frac{f(z)}{z^{n-1}}\right|=+\infty\), 
归纳即得结论. 
\end{proof}

\item 证明: 对任何\(z\in\mathbb{C}\)以及\(\delta\in(0,1)\), 
有\(\lim_{s\rightarrow+\infty}\frac{\displaystyle\int_{(0,1-\delta)\cup(1+\delta,+\infty)}x^z\left(x\ee^{-x}\right)^s\dd x}
{\displaystyle\int_{0}^{+\infty}\left(x\ee^{-x}\right)^s\dd x}=0.\)
\begin{proof}
记\(\alpha\)为\(x\ee^{-x}\)在\([0,1-\delta]\cup[1+\delta,+\infty]\)上的最大值, 
给定\(\beta\in(\alpha,\ee^{-1})\), 则存在长度为\(l\)的区间\(I\subseteq[1-\delta,1+\delta]\), 
使得\(x\ee^{-x}\geqslant \beta\)对\(x\in I\)恒成立. 
从而\(\int_{0}^{+\infty}\left(x\ee\right)^s\dd x\geqslant l\cdot\beta^s\), 
\(s\)足够大时, 存在常数\(C_1\)使得
\[\left|\int_{0}^{1-\delta}x^z(x\ee^{-x})^{s}\dd x\right|
\leqslant C_1\cdot\alpha^s,\]又存在常数\(C_2\)使得\[\begin{split}
\left|\int_{1+\delta}^{+\infty}x^z(x\ee^{-x})^s\dd x\right|
&\leqslant\int_{1+\delta}^{+\infty}x^{\operatorname{Re}z}(x\ee^{-x})^s\dd x\\
&\leqslant\int_{1+\delta}^{+\infty}x^{\operatorname{Re}z}(x\ee^{-x})^{s-1}\cdot\left[s(x-1)-\mathrm{Re}\,z\right]\ee^{-x}\dd x\\
&=-\int_{1+\delta}^{+\infty}\dd\left[x^{\operatorname{Re}z}(x\ee^{-x})^s\right]
\leqslant C_2\cdot\alpha^s.
\end{split}\]
\end{proof}
\end{enumerate}
\end{quiza}

\begin{quizb}
\begin{enumerate}
\item 设\(\alpha\in\mathbb{R}\), \(\boldsymbol{\sigma}\in S^{n-1}\). 
证明: 在\(\mathbb{R}^n\)的单位球\(B_1(\boldsymbol{0})\)内, 
\(f(\boldsymbol{x})=|\boldsymbol{\sigma}-\boldsymbol{x}|^\alpha\)
可以展开成\(\boldsymbol{x}\)的幂级数, 且对任何\(\delta\in(0,1)\), 
该幂级数关于\((\boldsymbol{\sigma},\boldsymbol{x})\in S^{n-1}\times B_{\delta}(\boldsymbol{0})\)一致收敛.

\item 已知当\(0<\alpha<1\)时, 成立\[\sum_{n=1}^{\infty}\frac{1}{n^2-\alpha^2}
=\frac{1}{2\alpha^2}-\frac{\pi\cot (\alpha\pi)}{2\alpha}.\]
试利用复解析函数的性质证明: 当\(\alpha>0\)时, 成立
\[\sum_{n=1}^{\infty}\frac{1}{n^2+\alpha^2}
=-\frac{1}{2\alpha^2}+\frac{\pi}{2\alpha\tanh(\alpha\pi)}.\]
\begin{proof}
用复解析函数的唯一性，$\alpha$换为$\ii\alpha$，
\[-\frac{\pi\cot(\ii\alpha\pi)}{2\ii\alpha}
=-\frac{\pi\cos(\ii\alpha\pi)}{2\ii\alpha\sin(\ii\alpha\pi)}
=\frac{\pi\cosh(\alpha\pi)}{2\alpha\sinh(\alpha\pi)}
=\frac{\pi}{2\alpha\tanh(\alpha\pi)}.\qedhere\]
\end{proof}

\item 试用不同的方法证明\[\operatorname{sh}x=x\prod_{n=1}^{\infty}\left(1+\frac{x^2}{n^2\pi^2}\right).\]
\end{enumerate}
\end{quizb}

\section{附录: \(C^1\)曲面上的Hausdorff测度}
\subsection{Binet--Cauchy公式, \(C^1\)曲面的Hausdorff公式}
\begin{theorem}\label{Th:kwei}
设\(1\leqslant k\leqslant n\), \(D_0\)为\(\mathbb{R}^k\)中区域, 
单射\(\boldsymbol{\varphi}:D_0\rightarrow\mathbb{R}^n\)连续可微, 
则对于紧包含于\(D_0\)的可测集\(D\), \(\varSigma=\boldsymbol{\varphi}(D)\)的\(k\)维测度为
\[V_k(\varSigma)=\int_D\sqrt{\det(\boldsymbol{\varphi_u}^{\!\!\!\!\rm T}\boldsymbol{\varphi_u})}\,\dd\boldsymbol{u}.\]
等价地,\[V_k(\varSigma)=\int_D\sqrt{\boldsymbol{\varphi_u}\text{ 的所有 }k\text{ 阶子式的平方和}}\,\dd\boldsymbol{u}.\]
\end{theorem}

\begin{quiza}
\begin{enumerate}
\item 设\(\varOmega\subseteq\mathbb{R}^n\)为区域, 
\(\boldsymbol{\varphi}\in C^1(\varOmega;\mathbb{R}^m)\). 
设\(F\subset \varOmega\)为紧集,
\[\omega(r)=\underset{0<|\boldsymbol{u}-\boldsymbol{v}|\leqslant r
\atop\boldsymbol{u}\in F,\boldsymbol{v}\in\overline{\varOmega}}{\sup}
\frac{\left|\boldsymbol{\varphi}(\boldsymbol{u})-\boldsymbol{\varphi}(\boldsymbol{v})\right|}
{|\boldsymbol{u}-\boldsymbol{v}|},\quad r>0.\]
证明\(\lim_{r\rightarrow 0^+}\omega(r)=0.\)
\begin{proof}

\end{proof}
\end{enumerate}
\end{quiza}
\begin{quizb}
1. 试减弱定理\ref{Th:kwei} 的条件使得结论仍然成立.
\begin{proof}[解答]

\end{proof}
\end{quizb}