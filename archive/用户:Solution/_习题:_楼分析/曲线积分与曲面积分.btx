\section{Green公式, Gauss公式, Stokes公式}
\subsection{向量场,单连通域, Ostrogradsky--Gauss定理(散度定理), Green公式, Stokes公式,曲线积分和路径无关性,原函数的存在性,循环常数,场论初步,梯度场(保守场),散度场,向量线,环量,旋度,无源场,无旋场, Hamilton算子, Laplace算子,分部积分公式, Green第一、\ 第二公式}
\begin{quiza}
\begin{enumerate}
\item 计算以下曲线积分绕原点的循环常数:
\begin{align*}
(1)\int_{C}\frac{-y\,\dd x+x\,\dd y}{x^2+y^2};\qquad
(2)\int_{C}\frac{x\,\dd x+y\,\dd y}{x^2+y^2}.
\end{align*}
\begin{proof}[解答1]
不妨取\(C=\{(x,y)\big|x^2+y^2=1\}\), 置\(x=\cos\theta,y=\sin\theta\) \((\theta\in[0,2\pi])\), 于是得到
\[\int_C\frac{-y\,\dd x+x\,\dd y}{x^2+y^2}=2\pi,\quad\int_{C}\frac{x\,\dd x+y\,\dd y}{x^2+y^2}=0.\qedhere\]
\end{proof}
\begin{proof}[解答2]
更为本质的原因在于，令$z=x+\ii y$，一方面，
\[\int_C\frac{\dd z}{z}=\int_C\frac{\bar{z}\,\dd z}{|z|^2}
=\frac{(x-\ii y)(\dd x+\ii\dd y)}{x^2+y^2}
=\int_{C}\frac{x\,\dd x+y\,\dd y}{x^2+y^2}+\ii\int_{C}\frac{-y\,\dd x+x\,\dd y}{x^2+y^2},\]
另一方面，
\[\int_C\frac{\dd z}{z}=\operatorname{Ln}z\big|_C=2\pi\ii,\]
其中多值函数\[\operatorname{Ln}z=\ln|z|+\operatorname{Arg}(z).\qedhere\]
\end{proof}

\item 设曲线\(C\)为\(\begin{cases}
x=\cos t,\\y=2t\sin t,\\z=t
\end{cases}\)对应于\(t\)从\(0\)到\(2\pi\)的那一段. 试计算曲线积分
\[\int_C\ee^{xy}\left[\left(y\cos(x+y)+yz^2-\sin(x+y)\right)\dd x
+\left(x\cos(x+y)+xz^2-\sin(x+y)\right)\dd y+2z\,\dd z \right].\]
\begin{proof}[解答]
方便起见设原积分为\(\int_CP\,\dd x+Q\,\dd y+R\,\dd z\). 
令\(L\)为直线段\(x=1,y=0,z\)从\(2\pi\)走到\(0\), 于是\(C\cup L\)为闭曲线, 
任取曲面\(\varSigma\)以\(C\cup L\)为边界, 方向与\(C\cup L\)的方向成右手系, 
由Stokes公式得到\[\int_{C\cup L}P\,\dd x+Q\,\dd y+R\,\dd z
=\iint\limits_{\varSigma}\left(\frac{\partial R}{\partial y}
-\frac{\partial Q}{\partial z}\right)\dd y\dd z
+\left(\frac{\partial P}{\partial z}-\frac{\partial R}{\partial x}\right)\dd z\dd x
+\left(\frac{\partial Q}{\partial x}-\frac{\partial P}{\partial y}\right)\dd x\dd y=0.\]
从而\[\int_CP\,\dd x+Q\,\dd y+R\,\dd z=-\int_LP\,\dd x+Q\,\dd y+R\,\dd z
=\int_{0}^{2\pi}2\ee z\,\dd z=4\ee\pi^2.\qedhere\]
\end{proof}

\item 设\(R>0\), 计算积分\(\iint\limits_{\varSigma}\frac{Rx\,\dd y\dd z+(z+R)^2\,\dd x\dd y}{\sqrt{x^2+y^2+z^2}}\), 
其中\(\varSigma\)为下半球面\(z=-\sqrt{R^2-x^2-y^2}\)的上侧.
\begin{proof}[解答]
原积分等于\[I_1=\iint\limits_{\varSigma}x\,\dd y\dd z+\frac{(z+R)^2}{R}\,\dd x\dd y.\]
选取圆盘\(D=\{(x,y,z)\big|x^2+y^2\leqslant R^2,z=0\}\), 方向为上侧, 由$x$的对称性得到
\[I_2:=\iint\limits_{D}x\,\dd y\dd z+\frac{(z+R)^2}{R}\,\dd x\dd y
=\iint\limits_{D}R\,\dd x\dd y=\pi R^3.\]
记\(\varOmega\)为\(\varSigma\cup D\)的内部, 于是由Gauss公式,
\[\begin{split}
-I_1+I_2&=\iiint\limits_{\varOmega}\left(\frac{\partial}{\partial x}(x)
+\frac{\partial}{\partial z}\left(\frac{(z+R)^2}{R}\right)\right)\dd x\dd y\dd z\\
&=\iiint\limits_{\varOmega}\left(3+\frac{2z}{R}\right)\dd x\dd y\dd z\\
&=2\pi R^3-\frac{1}{2}\pi R^3=\frac{3}{2}\pi R^3,
\end{split}\]
于是\(I_1=-\frac{1}{2}\pi R^3\).
\end{proof}

\item 设\(S\)为椭球面\(\dfrac{x^2}{2}+\dfrac{y^2}{2}+z^2=1\)的上半部分\((z>0)\), 
对于\(P=(x,y,z)\in S\), \(\varSigma\)为\(S\)在点\(P\)处的切平面, 
\(\rho(x,y,z)\)为原点到平面\(\varSigma\)的距离, 
求积分\(\iint\limits_{S}\frac{z}{\rho(x,y,z)}\,\dd S\).
\begin{proof}[解答]
记 $f(x, y, z)=x^2/2+y^2/2+z^2-1$。点 $P$ 处的法向量为 $\nabla f=(f_x, f_y, f_z)=(x,y,2z)$。于是，
\[\rho(x, y, z)=\frac{|(x, y, z) \cdot \nabla f|}{|\nabla f|}
=\frac{x^2+y^2+2z^2}{\sqrt{x^2+y^2+4z^2}}=\frac{2}{\sqrt{x^2+y^2+4z^2}},\]
即计算 \(\iint\limits_S \frac{z \sqrt{x^2+y^2+4z^2}}{2} \, \dd S\)。
注意到 $\varSigma$ 上的点 $(x, y, z)$ 处，指向曲面外侧的的单位法向量为 \(\boldsymbol{n}=\frac{(x, y, 2z)}{\sqrt{x^2+y^2+4z^2}}\)。因此，
\begin{align*}
\iint\limits_S \frac{z \sqrt{x^2+y^2+4z^2}}{2} \, \dd S 
& =\iint\limits_S\left(0,0, \frac{1}{4}\left(x^2+y^2+4z^2\right)\right) \cdot \boldsymbol{n} \, \dd S \\
& =\iint\limits_S \frac{1}{4}\left(x^2+y^2+4z^2\right) \dd x \dd y \\
& =\iint\limits_{x^2+y^2 \leqslant 2} \frac{1}{4}\left(x^2+y^2+4-2x^2-2y^2\right) \dd x \dd y \\
& =\frac{3}{2} \pi.
\end{align*}
\end{proof}

\item 设\(\theta_1<\theta_2\leqslant\theta_1+2\pi\). 
证明: 在极坐标下由射线\(\theta=\theta_1,\theta=\theta_2\)
和曲线\(C:\rho=\rho(\theta)\) \((\theta_1\leqslant \theta\leqslant\theta_2)\)
所围成的曲边扇形(如图\ref{fig:m}所示)的面积为
\(\frac{1}{2}\int_{\theta_1}^{\theta_2}\rho^2(\theta)\,\dd\theta\). 
当\(\rho\)连续可导时, 验证这一结果与公式(11.5.9)给出的结果一致. 
思考这一面积为什么不是\(\frac{1}{2}\int_C\rho^2\,\dd\sigma\).
\begin{figure}
