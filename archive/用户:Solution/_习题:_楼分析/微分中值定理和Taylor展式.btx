\section{微分中值定理}
\subsection{Fermat引理, Rolle中值定理, Lagrange中值定理, Cauchy中值定理,微分Darboux定理,凸集,常微分方程初值问题解的唯一性}
\begin{1a}
\begin{enumerate}
\item 设一元实函数\(f\)在\([a,b]\)上连续, 在\((a,b)\)内可导, \(f(a)=f(b)=0\). 证明:
\begin{enumerate}[label=(\arabic*)]
\item 存在\(\xi\in(a,b)\)使得\(\xi^2f(\xi)+f'(\xi)=0\).
\begin{proof}
令\(F(x)=f(x)\cdot\exp\left(\frac{1}{3}x^3\right)\), 则\(F(a)=F(b)=0\), 
由Rolle定理知存在\(\xi\in(a,b)\)使得
\[F'(\xi)=\exp\left(\frac{1}{3}\xi^3\right)\left(\xi^2f(\xi)+f'(\xi)\right)=0,\]
结论得证.
\end{proof}
\item 存在\(\xi\in(a,b)\)使得\(f^2(\xi)\sin\xi+f'(\xi)=0\).
\begin{proof}
令\(F(x)=f(x)\cdot\exp\left(\int_a^x f(t)\sin t\,\dd t\right)\), 则\(F(a)=F(b)=0\), 
由Rolle定理知存在\(\xi\in(a,b)\)使得
\[F'(\xi)=\exp\left(\int_a^x f(t)\sin t\,\dd t\right)\left(f^2(\xi)\sin\xi+f'(\xi)\right)=0,\]
结论得证.
\end{proof}
\end{enumerate}
\item 设实函数\(f\)在\([a,b]\)上可导, \(f(a)=f(b)=0\). 
证明: 存在\(\xi\in(a,b)\)使得\[f^3(\xi)+f'(\xi)=0.\]
\begin{proof}
令\[F(x)=f(x)\cdot\exp\left(\int_a^x f^2(t)\,\dd t\right),\]
则\(F(a)=F(b)=0\), 由Rolle定理知存在\(\xi\in(a,b)\)使得
\[F'(\xi)=\exp\left(\int_a^\xi f^2(t)\,\dd t\right)\left(f^3(\xi)+f'(\xi)\right)=0,\]
从而得证.
\end{proof}
\item 设实函数\(f\)在\([0,1]\)上连续, 在\((0,1)\)内二阶可导. 
已知\(f(0)=f(1)=0,f\left(\frac{1}{2}\right)=\frac{1}{4}\). 
证明: 存在\(\xi\in(0,1)\), 使得\(f''(\xi)=-2\).
\begin{proof}
令\(F(x)=f(x)+x^2\), 则\(F(0)=0,F(1)=1,F\left(\frac{1}{2}\right)=\frac{1}{2}\), 
则由Lagrange中值定理知存在\(\xi_1\in \left(0,\frac{1}{2}\right),\xi_2\in\left(\frac{1}{2},1\right)\)使得
\[F'(\xi_1)=\frac{F\left(1/2\right)-F(0)}{1/2-0}=1,\quad F'(\xi_2)=\frac{F(1)-F\left(1/2\right)}{1-1/2}=1,\]
由Rolle定理知存在\(\xi\in(\xi_1,\xi_2)\)使得\(F''(\xi)=f''(\xi)+2=0\). 得证.
\end{proof}
\item 设实函数\(f\)在\([0,1]\)上有二阶导数, 且
\[f(0)=1,\quad f(1)=3\ee,\quad f'(1)=5\ee.\]
证明或证伪: 存在\(\xi\in(0,1)\)使得\[f''(\xi)-2f'(\xi)+f(\xi)=0.\]
\begin{proof}
令\(F(x)=\ee^{-x}f(x).\) 则\(F(0)=1,F(1)=3\), 由Lagrange中值定理知存在\(\eta\in(0,1)\)使得
\[F'(\eta)=\frac{F(1)-F(0)}{1-0}=2,\]
而易见\(F'(1)=2\), 从由Rolle定理存在\(\xi\in(\eta,1)\)
使得\[F''(\xi)=\ee^{-\xi}\big(f''(\xi)-2f'(\xi)+f(\xi)\big)=0.\qedhere\]
\end{proof}
\item 设一元实函数\(f\)在\([1,2]\)上有二阶导数, 且\(f(2)=0\). 
令\(F(x)=(x-1)^2f(x)\), 证明: 存在\(\xi\in(1,2)\)使得\(F''(\xi)=0.\)
\begin{proof}
易见\(F(1)=F(2)=0\), 由Rolle定理知存在\(\eta\in(1,2)\)使得\(F'(\eta)=0\). 
易见\(F'(1)=0\), 再次使用Rolle定理知存在\(\xi\in(1,\eta)\)使得\(F''(\xi)=0\).
\end{proof}
\item 设\(\delta>0\), 在\((-\delta,\delta)\)内, 一元实函数\(f\)可微, 且满足
\[f(x+y)=\frac{f(x)+f(y)}{1-f(x)f(y)},\quad\forall\,x,y,x+y\in(-\delta,\delta).\]
试求\(f\).
\begin{proof}[解答]
易见\(f(0)=0\), 方程两侧对\(y\)求导得到
\[f'(x+y)=\frac{f'(y)\left(1-f(x)f(y)\right)+f(x)f'(y)\left(f(x)+f(y)\right)}{(1-f(x)f(y))^2},\]
记\(a=f'(0)\), 同时令\(y=0\)得到\[f'(x)=a+af^2(x),\]容易解得\(f(x)=\tan ax\).

另一个方法是考虑\(g(x)=\arctan f(x)\)，并证明\[g(x+y)=g(x)+g(y).\]

具体来讲，直接对两边取\(\arctan\)可得\[\arctan g(x+y)=\arctan\big(g(x)+g(y)\big),\]
即\[\operatorname{Im}G=\{G(x,y):x,y,x+y\in(-\delta,\delta)\}\subseteq\pi\Z,\]
其中\[G(x,y)=g(x+y)-g(x)-g(y).\]
由于\(\{(x,y):x,y,x+y\in(-\delta,\delta)\}\)是连通集而$G$连续，
得$\operatorname{Im}G$同样是连通集，
又\(0\in\operatorname{Im}G\)，只能\(\operatorname{Im}G=\{0\}\)。
\end{proof}
\item 设\(a_1=2,a_2=3,a_{n+2}=a_{n+1}+\frac{1}{\ln a_n}\ (n\geqslant 1)\). 
证明: \(\lim_{n\rightarrow+\infty}\frac{a_n\ln a_n}{n}\)存在并求其值.
\begin{proof}[解答]
易见\(\{a_n\}\)单增，则其要么收敛于某个数$a$，要么无界。
前者是不可能的，不然$a=a+\dfrac{1}{a}$，因此是后者。
进而有$a_{n+1}-a_n\to0$，和
\[\ln a_{n+1}=\ln a_n+\ln\left(1+\frac{1}{a_n\ln a_{n-1}}\right)\sim\ln a_n.\]
由Stolz定理，题中的极限等于下式的极限：
\begin{align*}
    &\quad\ \ a_{n+1}\ln a_{n+1}-a_n\ln a_n\\
    &=(a_{n+1}-a_n)\ln a_{n+1}-a_n(\ln a_{n+1}-\ln a_n)\\
    &=\frac{\ln a_{n+1}}{\ln a_{n-1}}-a_n\left[\left(\frac{a_{n+1}}{a_n}-1\right)+o\left(\frac{a_{n+1}}{a_n}-1\right)\right]\\
    &=\frac{\ln a_{n+1}}{\ln a_{n-1}}-[(a_{n+1}-a_n)+o(a_{n+1}-a_n)]\to1.
\end{align*}
\end{proof}
\item 设\(\psi\)是\((0,+\infty)\)上局部有界的实值函数, 满足
\[\psi(xy)=\psi(x)+\psi(y),\qquad\forall\, x,y\in(0,+\infty).\]
试证明:
\begin{enumerate}[label=(\arabic*)]
\item \(\psi\)在\((0,+\infty)\)上某一点连续, 进而在\((0,+\infty)\)每一点连续.
\item 对任何\(x>0\)以及有理数\(q\), \(\psi(x^q)=q\psi(x).\)
\item 对任何\(x>0\)以及实数\(y\), \(\psi(x^y)=y\psi(x).\)
\end{enumerate}
特别地, 对任何\(x>0\)成立\(\psi(x)=\psi(\ee)\ln x\).
\begin{proof}
    (1) 令$y=0$得$\psi(1)=0$。假如$\psi$在$1$处不连续，
    则存在$\delta>0$和一列$\{t_n\}\to1$，使得$|\psi(t_n)|>\delta$。
    这样，对任何给定的邻域$O\ni1$和正整数$N$，都能选很靠近$1$的$t_n$使得$t_n^N\in O$，
    从而$|\psi(t_n^N)|=|N\psi(t_n)|>N\delta$，
    那么$\psi$在$O$上无界，也就是在$1$处不局部有界，矛盾。

    (2) 当$q>0$，设$q=m/n$，其中$m,n$为正整数，则由
    \[\psi(x^\frac{m}{n})=m\psi(x^\frac{1}{n}),\quad\psi(x)=n\psi(x^\frac{1}{n})\]
    得$\psi(x^\frac{m}{n})=\frac{m}{n}\psi(x)$。

    (3) 结合(i),\,(ii)。特别地，取$x={\rm e},y=\ln x$得到$\psi(x)=\psi({\rm e})\ln x$。
\end{proof}
\item 若对任何\(x,y\in\mathbb{R},\mathbb{R}\)上不恒为零的一元实函数\(f\)满足\(f(x+y)=f(x)f(y)\). 
进一步, \(f\)在\(\mathbb{R}\)上局部有界, 证明: 存在常数\(a\)使得
\[f(x)=a^x,\quad\forall\,x\in\mathbb{R}.\]
\item 举例说明中值定理对于复值函数不成立.
\begin{proof}[解答]
    如\(f(x)=\ee^{2\pi{\rm i}x}\)，\(f(0)=f(1)=1\)，
    而\(f'(x)=2\pi{\rm i}\ee^{2\pi{\rm i}x}\)在$(0,1)$内一直取不到\(0\)。
\end{proof}
\item 设\(f,g\in C[a,b]\), \(g\)严格单调. 证明: 存在\([a_1,b_1]\subset [a,b]\)使得\(b_1-a_1=\frac{b-a}{2}\), 且
\[\frac{f(b_1)-f(a_1)}{g(b_1)-g(a_1)}=\frac{f(b)-f(a)}{g(b)-g(a)}.\]
\begin{proof}
简记
\[m=\frac{a+b}{2},\quad t=\frac{g(m)-g(a)}{g(b)-g(a)},
\quad s=\frac{f(b)-f(a)}{g(b)-g(a)},\]
以及
\[c=\frac{b-a}{2}, \quad F(x)=\frac{f(x+c)-f(x)}{g(x+c)-g(x)}.\]
$g$严格单调表明$t\in(0,1)$，并注意到\begin{align*}
    F(a)t+F(c)(1-t)
    &=\frac{f(m)-f(a)}{g(m)-g(a)}\frac{g(m)-g(a)}{g(b)-g(a)}\\
    &+\frac{f(b)-f(m)}{g(b)-g(m)}\frac{g(b)-g(m)}{g(b)-g(a)}\\
    &=\frac{f(m)-f(a)}{g(b)-g(a)}+\frac{f(b)-f(m)}{g(b)-g(a)}\\
    &=\frac{f(b)-f(a)}{g(b)-g(a)}=s,
\end{align*}
可知\(F(a)-s\)与\(F(c)-s\)异号, 从而$F(x)-s$有零点$a_1$.
\end{proof}
\end{enumerate}
\end{1a}
\begin{1b}
\begin{enumerate}
\item 若对任何\(x,y\in\mathbb{R}\), \(\mathbb{R}\)上的一元复值函数\(f\)满足\(f(x+y)=f(x)f(y)\). 
进一步, \(f\)在\(\mathbb{R}\)上局部有界. 试问, \(f\)的解具有什么形式?
\item 在上一题中, 假设\(f\)的取值为\(n\)阶方阵, 结论又如何?
\item 设\(f\)在\((a,b)\)内连续且右导数为\(f'_+(x)=x\arctan x\). 
证明: \(f\)在\((a,b)\)内可导.
\item 设实函数\(f\)在\(\left[0,+\infty\right)\)上有二阶的连续导数, 
满足\(f(0)=f'(0)=0\)以及\(f''(x)+3f'(x)+2f(x)\geqslant 0\). 
证明: \(f(x)\geqslant 0\ (\forall\,x\in [0,+\infty))\).
\item 设实函数\(f\)在区间\([-1,1]\)上连续, 在\((-1,1)\)内三阶可导. 
证明: 存在\(\xi\in(-1,1)\)使得\(f'''(\xi)=3\big(f(1)-f(-1)-2f'(0)\big)\).
\begin{proof}
令\[\begin{split}
F(x)=f(x)&-\left(\frac{f(1)-f(-1)-2f'(0)}{2}\right)x^3\\
&+\left(f(0)-\frac{f(-1)+f(1)}{2}\right)x^2-f'(0)x.
\end{split}\]于是有\[F(-1)=F(0)=F(1)=f(0),\]
由Rolle定理可知存在\(\xi_1\in(-1,0), \xi_2\in(0,1)\)
使得\(F'(\xi_1)=F'(\xi_2)=0\), 又有\(F'(0)=0\),
再次使用Rolle定理, 即存在\(\xi_3\in(\xi_1,0)\)与\(\xi_4\in(0,\xi_2)\)
使得\(F''(\xi_3)=F''(\xi_4)=0\), 
依Rolle定理存在\(\xi\in(\xi_3,\xi_4)\)使得\(F'''(\xi)=0\). 结论得证.
\end{proof}
\item 设实函数\(f\)为\(\mathbb{R}\)上的有界可微函数, 且对任何\(x\)均有\(|f'(x)|<1\). 
证明: 存在\(M<1\)使得对任何\(x\in\mathbb{R}\)成立\(|f(x)-f(0)|\leqslant M|x|\).

进一步, 是否存在常数\(K<1\), 使得对任何\(x,y\in\mathbb{R}\), 均有\(|f(x)-f(y)|\leqslant K|x-y|\)?
\begin{proof}
由Lagrange中值定理, 有\[\left|\frac{f(x)-f(0)}{x-0}\right|=|f'(\xi)|<M<1,\quad \xi\in(0,x),\]
由此知\(|f(x)-f(0)|<M|x|\). 后一结论不成立.
\end{proof}
\item 设实函数\(f\)是\(\mathbb{R}\)上的连续可导函数, 
且\(\forall\, x\in\mathbb{R}\), \(f'(x)>f(f(x))\). 
证明: \(\forall\, x\geqslant 0,f(f(f(x)))\leqslant 0\).
\begin{proof}

\textbf{Lemma 1} Either $\lim\limits_{x \rightarrow+\infty} f(x)$ does not exist 
or $\lim\limits_{x \rightarrow+\infty} f(x) \neq+\infty$.

Proof. Assume that the limit is $+\infty$. 
Then there exists $a>0$ such that $f(x)>2$ when $x>a$. 
Plus, there exists $b>0$ such that $f(x)>a$ when $x>b$. Hence, 
\[f^{\prime}(x)>f(f(x))>2\]
for $x>b$. Hence, there exists $c$ such that $f(x)>x$ for $x>c$. Then for $x>c$, we have
\[f^{\prime}(x)>f(f(x))>f(x) \ \ \Rightarrow \ \ f^{\prime}(x)/f(x)>1.\]
Integrating from $c$ to $x$ on both sides yields \[\log f(x)-\log f(c)>x-c,\]
i.e. $f(x)>f(c) e^{x-c}$ for all $x>c$. Then substituting $x$ with $f(x)$, we get
\[f^{\prime}(x)>f(f(x))>f(c) e^{f(x)-c},\]
i.e. \[f^{\prime}(x) e^{-f(x)}>f(c) e^{-c}.\]
Integrating from $c$ to $x$ again yields
\[e^{-f(c)}-e^{-f(x)}>(x-c) f(c) e^{-c}.\]
The right--hand side tends to infinity as $x\to+\infty$, 
while the left--hand side is bounded from above, a contradiction.

\textbf{Lemma 2} For $x>0$, we have $f(x)<x$.

Proof. By Lemma 1, there exists some $x>0$ with $f(x)<x$ 
(otherwise $f(x)$ would always be greater than $x$, and tend therefore to infinity). 
Hence, were the statement false, there would have to be some $t>0$ with $f(t)=t$.

Case I: There exists certain $x \geqslant t$ with $f(x)<t$. 
Let $T=\inf \{x \geqslant t: f(x)<t\}$. 
By the continuity of $f$, $f(T)=t$. Then
\[f^{\prime}(T)>f(f(T))=f(t)=t>0,\]
which implies that $f>f(T)=t$ in a right neighbourhood of $T$, 
contradicting the definition of $T$.

Case II: $f(x) \geqslant t$ for all $x \geqslant t$. Now we have
\[f^{\prime}(x)>f(f(x)) \geqslant t>0\]
for $x \geqslant t$. Then $f^{\prime}$ has a positive lower bound 
over $(t,+\infty)$, which contradicts Lemma 1.

\textbf{Lemma 3} (a) If $f(r)>0$ and $f(s) \geqslant r$, then $f(x)>r$ when $x>s$.

(b) In particular, if $r \leqslant 0$ and $f(r)>0$, then $f(x)>r$ when $x>r$.

Proof. Suppose that there exists certain $x>s$ with $f(x) \leqslant r$, 
and let $S=\inf \{x>s: f(x) \leqslant r\}$. 
By the continuity, we have $f(S)=r$. Similar to Lemma 2, we have
\[f^{\prime}(S)>f(f(S))=f(r)>0.\]
If $S>s$, then in a left neighbourhood of $S$ we have $f<f(S)=r$, 
contradicting the definition of $S$. 
Otherwise we have $S=s$, then $f>r$ in a right neighbourhood of $s$, 
contradiction again.

Part (b) follows directly from taking $s=r$.

With the help of these lemmas the proof goes as follows. 
Assume for contradiction that there exists some $t_0>0$ with $f(f(f(t_0)))>0$. 
Let $t_1=f(t_0), t_2=f(t_1)$ and $t_3=f(t_2)>0$. 
We show that $0<t_3<t_2<t_1<t_0$. By lemma 2 it suffices to prove that $t_1$ and $t_2$ are positive. 

If $t_1<0$, then $f(t_1) \leqslant 0$ (if $f(t_1)>0$ 
then taking $r=t_1$ in Lemma 3 (b) yields $f(t_0)>t_1$, contradiction). 
If $t_1=0$ then $f(t_1) \leqslant 0$ by lemma 2 and the continuity of $f$. 
Hence, if $t_1 \leqslant 0$, then also $t_2 \leqslant 0$. 
If $t_2=0$ then $f(t_2) \leqslant 0$ by lemma 2 and the continuity of $f$ 
(contradiction, as by definition $f(t_2)=t_3>0$). 
If $t_2<0$, then by lemma 3 (b) with $r=t_2$, $f(t_0)>t_2$ 
(recall that $t_0>0$, so $t_0>t_2$), i.e. $t_1>t_2$. 
Applying lemma 3 (b) with $r=t_2$ again, we obtain $f(t_1)>t_2$, contradiction. 
We have now proved $0<t_3<t_2<t_1<t_0$.

By lemma 3 (a) (with $f(t_1)>0$ and $f(t_0) \geqslant t_1$) 
we have $f(x)>t_1$ for all $x>t_0$, and similarly $f(x)>t_2$ for all $x>t_1$. 
It follows that for $x>t_0$ we have $f^{\prime}(x)>f(f(x))>t_2$, where $t_2>0$. 
Hence, $\lim\limits_{x \rightarrow+\infty} f(x)=+\infty$, which is a contradiction. 
This contradiction indicates that $f(f(f(x))) \leqslant 0$ for all $x>0$. 
And for $x=0$, the inequality follows from the continuity of $f$.
\end{proof}
\end{enumerate}
\end{1b}

\section{L'H\^{o}pital法则}
\subsection{L'H\^{o}pital法则及其推广,极限计算的化简------``去核''与``去皮''}
\begin{2a}
\begin{enumerate}
\item 设\(x_0\in(0,\pi),x_{n+1}=\sin x_n\ (n\geqslant 0)\). 
计算\(\lim_{n\rightarrow+\infty}\sqrt{n}\sin x_n\).
\begin{proof}[解答]
易见\(\{x_n\}\)大于零单调递减有下界, 取极限得\(\lim_{n\rightarrow\infty}x_n=0\), 而
\begin{align*}
\lim_{n\rightarrow\infty}\frac{1}{n\sin^2 x_n}
&\xlongequal{\text{Stolz}}\lim_{n\rightarrow\infty}\frac{\sin^2x_n-\sin^2x_{n+1}}{\sin^2x_n\sin^2x_{n+1}}\\
&=\lim_{n\rightarrow\infty}\frac{x_{n+1}^2-\sin^2x_{n+1}}{x_{n+1}^2\sin^2x_{n+1}}\\
&=\lim_{x\rightarrow 0}\frac{(x-\sin x)(x+\sin x)}{x^2\sin^2x}\\
&=\lim_{x\rightarrow 0}\frac{1/6\cdot x^3\cdot 2x}{x^4}=\frac{1}{3}.
\end{align*}
从而\(\lim_{n\rightarrow+\infty}\sqrt{n}\sin x_n=\sqrt{3}\).
\end{proof}
\item 计算\(\lim_{x\rightarrow 0}\left(\frac{\arcsin x}{x}\right)^{1/x^2}\).
\begin{proof}[解答]
由于\[\lim_{x\rightarrow 0}\frac{\ln\left(\dfrac{\arcsin x}{x}\right)}{x^2}
=\lim_{x\rightarrow 0}\frac{\arcsin x-x}{x^3}=\frac{1}{6}.\]
从而\(\lim_{x\rightarrow 0}\left(\frac{\arcsin x}{x}\right)^{1/x^2}
=\exp\left(\frac{1}{6}\right)\).
\end{proof}
\item 计算\(\lim_{x\rightarrow+\infty}\left(\left(x^3-x^2+\frac{x}{2}\right)\ee^{1/x}-\sqrt{x^6+x}\right)\).
\begin{proof}[解答]
令\(t=\frac{1}{x}\), 则原极限变为
\[\lim_{t\rightarrow0^+}\frac{\ee^t\left(1-t+\dfrac{1}{2}t^2\right)-\sqrt{1+t^5}}{t^3}\xlongequal{\text{L'H\^{o}pital}}\lim_{t\rightarrow 0^+}\frac{\dfrac{1}{2}t^2\ee^t-\dfrac{5t^4}{2\sqrt{1+t^5}}}{3t^2}=\frac{1}{6}.\qedhere\]
\end{proof}
\item 计算:
\begin{enumerate}[label=(\arabic*)]
\item \(\lim_{x\rightarrow 0}\frac{\arctan(\sin x)-\arctan(\ln (1+x))}{x^2}\).
\begin{proof}[解答]
注意到\(\lim_{x\rightarrow 0}\frac{\sin x-\ln(1+x)}{x^2}\xlongequal{\text{L'H\^{o}pital}}\frac{1}{2}\), 于是有
\[\begin{split}
&\quad\lim_{x\rightarrow 0}\frac{\arctan(\sin x)-\arctan(\ln (1+x))}{x^2}\\
&=\lim_{x\rightarrow 0}\frac{\arctan(\sin x)-\arctan(\ln (1+x))}{\sin x-\ln(1+x)}\cdot\frac{\sin x-\ln(1+x)}{x^2}\\
&=\frac{1}{2}\lim_{x\rightarrow 0}\left(\arctan x\right)'=\frac{1}{2}.
\end{split}\]
\end{proof}
\item \(\lim_{x\rightarrow 0}\frac{(1+\tan x)^{3/2}-(1+x)^{3/2}}{x^3}.\)
\begin{proof}[解答]
注意到\(\lim_{x\rightarrow 0}\frac{\tan x-x}{x^3}\xlongequal{\text{L'H\^{o}pital}}\frac{1}{3}\), 于是有
\[\begin{aligned}
&\quad\lim_{x\rightarrow 0}\frac{(1+\tan x)^{3/2}-(1+x)^{3/2}}{x^3}\\
&=\lim_{x\rightarrow 0}\frac{(1+\tan x)^{3/2}-(1+x)^{3/2}}{\tan x-x}\cdot\frac{\tan x-x}{x^3}\\
&=\frac{1}{3}\lim_{x\rightarrow 0}\left((1+x)^{3/2}\right)'=\frac{1}{2}.
\end{aligned}\]
\end{proof}
\item \(\lim_{x\rightarrow 0}\left(\frac{1}{\ln (x+\sqrt{1+x^2})}-\frac{1}{\ln(1+x)}\right).\)
\begin{proof}[解答]
记\(F(x)=\ln(1+x),\varphi(x)=x,\psi(x)=x+\sqrt{1+x^2}-1\), 注意到
\[\lim_{x\rightarrow 0}F'(x)=1,\quad\lim_{x\rightarrow 0}\frac{\varphi(x)}{x}
=\lim_{x\rightarrow 0}\frac{\psi(x)}{x}=1,\]
以及\begin{gather*}
\lim_{x\rightarrow 0}\frac{\varphi(x)-\psi(x)}{x^2}
=\lim_{x\rightarrow 0}\frac{1-\sqrt{1+x^2}}{x^2}
\xlongequal{\text{L'H\^{o}pital}}-\frac{1}{2}\\
\lim_{x\rightarrow 0}\frac{\varphi(x)\psi(x)}{x^2}
=\lim_{x\rightarrow 0}\frac{\varphi(x)}{x}\cdot\lim_{x\rightarrow 0}\frac{\psi(x)}{x}=1.
\end{gather*}
从而\[\begin{aligned}
&\quad\lim_{x\rightarrow 0}\left(\frac{1}{\ln (x+\sqrt{1+x^2})}-\frac{1}{\ln(1+x)}\right)\\
&=\lim_{x\rightarrow 0}\frac{\ln(1+x)-\ln\left(x+\sqrt{1+x^2}\right)}{\ln (x+\sqrt{1+x^2})\cdot\ln(1+x)}\\
&=\lim_{x\rightarrow 0}\frac{\ln(1+x)-\ln\left(x+\sqrt{1+x^2}\right)}{x^2}=-\frac{1}{2}.
\end{aligned}\]
\end{proof}
\item \(\lim_{x\rightarrow 0}\frac{\left(1+\frac{x}{x+1}\right)^{(1+x)/x}-\left(1+\tan x\right)^{1/\tan x}}{x^2}\).
\begin{proof}[解答]
设\(F(x)=\left(1+x\right)^{1/x}\), 注意到
\[\lim_{x\rightarrow 0}\frac{\frac{x}{x+1}-\tan x}{x^2}
=\lim_{x\rightarrow0}\frac{x-(x+1)\tan x}{x^2}\xlongequal{\text{L'H\^{o}pital}}-1,\]
以及\[\lim_{x\rightarrow 0}F'(x)=\ee\lim_{x\rightarrow 0}\frac{x-(1+x)\ln(1+x)}{x^2}\xlongequal{\text{L'H\^{o}pital}}-\frac{\ee}{2}.\]
于是\[\begin{aligned}
&\quad\lim_{x\rightarrow 0}\frac{\left(1+\frac{x}{x+1}\right)^{(1+x)/x}-\left(1+\tan x\right)^{1/\tan x}}{x^2}\\
&=\lim_{x\rightarrow 0}\frac{\left(1+\frac{x}{x+1}\right)^{(1+x)/x}-\left(1+\tan x\right)^{1/\tan x}}{\frac{x}{x+1}-\tan x}\cdot\frac{\frac{x}{x+1}-\tan x}{x^2}=\frac{\ee}{2}.
\end{aligned}\]
\end{proof}
\end{enumerate}
\item 设\(f\)在\([a,b]\)上两阶可导, 且满足\(|f''(x)|\leqslant M|f(x)|,f(a)=f'(a)=0\), 其中\(M\)是一个常数, 证明\(f(x)\equiv 0\).
\begin{proof}
97页

反证法. 若\(\exists x_0\in(a,b]\)使得\(f(x_0)\ne 0\), 不妨设\(f(x_0)>0\), 记
\[c=\sup\{x\in[a,x_0]\big|f(x)\leqslant 0\},\]
则\(c\)适定, 且\(c\in\left[a,x_0\right),f(c)=0\),
\[f(x)>0,\qquad\forall\, x\in(c,x_0).\]
在\((c,x_0)\)内, 有\[\frac{f'(x)}{f(x)}\leqslant M,\]
即\[\left(\ln f(x)\right)'\leqslant M,\quad\forall\, x\in(c,x_0),\]
所以由中值定理可得\[\frac{\ln f(x_0)-\ln f(x)}{x_0-c}\leqslant M,\quad\forall\, x\in(c,x_0).\]
在上式中令\(x\rightarrow c^+\), 并注意到\(f(c)=0\), 
得到\(+\infty\leqslant M\). 矛盾, 所以\(f(x)\equiv 0\).
\end{proof}
\item 设\(f\)在\(\left[0,+\infty\right)\)可导, 
且\(f'(x)\)在\(\left(0,+\infty\right)\)上一致连续, 
\(\lim_{x\rightarrow+\infty}f(x)\)存在. 
证明\(\lim_{x\rightarrow+\infty}f'(x)=0\).
\begin{proof}

\end{proof}
\item 设\(f\)在\(\mathbb{R}\)上连续可微, 
且\(f(x+1)-f(x)=f'(x)\) \((\forall\, x\in\mathbb{R})\), 
\(\lim_{x\rightarrow+\infty}f'(x)=c\). 证明\(f'(x)\equiv c\).
\begin{proof}
反证法. 设有\(\xi_0\)使得\(f'(\xi_0)\ne c\), 则
\[f(\xi_0+1)-f(\xi_0)=f'(\xi_0),\] 
由Lagrange中值定理可知存在\(\xi_1\in(\xi_0,\xi_0+1)\)使得
\[f'(\xi_0)=f(\xi_0+1)-f(\xi_0)=f'(\xi_1),\] 
则\(f(\xi_1+1)-f(\xi_1)=f'(\xi_1)\). 
又由Lagrange中值定理知存在\(\xi_2\in(\xi_1,\xi_1+1)\)使得
\[f'(\xi_0)=f(\xi_1+1)-f(\xi_1)=f'(\xi_2),\]
重复这个操作得到\(\{\xi_n\}\)使得\(f'(\xi_n)=f'(\xi_0)\) \((n=0,1,2\cdots)\), 
设集合\(E\)为全体导数值等于\(f'(\xi_0)\)的坐标全体, 即
\[E=\{\xi\big|f'(\xi)=f'(\xi_0)\},\]由上面的信息可见\(E\)为无限集。

若\(E\)无界, 则与题设\(\lim_{x\rightarrow+\infty}f'(x)=c\)矛盾. 下证\(E\)必无界. 

事实上, 若\(E\)有界, 则必有上确界, 记\(\sup_{\xi\in E}\xi =M\), 
从\(E\)中选取一子列\(\{\xi'_n\}\)使其收敛于\(M\), 结合\(f(x)\)的连续性有
\[f'(\xi_0)=\lim_{n\rightarrow\infty}\left[f(\xi'_n+1)-f(\xi'_n)\right]=f(M+1)-f(M),\]
由Lagrange中值定理可知存在\(\xi'\in(M,M+1)\)使得\(f'(\xi')=f'(\xi_0)\), 
即\(\xi'\in E\)并且\(\xi'>M\), 矛盾. 进而\(E\)无界.
\end{proof}
\end{enumerate}
\end{2a}
\begin{2b}
\begin{enumerate}
\item 设\(x\in(0,1),p>0\), 试考察级数
\[\left(\sin x\right)^p-\left(\sin\left(\sin x\right)\right)^p
+\left(\sin\left(\sin\left(\sin x\right)\right)\right)^p
-\left(\sin\left(\sin\left(\sin\left(\sin x\right)\right)\right)\right)^p+\cdots\]
的收敛性(含绝对收敛性).
\begin{proof}[解答]
记\(a_0=x\), \(a_{n+1}=\sin a_n\ (n\geqslant 1)\), 
于是原级数即为\(\sum_{n=1}^{\infty}(-1)^{n+1}a_n\), 
参考6.2.\(\boldsymbol{\mathcal{A}}\)可知\(\{a_n^p\}\)单调递减趋于零, 
由Leibniz判别法可知原级数收敛. 

并且由\(\lim_{n\rightarrow+\infty}\sqrt{n}\sin a_n=\sqrt{3}\)可知\(a_n\sim\sqrt{\frac{3}{n}}\), 
即\(a_n^p\sim\left(\frac{3}{n}\right)^{p/2}\), 从而\(p>2\)时原级数绝对收敛.
\end{proof}
\item 设\(n\geqslant 1\), \(P\)为\(n\)阶实系数多项式, 
则对于\(\mathbb{R}\)上任何\(n\)次可导的实函数\(f\), 
\(\lim_{x\rightarrow +\infty}P({\rm D})f(x)=0\)
均蕴涵\(\lim_{x\rightarrow+\infty}f(x)=0\)的充要条件是\(P\)的所有零点都有负实部.
\begin{proof}
	必要性.
    
    充分性.
\end{proof}
\item 设\(f\)在\(\left[1,+\infty\right)\)上连续, 在\(\left(1,+\infty\right)\)上可导, 
且\(\ee^{x^2}f'(x)\)在\(\left(1,+\infty\right)\)上有界, 
则在什么条件下可得\(x\ee^{x^2}f(x)\)在\(\left[1,+\infty\right)\)上有界?
\begin{proof}[解答]
	
\end{proof}
\item 设实函数\(f\)在\(\mathbb{R}\)上有界, 可导且\(|f'(x)|<1\) \((\forall\, x\in\mathbb{R})\), 
又设\(x_0\in\mathbb{R},x_{n+1}=f(x_n)\) \((n\geqslant 0)\), 证明\(\{x_n\}\)收敛.
\begin{proof}
设\(\max\{\left|f(x)\right|,|x_0|\}\leqslant M\). 
考虑\(F(x)=x-f(x)\), 由于\[F(-M)=-M-f(-M)\leqslant 0,\]
且\[F(M)=M-f(M)\geqslant 0,\]
从而有\(x^*\in[-M,M]\)使得\(F(x^*)=0\). 
下面说明, 这样的\(x^*\)是唯一的, 事实上由于\(|f'(x)|<1\), 
由Lagrange中值定理, 对任意\(x<y\), 存在\(\xi\in(x,y)\)使得
\[\left|f(x)-f(y)\right|=|f'(\xi)||x-y|<|x-y|,\]
若还有\(x'\ne x^*\)使得\(F(x')=0\), 则有\(|f(x^*)-f(x')|=|x^*-x'|\)矛盾.

再证\(\{x_n\}\)收敛到\(x^*\), 由于
\[\left|x_{n+1}-x^*\right|=\left|f(x_n)-f(x^*)\right|<\left|x_n-x^*\right|,\]
从而\(\{|x_n-x^*|\}\)单调递减, 设其极限为\(A\), 则\(\{x_n\}\)必存在子列收敛到\(x^*\pm A\). 
不妨设\(\{x_n\}\)本身收敛到\(x^*+A\), 则\(x_{n+1}=f(x_n)\)收敛到\(f(x^*+A)\), 
也即\(x^*+A=f(x^*+A)\), 则\(F(x^*+A)=0\), 由上述知\(A\)只能为\(0\). 从而\(\{x_n\}\)收敛.
\end{proof}
\item 设实函数\(f\)在\(\mathbb{R}\)上可导且\(|f'(x)|<1\) \((\forall\, x\in\mathbb{R})\), 
又设\(x_0\in\mathbb{R},x_{n+1}=f(x_n)\) \((n\geqslant 0)\), 
证明\(\{x_n\}\)收敛或举例说明\(\{x_n\}\)可能发散.
\begin{proof}[解答]
\(\{x_n\}\)可能发散. 设\[f(x)=\begin{cases}
x+\frac{1}{x},&x\geqslant 1,\\
2,&-1<x<1,\\
-x-\frac{1}{x},&x\leqslant -1
\end{cases}\]
取\(x_0=1\)易见\(\{x_n\}\)发散.
\end{proof}
\item 设\(\boldsymbol{F}:\mathbb{R}^n\rightarrow\mathbb{R}^n\)是可微的有界函数, 
\(\left\| \boldsymbol{F_x}(\boldsymbol{x})\right\|<1\ (\forall\,\boldsymbol{x}\in\mathbb{R}^n)\)。
任取\(\boldsymbol{x}_0\in\mathbb{R}^n\), 令\(\boldsymbol{x}_{k+1}=\boldsymbol{F}(\boldsymbol{x}_k)\ (k\geqslant 0)\), 
证明\(\{\boldsymbol{x}_k\}\)收敛.
\begin{proof}
由于
\begin{align*}
    \boldsymbol{F}(\boldsymbol{x})-\boldsymbol{F}(\boldsymbol{y})
    &=\int_0^1\frac{\rm d}{{\rm d}t}\boldsymbol{F}(t\boldsymbol{x}+(1-t)\boldsymbol{y})\,{\rm d}t\\
    &=\int_0^1\boldsymbol{F}_{\!\boldsymbol{x}}(t\boldsymbol{x}+(1-t)\boldsymbol{y})(\boldsymbol{x}-\boldsymbol{y})\,{\rm d}t,
\end{align*}
得到
\[\|\boldsymbol{F}(\boldsymbol{x})-\boldsymbol{F}(\boldsymbol{y})\|
\leqslant\max_{t\in[0,1]}\|\boldsymbol{F}_{\!\boldsymbol{x}}(t\boldsymbol{x}+(1-t)\boldsymbol{y})\|\|\boldsymbol{x}-\boldsymbol{y}\|.\]
设$K$是$\{\boldsymbol{x}_k\}_{k\geqslant0}$的闭凸包，$\boldsymbol{F}$有界保证了$K$是紧集，
则$\alpha:=\max\limits_{\boldsymbol{x} \in K}\|\boldsymbol{F}_{\!\boldsymbol{x}}(\boldsymbol{x})\|<1$。由于
\[\|\boldsymbol{x}_{k+2}-\boldsymbol{x}_{k+1}\|
=\|\boldsymbol{F}(\boldsymbol{x}_{k+1})-\boldsymbol{F}(\boldsymbol{x}_{k})\|
\leqslant\alpha\|\boldsymbol{x}_{k+1}-\boldsymbol{x}_{k}\|,\]
得到
\[\|\boldsymbol{x}_{\ell}-\boldsymbol{x}_{k}\|
\leqslant\sum_{i=k}^{\ell-1}\|\boldsymbol{x}_{i+1}-\boldsymbol{x}_{i}\|
\leqslant\sum_{i=k}^{\ell-1}\alpha^i\|\boldsymbol{x}_{1}-\boldsymbol{x}_{0}\|
\leqslant\frac{\alpha^k}{1-\alpha}\|\boldsymbol{x}_{1}-\boldsymbol{x}_{0}\|,\]
从而$\{\boldsymbol{x}_k\}_{k\geqslant0}$是Cauchy列，收敛于某点$\boldsymbol{x}^*$。

下面说明这样的\(\boldsymbol{x^*}\)是唯一的。
若还有\(\boldsymbol{x^{**}}\ne\boldsymbol{x^*}\)
使得\(\boldsymbol{F}(\boldsymbol{x^{**}})=\boldsymbol{x}^{**}\), 
则有\(\|\boldsymbol{F}(\boldsymbol{x^*})-\boldsymbol{F}(\boldsymbol{x^{**}})\|
=\|\boldsymbol{x^*}-\boldsymbol{x^{**}}\|\)，矛盾.
\end{proof}
\end{enumerate}
\end{2b}

\section{凸函数}
\subsection{凸(凹)函数, Jensen不等式,割线斜率与凸性,凸性与连续性,中点凸(凹)函数,凸函数与一阶导数,支撑线(面),凸性与二阶导数, Hesse矩阵,对偶数, Young不等式,离散H\"{o}lder不等式,离散Minkowski不等式,幂平均不等式,调和平均}
\begin{definition}\label{C61}
设\(E\subseteq\mathbb{R}^n\)为凸集, 称\(f:E\rightarrow\mathbb{R}\)为\(E\)上的\textbf{凸函数}, 
如果对于任何\(\alpha\in(0,1)\)以及\(\boldsymbol{x,y}\in E\), 成立
\[f(\alpha\boldsymbol{x}+(1-\alpha)\boldsymbol{y})\leqslant\alpha f(\boldsymbol{x})+(1-\alpha)f(\boldsymbol{y}).\]
若当\(\boldsymbol{x}\ne\boldsymbol{y}\)时上式中的严格不等式成立, 则称\(f\)为\textbf{严格凸函数}. 
称\(f\)为\textbf{(严格)凹函数}如果\(-f\)是(严格)凸函数.
\end{definition}
\begin{definition}\label{C62}
    设\(E\subseteq\mathbb{R}^n\)为凸集, 称\(f:E\rightarrow\mathbb{R}\)为\(E\)上的\textbf{凸函数}, 
    如果对于任何\(m\geqslant 2\), \(\boldsymbol{x}_1,\boldsymbol{x}_2,\cdots,\boldsymbol{x}_m\in E\)
    以及满足\(\alpha_1+\alpha_2+\cdots+\alpha_m=1\)的\(\alpha_1,\alpha_2,\cdots,\alpha_m\geqslant 0\), 成立
    \[f\left(\sum_{k=1}^{m}\alpha_k\boldsymbol{x}_k\right)
    \leqslant\sum_{k=1}^{m}\alpha_kf(\boldsymbol{x}_k).\]
\end{definition}
\begin{theorem}\label{C63}
设\(f\)为区间\((a,b)\)内的实连续函数. 则有
\begin{enumerate}[label=(\roman*)]
\item \(f\) (严格)凸当且仅当\(f'_+\)在\((a,b)\)内存在且(严格)单增.
\item \(f\)凸当且仅当\(f'_+\)在\((a,b)\)内存在, 且对任何\(x_0\in (a,b)\), 成立
\[f(x)\geqslant f(x_0)+f_+'(x_0)(x-x_0),\quad\forall\, x\in (a,b).\]

而\(f\)严格凸当且仅当\(f'_+\)在\((a,b)\)内存在, 且对任何\(x_0\in (a,b)\)以及\(x\ne x_0\), 上式中严格不等式成立.
\item \(f\)(严格)凸当且仅当\(f'_-\)在\((a,b)\)内存在, 且\(f'_-\)(严格)单增.
\item \(f\)凸当且仅当\(f'_-\)在\((a,b)\)内存在, 且对任何\(x_0\in (a,b)\), 成立
\[f(x)\geqslant f(x_0)+f_-'(x_0)(x-x_0),\quad\forall\, x\in (a,b).\]

而\(f\)严格凸当且仅当\(f'_-\)在\((a,b)\)内存在, 且对任何\(x_0\in (a,b)\)以及\(x\ne x_0\), 上式中严格不等式成立.
\item 若\(f\)可导, 则\(f\)(严格)凸当且仅当\(f'\)(严格)单增.
\item 若\(f\)可导, 则\(f\)凸当且仅当\textbf{曲线在切线之上}, 即对任何\(x_0\in (a,b)\), 成立
\[f(x)\geqslant f(x_0)+f_-'(x_0)(x-x_0),\quad\forall\, x\in (a,b).\]
而\(f\)严格凸当且仅当对任何\(x_0\in (a,b)\)以及\(x\ne x_0\), 上式中严格不等式成立.
\end{enumerate}
\end{theorem}
\begin{theorem}\label{C64}
设\(f\)为区间\((a,b)\)内二阶可导函数, 则\(f\)为凸函数当且仅当\(f''\)非负, 
进一步, 若\(f''\)恒正, 则\(f\)严格凸.
\end{theorem}
\begin{3a}
\begin{enumerate}
\item 设\(E\subseteq\mathbb{R}^n\)为凸集. 证明\(f: E\rightarrow\mathbb{R}\)为凸函数
当且仅当集合\(\{(\boldsymbol{x},y)\big|y\geqslant f(\boldsymbol{x}),\boldsymbol{x}\in E\}\)为凸集.
\begin{proof}

\end{proof}
\item 证明: 凸函数的定义 \ref{C61} 与定义 \ref{C62} 是等价的.
\begin{proof}
content...
\end{proof}
\item 设区间\(I\)上的实函数\(f\)在某一点\(x_0\in I\)的附近有界, 
且\(f\)为\(I\)上的中点凸函数. 尝试按以下步骤证明\(f\)为\(I\)上的凸函数:
\begin{enumerate}[label=(\arabic*)]
\item 证明\(f\)在\(I\)上的任何有界闭子区间上有界.
\item 证明\(f\)在\(I\)的内点连续.
\item 证明\(f\)为\(I\)上的凸函数.
\end{enumerate}
\begin{proof}

\end{proof}
\item 直接利用中值定理, 证明定理\ref{C63}的(v)---(vi)以及定理\ref{C64}.
\item 设\(0<a<b\), \(f\)在\([0,b]\)上连续可导, 在\([0,a]\)上为凹函数, 在\([a,b]\)上为凸函数, \(f'(0)>f'(b)\). 
证明: 存在正整数\(n_0\), 使得对任何\(n\geqslant n_0\), 
以及满足\(a_1+a_2+\cdots+a_n=b\)的非负数列\(a_1,a_2,\cdots,a_n\), 
成立\(f(a_1)+f(a_2)+\cdots+f(a_n)\leqslant nf\left(\frac{b}{n}\right)\).
\item 设\(a,b,c\)为满足\(a+b+c=1\)的非负实数, 求证:
\begin{enumerate}[label=(\arabic*)]
\def\tempf#1{\frac{a}{1+a^#1}+\frac{b}{1+b^#1}+\frac{c}{1+c^#1}}
\def\tempff#1{\frac{1}{1+a^#1}+\frac{1}{1+b^#1}+\frac{1}{1+c^#1}}
\item \(\tempf{3}\leqslant\frac{27}{28}\).
\begin{proof}
设\(f(x)=\frac{x}{1+x^3}\) \((x\in[0,1])\), 由\(f''(x)<0\)可知\(f(x)\)在给定定义域内是凹函数, 
从而\(\frac{1}{3}\left(f(a)+f(b)+f(c)\right)\leqslant f\left(\frac{a+b+c}{3}\right)\), 即为题设不等式.
\end{proof}
\item \(\tempf{2}\leqslant\frac{9}{10}\).
\begin{proof}
设\(f(x)=\frac{x}{1+x^2}\), 同(1)可证. 
\end{proof}
\item \(\tempff{2}\leqslant\frac{27}{10}\).
\begin{proof}
设\(f(x)=\frac{1}{1+x^2}\), 同(2)可证.
\end{proof}
\item \(\frac{1}{\sqrt{1+a^2}}+\frac{1}{\sqrt{1+b^2}}+\frac{1}{\sqrt{1+c^2}}\leqslant\frac{9}{\sqrt{10}}\).
\begin{proof}
设\(f(x)=\frac{1}{\sqrt{1+x^2}}\), 同(3)可证.
\end{proof}
\end{enumerate}
\item 设\(a<b<c<d\), \(f\)在\([a,c]\)和\([b,d]\)上为凸函数, 证明\(f\)在\([a,d]\)上为凸函数.
\begin{proof}
由于去除凸函数在端点处的值不会影响函数的凸性, 我们下证\(f\)在\((a,c)\)和\((b,d)\)上为凸函数, 则\(f\)在\((a,d)\)上也为凸函数.

首先, \(f\)在\((a,c)\)与\((b,d)\)上的凸性蕴含其连续性, 因此\(f\)在\((a,b)\)内连续.

我们只需证明对任何\(\varepsilon\in\left(0,\frac{b-c}{4}\right)\), 
\(f\)在\((a+\varepsilon,d-\varepsilon)\)内为凸函数. 
任取\(\alpha\in\left(0,\frac{\varepsilon}{4}\right)\), 定义
\[f_{\alpha}=\frac{1}{\alpha^2}\int_{x}^{x+\alpha}\dd t\int_{t}^{t+\alpha}f(s)\,\dd s,\quad x\in(a+\varepsilon,d-\varepsilon).\]
则\(f_{\alpha}\)有连续的二阶导数, 且\(\lim_{\alpha\rightarrow 0^+}f_{\alpha}(x)=f(x)\).

进一步, \(f_{\alpha}\)在\((a+\varepsilon,c-\varepsilon)\)和\((b+\varepsilon,d-\varepsilon)\)内分别为凸函数. 
因此, 注意到\(c-\varepsilon>b+\varepsilon\),
\[f''_{\alpha}(x)\geqslant 0,\quad\forall x\in(a+\varepsilon,d-\varepsilon).\]
所以\(f_{\alpha}(x)\)是\((a+\varepsilon,d-\varepsilon)\)内的凸函数. 从而
\[f_{\alpha}(x)\left(sx+(1-s)y\right)\leqslant sf_{\alpha}(x)+(1-s)f_{\alpha}(y),\quad\forall s\in(0,1),\,x,y\in(a+\varepsilon,d-\varepsilon).\]
令\(\alpha\rightarrow 0^+\)即得
\[f(x)\left(sx+(1-s)y\right)\leqslant sf(x)+(1-s)f(y),\quad\forall s\in(0,1),\,x,y\in(a+\varepsilon,d-\varepsilon).\]
所以\(f\)是\((a+\varepsilon,d-\varepsilon)\)内的凸函数, 即是\((a,d)\)上的凸函数, 进一步, \(f\)是\([a,d]\)上的凸函数.
\end{proof}
\item 设\(f\)为区间\(I\)上的凸函数. 若\(x,y,s,t\in I\)满足\(x<s\)且\(y<t\), 
进一步, \(x\leqslant y\)且\(s\leqslant t\), 
证明: \(\frac{f(s)-f(x)}{s-x}\leqslant\frac{f(t)-f(y)}{t-y}\) (如图\ref{fig:c63}).
\begin{figure}
