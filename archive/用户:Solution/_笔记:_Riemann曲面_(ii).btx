\section{紧Riemann面}
	
\subsection{Riemann--Roch定理}
\begin{definition}
	$X$是Riemann面，$X$上一个除子(divisor)指一个映射$D\colon X\rightarrow \mathbb{Z}$
    使得对于任意紧集$K\subset X$，只有有限个$x\in K$使得$D(x)\neq 0$.
			
	记$\Div(X)$为$X$上除子全体，配以加法运算后，其为一个Abel群.
			
	设$D, D'\in \Div(X)$，定义$D\leq D'$等价于$\forall x\in X$, $D(x)\leq D'(x)$.
\end{definition}	
		
\begin{example}
	设$0\neq f\in \mathscr{M}(X)$，对$x\in X$，定义
	$$\ord_xf= \begin{cases} 0, &f(x)\neq 0\text{ 且 } f\in \mathcal{O}_x\\
	k, &x\text{ 为 }f\text{ 的 }k\text{ 阶零点}\\
	-k, &x\text{ 为 }f\text{ 的 }k\text{ 阶极点}
	\end{cases},$$
	则$x\mapsto \ord_xf \in \Div(X)$，记为$(f)$.
\end{example}
		
\begin{example}
	设$0\neq \omega\in \mathscr{M}^1(X)$，对于任意$x\in X$，
    在$x$的某坐标邻域使得$z(x)=0$，$\omega=fdz$，定义$\ord_x\omega:=\ord_0 f$. 
    验证其与局部坐标选取无关.
			
	则$x\mapsto \ord_x \omega\in \Div(X)$，记为$(\omega)$，
    称为典范除子 (canonical divisor).	
		
	设$f,g\in \mathscr{M}(X)\backslash \{0\}$，
    $\omega\in \mathscr{M}^1(X)\backslash \{0\}$，
    则$(f\cdot g)=(f)+(g)$，$(f\cdot \omega)=(f)+(\omega)$，
    $\big(\frac{1}{f}\big)=-(f)$.
\end{example}

\begin{definition}
	称一个除子$D\in \Div(X)$为一个主除子，
    若存在$f\in \mathscr{M}\backslash \{0\}$使得$D=(f)$.

	对于$D, D'\in \Div(X)$，则定义$D\sim D'$当且仅当$D-D'$是主除子.
\end{definition}
		
\begin{example}
	设$\omega_1,\omega_2\in \mathscr{M}^1(X) \backslash\{0\}$，
    则$(\omega_1)\sim (\omega_2)$.
			
	设$\omega \in \mathscr{M}^1(X)$，设$(U,z_U), (V,z_V)$是两个局部坐标. 
    设$\omega=\begin{cases} f_Udz_U,\ \text{on} \ U\\ f_Vdz_V,\ \text{on}\ V \end{cases}$, 
    则$f_U=f_V\cdot \frac{\partial z_V}{\partial z_U}$于$U\cap V$.
			
	设在局部坐标下，$\omega_1=f_1 dz, \omega_2=f_2dz$，
    定义$f:=\frac{\omega_1}{\omega_2}=\frac{f_1}{f_2}\in \mathscr{M}\backslash \{0\}$，
    则$(\omega_1)-(\omega_2)=(f)$，进而$(\omega_1)\sim (\omega_2)$.
\end{example}

\begin{definition} $X$是紧Riemann面，定义映射
	\begin{align*}
		\deg\colon \Div(X) &\rightarrow \mathbb{Z}\\
		D &\mapsto \deg D:=\sum\limits_{x\in X} D(x)
	\end{align*}
称其为$D$的阶.
\end{definition}
		
对于任意$f\in \mathscr{M}(X)\backslash \{0\}$，则$\# f^{-1}(0)= \#f^{-1}(\infty)$，
则$\deg (f)=0$. 故若$D\sim D'$，则$\deg D=\deg D'$.

\begin{definition}
	给定$D\in \Div(X)$，$U\subset X$开集，定义
	$$\mathcal{O}_D(U):=\{f\in \mathscr{M}(U): \ord_xf\geq -D(x), \forall x\in U\}$$
	配以通常的限制映射，其诱导出一个$X$上的层$\mathcal{O}_D$.
\end{definition}

\begin{proposition} $\mathcal{O}_D$的基本性质.

	1. 若$D=0$，则$\mathcal{O}_D=\mathcal{O}$.

	2. 若$D\sim D'$，则$\mathcal{O}_D \cong \mathcal{O}_{D'}$.
\end{proposition}

\begin{proof}
	2. 对于任意$\psi \in \mathscr{M}(X)\backslash \{0\}$使得$D-D'=(\psi)$. 定义同构
	\begin{align*}
	    \mathcal{O}_D(U) &\rightarrow \mathcal{O}_{D'}(U)\\
		f&\mapsto f\cdot \psi
	\end{align*}
	$(f\cdot \psi)=(f)+(\psi)\geq -D+(\psi)=-D'$. 类似定义
	\begin{align*}
		\mathcal{O}_{D'}(U) &\rightarrow \mathcal{O}_{D}(U)\\
		g&\mapsto g/\psi
	\end{align*}
	再验证即可.
\end{proof}
		
\begin{theorem}
	$X$是紧Riemann面，$D\in \Div(X)$使得$\deg D<0$，则$H^0(X, \mathcal{O}_D)=0$.
\end{theorem}
		
\begin{proof}
	假设存在$f\in H^0(X, \mathcal{O}_D)\backslash \{0\}$，使得$f\geq -D$. 
    $0=\deg(f)\geq -\deg D>0$，矛盾.
\end{proof}

\begin{definition}
	固定$p\in X$，对于$U\subset X$开集，定义
	$\mathbb{C}_p(U):=\begin{cases} \mathbb{C}, &p\in U\\ 0, &p\notin U\end{cases}$,
	其诱导出$X$上的一个层$\mathbb{C}_p$，称其为一个摩天大楼层.
\end{definition}
		
\begin{lemma}
	1. $H^0(X, \mathbb{C}_p)\cong \mathbb{C}$.\qquad  
    2. $H^1(X,\mathbb{C}_p)=0$.
\end{lemma}

\begin{proof}
	1. $H^0(X,\mathbb{C}_p)\cong \mathbb{C}_p(X)=\mathbb{C}$.

	2. 设$\zeta=[(f_{ij})\in H^1(X,\mathbb{C}_p)]$，
    其中$(f_{ij})\in Z^1(\mathscr{U},\mathbb{C}_p)$，$\mathscr{U}$是$X$的一个开覆盖. 
    取$\mathscr{U}$的一个加细$\mathscr{V}=\{V_\alpha\}$使得只有一个$V_\alpha \ni p$，
    即$p \notin V_\alpha\cap V_\beta$，$\forall \beta\neq \alpha$. 即得$\zeta=0$.
\end{proof}

\begin{definition}
	设$p \in X$，定义单点除子$P$为在$p$点取值为$1$，在其它点取值为$0$的除子.
\end{definition}

对于任意$D\in \Div(X)$，有$D\leq D+P$，
故存在包含同态$\iota\colon \mathcal{O}_D \rightarrow \mathcal{O}_{D+P}$是一个层同态.

取复坐标$z$使得$z(p)=0$，定义层同态$\beta\colon \mathcal{O}_{D+P}\rightarrow \mathbb{C}_p$如下

设$U\subset X$是开集，若$p\notin U$，则定义$\beta_U:=0$. 
若$p\in U$，则对于任意$f\in \mathcal{O}_{D+P}(U)$，
在$p$的某邻域有Laurent展开$f(z)=\sum\limits_{n=-k-1}^\infty c_n z^n$，
其中$k=D(p)$. 此时，定义$\beta_U(f):=c_{-k-1}\in \mathbb{C}=\mathbb{C}_p(U)$. 则
$$0\rightarrow \mathcal{O}_D \stackrel{\iota}{\longrightarrow} \mathcal{O}_{D+P} 
\stackrel{\beta}{\longrightarrow} \mathbb{C}_p \rightarrow 0$$
正合. 进而有长正合列
$$0\rightarrow H^0(X, \mathcal{O}_D) \rightarrow H^0(X, \mathcal{O}_{D+P}) 
\rightarrow \mathbb{C} \rightarrow H^1(X, \mathcal{O}_D) 
\rightarrow H^1(X, \mathcal{O}_{D+P})\rightarrow 0.$$

\begin{theorem}[Riemann--Roch定理]
	$X$是紧Riemann面，$D\in \Div(X)$，$g$是$X$的亏格，
    则$\dim H^0(X, \mathcal{O}_D)$和$\dim H^1(X, \mathcal{O}_D)$有限，且
	$$\dim H^0(X, \mathcal{O}_D)-\dim H^1(X, \mathcal{O}_D)=1-g+\deg D.$$
\end{theorem}

\begin{proof}
    当$D=0$时，$H^0(X, \mathcal{O})\cong \mathbb{C}$，
    故$\dim H^0(X, \mathcal{O})=1$，而$g=\dim H^1(X, \mathcal{O})$，$\deg D=0$.

	设$D\in \Div(X)$，$p\in X$，令$D'=D+P$. 有长正合列
	$$0\rightarrow H^0(X, \mathcal{O}_D) \rightarrow H^0(X, \mathcal{O}_{D'}) 
    \rightarrow \mathbb{C} \rightarrow H^1(X, \mathcal{O}_D) 
    \rightarrow H^1(X, \mathcal{O}_{D'})\rightarrow 0.$$
	令$V:=\Im (H^0(X, \mathcal{O}_{D'})\rightarrow \mathbb{C})$, $W=\mathbb{C}/V$. 
    则$\dim V+\dim W=1=\deg D'-\deg D$. 于是有两个短正合列
	$$0\rightarrow H^0(X, \mathcal{O}_D) \rightarrow H^0(X, \mathcal{O}_{D'}) \rightarrow V \rightarrow 0,$$
	$$0\rightarrow W \rightarrow H^1(X, \mathcal{O}_D) 
    \rightarrow H^1(X, \mathcal{O}_{D'})\rightarrow 0.$$
    于是，
	$$\dim H^0(X, \mathcal{O}_{D'})=\dim H^0(X, \mathcal{O}_D)+\dim V,$$
	$$\dim H^1(X, \mathcal{O}_D)=\dim H^1(X, \mathcal{O}_{D'})+\dim W.$$

	由于任何除子$D=P_1+\cdots+P_m-Q_1-\cdots -Q_n$，
    且$\dim H^0(X, \mathcal{O}), \dim H^1(X,\mathcal{O})$有限，
    所以$\dim H^0(X, \mathcal{O}_D), \dim H^1(X, \mathcal{O}_D)$有限. 有
	$$\dim H^0(X,\mathcal{O}_{D'})+\dim H^1(X, \mathcal{O}_D)
    = \dim H^0(X, \mathcal{O}_D)+\dim H^1(X, \mathcal{O}_{D'})+\deg D' -\deg D,$$
	则	
	$$\dim H^0(X, \mathcal{O}_{D'})-\dim H^1(X, \mathcal{O}_{D'})-\deg D'
    =\dim H^0(X, \mathcal{O}_{D})-\dim H^1(X, \mathcal{O}_{D})-\deg D,$$
	于是若Riemann--Roch定理对$D, D'$中一个成立，则对另一个也成立.

	由于任何一个$D\in \Div(X)$可写为$P_1+\cdots +P_m-Q_1-\cdots-Q_n$，
    故再由数学归纳法即得.
\end{proof}

\begin{theorem}
	设$X$是亏格为$g$的紧Riemann面，设$a\in X$，则存在$f\in \mathscr{M}(X)$
    使得$f\in \mathcal{O}(X\backslash \{a\})$且$a$为$f$的极点且其阶不超过$g+1$.
\end{theorem}

\begin{proof}
	取$D\in \Div(X)$如下，$D(x)=\begin{cases} g+1, &x=a\\ 0, &x\neq a\end{cases}$. 
    由Riemann--Roch定理，
	$$\dim H^0(X, \mathcal{O}_D)\geq 1-g +\deg D=1-g+g+1=2.$$
	故存在非常值函数$f\in H^0(X, \mathcal{O}_D)$其满足要求.
\end{proof}

\begin{corollary}
	$X$是紧Riemann面，$g$是亏格，
    则存在分歧全纯覆盖$f\colon X\rightarrow \mathbb{P}^1$，其叶数不超过$g+1$.
\end{corollary}

\begin{proof}
	取$f$如上一个定理，其定义了全纯映射$X\rightarrow \mathbb{P}^1$，
    其在$\infty$的重数不超过$g+1$.
\end{proof}

\begin{corollary}
	亏格为$0$的紧Riemann面$\cong \mathbb{P}^1$.（双全纯等价）
\end{corollary}

\begin{proof}
	由上一个推论知叶数为$1$，而叶数为$1$的覆盖映射必双全纯.
\end{proof}


\subsection{Serre对偶定理}
此节假设$X$是紧Riemann面.

\begin{definition}
	若$D\in \Div(X)$，对$U\subset X$开集，定义
	$$\Omega_D(U)=\{\omega\in \mathscr{M}^1(U): (\omega)\geq -D \ \text{于}\ U\},$$
    诱导出层$\Omega_D$.
\end{definition}

\begin{theorem}[Serre对偶定理]
	$$H^1(X, \mathcal{O}_D)\cong H^0(X, \Omega_{-D})^*$$
	$$H^1(X, \Omega_D)\cong H^0(X, \mathcal{O}_{-D})^*$$
\end{theorem}

\begin{remark}
	1. 当$D=0$时，$\dim H^0(X, \Omega)=\dim H^1(X, \mathcal{O})=g$.
    
    2. 设$K$是典范除子，$\Omega_{-K}\cong \mathcal{O}$，$\Omega\cong \mathcal{O}_K$.
\end{remark}

\begin{proof}
	设$K=(\omega)$，对$\omega_1\in \Omega_{-K}(U)$，
    则$(\omega_1)\geq K=(\omega)$，则$f=\omega_1/\omega \in \mathcal{O}(U)$，
    这定义了一个从$\Omega_{-K}(U)$到$\mathcal{O}(U)$的同构.
\end{proof}

\begin{remark}
	R. Narasimhan, \textit{Compact Riemann Surfaces}.
\end{remark}

\begin{theorem}
	设$\omega\in \mathscr{M}^1(X)\backslash \{0\}$，则$\deg (\omega)=2g-2$. 
    特别地，若$\omega\in \Omega(X)\backslash \{0\}$，则其零点个数为$2g-2$.
\end{theorem}

\begin{proof}
	设$K=(\omega)$，由Riemann--Roch定理，
    $\dim H^0(X,\mathcal{O}_K)-\dim H^1(X, \mathcal{O}_K)=1-g+\deg K$，而
	$$\text{LHS}=\dim H^1(X, \Omega_{-K})-\dim H^0(X, \Omega_{-K})
    =\dim H^1(X, \mathcal{O})-\dim H^0(X, \mathcal{O})=g-1,$$
	故$\deg K=2g-2$.
\end{proof}

\begin{corollary}
	环面$\mathbb{C}/\Gamma$的亏格为$1$.
\end{corollary}

\begin{proof}
	$dz$关于$\Gamma$不变，其诱导出$\mathbb{C}/\Gamma$上的一个全纯$1$-形式$\omega$，
    其无零点，进而$0=\deg \omega=2g-2$推出$g=1$.
\end{proof}

\begin{theorem}
	若$g\geq 1$，则对于任意$p\in X$，存在$\omega\in \Omega(X)$使得$\omega|_p\neq 0$.
\end{theorem}

\begin{proof}
	因为$X$不同构于$\mathbb{P}^1$，所以$\dim H^0(X, \mathcal{O}_P)=1$
    （否则存在非常值$f\in H^0(X, \mathcal{O}_P)$且$(f)\geq -P$
    推出$X\cong \mathbb{P}^1$，矛盾.）

	由Serre对偶，$\dim H^1(X, \Omega_{-P})=\dim H^0(X, \mathcal{O}_P)=1$，
    由Serre对偶与Riemann--Roch定理，
	$$\dim H^0(X, \Omega_{-P})=\dim H^1(X, \mathcal{O}_{P})=\dim H^0(X, \mathcal{O}_{P})-1+g-\deg P=g-1=\dim H^0(X,\Omega)-1,$$
	推出存在$\omega\in H^0(X, \Omega)\backslash H^0(X, \Omega_{-P})$，
    则$\omega|_p\neq 0$.
\end{proof}	

\begin{theorem}
	$D\in \Div(X)$，$\deg D>2g-2$，则$H^1(X, \mathcal{O}_D)=0$.
\end{theorem}

\begin{proof}
	取$K$为典范除子，
	\begin{align*}
	\dim H^1(X, \mathcal{O}_D)&=\dim H^0(X, \Omega_{-D}) (\text{Serre})\\
	&=\dim H^0(X, \mathcal{O}_{K-D})\\
	&=0
	\end{align*}
	因为$\deg(K-D)=2g-2-\deg D<0$.
\end{proof}

\begin{remark}
	多元的情形即为Kodaira消灭定理.
\end{remark}

\begin{corollary}
	$H^1(X, \mathscr{M})=0$.
\end{corollary}

\begin{proof}
	设$\xi=[(f_{ij})]\in H^1(X, \mathscr{M})$，
    其中$(f_{ij})\in Z^1(\mathscr{U}, \mathscr{M})$，$\mathscr{U}$是$X$的开覆盖.

	取$\mathscr{V}=\{V_i\}\ll\mathscr{U}=\{U_i\}, i=1,2,\cdots,n$. 
    因为$\overline{V_i}\cap \overline{V_j}\subset U_i\cap U_j$，
    所以存在$D\in \Div(X)$使得$\deg D>2g-2$
    且$(f_{ij})\geq -D$于$\overline{V_i}\cap \overline{V_j}$. 
    推出$(f_{ij}|_{V_i\cap V_j})\in Z^1(\mathscr{V}, \mathcal{O}_D)$.\par
	因为$H^1(\mathscr{V}, \mathcal{O}_D)=0$，所以$f_{ij}=f_i-f_j$于$V_i\cap V_j$，
    其中$f_i\in C^0(V_i,\mathcal{O}_D)\subset C^0(V_i, \mathscr{M})$，故$\xi=0$.
\end{proof}

\begin{definition}
	设$D\in \Div(X)$，称$\mathcal{O}_D$为整体生成的，
    若$\forall x\in X$，存在$f\in H^0(X,\mathcal{O}_D)$使得$\ord_x f=-D(x)$.
\end{definition}

\begin{theorem}
	若$\deg D\geq 2g$则$\mathcal{O}_D$是整体生成的.
\end{theorem}

\begin{proof}
	令$D'(y):=\begin{cases} D(y), &y\neq x\\ D(x)-1, &y=x\end{cases}$. 
    则$D'\in \Div(X)$使得
    \[\deg D'=\deg D-1\geq2g-1> 2g-2.\]
    推出$H^1(X,\mathcal{O}_D)=H^1(X, \mathcal{O}_{D'})=0$.

	由Riemann--Roch定理，$\dim H^0(X, \mathcal{O}_D)> \dim H^0(X, \mathcal{O}_{D'})$.

	因为$H^0(X, \mathcal{O}_{D'})\subset H^0(X, \mathcal{O}_D)$（$(f)\geq -D'\geq -D$），
    所以只需取$f\in H^0(X, \mathcal{O}_D)\backslash H^0(X, \mathcal{O}_{D'})$.
\end{proof}

\begin{definition}
    $N$维复射影空间$\mathbb{P}^N$.

	令$\mathbb{P}^N:=\mathbb{C}^{N+1}/\sim$，
    其中$(z_0,\cdots,z_N)\sim (z_0',\cdots,z_N')$等价于
    存在$\lambda\in \mathbb{C}^*$使得$z_j'=\lambda\cdot z_j, 0\leq j\leq N$.

	设$[z_0;z_1;\cdots;z_N]$为由$(z_0,\cdots,z_N)$所代表的等价类. 
    令$U_j:=\{[z_0;\cdots;z_N]: z_j\neq 0\}$，则$\{U_j\}_{j=0}^N$是一个开覆盖. 
    考虑同胚$\varphi_j\colon U_j\rightarrow \mathbb{C}^n$，
    $[z_0;\cdots;z_N]\mapsto \big(\frac{z_0}{z_j},\cdots,\frac{z_{j-1}}{z_j} ,
    \frac{z_{j+1}}{z_j},\cdots,\frac{z_N}{z_{j}}\big)$为一个复坐标.
\end{definition}

\begin{definition}
	$X$是紧Riemann面，$F\in C(X,\mathbb{P}^N)$，
    则$\{W_j:=F^{-1}(U_j)\}$构成$X$的开覆盖. 
    令$F_j:=\varphi_j \circ F\colon W_j\rightarrow \mathbb{C}^N$，
    记$F_j=(F_{j1},\cdots,F_{jN})$，若$F_{j\nu}$皆全纯，则称$F_j$为全纯映射. 
    如果$\forall x\in X$，存在$W_j \ni x$，且存在$\nu$使得$dF_{j\nu}|_x\neq 0$，
    则称$F$是全纯浸入. 称$F$为全纯嵌入，若$F$是全纯浸入且$F$是单射.
\end{definition}

设$f_0,\cdots,f_N\in \mathscr{M}\backslash \{0\}$，
则构造全纯映射$F:=[f_0:f_1:\cdots:f_N]\colon X\rightarrow \mathbb{P}^N$如下：

对于任意$x\in X$，取坐标$z$使得$z(x)=0$. 
令$k=\min\limits_{0\leq j\leq N} \ord_x f_j$. 
则$f_j=z^k\cdot g_j, g_j\in \mathcal{O}_x$，且至少有一个$g_j(x) \neq 0$. 
则令$F(x):=[g_0(x):g_1(x):\cdots:g_N(x)]$. 而
$$F_j=\left(\frac{g_0}{g_j},\cdots,\frac{g_{j-1}}{g_j},\frac{g_{j+1}}{g_j},
\cdots, \frac{g_N}{g_j}\right)\in \mathcal{O}_x^{\oplus N}.$$
			
\begin{theorem}
	设$D\in \Div(X)$使得$\deg D\geq 2g+1$，
    设$f_0,\cdots,f_N\in H^0(X, \mathcal{O}_D)$的一组基，则
	$$F=[f_0:f_1:\cdots:f_N]\colon X\hookrightarrow \mathbb{P}^N$$
    为一个全纯嵌入.
\end{theorem}

\begin{remark}[多复变]
	若$X$是非紧的Riemann面，则$X$可以作为闭一维复子流形全纯嵌入到$\mathbb{C}^3$中.
\end{remark}

\begin{proof}
    我们只需证明$F$是单浸入.
	\begin{enumerate} 
		\item[1.] $F$是单射.

		\qquad 任取$X$上不同的两点$x_1,x_2$. 作$D' \in \Div(X)$如下：
        $D'(x)=\begin{cases} D(x), &x\neq x_2\\ D(x_2)-1, &x=x_2\end{cases}$. 
        因为$\deg D'=\deg D-1\geq 2g$，所以$\mathcal{O}_{D'}$是整体生成的. 
        于是存在$f\in H^0(X,\mathcal{O}_{D'})$使得
		$$\ord_{x_1} f=-D'(x_1)=-D(x_1).$$
		显然
		$$\ord_{x_2} f\geq -D'(x_2)=-D(x_2)+1.$$
		因为$H^0(X,\mathcal{O}_{D'})\subset H^0(X,\mathcal{O}_D)$，
        所以$f=\sum\limits_{j=0}^N \lambda_jf_j, \lambda_j\in \mathbb{C}$.

		\qquad 取$x_1, x_2$处的坐标$(V_1,z_1), (V_2,z_2)$使得$z_1(x_1)=z_2(x_2)=0$. 
        因为$\mathcal{O}_D$是整体生成的，$k_\mu:=\min\limits_j \ord_{x_\mu} f_j=-D(x_\mu), \mu=1,2$.

		\qquad 在$x_\mu$附近，$f_j=z_\mu^{k_\mu}\cdot g_{\mu j}$，
        $f=z_\mu^{k_\mu} \cdot g$, 其中$g_{\mu j}, g \in \mathcal{O}_{x_\mu}, \mu=1,2$. 
        推出$F(x_\mu)=[g_{\mu 0}:g_{\mu 1}:\cdots: g_{\mu N}]$
        且$\sum\limits_{j=0}^N \lambda_j g_{\mu j} (x_\mu)=g(x_\mu), \mu=1,2$.

		\qquad 由$\ord_{x_1} f=-D'(x_1)=-D(x_1)$推出$g(x_1)\neq 0$，由
        \[\ord_{x_2} f\geq -D'(x_2)=-D(x_2)+1\]
        推出$g(x_2)=0$. 则$F(x_1)\neq F(x_2)$. 
        若否，则存在$\lambda\in \mathbb{C}$使得$g_{1 j}(x_1)=\lambda \cdot g_{2 j}(x_2) $. 则	
		$$0\neq g(x_1)=\sum\limits_{j=0}^N \lambda_j g_{1 j}(x_1)
        =\lambda \cdot \sum\limits_{j=0}^N \lambda_j g_{2 j}(x_2)
        =\lambda \cdot g(x_2)=0,$$
		得到矛盾.
		
        \item[2.] $F$是浸入.

		\qquad 设$x_0\in X$，取$D'\in \Div(X)$如下：
        $D'(x)=\begin{cases} D(x), &x\neq x_0\\ D(x_0)-1, &x=x_0\end{cases}$. 
        取$f\in H^0(X,\mathcal{O}_{D'})\subset H^0(X,\mathcal{O}_D)$使得
		$$\ord_{x_0}f=-D'(x_0)=-D(x)+1.$$
		\qquad 设$f=\sum\limits_{j=0}^N \lambda_j f_j$. 
        取$k=\min\limits_j \ord_{x_0}f_j=-D(x_0)$使得取$x_0$处复坐标$z$
        使得$f_j=z^k\cdot g_j, f=z^k \cdot g$, 其中$g_i,g\in \mathcal{O}_{x_0}$. 
        不妨设$g_0(x_0)\neq 0$. 则$F_0:=\varphi_0\circ F\colon W_0=F^{-1}(U_0)\rightarrow \mathbb{C}^N$,
		$$F_0=(F_{01},\cdots,F_{0N})=\left(\frac{g_1}{g_0},\cdots,\frac{g_N}{g_0}\right).$$

		$$\sum_{j=1}^N \lambda_j F_{0j}
        =\sum_{j=1}^N \frac{\lambda_jg_j}{g_0}=\frac{g}{g_0}-\lambda_0$$
		推出
		$$\sum_{j=1}^N \lambda_jdF_{0j}(x_0)=d\left(\frac{g}{g_0}\right)(x_0).$$
		因为$g(x_0)\neq 0$, 且$\ord_{x_0}f=-D'(x_0)=-D(x)+1$推出$\ord_{x_0}g=1$. 
        所以 $g(x_0)=0,dg(x_0)\neq 0$. 于是
		$$d\left(\frac{g}{g_0}\right)(x_0)=\frac{dg(x_0)}{g_0(x_0)}
        -\frac{g(x_0)\cdot dg_0(x_0)}{g_0(x_0)^2}=\frac{d g(x_0)}{g_0(x_0)}\neq 0,$$
		故存在某个$j$使得$dF_{0j}(x_0)\neq 0$，故$F$是浸入.\qedhere
	\end{enumerate}
\end{proof}

\begin{remark}
	$N+1=\dim H^0(X,\mathcal{O}_D)= 1-g+\deg D\geq g+2$，
    因此$X\hookrightarrow \mathbb{P}^{g+1}$，其中$g$是$X$的亏格. 
    特别地，$\mathbb{C}/\Gamma \hookrightarrow \mathbb{P}^2$.
	一般地，任意紧Riemann面$X\hookrightarrow \mathbb{P}^3$.
\end{remark}
	
\begin{remark}
	若$X$是非紧Riemann面，则存在逆紧全纯嵌入$X\hookrightarrow \mathbb{C}^3$
    (Bishop-Narasimhan-Remmert). 

	Conjecture: 存在逆紧全纯嵌入$X\hookrightarrow \mathbb{C}^2$.
\end{remark}

\begin{remark}
    在$\mathbb{P}^N$上有一个特殊的度量 Fubini-Study 度量$\omega_{FS}$. 映射$F:X\to\mathbb{P}^N$ 诱导了
    $$F^*(\omega_{FS}) = \frac{i}{2\pi} \partial \bar{\partial} \log \sum_{j=0}^N |s_j(x)|^2 = \omega_B.$$
    其中$\omega_B$ 是$X$上的Bergman度量.
\end{remark}

\begin{definition}
	$X, Y$是紧Riemann面，非常值映射$F\in \mathcal{O}(X,Y)$. 
    令$f$在$x$处的重数$\nu(f,x):=\# (f^{-1}(y)\cap U)$，
    这里$U\ni x$是充分小的邻域，$y\neq f(x)$但充分接近于$f(x)$.

	称$b(f,x)=\nu(f,x)-1$为$f$在$x$处的分歧阶(分歧：branch). 
    令$b:=\sum\limits_{x\in X}b(f,x)$.\par
	称$n:=\sum\limits_{x\in f^{-1}(y)} \nu(f,x)$为$f$的叶数. 
    $g$和$g'$分别是$X$和$Y$的亏格.
\end{definition}

\begin{theorem}[Riemann--Hurwitz定理]
	$$g=\frac{b}{2}+n(g'-1)+1.$$
\end{theorem}

\begin{remark}
    推出$b$是偶数.
\end{remark}

\begin{proof}
	设$\omega\in \mathscr{M}^1(Y)\backslash \{0\}$，
    由Riemann--Roch定理，$\deg \omega=2g'-2$. 
    而$f^*\omega\in \mathscr{M}^1(X)\backslash \{0\}$，
    再由Riemann--Roch定理，$\deg f^*\omega=2g-2$.

	设$x\in X$，$y=f(x)\in Y$. 取$x, y$处的坐标$z, w$
    使得$z(x)=w(y)=0$，且$f$可表示为$w=z^k$，$k=\nu(f,x)$.
	设$\omega=\psi(w)dw$，则$f^*\omega=\psi(z^k)dz^k=kz^{k-1}\psi(z^k)dz$. 于是有
	$$\ord_x f^*\omega=b(f,x)+\nu(f,x)\cdot \ord_y \omega.$$
	推出
	$$\sum_{x\in f^{-1}(y)}\ord_x f^*\omega
    =\sum_{x\in f^{-1}(y)} b(f,x)+n\cdot \ord_y\omega.$$
	故	
	\begin{align*}
		\deg f^*\omega&=\sum_{x\in X}\ord_x f^*\omega\\
		&=\sum\limits_{y\in Y} \sum_{x\in f^{-1}(y)} \ord_x f^*\omega\\
		&=\sum\limits_{y\in Y}\sum_{x\in f^{-1}(y)} b(f,x)+n\sum_{y\in Y}\ord_y \omega\\
		&=b+n\cdot \deg \omega.
	\end{align*}
\end{proof}

\begin{example}
	当$Y=\mathbb{P}^1$时，则$g=\frac{b}{2}-n+1$.

	特别地，当$n=2$时，$g=\frac{b}{2}-1$，此时称$X$为超椭圆的.
\end{example}


\subsection{除子与线丛，Serre定理证明}	
	
\begin{definition}
	$X$是Riemann面，$X$上一个全纯线丛指
    $L=\bigsqcup\limits_{i\in I} U_i\times \mathbb{C}/\sim$，
    其中$\scrU=\{U_i\}_{i\in I}$为$X$的一个开覆盖，
    $(x,v)\in U_i\times \mathbb{C}\sim (y,w)\in U_j\times \mathbb{C}$
    等价于$x=y$且$v=g_{ij}(x)\cdot w$，
    其中$g_{ij}\in \mathcal{O}^*(U_i\cap U_j)$
    满足$g_{ij}\cdot g_{jk}=g_{ik}$于$U_i\cap U_j \cap U_k$. 
    称$\{g_{ij}\}$为$L$的转换函数.
\end{definition}

\begin{definition}
	设$U\subset X$为开集，$L$在$U$上的一个全纯截影指一族$(f_i)_{i\in I}$，
    其中$f_i\in \mathcal{O}(U\cap U_i)$
    使得$f_i=g_{ij}\cdot f_j$于$U\cap U_i \cap U_j$. 
    记$\Gamma(U,L)=\{L$在$U\text{ 上的全纯截影}\}$. 其诱导出一个层，记为$\mathcal{O}_L$.
\end{definition}
	
\begin{definition}
	$L$在$X$上的一个亚纯截影指一个$f\in \Gamma(X',L)$，其中$X'\subset X$开，满足

	1. $X\backslash X'$离散.

	2. $\forall a\in X\backslash X'$，存在$a$处坐标$(U,z)$
    使得$z(a)=0$且存在$n\in \mathbb{Z}^+$使得$z^n\cdot f\in \Gamma(U,L)$.
\end{definition}

\begin{example}
	1. 平凡线丛$L=X\times \mathbb{C}$. 
    此时$g_{ij}=1$，$\mathcal{O}=\mathcal{O}_L$.

	2. 设$\{(U_i,z_i)\}_{i\in I}$为$X$的一个坐标邻域覆盖. 
    定义$g_{ij}:=\frac{dz_j}{dz_i}$，
    称以$\{g_{ij}\}$为转换函数诱导的全纯线丛为$X$上的典范线丛$K_X$
    （即为$X$上的全纯余切丛）.

	3. $L, L'$为$X$上全纯线丛，转换函数$\{g_{ij}\}, \{g_{kl}'\}$，
    取一个公共加细覆盖后，不妨设转换函数为$\{g_{ij}\}$与$\{g_{ij}'\}$，
    称以$\{g_{ij}\cdot g_{ij}'\}$为转移函数诱导出的全纯线丛为$L$与$L'$的张量积，
    记为$L\otimes L'$.

	记$L^{\otimes m}=L\otimes L\otimes \cdots \otimes L$共$m$个作张量积. 
    称$K^{\otimes m}$为pluri-canonical line bundle，$
    P_m:=\Gamma(X, K^{\otimes m})$为pluri-genera.

	4. 设$L$的转换函数为$\{g_{ij}\}$，
    以$\{g_{ij}^{-1}\}$为转移函数诱导出的全纯线丛为$L$的对偶线丛.

	5. 设$D\in \Div(X)$，取$X$的开覆盖$\mathscr{U}=\{U_i\}_{i\in I}$，
    以及$\psi_i\in \mathscr{M}(U_i)$, $i\in I$使得$(\psi_i)=D$于$U_i$. 
    则$g_{ij}:=\psi_i/\psi_j \in \mathcal{O}^*(U_i\cap U_j)$. 
    记$L_D$为以$\{g_{ij}\}$为转换函数的全纯线丛. 易见$L_K\cong K_X$，其中$K$是典范除子.
\end{example}
			
\begin{lemma}
	$$\mathcal{O}_D\cong \mathcal{O}_{L_D}.$$
\end{lemma}
	
\begin{proof}
	设$U\subset X$为一个开集，$f \in \mathcal{O}_D(U)$则$(f)\geq -D$于$U$. 
    故$f_i:=f\cdot \psi_i\in \mathcal{O}(U\cap U_i)$. 
    ($(f_i)=(f)+(\psi_i)\geq -D+(\psi_i)=0$.)

	在$U\cap U_i \cap U_j$上，$\frac{f_i}{\psi_i}=f=\frac{f_j}{\psi_j}$
    推出$f_i=g_{ij}f_j$，推出$(f_i)\in \Gamma(U, L_D)$.

	反过来，设$(f_i)_i\in \Gamma(U,L_D)$，在$U\cap U_i\cap U_j$上，$f_i=g_{ij}f_j$，
    则$\frac{f_i}{\psi_i}=\frac{f_j}{\psi_j}$，
    推出$f|_{U\cap U_i}:=\frac{f_i}{\psi_i}\in \mathscr{M}(U)$，
    且使得$(f)=(f_i)-(\psi_i)\geq -(\psi_i)=-D$，$\forall U\cap U_i$，
    则$f\in \mathcal{O}_D(U)$.
\end{proof}

\begin{definition}
    设$L$是$X$上的全纯线丛，记$\pi\colon L\rightarrow X$，$[(x,v)]\mapsto x$为自然投影. 
    商映射$\bigsqcup\limits_{i\in I} U_i\times \mathbb{C}\rightarrow L$
    诱导出同胚$\Phi_i\colon\pi^{-1}(U_i)\rightarrow U_i\times \mathbb{C}$使得下图交换
	\[\begin{cd}
		&\pi^{-1}(U_i) \ar[d,"\pi"] \ar[r,"\Phi_i"] &U_i \times \mathbb{C} \ar[dl]\\
		&U_i &
	\end{cd}\]
	称$\Phi_i$为$L$在$U_i$上的平凡化. 
    $\Phi_i\circ \Phi_j^{-1}(x,v)=(x,g_{ij}(x)v)$是全纯的. 说明$L$为一个二维复流形.

	称$\xi_i:=\Phi_i^{-1}(x,1)$为$L$在$U_i$上的一个局部标架. 
    则有$\xi_j=g_{ij}\xi_i$.\par
			
	设$f=(f_i)\in \Gamma(U,L)$, $U\subset X$开，
    则$\tilde{f}|_{U\cap U_i}:=f_i \otimes \xi_i$可以粘成 $\mathcal{O}(U,L)$中的一个元素. 
    我们将$f$与$\tilde{f}$恒同起来（解释了为什么叫全纯截影）.
\end{definition}

\begin{definition}
	$L$上的一个Hermite度量$h$指一族函数$\{h_i\}$，
    其中$0<h_i\in \mathcal{E}(U_i)$使得$h_i=h_j/|g_{ij}|^2$于$U_i\cap U_j$.

	设$f\in \Gamma(U,L)$，$f=(f_i)$，其中$f_i\in \mathcal{O}(U\cap U_i)$.
    我们有$|f_i|^2 h_i=|f_j|^2 h_j$于$U\cap U_i\cap U_j$. 
    故可定义$|f|^2_h|_{U_i}:=|f_i|^2 \cdot h_i \in \mathcal{E}(U)$，
    称其为$f$关于$h$的点态长度的平方.
\end{definition}

\begin{definition}
	因为$d'd''(-\log h_i)=d'd''(-\log h_j)$于$U_i\cap U_j$，
    故定义$\Theta_h|_{U_i}:=id'd''(-\log h_i)\in \mathcal{E}^{(1,1)}(X)$称为$h$的曲率.
\end{definition}
	
\begin{definition}
	称$C(L):=\frac{1}{2\pi}\int_X \Theta_h$为$L$的Euler示性数或第一陈类.
\end{definition}
				
\begin{theorem}[Gauss--Bonnet]
	$X$是紧Riemann面，$D\in \Div(X)$，则$C(L_D)=\deg D$.
\end{theorem}

\begin{proof}
	取$X$的（有限）坐标邻域覆盖$\mathscr{U}=\{(U_i,z_i)\}$
    以及$\psi_i\in \mathscr{M}(U_i)$使得$(\psi_i)=D$于$U_i$. 
    于是有$f=(\psi_i)_i\in \mathscr{M}(X,L_D)$.

	设$D=\sum\limits_{k=1}^n n_k \cdot P_k$，$n_k\in \mathbb{Z}$, $P_k\in X$. 
    令$X'=X\backslash \{P_1,\cdots,P_n\}$，则$f\in \Gamma(X',L_D)$且无零点. 
    则$\Theta_h=id'd''(-\log |f|_h^2)$于$X'$. 所以
	$$C(L_D)=\frac{1}{2\pi}\int_{X'} \Theta_h
    =\frac{1}{2\pi}\int_{X'} id'd''(-\log \vert f\vert_h^2).$$
	设$z_k$为$P_k$处坐标使得$z_k(P_k)=0$. 则$\xi_k$为$L$在$P_k$附近的一个局部标架.

	设$f=z_k^{n_k}\cdot g_k \otimes \xi_k$于$P_k$附近，
    $g_k\in \mathcal{O}_{P_k}^*$，推出
	\begin{align*}
		C(L_D)
        &=\lim_{\delta\to 0} \frac{1}{2\pi} 
        \int_{X\backslash \bigcup_{k=1}^n \{\vert z_k\vert <\delta\} } 
        idd'\log \vert f\vert_h^2\\
		&=\lim_{\delta\to 0} \frac{1}{2\pi i} 
        \sum_{k=1}^n \int_{\vert z_k\vert=\delta} 
        d'\log  \vert f\vert_h^2\\
		&=\lim_{\delta \to 0} \sum_{k=1}^n 
        \frac{1}{2\pi i} \int_{\vert z_k\vert =\delta} 
        (n_k \frac{dz_k}{z_k} +d'\log \vert g_k\otimes \xi_k \vert_h^2)\\
		&=\sum_{k=1}^n n_k =\deg D.
	\end{align*}
\end{proof}
	
\begin{remark}
	设$g=\lambda^2 dz\otimes d\bar{z}$为$X$上一个Riemann度量，
    其可以看作$X$的全纯切丛$K^*$上的一个Hermite度量. 
    记$\omega_g:=\frac{i}{2}\lambda^2 dz\wedge d\bar{z}$为$g$的Kähler形式. 
    称$$K_g:=-\frac{2}{\lambda^2} \frac{\partial \log \lambda^2}{\partial z\partial \bar{z}}$$
    为$g$的Gauss曲率. 
    则$\Theta_g=K_g\cdot \omega_g$. 则由上条定理推出
	$$\frac{1}{2\pi} \int_X K_g\cdot \omega_g=-\deg K=2-2g=\chi(X).$$
	其中$K$是canonical divisor，$g$是$X$的“柄”的个数，$\chi(X)$是$X$的Euler示性数. 
\end{remark}

\begin{definition}
	$X$是Riemann面，$L$是$X$上的全纯线丛，$U\subset X$开，
    与全纯截影类似可定义$C^\infty$截影，令
	$$\calE_L(U):=\{L\text{ 在 } U\text{ 上的 } C^\infty \text{ 截影}\},$$
	$$\calE_L^{(0,1)}(U):=\calE^{(0,1)}(U)\otimes \calE_L(U).$$
	$\{\calE_L(U)\}, \{\calE_L^{(0,1)}(U)\}$诱导出层$\calE_L$和$\calE_L^{(0,1)}$.
\end{definition}

\begin{definition}
	引入层同态$d''\colon\calE_L\rightarrow \calE_L^{(0,1)}$，
    设$U\subset X$开，$\scrU=\{U_i\}$为$X$的开覆盖使得$L_{U_i}$平凡.

	设$S\in \calE_L(U)$，则$S=f_i\otimes \xi_i$于$U\cap U_i$，
    $f_i\in \calE(U_i\cap U)$. 定义$d''S|_{U\cap U_i}:=d''f_i\otimes \xi_i$. 
    则$d''S\in \calE_{L}^{(0,1)}(U)$: 
    $f_i\otimes \xi_i=f_j\otimes \xi_j$于$U\cap U_i\cap U_j$, 
    $f_i=g_{ij}f_j$，$\xi_i=g_{ij}^{-1}\xi_j$. 
	\begin{align*}
		d''f_i\otimes \xi_i&=d''(g_{ij}f_j)\otimes (g_{ij}^{-1}\xi_j)\\
		&=g_{ij}d''f_j\otimes (g_{ij}^{-1}\xi_j)\\
		&=d''f_j\otimes \xi_j.
	\end{align*}
\end{definition}

\begin{remark}
	无法如上定义$d'\colon\calE_L\rightarrow \calE_L^{(1,0)}$.
\end{remark}

令$H^0(X,L):=H^0(X,\calO_L)$, $H^1(X,L):=H^1(X,\calO_L)$. 则有

\begin{theorem}[Dolbeault定理]
	$H^1(X,L)\cong \calE_L^{(0,1)}(X)/d''\calE_L(X)$.
\end{theorem}
\begin{proof}
    我们有断言有如下正合列：
    $$ 0 \to \mathcal{O}_L \rightarrow \mathcal{E}_L \xrightarrow{d''} \mathcal{E}_L^{(0,1)} \to 0 $$
    已证$L$平凡的情况，而由于$L$局部平凡，由于层正合列是局部验证的，该断言亦可类似证得. 之后取上同调诱导的正合列，由于单位分解依旧存在，易证$H^1(X,\mathcal{E}_L)=0$，于是定理得证.
\end{proof}

\begin{definition}
	设$L$是$X$上的全纯线丛，$L^*$是$L$的对偶丛，$K$是$X$上的典范线丛，
    定义双线性形式$\langle-,-\rangle\colon 
    H^0(X,K\otimes L^*)\times \calE_L^{(0,1)}(X)\rightarrow \bbC$如下

	设$\xi$为$L$的一个局部标架，则$\xi^*:=\xi^{-1}$为$L^*$的一个局部标架，
    则对于任意$S\in H^0(X,K\otimes L^*)$
    以及对于任意$\varphi\in \calE_L^{(0,1)}(X)$，可局部表示为
	\begin{align*}
        S&=fdz\otimes \xi^*, \quad f\in \calO(U)\\
        \varphi&=gd\bar{z}\otimes \xi, \quad\ \ g\in \calE(U)
    \end{align*}
	定义$(S,\varphi)|_U:=f\cdot gdz\wedge d\bar{z}$，
    其不依赖于$U$以及标架的选取，故$(S,\varphi)\in \calE^{(1,1)}(X)$，
    则定义$\langle S,\varphi\rangle:=\int_X (S,\varphi)$.
\end{definition}

\begin{theorem}[表示定理]
	$X$是紧Riemann面，$L$是$X$上的全纯线丛，
    $F\colon\calE_L^{(0,1)}\rightarrow \bbC$是一个连续线性泛函，
    使得$F|_{d''\calE_L(X)}=0$可推出存在唯一的$S\in H^0(X,K\otimes L^*)$
    使得$F(\varphi)=\langle S,\varphi\rangle, \forall \varphi\in \calE_L^{(0,1)}(X)$.
\end{theorem}

\begin{proof}
	我们先给出两个断言. 
    \begin{enumerate}
        \item[(i)] 设$U\subset X$开，$\sigma\in H^0(U,K\otimes L^*)$
        使得$\langle \sigma,\varphi\rangle =0, \forall \varphi\in \calE_L^{(0,1)}(X)$, 
        $\Supp \varphi \subset U$，则$\sigma=0$（定理的唯一性.
        \item[(ii)] 设$U$为$X$的一个坐标邻域，使得$L|_U$平凡，
        则存在$S\in H^0(U,K\otimes L^*)$使得
        $F(\varphi)=\langle S,\varphi\rangle, \forall \varphi \in \calE_L^{(0,1)}(X)$
        且$\Supp \varphi\subset U$.
    \end{enumerate} 

    对于(i)，在局部坐标下，即证若$\int_U f\cdot gdz\wedge d\bar{z}=0$ 对任意$g\in C^\infty_0(U)$则$f=0$. 这是熟知结论，于是(i)成立.

	接下来先假设(ii)成立，取$X$的坐标邻域覆盖$\{(U_i,z_i)\}$使得$L|_{U_i}$平凡，
    由(ii)，存在$S_i\in H^0(U_i,K\otimes L^*)$
    使得$F(\varphi)=\langle S_i,\varphi\rangle, \forall \varphi\in \calE_L^{(0,1)}(X)$
    且$\Supp \varphi\subset U_i$. 若$\Supp \varphi\subset U_i\cap U_j$，
    则$\langle S_i-S_j,\varphi\rangle =0$，由(i)推出$S_i=S_j$于$U_i\cap U_j$，
    故定义$S|_{U_i}:=S_i$，有$S\in H^0(X,K\otimes L^*)$.

	取$\{\chi_i\}$为从属于$\{U_i\}$的单位分解，对$\varphi\in \calE_L^{(0,1)}(X)$，
    令$\varphi_i=\chi_i\varphi$，
    则$\Supp \varphi_i\subset U_i$且$\varphi=\sum\limits_i\varphi_i$. 
	$$\langle S,\varphi\rangle=\sum \langle S,\varphi_i\rangle 
    =\sum \langle S_i,\varphi_i\rangle =\sum F(\varphi_i)
    =F(\sum \varphi_i)=F(\varphi).$$
	接下来我们证明(ii)成立. 设$S=fdz\otimes \xi^*$，$\varphi=gd\bar{z}\otimes \xi$，
    则$\langle S,\varphi\rangle =\int_U f\cdot gdz\wedge d\bar{z}$. 
    因此只需证明下面的Weyl引理.
\end{proof}

\begin{lemma}[Weyl引理]
	设$U\subset \subset \bbC$是有界区域，
    $T\colon C^\infty_0(U)\rightarrow \bbC$为一个线性映射，使得
    \begin{enumerate}
	\item 若$f_j \in C^\infty_0(U)$按$C^\infty$拓扑
    收敛于$f\in C^\infty_0(U)$, 则$Tf_j\rightarrow Tf$;
	
    \item $T(\partial g/\partial \bar{z})=0, \forall g\in C^\infty_0(U)$
    （即在分布意义下，$\Opartial T=0$）.
    \end{enumerate}
	则存在唯一的$h\in \calO(U)$，使得$Tg=\int_U h\cdot gdz\wedge d\bar{z}$.
\end{lemma}

\begin{proof}
	$\forall \varep >0$，定义$U_\varep:=\{z\in U: d(z,\partial U)>\varep\}$，
    取$\chi_\varep\in C_0^\infty(\Delta_\varep)$
    使得$\chi_\varep|_{\overline{\Delta_{\frac{\varep}{2}}}}=1$. 

	对于$f\in C^\infty_0(U_\varep)$，定义$f_\varep \in C^\infty_0(U)$如下：
	$$f_\varep(z):=\frac{1}{2\pi i} \int_\bbC f(z+w)\cdot \frac{\chi_\varep(w)}{w} dw\wedge d\bar{w}.$$
	\begin{align*}
		\frac{\partial f_\varep}{\partial \bar{z}}
        &=\frac{1}{2\pi i}\int_\bbC \frac{\partial}{\partial \bar{z}}
        f(z+w)\frac{\chi_\varep(w)}{w} dw\wedge d\bar{w}\\
		&=\lim_{\delta \to 0} \frac{1}{2\pi i} 
        \int_{\bbC\backslash \overline{\Delta_\delta}} 
        \frac{\partial}{\partial \bar{w}} f(z+w)
        \frac{\chi_\varep(w)}{w}dw\wedge d\bar{w}\\
		&=-\lim_{\delta \to 0} \frac{1}{2\pi i} 
        \int_{\bbC\backslash \overline{\Delta_\delta}} 
        d\left(f(z+w)\frac{\chi_\varep(w)}{w}dw\right)\\
        &\quad-\lim_{\delta \to 0}\frac{1}{2\pi i} 
        \int_{\bbC\backslash \overline{\Delta_\delta}} 
        f(z+w)\frac{\partial}{\partial \bar{w}}
        \bigg(\frac{\chi_\varep(w)}{w}\bigg) dw\wedge d\bar{w}\\
		&=\quad\lim_{\delta\to 0} \frac{1}{2\pi i} 
        \int_{\partial \Delta_\delta} f(z+w)\frac{\chi_\varep(w)}{w}dw\\
        &\quad-\lim_{\delta\to 0} \frac{1}{2\pi i} 
        \int_{\bbC\backslash \Delta_\delta} f(w) \rho_\varep(w-z)dw\wedge d\bar{w}\\
		&=f(z)-\frac{1}{2\pi i} \int_\bbC f(w) \rho_\varep (w-z)dw\wedge d\bar{w},
	\end{align*}
	其中$\rho_\varep(w)=\frac{\partial}{\partial \bar{w}}\big(\frac{\chi_\varep(w)}{w}\big) 
    \in C^\infty_0(\Delta_\varep \backslash \overline{\Delta_{\frac{\varep}{2}}})$.

	将上面积分写成Riemann和的极限，再利用1推出$\forall f\in C^\infty_0(U_\varep)$，有
	$$0=T\bigg(\frac{\partial f_\varep}{\partial \bar{z}}\bigg)
    =Tf-\frac{1}{2\pi i} \int_U f(w)h_\varep(w)dw\wedge d\bar{w},$$
	其中$h_\varep(w)=T(z\to \rho_\varep(w-z))$，第一处等号是因为2，则
	$$Tf=\frac{1}{2\pi i} \int_U f(w)h_\varep(w)dw\wedge d\bar{w}.$$
	$$\frac{h_\varep(w+t)-h_\varep(w)}{t}
    =T\bigg(\frac{\rho_\varep(w+t-\cdots)-\rho_\varep(w-\cdots)}{t}\bigg)
    \to T\bigg(\frac{\partial \rho_\varep}{\partial t}\bigg)$$
	推出$h_\varep\in C^1(U_\varep)$.

	设$g\in C^\infty_0(U_\varep)$，则
	\begin{align*}
		0&=T\bigg(\frac{\partial g}{\partial \bar{z}}\bigg)\\
		&=\frac{1}{2\pi i}\int_{U_\varep} \frac{\partial g}{\partial \bar{z}}\cdot h_\varep (z)dz\wedge d\bar{z}\\
		&=0\frac{1}{2\pi i} \int_{U_\varep} g\cdot \frac{\partial h_\varep}{\partial \bar{z}} dz\wedge d\bar{z}			
	\end{align*}
	推出$\frac{\partial h_\varep}{\partial \bar{z}}=0$，
    故$h_\varep \in \calO(U_\varep)$.

	设$\varep_1<\varep_2$，则$U_{\varep_1}\supset U_{\varep_2}$，
    对$g\in C^\infty_0(U_{\varep_2})$,
	$$Tg=\frac{1}{2\pi i}\int_U g(w)\cdot h_{\varep_2}(w)dw\wedge d\bar{w}
    =\frac{1}{2\pi i} \int_U g(w)h_\varep(w) dw\wedge d\bar{w}.$$
	推出$\int_{U_{\varep_2}} g(w)(h_{\varep_1}(w)-h_{\varep_2}(w))dw\wedge d\bar{w}=0, 
    \forall g\in C^\infty_0(U_{\varep_2})$，
    则$h_{\varep_1}|_{U_{\varep_2}}=h_{\varep_2}$.

	最后，取$h|_{U_\varep}:=\frac{1}{2\pi i} h_\varep\in \calO(U)$，其满足要求.	
\end{proof}

\begin{lemma}
	$X$是紧Riemann面，$f\in \calE_L(X)$，$S\in H^0(X,K\otimes L^*)$，
    则$\langle S, d''f\rangle =0$.
\end{lemma}

\begin{proof}[引理的证明]
	设$\{(U_i,z_i)\}$是$X$的一个坐标邻域覆盖，使得$L_{U_i}$平凡. 
    取$\{U_i\}$的单位分解$\chi_i$，令$f_i=\chi_i \cdot f\in C^\infty_0(U_i)$，
    $f=\sum f_i$，$S|_{U_i}=h_i dz_i \otimes \xi^*, h_i \in \calO(U_i)$. 那么
	\begin{align*}
		\langle S, d''f\rangle &=\sum \langle S, d''f_i \rangle\\
		&=\sum \int_{U_i} h_i \cdot \frac{\partial f_i}{\partial \bar{z}_i}dz_i \wedge d\bar{z}_i\\
		&=-\sum \int_{U_i} \frac{\partial h_i}{\partial \bar{z}_i} f_i dz_i \wedge d\bar{z}_i=0.
	\end{align*}
\end{proof}
 
\begin{definition}
	于是$\langle -,- \rangle $诱导出一个双线性形式
	$$H^0(X, K\otimes L^*)\times \left(\calE^{(0,1)}_L(X)/d''\calE_L(X)\right) \rightarrow  \bbC$$
	仍记为$\langle -,- \rangle$.

	设$D\colon H^1(X,L)\rightarrow \calE^{(0,1)}_L(X)/d''\calE_L(X)$为Dolbeault同构，
    再定义一个双线性形式
	$$H^0(X,K\otimes L^*)\times H^1(X,L)\rightarrow \bbC$$
	$$\langle S, \xi \rangle_L:=\langle S, D(\xi)\rangle$$
	其诱导出映射$\Delta_L\colon H^0(X, K\otimes L^*)\rightarrow H^1(X,L)^*$, 
    $S\mapsto \Delta_L(S)\colon \xi \mapsto \langle S, \xi \rangle_L$.
\end{definition}

\begin{theorem}[Serre]
	$\Delta_L$是一个同构.
\end{theorem}

\begin{proof}
	$\Delta_L$单：若$S\in  H^0(X, K\otimes L^*)$
    使得$\langle S,\varphi\rangle =0, \forall \varphi\in \calE^{(0,1)}_L(X)$，
    则$S=0$.

	$\Delta_L$满. 设$l\colon \calE^{(0,1)}_L(X)/d'' \calE_L(X) \rightarrow \bbC$
    是一个线性映射，因为$\dim \calE^{(0,1)}_L(X)/d'' \calE_L(X)<\infty$，故$l$ 连续. 
    定义线性映射
	\begin{align*}
		F\colon\calE^{(0,1)}_L(X) &\rightarrow \bbC\\
		\varphi &\mapsto l([\varphi]).
	\end{align*}
	则$F$为连续线性泛函，且使得$F|_{d''\calE_L(X)}=0$，
    所以由表示定理，存在唯一的$S\in H^0(X, K\otimes L^*)$使得
	$$l([\varphi])=F(\varphi)=\langle S, \varphi \rangle 
    =\langle S, [\varphi] \rangle, \forall \varphi \in \calE^{(0,1)}_L(X).$$
	再利用同构$D$，知$\Delta_L$是满的.
\end{proof}

\begin{corollary}[Serre对偶定理]
	$$H^0(X,\Omega_{-D})\cong H^1(X, \calO_D)^*.$$
	$$H^0(X, \calO_{-D})\cong H^1(X, \Omega_D)^*.$$
\end{corollary}

\begin{proof}
    第一个是因为
	$$\Omega_{-D}\cong \calO_{K\otimes L_D^*},$$
	$$\calO_D \cong \calO_{L_D}.$$
	第二个是
	$$H^0(X, \calO_{-D})\cong H^0(X, \Omega_{-K-D}) 
    \cong H^1(X, \calO_{K+D})^* \cong H^1(X, \Omega_D)^*.\qedhere$$
\end{proof}


\subsection{调和微分形式}

\begin{definition}
	$X$是Riemann面，$\omega\in \calE^1(X)$，局部地，$\omega=fdz+gd\bar{z}$. 
    定义$\overline{\omega}:=\bar{f}d\bar{z}+\bar{g}dz\in \calE^1(X)$.

	若$\omega=\Over{\omega}$，则称$\omega$为实的. 
    令$\Re \omega:=\frac{1}{2}(\omega+\Over{\omega})$，
    则$\omega$为实的等价于$\omega=\Re \omega$.

	$\Over{\Omega}(X)=\{\Over{\omega}:\omega\in \Omega(X)\}$. 
    $\forall \omega\in \calE^1(X)$，存在唯一分解$\omega=\omega_1+\omega_2$，
    其中$\omega_1\in \calE^{(1,0)}(X)$，$\omega_2\in \calE^{(0,1)}(X)$.
\end{definition}

\begin{definition}
	定义Hodge $*$ 算子如下：$*\omega:=i(\Over{\omega_1}-\Over{\omega_2})$
    （其为一个共轭线性算子）.
\end{definition}

\begin{proposition}[Hodge $*$ 算子的若干性质]

	1.$**\omega=-\omega$, $\Over{*\omega}=*\Over{\omega}$.

	2. $d*\omega=id(\Over{\omega_1}-\Over{\omega_2})
    =id'\Over{\omega_1}-id''\Over{\omega_2}$.

	3. $*d'f=id''\bar{f}$, $*d''f=-id'\bar{f}$.

	4. $d*df=2id'd''\bar{f}$.
\end{proposition}
\begin{proof}
根据定义，我们将 $\omega \in \mathcal{E}^1(X)$ 分解为 $\omega = \omega_1 + \omega_2$, 其中 $\omega_1 \in \mathcal{E}^{(1,0)}(X)$, $\omega_2 \in \mathcal{E}^{(0,1)}(X)$. 则 $*\omega = i(\overline{\omega_1} - \overline{\omega_2})$.

    先证明第一条.
    由于 $\overline{\omega_1}$ 是 $(0,1)$ 型, $\overline{\omega_2}$ 是 $(1,0)$ 型, 令 $\eta = *\omega = \eta_1 + \eta_2$, 其中 $\eta_1 = -i\overline{\omega_2}$ 为 $(1,0)$ 型, $\eta_2 = i\overline{\omega_1}$ 为 $(0,1)$ 型. 则:
    \[ **\omega = i(\overline{\eta_1} - \overline{\eta_2}) = i(i\omega_2 - (-i)\omega_1) = i^2(\omega_1 + \omega_2) = -\omega \]
    同时, 
    \[ \overline{*\omega} = \overline{i(\overline{\omega_1} - \overline{\omega_2})} = -i(\omega_1 - \omega_2) \]
    由于 $\bar{\omega} = \overline{\omega_1} + \overline{\omega_2}$, 其 $(1,0)$ 分量为 $\overline{\omega_2}$, $(0,1)$ 分量为 $\overline{\omega_1}$, 故:
    \[ *\bar{\omega} = i(\overline{\overline{\omega_2}} - \overline{\overline{\omega_1}}) = i(\omega_2 - \omega_1) = -i(\omega_1 - \omega_2) \]
    得证 $\overline{*\omega} = *\bar{\omega}$.

    接下来证明第二条.
    \[ d*\omega = i d(\overline{\omega_1} - \overline{\omega_2}) \]
    在 Riemann 面上, $d\overline{\omega_1} = (d' + d'')\overline{\omega_1} = d'\overline{\omega_1}$, $d\overline{\omega_2} = (d' + d'')\overline{\omega_2} = d''\overline{\omega_2}$. 代入即得:
    \[ d*\omega = id'\overline{\omega_1} - id''\overline{\omega_2} \]

    接下来证明第三条.
    对于 $\omega = d'f$, 其 $\omega_1 = d'f, \omega_2 = 0$, 则 $*d'f = i\overline{d'f} = id''\bar{f}$. \\
    对于 $\omega = d''f$, 其 $\omega_1 = 0, \omega_2 = d''f$, 则 $*d''f = -i\overline{d''f} = -id'\bar{f}$.

    最后证明第四条.
    利用性质 3:
    \[ d * df = d(*(d'f + d''f)) = d(id''\bar{f} - id'\bar{f}) = i(d' + d'')(d''\bar{f} - d'\bar{f}) \]
    \[ = i(d'd''\bar{f} - d''d'\bar{f}) = i(d'd''\bar{f} - (-d'd''\bar{f})) = 2id'd''\bar{f} \]
\end{proof}
\begin{definition}
	称$\omega\in \calE^1(X)$为调和的，若
	$$d\omega=0=d*\omega.$$
	记$\mathscr{H}^1(X)$是$X$上的调和$1$-形式全体.
\end{definition}
		
\begin{theorem} 下列命题等价(TFAE):

	1. $\omega\in \scrH^1(X)$.\par
	2. $d'\omega=0=d''\omega$.\par
	3. $\omega=\omega_1+\omega_2\in \Omega(X)+\Over{\Omega}(X)$.\par
	4. $\forall a\in X$，存在坐标邻域$U\ni a$以及$f\in \scrH(U)$使得$\omega=df$.
\end{theorem}
		
\begin{proof}
	$$0=d\omega=d\omega_1+d\omega_2=d''\omega_1+d'\omega_2$$
	$$0=d*\omega=id(\Over{\omega_1}-\Over{\omega_2})
    =i(d'\Over{\omega_1}-d''\Over{\omega_2})$$
	第二行等价于$0=d''\omega_1-d'\omega_2$. 故$\omega\in \scrH^1(X)$
    等价于$d''\omega_1=0=d'\omega_2$. 容易验证1，2，3等价.

	3推4：设$\omega_1=h_1dz$, $\Over{\omega_2}=h_2dz$, $h_1,h_2\in \calO(U)$. 令
	$$f(z):=\int_0^z h_1dz+ \int_0^{\bar{z}} \Over{h_2dz}\in \scrH(U),$$
	则$df=h_1dz+\Over{h_2dz}=\omega$.

	4推1：设$\omega=df$，$d\omega=d^2f=0$. 
    $d*\omega=d*df=2id'd''\Over{f}=0$推出$\omega\in \scrH^1(X)$.	
\end{proof}
		
\begin{theorem}
	设$\sigma\in \scrH^1(X)$且是实的，
    则存在唯一的$\omega\in \Omega(X)$使得$\sigma=\Re\omega$.
\end{theorem}

\begin{proof}
	存在性：设$\sigma=\omega_1+\Over{\omega_2}$，$\omega_1, \omega_2\in \Omega(X)$. 
    $\omega_1+\Over{\omega_2}=\sigma=\Over{\sigma}=\Over{\omega_1}+\omega_2$. 
    推出$\omega_1-\omega_2=\Over{\omega_1-\omega_2}$，故$\omega_1=\omega_2$，
    因此$\sigma=\omega+\Over{\omega}=2\Re\omega$.

	唯一性：设$\omega\in \Omega(X)$使得$\Re\omega=0$. 
    局部地，$\omega=df$，$f\in \calO$.
	$$0=\Re\omega=\Re df=d \Re f$$
	推出$\Re f$局部为常数，由柯西黎曼方程，进而$f$局部为常数，进而$df=0$，则$\omega=0$.
\end{proof}

\begin{definition}
    设$X$是紧Riemann面（本节下述命题均有此假设），$\omega_1,\omega_2\in \calE^1(X)$，令
    \[\langle \omega_1,\omega_2\rangle :=\int_X \omega_1\wedge *\omega_2.\]
\end{definition}

局部地，设$\omega_1=f_1dz+g_1d\bar{z}$，$\omega_2=f_2dz+g_2d\bar{z}$，
\begin{align*}
	\omega_1\wedge *\omega_2&=(f_1dz+g_1d\bar{z})\wedge i(\Over{f_2}d\bar{z}-\Over{g_2}dz)\\
	&=i(f_1\Over{f_2}+g_1\Over{g_2})dz\wedge d\bar{z}
\end{align*}
故$\langle \cdot, \cdot \rangle$是$\calE^1(X)$上的一个内积.

\begin{lemma}
	1. $d'\calE(X), d''\calE(X), \Omega(X), \Over{\Omega}(X)$相互正交.

	2. $d\calE(X)$与$*d\calE(X)$正交，
    且$d\calE(X)\oplus *d\calE(X)=d'\calE(X)\oplus d''\calE(X)$.
\end{lemma}

\begin{proof}[引理的证明]
	第一条：首先我们显然有$\calE^{(1,0)}(X) \perp \calE^{(0,1)}(X)$，
    故$\calE^1(X)=\calE^{(1,0)}(X)\oplus \calE^{(0,1)}(X)$. 
    故只需证$d'\calE(X) \perp \Omega(X)$，$d''\calE(X)\perp \Over{\Omega}(X)$. 我们只证第一个，第二个可类似证明.

	设$f\in \calE(X)$, $\omega\in \Omega(X)$
	$$\omega \wedge *d'f=\omega \wedge id''\Over{f}
    =-id''(\Over{f}\omega)=-id(\Over{f}\omega)$$
	推出
	$$\langle \omega, d'f\rangle=\int_X \omega\wedge *d'f
    =-i\int_X d(\Over{f}\omega)=0$$
	故$\omega \perp d'f$.
			
	第二条：设$f,g\in \calE(X)$，则$df\wedge **dg=-df\wedge dg=-d(fdg)$，
    推出$\langle df,*dg\rangle=-\int_X d(fdg)=0$，进而$d\calE(X)\perp *d\calE(X)$.

	又因为$d'\calE(X)\oplus d''\calE(X)\supset d\calE(X)$，
    $*d\calE(X)\subset d'\calE(X)\oplus d''\calE(X)$(性质3). 所以LHS包含于RHS.
	RHS包含于LHS由性质3易得，注意到:
    \[ d'f = \frac{1}{2}(df + i * d\bar{f}), \quad d''f = \frac{1}{2}(df - i * d\bar{f}). \]
\end{proof}

\begin{corollary}
	$\scrH^1(X)=\Omega(X)\oplus \Over{\Omega}(X)$，
    进而$\dim \scrH^1(X)=2\dim \Omega(X)=2g$.
\end{corollary}

\begin{corollary}
	$\sigma\in \scrH^1(X)$且正合，则$\sigma=0$.
    ($\sigma \in \scrH^1(X)\cap d\calE(X)$)
\end{corollary}

\begin{corollary}
	$f\in \scrH(X)$，则$f$恒为常数.(考虑$\sigma=df$)
\end{corollary}

\begin{theorem}\label{decomposition}
	$\calE^{(0,1)}(X)=d''\calE(X)\oplus \Over{\Omega}(X)$.
\end{theorem}

\begin{proof}
	由Dolbeault定理，$\calE^{(0,1)}(X)/d''\calE(X)\cong H^1(X,\calO)$，
    则$\dim \calE^{(0,1)}(X)/d''\calE(X)=g$.

	显然$\calE^{(0,1)}(X)\supset d''\calE(X)\oplus \Over{\Omega}(X)$，
    则$\calE^{(0,1)}(X)/d''\calE(X)\supset \Over{\Omega}(X)$.

	因为$\dim \Over{\Omega}=g$，
    所以$\calE^{(0,1)}(X)/d''\calE(X)=\Over{\Omega}(X)$. 所以$\calE^{(0,1)}(X)=d''\calE(X)\oplus \Over{\Omega}(X)$.
\end{proof}

\begin{theorem}[Hodge正交分解定理]
	$$\calE^1(X)=d\calE(X)\oplus *d\calE(X)\oplus \scrH^1(X).$$
\end{theorem}

\begin{proof}
	由上述定理，$\calE^{(1,0)}=d'\calE(X)\oplus \Omega(X)$，推出
	\begin{align*}
		\calE^1(X) &= \calE^{(1,0)}(X)\oplus \calE^{(0,1)}(X)\\
		&=d'\calE(X)\oplus d''\calE(X)\oplus \Omega(X)\oplus \Over{\Omega}(X)\\
		&=d\calE(X)\oplus *d\calE(X)\oplus \scrH^1(X).
	\end{align*}
\end{proof}

\begin{corollary}
	$\sigma\in \calE^{(0,1)}(X)$，方程$d''f=\sigma$可解等价于
	$$\int_X\sigma\wedge \omega=0, \quad \forall \omega\in \Omega(X).$$
\end{corollary}

\begin{proof}
	左推右：
	$$\int_X \sigma\wedge \omega=\int_X d''f\wedge \omega
    =\int_X d''(f\omega)=\int_Xd(f\omega)=0.$$
	右推左：
	$$\langle \sigma,\Over{\omega}\rangle =\int_X \sigma\wedge (-i\omega)
    =-i \int_X \sigma\wedge \omega=0$$
	推出$\sigma\perp \Over{\Omega}(X)$，由定理\ref{decomposition}知$\sigma\in d''\calE(X)$.
\end{proof}

\begin{theorem}
	$$\Ker \left(d\colon\calE^1(X)\rightarrow \calE^2(X)\right) 
    =d\calE(X) \oplus \scrH^1(X).$$
\end{theorem}

\begin{proof}
	记LHS为$\scrL$，LHS包含RHS是显然的，对于另一方向，由Hodge正交分解，
    只需证$\scrL\perp *d\calE(X)$即可.

	设$\omega\in \scrL$，$f\in \calE(X)$，
	$$\omega\wedge **df=-\omega \wedge df=d(f\omega)$$
	推出$\langle \omega, *df\rangle =\int_Xd(f\omega)=0$.
\end{proof}

\begin{corollary}
	$\sigma\in \calE^1(X)$正合（即$df=\sigma$可解）等价于
	$$\int_X \sigma\wedge \omega=0, \quad \forall \text{ 闭 } \omega\in \calE^1(X).$$
\end{corollary}

\begin{proof}
	左推右是Stokes公式，右推左：
	$$\langle \omega, *\sigma\rangle =\int_X \omega\wedge **\sigma
    =-\int_X \omega\wedge \sigma=0$$
	对于任意闭的$\omega\in \calE^1(X)$. 推出$*\sigma\perp \scrL$，
    则由Hodge分解，$*\sigma \in *d\calE(X)$，进而$\sigma \in d\calE(X)$.
\end{proof}

\begin{theorem}[Hodge--de Rham]
	$$H^1(X,\bbC)\cong \operatorname{Rh}^1(X) \cong \scrH^1(X),$$
	其中第一个同构是de Rham同构，第二处同构是上一条定理. 
\end{theorem}
		
\begin{definition}
	称$b_1:=\dim H^1(X,\bbC)$为$X$的第一Betti数，其为一个拓扑不变量.
\end{definition}
		
\begin{remark}
	由Hodge--de Rham定理，$b_1=2g$，故$g$也是拓扑不变量.
\end{remark}

\begin{remark}
	由可定向紧曲面的拓扑分类，$X$同胚于球面加上$g$个柄.
\end{remark}
		

\subsection{Mittag--Leffler问题}

\begin{theorem}[Mittag--Leffler定理]
	给定$\bbC$中一个离散点列上的一列主部，
    存在$f\in \mathscr{M}(\bbC)$使得$f$在这些点上的主部恰好为给定主部.
\end{theorem}

问：在Riemann面上是否有类似现象？

\begin{definition}
	$X$是Riemann面，$\scrU=\{U_i\}_{i\in I}$为$X$的开覆盖. 
    称$\mu=(f_i)\in C^0(\scrU, \mathscr{M})$为一个Mittag--Leffler分布，
    若$f_i-f_j \in \calO(U_i\cap U_j), \forall i,j$，
    即$\delta \mu \in Z^1(\scrU, \calO)$.

	相应于$\mu$的一个解指的是一个$f\in \mathscr{M}(X)$使得$f-f_i\in \calO(U_i), \forall i$.
\end{definition}

\begin{remark}
	则Mittag--Leffler定理等价于$\bbC$上的任何Mittag--Leffler分布存在解.
\end{remark}

\begin{theorem}
	M--L分布$\mu$存在解等价于$[\delta \mu]=0$于$H^1(\scrU,\calO)$.
\end{theorem}

\begin{proof} 左推右：设$f$为$\mu=(f_i)$的解，则$g_i:=f_i-f\in \calO(U_i)$，
	$$\delta \mu=(f_i-f_j)=(g_i-g_j)\in B^1(\scrU,\calO).$$
	右推左：$[\delta \mu]=0$，推出存在$g_i\in \calO(U_i)$使得$\delta \mu=(g_i-g_j)$，
    则$f_i-f_j=g_i-g_j$，即$f_i-g_i=f_j-g_j$，
    做$f|_{U_i}:=f_i-g_i \in \mathscr{M}(X)$，其为$\mu$的解.
\end{proof}

\begin{remark}
	设$X$是紧Riemann面，则$H^1(X,\mathscr{M})=0$. 对于任意$\xi\in H^1(X,\calO)$，
    则$\xi=[(f_{ij})], (f_{ij})\in Z^1(\scrU, \calO)\subset Z^1(\scrU, \mathscr{M})$，
    故存在$f_i\in \mathscr{M}(U_i)$，使得$f_{ij}=f_i-f_j$. 
    故$\mu=(f_i)$为一个M--L分布，且$\xi=[\delta \mu]$.

	当$g\geq 1$时，存在$\xi\in H^1(X, \calO)$非$0$，其对应的M--L分布$\mu$不存在解.
\end{remark}

\begin{definition}
	称$\mu=(\omega_i)_{i \in I}\in C^0(\scrU, \mathscr{M}^1)$为一个M--L分布，
    若$\omega_i-\omega_j \in \Omega(U_i\cap U_j), \forall i,j$.

	对于$a\in X$，定义$\mu$在$a$处的留数为$\Res_a \mu :=\Res_a \omega_i$，
    若$a\in U_i$.（验证定义良好）
	若$X$是紧Riemann面，则定义$\Res \mu =\sum\limits_{a\in X} \Res_a \mu$.
    （本质是有限和）
\end{definition}

\begin{theorem}
	$X$是紧Riemann面，M--L分布$\mu=(f_i)$存在解等价于
	$$\Res \mu \omega=0, \quad \forall \omega \in \Omega(X).$$
\end{theorem}

\begin{proof}
	左推右：设$f$为$\mu$的解，则$f-f_i\in \calO(U_i)$，
    则$\forall x\in U_i$，$\Res_x f\cdot \omega=\Res_x f_i\cdot \omega, \forall i$. 
    另一方面，因为$f\cdot \omega \in \mathscr{M}^1(X)$，
    由留数定理，$\Res f\cdot \omega=0$.

	右推左：因为$\delta \mu \in Z^1(\scrU, \calO)\subset Z^1(\scrU, \calE)$，
    而$H^1(\scrU, \calE)=0$，故存在$(\sigma_i)\in C^0(\scrU, \calE)$
    使得$\calO(U_i\cap U_j)\ni f_i-f_j=\sigma_i-\sigma_j$于$U_i\cap U_j$. 
    故$d''\sigma_i=d''\sigma_j$于$U_i\cap U_j$，
    则$\alpha|_{U_i}:=d''\sigma_i \in \calE^{(0,1)}(X)$. 我们假设有
	\[\int_X \alpha \wedge \omega=0, \quad \forall \omega \in \Omega(X),\tag{$*$}\]
	则存在$u \in \calE(X)$使得$d''u=\alpha$.

	令$g_i=\sigma_i-u$，则$d''g_i=0$，故$g_i\in \calO(U_i)$，
    且$\delta \mu =(f_i-f_j)=(\sigma_i-\sigma_j)=(g_i-g_j)$，
    则$[\delta \mu]=0$，故$\mu$存在解.

	我们再说明方程$(*)$成立. 令$\beta|_{U_i}:=f_i-\sigma_i$ 拼接成 $\beta\in \calE(X')$，
    $X'=X\backslash \{a_1,\cdots,a_n\}$，其中$a_j$是$\mu$的极点. 
    则$d''\beta=d''f_i-d''\sigma_i=-\alpha$于$X'$.
	\begin{align*}
		\int_X \alpha \wedge \omega
        &=-\lim\limits_{\varep\to 0} \int_{X\backslash \bigcup\limits_j \{\vert z_j \vert \leq \varep\}} d''\beta\wedge \omega\\
		&=-\lim\limits_{\varep\to 0} \int_{X\backslash \bigcup\limits_j \{\vert z_j \vert \leq \varep\}}  d(\beta\wedge \omega)\\
		&=\sum\limits_{j=1}^n \lim\limits_{\varep\to 0} \int_{\{\vert z_j \vert = \varep\}} \beta\wedge \omega\\
		&=\sum\limits_{j=1}^n \lim\limits_{\varep\to 0} \int_{\{\vert z_j \vert = \varep\}} f_j\wedge \omega-\sigma_j\wedge \omega\\
		&=2\pi i \Res \mu \cdot \omega=0.
	\end{align*}
\end{proof}

接下来我们看一些应用.

先考虑亏格$g=1$的情形. 取 $\Gamma:=\Z\gamma_1+\Z\gamma_2$为一个格. 
$P:=\{t_1\gamma_1+t_2\gamma_2: t_1, t_2\in [0,1)\}.$
\begin{proposition}
    给定$a_1,\cdots,a_n\in P$
    以及主部$\sum\limits_{\nu=-r_j}^{-1} C_\nu^j (z-a_j)^\nu$，$1\leq j\leq n$.

	存在$\Gamma$双周期亚纯函数，使得其在$a_j$处有上述给定主部，等价于
	$$\sum\limits_{j=1}^n C^j_{-1}=0.$$
\end{proposition}
		
\begin{proof}
	设$X=\bbC/\Gamma$. 记$\omega$为由$dz$诱导的$X$上的全纯$1$-形式，
    则$\Omega(X)=\bbC \cdot \omega$. 设$\mu$为相应的M--L分布. 
    则$\mu$存在解等价于$\Res \mu \cdot \omega=0$（这里用到了$\omega$构成基），
    即等价于$\sum\limits_{j=1}^n C^j_{-1}=0$.
\end{proof}

接下来我们考虑一般情形.
\begin{definition}
    $U\subset \bbC$为区域，$f_1,\cdots,f_g\in \calO(U)$，称
    $$W(f_1,\cdots,f_g):=\det \begin{pmatrix}f_1 &f_2 &\cdots &f_g\\ \\
    f_1' &f_2' &\cdots &f_g'\\ \\ \vdots &\vdots &\ddots &\vdots\\ \\
    f_1^{(g-1)} &f_2^{(g-1)} &\cdots &f_g^{(g-1)} \end{pmatrix}$$
	为Wronski行列式.
\end{definition}

\begin{lemma}
	$f_1,\cdots,f_g$线性无关等价于$W(f_1,\cdots,f_g)$不恒等于$0$.
\end{lemma}

\begin{proof}[引理的证明]
	右推左：假设$f_1,\cdots,f_g$线性相关，
    即存在不全为$0$的$c_1,\cdots,c_g\in \bbC$使得
	$$c_1f_1+\cdots+c_gf_g=0.$$
	不妨设$c_g\neq 0$，则$f_g=-\sum\limits_{j=1}^{g-1} \frac{c_j}{c_g}f_j$，
    则$W(f_1,\cdots,f_g)\equiv 0$，矛盾.

	左推右：首先证明，若$h_j=\varphi \cdot f_j, \varphi\in \calO(U)$，
    则$W(h_1,\cdots,h_g)=\varphi^g \cdot W(f_1,\cdots,f_j)$. 
    由Leibniz法则，
    \[h_k^{(\nu)}=\varphi\cdot f_k^{(\nu)}
    +\sum_{0\leq\mu<\nu} C_\nu^\mu \varphi^{(\nu-\mu)}f_k^{(\mu)},\]
    则
	$$W(h_1,\cdots,h_g)=\det(\varphi f_k^{(j)})=\varphi^g W(f_1,\cdots,f_g).$$
	回到原题，用数学归纳法，$g=1$时显然，现假设$g-1$的情形已证明，
    若$W(f_1,\cdots,f_g)\equiv0$，且不妨设$f_g$不恒等于$0$. 
    令$V:=U\backslash f_g^{-1}(0)$，在$V$上
	$$W\left(\frac{f_1}{f_g},\cdots,\frac{f_{g-1}}{f_g},1\right)
    =f_g^{-g}W(f_1,\cdots,f_g)=0.$$
	记$h_k:=\frac{f_k}{f_g}$，有
	$$W\left(\frac{f_1}{f_g},\cdots,\frac{f_{g-1}}{f_g},1\right)
    =W(h_1,\cdots,h_{g-1},1)=\pm W(h_1',\cdots,h_{g-1}').$$
	由归纳假设，存在不全为$0$的复数$c_1,\cdots,c_{g-1}$
    使得$\sum\limits_{j=1}^{g-1} c_j h_j'=0$，
    则$\sum\limits_{j=1}^{g-1} c_j h_j$是常数，
    故$h_1,\cdots,h_{g-1},1$线性相关，即$f_1,\cdots,f_g$在$V$上线性相关. 
    又$V\subset U$稠密，所以$f_1,\cdots,f_g$在$U$上线性相关.
\end{proof}

\begin{definition}
	$X$是紧Riemann面，亏格为$g$，设$\omega_1,\cdots,\omega_g$为$\Omega(X)$的一组基. 
    若在局部坐标 $(U,z)$下 $\omega_k=f_kdz$，那么我们定义$W_z(\omega_1,\cdots,\omega_g):=W(f_1,\cdots,f_g)$. 
\end{definition}

可以看到$W_z(\omega_1,\cdots,\omega_g)$依赖坐标的选取，我们接下来分析其在坐标变换下的变化.
事实上我们有如下定理.
\begin{theorem}
	设$(U,z)$和$(V,\tilde{z})$为$X$上的两个坐标邻域，且$U\cap V$非空. 则在$U\cap V$上成立
	$$W_z(\omega_1,\cdots,\omega_g)
    =\bigg(\frac{d\tilde{z}}{dz}\bigg)^N W_{\tilde{z}}(\omega_1,\cdots,\omega_g),$$
	其中$N=\frac{g(g+1)}{2}$.
\end{theorem}
\begin{proof}
    记$\psi=\frac{d\tilde{z}}{dz}$，设$\omega_i=\tilde{f_i}d\tilde{z}$，则
    \begin{align*}
        W_z(\omega_1,\cdots,\omega_g)&=\det \bigg(\psi^{m+1}\frac{d^m\tilde{f_k}}{d\tilde{z}^m}\bigg)_{m,k}
        &=\psi^{1+\cdots+g}W_{\tilde{z}}(\omega_1,\cdots,\omega_g)
        &=\bigg(\frac{d\tilde{z}}{dz}\bigg)^N W_{\tilde{z}}(\omega_1,\cdots,\omega_g).
    \end{align*}
\end{proof}
\begin{remark}
	$\sigma|_U:=W_z(\omega_1,\cdots,\omega_g)dz^{\otimes N}\in \Gamma(X,K_X^{\otimes N})$. 其中$K_X$是典范线丛.
\end{remark}

\begin{definition}
	设$g\geq 2$，称$p\in X$为一个Weierstrass点，
    若存在基$\omega_1,\cdots,\omega_g\in \Omega(X)$以及坐标$(U,z)$
    使得$W_z(\omega_1,\cdots,\omega_g)|_p=0$. 
    上述定理保证此定义不依赖于坐标选取，还需验证定义与$\Omega(X)$的正交基的选取无关

	$(\omega_1,\cdots,\omega_g)=(\tilde{\omega}_1,\cdots,\tilde{\omega}_g)\cdot C$，
    则$W_z(\omega_1,\cdots,\omega_g)=|C| W_z(\tilde{\omega}_1,\cdots,\tilde{\omega}_g)$（练习）.
\end{definition}

\begin{theorem}
	设$p\in X$，存在$f\in \mathscr{M}(X) \cap \calO(X\backslash \{p\})$
    使得其在$p$处有阶小于等于$g$的极点，等价于，$p$是一个Weierstrass点.
\end{theorem}

\begin{proof}
	取$\omega_1,\cdots,\omega_g\in \Omega(X)$的一组基. 取坐标$(U,z)$使得$z(p)=0$. 
    记$\omega_k=\sum\limits_{\gamma=0}^\infty a_{k\gamma}z^\gamma dz$于$U$. 
    则存在$f\in \mathscr{M}(X)\cap \calO(X\backslash \{p\})$，
    其在$p$处主部为$h=\sum\limits_{\gamma=0}^{q-1} c_\gamma/z^{\gamma+1}$，
    $c_0,\cdots,c_{q-1}$不全为$0$，等价于其是下面M-L分布的一个解: 
    $\mu=(h,0)\in C^0(\scrU,\mathscr{M})$，$\scrU=\{U,X\backslash \{p\}\}$. 
	$$\Res(\omega_k \mu)=\Res_p(\omega_k \cdot h)
    =\sum\limits_{\gamma=0}^{g-1} a_{k\gamma}\cdot c_\gamma$$
	推出$\begin{cases} \Res(\omega_k \mu)=0\\ 1\leq k\leq g\end{cases}$
    有非平凡解$(c_0,\cdots,c_{g-1})$等价于
    $\det(a_{k\gamma})_{\substack{\!\!\!\!1\leq k\leq g, \\\ 0\leq \gamma\leq g-1}}=0$，
    即$W_z(\omega_1,\cdots,\omega_g)|_p=0$，$p$为一个Weierstrass点.
\end{proof}

\begin{theorem}
	Weierstrass点的个数为$(g-1)g(g+1)$，记重数在内.
\end{theorem}

\begin{proof}
	设$(U_i,z_i)$，$i\in I$为$X$的一个坐标邻域覆盖，
    记$\psi_{ij}:=dz_j/dz_i$于$U_i\cap U_j$. 
    设$\omega_1,\cdots,\omega_g\in \Omega(X)$为一组基. 
    令$W_i=W_{z_i}(\omega_1,\cdots,\omega_g)\in \calO(U_i)$.

	定义$D\in \Div(X)$：$D(x):=\ord_x W_i$若$x\in U_i$. 
    只须证明$\deg D=(g-1)g(g+1)$.

	设$D_1=(\omega_1)$，则$\deg D_1=2g-2$. 
    设$\omega_1=f_{1i}dz_i$于$U_i$，则$D_1(x)=\ord_x f_{1i}$，若$x\in U_i$. 
    注意到$f_{1i}=\psi_{ij}f_{1j}$于$U_i\cap U_j$，则$\psi_{ij}=f_{1i}/f_{1j}$.

	因为$W_i=\psi_{ij}^N W_j$，
    所以$W_i \cdot f_{1i}^{-N}=W_j\cdot f_{1j}^{-N}$于$U_i \cap U_j$. 
    进而$f|_{U_i}:=W_i \cdot f_{1i}^{-N}\in \mathscr{M}(X)$. 
    则$0=\deg (f)=\deg D-N\cdot \deg D_1$，
	$$\deg D=N\cdot \deg D_1=(g-1)g(g+1).\qedhere$$
\end{proof}

\begin{remark}
    由Riemann-Roch定理，对于任意的$p$，存在$f\in \mathscr{M}(X) \cap \calO(X\backslash \{p\})$
    使得其在$p$处有阶小于等于$g+1$的极点，上述定理说明该界是“精确”的.
\end{remark}

\begin{corollary}
	$g\geq 2$时，Weierstrass点存在，更加地，
    存在分歧全纯覆盖$f\colon X \rightarrow \mathbb{P}^1$使得叶数不超过$g$.

	特别地，若$g=2$，则全纯覆盖的叶数只能为$2$，进而$X$为超椭圆.
\end{corollary}

\begin{definition}
	$X$是紧Riemann面，定义$X$的阶为
	$$\deg X:=\min \{n:\text{存在 }n\text{ 叶全纯覆盖 } 
    f\colon X\rightarrow \mathbb{P}^1\}.$$
	由推论，$\deg X\leq g$.
\end{definition}


\subsection{Abel定理}

\begin{theorem}[Weierstrass]
	设$\{a_n\}\subset \bbC$离散，$\{m_n\}\subset \Z\backslash \{0\}$，
    则存在$f\in \mathscr{M}(\bbC)$
    使得$f\in \calO(\bbC\backslash\{a_1,\cdots,a_n,\cdots\})$且$\ord_{a_n}f=m_n$.
\end{theorem}

问：在Riemann面上是否有类似现象？

\begin{definition}
	$X$是Riemann面，$D\in \Div(X)$. 称$f$为$D$的一个解，
    若$f\in \mathscr{M}(X)$使得$(f)=D$（即$D$是一个主除子）.
\end{definition}

\begin{remark}
	则Weierstrass定理等价于，任意$D\in \Div(\bbC)$存在一个解.
\end{remark}

若$X$是紧Riemann面，则$D\in \Div(X)$存在解可推出$\deg D=0$. 

记$X_D=\{x\in X: D(x)\geq 0\}$，则$X\backslash X_D$离散.

\begin{definition}
	$D$的一个弱解指一个$f\in \calE(X_D)$使得$\forall a\in X$，
    存在坐标$(U,z)$使得$z(a)=0$及$\psi\in \calE(U)$，$\psi(a)\neq 0$，
    使得$f=z^k\cdot \psi$于$X_D\cap U$，$k=D(a)$.

	弱解$f$为一个解，等价于$f\in \calO(X_D)$.
\end{definition}

\begin{proposition}
	若$f_1,f_2$为$D_1,D_2$的弱解，
    则$f_1\cdot f_2$是$D_1+D_2$的弱解，$f_1/f_2$是$D_1-D_2$的弱解.
\end{proposition}

\begin{proposition}
	设$f$为$D$的一个弱解，则$\frac{df}{f}\in \calE^1(X\backslash \Supp D)$.
\end{proposition}

\begin{definition}
	对$a\in \Supp D$, $k=D(a)$，则$f=z^k \cdot \psi$，$\psi(a)\neq 0$.
	$\frac{df}{f}=k\frac{dz}{z}+\frac{d\psi}{\psi}$. 
    则可定义$\int_X\frac{df}{f}\wedge \sigma$，其中$\sigma\in \calE^1(X)$具有紧支集.

	注意到$\frac{d''f}{f}=\frac{d''\psi}{\psi}$，在$a$附近良定且光滑，
    于是$\frac{d''f}{f}\in \calE^{(0,1)}(X)$.
	\end{definition}

\begin{lemma}\label{aaa}
	设$a_1,\cdots,a_n\in X$，$k_1\cdots,k_n\in \Z$，
    设$D=\sum\limits_{j=1}^n k_j\cdot a_j \in \Div(X)$. 
    若$f$为$D$的一个弱解，则$\forall g\in \calE(X)$具紧支集，有
	$$\frac{1}{2\pi i}\int_X \frac{df}{f}\wedge dg
    =\sum_{j=1}^n k_j g(a_j).$$
\end{lemma}

\begin{proof}[引理的证明]
	取坐标$(U_j,z_j)$使得$z_j(a_j)=0$，且在$U_j$上
    $f=z_j^{k_j}\cdot \psi_j$，$\psi_j\in \calE(U_j)$，$\psi_j(a_j)\neq 0$.
	\begin{align*}
		\int_X \frac{df}{f}\wedge dg
        &=-\lim_{\varep \to 0} \int_{X\backslash \bigcup\limits_j \{\vert z_j\vert \leq \varep\} } d(g\cdot \frac{df}{f})\\
		&=\lim_{\varep \to 0} \sum_j \int_{\vert z_j \vert =\varep} g\cdot \frac{df}{f}\\
		&=\lim_{\varep \to 0} \sum_j \int_{\vert z_j \vert =\varep} \left(gk_j\cdot \frac{dz_j}{z_j}+g\cdot \frac{d\psi_j}{\psi_j}\right)\\
		&=2\pi i \sum_j k_jg(a_j).
	\end{align*}
\end{proof}
		
\begin{definition}
	$X$上一个$1$-链指$c=\sum\limits_{j=1}^k n_jc_j$，$n_j\in \Z$，
    $c_j\colon [0,1]\rightarrow X$为分段光滑曲线. 记$C_1(X)$为$X$上$1$-链全体.

	若$\omega\in \calE^1(X)$，则定义
    \[\int_c\omega:=\sum_{j=1}^k n_j \int_{c_j}\omega.\]
    定义上边缘算子$\partial\colon C_1(X) \rightarrow \Div(X)$如下：

	设$c\colon [0,1]\rightarrow X$为一条曲线，若$c(0)=c(1)$，则$\partial c:=0$，否则定义
	$$\partial c(x)=\begin{cases} 1, &x=c(1)\\ -1, &x=c(0)\\ 0, &\text{其余情形}\end{cases}.$$
	一般地，若$c=\sum\limits_{j=1}^k n_jc_j\in C_1(X)$，
    则定义$\partial c:= \sum\limits_{j=1}^k n_j \partial c_j$.
\end{definition}

若$X$是紧Riemann面，$D\in \Div(X)$，$\deg D=0$，
则$D=a_1+a_2+\cdots+a_n-b_1-\cdots-b_n$. 
令$c_j$为连接$a_j,b_j$的一条曲线. 定义$c=c_1+\cdots+c_k$，则$\partial c=D$.

\begin{definition}
	称$Z_1(X):=\Ker \big(C_1(X) \stackrel{\partial}{\longrightarrow} \Div(X)\big)$
    为$X$上一个$1$-循环群.

	对于$c,c'\in Z_1(X)$，定义$c\sim c'$等价于$\int_c \omega=\int_{c'}\omega$，
    对于任意闭的$\omega\in \calE^1(X)$成立.

	称$H_1(X):=Z_1(X)/\sim$为$X$的一阶下同调群.
\end{definition}
		
\begin{theorem}[Abel定理]
	$X$是紧Riemann面，$D\in \Div(X)$，$\deg D=0$. 则$D$有一个解等价于，
    存在$c\in C_1(X)$使得$\partial c=D$且$\int_c\omega=0$
    对于任意$\omega\in \Omega(X)$成立.
\end{theorem}

\begin{proof}[证明概要]
	右推左：Step 1，寻找弱解；Step 2，通过解$d''$方程把弱解调整为强解.
\end{proof}
		
\begin{lemma}\label{weaksolution}
    $X$是Riemann面，$c$是$X$上曲线，$U\supset c$为一个相对紧邻域，
    则存在$\partial c$的弱解$f$，使得
	1. $f|_{X\backslash U}=1$，
    2. $\int_c \omega = \frac{1}{2\pi i} \int_X \frac{df}{f}\wedge \omega$，
    对于任意闭的$\omega\in \calE^1(X)$.
\end{lemma}

\begin{proof}[引理的证明]
	首先设$(U,z)$为一个坐标邻域，使得$z(U)$为单位圆盘，且$c\subset U$. 
    记$a=c(0)$，$b=c(1)$，取$r<1$使得$c\subset \Over{\Delta_r}$. 
    则$\log \frac{z-b}{z-a}$在$\{r<\vert z\vert <1\}$上可取单值支，
    再取$r<r'<1$及$\psi\in C_0^\infty(\Delta_{r'})$，
    $\psi|_{\Over{\Delta_r}}=1$. 定义
	$$f:=\begin{cases} \exp \left(\psi \cdot \log \dfrac{z-b}{z-a}\right), &r<|z|<1\\ \\
    \dfrac{z-b}{z-a}, &|z| \leq r\\ \\1, &X\backslash U\end{cases}.$$
	则$f$为$\partial c$的一个弱解. 设$\omega \in \calE^1(X)$闭，
    由Poincaré引理，存在$g\in \calE(X)$
    使得$\Supp g\subset U$且$\omega=dg$于$\Over{\Delta_{r'}}$.
    （取$r'<r''<1$，则存在$h\in \calE(\Delta_{r''})$使得$dh=\omega$于$\Delta_{r''}$，
    取$\chi\in C^\infty_0(\Delta_{r''})$使得$\chi|_{\Over{\Delta_{r'}}}=1$，
    取$g=\chi\cdot h\in \calE(X)$）.
	
	$$\frac{1}{2\pi i} \int_X \frac{df}{f}\wedge \omega
    =\frac{1}{2\pi i} \int_X \frac{df}{f}\wedge dg = g|_a^b =\int_c dg=\int_c \omega.$$
    （第二个等号由引理\ref{aaa}可得.）
    一般地，取划分$0=t_0<t_1<t_2<\cdots<t_n=1$
    及坐标邻域$(U_j,z_j)$，$1\leq j\leq n$使得

	(i) $c_j:=c|_{[t_{j-1},t_j]} \subset U_j \subset U$.

	(ii) $z_j(U_j)$为单位圆.		
	取$\partial c_j$的弱解$f_j$使得$f_j|_{X\backslash U_j}=1$且
    \[\int_{c_j}\omega =\frac{1}{2\pi i} \int_X \frac{df_j}{f_j}\wedge \omega,\]
    对于任意闭的$\omega\in \calE^1(X)$. 取$f:=f_1\cdots f_n$，
    则$f$为$\partial c$的一个弱解，使得$f|_{X\backslash U}=1$且
	$$\frac{1}{2\pi i} \int_X \frac{df}{f}\wedge \omega
    =\sum_j \frac{1}{2\pi i} \int_X \frac{df_j}{f_j}\wedge \omega 
    =\sum_j \int_{c_j} \omega =\int_c \omega.\qedhere$$
\end{proof}

\begin{proof}
    回到Abel定理，右推左方向. 设$c=\sum\limits_{j=1}^k n_j c_j$，
    由引理\ref{weaksolution}，存在相应于$\partial c_j$的弱解$f_j$使得
    \[\frac{1}{2\pi i} \int_X \frac{df_j}{f_j} \wedge \omega=\int_c \omega,\]
    对于任意闭的$\omega\in \calE^1(X)$.

	令$f:=f_1^{n_1}\cdots f_k^{n_k}$，则$f$为$\partial c$的一个弱解，且
	$$\frac{1}{2\pi i} \int_X \frac{df}{f}\wedge \omega 
    =\sum\limits_j \frac{n_j}{2\pi i} \int_X \frac{df_j}{f_j}\wedge \omega 
    =\sum\limits_j n_j \int_{c_j} \omega=\int_c \omega.$$
	对于$\omega\in \Omega(X)$，则
	$$0=\int_c \omega=\frac{1}{2\pi i} \int_X \frac{df}{f}\wedge \omega
    =\frac{1}{2\pi i} \int_X \frac{d'' f}{f} \wedge \omega.$$
	注意到$\frac{d''f}{f}\in \calE^{(0,1)}(X)$，
    由Hodge理论，存在$g\in \calE(X)$使得$d''g=\frac{d''f}{f}$.

	令$F:=e^{-g}\cdot f$，则$F$也为$D=\partial c$的一个弱解，且在$X_D$上，
	$$d''F=-e^{-g}d''g\cdot f+e^{-g}\cdot d''f=0.$$
	进而$F\in \calO(X_D)$，即$F$是$D$的一个解.
\end{proof}
		
\begin{remark}[Oka原理]
	$M$是复流形，那么对任意$v\in \calE^{(0,1)}(X)$满足$d''v=0$，$d''u=v$均可解.

	那么我们可以提出一个问题，在全纯框架下可解，是否等价于其在拓扑框架下可解？
\end{remark}

\begin{proof}
	Abel定理的左推右方向. 设$f$为$D$的一个解，
    其定义一个分歧覆盖$X\rightarrow \mathbb{P}^1$. 记$a_1,\cdots, a_r$为分歧点全体，
    记$Y=\mathbb{P}^1\backslash \{f(a_1),\cdots,f(a_r)\}
    =\mathbb{P}^1\backslash \{y_1,\cdots,y_s\}$，$s\leq r$.

	对$\omega\in \Omega(X)$，定义push-down $f_*\omega$如下：

	$\forall y\in Y$，存在邻域$V\ni y$，
    使得$f^{-1}(V)=\bigcup\limits_{k=1}^n U_k$，
    $U_k\subset X\backslash \{a_1,\cdots,a_r\}$
    且$f|_{U_k}\colon U_k\rightarrow V$是双全纯映射，
    令$\varphi_k=(f|_{U_k})^{-1}$. 定义
	$$f_*\omega|_V:=\sum\limits_{k=1}^n \varphi_k^*\omega,$$
	其与$V$的选取无关，故$f_*\omega\in \Omega(Y)$.
	
    则有如下的可去奇性：
	\begin{center}
		$f_*\omega$ 可全纯延拓至 $\mathbb{P}^1$ (*)
	\end{center}

	先假设(*)成立，则$f_*\omega\in \Omega(\mathbb{P}^1)$，进而$f_*\omega=0$. 
    取曲线$\gamma\colon [0,1]\rightarrow \mathbb{P}^1$，
    $\gamma(0)=\infty$，$\gamma(1)=0$，$\gamma|_{(0,1)}\subset Y$.
	令$f^{-1}(\gamma)=c_1+\cdots+c_n=:c\in C_1(X)$. 
    其中$c_j$为$X$中连接$f$的极点与零点的曲线，
    则$\partial c=D$，且$\forall \omega\in \Omega(X)$，
    有$\int_c \omega=\sum\limits_{j=1}^n \int_{c_j} \omega=\sum\limits_{j=1}^n \int_{f(c_j)} f_*\omega=\int_{\gamma}f_*\omega=0$.

	接下来我们证明假设(*)成立. 
    不妨设$f^{-1}(y_1)\cap \{a_1,\cdots,a_r\}=\{a_1,\cdots,a_{r'}\}$，$r'\leq r$. 
    记$n_j=\ord_{a_j}f$，不妨设$\varphi_1,\cdots,\varphi_{n_1}$由$a_1$确定. 
    只需证明，$\varphi_1^*\omega+\cdots+\varphi_{n_1}^*\omega$可全纯延拓至$y_1$.

	取$a_1$处坐标$(U,z)$，$y_1$处坐标$(W,\zeta)$，使得$f$可表示为$\zeta\circ f=z^{n_1}$. 
    若$\omega=z^m dz$，$m\in \Z^+$.

	注意到$\varphi_1(\zeta),\cdots,\varphi_{n_1}(\zeta)$
    为多项式$h(z,\zeta):=z^{n_1}-\zeta$的根.
	当$\vert \zeta\vert \ll 1$时，$\vert \varphi_j(\zeta)\vert \ll 1$. 
    取$0<\delta \ll \varep \ll 1,l\in\mathbb{Z^+}$，当$\vert \zeta\vert <\delta$，计算留数
	\begin{align*}
		\sum\limits_{k=1}^{n_1} \varphi_k(\zeta)^l
        &=\frac{1}{2\pi i} \int_{\vert z\vert=\varep} 
        \frac{z^l \partial h(z,\zeta)/\partial z}{h(z,\zeta)} dz\\
		&=\frac{n_1}{2\pi i} \int_{\vert z\vert=\varep} 
        \frac{z^{l+n_1-1}}{z^{n_1}-\zeta}dz\\
		&=\frac{n_1}{2\pi i} \int_{\vert z\vert=\varep} 
        z^{l-1} \sum\limits_{j=0}^\infty (\zeta/z^{n_1})^j dz\in \calO_0.
	\end{align*}
	推出
	\[\sum_{k=1}^{n_1} \varphi_k^*\omega=\sum_{k=1}^{n_1} \varphi_k^md\varphi_k 
    =\frac{1}{m+1} d\left(\sum_{k=1}^{n_1} \varphi_k^{m+1}\right),\]
    可全纯延拓过$\zeta=0$，即$y_1$.

	对于一般的$\omega$，总可写出Taylor展开
    $\omega=\sum\limits_{m=0}^\infty a_m z^m dz$，即得.
\end{proof}

\begin{proposition}
	$\Gamma=\Z \gamma_1+\Z \gamma_2\subset \bbC$为一个格，
    $P=\{t_1\gamma_1+t_2\gamma_2: t_1,t_2\in [0,1)\}$，
    $a_1,\cdots,a_n,b_1,\cdots,b_n\in P$.

	存在$\Gamma$-双周期函数以$a_j$为零点，$b_j$为极点，
    等价于$\sum\limits_{j=1}^n (a_j-b_j)\in \Gamma$.
\end{proposition}

\begin{proof}
	记$\pi\colon\bbC \rightarrow \bbC/\Gamma$是自然投影. 
    记$D=\pi a_1+\cdots+\pi a_n-\pi b_1-\cdots-\pi b_n$，则$\deg D=0$. 
    记$c_j=[a_j,b_j']$是连接$a_j,b_j'$的曲线，$b_j'\in b_j+\Gamma$.

	令$c:=\pi c_1 +\cdots +\pi c_n\in C_1(\bbC/\Gamma)$ 则 $\partial c=D$. 
    设$dz$诱导$\omega\in \Omega(\bbC/\Gamma)$，则
    \[\int_c \omega=\sum_k \int_{c_k} dz=\gamma_c+\sum_k (b_k-a_k),\]
    其中$\gamma_c\in\Gamma$ 与$c$的选取有关，并且当$c$跑遍所有选取时，$\gamma_c$跑遍$\Gamma$.
    则存在$c$使得$\int_c \omega=0$ 等价于$\sum\limits_k (b_k-a_k)\in \Gamma$，之后由Abel定理即证.
\end{proof}

\begin{remark}
	设$\omega_1,\cdots,\omega_g$为$\Omega(X)$的一组基，
    记$c_1,\cdots,c_{2g}$为$H_1(X)$的一组典范基（由拓扑知识可知$\dim H_1(X)=2g$）. 作
    \[\gamma_j=\left( \int_{c_j} \omega_1,\cdots, \int_{c_j} \omega_g\right) \in \bbC^g, \quad 1\leq j\leq 2g.\]

	可以证明，$\Gamma:=\Z \gamma_1+\cdots+\Z \gamma_{2g} 
    \subset \bbC^g \cong \R^{2g}$为一个格，
    进而$J(X):=\bbC^g / \Gamma$为一个$g$维环面，称其为$X$的Abel簇.
	固定$a\in X$，定义映射\[j_x\colon X\rightarrow J(X), \quad 
    x\mapsto \left[\left( \int_a^x \omega_1, \cdots, \int_a^x \omega_g \right)\right],\]
    称为Abel--Jacobi映射.

	当$g\geq 1$时，$j_x$为一个全纯嵌入.		
\end{remark}