\setdisplaytitle{除子与线丛}
\sethtmltitle{除子与线丛}
\section{线丛}
    以下是线丛的一个几何定义：
    \begin{definition}[线丛1（Line Bundle）]
        若$X$是簇，则$X$上的线丛指簇的映射$p\colon L \rightarrow X$，满足
        \begin{enumerate}
            \item[(1)]（局部平凡性（Local Trivialization））
                       存在$X$的开覆盖$\{U_{i}\}$以及态射$\phi_{i}$，
                       使得$\phi_{i}\colon p^{-1}(U_{i}) \rightarrow U_{i} \times \mathbb{A}^{1}$. 
                       换句话说，即下图交换：
                       \begin{tikzcd}
                           p^{-1}(U_{i}) \arrow[rd, "p"] \arrow[r, "\phi_{i}"] & U_{i} \times \mathbb{A}^{1} \arrow[d, "\pi_{i}=\pi_{U_{i}}"] \\
                                                    & U_{i}                                                       
                       \end{tikzcd}
            \item[(2)]（转移函数（Transitive Function））
                       对于上述的$i,j$，态射
                       $\varphi_{i} \circ \varphi_{j}^{-1}\colon U_{ij} \times \mathbb{A}^{1} \rightarrow U_{ij} \times \mathbb{A}^{1};
                       (x,t) \mapsto (x,g_{ij}(x)t)$，其中$U_{ij}=U_{i} \cap U_{j}$， 
                       而$g_{ij}\colon U_{ij} \mapsto \mathbb{A}^{1}\backslash 0$是$U_{ij}$上不取零的态射.
                       称所有$g_{ij}$为转移函数.
        \end{enumerate}
        称$p^{-1}(x)$为$x \in X$处的\textbf{纤维}（Fiber）.
    \end{definition}

    \begin{remark}
        在Čech上同调的意义下，线丛即是$H^{1}(X,O_{X}^{*})$中的元素，
        其中$O_{X}^{*}$是$X$上的可逆函数层.
    \end{remark}

    线丛间也有态射：

    \begin{definition}[线丛的态射]
        若$p\colon L \rightarrow X$与$p'\colon L' \rightarrow X$是$X$上的两个线丛. 
        则称$u\colon L\mapsto L'$是线丛的态射，若$p' = p \circ u$，且$u$在纤维上线性. 
        这里线性的意思是对于开覆盖$\{U_{i}\}$，存在正则函数$h_{i}(x)$
        使得$\phi'_{i} \circ u \circ \phi_{i}^{-1}\colon(x,t) \mapsto (x,h_{i}(x)t)$，
        其中$h_{i}(x)$是纤维上的线性函数.\par
        进一步地，称$L_{1}$与$L_{2}$作为线丛\textbf{同构}，
        若存在态射$v\colon L_{2} \rightarrow L_{1}$，
        使得$u \circ v = \operatorname{id}_{L_{2}}$且$v \circ u = \operatorname{id}_{L_{1}}$.
    \end{definition}

    \begin{definition}[截面（Section）]
        对于线丛$p\colon L \rightarrow X$，其上的一个\textbf{截面}指的是一个簇的态射
        $s\colon X \rightarrow L$使得$p \circ s = \operatorname{id}_{X}$.
    \end{definition}

    \begin{example}[零截面]
        即$s_{0}\colon x \mapsto \varphi^{-1}(x,0)$. 这是$X$至$L$的自然嵌入.
    \end{example}

    
    \begin{example}
        定义$\mathbb{P}^{n}$上的典范丛$\mathcal{O}_{\mathbb{P}^{n}}(-1)$如下：\par
        令$L:=\{(x,v)\in\mathbb{P}^{n}\times\mathbb{A}^{n+1} \mid v \in \mathcal{C}x\}$，
        其中$\mathcal{C}x$为其仿射锥.
        这是$\mathbb{P}^{n} \times \mathbb{A}^{n+1}$的闭子集.
        令$U_{i}$为$\mathbb{P}^{n}$的标准开集，$p\colon L \rightarrow \mathbb{P}^{n};(x,v) \mapsto x$为投影.
        那么$U_{i}$即为局部平凡化，即
        \begin{cd}
            p^{-1}(U_{i}) \ar[r,"\varphi_{i}"] \ar[rd] & U_{i} \times \mathbb{A}^{1} \ar[d] &  & {(x_{0},\cdots,x_{i},\cdots,x_{n}) \times v} \ar[r, maps to] \ar[rd, maps to] & {\big(\frac{x_{0}}{x_{i}},\cdots,\frac{x_{i-1}}{x_{i}},\frac{x_{i+1}}{x_{i}},\cdots,\frac{x_{n}}{x_{i}}\big) \times v_{i}} \ar[d, maps to] \\
                                   & U_{i}                                 &  &                                                                                     & {\big(\frac{x_{0}}{x_{i}},\cdots,\frac{x_{i-1}}{x_{i}},\frac{x_{i+1}}{x_{i}},\cdots,\frac{x_{n}}{x_{i}}\big)}                                 \\                                    &                                                                                                                                      
        \end{cd}
        其中$v=v_{i}\big(\frac{x_{0}}{x_{i}},\cdots,\frac{x_{i-1}}{x_{i}},\frac{x_{i+1}}{x_{i}},\cdots,\frac{x_{n}}{x_{i}}\big)$.
        而坐标转换即$g_{ij}\colon U_{ij} \rightarrow k^{*};(x_{0},\cdots,x_{n}) \mapsto \frac{x_{i}}{x_{j}}$.
    \end{example}

    我们也可以代数地定义线丛：
    \begin{definition}[线丛2]
        簇$X$上的线丛指如下资料：
        \begin{enumerate}
            \item[(1)] 簇$X$的一族开覆盖$\{U_{i}\}_{i \in I}$.
            \item[(2)] 一族正则函数$\{g_{ij}\colon U_{ij} \rightarrow k^{*}\}_{i,j \in I}$，
                       其中$U_{ij}=U_{i} \cap U_{j}$.
            \item[(3)] 这些正则函数满足$g_{ii}=1$，$g_{ij}g_{jk}g_{ki}=1$. 
                       这称为\textbf{上闭链条件}.
        \end{enumerate}
        记线丛为$\{(U_{i},g_{ij})\}$.
    \end{definition}

    \begin{remark}
        上述资料可以复刻出一个线丛来：\par
        令$L:=\coprod_{i \in I}(U_{i} \times \mathbb{A}^{1})/\sim$，
        其中对于$x \in U_{ij}$，规定$(x,t) \sim (x,g_{ij}(x)t)$. 
        令$p\colon L \rightarrow X$是自然投影，则$L$在诸$U_{i}$上是局部平凡化，
        且转移函数为$g_{ij}$.
    \end{remark}

    \begin{remark}
        我们可以定义线丛$L=\{(U_{i},g_{ij})\}$与$L'=\{(U_{i'},g_{i'j'})\}$
        同构\textbf{当且仅当}存在
        $s_{ii'}\colon U_{i} \cap U_{i'} \rightarrow k^{*}$
        使得$g_{i'j'}s_{ii'}=g_{ij}s_{jj'}$. 其中这里是乘法而非复合.
    \end{remark}

    我们可以定义线丛的乘法为转移函数的乘法. 
    令线丛$L=\{(U_{i},g_{ij})\}$与$L'=\{(U_{i},g_{ij}')\}$. 
    这里，对于两个不同的线丛，我们可以对覆盖加细，使得$L$与$L'$具有相同覆盖，则定义
    $L \otimes L'=\{(U_{i},g_{ij}g_{ij}')\}$. 

    \begin{proposition}[Picard群]
        簇$X$上的全体线丛在乘法运算下构成一个群. 记该群为$\operatorname{Pic}(X)$.
    \end{proposition}
    \begin{proof}
        单位元为平凡丛$X \times \mathbb{A}^{1}$，也即所有$g_{ij}=1$.
        而线丛$(U_{i},g_{ij})$逆元定义为$(U_{i},g_{ij}^{-1})$.
    \end{proof}

    \begin{example}
        射影空间$\mathbb{P}^{n}$上的典范线丛$\mathcal{O}_{\mathbb{P}^{n}}(-1)$
        事实上即$(U_{i},g_{ij})$，其中
        $g_{ij}=\frac{x_{i}}{x_{j}}$. 这样的线丛在乘法下生成一个循环群
        $\{\mathcal{O}_{\mathbb{P}^{n}}(d)\}$，
        其中$\mathcal{O}_{\mathbb{P}^{n}}(d)$中的转移函数
        $g_{ij}=\big(\frac{x_{j}}{x_{i}}\big)^{d}$.
    \end{example}

\section{除子与除子类群}
    这里只考虑$X$是不可约拟射影簇的情形. 我们将要引入两种重要的除子，
    即Weil除子与Cartier除子. \par

    以下是一个惯用语：我们称$X$是\textbf{余维一光滑}的，
    若$\dim\operatorname{sing}(X) \leq \dim X - 2$.
    这个条件将允许我们在余维一的子簇上取光滑点. 有不少簇满足余维一光滑的性质，诸如
    正规簇. 在以下讨论中，我们都假定$X$余维一光滑.

    \begin{definition}[$\Z$系数Weil除子（Weil Divisor）]
        称形式有限和$\sum_{i}a_{i}Y_{i}$为Weil除子，
        其中$Y_{i}$都是余维一子簇，
        而$a_{i} \in \Z$.
    \end{definition}

    \begin{definition}[Cartier除子（Cartier Divisor）]
        对于簇$X$，称数据$\{(U_{i},f_{i})\}$为$X$上的Cartier除子，
        若$\{U_{i}\}$是$X$的开覆盖，而$f_{i}$是$U_{i} \dashrightarrow k$的处处非零有理函数. \par
        经过覆盖加细后，称两个Cartier除子
        $D=\{(U_{i},f_{i})\}$与$D'=\{(U_{i},g_{i})\}$是\textbf{相容的}，
        若$\frac{f_{i}}{f_{j}}$在$U_{i} \cap U_{j}$上是正则函数. 
        定义两个Cartier除子等价当且仅当它们正则.
    \end{definition}

    Cartier除子全体在加法$\{(U_{i},f_{i})\} + \{(U_{i},g_{i})\} = \{(U_{i},f_{i}g_{i})\}$
    与取逆$-\{(U_{i},f_{i})\}=\{(U_{i},f_{i}^{-1})\}$下构成一个群，
    记作$\operatorname{Cartier}(X)$. 
    称一个Cartier除子$D$为主除子，若$D=\{(X,f)\}$. 

    在$\operatorname{Cartier}(X)$与$\operatorname{Pic}(X)$间，我们可以定义群同态.
    \begin{equation*}\begin{aligned}
        \Phi\colon\operatorname{Cartier}(X) &\longrightarrow \operatorname{Pic}(X); \\
        \{(U_{i},f_{i})\} &\longmapsto \{(U_{i},g_{ij}=\frac{f_{i}}{f_{j}}).\}
    \end{aligned}\end{equation*}

    这时，$\Phi(D_{1}+D_{2})=\Phi(D_{1}) \otimes \Phi(D_{2})$，故这是一个群同态.

    我们有如下命题：
    \begin{theorem}
        若$X$是不可约拟射影簇，则上述映射$\Phi$诱导了群同构
        $\operatorname{Cartier}(X)/\operatorname{p.Cartier}(X) \cong \operatorname{Pic}(X)$.
        其中$\operatorname{p.Cartier}(X)$即全体主除子构成的子群.
    \end{theorem}
    \begin{proof}
        首先，我们验证$\ker \Phi = \operatorname{p.Cartier}(X)$.
        若$\Phi(D)=1$，则$\Phi(D)$存在处处非零的整体截面
        $s=\{(U_{i},s_{i})\mid s_{i}\colon U_{i} \rightarrow k^{*}\text{ 正则}\}$.
        加之$s_{i}=g_{ij}s_{j}=\frac{f_{i}}{f_{j}}s_{j}$，
        我们有$\frac{s_{i}}{f_{i}}$为一个固定的函数，
        记为$F$. 那么$D=\{(U_{i},F)\}=\{(X,F)\}$. 
        而显然有$\operatorname{p.Cartier}(X) \subset \ker \Phi$，
        故$\ker \Phi = \operatorname{p.Cartier}(X)$. \par
        再证$\Phi$满. 而对于任一线丛$L=\{(U_{i},g_{ij})\}$，可固定一个开集$U_{i_{0}}$，
        则由不可约性，$U_{i} \cap U_{i_{0}} \neq \varnothing$，
        且$g_{ii_{0}}\colon U_{i} \cap U_{i_{0}} \rightarrow k^{*}$是处处非零正则函数.
        令$D=\{(U_{i},g_{ii_{0}})\}$，则$\Phi(D)=L$.
    \end{proof}

    后文记$\operatorname{Cartier}(X)/\operatorname{p.Cartier}(X)$
    为$\operatorname{CaCl}(X)$. 下面我们计算一些除子类群的例子
    
    \begin{example}
        仿射空间$\mathbb{A}^{n}$. \par
        由于这是个不可约光滑簇，故$\operatorname{Pic}(\mathbb{A}^{n})=\operatorname{Cl}(\mathbb{A}^{n})$.
        而$\mathbb{A}^{n}$中的所有超曲面都由一个多项式定义. 
        故对于任意超曲面$Y \subset \mathbb{A}^{n}$，$Y$代表一个主Weil除子.
        故$\operatorname{Pic}(\mathbb{A}^{n})=\operatorname{Cl}(\mathbb{A}^{n})=0$.

        事实上，若$X$是一个正规仿射代数簇，
        则$\operatorname{Cl}(X)=0$当且仅当$A(X)$是一个UFD.
    \end{example}

    \begin{example}
        射影空间$\mathbb{P}^{n}$. \par
        这也是一个不可约光滑簇，故$\operatorname{Pic}(\mathbb{P}^{n})=\operatorname{Cl}(\mathbb{P}^{n})$.
        令$H_{0}=\{X_{0}=0\}$. 由于$\mathbb{P}^{n}$中的任一超曲面$H$
        由一个$d$次齐次多项式定义，那么考虑$H$上的有理函数$\frac{F}{X_{0}^{d}}$，
        则$H - dH_{0} = \operatorname{div}(\frac{F}{X_{0}^{d}})$.
        故$\operatorname{Cl}(\mathbb{P}^{n})$由$H_{0}$生成，故而有满同态
        \begin{equation*}\begin{aligned}
            \phi\colon\Z &\longrightarrow \operatorname{\mathbb{P}}^{n};\\d &\longmapsto dH_{0}.
        \end{aligned}\end{equation*}
        我们只需证明$\ker\phi=0$即可. 
        否则$\ker\phi = \left<d_{0}\right>$，其中$d_{0}>0$. 
        那么$d_{0}H_{0} \sim 0$当且仅当$\mathcal{L}(d_{0}H_{0})$平凡.
        但视$H_{0}=\{(U_{i},\frac{X_{0}}{X_{1}})\}$为Cartier除子，其中$U_{i}$是标准开集，我们有
        $\mathcal{L}(H_{0})=\{(U_{i},\frac{X_{j}}{X_{i}})\}=\mathcal{O}_{\mathbb{P}^{n}}(1)$.
        且$\bigotimes_{i=1}^{d}\mathcal{O}_{\mathbb{P}^{n}}(1)=\mathcal{O}_{\mathbb{P}^{n}}(d)$.
        故这意味着$\mathcal{O}_{\mathbb{P}^{n}}(d_{0})$平凡，矛盾！

        上述过程即是说$\operatorname{Pic}(\mathbb{P}^{n})=\operatorname{Cl}(\mathbb{P}^{n})=\Z$.
    \end{example}

    \begin{example}
        在射影空间$\mathbb{P}^{n}$中切除一个$d$次超曲面$H$. \par
        记$X = \mathbb{P}^{n}-H$，$H = \mathcal{V}(F)$，
        我们可以注意到$X$中的超平面都由$\mathbb{P}^{n}$中的超平面限制而来. 故有如下满同态
        \begin{cd}
            \operatorname{Cl}(\mathbb{P}^{n}) \ar[r,"\varphi"] & \operatorname{Cl}(X) \ar[r] & 0 \\
            Y \ar[r, maps to]                        & Y \cap X                       &  
        \end{cd}
        故$\operatorname{Cl}(X)$必形如$\Z/l\Z$，其中$l$是一个整数.
        考虑$\operatorname{Cl}(\mathbb{P}^{n})$的生成元$H_{0}$，

        考虑Venerose映射$v_{d}\colon\mathbb{P}^{n} \rightarrow \mathbb{P}^{{n+d \choose d}-1}$. 
        那么$v_{d}(H)$无非是一些$\{X_{j}=0\}$的交，从而$X$是代数簇（由$v_{d}$单），
        且$A(X)=\{\frac{G}{F^{m}}\mid G\text{ 为 }md\text{ 次齐次多项式}\}=k[X]_{F}$.
        若$lH_{0} \in \ker\varphi$，则存在$m \in \N$
        使得$\frac{X_{0}^{k}}{F^{m}} \in A(X)$. 这意味着$k=md$.

        而考虑除子$dH_{0}$，则由于$dH_{0} = \operatorname{div}(\frac{X_{0}^{d}}{F})$，
        故$dH_{0} \in \ker\varphi$.
        这意味着$\ker\varphi = d\Z$，从而$\operatorname{Cl}(X)=\Z/d\Z$.
    \end{example}

    \begin{example}
        射影空间的乘积簇$\mathbb{P}^{m} \times \mathbb{P}^{n}$. 
        
        与射影空间的情形类似，在$\mathbb{P}^{m}$中取$H_{1}=\{X_{0}=0\}$，
        在$\mathbb{P}^{n}$中取同样定义的超平面$H_{2}=\{Y_{0}=0\}$. 
        记$Z_{1}=H_{1} \times \mathbb{P}^{n}$，$Z_{2}=\mathbb{P}^{n} \times H_{2}$，
        由于$\mathbb{P}^{m} \times \mathbb{P}^{n}$中超曲面由
        一个双齐次多项式$F$定义，并记次数为$(d,e)$，
        （由Segre嵌入，这仍是一个射影簇，
        我们可以用$\mathbb{P}^{mn+m+n}$中的超平面拉回至
        $\mathbb{P}^{m} \times \mathbb{P}^{n}$上）
        则$H$上有有理函数$\frac{F}{X_{0}^{d}Y_{0}^{e}}$，
        故$H-dZ_{1}-eZ_{2}=\operatorname{div}(\frac{F}{X_{0}^{d}Y_{0}^{e}})$.
        这意味着$\operatorname{Cl}(\mathbb{P}^{m}\times\mathbb{P}^{n})$
        由$Z_{1}$与$Z_{2}$生成，从而可以定义满同态
        \begin{equation*}\begin{aligned}
            \phi\colon\Z^{2} &\longrightarrow \operatorname{Cl}(\mathbb{P}^{m}\times\mathbb{P}^{n});
            \\(d,e) &\longmapsto dZ_{1}+eZ_{2}.
        \end{aligned}\end{equation*}
        由于$\ker \phi$形如$d_{1}\Z \oplus d_{2}\Z$，
        故$\mathcal{L}(d_{1}H_{1}+d_{2}H_{2})=
        \{(U_{i} \times V_{j},\big(\frac{X_{k}}{X_{i}}\big)^{d_{1}}\big(\frac{Y_{l}}{Y_{j}}\big)^{d_{2}}\}$平凡.
        这意味着$d_{1}=d_{2}=0$，即映射$\phi$单.
        故$\operatorname{Cl}(\mathbb{P}^{m}\times\mathbb{P}^{n}) = \Z^{2}$.

        更一般地，可以证明$\operatorname{Cl}(\mathbb{P}^{k_{1}}\times\cdots\times\mathbb{P}^{k_{m}})=\Z^{m}$.
    \end{example}

    \begin{example}
        二次锥面$C = \mathcal{V}(XY-Z^{2}) \subset \mathbb{A}^{2}$. \par
        这是一个不可约正规簇，且唯一奇点为$(0,0,0)$.
    \end{example}