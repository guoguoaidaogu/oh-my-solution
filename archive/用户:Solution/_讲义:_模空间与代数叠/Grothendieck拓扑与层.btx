\subsection{例子}

\section{代数空间}
\begin{definition}
    对于概形$S$与俯范畴$\sch{S}$上的一种Grothendieck拓扑$\tau$，
    \textbf{$S$-空间}是指$(\sch{S})_{\tau}$上的一个层.
\end{definition}

$S$-空间的态射即层的态射.

\begin{example}[概形视作层]
    
\end{example}

\begin{definition}
    对于概形$S$，其上的\textbf{代数空间}$\mathcal{X}$指的是
    $(\sch{S})_{\et}$上满足如下两个条件的层：
    \begin{itemize}
        \item[(1)] 
        对于任意两个概形$X,Y$以及$S$-空间态射$s:X \to \mathcal{X}$与
        $y:Y \to \mathcal{X}$，层$X \times_{\mathcal{X}} Y$可被概形表出；

        \item[(2)]
        存在一个概形$U$以及一个平展满射$p:U to \mathcal{X}$，即对于
        任何概形$Y$，$U \times_{\mathcal{X}} Y \to Y$是概形间的平展满射.
        该态射$P:U \to \mathcal{X}$成为\textbf{坐标卡}.
    \end{itemize}
\end{definition}