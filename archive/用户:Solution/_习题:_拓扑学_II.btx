\coordinate (L1) at (0,0);\coordinate (L2) at (0,2.9);\coordinate (R1) at (3.4,0);\coordinate (R2) at (3.4,2.9);\coordinate (C0) at (1.7,1.45);
\draw (L1)--(L2);\draw (R1)--(R2);\draw (L2)--(C0)--(R2);\draw (L1)--(C0)--(R1);
\fill (L1) circle (0.9pt);\fill (L2) circle (0.9pt);\fill (R1) circle (0.9pt);\fill (R2) circle (0.9pt);\fill (C0) circle (0.9pt);
