\item (243.12)\quad设 $\sigma = (a_0, \cdots, a_p)$ 和 $\tau = (b_0, \cdots, b_q)$ 是 $\mathbb{R}^n$ 中两个单形, 
如果 $p+q+2$ 个点 $\{a_0, \cdots, a_p, b_0, \cdots, b_q\}$ 几何独立, 则称它们可统联, 
它们的统联是 $p+q+1$ 维单形 $\sigma * \tau = (a_0, \cdots, a_p, b_0, \cdots, b_q)$. 
如果 $K$ 中任意单形 $\sigma$ 和 $L$ 中任意单形 $\tau$ 可统联, 且对任意 $\sigma, \sigma' \in K, \tau, \tau' \in L$, 
有 $\sigma * \tau \cap \sigma' * \tau' = (\sigma \cap \sigma') * (\tau \cap \tau')$, 
则称 $\mathbb{R}^n$ 中两个复形 $K$ 和 $L$ 为可统联的. $K$ 和 $L$ 的统联是下述复形:
\[
K * L = K \cup L \cup \{\sigma * \tau \mid \sigma \in K, \tau \in L\}.
\]
\begin{proofc}[解答]
\begin{enumerate}[label=(\arabic*)]
 \item 先说明：$(a_0, \dots, a_k, b_0, \dots, b_{p-1-k}) \neq (a'_0, \dots, a'_{k'}, b'_0, \dots, b'_{p-1-k'})$.
    若不然,则 $k=k'$ 且 $a_i=a'_i, b_i=b'_i$.
    反证相等,则顶点一一重合.不妨设 $k \geqslant k'$.
    由于 $(a_0, \dots, a_k)$ 与 $(b'_0, \dots, b'_{p-1-k'})$ 可统联,故点数互异.从而 $k=k'$.
    $(a_0, \dots, a_k)$ 两两不同.
    故 $K$ 中的 $p$ 维单形, $L$ 中的 $p$ 维单形, $\{\sigma * \tau \mid \sigma \in K, \tau \in L\}$ 中的 $p$ 维单形,三者两两不同.
    故 \[d_p(K*L) = d_p(K) + \sum_{q=0}^{p-1} d_{p-q-1}(K) d_q(L) + d_p(L).\]

    \item $\tau * \sigma = \langle b_0, \dots, b_q, a_0, \dots, a_p \rangle$.
    交换为 $\langle a_0, \dots, a_p, b_0, \dots, b_q \rangle$ 需历 $(p+1)(q+1)$ 次.
    故 $\sigma * \tau = (-1)^{(p+1)(q+1)} \tau * \sigma$.

    \item 此时,由于 $K \cup L \cup \{\sigma * \tau \mid \sigma \in K, \tau \in L\}$ 与 $M$ 可统联,故 $K$ 与 $M$ 可统联.
    同 (1) 知：$(K*L)*M$ 的 $p$ 维单形为 $(a_0, \dots, a_{k_1}, b_0, \dots, b_{k_2}, c_0, \dots, c_{k_3})$.
    与 $K*(L*M)$ 相同.
    故 $(K*L)*M = K*(L*M)$.\qedhere
\end{enumerate}
\end{proofc}
\end{enumerate}

\section{第二周作业及解答}
\begin{enumerate}
\item(243.13) 设$K$是复形, $\sigma \in K$, $\sigma$的环绕复形定义为
\[L_k(\sigma)=\{\tau \in K\mid\sigma*\tau \in K\}.\]
\begin{itemize}

    \item[(1)] 验证 $L_k(\sigma)$ 是 $K$ 的子复形;
    \begin{center}
        \begin{tikzpicture}
            % 定义四个顶点坐标,左边顶点命名为 L
            \coordinate (T) at (0, 1.2); % Top
            \coordinate (B) at (0, -1.2); % Bottom
            \coordinate (R) at (2, 0);   % Right
            \node[circle, fill, inner sep=1.2pt, label=left:{$a_0$}] (L) at (-2, 0) {}; % Left
            % 用斜线图案填充左边的三角形 (τ)
            \fill[pattern=north east lines,color=lightgray] (L.center) -- (T) -- (B) -- cycle;
            \draw (L.center) -- (T) -- (R) -- (B) -- cycle;
            \draw (T) -- (B);
            % 在两个三角形内部添加标签
            \node at (-1, 0) {$\tau$};
            \node at (1, 0) {$\sigma$};
        \end{tikzpicture}
    \end{center}
    
    \item[(2)] 对上图所给的 $2$ 维复形, 求 $L_k(\sigma)$, $L_k(\tau)$ 和 $L_k(a_0)$.
    
\end{itemize}
\begin{proofc}[解答]
\begin{itemize}
    \item[(1)] 已知 $L_k(\sigma) \subset K$.故只需证 $L_k(\sigma)$ 为复形.
    
    设 $\tau \in L_k(\sigma)$, 即 $\sigma * \tau \in K$.设 $\tau'$ 是 $\tau$ 的任一面.
    由于 $\sigma * \tau'$ 是 $\sigma * \tau$ 的一个面, 且 $\sigma * \tau \in K$, 而 $K$ 是复形, 故 $\sigma * \tau' \in K$.
    根据定义, $\tau' \in L_k(\sigma)$.
    
    设 $\tau_1, \tau_2 \in L_k(\sigma)$.因 $L_k(\sigma) \subset K$ 且 $K$ 是复形, 故 $\tau_1 \cap \tau_2$ 是 $\tau_1$ 和 $\tau_2$ 的公共面（或为空集）.
    
    故 $L_k(\sigma)$ 为 $K$ 的子复形.

    \item[(2)] 
    \begin{center}
        \begin{tikzpicture}
            % 定义顶点
            \coordinate (a1) at (0, 1.2);
            \coordinate (a2) at (0, -1.2);
            \coordinate (a3) at (2, 0);
            \node[label=left:{$a_0$}] (a0) at (-2, 0) {};
            % 绘制外框和分割线
            \draw (a0.center) -- (a1) -- (a3) -- (a2) -- cycle;
            \draw (a1) -- (a2);
            % 添加标签
            \node at (-1, 0) {$\tau$};
            \node at (1, 0) {$\sigma$};
            % 添加顶点名称
            \node[above] at (a1) {$a_1$};
            \node[below] at (a2) {$a_2$};
            \node[right] at (a3) {$a_3$};
        \end{tikzpicture}
    \end{center}
    
    $K = \{ a_0, a_1, a_2, a_3, (a_0, a_1), (a_0, a_2), (a_1, a_3), (a_2, a_3), (a_1, a_2), (a_0, a_1, a_2), (a_1, a_2, a_3) \}$
    
    可与 $\sigma$ 统联的单形有 $a_0$, 且统联 $\in K$.故 $L_k(\sigma) = \{a_0\}$.
    
    可与 $\tau$ 统联的单形为空.故 $L_k(\tau) = \emptyset$.
    
    可与 $a_0$ 统联的单形有 $a_1, a_2, \sigma, (a_1, a_2), (a_1, a_3), \dots$\qedhere
\end{itemize}

\end{proofc}
\end{enumerate}

\begin{enumerate}
\item(243.15)给出 $\mathbb{R}^4$ 中单纯复形 $K$ 和 $L$, 使得 $|K| \cong P^2$, $|L|$ 和 Klein 瓶同胚.

\begin{proofc}[解答]
$K$的构造:我们在四维欧几里得空间 $\mathbb{R}^4$ 中定义6个顶点：\par
\begin{itemize}
    \item $v_1 = (1, 0, 0, 0)$
    \item $v_2 = (0, 1, 0, 0)$
    \item $v_3 = (0, 0, 1, 0)$
    \item $v_4 = (0, 0, 0, 1)$
    \item $v_5 = (1, 1, 0, 0)$
    \item $v_6 = (0, 0, 1, 1)$
\end{itemize}
$K$ 的结构由它的10个二维单纯形(三角形)完全确定.这10个三角形是：

$K_2 =\{
(v_1, v_2, v_3),  (v_1, v_2, v_4),  (v_1, v_3, v_5),  (v_1, v_4, v_6),  (v_1, v_5, v_6), \\
(v_2, v_3, v_6),  (v_2, v_4, v_5),  (v_2, v_5, v_6),  (v_3, v_4, v_5),  (v_3, v_4, v_6)
\}$


$L$的构造:\begin{itemize}
    \item $v_1 = (1, 0, 1, 0)$
    \item $v_2 = (1, 0, 0, 1)$
    \item $v_3 = (1, 0, -1, 0)$
    \item $v_4 = (0, 1, 1, 0)$
    \item $v_5 = (0, 1, 0, 1)$
    \item $v_6 = (0, 1, -1, 0)$
    \item $v_7 = (-1, 0, 1, 0)$
    \item $v_8 = (-1, 0, 0, 1)$
    \item $v_9 = (-1, 0, -1, 0)$
\end{itemize}
$L$ 的结构由它的18个二维单纯形(三角形)完全确定.这18个三角形是：\\
$L_2 =\{(v_1, v_2, v_4),(v_2, v_5, v_4),(v_2, v_3, v_5),(v_3, v_6, v_5),(v_3, v_1, v_6),  (v_1, v_4, v_6),\\
(v_4, v_5, v_7),(v_5, v_8, v_7),(v_5, v_6, v_8),(v_6, v_9, v_8),  (v_6, v_4, v_9),  (v_4, v_7, v_9),\\
(v_7, v_8, v_1),(v_8, v_2, v_1),(v_8, v_9, v_2),(v_9, v_3, v_2),  (v_9, v_7, v_3),  (v_7, v_1, v_3)\}$

\end{proofc}

\end{enumerate}

\section{第三周作业及解答}
\begin{enumerate}
\item(243.19)\quad给出 Möbius 带和 Klein 瓶的剖分, 计算其同调群.
\begin{proofc}[解答]


\begin{center}
\begin{tikzpicture}[scale=1.5]
    \node (a0) at (0,0) {$a_0$}; \node (a1) at (1,0) {$a_1$}; \node (a2) at (2,0) {$a_2$}; \node (a3) at (3,0) {$a_3$};
    \node (a4) at (0,1) {$a_4$}; \node (a5) at (1,1) {$a_5$}; \node (a6) at (2,1) {$a_6$}; \node (a7) at (3,1) ($a_7$);
    \node (a8) at (0,2) {$a_3$}; \node (a9) at (1,2) {$a_2$}; \node (b) at (3,2) {$a_1$}; \node (c) at (4,2) {$a_1$};
\end{tikzpicture}
\end{center}

当 $n<0$ 或 $n \geqslant 2$ 时, $H_n = 0$.
由于 Möbius 带连续, 故 $H_0 = \mathbb{Z}$.

对 $\forall \sigma \in Z_2$, 设
\[
\begin{aligned}
\sigma = & \ g_1 \langle a_1, a_5, a_4 \rangle + g_2 \langle a_2, a_4, a_5 \rangle + g_3 \langle a_1, a_2, a_5 \rangle \\
         & + g_4 \langle a_1, a_6, a_5 \rangle + g_5 \langle a_1, a_2, a_6 \rangle + g_6 \langle a_0, a_6, a_7 \rangle \\
         & + g_7 \langle a_0, a_5, a_4 \rangle + g_8 \langle a_0, a_6, a_5 \rangle + g_9 \langle a_5, a_1, a_6 \rangle \\
         & + g_{10} \langle a_1, a_6, a_0 \rangle + g_{11} \langle a_6, a_2, a_7 \rangle + g_{12} \langle a_2, a_7, a_3 \rangle
\end{aligned}
\]
可知 $g_1=g_2=\dots=g_{12}=g$.
由于 $\langle a_0, a_4 \rangle$ 只属于 $\langle a_0, a_1, a_4 \rangle$, 故 $\partial\sigma=0 \Rightarrow g=0$.即 $Z_2=0$.
故 $H_2=0$.

设 $\sigma \in Z_1$.
若 $\sigma$ 中含有 $\langle a_1, a_4 \rangle$, 则 $\exists g \in \mathbb{Z}, \text{s.t.} \sigma - g \cdot \partial \langle a_1, a_4, a_0 \rangle = \sigma_1$, $\sigma_1$ 中不含 $\langle a_1, a_4 \rangle$.
同理, $\partial[\langle a_2, a_5, a_4 \rangle + \langle a_3, a_6, a_5 \rangle]$ 为 $\partial$ 的边链的组合.
故 $\exists \sigma'' \text{s.t.} \sigma - \partial \sigma' = \sigma''$, $\sigma''$ 中不含 $\langle a_i, a_j \rangle$.

故 $\partial^3 \sigma'' = g_1 \langle a_3, a_4 \rangle + g_2 \langle a_4, a_0 \rangle + g_3 \langle a_0, a_2 \rangle + g_4 \langle a_2, a_5 \rangle + g_5 \langle a_5, a_6 \rangle + g_6 \langle a_6, a_3 \rangle + g_7 \langle a_6, a_7 \rangle + g_8 \langle a_0, a_7 \rangle + g_9 \langle a_1, a_0 \rangle + g_{10} \langle a_2, a_1 \rangle$.

考虑 $a_5, a_6$, 故 $g_5 = g_4 = x$.
考虑 $a_1, a_2$, 故 $g_8 = g_9 = g_{10} = y$.
考虑 $a_2, a_0, a_4, a_7$, 有 $g_1-g_4-g_{10}=0, g_8-g_2-g_3=0, g_2-g_1+g_5=0, g_4-g_3-g_7=0$.
即 $y-g_2=y, g_2-g_3=y, g_4-g_2=x, g_4-g_3-g_7=0$.

考虑 $\langle a_4, a_5 \rangle + \langle a_5, a_6 \rangle + \langle a_6, a_3 \rangle + \langle a_3, a_7 \rangle + \langle a_7, a_0 \rangle + \langle a_0, a_4 \rangle \sim 0$.
故 $\sigma''' \sim \sigma'' \text{ s.t. } S_1\langle a_1, a_4 \rangle + S_2\langle a_2, a_5 \rangle + S_3\langle a_3, a_6 \rangle + S_5\langle a_0, a_4 \rangle + S_6\langle a_1, a_2 \rangle + S_7\langle a_2, a_3 \rangle$.
从而 $S_3=S_4, S_1=S_2, \dots, S_6=S_7+S_5$.
从而 $\partial \sigma''' \sim (S_4+S_5)\langle a_0, a_4 \rangle + \langle a_0, a_7 \rangle + (S_5-2S_7)\langle a_0, a_7 \rangle + \dots$
$\dots = (2S_4+S_5)(\langle a_0, a_7 \rangle + \langle a_7, a_3 \rangle - \langle a_0, a_1 \rangle - \langle a_1, a_2 \rangle - \langle a_2, a_3 \rangle)$.
故 $\forall \sigma \in Z_1$, 均有 $\sigma \sim \eta Z_1$.故 $Z_1/B_1 = H_1 \cong \mathbb{Z}$.

% ===== 内容分割: 克莱因瓶 =====

\begin{center}
\begin{tikzpicture}[scale=1.5]
    \node (a0) at (0,0) {$a_0$}; \node (a1) at (1,0) {$a_1$}; \node (a2) at (2,0) {$a_2$};
    \node (a3) at (0,1) {$a_3$}; \node (a4) at (1,1) {$a_4$}; \node (a5) at (2,1) {$a_5$};
    \node (a6) at (0,2) {$a_6$}; \node (a7) at (1,2) {$a_7$}; \node (a8) at (2,2) {$a_8$};
    \draw[step=1.0,black,thin] (0,0) grid (2,2);
    \draw (0,0)--(1,1)--(2,2); \draw (0,1)--(1,2); \draw (1,0)--(2,1); \draw (0,1)--(1,0);
    \draw (1,1)--(2,0); \draw (0,2)--(1,1); \draw (1,2)--(2,1);
\end{tikzpicture}
\end{center}

对 $n<0$ 或 $n \ge 2$, 有 $H_n = 0$.
$\forall \sigma \in Z_2$, 设 $\sigma=g_1 \langle a_0, a_4, a_5 \rangle + g_2 \langle a_0, a_1, a_4 \rangle + \dots$
可知每个1-单纯形均作为两个2-单纯形的边.考虑 $\langle a_0, a_4 \rangle$, 知 $g_1=-g_6$.
故均为0, 故 $H_2=0$.

$\forall \sigma \in Z_1$, 同Mobius, $\sigma$ 不含纯内边的组合, 从 $\sigma \sim \sigma'$.
故 $\sigma \sim \sigma''$, $\sigma''$ 只由边界的边组成.
设 $\sigma'' = g_1 \langle a_0, a_1 \rangle + g_2 \langle a_1, a_2 \rangle + g_3 \langle a_2, a_0 \rangle + g_4 \langle a_0, a_3 \rangle + g_5 \langle a_3, a_4 \rangle + g_6 \langle a_4, a_0 \rangle$.
$\partial \sigma''=0$, 故 $g_1=g_2, g_1=g_3$.$g_4=g_5, g_4=g_6$.
即 $\sigma'' = g_1 [ \langle a_0, a_1 \rangle + \langle a_1, a_2 \rangle + \langle a_2, a_0 \rangle ] + g_4 [ \langle a_0, a_3 \rangle + \langle a_3, a_4 \rangle + \langle a_4, a_0 \rangle ]$.
定义为 $g_1 w_1 + g_4 w_2$.
$w_1$ 为2倍环路, $w_2$ 为标准环路.
故 $H_1 \cong \{\pm 1\} \oplus \mathbb{Z}$.
\end{proofc}

\item(244.20)\quad给出上面图形的剖分, 计算其同调群:
    \begin{itemize}
        \item[(1)] 按图 (a) 所示方式将六边形的边选合;
        \item[(2)] 将 $S^2$ 上 $n$ 个不同的点选合;
        \item[(3)] 按图 (b) 所示方式将三角形的三边选合.
    \end{itemize}
\begin{figure}
\begin{center}
\begin{tikzpicture}
    % --- 图 (a) 六边形 ---
    \begin{scope}[xshift=-4cm]
        \node at (-2.5, 0) {(a)};
        % 定义六边形的六个顶点坐标
        \coordinate (v1) at (90:2);
        \coordinate (v2) at (150:2);
