\section*{Sets}

\begin{problem}
Given a linear space $ X $, and its linear subspace $ V $,
then there is a linear subspace $ X $ of $ W $,
and $ X $ is the direct sum of $ V $ and $ W $.
\end{problem}

\begin{proof}
	First we recall Zorn's Lemma:
	\begin{lemma*}
		Let $X$ be a partially ordered non-empty set for which
		every totally ordered subset has an upper bound.
		Then $X$ has a maximal element.
	\end{lemma*}
	Let  $ \Gamma $ denote the collection of all linear subspaces of $ X $,
	all of which share with $ V $ only the $ 0 $ vector.
	It is trivial that zero space is in $ \Gamma $, so it is not empty.
	Define a partial order $ \prec $ as follows:
	$ Y_{1} \prec Y_{2} $ if  $ Y_{1}\subset Y_{2} $.

	Now we verify that any totally ordered subset $ \Gamma' $ of  $ \Gamma $ has an upper bound.
	It suffices to show that $ Y'=\bigcup_{Y\in \Gamma'}Y $ is in $ \Gamma $.

	First, it is obvious that $ Y'\cap V=\varnothing $.

	Second, verify that $ Y' $ is a linear subspace of $ X $.
	For any $ y_{1},y_{2}\in Y'$ and scalar $ k $, there is $ Y_{1},Y_{2}\in \Gamma' $,
	and $ y_{i}\in Y_{i}\ (i=1,2) $. Since $ \Gamma' $ is totally ordered,
	we could assume $ Y_{1}\subset Y_{2} $. Then $ y_{i}\in Y_{2} $,
	so $ y_{1}+y_{2},ky_{1}\in Y_{2} \subset Y' $,
	since $ Y_{2} $ is a linear subspace of $ X $.

	Thus we could use Zorn's Lemma to get a maximal element $ W $ of $ \Gamma $.
	We will show that $ X=V\oplus W $.
	If it is not the case, there exists $ x $ in $ X $, $ x $ cannot be decomposed as sum of vectors in $ V $ and $ W $.
	Then let $ W' $ denote the subspace generated by $ x,W $, and $ W'\in \Gamma $, contradicting to the maximality of $ W $.
\end{proof}

\begin{problem}
If $ A $ is countable, $ f\colon A\to B $ is surjective, then $ B $ is countable.
\end{problem}

\begin{proof}
	Since $ f $ is surjective, then for any $ b\in B $,
	the pre-image of $ b $ is non-empty.
	Choose $ g(b)\in f^{-1}(b) $ arbitrarily for all $b\in B$, then $ g $ is injective.
	Thus $ B,g(B) $ are equipotent,
	but $ g(B)\subset A $ implies that $ g(B) $ is countable, then $ B $ is countable.
\end{proof}

\begin{problem}
Suppose that $ A\subset \mathbb{R} $, for any $ x\in A $, there is $ \delta>0 $, such that
$$
	(x-\delta,x+\delta)\cap A
$$
is countable. Then $ A $ is countable.
\end{problem}

\begin{proof}
	$\forall x\in A,\exists\ a_x<x<b_x\in \mathbb{Q}$, with
	$( a_x,b_x ) \cap A$ countable. Then:
	$$
		A=\bigcup_{x\in A}^{}{\left( \left( a_x,b_x \right) \cap A \right)}\subset
		\bigcup_{
			\begin{subarray}{c}
				a<b\in \mathbb{Q}, \\ ( a,b ) \cap A \text{ countable}
			\end{subarray}
		}^{}{\left( a,b \right) \cap A}
	$$
	is countable since it is a subset of a countable union of countable sets.
\end{proof}

\begin{problem}
Construct a bijection from $ \mathbb{R}^{2} $ to $ \mathbb{R} $.
\end{problem}

\begin{proof}
	The readers are invited to surf the internet for answers.(Or can someone complete this?)

    Hint: Consider the numbers in $[0,1)$, and write them in decimals. Assume that we write the finite decimals NOT in the form of $0.XXX...XXX999...$, but $0.XXX...XXX000...$

    Then we can "split" a number into two in the following way:

    Example: $0.23989479837099981...$

    Write a bar after each number other than $9$: $0.2|3|98|94|7|98|3|7|0|9998|1|...$

    We have infinite many bars since there is no $0.XXX...XXX999...$

    Then we get two numbers: $0.2|98|7|3|0|1|...$ and $0.3|94|98|7|9998|...$. We can prove that this gives a bijection between $[0,1)$ and $[0,1)\times[0,1)$ by writing its inverse (which is obvious).
\end{proof}

\section*{Measure Space}

\begin{problem}
Given a measure space $ (X,\mathcal{X}) $, and an arbitrary function $ f\colon X\to \mathbb{R} $. We have
$$
	\mathcal{A}=\{A\subset \mathbb{R}:f^{-1}(A)\in \mathcal{X} \}
$$
is a $ \sigma$-algebra.
\end{problem}

\begin{proof}
	By definition, we will check the following conditions:

	\begin{enumerate}
		\item $ \varnothing,\mathbb{R}\in \mathcal{A} $:

		      $
			      f^{-1}( \varnothing ) =\varnothing \in \mathcal{X},f^{-1}( \mathbb{R} ) =X\in \mathcal{X}.
		      $
		\item if $ A \in \mathcal{A} $, then $ A^{c}\in \mathcal{A} $:

		      $
			      f^{-1}( A^c ) =\left( f^{-1}( A ) \right) ^c\in \mathcal{X}.
		      $
		\item if $
			      \left\{ A_n \right\} _{n=1}^{\infty}
		      $ is a sequence in $ \mathcal{A} $, then $
			      \bigcup_{n=1}^{\infty}{A_n}\in \mathcal{A}
		      $:

		      $
			      f^{-1}( \bigcup_{n=1}^{\infty}{A_n} ) =\bigcup_{n=1}^{\infty}{f^{-1}( A_n )}\in \mathcal{X}.
		      $
	\end{enumerate}
\end{proof}

\begin{problem}
Determine if it is true and give a proof: The collection of irrationals in $ [0,1] $, the decimal expansion of which contain no digit ``$7$'', is Borel.
\end{problem}

\begin{proof}
	The following discussion is within $ [0,1] $ and using decimal expansion.
	Let $ A $ denote those numbers whose expansion contain digit ``$7$'',
	then it suffices to check $ A $ is Borel. (Why?)

	Let $ B_{n} $ denote numbers with the $ n $-th position of expansion ``$7$'',
	then $ B_{n} $ could be decomposed of countable disjoint intervals, thus it is Borel.
	Since $ A=\bigcup B_{n} $, $ A $ is also Borel.
\end{proof}

\begin{problem}
The $ \sigma $-algebra generated by intervals of the form $ (-\infty,a) $ is exactly $ \mathcal{B}(\mathbb{R} ) $.
\end{problem}

\begin{proof}
	With the closure of complement and countable union operations in $ \sigma $-algebra,
	it is not hard to construct all open intervals,
	then the $ \mathcal{B}(\mathbb{R} ) $.
\end{proof}

\begin{problem}
Determine if it is true and give a proof: Let $ \mathcal{C} $ denote the $ \sigma $-algebra of the collection of
all subsets of $ \mathcal{R} $,
then the following set functions are measures on $ (\mathbb{R} ,\mathcal{C} ) $:
$$ \mu _1\left( A \right) =
	\begin{cases}
		0 ,      & \text{if }  A  \text{ is finite}    \\
		\infty , & \text{if }  A  \text{ is infinite.}
	\end{cases},
	\mu _2\left( A \right) =
	\begin{cases}
		0 ,      & \text{if }  A  \text{ is countable}    \\
		\infty , & \text{if }  A  \text{ is uncountable.}
	\end{cases}
$$
\end{problem}

\begin{proof}
	Since $
		\mu _1\left( \mathbb{Z} \right) =\infty \ne 0=\sum_{n\in \mathbb{Z}}^{}{\mu _1\left( \{n\} \right)}
	$, we know $ \mu_1 $ is not a measure.

	It is trivial to check by definition that $ \mu_2 $ is a measure.
\end{proof}

\begin{problem}
Let $ \mathcal{C}  $ denote the collection of subsets of $ \mathbb{N}  $ that make this limit exist:
$$
	\lim_{n\rightarrow \infty}\frac{|A\cap \left\{ 1,\cdots ,n \right\} |}{n}
$$

And in case it exists, let $ p(A) $ denote it. Determine if $ (\mathbb{N} ,\mathcal{C} ,p) $ is a measure space.
\end{problem}

\begin{proof}
	In fact, the countable additivity is not satisfied.

	First we construct a set $ A\in \mathbb{N}  $, and the limit does not exist:
	$$
		A=\left\{ j\in \mathbb{N},\exists n\in \mathbb{Z}_+,2^n\le j<3\times 2^{n-1} \right\}
	$$

	Then denote $
		A_n=|A\cap \left\{ 1,\cdots ,n \right\} |
	$, it is easy to observe:
	\begin{gather*}
		A_{3\times 2^{n-1}}=\sum_{k=1}^n{2^{k-1}}=2^n-1,A_{2^n-1}=2^{n-1}-1
		\\
		\lim_{n\rightarrow \infty}\frac{A_{3\times 2^{n-1}}}{3\times 2^{n-1}}=\frac{2}{3},
		\lim_{n\rightarrow \infty}\frac{A_{2^n-1}}{2^n-1}=\frac{1}{2}
	\end{gather*}

	Which implies what we want. Then we seperate $ A $ into countable disjoint union
	of unit subsets. Each of them are in $ \mathcal{C}  $, but $ A $ is not.
	A contradiction!
\end{proof}

\begin{problem} \label{pro:capcup}
Assume $ (X,\mathcal{X},\mu ) $ to be a measure space, for any $ E_{1},E_{2} \in \mathcal{X} $, we have
$$
	\mu \left( E_1\cup E_2 \right) +\mu \left( E_1\cap E_2 \right) =\mu \left( E_1 \right) +\mu \left( E_2 \right).
$$
\end{problem}

\begin{proof}
	If the right hand side is infinity, then it is trivial.

	Otherwise, due to countable additivity, we obtain
	\begin{align*}
		 & \mu ( E_1\cup E_2 ) =\mu ( E_1\cap E_2 ) +\mu ( E_1-E_2 ) +\mu ( E_2-E_1 ) \\
		 & \mu ( E_1 ) =\mu ( E_1\cap E_2 ) +\mu ( E_1-E_2 )                                     \\
		 & \mu ( E_2 ) =\mu ( E_1\cap E_2 ) +\mu ( E_2-E_1 )
	\end{align*}

	Which implies what we want.
\end{proof}

\begin{problem}
Let $ E_{1},E_{2},\cdots,E_{n} $ be Borel subsets of $ [0,1],\sum_{k=1}^n{m( E_k )}>n-1 $, then $
	\bigcap_{k=1}^n{E_k}
$ is not empty.
\end{problem}

\begin{proof}
	Let $ F_{k}=[0,1]\backslash E_{k} $, then $
		\bigcap_{k=1}^n{E_k}=\left[ 0,1 \right] \backslash \bigcup_{k=1}^n{F_k}
	$, which implies:
	\begin{gather*}
		m\left( \bigcap_{k=1}^n{E_k} \right) =1-m\left( \bigcup_{k=1}^n{F_k} \right)
		\ge 1-\sum_{k=1}^n{m( F_k )}
		=1-\sum_{k=1}^n{( 1-m( E_k ) )}>0
	\end{gather*}

	and it is obvious that $
		\bigcap_{k=1}^n{E_k}
	$ is not empty.
\end{proof}

\begin{problem}
	(Poincaré Recurrence Theorem)
	Let $ (X,\mathcal{X} ,\mu) $ be a probability space
	(a measure space with $ \mu(X)=1 $), $ f\colon X\to X $ is a measure-preserving transformation,
	which means: for any $ E $ measurable, $ f^{-1}(E) $ is also measurable,
	and their measure coincide. Then for any set $ A $ of positive measure,
	there exists $ x\in A,n\in \mathbb{N}_{+} $, with $ f^{\circ n}(x)\in A $.
\end{problem}

\begin{proof}
	We prove it by contradiction. If $ m(A)>0 $, but $ \forall x\in A,n\in \mathbb{N}_{+} ,
		f^{\circ n}(x)\notin A $, then $ f^{\circ n}(A)\cap A=\varnothing $,
	and we can easily prove by contradiction $ f^{\circ (-n)}(A)\cap A=\varnothing $.
	Then again, $
		A,f^{-1}( A ) ,\cdots ,f^{\circ (-n)}( A ) ,\cdots
	$ are disjoint. Finally we obtain
	$$
		\mu \left( \bigcup_{n=1}^{\infty}{f^{\circ ( -n )}( A )} \right)
		=\sum_{n=1}^{\infty}{\mu \left( f^{\circ ( -n )}( A ) \right)}
		=\sum_{n=1}^{\infty}{\mu ( A )}=\infty
	$$

	Contradicting to $ \mu(X)=1 $!
\end{proof}

\begin{problem} \label{pro:outer_by_open}
$
	\forall E \subset \mathbb{R} ,m^{*}(E)=\inf\{m^{*}(U),U\,\text{open},E\subset U\}
$
\end{problem}

\begin{proof}
	For any $ \varepsilon>0 $, let $ \{I_{k}\} $ be a countable open cover of $ E $,
	$ E\subset \bigcup I_{k},\sum_{}^{}{m( I_k ) \le m^*( E ) +\varepsilon} $.

	Since $ U=\bigcup I_{k} $ is open, and $ E\subset U $, we get:
	\[
		m^*( U ) \le \sum_{}^{}{m^*( I_k )}=\sum_{}^{}{m( I_k )}
		\le m^*( E ) +\varepsilon.
	\]

	Using the definition of infimum, we are done.

\end{proof}
\begin{problem}
If $ E,F\subset \mathbb{R}$ with $m^{*}(E\triangle F)=0 $,
where $ E\triangle F=(E\backslash F)\cup (F\backslash E) $.
$ E $ is Lebesgue measurable if and only if $ F $ is Lebesgue measurable.
\end{problem}

\begin{proof}
	Due to the symmetry between $ E,F $, we only deal with the case 
    where $ E $ is measurable.
	Then for any $ T\subset \mathbb{R}  $, we have:
	$$
		m^*( T ) = m^*(T\cap E) + m^*(T\cap E^c).
    $$
	To prove $ F $ is measurable, it suffices to show:
	$$
		m^*( T ) \ge m^*( T\cap F ) +m^*( T\cap F^c ).
	$$

	Then we observe and make use of the assumption:
	$$
		T\cap F\subset ( T\cap E ) \cup ( E\bigtriangleup F ) ,
		m^*( T\cap F ) \le m^*( T\cap E )
	$$
	$$
		T\cap F^c\subset ( T\cap E^c ) \cup ( E\bigtriangleup F ) ,
		m^*( T\cap F^c ) \le m^*( T\cap E^c )
	$$

	Which implies what we want.
\end{proof}

\begin{problem}
$ \forall A,B\subset \mathbb{R} ,
	m^*( A\cup B ) +m^*( A\cap B )
	\le m^*( A ) +m^*( B ).
$
\end{problem}

\begin{proof}
	Using \ref{pro:outer_by_open}, we have $ \forall \varepsilon >0 ,\exists U,V $ open, with:
	$$ A\subset U,B\subset V,m^*(U)+m^*(V)<m^*( A ) +m^*( B )+\varepsilon.
	$$

	Since \ref{pro:capcup} holds for $ U,V $, we obtain
	\begin{align*}
		  & m^*( A\cap B ) +m^*( A\cup B ) \le m^*( U\cap V ) +m^*( U\cup V ) \\
		= & m^*( U ) +m^*( V ) <m^*( A ) +m^*( B )+\varepsilon.
	\end{align*}

	Then we are done since $ \varepsilon $ is arbitrary.
\end{proof}

\begin{problem}
Let $ d(A,B)>0 $, then $ m^{*}(A\cup B)=m^{*}(A)+m^{*}(B) $.
\end{problem}

\begin{proof}
	If the right hand side is infinity, then it is trivial.

	Otherwise, for any $ \varepsilon>0 $,
	let $ \{I_{k}\} $ be a countable open cover of $ A\cup B $,
	$\sum_{}^{}{m( I_k ) \le m^*( A\cup B ) +\varepsilon} $.

	Since $ d(A,B)>0 $, we assume $ m(I_{k})<d(A,B) $,
	then $ \{I_{k}\} $ cound be divided into two groups:
	$ \{I_{1k}\} $ covering $ A $ and $ \{I_{2k}\} $ covering $ B $. So we have
	\begin{gather*}
		m^*( A ) +m^*( B ) \le \sum_{}^{}{m( I_{1k} )}+\sum_{}^{}{m( I_{2k} )}
		\\
		=\sum_{}^{}{m( I_k )}\le m^*( A\cup B ) +\varepsilon.
	\end{gather*}

	Then we are done since $ \varepsilon $ was arbitrary.
\end{proof}

\begin{problem}
Assume $ m^{*}(E)<\infty $, and for any reals $ a<b $,
\[
	b-a=m^{*}((a,b)\cap E)+m^{*}((a,b)\backslash E).
\]

Then $ E $ satisfies Caratheodory condition.
\end{problem}

\begin{proof}
	$ \forall T \subset \mathbb{R} $, our goal is to prove $
		m^*( T ) \ge m^*( T\cap E ) +m^*( T\cap E^c )
	$.

	For any $ \varepsilon>0 $,
	let $ \{I_{k}\} $ be a countable set of open intervals covering $ T $,
	$ T\subset \bigcup I_{k},\sum{m( I_k ) \le m^*( T ) +\varepsilon} $.

	We obtain:
	\begin{gather*}
		T\cap E\subset \bigcup (I_{k}\cap E ),T\cap E^{c}\subset \bigcup (I_{k}\cap E^{c} ) \\
		m^*( T\cap E ) +m^*( T\cap E^c )
		\le \sum{( m^*( I_k\cap E ) +m^*( I_k\cap E^c ) )} \\
		=\sum{m^*( I_k )}
		<m^*( T )+\varepsilon.
	\end{gather*}

	Since $ \varepsilon $ was arbitrary, we are done.
\end{proof}

Construct the following:

\begin{problem}
$ A\subset \mathbb{R}  $ with $ 0<4m(A^{\circ})=2m(A)=m(\bar{A})<\infty $.
\end{problem}

\begin{proof}
	Observing the properties of rational numbers, we define
	\begin{alignat*}{3}
		      & A_1=( 0,2 ) \cap \mathbb{Q},
		\quad &                                               & A_1^{\circ}=\varnothing ,
		\quad &                                               & \bar{A_1}=[ 0,2 ]     \\
		      & A_2=( 2,3 ) \backslash \mathbb{Q},
		\quad &                                               & A_2^{\circ}=\varnothing ,
		\quad &                                               & \bar{A_2}=[ 2,3 ]     \\
		      & A_3=( 3,4 ) ,
		\quad &                                               & A_3^{\circ}=( 3,4 ) ,
		\quad &                                               & \bar{A_3}=[ 3,4 ]
	\end{alignat*}

	Then it is easy to check $
		A_1\cup A_2\cup A_3
	$ is what we want.
\end{proof}

\begin{problem}
Construct a sequence of disjoint subsets of $ \mathbb{R} $, such that
the measure of the closure of their union is greater than
the sum of the measure of their closure.
\end{problem}

\begin{proof}
	Let $ \{ r_n \} $ denote the sequence of all rational numbers. Then $
		A_n=\{ r_n \}
	$ is a unit set. We have:
	\[
		m\left( \overline{\bigcup_{n=1}^{\infty}{A_n}} \right) =\infty >0=\sum_{n=1}^{\infty}{m(\overline{A_n})}.
	\]
\end{proof}

\section*{Measurable Functions}

\begin{problem}
Given a measure space $ (X,\mathcal{X} ) $, then $ f\colon X\to \mathbb{R} $ is $ \mathcal{X}  $-measurable if and only if for any integer $ k,n $, we have:
$$
	\left\{ x:f( x ) >\frac{k}{2^n} \right\} \in \mathcal{X}
$$
\end{problem}

\begin{proof}
	For any $ c\in \mathbb{R}  $, let a sequence of the form $ k/2^{n} $ approximate it.
\end{proof}

\begin{problem}
Given a measure space $ (X,\mathcal{X} ) $, and a sequence of measuable functions $ f_{n} \colon X\to \mathbb{R} $.Denote
$$
	E=\left\{ x\in X:\left\{ f_n( x )\right\} \text{ converges in } \mathbb{R}  \right\} .
$$

Then $ E $ is measurable.
\end{problem}

\begin{proof}
	In fact, $ \limsup f_{n}(x),\liminf f_{n}(x) $ are measurable. We have $
		E=\left\{ x\in X: \limsup f_{n}(x)=\liminf f_{n}(x)  \right\}
	$ is also measurable.
\end{proof}

\begin{problem} \label{pro:keepmeasure}
Let $ f\colon \mathbb{R} \to \mathbb{R}  $ be pointwise differentiable,
$ E\subset \mathbb{R},m(E)=0  $. Then $ m(f(E))=0 $.
\end{problem}

\begin{proof}
	We set $ E_{n}=\{x\in E\colon|f'(x)|<n\} $, then $ f(E_{n}) $ increases to $ f(E) $. Since $ m(E)=0 $, for any $ \varepsilon>0 $,
	there exists an open set $ U $ such that $ E\subset U $ and $ m(U)<\varepsilon/n $.

	For each $ x\in E_{n} $, there exsits a binary interval $ J_{x} $ such that $ x\in J_{x}\subset U $ and $ m(f(J_{x}))<nm(J_{x}) $.

	Then $ \mathcal{J} =\{J_{x},x\in E_{n}\} $ is a cover of $ E_{n} $.
	By removing the duplicate parts we obtain $ \mathcal{J} _{1}\subset \mathcal{J}  $, a disjoint cover of $ E_{n} $.
	We have the estimate
	$$ m(f(E_{n}))\le\sum m(f(J_{x}))\le n\sum m(J_{x}) = nm\left (\bigcup J_{x}\right )\le nm(U)<\varepsilon  $$

	Thus $ m(f(E_{n}))=0 $ since $ \varepsilon $ was arbitrary. And finally
	$$
		m( f( E ) ) =m( \lim f( E_n ) ) =\lim m( f( E_n ) ) =0.
	$$
	%(afsd) For any positive integer $ n,k $, set $ E_n:= \left\{ x\in E: | f'(x) | <n \right\} $ and 
	%$ E_{n,k}:= \left\{ x\in E: |f(y)-f(x)|\leqslant n|y-x|, \forall y \in B_{1/k}(x) \right\}$.

	%Observe that $ E=\bigcup_{n\geqslant 1}E_n $ and $ E_n=\bigcup_{k\geqslant 1} E_{n,k}$. Since $ f(E)=\bigcup_{n,k\geqslant 1} f(E_{n,k})$, 
	%we only need to prove that $ f(E_{n,k})$ is of measure zero for any $ n,k\geqslant 1$.

	%Use the definition of $ E_{n,k} $ to estimate the (outer) measure of $ f(E_{n,k})$, and conclude. 
	%Notice that we may have to find a cover of $ E_{n,k} $ consisting of balls centered in $ E_{n,k} $.
\end{proof}

\begin{problem}
Let $ f\colon \mathbb{R}^{2} \to \mathbb{R}  $ be a continuous function.
For any $ x\in \mathbb{R}  $, let $ p(x) $ denote the number of y that satisfies $ f(x,y)=0 $.
Then $ p(x) $ is Borel measurable.
\end{problem}

\begin{proof}
	Since $ p(x) $ is a positive integer-valued function, it suffices to prove $ \{x:p(x)\ge n\} $ is borel for any positive integer $ n $. Observe that
	\begin{gather*}
		\left\{ x:p( x ) \ge n \right\} =\left\{ x:\exists \text{ distinct }y_1,\cdots ,y_n, f( x,y_k ) =0 \right\} \\
		=\left\{ x:\exists N,m\in \mathbb{N}_+,\exists \text{ distinct }y_1,\cdots ,y_n, |y_k|\le N,|y_j-y_k|\ge \frac{1}{m},f( x,y_k ) =0 \right\} \\
		=\bigcup_{N=1}^{\infty}{\bigcup_{m=1}^{\infty}{E_n}}
	\end{gather*}

	Where we denote
	$$
		E_n=\left\{ x:\exists \text{ distinct }y_1,\cdots ,y_n, |y_k|\le N,|y_j-y_k|\ge \frac{1}{m},f( x,y_k ) =0 \right\}
	$$

	Thus our problem is reduced to prove $ E_{n} $ is closed. If so, it is Borel, then countable union of Borel sets is still Borel.

	$
		\forall x_0\in E_n',\exists \left\{ x_r \right\} \subset E_n,\lim x_r=x_0
	$. since $ x_r\in E_n $,
	$$
		\exists y_{r1},\cdots ,y_{rn}\text{ pairwise disjoint, }|y_{rk}|\le N,|y_{rj}-y_{rk}|\ge \frac{1}{m},f( x_r,y_{rk} ) =0.
	$$

	Then for any $ r,k $, $ y_{rk} $ is bounded by $ N $. Thus $
		\{( y_{r1},\cdots ,y_{rn} )\} \subset \mathbb{R}^n
	$ is also bounded, and contains a subsequence $
		\{ ( y_{r_t1},\cdots ,y_{r_tn} ) \}
	$ which converges to $
		( y_{01},\cdots ,y_{0n} )
	$. Still we have $
		|y_{0k}|\le N,|y_{0j}-y_{0k}|\ge \frac{1}{m}
	$, and since $ f $ is continuous, we obtain
	$$
		f( x_0,y_{0k} ) =f( \lim \left( x_{r_t},y_{r_tk} \right) ) =\lim f( x_{r_t},y_{r_tk} ) =0.
	$$

	Finally $ x_{0} $ is in $ E_{n} $. Thus $ E_{n} $ is closed.
\end{proof}

\begin{problem}
Let $ \mu $ be a Borel measure on $ \mathbb{R}  $. Then real-valued function
\[
	f(x)=\liminf_{r\to 0}\frac{\mu((x-r,x+r))}{r}
\]

is Borel measuable.
\end{problem}

\begin{proof}
	Since $ f(x)=\lim_{r_{0}\to 0^{+}}f_{r_{0}}( x ) $, where we denote
	$$ f_{r_{0}}( x ) =\inf_{0<r<r_{0}}\frac{\mu ( ( x-r,x+r ) )}{r}.
	$$

	It is obvious that for a fixed $ x $, the function $ f_{r_{0}}(x) $ of $ r_{0} $ is decreasing. Thus we obtain $
		f( x ) =\sup f_{1/n}( x )
	$. Next we shall prove this $ f_{1/n}(x) $ is Borel measurable, then the supremum of it is still Borel measurable.

	We claim that for any $ n\in \mathbb{N}_{+},c\in \mathbb{R} $, the set $ \{f_{1/n}(x)<c\} $ is open.

	For any $ x_{0}\in \{f_{1/n}(x)<c\} $, we have $ \{f_{1/n}(x_{0})<c\} $.
	Using definition, there exists $ 0<r<1/n $, such that $ \mu((x_{0}-r,x_{0}+r))<cr $.
	Thus take  one more $ 0<s \ll r $, such that $ \mu((x_{0}-r,x_{0}+r))<c(r-s) $.

	For any $ x\in U(x_{0},s) $, we have $ U(x,r-s)\subset U(x_{0},r) $. Then
	$$ \mu((x-(r-s),x+(r-s)))\le \mu((x_{0}-r,x_{0}+r))<c(r-s) $$
	$$
		\inf_{0<r<\frac{1}{n}}\frac{\mu ( ( x-r,x+r ) )}{r}\le \frac{\mu ( ( x-( r-s ) ,x+( r-s ) ) )}{r-s}<c
	$$
	Thus $ f_{1/n}(x)<c $, namely $
		U( x_0,s ) \subset \{ f_{1/n}( x ) <c \}
	$, so it is open, then Borel measurable.
\end{proof}

\section*{Lebesgue Integral}

\begin{problem}
Let $ (X,\mathcal{X} ,\mu) $ be a measure space with $ \mu(X)<\infty $. $ f\colon X\to \mathbb{R}  $ is integrable if and only if:
$$
	\sum_{n=1}^{\infty}{2^n\mu ( \left\{ x\in X:|f( x ) |>2^n \right\} )}<\infty.
$$
\end{problem}

\begin{proof}
	Let $
		A_n=\left\{ x\in X:2^n<|f( x ) |\le 2^{n+1} \right\}
	$, then we denote:
	$$
		B_n=\bigcup_{m=n}^{\infty}{A_m}
	$$

	this union is disjoint.Thus
	\begin{gather*}
		I=\sum_{n=1}^{\infty}{2^n\mu ( B_n )}=\sum_{n=1}^{\infty}{2^n\sum_{m=n}^{\infty}{\mu ( A_m )}}=\sum_{m=1}^{\infty}{\mu ( A_m ) \sum_{n=1}^m{2^n}}
		\\
		=\sum_{m=1}^{\infty}{\int_{}^{}{( 2^{m+1}-1 ) \chi _{A_m}\mathrm{d}\mu}}=\int_{}^{}{\sum_{m=1}^{\infty}{( 2^{m+1}-1 ) \chi _{A_m}}\mathrm{d}\mu}
		\\
		\int_{}^{}{|f( x ) |-1\mathrm{d}\mu}\le I<\int_{}^{}{2|f( x ) |-1\mathrm{d}\mu}
	\end{gather*}

	Since $ \mu(X)<\infty $ and  $ |f| $ is integrable if and only if $ f $ is integrable, we are done.
\end{proof}

\begin{problem}
Suppose $\left\{f_n\right\}_1^{\infty} \subset L^{+}, f_n \rightarrow f$ pointwise, and $\int f=\lim \int f_n<\infty$.
Then $\int_E f=\lim \int_E f_n$ $\forall E \in \mathcal{M}$.
However, this need not be true if $\int f=\lim f_n=\infty$.
\end{problem}

\begin{proof}
    *:Applying Fatou Lemma to the complement of $E$.

	Let $E \in \mathcal{M}$ and $\int f<\infty$, we have:
	$$
		\int f=\int\left(\chi_E f+\chi_{E^c} f\right)=\int \chi_E f+\int \chi_{E^c} f
	$$
	And similarly for substituting $f_n$ for $f$ above. Now, since $f_n \rightarrow f \Rightarrow \chi_F f_n \rightarrow \chi_F f, \forall F \in \mathcal{M}$, we may apply Fatou's Lemma as follows:
	$$
		\int_E f=\int \liminf _{n \rightarrow \infty} \chi_E f_n \leq \liminf _{n \rightarrow \infty} \int_E f_n \stackrel{*}{=} \liminf _{n \rightarrow \infty}\left(\int f_n-\int_{E^c} f_n\right) \stackrel{* *}{=} \int f-\limsup _{n \rightarrow \infty} \int_{E^c} f_n
	$$
	Where we have $\stackrel{*}{=}$ since $\int_E f=\int \chi_E f+\int \chi_{E^c} f$, and $\stackrel{* *}{=}$ since $\liminf \int f_n=\lim \int f_n=\int f$ and $\liminf -\int g=-\lim \sup \int g$.
	However, since all terms above are finite, we may gain by apply Fatou's Lemma (and in noticing the similarity to the steps made above) to see that:
	$$
		\limsup _{n \rightarrow \infty} \int_{E^c} f_n=\limsup _{n \rightarrow \infty}\left(\int f_n-\int_E f_n\right)=\int f-\liminf _{n \rightarrow \infty} \int_E f_n \leq \int f-\int_E f.
	$$
	And thus by substituting this in, we have:
	$$
		\int_E f \leq \liminf _{n \rightarrow \infty} \int_E f_n \leq \limsup _{n \rightarrow \infty} \int_E f_n \leq \int_E f.
	$$
	And therefore all the inequalities in the equation(s) above are actually equalities, and so we have:
	$$
		\liminf _{n \rightarrow \infty} \int_E f_n=\limsup _{n \rightarrow \infty} \int_E f_n=\lim _{n \rightarrow \infty} \int_E f=\int_E f.
	$$
	We now turn our attention showing the above result need not hold if $\int f=\lim \int f=\infty$ by means of a counter-example. Let $E=(0,1], f=\chi_{[2, \infty)}$, and $f_n=\chi_{[2, \infty)}+n \chi_{(0,1 / n]}$. Then $f_n \rightarrow f$ p.w., and:
			$$
			\int_{(0,1]} f_n=n \mu((0,1 / n])=1 \forall n \in \mathbb{N} \Rightarrow \lim _{n \rightarrow \infty} \int_{(0,1]} f_n=1.
	$$
	However, $\int_{(0,1]} f=0$, thus $\int_E f=\lim \int_E f_n$ need not be true if $\lim \int f_{n}=\int f=\infty$.
\end{proof}

\begin{problem}
Suppose that $\left\{f_j\right\}$ is a sequence in $L^1$ such that $\sum_1^{\infty} \int_j\left|f_j\right|<\infty$. Then $\sum_1^{\infty} f_j$ converges a.e. to a function in $L^1$, and $\int \sum_1^{\infty} f_j=\sum_1^{\infty} \int f_j$.
\end{problem}

\begin{proof}
	$\int \sum_1^{\infty}\left|f_j\right|=\sum_1^{\infty} \int\left|f_j\right|<\infty$, so the function $g=$ $\sum_1^{\infty}\left|f_j\right|$ is in $L^1$.
	In particular, $\sum_1^{\infty}\left|f_j(x)\right|$ is finite for a.e. $x$, and for each such $x$ the series $\sum_1^{\infty} f_j(x)$ converges.
	Moreover, $\left|\sum_1^n f_j\right| \leq g$ for all $n$, so we can apply the dominated convergence theorem to the sequence of partial sums to obtain $\int \sum_1^{\infty} f_j=\sum_1^{\infty} \int f_j$.
\end{proof}

\begin{problem}
Let $ f $ be a non-negative measurable function, $ \{E_{k}\}_{k=1}^{\infty} $ is a sequence of measurable sets, such that
\[
	\lim_{k\to \infty} \mu(X\backslash E_{k})=0.
\]

Then
$$
	\lim \int_{E_k}^{}{f\mathrm{d}\mu}=\int_{}^{}{f\mathrm{d}\mu}.
$$
\end{problem}

\begin{proof}
%	I do not know how to prove rigorously. But someone told me to consider
%	$$
%		f\chi _{\bigcap_{j=k}^{\infty}{E_j}}\le f\chi _{E_k}\le f\chi _{\bigcup_{j=1}^k{E_j}}
%	$$
%
%	and approximate by sup and inf.

    Hint: Let $An$ denote the $x$ that $f(x)>n$. Use theories of summation of series to solve the problem when the equality given takes real values.
\end{proof}

\begin{problem}
Let $ f $ be a positive-valued measurable function. For any $ \alpha>0 $,
\[
	\inf\left\{ \int_E^{}{f\mathrm{d}\mu}:\mu ( E ) \ge \alpha \right\} >0.
\]
\end{problem}

\begin{proof}
	We prove it by contradiction. If there exists $ \alpha>0 $, such that
	\[
		\inf\left\{ \int_E^{}{f\mathrm{d}\mu}:\mu ( E ) \ge \alpha \right\} =0,
	\]

	then we can choose a sequence $ \{E_{k}\}_{k=1}^{\infty} $, each with $ \mu(E_{k})\ge \alpha $, and $ \int_{E_{k}}^{}{f\mathrm{d}\mu}\le 1/2^{k} $.

	Let $ F=\limsup E_{k} $, it is not hard to observe
	$$
		\mu ( F ) =\lim \mu \left( \bigcup_{k=n}^{\infty}{E_k} \right) \ge \alpha
	$$
	$$
		\int_F^{}{f\mathrm{d}\mu}\le \int_{\bigcup_{k=n}^{\infty}{E_k}}^{}{f\mathrm{d}\mu}\le \sum_{k=n}^{\infty}{\int_{E_k}^{}{f\mathrm{d}\mu}}\le \sum_{k=n}^{\infty}{\frac{1}{2^k}}=\frac{1}{2^{n-1}}
	$$

	Let $ n\to \infty $, we obtain $
		\int_F^{}{f\mathrm{d}\mu}=0
	$, then $ f=0 $ holds a.e. on $ F $, contradicting to being positive-valued.
\end{proof}

\begin{problem}
Let $ f $ be a non-negative measurable function, and there is a constant $ c $, such that $
	\int_{}^{}{f^n\mathrm{d}\mu}=c
$ holds for any $ n\in \mathbb{N}^+  $. Then there exists a measurable set $ E $, $ f(x)=\chi_E(x) $ a.e.
\end{problem}

\begin{proof}
	First we compute $
		F( x ) =\liminf f( x ) ^n
	$. For $ f(x)<1,=1,>1 $, $ F(x)=0,1,\infty $ respectively.

	By Fatou's Lemma,
	$$
		\int_{}^{}{F}\le \liminf\int_{}^{}{f^n}=\liminf\int_{}^{}{f}=c
	$$

	We obtain for a.e. $ F<\infty \Rightarrow  f\le 1 \Rightarrow f^{2}\le f $. But on the other hand we have $
		\int_{}^{}{f^2}=\int_{}^{}{f}
	$, then for a.e. $ f^{2}=f \Rightarrow f=0 \text{ or } f=1 $.

	Thus let $ E=\{f(x)=1\} $, it is exactly what we want.
\end{proof}

\begin{problem}
For any $ x\in [ 0,1) $, define by its binary decomposition a sequence of functions $ x=0.a_{1}(x)a_{2}(x)\cdots $. For those without an unique decomposition, we choose the one with the ending of $ 000\cdots $.

Let $ f\colon [ 0,1  ) \to \mathbb{R}  $ be Lebesgue measurable, then
\[
	\lim_{n\to \infty} \int_0^1 f( x ) a_n( x ) \mathrm{d}x=\frac{1}{2}\int_0^1 f( x ) \mathrm{d}x.
\]
\end{problem}

\begin{proof}
	\begin{enumerate}
		\item If $ f $ is continuous on $ [0,1] $, then it is also uniformly continuous. For any $ \varepsilon>0 $, there exists $ N>0 $, such that $ \vert f(x)-f(y) \vert \le \varepsilon $ for any $ \vert x-y \vert<1/{2^{N+1}} $. Thus for any $ n>N $, we have
		      $$
			      \bigg| \int_{\frac{k}{2^n}}^{\frac{k+\frac{1}{2}}{2^n}}{f( x ) \mathrm{d} x}-\int_{\frac{k+\frac{1}{2}}{2^n}}^{\frac{k+1}{2^n}}{f( x ) \mathrm{d} x} \bigg|\le \int_{\frac{k}{2^n}}^{\frac{k+\frac{1}{2}}{2^n}}{\varepsilon \mathrm{d} x}=\frac{\varepsilon}{2^{n+1}}
		      $$
		      $$
			      \bigg|\int_0^1{f( x ) a_n( x ) \mathrm{d} x}-\int_0^1{f( x ) ( 1-a_n( x ) ) \mathrm{d} x}\bigg|\le 2^n\frac{\varepsilon}{2^{n+1}}=\frac{\varepsilon}{2}
		      $$

		      Which implies the limit.

		      Now we approximate any measurable function by a continuous one.
		\item If $ f $ is a indicator function: $ f=\chi_{E} $, $ E\subset [ 0,1) $, by Lusin's theorem, for each $ \delta>0 $ there exists a continuous $ h\colon\mathbb{R} \to [0,1]  $ such that $ m(\{f\ne h\})<\delta $, thus $ \int_{0}^{1}\vert f-h \vert\mathrm{d}x\le \delta $.

		      We already know $
			      \int_0^1{ha_n\mathrm{d} x}\rightarrow \frac{1}{2}\int_0^1{h\mathrm{d} x}
		      $, and we have
		      $$
			      \bigg|\int_0^1{fa_n\mathrm{d} x}-\int_0^1{ha_n\mathrm{d} x}\bigg|\le \int_0^1{\vert f-h \vert\mathrm{d} x}\le \delta
		      $$

		      Since $ \delta $ was arbitrary, we are done.

		\item If $ f $ is a simple function, it is trivial by the above.

		\item Finally for any measurable $ f $, WLOG we assume $ f\ge 0 $. Let an increasing sequence of simple functions approximate it and...
	\end{enumerate}
\end{proof}

\begin{problem}
Let $ \mu(X)<\infty,f\colon X \to \left[0 ,\infty \right) $ be bounded. Then
$$
	\int_{}^{}{f\mathrm{d}\mu}=\inf\left\{ \int_{}^{}{\varphi \mathrm{d}\mu}:\varphi \ge f, \varphi \text{ simple} \right\}
$$
Moreover, prove by examples that the condition $ \mu(X)<\infty  $ is necessary.
\end{problem}

\begin{proof}
	Let $ |f|<M $. We obtain by $ \mu(X)<\infty $ the following:
	$$
		M\mu \left( X \right) -\int_{}^{}{f\mathrm{d} \mu}=\int_{}^{}{M-f\mathrm{d} \mu}
		=\text{sup}\left\{ \int_{}^{}{\psi \mathrm{d} \mu},\psi \text{ simple},0\le \psi \le M-f \right\}
	$$
	$$
		=\text{sup}\left\{ \int_{}^{}{M-\varphi \mathrm{d} \mu},\varphi \text{ simple},f\le \varphi \le M \right\}
		=M\mu \left( X \right) -\text{inf}\left\{ \int_{}^{}{\varphi \mathrm{d} \mu},\varphi \text{ simple},\varphi \ge f \right\}
	$$

	Which implies what we want.

	For an example, let $ \mu $ be a counting measure on $ (\mathbb{N} ,2^\mathbb{N} ,\mu) $ and $ f\colon \mathbb{N} \to \left[0,\infty \right) $ be $ f(n)=1/n^{2} $, then it is bounded, and we have
	$$
		\int_{}^{}{f\mathrm{d} \mu}=\text{sup}\left\{ \int_{}^{}{\varphi \mathrm{d} \mu},\varphi  \text{ simple}\le f \right\} =\sum_1^{\infty}{\frac{1}{n^2}}=\frac{\pi ^2}{6}.
	$$

	But for any simple $ \varphi\ge f $, assume $ \varphi=\sum_{k=1}^n{a_k\chi _{E_k}} $, then each $ a_{k}>0 $, and $
		\bigsqcup_{k=1}^n{E_k}=\mathbb{N}
	$. Thus there exists a $ E_{k} $, which is infinite, so $ \int \varphi \mathrm{d} \mu=\infty $:
	\[
		\inf\left\{ \int_{}^{}{\varphi \mathrm{d}\mu}:\varphi \ge f, \varphi \text{ simple} \right\}  =\infty.
	\]
\end{proof}

\begin{problem}
Let $ f $ be integrable. For any $ \varepsilon>0 $, there exists $ E $ measurable, $ \mu(E)<\infty $, such that
$$
	\bigg|\int_{}^{}{f\mathrm{d} \mu}-\int_E^{}{f\mathrm{d} \mu}\bigg|<\varepsilon
$$
\end{problem}

\begin{proof}
	WLOG we assume $ f\ge 0 $. Let $ F_{n}=\{f>\frac{1}{n}\} $ and $ F=\{f>0\} $, then $ F_{n} $ increases to $ F $, $ \chi_{F_{n}} $ increases to $ \chi_{F} $. By MCT we have
	$$
		\int f=\int \chi _Ff=\lim \int \chi _{F_n}f=\lim \int_{F_n}f.
	$$


	Now it suffices to check $ \mu(F_{n})<\infty $. It is guaranteed by
	$$
		\mu \left( F_n \right) =\int_{F_n}^{}{1}<\int_{F_n}^{}{nf}<n\int_{}^{}{f}<\infty.
	$$
\end{proof}

\begin{problem}
Let $
	\left\{ f_n \right\} _{n=1}^{\infty}
$ be a sequence of integrable functions that converge to $ 0 $ a.e. Constant $ M>0 $ such that
$$
	\int_{}^{}{\max \left\{ |f_1( x ) |,|f_2( x ) |,\cdots ,|f_n( x ) | \right\} \mathrm{d} \mu}<M
$$

for any positive integer $ n $. Then
$$
	\lim_{n\rightarrow \infty}\int_{}^{}{f_n\mathrm{d} \mu}=0.
$$
\end{problem}

\begin{proof}
	Let $
		g_n( x ) =\max \left\{ |f_1( x )| ,\cdots ,|f_n( x ) | \right\}
	$ be a monotone increasing sequence of positive measurable functions and let $ g=\lim g_{n} $, we obtain by MCT:
	$$
		\lim_{n\rightarrow \infty}\int_{}^{}{g_n\mathrm{d} \mu}=\int_{}^{}{g\mathrm{d} \mu}
	$$

	Since $
		\int_{}^{}{g_n\mathrm{d} \mu}<M
	$, $
		\int_{}^{}{g\mathrm{d} \mu}\le M
	$. Thus $ g $ is integrable.

	On the other hand, $
		|f_n|\le g_n\le g
	$, then by DCT and $ f_{n}\to 0 $ a.e.:
	$$
		\lim_{n\rightarrow \infty}\int_{}^{}{f_n\mathrm{d} \mu}=\int_{}^{}{0\mathrm{d} \mu}=0.
	$$
\end{proof}

\begin{problem}
Compute
$$
	\lim_{n\rightarrow \infty}\int_0^{\infty}\left( 1+\frac{x}{n} \right) ^n\text{e}^{-2x}\mathrm{d} x.
$$
\end{problem}

\begin{proof}
	1.
\end{proof}

\begin{problem}
Let $ f\colon X\to \mathbb{R}  $ be measurable, $ \mu(X)<\infty $. Then
$$
	\lim_{n\rightarrow \infty}\int_{}^{}{|\cos ( \pi f( x ) ) |^n\mathrm{d} \mu}=\mu ( f^{-1}( \mathbb{Z} ) ).
$$
\end{problem}

\begin{proof}
	Let $
		g_n( x ) =|\cos ( \pi f( x ) ) |^n,\tilde{X}=f^{-1}( \mathbb{Z} )
	$, then $ \tilde{X} $ is measurable since $ f $ is measurable.

	For $ x\in \tilde{X} $, $ g_{n}(x)=1 $. Otherwise, $ g_{n}(x)\to 0 $. Thus $ g_{n}(x)\searrow \chi_{\tilde{X}} $.

	By MCT and $ \mu(X)<\infty $, we obtain
	$$
		\lim_{n\rightarrow \infty}\int_{}^{}{g_n\mathrm{d} \mu}=\int_{}^{}{\chi _{\tilde{X}}\mathrm{d} \mu}=\mu ( \tilde{X} ).
	$$
\end{proof}

\begin{problem}
Compute
$$
	\lim_{n\rightarrow \infty}\int_0^{n^2}{\frac{x^{\frac{1}{n}}}{1+x^{2n}}\mathrm{d} x}
$$
\end{problem}

\begin{proof}
	1.
\end{proof}

\begin{problem}
Let $ f_{n} $ be measurable. For any $ x\in X $, $ |f_{n}(x)|<1/n^{2} $, for any positive integer $ n $. Let $ g $ be integrable. Then for any $ E $ measurable, the following holds:
$$
	\int_E{\sum{f_ng}\mathrm{d} \mu}=\sum\int_E{f_ng}\mathrm{d} \mu.
$$

\end{problem}

\begin{proof}
	WLOG we assume $ f_{n},g\ge0 $, then prove it by lemmas:

	\begin{lemma*}
		%{2.13}
		Let $ f_{n}\ge 0 $ be measurable, $ f_{n}\to f $ pointwise, $ \int f=\lim \int f_{n}<\infty $, then for any $ E $ measurable, we have
		$$
			\int_E{f}=\lim \int_E{f_n}.
		$$
	\end{lemma*}

	\begin{lemma*}
		Let $ f_{n}\ge 0 $ be measurable, $ f=\sum f_{n} $, then $ \int f=\sum \int f_{n} $.
	\end{lemma*}

	Back to our proof, we check two things at first:  $
		\sum_{k=1}^n{f_kg}\rightarrow \sum_{k=1}^{\infty}{f_kg}
	$, which is obvious; second:
	$$
		\int_{}^{}{\sum_{k=1}^n{f_kg}}\rightarrow \int_{}^{}{\sum_{k=1}^{\infty}{f_kg}}<\infty
	$$

	This convergence is by the second lemma, and finity by $ f_{n}<1/n^{2} $.

	By the first lemma, for any $ E $ measurable, we have
	$$
		\int_E^{}{\sum_{k=1}^{\infty}{f_kg}}=\lim \int_E^{}{\sum_{k=1}^n{f_kg}}=\lim \sum_{k=1}^n{\int_E^{}{f_kg}},
	$$

	where the latter equality is by the second lemma.
\end{proof}

\begin{problem}
Let $ f\colon[ 0,1)\to \mathbb{R}   $ be Lebesgue measurable. For each $ n\in \mathbb{N} _{+} $, define
$$
	f_n( x ) =n\int_{\frac{k}{n}}^{\frac{k+1}{n}}{f( t ) \mathrm{d} t},x\in \left[ \frac{k}{n},\frac{k+1}{n} \right) ,k=0,1,\cdots ,n-1.
$$

Then$$
	\lim_{n\rightarrow \infty}\int_0^1{|f_n( x ) -f( x ) |\mathrm{d} x}=0.
$$
\end{problem}

\begin{proof}
	\begin{enumerate}
		\item If $ f $ is continuous on $ [0,1] $, then it is also uniformly continuous. For any $ \varepsilon>0 $, there exists $ N>0 $, such that $ \vert f(x)-f(y) \vert \le \varepsilon $ for any $ \vert x-y \vert<1/N $. Thus for any $ n>N $, we have
		      $$
			      \int_{\frac{k}{n}}^{\frac{k+1}{n}}{|f_n( x ) -f( x ) |\mathrm{d} x}\le n\int_{\frac{k}{n}}^{\frac{k+1}{n}}{\int_{\frac{k}{n}}^{\frac{k+1}{n}}{|f( t ) -f( x ) |\mathrm{d} t}\mathrm{d} x}\le n\int_{\frac{k}{n}}^{\frac{k+1}{n}}{\varepsilon \frac{1}{n}\mathrm{d} x}=\frac{\varepsilon}{n}.
		      $$

		      Add them, by the arbitrary of $ \varepsilon $, we obtain the limit.

		      Now we approximate any measurable function by a continuous one.
		\item If $ f $ is a indicator function: $ f=\chi_{E} $, $ E\subset \left[ 0,1\right) $, by Lusin's theorem, for each $ \delta>0 $ there exists a continuous $ h\colon\mathbb{R} \to \mathbb{R}   $ such that $ m(\{f\ne h\})<\delta $, thus $ \int_{0}^{1}\vert f-h \vert\mathrm{d}x\le \delta $.

		      We already know $
			      \int_0^1{|h_n( x ) -h( x ) |\mathrm{d} x}\rightarrow 0
		      $, and we have
		      $$
			      \int_0^1{|f_n( x ) -h_n( x ) |\mathrm{d} x}=\sum_{k=0}^{n-1}{\int_{\frac{k}{n}}^{\frac{k+1}{n}}{|f_n( x ) -h_n( x ) |\mathrm{d} x}}
		      $$
		      $$
			      \le \sum_{k=0}^{n-1}{\frac{1}{n}n\int_{\frac{k}{n}}^{\frac{k+1}{n}}{|f( t ) -h( t ) |\mathrm{d} t}}=\int_0^1{|f( t ) -h( t ) |\mathrm{d} t}.
		      $$

		      Then we estimate
		      $$
			      \int_0^1{|f_n( x ) -f( x ) |\mathrm{d} x}\le \int_0^1{|f_n( x ) -h_n( x ) |+|h_n( x ) -h( x ) |+|h( x ) -f( x ) |\mathrm{d} x}
		      $$
		      $$
			      \le 2\delta +\int_0^1{|h_n( x ) -h( x ) |\mathrm{d} x}.
		      $$

		      Since $ \delta $ is arbitrary, we are done.

		\item If $ f $ is a simple function, it is trivial by the above.

		\item Finally for any measurable $ f $, WLOG we assume $ f\ge 0 $. Let an increasing sequence of simple functions approximate it and...
	\end{enumerate}
\end{proof}

\begin{problem}
Let $ f_{n}\colon [0,1]\to \mathbb{R} $, $f_{n}\ge 0 $ Lebesgue measurable, and converges to $ f $ a.e.

Let $ F(x)=\int_{0}^{x}f(y)\mathrm{d} y,F_{n}(x)=\int _{0}^{x}f_{n}(y)\mathrm{d} y $. Then:
$$
	\int_0^1{f+F\mathrm{d} x}\le \liminf \int_0^1{f_n+F_n\mathrm{d} x}
$$
\end{problem}

\begin{proof}
	By Fatou's Lemma,
	$$
		\liminf \int_0^1{f_n( x ) +F_n( x ) \mathrm{d} x}\ge \int_0^1{\liminf ( f_n( x ) +F_n( x ) ) \mathrm{d} x}
	$$
	$$
		=\int_0^1{f( x ) +\liminf \int_0^x{f( y ) \mathrm{d} y}\mathrm{d} x}
	$$
	$$
		\ge \int_0^1{f( x ) +\int_0^x{\liminf f( y ) \mathrm{d} y}\mathrm{d} x}=\int_0^1{f( x ) +F( x ) \mathrm{d} x}
	$$
\end{proof}

\begin{problem}
Let $ f,f_{n},g\in \mathcal{L} ^{2}(\mathbb{R} ),n=1,2,\cdots $, $ f_{n} $ converges to $ f $ a.e. and
$$
	\int_{\mathbb{R}}^{}{\vert f_n( x ) \vert ^2\mathrm{d} x}\le 1.
$$

Then
$$
	\lim_{n\rightarrow \infty}\int_{\mathbb{R}}^{}{\vert f_n( x ) -f( x ) \vert \vert g (x) \vert \mathrm{d} x}=0.
$$
\end{problem}

\begin{proof}
	For any $ \varepsilon> 0 $, there exists a $ \delta>0 $ such that for any $ m(A)<\delta $ we have
	$$
		\int_A^{}{g^2}<\varepsilon
	$$


	At the same time, denote $
		E_n=\left\{ |x|>n \right\}
	$, then there exists a $ N $:
	$$
		\int_{E_N}^{}{g^2}<\varepsilon
	$$

	By Erogoff's theorem, there exists a measurable $ F $ such that $ m(\mathbb{R} \backslash (E_{N}\cup F))<\delta $, and $ f_{n}(x)\vert_{F}\rightrightarrows f(x)\vert_{F} $. Then there exits a $ N_{1} $ such that for any $ k\ge N_{1},x\in F $, we have $ \vert f_{k}-f \vert^{2}<\varepsilon/m(F) $. Thus
	$$
		\int_F^{}{|f_k-f|^2}<\frac{\varepsilon}{m( F )}m( F ) =\varepsilon.
	$$

	Again we also have
	$$
		\int_{\mathbb{R} \backslash (E_{N}\cup F)}^{}{g^2}<\varepsilon \Rightarrow \int_{\mathbb{R} \backslash F}^{}{g^2}<2\varepsilon.
	$$

	Thus for any $ n\ge N+N_{1} $, we have
	$$
		\int_{\mathbb{R}}^{}{|f_n-f|g}\le \int_{\mathbb{R}-F}^{}{|f_n-f|g}+\int_F^{}{|f_n-f|g}
	$$
	$$
		\le \sqrt{\int_{\mathbb{R}}^{}{|f_n-f|^2}\int_{\mathbb{R}-F}^{}{g^2}}+\sqrt{\int_F^{}{|f_n-f|^2}\int_{\mathbb{R}}^{}{g^2}}
	$$
	$$
		\le 2\sqrt{2\varepsilon}+\|g\|_2\sqrt{\varepsilon}.
	$$

	Then we are done.
\end{proof}

\begin{problem}
Let $ f_{n} $ be a sequence of non-negative Borel measurable functions on $ [0,1] $ that converges to $ f $ a.e. Moreover, we have
$$
	\int_0^1{f_n( x ) \log ( f_n( x ) +2 ) \mathrm{d} x}\le 1.
$$

Then $ f $ is Lebesgue measurable, and $
	\lim \int_0^1{|f_n( x ) -f( x ) |\mathrm{d} x}=0
$.
\end{problem}

\begin{proof}
	We prove it by Vitali Convergence Theorem:
	\begin{lemma*}
		Let $ \mathcal{F}  $ be a uniformly integrable and tight family of integrable functions, and a subfamily $ f_{n} $ converges to $ f $ pointwise, then $ f $ is integrable, and $
			\lim \int_0^1{|f_n( x ) -f( x ) |\mathrm{d} x}=0
		$.
	\end{lemma*}

	Since $ m([0,1])=1<\infty $, the tightness is trivial. We only need to show that $ f_{n} $ is uniformly integrable.

	For any $ \varepsilon>0 $, we choose a $ M>0 $ such that $
		\varepsilon \log \left( M+2 \right)>1
	$, then denote $ F_{n}=\{f_{n}\ge M\} $. Thus for $ \delta=\varepsilon/M $, we have for any $ m(E)<\delta $:
	$$
		\int_E^{}{f_n}=\int_{E\cap F_n}^{}{f_n}+\int_{E\backslash F_n}^{}{f_n}\le \frac{1}{\log \left( M+2 \right)}+Mm( E ) <2\varepsilon
	$$

	Thus we are done.
\end{proof}

\begin{problem}
Let $ f\colon\mathbb{R} \to \mathbb{R}  $ be Lebesgue integrable, such that
$$
\liminf_{\varepsilon \searrow 0}\int_{\mathbb{R}^2}^{}{\frac{|f(x)f(y) |}{|x-y|^2+\varepsilon}\mathrm{d} x\mathrm{d} y}<\infty.
$$
Prove that $f=0$ a.e.
\end{problem}

\begin{proof}
	Without loss of generality, assume that $f(x)\ge0.$\\
    By Fatou's lemma we have $$\int_{\mathbb{R}^2} \frac{f(x)f(y)}{|x-y|^2}\mathrm{d} x\mathrm{d} y \le M< \infty,$$
    where $M$ denotes the limit given above. Suppose the otherwise, there exists an $n\in \mathbb{N}^*$ such that $\mu(E:=\{x\mid f(x)\ge \frac{1}{n}\})>0$.\\  
    Then we have $$\int_{E\times E}\frac{1}{|x-y|^2} \mathrm{d} x\mathrm{d} y\le n^2M.$$
    It indicates that $\frac{1}{|x-y|^2}\chi_E(x)\chi_E(y)$is integrable, and that Fubini's theorem works.\\
    Since $\mu(E)>0$, we can take a Lebesgue density point $x\in E$ and an $r$ such that $\mu(E\cap (x-\delta,x+\delta))>\delta ,\forall \delta \in (0,r).$\\
    Thus $\int_E \frac{1}{|x-y|^2} \mathrm{d} y\ge \frac{1}{\delta}\to \infty$ as $\delta \to 0,$a contradiction to Fubini's theorem since Lebesgue density points also have positive measure.


\end{proof}

\begin{problem}
Let $ f\colon\mathbb{R} \to \mathbb{R}  $ be Lebesgue integrable. Then for $ x\in \mathbb{R}  $ a.e. the series converges:
$$
\sum_{n=1}^{\infty}\frac{1}{\sqrt{n}}f( x-\sqrt{n} ).
$$
\end{problem}

\begin{proof}
	We prove that for any $ a<b $, the series is integrable on $ [a,b] $. Observe that
	$$
	\int_a^b{\sum_{n=1}^{\infty}{\frac{1}{\sqrt{n}}f( x-\sqrt{n} )}\mathrm{d} x}=\sum_{n=1}^{\infty}{\frac{1}{\sqrt{n}}\int_a^b{f( x-\sqrt{n} ) \mathrm{d} x}}
	$$
	$$
	=\sum_{n=1}^{\infty}{\frac{1}{\sqrt{n}}\int_{\mathbb{R}}^{}{f( x ) \chi _{[ a-\sqrt{n},b+\sqrt{n} ]}\mathrm{d} x}=\int_{\mathbb{R}}^{}{f( x ) S( x ) \mathrm{d} x}}
	$$
	
	Where we denote $
	S( x ) =\sum_{n=1}^{\infty}{\frac{1}{\sqrt{n}}\chi _{[ a-\sqrt{n},b-\sqrt{n} ]}}
	$. We claim that $ S(x) $ is bounded by $ C=C(a,b) $ independent of $ x $:
	
	For any $ x\in \mathbb{R}  $, the sum is taken on those $ n $ with $ a-\sqrt{n}\le x\le b-\sqrt{n} $, namely:$$
	S\left( x \right) =\sum_{a-x\le \sqrt{n}\le b-x}^{}{\frac{1}{\sqrt{n}}}
	$$
	
	If $ a-x\le 1 $, we have
	$$
	S( x ) =\sum_{1\le n\le ( b-x ) ^2}^{}{\frac{1}{\sqrt{n}}}\le \int_0^{\left( b-x \right) ^2}{\frac{\mathrm{d} t}{\sqrt{t}}}=2( b-x ) \le 2( b-a+1 ). 
	$$
	
	If $ a-x>1 $, we have
	$$
	S( x ) =\sum_{( a-x ) ^2\le n\le ( b-x ) ^2}^{}{\frac{1}{\sqrt{n}}}\le \int_{( a-x ) ^2-1}^{( b-x ) ^2}{\frac{\mathrm{d} t}{\sqrt{t}}}
	$$
	$$
	=2\Big( ( b-x ) -\sqrt{( a-x ) ^2-1} \Big) \le 2( b-a+1 ).
	$$
	
	The last inequality by the monotonicity.
\end{proof}

\begin{problem}
Define $ f(0)=0 $, and $ f(x)=x^{2}\sin (1/x) $ for $ x\ne 0 $, then $ f $ is a function of bounded variation on $ [-1,1] $.
\end{problem}

\begin{proof}
	Trivial if you make use of Lagrange's mean value theorem.
\end{proof}

\begin{problem}
Construct a monotone increasing function $ f\colon \mathbb{R} \to \mathbb{R}  $, such that the set of continuous points of $ f $ is the complement of $ \mathbb{Q}  $.
\end{problem}

\begin{proof}
	It suffices to consider $ [0,1]\to \mathbb{R} $ and extend by $ f(x+1)=f(x)+f(1) $. Let $ R(x) $ denote the Riemann function, and define $ f(x)\colon [0,1]\to \mathbb{R}  $:
	$$
	R( x ) =
	\begin{cases}
	\frac{1}{q}, & x=\frac{p}{q}\in[0,1],p,q\in \mathbb{N},\left( p,q \right) =1\\
			0, & x\in [0,1]\backslash \mathbb{Q}
	\end{cases},f( x ) =\sum_{0\le r\le x}^{}{R^3( r )}
	$$
	
	Since $ f(x)\le f(1)=\sum \phi(n)/n^{3}<\sum 1/n^{2} $, $ f(x) $ is well defined. The monotone property is obvious. 
	
	For any $ x_{0}=p/q $, the discontinuity follows from the observation:
	$$
	\forall \delta >0,\exists x_0-\delta <x<x_0,f( x_0 ) -f( x ) \ge \frac{1}{q^3}
	$$
	
	Now for any $ x_{0}\in [0,1]\backslash \mathbb{Q}  $, we will show that $ f(x) $ is continuous at $ x_{0} $. For each $ \varepsilon>0 $, denote $ K=[1/\varepsilon]+1 $, then those $ x=p/q $ with $ q\le K $ is finite. Let $ \delta  $ be half of the minimum distance between the points and $ x_{0} $. Then for any $ x\in B(x_{0},\delta) $, we have
	$$
	|f( x ) -f( x_0 ) |\le \sum_{r\in I}^{}{R^3( r )}\le \sum_{n\ge K+1}^{}{\frac{\phi ( n )}{n^3}}\le \frac{1}{K}\le \varepsilon,
	$$
	
	where $ I $ is a close interval with end points $ x,x_{0} $.
	
\end{proof}

\begin{problem}
Let $ f\colon\mathbb{R} \to \mathbb{R}  $ be monotone increasing, $ E\subset\mathbb{R}  $ is Lebesgue measurable, For any $ \varepsilon>0 $, there exists a sequence of open intervals $ (a_{i},b_{i}) $, such that
\[
 E\subset \bigcup (a_{i},b_{i}), \sum |f(b_{i})-f(a_{i})|<\varepsilon 
\]

Then $ f'(x)=0 $ a.e. $ x\in E $.
\end{problem}

\begin{proof}
	 The monotone property implies that $ f $ is differentiable a.e. and $ f' $ is integrable. For any $ \varepsilon>0 $,
	$$
	\int_E^{}{f'( x ) \mathrm{d} x}\le \sum_{}^{}{\int_{a_{i}}^{b_{i}}{f'( x ) \mathrm{d} x}}\le \sum_{}^{}{f( b_{i} ) -f( a_{i} )}<\varepsilon 
	$$
	
	Thus $ \int_{E}f'(x)\mathrm{d} x=0 $. We have $ f'(x)=0 $ a.e. $ x\in E $.
\end{proof}

\begin{problem}
Let $ f\colon[0,1]\to [0,1] $ be a continuous bijection, but not absolutely continuous. Then there exists $ E\subset [0,1] $, such that $ m(E)=0,m(f(E))>0 $.
\end{problem}

\begin{proof}
	First we prove two lemmas.
	\begin{lemma*}
		Let $ f $ be differentiable on $ E\subset \mathbb{R}  $, and $ |f'|\le M $ on $ E $, then $ m^{*}(f(E))\le Mm^{*}(E) $.
	\end{lemma*}
	\begin{proof}
		It is a more general case of \ref{pro:keepmeasure}, thus can be proved in a similar way.
	\end{proof}
	\begin{lemma*}
		Let $ f $ be measurable on $ [a,b] $, $ E\subset [a,b] $ is measurable, and $ f $ is differentiable everywhere on $ E $, then $ m^{*}(f(E))\le \int_{E}|f'| $.
	\end{lemma*}
	\begin{proof}
		For each $ \varepsilon>0 $, denote $ E_{k}=\{x\in E:(k-1)\varepsilon\le |f'|<k\varepsilon\} $, by the first lemma we have
		$$
		m^*( f( E_k ) ) \le k\varepsilon m( E_k ) =( k-1 ) \varepsilon m( E_k ) +\varepsilon m( E_k ) \le \int_{E_k}^{}{|f'|}+\varepsilon m( E_k ) 
		$$
		
		Add them together, we obtain $
		m^*( f( E ) ) \le \int_E^{}{|f'|}+\varepsilon m( E ) 
		$, then we are done since $ \varepsilon $ was arbitrary.
	\end{proof}
	
	Back to our proof, we will first show $ f\in \mathrm {BV} $ from continuous and bijective property. Then by assuming the conclusion is false, we will prove $ f\in\mathrm{AC} $, a contradiction.
	
	We have two approaches to prove $ f\in \mathrm{BV}  $. One is that $ f $ is monotone as a continuous bijection. The other one can deal with more general cases.
	
	$
	\forall 0=x_0<x_1<\cdots <x_n=1
	$, we denote $ J_{k} $ as the close interval with endpoints $ f(x_{k-1}),f(x_{k}) $. Then by continuity, we have $
	J_k\subset f( [ x_{k-1},x_k ] ) =I_k
	$. Thus
	$$
	\sum_{k=1}^n{|f( x_k ) -f( x_{k-1} ) |}=\int_0^1{\sum_{k=1}^n{\chi _{J_k}}\mathrm{d} y}\le \int_0^1{\sum_{k=1}^n{\chi _{I_k}}\mathrm{d} y}\le 1
	$$
	
	Where we used the bijective property. In fact, even not being bijective our conclusion $ f\in \mathrm {BV} $ still holds as long as the number of every point's preimage is bounded by a same number. 
	
	Now assume $ f $ preserves zero measure. By $ f\in\mathrm{BV}  $ we know $ f' $ exists a.e. and it is integrable. 
    Hence there exists $ E\subset [0,1] $ such that $ m(E)=0 $ and $ f' $ exists everywhere in $ [0,1]\backslash E $. 
    By the assumption, $ m(f(E))=0 $. We observe that $ \forall (x,y)\subset [0,1],|f(y)-f(x)|\le m(f([x,y]))\le m^{*}(f([x,y]\backslash E))+m(f(E))\le \int _{x}^{y}|f'(t)|\mathrm{d}t  $, the last inequality by the second lemma.
	
	Now we make use of the integrablility of $ f' $ and the absolute continuity of Lebesgue integral, for any $ \varepsilon>0 $, there exists $ \delta>0 $, $ \int _{A}|f'|<\varepsilon $ as long as $ m(A)<\delta $.
	
	Finally we check the definition of absolute continuity of $ f $. For each $ \varepsilon>0 $, for any $ 0\le a_{1}<b_{1}<\cdots <a_{n}<b_{n}\le 1 $ with $ \sum (b_{k}-a_{k}) <\delta $, we have
	$$
	\sum_{k=1}^{n}{|f( b_k ) -f( a_k ) |}\le \sum_{k=1}^{n}{\int_{a_k}^{b_k}{|f'|}}=\int_{\bigcup_{k=1}^{n} ( a_k,b_k )}^{}{|f'|}<\varepsilon.
	$$
\end{proof}

\begin{problem}
Let $ f\colon[0,1]\to \mathbb{R}  $, prove the following are equivalent:
\begin{enumerate}
\item $ f\in \mathrm{AC}  $, and there exists $ h $ bounded and measurable, such that $ f'=h $ a.e.
\item There exists $ L>0 $, such that for any $ 0\le x,y\le 1 $, $ |f(x)-f(y)|\le L|x-y| $.
\end{enumerate}
\end{problem}

\begin{proof}
	$ (2)\Rightarrow (1) $: It follows easily from checking definition that $ f\in\mathrm{AC}  $. By Lebesgue differentiation theorem, $ \exists h $ measurable, $ h\colon[0,1]\to \mathbb{R}  $, such that $ h=f' $ a.e. For those differentiable points, $ |f'| $ is bounded by Lipschitz condition. 
    For the rest, just assign $ h=0 $, then $ h $ is bounded.
	
	$ (1)\Rightarrow (2) $: Since Lebesgue differentiation theorem, $ f(x)=f(0)+\int _{0}^{x}h(t)\mathrm{d} t $. Thus
	$$
	|f( y ) -f( x ) |=\bigg|\int_x^y{h( t ) \mathrm{d} t}\bigg|\le \int_x^y |h( t ) |\mathrm{d} t \le L|y-x|.
	$$
\end{proof}

\begin{problem}
Let $ f\colon\mathbb{R} ^{2}\to \mathbb{R}  $, $ f\in C^{1} $ and for any $ (x_{0},y_{0})\in \mathbb{R} ^{2} $, we have
$$
\frac{\partial f}{\partial x}+\frac{\partial f}{\partial y}\big|_{\left( x_0,y_0 \right)}\ne 0
$$

Then for $ E=\{(x,y):f(x,y)=0\} $ is a set of measure zero.

\end{problem}

\begin{proof}
	On any straight line $ y=x+t $, the directional derivative never vanishes, and also it is continuous, then $ f $ is absolutely monotone, with no more than one zero. Thus $ m(E)\le m(\{0\}\times \mathbb{R} )=0 $.
\end{proof}

\begin{problem}
Let $ E\subset \mathbb{R}  $ be measurable and $ m(E)>0 $, and $ f\colon\mathbb{R} \to \mathbb{R}  $ be non-negative Lebesgue measurable function. If $ F(x)=\int _{E}f(x-t)\mathrm{d} t $ is Lebesgue integrable on $ \mathbb{R}  $, then $ f $ is also Lebesgue integrable.
\end{problem}

\begin{proof}
	Observe by Tonelli's theorem, $ f(x-t) $ is measurable and $ f\ge 0 $ that
	$$
	\infty >\int_{\mathbb{R}}^{}{F( x ) \mathrm{d} x}=\int_{\mathbb{R}}^{}{\int_{\mathbb{R}}^{}{f( x-t ) \chi _E( t ) \mathrm{d} t}\mathrm{d} x}
	$$
	$$
	=\int_{\mathbb{R}}^{}{\chi _E( t ) \int_{\mathbb{R}}^{}{f( x-t ) \mathrm{d} x}\mathrm{d} t}=m( E ) \int_{\mathbb{R}}^{}{f( x ) \mathrm{d} x}
	$$
	
	Thus $ f $ is also Lebesgue integrable.
\end{proof}

\section*{$ L^{p} $ spaces}

\begin{problem}
Let $ f_{n}\colon[0,1]\to \mathbb{R}  $ be a sequence of Lebesgue integrable functions, and converges in measure to $ f\colon [0,1]\to \mathbb{R}  $, which is Lebesgue measurable. Moreover we have $ \Vert f_{n} \Vert_{3}\le 1 $, then $ f_{n}\to f $ in $ L^{2}([0,1]) $.
\end{problem}

\begin{proof}
	For any $ \varepsilon>0 $, there exists $ N $ such that for $ E_{n}=\{|f_{n}-f|\ge \varepsilon\} $, we have $ m(E_{n})<\varepsilon $ for any $ n>N $.
	
	$$
	\int_0^1{|f_n-f|^2}\le \int_{E_n}^{}{|f_n-f|^2}+\int_{E_{n}^{c}}^{}{|f_n-f|^2}
	$$
	$$
	\le \varepsilon ^2m( E_{n}^{c} ) +\left( \int_0^1{|f_n-f|^3} \right) ^{\frac{2}{3}}( m( E_n ) ) ^{\frac{1}{3}}
	\le \varepsilon ^2+\varepsilon ^{\frac{1}{3}}\Vert f_n-f \Vert_{3}^{2}
	$$
	
	Since $ f_{n}\to f $ in measure, there is a subsequence $ f_{n_{k}}\to f $ a.e. Thus we have
	$$
	\int_0^1{|f|^3}=\int_0^1{\liminf|f_{n_k}|^3}\le \liminf\int_0^1{|f_{n_k}|^3}\le 1,
	$$
	
	which implies $ \Vert f_n-f \Vert_{3}^{2}\le (\Vert f_{n} \Vert_{3}+\Vert f \Vert_{3})^{2}\le 4 $. Thus we are done.
\end{proof}

\begin{problem}
Let $ 1\le p<\infty $, $ f_{n},f\in L^{p} $, and $ f_{n}\to f $ a.e. Then $ \Vert f_{n}-f \Vert_{p}\to 0 \Leftrightarrow \Vert f_{n} \Vert_{p}\to \Vert f \Vert_{p} $.
\end{problem}

\begin{proof}
	If $ \Vert f_{n}-f \Vert_{p}\to 0 $, then $ |\Vert f_{n} \Vert_{p}-\Vert f \Vert_{p}|\le \Vert f_{n}-f \Vert_{p}\to 0 $, thus $ \Vert f_{n} \Vert_{p}\to \Vert f \Vert_{p} $.
	
	If $ \Vert f_{n} \Vert_{p}\to \Vert f \Vert_{p} $, we notice that $ |x|^{p} $ is lower convex, thus by Jensen's inequality we have
	$$
	\Big|\frac{f_n-f}{2}\Big|^p\le \frac{|f_n|^p+|f|^p}{2}.
	$$
	
	The right-hand side converges to $ |f|^{p} $ a.e. and its integral also converges to the integral of $ |f|^{p} $, thus by DCT we have
	$$
	\int_{}^{}{\Big|\frac{f_n-f}{2}\Big|^p}\rightarrow \int_{}^{}{0}=0,
	$$
	
	which means $ \Vert f_{n}-f \Vert_{p}\to 0 $.
\end{proof}

\begin{problem}
Let $ E,F\subset \mathbb{R}  $ be with finite Lebesgue measure.
\begin{enumerate}
\item The convolution $ \chi _{E}*\chi _{F} $ is continuous.
\item $ \chi _{E}*\chi _{F}\in L^{p}(\mathbb{R} ) $ for $ 1\le p<\infty $.
\end{enumerate}
\end{problem}

\begin{proof}
	(1) A more general case: let $ f $ be integrable, $ g $ be bounded and measurable, then $ f*g $ is continuous.
	
	We denote $
	\varPsi \colon \mathbb{R}\rightarrow L^1( \mathbb{R} ) ,x\mapsto f( x-y ) 
	$ and $
	\varPhi \colon\ L^1( \mathbb{R} ) \rightarrow \mathbb{R},h\mapsto \int_{\mathbb{R}}^{}{hg}
	$, then $ f*g=\varPhi \circ \varPsi $.
	
	Now it suffices to show both $ \varPhi $ and $ \varPsi $ are continuous.
	
	For $ \varPhi $, it is trivial by that $ g $ is bounded and measurable.
	
	For $ \varPsi $, we observe that as $ h\to 0 $, we have
	$$
	\int_{\mathbb{R}}^{}{|f( x-y ) -f( x+h-y ) |\mathrm{d} y}=\int_{\mathbb{R}}^{}{|f( y-h ) -f( y ) |\mathrm{d} y}\rightarrow 0
	$$
	
	Which is a common proposition used very common, for instance in the proof of the density of $ C_{c}$ in $ L^{p} $.
	
	(2) Since $ \chi _{E}\in L^{1},\chi _{F}\in L^{p} $, we have $ \chi _{E}*\chi _{F}\in L^{p}(\mathbb{R} ) $.
\end{proof}

\begin{problem}
Let $ f\colon[0,1]\to \mathbb{R}  $ be Lebesgue measurable, and for any $ g\in L^{2}[0,1] $, we have $ fg\in L^{2}([0,1]) $, then $ f\in L^{\infty }([0,1]) $.
\end{problem}

\begin{proof}
	If $ f\notin L^{\infty }([0,1]) $, then for $ E_{n}=\{n\le |f|<n+1\} $, we have $ m(E_{n})>0 $ frequently. Take a subsequence while not changing the notion, we have $ f\ge \sum_{n=1}^{\infty}n\chi_{E_{n}} $, and then $ f^{2}\ge \sum_{n=1}^{\infty}n^{2}\chi_{E_{n}} $.
	
	Let $ g=\sum_{n=1}^{\infty}{\frac{\chi _{E_n}}{n\sqrt{m\left( E_n \right)}}} $, then $
	\int_0^1{g^2}=\sum_{n=1}^{\infty}{\frac{1}{n^2}}<\infty 
	$, $ g\in L^{2}([0,1]) $. But $
	\int_0^1{f^2g^2}\ge \sum_{n=1}^{\infty}{1}=\infty 
	$.
\end{proof}

\begin{problem}
Let $ f\colon\mathbb{R} \to \mathbb{R}  $ be Lebesgue integrable, then $$
\lim_{h\rightarrow 0}\int_{\mathbb{R}}^{}{|f( x+h ) -f( x ) |\mathrm{d} x}=0.
$$
\end{problem}

\begin{proof}
%    (afsd) It is quite routine and common in analysis. Use the density of $\mathrm{C}_c^\infty(\mathbb{R})$ in $L^1(\mathbb{R})$.

	Since in our system the density of $\mathrm{C}_c^\infty(\mathbb{R})$ in $L^1(\mathbb{R})$ was proved through this proposition, we have to prove it in another way, otherwise we will fall into circular argument. So you are invited to consult related books for answers.
\end{proof}

\begin{problem}
Let $ f_{n},f \colon[0,1]\to \mathbb{R}  $ be Lebesgue integrable, and $ f_{n}\to f $ in $ L^{1}([0,1]) $.
\begin{enumerate}
\item There exists a subsequence $ f_{n_{k}} $ that converges to $ f $ a.e.
\item Show by a example that `a.e.' can not be replaced with `uniformly'.
\end{enumerate}
\end{problem}

\begin{proof}
	(1) It suffices to show $ f_{n}\to f $ in measure. For any $ \eta>0 $, we denote $ E=\{|f_{n}-f|\ge\eta \} $, then observe
	$$
	\int_0^1{|f_n-f|\mathrm{d} x}\ge \int_E^{}{|f_n-f|\mathrm{d} x}\ge \eta m( E ), 
	$$
	
	which forces $ m(E) $ to be null.
	
	(2) Let $
	f_n=n\chi _{[ 0,\frac{1}{n} ]},f=0
	$, then for any subsequence $ f_{n_{k}} $, we have $
	|f_{n_{k}}( 0 ) -f( 0 ) |=n_{k}
	$.
\end{proof}

\begin{problem}
Let $ f\colon\mathbb{R} \to \mathbb{R}  $ be a Lebesgue measurable bijection, and $ f(x+y)=f(x)+f(y) $, then $ f $ is continuous.
\end{problem}

\begin{proof}
	Using Lusin's theorem, there exists a compact $ K\subset[0,1] $ such that $ m(K)>2/3 $	and $ f $ continuous on $ K $. 
    Let $ \varepsilon>0 $. In fact, $ f $ is uniformly continuous on $ K $, so there exists $ \delta>0 $ such that $ |x-y|<\delta $ implies $ |f(x)-f(y)|<\varepsilon $	; 
    without loss of generality, suppose $ \delta<1/3 $.
	
	Let $ 0<h<\delta $. Notice that the intersection between $ K $ and $ K-h $ is nonempty; otherwise
	$$ 1+h= \mu([-h,1]) \geq \mu(K \cup K-h)= \mu(K)+\mu(K-h)=2\mu(K)>4/3 $$
	
	So $ h>1/3 $ whereas $ h<\delta<1/3 $ by assumption.
	
	Let $ x_{0}\in K\cap (K-h) $. We have $ |f(x_{0}+h)-f(x_{0})|<\varepsilon $, hence $ |f(h)|<\varepsilon $ because $f$ is additive. You deduce that $ f $ is continuous at $ 0 $.
	
	Finally, it is straightforward to conclude that $ f $ is continuous on $ \mathbb{R}  $.
\end{proof}

\begin{problem}
$ f \colon[0,1]\to \mathbb{R}  $ be absolutely continuous, and $ f'\in L^{2}([0,1]) $, then there exists a constant $ C >0$ such that for any $ 0\le x\le y\le 1 $, we have $ |f(x)-f(y)|\le C\sqrt{y-x} $.
\end{problem}

\begin{proof}
	$$
	|f( x ) -f( y ) |=\bigg|\int_x^y{f'( t ) \mathrm{d} t}\bigg|\le \int_x^y{|f'( t ) |\mathrm{d} t}\le \int_0^1{|f'( t ) |^2\mathrm{d} t}\sqrt{y-x}
	$$
	
	Where we used the Hölder's inequality.
\end{proof}

\begin{problem}
Let $ H $ be the set of every absolutely continuous functions $ f\colon [0,1]\to \mathbb{R}  $ that satisfies
\[
 \Vert f \Vert_{H}:=\Vert f \Vert_{2}+\Vert f' \Vert_{2}<\infty. 
\]

Then $ (H,\Vert \cdot \Vert_{H}) $ is Banach space.
\end{problem}

\begin{proof}
	It is obvious that $ \Vert \cdot \Vert_{H} $ is a norm. Then it suffices to check any Cauchy sequence converges to some point in $ H $.
	
	If $ f_{n} $ is Cauchy in $ H $, then $ f_{n} $ and $ f_{n}' $ are both Cauchy in $ L^{2}([0,1]) $. Thus we assume $ f_{n}\to f,f_{n}'\to g $ in  $ L^{2}([0,1]) $. To show $ f_{n}\to f $ in $ H $, we must check $ f'=g $ a.e.
	
	Since $ f_{n}\in AC $, we have
	$$ f_{n}(x)=f_{n}(0)+\int_{0}^{x}f_{n}'(t)\mathrm{d} t $$
	
	In the following we will deduce $
	f( x ) =f( 0 ) +\int_0^x{g( t ) \mathrm{d} t}
	$ from it, which implies $ f'=g $ a.e. 
	
	Since $ f_{n}\to f $ in $ L^{2}([0,1]) $, we have a subsequence $ f_{n_{k}}\to f $ a.e.
	
	By Holder's inequality we have
	$$
	\bigg|\int_0^x{f_n'( t ) \mathrm{d} t}-\int_0^x{g( t ) \mathrm{d} t}\bigg|\le \sqrt{x}\int_0^x \big( f_n'( t ) -g( t ) \big) ^2\mathrm{d} t\rightarrow 0
	$$
	
	Thus we are done by taking the limit in the subsequence.
\end{proof}

\begin{problem}
Let $ f\colon\mathbb{R} \to \mathbb{R}  $ be a Lebesgue integrable, and for any $ \varphi\colon\mathbb{R} \to \mathbb{R}  $ such that $ \varphi\ge 0 $ is bounded and continuous, we have $ \int\varphi f\ge 0 $. Then $ f\ge 0 $ a.e.
\end{problem}

\begin{proof}
	If $ f<0 $ on $ E $ with $ m(E)>0 $, then $ \int _{E}f=-A<0 $, where $ A>0 $.
	
	By the absolutely continuity of the integral of $ |f| $, $\exists \delta>0 $, and $ \int _{T}|f|<A/2 $ as long as $ m(T)<\delta $.
	
	Using Lusin's theorem, there exists $ h\colon \mathbb{R} \to [0,1] $ continuous, such that for $ F=\{h\ne \chi _{E}\} $, we have $ m(F)<\delta $. Then $ |\int(h-\chi_{E})f|\le \int _{F}|f|<A/2 $. 
    Hence $ \int hf=\int (h-\chi_{E})f+\int \chi_{E}<A/2+(-A)=-A/2<0 $.
\end{proof}

\begin{problem}
Let $ f_{n}\in L^{2}([0,1]) $, and constants $ A,B $ such that for each $ n $, the following holds:
$$ 0<A<\Vert f_{n} \Vert_{1}\le \Vert f_{n} \Vert_{2}<B. $$

Let a sequence of non-negative reals $ c_{n} $ such that for $ F(x)=\sum_{1}^{\infty}|c_{n}f_{n}(x)| $, we have $ F(x)<\infty $ a.e. Denote $ E_{n}=\{F(x)>n\} $, prove the following:
\begin{enumerate}
\item
$
 \lim_{n\rightarrow \infty}m( E_n ) =0
$.
\item
$
 \int_{E_n}^{}{|f_{k}( x ) |\mathrm{d} x}\le B\sqrt{m(E_n)}
$.
\item 
$
 \sum_1^{\infty}{c_k}<\infty 
$.
\end{enumerate}
\end{problem}

\begin{proof}
(1)
$
\lim_{n\rightarrow \infty}m( E_n ) =m( \bigcap_{n=1}^{\infty}{E_n} ) =m( \{ F( x ) =\infty \} ) =0.
$
	
(2)
$
\int_{E_n}^{}{|f_k|}\le \left( \int_{E_n}^{}{|f_k|^2} \right) ^{\frac{1}{2}}\left( \int_{E_n}^{}{1^2} \right) ^{\frac{1}{2}}\le \Vert f \Vert_2\sqrt{m( E_n )}\le B\sqrt{m( E_n )}.
$

(3)%This proposition seems to call for a probabilistic approach(three-series theorem), which I haven't yet mastered.
%
%(afsd) It seems unrelated to Kolmogorov three-series theorem since there is no concept like "independence" in such a problem.

%Note that $A$ must be strictly positive, otherwise there are counterexamples.
From (2) we know that $\int_{E_n^c}|f_k(x)|\mathrm{d}x \ge A-B\sqrt{m(E_n)}$. 

By (1), there exists a sufficiently large $n$ such that $\int_{E_n^c}|f_k(x)|\mathrm{d}x \ge A/2 >0 $.

Now sum the above inequalities over all $k\ge 1$ with weights $c_k$. This leads to the following:
$$\int_{E_n^c}|F(x)|\mathrm{d}x\ge \frac{A}{2} \sum\limits_{k\ge 1}c_k.$$
But the left hand side is finite according to the choice of $E_n$, so $\sum\limits_{k\ge 1}c_k<\infty.$
\end{proof}

\begin{problem}
Let $ \mathcal{F}  $ be a nonempty set of some Lebesgue integrable functions on $ \mathbb{R}  $ that satisfies the following:
\begin{itemize}
\item If $ f,g\in \mathcal{F}  $, set $ h(x)=\max(f(x),g(x)) $, then $ h\in \mathcal{F}  $.
\item $\displaystyle{
 M=\sup\left\{ \int_{\mathbb{R}}^{}{f( x ) \mathrm{d} x} \right\} <\infty
}$.
\end{itemize}
Then there exists $ \varphi $ such that the following holds:
\begin{itemize}
\item For any $ f\in \mathcal{F}  $, $ f\le \varphi $ holds a.e.
\item $ \int_{\mathbb{R} }\varphi=M $.
\end{itemize}
\end{problem}

\begin{proof}
	Select a sequence $ \{f_{n}\} $ in $ \mathcal{F}  $ such that $ \int f_{n}\to M $. Then let $ g_{n}=\max(f_{1},\cdots,f_{n}) $, and $ \varphi=\sup f_{n} $, we have for any fixed $ x $, $ g_{n}(x) $ increases to $ \varphi(x) $. Thus $ \lim \int g_{n}=\int \varphi $. But on one hand $ g_{n}\in \mathcal{F} \Rightarrow \int g_{n}\le M \Rightarrow \lim \int g_{n} \le M $, on the other hand $ g_{n}\ge f_{n} \Rightarrow \lim \int g_{n}\ge \lim \int f_{n}=M $. Thus $ \int \varphi=M $.
	
%	As for the first property, I haven't found an elegant proof yet.

%    (afsd) 
    If there is some $ f \in \mathcal{F} $ such that $ f> \varphi $ on a positive measure, consider $ h_n=\max(g_n,f) \in \mathcal{F}$.
    
    By the constructions above, $(h_n)_{n\ge 1}$ is an increasing sequence of functions
    and thus converges pointwise to a function $h$.
    
    Since by the given condition that $ \int h_n \le M $ and the fact that $h_n\ge h_1$ where $h_1$ is integrable,
    the monotone convergence theorem holds for $(h_n)_{n\ge 1}$ and thus $ \int h \le M $.

    However, $h>\varphi$ on a positive measure and $h\ge \varphi$ everywhere. These imply that 
    $$M \ge \int h> \int \varphi =M,$$
    which is absurd.   

    (Proof by contradiction is not necessary, but it is shorter.)
\end{proof}

\begin{problem}
Let $ A=(a_{ij})_{1\le i,j\le n} $ be an $ n- $order real square symmetric matrix, and $ f( x_1,x_2,\cdots ,x_n ) =\exp \left( -\sum_{j,k=1}^n{x_{jk}a_ja_k} \right)  $.
\begin{enumerate}
\item Prove that $ f\in L^{1}(\mathbb{R} ^{n}) $ iff $ A $ is positive definite.
\item Assuming $ A $ is positive definite, compute $ \int_{\mathbb{R} ^{n}}f(x)dx $.
\end{enumerate}
\end{problem}

\begin{proof}
	\begin{enumerate}
	\item Since $ A $ is real and symmetric, it can be orthogonal diagonalized. Assume $ Q $ is orthogonal with $ \det Q=1 $, such that $ QAQ^{-1}=D=\mathrm{diag} \{\lambda_{1},\lambda_{2},\cdots,\lambda_{n}\} $, where each $ \lambda_{i} $ is an eigenvalue of $ A $.
	
	Then $ f(x)=\exp(-x^{T}Ax)=\exp(-x^{T}Q^{T}DQx)=\exp(-y^{T}Dy) $, where we denote $ y=Qx $.
	
	Thus 
	$$
	\int_{\mathbb{R}^n}^{}{f( x ) \mathrm{d} x}=\int_{\mathbb{R}^n}^{}{\exp \left( -y^TDy \right) \mathrm{d} x}=\int_{\mathbb{R}^n}^{}{\exp \left( -y^TDy \right) \mathrm{d} y}=\int_{\mathbb{R}^n}^{}{\exp \left( -\sum_{k=1}^n{\lambda _ky_{k}^{2}} \right) \mathrm{d} y_1\cdots \mathrm{d} y_n}.
	$$
	
	Therefore, $ f\in L^{1}(\mathbb{R} ^{n}) $ iff $ \forall i=1,2,\cdots n,\lambda_{i}>0  $ iff $ A $ is positive definite.
	\item By the above discussions, using Tonelli's theorem we have 
	$$
	\int_{\mathbb{R}^n}^{}{f( x ) \mathrm{d} x}=\int_{\mathbb{R}^n}^{}{\exp \left( -\sum_{k=1}^n{\lambda _ky_{k}^{2}} \right) \mathrm{d} y_1\cdots \mathrm{d} y_n}=\prod_{k=1}^n{\int_{\mathbb{R}}^{}{\exp \left( -\lambda _kt^2 \right) \mathrm{d} t}}=\sqrt{\frac{\pi^{n}}{\det A}}.
	$$
	\end{enumerate}
\end{proof}