\newcommand{\supp}{\operatorname{supp}}
\newcommand{\M}{\mathscr{M}}
\setdisplaytitle{现代分析基础I概要}
\sethtmltitle{现代分析基础I概要}
\section{Fourier级数}
\subsection{基本性质}
命题[Grafakos, gtm249, 命题3.1.2]
\subsection{Dirichlet和, Cesàro和, Abel和}
定义.
    Dirichlet和
    $$S_N(f):=\sum_{|k|\leq N}\hat{f}(k)e^{2 \pi ikx}.$$
    Cesàro和
    $$\sigma_N(f)=\frac{\sum_{k=0}^NS_k(f)}{N+1}.$$
    Abel和
    $$A_r(f)(x)=\sum_{k\in \mathbb{Z}}\hat{f}(k)r^{|k|}e^{2\pi ikx},\ 0<r<1.$$

引理. [Grafakos, gtm249, 3.1]
    (i) $S_N(f)=D_N*f$,其中
    $$D_N(x)=\sum_{|k|\leq N}e^{2 \pi ikx}
    =\frac{\sin(2N+1)\pi x}{\sin \pi x}.$$
    (ii) $\sigma_N(f)=F_N*f$,其中
    $$F_N(x)=\frac{\sum_{k=0}^ND_k(f)}{N+1}
    =\frac{1}{N+1}\left(\frac{\sin (N+1)\pi x}{\sin  \pi x}\right)^2.$$
    (iii) $A_r(f)=P_r*f$,其中
    $$P_r(x)=\sum_{k\in \mathbb{Z}}r^{\left\vert k \right\vert }e^{2\pi ikx}
    =\frac{1-r^2}{1-2r\cos (2\pi x)+r^2}.$$

定义.
    称$\{ K_N \}_{N\in\mathbb{N}}$为逼近恒等，若

    (i) $\int K_N=1,\forall N\in \mathbb{N}$;
    (ii) $\sup_{N}\|K_N\|_{L^1}<\infty$;
    (iii) $\forall \eta>0,\int_{|x|>\eta}|K_N(x)| \,\mathrm{d}x\to 0, N\to \infty$.
    
    称$\{ K_\varepsilon \}_{\varepsilon>0}$为逼近恒等，若

    (i) $\int K_\varepsilon=1,\forall \varepsilon>0$;
    (ii) $\sup_{\varepsilon>0}\|K_\varepsilon\|_{L^1}<\infty$;
    (iii) $\forall \eta>0,\int_{|x|>\eta}|K_N(x)| \,\mathrm{d}x\to 0, \varepsilon\to 0$.

命题. (Minkowski不等式) [Grafakos, gtm249, 定理1.2.10]：
    $1\leq p\leq \infty,f\in L^p(\mathbb{R}^n),g\in L^1(\mathbb{R}^n)$,
    则$f*g$几乎处处有定义，且
    $$\|f*g\|_{L^p}\leq \|f\|_{L^p}\|g\|_{L^1}.$$

定理. [Grafakos, gtm249, 定理1.2.19]：若$K_\varepsilon$为逼近恒等，则
    (i) $1\leq p<\infty$,则
    $$\|K_\varepsilon*f-f\|_{L^p(\mathbb{R}^n)}\to 0,\ \varepsilon \to 0.$$
    (ii) $f$在$E$上有界且一致连续，则在$E$上$K_\varepsilon *f$一致收敛到$f$.
    特别地，若$f$在$x_0$连续，则$$K_\varepsilon*f(x_0)\to f(x_0).$$

注：上述定理对于局部紧群上的逼近恒等也成立，如$\mathbb{T}$.




\subsection{点态收敛}
定理：$\{ F_N \}_{N\in \mathbb{N}}$是逼近恒等.

练习：$\{ D_N \}_{N\in \mathbb{N}}$不是逼近恒等.

定理：三角多项式在$C(\mathbb{T})$中稠密.

引理(Riemann--Lebesgue)
对$f\in L^1(\mathbb{T})$, $\hat{f}(k)\to0,k\to \infty.$

推论：对$f\in C^\alpha(\mathbb{T})$,我们有$\hat{f}(k)=o(|k|^{-\alpha})$.

命题：$f,g\in L^1(\mathbb{T})$,若$\hat{f}=\hat{g}$,则$f=g,a.e.$

命题：$f\in L^1(\mathbb{T}),\sum |\hat{f}(k)| < \infty$,
则$\sum \hat{f}(k)e^{2\pi ikx}=f ,a.e.$

命题：$f\in C^2(\mathbb{T}),$则$\sum \hat{f}(k)e^{2\pi ikx}=f ,a.e.$

\subsection{范数收敛与$L^2$可和性}
定理[Grafakos, gtm249, 命题3.2.7]：
(i) (Plancherel等式)$$\|f\|^2_{L^2(\mathbb{T})} 
=\sum_{k\in\Z} |\hat{f}(k)|^2.$$

(ii) $\sum_{|k|\leq N} \hat{f}(k)e^{2\pi ikx}$在$L^2$中收敛到$f$.

(iii)$$\int _{\mathbb{T}}f(x)\overline{g(x)}
=\sum_{k\in\Z} \hat{f}(k)\overline{\hat{g}(k)}.$$

(iv) $\mathcal{F}\colon f\mapsto\{ \hat{f}(k) \}_{k\in \mathbb{Z}}$
是$L^2(\mathbb{T})$到$l^2(\mathbb{Z})$的等距同构.

(v)$$\widehat{fg}(k)=\sum_{m\in \mathbb{Z}}\hat{f}(k-m)\hat{g}(m).$$

定理：设$f\in L^1(\mathbb{T}),f$在$x_0$可微，则
$$S_N(f)(x_0):=D_N*f(x_0)\to f(x_0).$$

推论：$f\in C^1(\mathbb{T})$,则$S_N(f)(x)\to f(x),x\in \mathbb{T}.$

推论：$f,g\in L^1(\mathbb{T}),f,g$在$x_0$的小邻域相等，
则$S_N(f)(x_0)-S_N(g)(x_0)\to 0.$

定理：存在$f\in C(\mathbb{T}),$使得
$\limsup_{N\to \infty}|S_N(f)(0)|=\infty$.

\subsection{Hardy--Littlewood极大函数}
定义：中心极大函数（字体更接近于𝓜$(f)$，公式里打不出来）
$$\mathcal{M}(f)(x)=\sup_{r>0}\frac{1}{|B(x,r)|}\int_{B(x,r)}|f(y)|\,\mathrm{d}y=\sup_{r>0}A_r(\vert f\vert )(x).$$
非中心极大函数
$$M(f)(x)=\sup_{x\in B}\frac{1}{|B|}\int_B |f(y)|\,\mathrm{d}y.$$
定理[Grafakos, gtm249, 定理2.1.6]：$1<p\leq \infty$,
则$M,\mathcal{M}$在$L^p(\mathbb{R}^n)$上有界，在$L^1(\mathbb{R}^n)$上弱有界.\\
定理的证明需要用到引理[Grafakos, gtm249, 引理2.1.5]：(Vitali)
$\{ B_1, \ldots ,B_k \}$为$\mathbb{R}^n$中$i$个球，
则存在一个两两不交的子族$\{ B_{i_1}, \ldots ,B_{i_l} \}$使得
$$\sum _{j=1}^l|B_{i_j}| \geq 3^{-n}|\cup_{i=1}^k B_i|.$$
及定理(Marcinkiewicz插值定理) [Grafakos, gtm249, 定理1.3.2].

定理：$\varphi(x):=(1+|x|)^{-n-1},
\varphi_\varepsilon(x)=\varepsilon^{-n}\varphi(\varepsilon^{-1}x)$，
则对$f\in L^1_{\text{loc}}(\mathbb{R}^n)$,
$$T_*(f)(x):=\sup_{\varepsilon>0}|(\varphi_\varepsilon*f)(x)|\leq CM(f)(x).$$
定理：$0<p,q<\infty,T_\varepsilon(f)(x):=(\varphi_\varepsilon*f)(x),$
设存在$B>0$,使得
$$\|T_*(f)\|_{L^{q,\infty}}\leq B\|f \|_{L^p},\forall f\in L^p.$$
$D$为$L^p$的一个稠子空间，满足对$f\in D$，
$$\lim_{\varepsilon \to 0}T_\varepsilon(f)=T(f)$$存在且几乎处处有限，
则对于任意$f\in L^p$,上述极限存在，且几乎处处有限，且定义了一个$L^p$上的算子$T$,满足
$$\|T(f)\|_{L^{q,\infty}} \leq B\|f\|_{L^p}.$$

定理(Lebesgue微分定理)

定理：对于$f\in L^1(\mathbb{T})$,
$\mathscr{H}(f)=\sup_{N\in \mathbb{Z}^+}|f*F_N|$.
则$\mathscr{H}$弱$(1,1)$有界，强$(p,p)$有界.
从而，对$f\in L^1(\mathbb{T}),$当$N\to \infty$, $F_N*f\to f,a.e.$

\subsection{Fourier变换}
定义：Schwartz空间及其拓扑.

性质：Fourier变换的基本性质.

定义：Fourier逆变换.

命题：Fourier变换可延拓到$L^2(\R^n)$上,从而延拓到$L^p(\R^n)$上，$1<p<2$.

命题(Hausdorff--Young不等式)：对$f\in L^p(\mathbb{R}^n),1\leq p\leq 2,$我们有
$$\|\hat{f} \|_{L^{p'}}\leq \|f\|_{L^p}.$$

定义：缓增分布.

命题：缓增分布的半范数刻画. [Grafakos, gtm249, 命题2.3.4]

例：Dirac分布的Fourier变换是$1$; $L^p \subseteq \mathscr{S}'$.

定义：分布的导数及卷积.

性质：[Grafakos, gtm249, 命题2.3.22].

\subsection{Poisson求和公式}
定理[Grafakos, gtm249, 定理3.2.8]：
$f$为$\mathbb{R}^n$上的连续函数，满足存在$C,\delta>0$,
$$|f(x)|\leq C(1+|x|)^{-n-\delta},\ x\in \mathbb{R}^n,$$
且它的Fourier变换在$\mathbb{Z}^n$上的限制满足
$$\sum _{m\in \mathbb{Z}^n}|\hat{f}(m)| <\infty.$$
则
$$\sum_{m\in \mathbb{Z}^n} \hat{f}(m)e^{2\pi im\cdot x}
=\sum_{k\in \mathbb{Z}^n}f(x+k),$$
特别地$$\sum_{m\in \mathbb{Z}^n} \hat{f}(m)=\sum_{k\in \mathbb{Z}^n}f(k).$$

\subsection{范数收敛性}
定理：$1\leq p<\infty$,则以下等价：
(i) $S_N(f)$在$L^p(\mathbb{T}^n)$中收敛到$f$;
(ii) $\sup_{N\in\Z^+}\|S_N\|_{L^p\to L^p}<\infty.$

注：$S_N(f)$在$C(\mathbb{T}^n)$中收敛到$f$当且仅当
$\sup_{N}\|S_N\|_{C(\mathbb{T}^n)\to C(\mathbb{T}^n)}<\infty$.

推论：Dirichlet 核在$C(\mathbb{T}^n)$与$L^1(\mathbb{T}^n)$中不收敛.

\section{乘子的转移}
[Grafakos, gtm249, 2.5; 4.3]

定义：对定义在$\mathbb{T}^n$上的函数$f$,记
$$S_N(f)=\sum_{k\in \mathbb{Z}^n}\chi_{B(0,N+1)}(k)\hat{f}(k)e^{2\pi ik\cdot x},$$
$$\sigma_N(f)=\sum_{k\in \mathbb{Z}^n}\Big(1-\frac{|k|}{N+1}\Big)_+\hat{f}(k)e^{2\pi ik\cdot x}.$$

定义：对于$b=\{ b_k \}_{k\in \mathbb{Z}^n}$,记
$$S_b(f)(x):=\sum_{k\in \mathbb{Z}^n}b_k \hat{f}(k)e^{2\pi ik\cdot x}.$$
称$b$为$\mathbb{T}^n$上的$L^p$-乘子，若
$$\|S_b\|_{L^p(\mathbb{T}^n)\to L^p(\mathbb{T}^n)}<\infty.$$
并将$L^p$-乘子全体记作$\M_p(\mathbb{Z}^n)$.

定理：$1<p<\infty,\frac{1}{p}+\frac{1}{p'}=1.$则
(i) $b\in \M_p(\mathbb{Z}^n)\Leftrightarrow b\in \M_{p'}(\mathbb{Z}^n)$;
(ii) $b\in \M_p(\mathbb{Z}^n)\Rightarrow b\in l^\infty(\mathbb{Z}^n)$;
(iii) $b\in \M_2(\mathbb{Z}^n)\Leftrightarrow b\in l^\infty(\mathbb{Z}^n)$.

定义：$$T_m(f)(x):=\int_{\mathbb{R}^n}m(\xi)\hat{f}(\xi)e^{2\pi i x\cdot\xi}\mathrm{d}\xi.$$
称$m$为$\mathbb{R}^n$上$L^p$-乘子，若
$$\|m\|_{\M_p(\mathbb{R}^n)}:=\|T_m\|_{L^p(\mathbb{R}^n)\to L^p(\mathbb{R}^n)}<\infty.$$

定理：$1<p<\infty,\frac{1}{p}+\frac{1}{p'}=1$,则
(i) $b\in \M_p(\mathbb{R}^n)\Leftrightarrow b\in \M_{p'}(\mathbb{R}^n)$;
(ii) $b\in \M_2(\mathbb{R}^n)\Leftrightarrow b\in L^\infty(\mathbb{R}^n)$;
(iii) $b\in \M_p(\mathbb{R}^n)\Rightarrow b\in \M_2(\mathbb{R}^n)$.

定理：$1<p<\infty,m\in \M_p(\mathbb{R}^n)$连续，
则$\{ m(k) \}_{k\in \mathbb{Z}^n}\in \M_p(\mathbb{Z}^n)$且
$$\Vert \{ m(k) \}_{k\in \mathbb{Z}^n}\Vert _{\M_p(\mathbb{Z}^n)}
\leq \Vert m\Vert _{\M_p(\mathbb{R}^n)}.$$

定义：称有界函数$b$在$x_0$正则，若
$$\lim_{\varepsilon \to 0}\frac{1}{\varepsilon^n}\int (b(x_0+t)-b(x_0))\,\mathrm{d}t=0.$$

注：上述定理的条件可以减弱到$m$在格点处正则.

定理：$1<p<\infty,m\in C(\mathbb{R}^n)$,
$A=\sup_{\varepsilon>0}\|\{ m(\varepsilon k) \}_{k\in \mathbb{Z}^n}\|_{\M_p(\mathbb{Z}^n)} <\infty$.
则$m\in \M_p(\mathbb{R}^n),\|m\|_{\M_p(\mathbb{R}^n)}\leq A$.

注：上述命题在$m$有界且局部Riemann可积的条件下也成立.

推论：$1<p<\infty,$则$S_N(f)$在$L^p$中收敛到$f$当且仅当
$\chi_{B(0,1)}\in \M_p(\mathbb{R}^n)$.

定理：当$n=1$,上述推论的结论成立.

\subsection{Bochner--Riesz平均}

定义：$f\in L^1(\mathbb{T}^n)$的Bochner--Riesz平均为
$$B^\lambda_R(f)(x):=\sum_{k\in \mathbb{Z}^n}
\bigg(1-\frac{|k|^2}{R^2}\bigg)_+^\lambda \hat{f}(k)e^{2\pi ik\cdot x}.$$

推论：$1<p<\infty, \lambda\geq 0,(1-\left\vert \xi \right\vert ^2)_+^\lambda\in \M_p(\mathbb{R}^n)
\Leftrightarrow B^\lambda_R(f)$在$L^p(\mathbb{T}^n)$中收敛到$f$.

注：$1<p<\infty,\lambda \geq 0$,则$(1-\left\vert \xi  \right\vert ^2)^\lambda_+\in \M_p(\mathbb{R}^n) 
\Leftrightarrow (1-\left\vert \xi  \right\vert )^\lambda_+\in \M_p(\mathbb{R}^n)$.

此命题的证明可能需要用到[Grafakos, gtm249, 6.2.3节]的内容，
即$(1+\left\vert \xi  \right\vert )^{\pm \lambda}\psi(\xi)$
为H\"{o}rmander乘子，其中$\psi$紧支光滑.

定义：$1<p<\infty,\lambda> \frac{n-1}2$,重新定义
$$ B_R^\lambda (f)(x)=(K_R^\lambda *f)(x),$$
其中$K_R^\lambda(\xi)= \big((1-\frac{|\xi|^2}{R^2})_+^\lambda\big)^\vee $,
则$B^\lambda_R(f)\to f, a.e.,\forall f\in L^p(\mathbb{R}^n)$.

证明需要用到引理：$\big|K^\lambda(x)\big|\lesssim \langle x \rangle ^{-\frac{n+1}2-\lambda}$,
其中$K^\lambda=K^\lambda_1$.

引理的证明可以参考[Grafakos, gtm249, 附录B.5]. 这里给出一个另外的证明：

利用积分的球对称性并将重积分化为累次积分，不难得到
$$K^\lambda(x)=C\int _{0}^{\frac{\pi}{2}} (\sin \theta)^{n+2\lambda} 
e^{-2\pi i\cos \theta \left\vert x \right\vert }\mathrm{d}\theta,$$
再利用振荡积分的知识可以得到相应的衰减估计.

Bochner--Riesz猜想：$\lambda>0,
p\in \big(\frac{2n}{n+1+2\lambda},\frac{2n}{n-1-2\lambda}\big)$,则
$\Vert B^\lambda_1 f\Vert _{L^p}\lesssim \Vert f\Vert _{L^p}.$

定理：若Bochner--Riesz猜想的结论成立，则必有
$p\in \big(\frac{2n}{n+1+2\lambda},\frac{2n}{n-1-2\lambda}\big)$.

\section{圆盘乘子}
[主要参考Stein, Harmonic Analysis, P434起]
\subsection{Kakeya针问题与Kakeya集}
定理：$l$为$\mathbb{R}^2$中的单位线段，
则$\forall \varepsilon>0$，存在包含$l$的集合$F$, $|F|<\varepsilon$，
使得我们可以通过在$F$中的连续运动来反转$l$.

定义：称$\mathbb{R}^n$中紧集$K$为Kakeya集，若它包含任意方向的单位线段.

定理：$\mathbb{R}^2$中存在零测Kakeya集.

定理的证明需要用到引理：对任一Kakeya集$E,\varepsilon,\delta>0$,
存在Kakeya集$F$，$|F|<\delta$，使得
$$F \subseteq E(\varepsilon):=\{   y:\exists x\in E,|y-x| <\varepsilon \}.$$

\subsection{球乘子}

定理(Fefferman,1971)：当$n\geq 2$,
$\chi_{B(0,1)}\in \M_p(\mathbb{R}^n)\Leftrightarrow p=2$.

定理的证明需要用到[Stein, Harmonic Analysis, P434] Besicovitch集的构造，
及一系列引理，完整证明可参考
[\textit{The multiplier problem for the ball}, Charles Fefferman, 
Annals of Mathematics, Second Series, Vol. 94, No. 2 (Sep., 1971), pp. 330-336, 
\href{https://www.jstor.org/stable/1970864}{access}].

\section{不确定性原理}

定理[Grafakos, gtm249, Theorem 2.3.21]：
$f\neq 0\in C_c^\infty(\mathbb{R}^n)$，则$\hat{f}$不是紧支的.

定理：$f\in \mathscr{S}(\mathbb{R})$，$x_0,\xi_0\in \mathbb{R}$，则
$$\|f\|^2_{L^2(\mathbb{R})}\leq 4\pi \|(\,\cdot -x_0)f\|_{L^2(\mathbb{R})}\cdot 
\|(\,\cdot -\xi_0)\hat{f}\|_{L^2(\mathbb{R})},$$
等号成立当且仅当$f(x)=Ae^{2\pi i \xi_0x-B\pi (x-x_0)^2}.$

定理：$f\in L^2(\mathbb{R}^n),\operatorname{supp} \hat{f} \subseteq B(0,R)$,则$f\in C^\infty$, 
$$\Vert D^\alpha f\Vert _{L^2(\mathbb{R}^n)}
\leq (2\pi R)^{|\alpha|}\|f\|_{L^2(\mathbb{R}^n)}.$$

以下主要参考[Thomas H. Wolff: Lectures on Harmonic Analysis (2003), Chapter 5]
引理：存在$\varphi\in \mathscr{S}(\mathbb{R}^n)$满足，
对于满足$\supp\hat{f} \subseteq B(0,R)$的$f\in L^1+L^2$,
都有$f=\varphi_{R^{-1}}*f$,其中$\varphi_{R^{-1}}(x)=R^n\varphi(Rx).$

定理：在上述引理的条件下，我们有
(i) $\forall \alpha\in \mathbb{N}^n, p\in [1,\infty]$,
则$\|D^\alpha f\|_{L^p}\lesssim_\alpha R^{|\alpha|}\|f\|_{L^p}$；
(ii) $1\leq p\leq  q\leq \infty,\|f\|_{L^q}\lesssim 
R^{n(\frac{1}{p}-\frac{1}{q})}\|f\|_{L^p}$.

定义：$\mathbb{R}^n$中的标准正交基为$\{ e_j \}_{j=1}^n$, 
$\mathbb{R}^n$中的椭球$E=\{ x:\sum _{j}\frac{|(x-a)\cdot e_j|^2 }{r_j^2} \leq 1\}$,
其对偶$E^*=\{ x:\sum _{j}|(x-a)\cdot e_j|^2 r_j^2 \leq 1\}$.

命题：$f\in L^1+L^2,\supp\hat{f} \subseteq E$,则
$\|f\| _{L^q}\lesssim |E|^{\frac{1}{p}-\frac{1}{q}}\|f\|_{L^p}.$

定理(简单版本)：$f\in L^1+L^2, \supp\hat{f} \subseteq B(0,1)$,则对于$z\in E$,
$|f(z)| \lesssim \int |f(x)| (1+|x|)^{-N}.$

\section{振荡积分}

\subsection{单变量情形}

命题：$$I(\lambda)=\int _a^b e^{i\lambda \varphi(x)}\psi(x)\,\mathrm{d}x,$$
$\varphi \in C^\infty(a,b), \varphi'\neq 0, \psi \in C_c^\infty(a,b),$
则$I(\lambda)=O(\lambda^{-N}),\lambda\to \infty,\forall N>0$.

引理(Vander Corput): $\varphi ^{(k)}(x)\geq 1, x\in [a,b]$,则
$$I(\lambda)=\int_a^b e^{i\lambda \varphi(x)}\mathrm{d}x
\lesssim _k \lambda^{-\frac{1}{k}}$$
当$k=1$且$\varphi'(x)$单调，或$k\geq 2$.

推论：在上述引理的条件下，
$$\bigg| \int _a^b e^{i\lambda \varphi(x)}\psi (x)\,\mathrm{d}x\bigg| 
\lesssim _k \lambda^{-\frac{1}{k}}
(|\psi(b)| +\int _a^b |\psi'(x)| \,\mathrm{d}x).$$

定义：$x_0$称为$\varphi$的奇点，若$\varphi'(x_0)=0$. 
进一步，若$\varphi$为实值函数，则称$x_0$是稳定的.

定理：$k\geq 2,\varphi(x_0)=\varphi'(x_0)=\cdots =\varphi^{(k-1)}(x_0)=0,\varphi^{(k)}(x_0)\neq 0$,
$\psi$支撑在$x_0$的充分小的邻域内，则
$$I(\lambda)\sim \lambda^{-\frac{1}{k}}\sum_{j}a_j \lambda^{-\frac{j}{k}},$$
在此意义下：
$$\Big(\frac{\mathrm{d}}{\mathrm{d}x}\Big)^r
\Big(I(\lambda)-\lambda^{-\frac{1}{k}}\sum_{j}a_j \lambda^{-\frac{j}{k}}\Big)
=O(\lambda^{-r-\frac{N+2}{k}}),$$
这里$a_j=0$，若$\frac{j}{2}\notin \mathbb{Z}$.

注：在上述渐近展开中，$a_0=\big(\frac{2\pi}{-i\varphi''(x_0)}\big)^{\frac{1}{2}}\psi(x_0)$.

\subsection{多元情形}

命题：$I(\lambda)=\int e^{i\lambda \varphi(x)}\psi(x)\,\mathrm{d}x,
\varphi \in C^\infty(\mathbb{R}^n,\mathbb{R})$, 
$\varphi$在$\supp \psi$中无奇点, $\psi \in C_c^\infty(\mathbb{R}^n)$,
则$I(\lambda)=O(\lambda^{-N}),\lambda\to \infty,\forall N>0$.


定理：设$\psi\in C_c^\infty(\R^n),\supp\psi \subseteq B(0,1),
\varphi\in C^\infty(\mathbb{R}^n,\mathbb{R})$,
使得$\exists \alpha, k=|\alpha|>0,
|\partial^\alpha_x \varphi(x)| \geq 1, x\in \supp\varphi$,则
$$\int e^{i\lambda \varphi(x)}\psi(x)\,\mathrm{d}x \lesssim_{k,\varphi}
\lambda^{-\frac{1}{k}}(\|\psi\|_{L^\infty}+\|\nabla\psi\|_{L^1}).$$

定义：称$\varphi$的奇点$x_0$非退化，若$\det(\nabla ^2\varphi)(x_0)\neq 0.$

定理：$\varphi(x_0)=0,x_0$为非退化奇点，$\psi$支撑在$x_0$的小邻域内，则
$$I(\lambda)\sim \lambda^{-\frac{n}{2}}\sum_{j=0}^\infty a_j \lambda^{-j}.$$

\section{限制性定理}

\subsection{介绍}

定义：记$R(p\to q)$，若对$f\in \mathscr{S},
\|\hat{f}\|_{L^q(S^{n-1})}\lesssim \|f\|_{L^p(\mathbb{R}^n)}$.

定义：对于定义在$S^{n-1}$上的函数$g$，记$g$的扩张
$$E(g)(x):=g^\vee*\widehat{\mathrm{d}\sigma}(x)
=\int _{S^{n-1}}g(\xi )e^{2\pi ix\cdot\xi}\mathrm{d}\sigma(\xi).$$

定义：记$R^*(p\to q)$，若
$\|E(g)\|_{L^q(\mathbb{R}^n)}\lesssim \|g\|_{L^p(S^{n-1})}$.

命题：$R(p\to q)\Leftrightarrow R^*(q'\to p')$.

定理：(Knapp例子) 若$R(p\to q)$,则$p'\geq \frac{n+1}{n-1}q$.

命题：若$R(p\to q)$，则$p<\frac{2n}{n+1}.$

命题的证明需要用到引理：$\widehat{\mathrm{d}\sigma}(x)\sim  |x|^{-\frac{n-1}2}$.
[参考Stein, Harmonic Analysis, Chapter 8, 1.4]

限制性猜想：若$q>\frac{2n}{n-1},q\geq \frac{n+1}{n-1}p'$,则$R^*(p\to q)$成立.

\subsection{限制性定理}

命题：以下等价：(i) $R(p\to 2)$;
(ii) $R^*(2\to p')$;
(iii) $\|f*\widehat{\mathrm{d}\sigma}\|_{L^{p'}(\mathbb{R}^n)}
\lesssim \|f\|_{L^p(\mathbb{R}^n)}.$

定理：(Stein--Tomas)若$q>\frac{2n+2}{n-1},$则$R^*(2\to q)$成立.

定理：在$\mathbb{R}^2$中，$q>4,q\geq 3p'$,则$R^*(p\to q)$成立.

\subsection{限制性定理能导出Bochner--Riesz猜想}
[参考Tao, Lecture notes 3 for 254B, \href{https://www.math.ucla.edu/~tao/254b.1.99s/}{https://www.math.ucla.edu/～tao/254b.1.99s/}]

定理：$1\leq p<2,$若$R(p\to 2)$成立，
则当$\frac{1}{p}-\frac{1}{2}<\frac{2\lambda+1}{2n}$时
Bochner--Riesz平均在$L^p(\mathbb{R}^n)$有界.
特别地，由Stein--Tomas定理，Bochner--Riesz猜想在$\lambda>\frac{n-1}{2n+2}$时成立.


\section{Kakeya猜想}

\subsection{基本事实}

Kakeya猜想：$\mathbb{R}^n$中的Kakeya集的Hausdorff维数为$n$.\\

定义：$0\leq s<\infty,\varepsilon >0,E \subseteq \mathbb{R}^n$,
$$H^s_\varepsilon(E)
:=\inf \bigg\{\sum_{j=1}^\infty \alpha(s)
\Big(\frac{\operatorname{diam}(A_j)}{2}\Big)^s :
E \subseteq \bigcup_{j}A_j,\operatorname{diam}(A_j)<\varepsilon\bigg\},$$
其中$\alpha(s)=\dfrac{\pi^\frac{s}{2}}{\Gamma(\frac{s}{2}+1)}$.

定义：$H^s(E):=\lim_{\varepsilon \to 0}H^s_\varepsilon (E)$为$E$的$s$维Hausdorff测度.

命题：对$s_1<s_2$,若$H^{s_2}(E)>0$,则$H^{s_1}(E)=\infty$;
若$H^{s_1}(E)=0$,则$H^{s_2}(E)=0$.

记$E$的Hausdorff维数$$\dim_{H}(E)=\sup\{s:H^s(E)=\infty\}=\inf \{ s:H^s(E)=0 \}.$$

定义：Kakeya极大函数：
给定$\delta>0,f\in L^1_{\text{loc}}(\mathbb{R}^n),e\in S^{n-1}$,我们定义
$$f^*_\delta(e)=\sup_{T_\delta\parallel e}\frac{1}{|T_\delta|}
\int_{T_\delta}|f(x)|\,\mathrm{d}x,$$
这里$T_\delta$为半径$\delta$，长度$1$，母线平行于$e$的圆柱,
$T_\delta$也称作$\delta$-管子.

定理：若$\|f^*_\delta\|_{L^p(S^{n-1})}
\lesssim \delta^{-\alpha}\|f\|_{L^1(\mathbb{R}^n)}$,
则每个Kakeya集的Hausdorff维数不小于$n-p\alpha$.

猜想(Kakeya极大函数)：$\forall \varepsilon >0, 
\|f^*_\delta\|_{L^n}\lesssim_\varepsilon \delta^{-\varepsilon}\|f\|_{L^n}.$

定义：$\Omega$为$S^{n-1}$的子集，$\Omega$的$\delta$-覆盖是一族$\{B(e_j,\delta)\}$,
满足$\Omega \subseteq \cup B(e_j,\delta)$.
称$\{ e_j \}$为$\delta$-分离的，若$\|e_j-e_k\|\geq \delta,\forall j\neq k$.
一个$\delta$-覆盖称为极小的，若其任一真子覆盖不构成$\delta$-覆盖.

定理：$\forall f\in L^2(\mathbb{R}^n),\varepsilon>0$,
则$\|f^*_\delta\|_{L^2}\lesssim_\varepsilon \delta^{-\varepsilon}\|f\|_{L^2}.$

猜想(Kakeya tube)：$\Omega \subseteq S^{n-1}$为$\delta$-分离的，
对$w\in \Omega,T_w $为平行于$w$的$\delta$-管子，
则对$1\leq p \leq \frac{n}{n-1},\forall \varepsilon >0$,
$$\Big\|\sum _{w\in \Omega}\chi_{T_w}\Big\|_{L^p}\lesssim_\varepsilon 
\delta^{-\varepsilon}\bigg(\sum_w |T_w| \bigg)^{\frac{1}{p}}.$$

剩下的内容考试不考.