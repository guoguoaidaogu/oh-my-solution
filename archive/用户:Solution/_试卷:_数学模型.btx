    \draw[->,>=stealth](-2,0)to(-0.9,0);\draw(-1,0)to(0,0);
    \draw[->,>=stealth](0,0)to(0,-1.1);\draw(0,-1)to(0,-2);
    \draw[->,>=stealth](-2,0)to(-0.9,-1.1);\draw(-1,-1)to(0,-2);
    \draw[->,>=stealth](2,0)to(0.9,-1.1);\draw(1,-1)to(0,-2);
    \draw[->,>=stealth](2,0)arc(60:92:2);\draw(0,0)arc(120:90:2);
    \draw[->,>=stealth](0,0)arc(240:272:2);\draw(2,0)arc(300:270:2);
    \draw[->,>=stealth](2,0)arc(0:46:2);\draw(0,2)arc(90:45:2);
    \filldraw[fill=white](0,2)circle(0.05);\filldraw[fill=white](-2,0)circle(0.05);
