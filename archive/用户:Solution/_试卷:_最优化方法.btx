== 最优化方法2024学年春季学期期末试题 ==

\begin{itemize}
\item[一、] (1) 请写出（连续可微）凸函数判定的一阶条件和（二阶可微）凸函数判定的二阶条件。

(2) $\theta \in \R^{n},x_{n} \in \R^{n}, y_{n} \in \{0,1\}$, 
$h(x,\theta)= \dfrac{1}{1+e^{-\theta^{T}x}}$。

\[
f( \theta ) = - \sum_{1 \leq i \leq n} \left[ y_{i}\ln h(x_{i},\theta) +(1-y_{i})\ln (1- h(x_{i}, \theta))\right] 
\]

求证：$f(\theta )$ 是凸函数。

\item[二、] (1)写出 $f(x)$ 的共轭函数 $f^{*}(y)$ 的表达式.

(2) $x \in \mathbb{R}^{n}$, $x_{i} > 0$是 $x $ 的分量, 
求 $f(x) = \sum\limits_{1 \leq i \leq n} x_{i} \ln x_{i}  $ 的共轭函数 $f^{*} (y)$.

\item[三、] (1) $F(x)$ 是凸函数，请写出 $\partial F(x)$ 的定义.

(2) $\varepsilon >0 $, 定义 $F(a,b)= a - \max\{0,a-\varepsilon b\}$,
求$F(a,b)=0$ 的充要条件.

(3) 求$F(a,b)$的次微分.

\item[四、] $f(x)$ 是凸函数，且满足梯度 $L$--利普希茨连续，
即 $\left\| \nabla f(x)- \nabla f(y) \right\| \leq L \left\| x-y \right\| $. 
$x^*$ 是 $f$ 的全局最小值点.

(1) 求证：$\forall x,y \in \mathbf{dom} f$, 有：
\[
f(y) \leq f(x) + \nabla f(x)^{T}(y-x) + \frac{L}{2}\left\| x-y \right\|^{2}
\]

(2) 求证：
\[
\frac{1}{2L}\left\| \nabla f(x) \right\|^{2} 
\leq f(x) - f(x^*) \leq \frac{L}{2}\left\| x-x^* \right\|^{2}
\]

\item[五、] $f(x)$ 是凸函数.$x^*$ 是 $f$ 的全局最小值点.

(1) 写出临近算子 $\operatorname{prox}_{tf}(x)$ 的定义。

(2) 写出近似点算法的迭代公式和大致流程。

(3) 已知从 $x_{k}$ 到 $x_{k+1}$ 的迭代系数为 $t_k$,
求证： $\dfrac{x_{k} - x_{k+1}}{t_{k}} \in \partial f(x_{k+1})$. 

(4) 证明：\[
f(x_{k+1}) \leq f(x_{k}) - \frac{   1}{t_{k}}\left\| x_{k   } - x_{k+1} \right\|^2
\]

(5) 证明：
\[
f(x_{k+1}) \leq f(x^*)+\frac{1}{2t_{k}}\left( \left\| x_{k} - x^* \right\|^2 -\left\| x_{k+1} - x^* \right\|^2 \right) 
\]

(6) 证明：

\[
f(x_{k}) - f(x^*) \leq \frac{\left\| x_0 - x^* \right\|^2}
{2\sum_{1 \leq i \leq k-1}t_{i}} 
\]

\item[六、] (1) $t>0,f(x)= \left\| x \right\|_{1}$,
求 $\operatorname{prox}_{tf}(x)$.

(2) $t>0,f(x)= \left\| x \right\|_{2}$,求 $\operatorname{prox}_{tf}(x)$.

\[
f(x) = \frac{1}{2} x^{T}Qx +q^T x + \left\| x \right\|_{1}
\]
\[
A x =b
\]

其中 $Q$ 是 $n \times n$ 正定矩阵，$q \in \R^{n}$.

(3) 写出用增广拉格朗日法求解 $\min f$ 的表达式。

(4) 写出用交替方向乘子法求解 $\min f$ 的表达式，并说明这样做的理由。
\end{itemize}

\begin{proofc}[提示]
    \begin{itemize}
    \item[一、](1)一阶条件:对于定义在凸集上的可微函数$f,f$是凸函数当且仅当$f(y)\geq f(x)+\nabla f^\top(x)(y-x),\quad\forall x,y\in\textbf{dom}f$\par
    二阶条件:对于定义在凸集上的可微函数$f,f$是凸函数当且仅当$\nabla^2f(x)\geq0,\quad\forall x\in\textbf{dom}f$\par
    (2)由于凸函数的线性组合仍是凸函数,故原问题等价于证明$n=1$时的情况,等价于证明$\ln h(x_1,\cdot)$和$\ln(1-h(x_1,\cdot))$均为凸函数.又注意到$\theta^\top x$关于$\theta$线性,从而只需要证明$\ln\frac{1}{1+e^{-z}}$和
    $\ln\frac{e^{-z}}{1+e^{-z}}(z\in\mathbb{R})$是凸函数即可.
    $$(\ln\frac{1}{1+e^{-z}})''=(-\frac{e^{-z}}{1+e^{-z}})'=-(\frac{1}{1+e^{-z}})'=\frac{e^{-z}}{(1+e^{-z})^2}>0$$
    $$(\ln\frac{e^{-z}}{1+e^{-z}})''=(\frac{1+e^{-z}}{e^{-z}}(\frac{e^{-z}}{1+e^{-z}})')'=(-\frac{1}{1+e^{-z}})'=\frac{e^{-z}}{(1+e^{-z})^2}>0$$
\end{itemize}
\end{proofc}







== 最优化方法2025学年春季学期期末试题 ==
\begin{itemize}
\item[一、] (1) 请写出（连续可微）凸函数判定的一阶条件和（二阶可微）凸函数判定的二阶条件。

(2)对于$x\in\mathbb{R}^n,y\in\mathbb{R},y>0$,证明函数
$$f(x,y)=\frac{\|x\|^2_2}{y}$$
是凸函数.

\item[二、](1)写出临近算子$\text{prox}_h(x)$的定义.\par
(2)$h(x)=\|x\|_1$时,计算$\text{prox}_{th}(x)$.\par
(3)设$h(x)=g(\lambda x+a)$($\lambda\neq0$).证明$\text{prox}_h(x)=\frac{1}{\lambda}(\text{prox}_{\lambda^2g}(\lambda x+a)-a)$

\item[三、]考虑凸问题
$$\min\limits_x \quad\frac{1}{2}x^\top Ax+b^\top x$$
$$l\leq x\leq u$$
其中$A$是半正定对称阵.\par
(1)把该问题改写为可以使用交替方向乘子法的形式,并写出该问题的增广拉格朗日函数.\par
(2)写出用交替方向乘子法求解的算法步骤并说明理由.

\item[四、](1)设$f$是凸函数,满足$\|\nabla f(x)-\nabla f(y)\|\leq L\|x-y\|$.$\forall x
,y\in\textbf{dom}(f),$求证
$$|f(y)-f(x)-\nabla f^\top(x)(y-x)|\leq \frac{L}{2}\|x-y\|^2$$
(2)设$f$是凸函数,满足$\|\nabla^2 f(x)-\nabla^2 f(y)\|\leq L\|x-y\|$.$\forall x
,y\in\textbf{dom}(f)$,写出
$$|f(y)-f(x)-\nabla f^\top(x)(y-x)-\frac{1}{2}(\nabla^2f(x)(x-y),(x-y))|$$
应满足的不等式.

\item[五、](1)写出 $f(x)$ 的次梯度的定义.\par
(2)写出 $f(x)$ 的二次共轭函数 $f^{**}(x)$ 的定义.\par
(3)设$f$还是闭凸函数,那么我们知道$\forall x\in\textbf{dom}(f), f(x)=f^{**}(x)$.求证
$$y\in\partial f(x) \Leftrightarrow x\in\partial f^{*}(y)$$

\item[六、]设$t\in\mathbb{R},x\in\mathbb{R}^n$.定义$f(t,x)=\ln (t^2-x^\top x),\textbf{dom}(f)=\{(t,x)|t>0,t^2-x^\top x>0\}$.求$f(t,x)$的共轭函数.


\end{itemize}
\begin{proofc}[提示]
