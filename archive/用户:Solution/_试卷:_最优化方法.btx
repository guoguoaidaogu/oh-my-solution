    \item[一、]

\end{itemize}
\end{proofc}

== 最优化方法2026学年春季学期期末试题 ==
\begin{itemize}

\item[一、] 
(1) 请写出连续可微凸函数判定的一阶条件，以及二阶可微凸函数判定的二阶条件。

(2) 设 $0<\alpha<1$，函数 $f:\mathbb{R}_{++}^2\to\mathbb{R}$ 定义为
\[
    f(x,y)=-x^\alpha y^{1-\alpha}.
\]
证明 $f$ 在其定义域上是凸函数。

(3) 设 $f:\mathbb{R}^n\to\mathbb{R}$ 二阶连续可微，且对任意 $x\in\mathbb{R}^n$，Hessian 矩阵正定。
是否一定可以推出 $f$有下界? 若正确，请给出证明；若错误，请举出反例。
进一步地，
若 $f$有下界，是否一定可以推出$f$有最优值?
若正确，请给出证明；若错误，请举出反例。

\item[二、] 
(1) 写出函数 $f$ 为 $L$-光滑函数的定义。

(2) 可引用如下引理：

\textbf{引理 6.1.} 设 $g:\mathbb{R}^n\to\mathbb{R}$ 为可微凸函数。则以下命题等价：
\[
    g\text{ 是 }L\text{-光滑函数};
\]
\[
    x\mapsto \frac{L}{2}\|x\|_2^2-g(x)\text{ 是凸函数};
\]
\[
    g\text{ 满足余强制性，即对任意 }x,y\in\mathbb{R}^n,
\]
\[
    \langle \nabla g(x)-\nabla g(y),x-y\rangle
    \geq
    \frac{1}{L}\|\nabla g(x)-\nabla g(y)\|_2^2.
\]

证明：若 $f$ 可微，则 $f$ 是 $L$-光滑函数当且仅当
\[
    x\mapsto \frac{L}{2}\|x\|_2^2-f(x)
    \quad\text{与}\quad
    x\mapsto \frac{L}{2}\|x\|_2^2+f(x)
\]
均为凸函数。

\item[三、] 
(1) 写出共轭函数 $f^*(y)$ 的定义。

(2) 设
\[
    f(x)=\max_{1\leq i\leq n}x_i,
    \qquad x=(x_1,\dots,x_n)^\top\in\mathbb{R}^n.
\]
求 $f$ 的共轭函数 $f^*$。

(3) 设 $a_1,\dots,a_m\in\mathbb{R}^n$，$b_1,\dots,b_m\in\mathbb{R}$，函数 $f:\mathbb{R}^n\to\mathbb{R}$ 定义为
\[
    f(x)=\max_{1\leq i\leq m}\{a_i^\top x+b_i\}.
\]
求 $f$ 的共轭函数 $f^*$。

\item[四、] 
(1) 写出函数 $f$ 在点 $x_0$ 沿方向 $d$ 的方向导数
\[
    f'(x_0;d)
\]
的定义。

(2) 设
\[
    f(x)=\|x\|_1,
    \qquad x\in\mathbb{R}^n.
\]
求方向导数 $f'(x;d)$ 的表达式，并说明在什么条件下有
\[
    f'(x;d)=-f'(x;-d).
\]

\item[五、] 
设 $e=(1,\dots,1)^\top\in\mathbb{R}^n$。

(1) 写出临近算子 $\operatorname{prox}_{t h}(x)$ 的定义，其中 $t>0$。

(2) 设 $h(x)=\|x\|_1$, 定义域为 $\{x\in\mathbb{R}^n:x\leq e\}$,
求 $\operatorname{prox}_{t h}(x)$ 的显式表达式。

(3) 考虑优化问题
\[
    \min_{x\in\mathbb{R}^n}
    \quad
    \frac{1}{2}x^\top Qx+q^\top x+\|x\|_1
\]
\[
    \text{s.t.}\quad x\leq e,
\]
其中 $Q\in\mathbb{R}^{n\times n}$ 为对称正定矩阵，$q\in\mathbb{R}^n$。

为了使用交替方向乘子法，写出该问题对应的增广拉格朗日函数。

(4) 写出对应优化问题的交替方向乘子法的算法步骤，要求每一步写出解的显式表达式。

\item[六、] 
设 $f:\mathbb{R}^n\to\mathbb{R}$ 为凸可微函数，且存在最小值点 $x^*$。考虑梯度法迭代
\[
    x_{k+1}=x_k-\alpha \nabla f(x_k),
\]
其中 $\alpha>0$ 为步长。假设迭代满足下降条件
\[
    f(x_{k+1})
    \leq
    f(x_k)-\frac{\alpha}{2}\|\nabla f(x_k)\|_2^2.
\]

(1) 证明对任意 $k\geq 0$，
\[
    f(x_{k+1})-f(x^*)
    \leq
    \frac{1}{2\alpha}
    \left(
        \|x_k-x^*\|_2^2-\|x_{k+1}-x^*\|_2^2
    \right).
\]

(2) 证明对任意 $k\geq 1$，
\[
    f(x_k)-f(x^*)
    \leq
    \frac{1}{2\alpha k}\|x_0-x^*\|_2^2.
\]

\end{itemize}