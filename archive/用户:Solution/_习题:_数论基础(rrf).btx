\end{exercise}
\begin{proof}[解]
 (a) $2^{69},2^{2\times69},2^{4\times69},2^{8\times69}\equiv967,259,781,1(\operatorname{mod}1105)$.\\
 (b) $2^{36801},2^{2\times36801},2^{4\times36801}\equiv512,262144,1(\operatorname{mod}294409)$.\\
\end{proof}

