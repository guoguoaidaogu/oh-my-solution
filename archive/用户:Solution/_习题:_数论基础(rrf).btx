\section{HW4}
以下默认$p$是奇素数。
\begin{exercise}
    求证：若$p\nmid a$，则$\sum\limits_{x=0}^{p-1}\left( \dfrac{ax+b}{p} \right)=0$.
\end{exercise}
\begin{proof}
    略.
\end{proof}

\begin{exercise}
    求证：$x^2-y^2\equiv a(\operatorname{mod}p)$的解的个数是$
    \left\{ 
    \begin{aligned}
        &p-1\quad&若\,p\nmid a\\
        &2p-1\quad&若\,p\mid a\\
    \end{aligned}
     \right.
    $
\end{exercise}
\begin{proof}
    $(x+y)(x-y)=x^2-y^2$.
\end{proof}

\begin{exercise}
    求证：$1^2\cdot3^2\cdot5^2\cdot\ldots\cdot(p-2)^2\equiv (-1)^{(p+1)/2}(\operatorname{mod}p)$.
\end{exercise}
\begin{proof}
    Wilson定理的直接推论.
\end{proof}

\begin{exercise}
    若$p\equiv 3(\operatorname{mod}4)$，并且$q=2p+1$也是素数，并且$p>3$，
    求证：$2^p-1$不是素数。
\end{exercise}
\begin{proof}
    $2^p-1\equiv\left( \frac{2}{q} \right)-1\equiv(-1)^{(q^2-1)/8}-1\equiv0(\operatorname{mod}q)$，
    假设$q=2^p-1$会和$p>3$矛盾。
\end{proof}

\begin{exercise}\label{4.5}
    $f(x)\in\bbZ[x]$，称素数$p$整除$f(x)$：如果存在$b\in\bbZ$使得$p\mid f(n)$，
    描述$x^2+1$和$x^2-2$的素因子。
\end{exercise}
\begin{proof}
    前者是$4t+1$型素数和$2$，后者是$8t+1,8t+7$型素数和$2$。
\end{proof}

\begin{exercise}
    接\ref{4.5}，求证：$x^4-x^2+1$的任何素因子$\operatorname{mod}12$余$1$.
\end{exercise}
\begin{proof}
    $x^4-x^2+1=(x^2-1)^2+x^2$可推得$\left( \frac{-1}{p} \right)=1$，
    $x^4-x^2+1=(x^2+1)^2-3x^2$可推得$\left( \frac{3}{p} \right)=1$，
    利用二次互反律可以推$p\equiv1\operatorname{mod}12$.
\end{proof}

\begin{exercise}
    利用$(\bbZ/p\bbZ)^*$是循环群求证：$\left( \frac{-3}{p} \right)=1$在$p\equiv1\operatorname{mod}3$时成立。
\end{exercise}
\begin{proof}
    $p\equiv1\operatorname{mod}3$时，$(\bbZ/p\bbZ)^*$有阶为$3$的元素$\rho$，
    说明$(2\rho+1)^2\equiv-3(\operatorname{mod}p)$
\end{proof}

\begin{exercise}
若$p\equiv1(\operatorname{mod}5)$，求证：$\left( \frac{5}{p} \right)=1$
\end{exercise}
\begin{proof}
    $(\bbZ/p\bbZ)^*$有阶为$5$的元素$\rho$，说明$(2(\rho+\rho^4)+1)^2\equiv5(\operatorname{mod}p)$.
\end{proof}

\begin{exercise}
    Book③，Exercise 3.13(a)
\end{exercise}
