\section{HW1}
\begin{exercise}
    求证：$\bbZ[\sqrt{-5}]$中由$2$和$1+\sqrt{-5}$生成的理想不是主理想。
\end{exercise}
\begin{proof}
    反证法，假设$(2,1+\sqrt{-5})=(\alpha)$。\\
    \qquad假设$\alpha$为单位元，记$a,b,c,d\in\bbZ$使得$2(a+b\sqrt{-5})+(1+\sqrt{-5})(c+d\sqrt{-5})=1$，
    可得$c-5d$是奇数，$c+d$是偶数，矛盾。\\
    \qquad下默认$\alpha$不是单位元，若$2=(x+y\sqrt{-5})(z+w\sqrt{-5})$，其中$x,y,z,w\in\bbZ$，
    得到\begin{align*}
    \left\{ 
    \begin{aligned}
        &xz-5yw=2\\
        &xw=-yz
    \end{aligned}
     \right.
     \end{align*}
     假设$x,y,z,w$都是奇数，分析任何奇素数$p$对应的$V_p(x)$和$V_p(z)$得到$x=\plusmn z$，得到$x^2+5y^2=\plusmn 2$矛盾。
     于是$x,y,z,w$中必有偶数。\\
     \qquad容易发现
     \begin{align*}
    \left\{ 
    \begin{aligned}
        &xz+yw\equiv0(\operatorname{mod}2)\\
        &xw+yz\equiv0(\operatorname{mod}2)
    \end{aligned}
     \right.
     \end{align*}
     由对称性可不妨$x$是偶数。若$y$是偶数，则$1=(x/2+y/2\sqrt{-5})(z+w\sqrt{-5})$，代表$z+w\sqrt{-5}$是单位元；
     若$y$奇数，则$z,w$都是偶数，同理有$x+y\sqrt{-5}$是单位元。\\
     \qquad于是$2$是不可约元，故$\alpha$和$2$就差一个单位元倍，故$2|1+\sqrt{-5}$矛盾。
\end{proof}

\begin{exercise}
    $R$是一个PID，$a$是$R$的一个素元，求证：$R/a R$是一个域。
\end{exercise}
\begin{proof}
    对$b\in R-aR$，由$R$是PID得$(a,b)=(c)$。
    假设$c$不是$R$中单位，由$R$是PID知$a$不可约，故$a=c\cdot$一个单位，
    故$(a,b)=(a)$，和$b\notin aR$矛盾。
    因此$c$是单位，存在$s,t\in R$使得$as+bt=1$，
    则$(b+aR)(t+aR)=1+aR$是$R/aR$中单位。
\end{proof}

\begin{exercise}
    对于一个整环，如果任何由两个元素生成的理想都是主理想，
    则称这个整环为Bezout整环。
    求证：$R$是PID当且仅当$R$是Noether，Bezout整环。
\end{exercise}
\begin{proof}
    $\Longrightarrow$显然；$\Longleftarrow$，由Noether和Bezout可以发现任何理想$I$有：
    $I=(x_1,\ldots,x_n)=(x_1,\ldots,(x_{n-1},x_n))=(x_1,\ldots,x_{n-2},y_{n-1})=\cdots=(y_1)$。
\end{proof}

\begin{exercise}
    $R$为交换环，对$R$中两个理想$I,J$，可以定义$I\cdot J:=\{由全体\,xy\,生成的理想;x\in I,y\in J\}$，
    取$R=\bbZ[\sqrt{-5}]$，$I=2R+(1+\sqrt{-5})R$，$J=3R+(1+\sqrt{-5})R$，
    求证：$I\cdot J=(1+\sqrt{-5})R$.
\end{exercise}
\begin{proof}
    略
\end{proof}

\begin{exercise}
    求证：$R$是PID，$P$是$R$的一个素理想，则有$R/P$是PID.
\end{exercise}
\begin{proof}
    $R/P$整环，$f:R\to R/P$为自然同态，对于$R/P$中理想$I$，由$R$是PID，
    有$f^{-1}(I)=(r)$，则$I=(r+P)$是由$r+P\in R/P$生成的主理想。
\end{proof}

\begin{exercise}
    $\bbZ[x]$中：
    \begin{itemize}
        \item[(1)]$\bbZ[x]$是否为UFD？
        \item[(2)]求证：$\{a+xf(x)|a\in2\bbZ,f(x)\in\bbZ[x]\}$是$\bbZ[x]$中理想。
        \item[(3)]$\bbZ[x]$是否为PID？
        \item[(4)]$\bbZ[x]$是否为ED？
    \end{itemize}
\end{exercise}
\begin{proof}
   (1)是，因为$R$为UFD$\Rightarrow R[x]$为UFD；(2)略；(3)不是，$I=(2,x)$不是主理想；(4)不是，因为ED自动是UFD。
\end{proof}

\begin{exercise}
    求证：$x^2+y^2-1$在$\mathbb{Q}[x,y]$中不可约。
\end{exercise}
\begin{proof}
    略
\end{proof}

\begin{exercise}
    $F$是一个域，$f(x)\in F[x]$，$\deg f=n$，
    称$g(x):=x^nf(1/x)$是$f(x)$的逆。
    \begin{itemize}
        \item[(1)]用$f$的系数描述$g$。
        \item[(2)]求证：$f$不可约当且仅当$g$不可约。
    \end{itemize}
\end{exercise}
\begin{proof}
    略
\end{proof}

\begin{exercise}
    \begin{itemize}
        \item[(1)]求证：$x+1$是$\bbZ[[x]]$中单位，但不是$\bbZ[x]$的单位。
        \item[(2)]求证：$x^2+3x+2$在$\bbZ[x]$中可约，但在$\bbZ[[x]]$中不可约。
    \end{itemize}
\end{exercise}
\begin{proof}
    (1) $1=(x+1)(1-x+x^2-x^3+\ldots)$；
    (2)形如$1+a_1x+a_2x^2+\ldots$都是$\bbZ[[x]]$的单位，$x^2+3x+2=(a_0+a_1x+\ldots)(b_0+b_1x+\ldots)$中$a_0,b_0$必有一个为$\plusmn 1$.
\end{proof}

\begin{exercise}
    求证：对任何$n\in\bbN^*$，$(x-1)(x-2)\ldots(x-n)-1\in\bbZ[x]$不可约。
\end{exercise}
\begin{proof}
    假设可约，$(x-1)(x-2)\ldots(x-n)-1=f(x)g(x)$，则$f(1)g(1)=\ldots=f(n)g(n)=-1$，
    则$f(1)+g(1)=f(2)+g(2)=\ldots=f(n)+g(n)=0$，则$(x-1)\ldots(x-n)|f+g$，有$\deg f+g\geqslant n$，
    结合$\deg f+\deg g=n$以及首次系数可知$f,g$分别为$\plusmn(x-1)\ldots(x-n)$和$\plusmn 1$，矛盾.
\end{proof}

\section{HW2}
\begin{exercise}
    求证：$3x^2+2=y^2$没有整数解。
\end{exercise}
\begin{proof}
    $\bmod\,3$即可。
\end{proof}

\begin{exercise}
    $\{a_1,\ldots,a_{\phi(n)}\}$是$\operatorname{mod}n$的互素剩余全体，
    $N$是$x^2\equiv1(\operatorname{mod}n)$的解的个数，
    求证：$a_1\ldots a_{\phi(n)}\equiv(-1)^{N/2}(\operatorname{mod}n)$
\end{exercise}
\begin{proof}
    $\{h_1,\ldots,h_N\}:=\{a_j|a_j^2\equiv1(\operatorname{mod}n)\}$，
    任何$\alpha\in\{1,\dots,N\}$存在唯一的$j\in\{1,\dots,\phi(n)\}$使得$h_\alpha a_j\equiv-1(\operatorname{mod}n)$，
    可发现存在$\beta\in \{1,\dots,N\}$使得$\beta\neq\alpha$且$h_\beta=a_j$。
    就这样以上述$h_\alpha \sim h_\beta$形成$\{h_1,\ldots,h_N\}$中的两两配对，
    可以得到$h_1\ldots h_N\equiv(-1)^{N/2}(\operatorname{mod}n)$.\\
    \qquad 对于$\{a_1,\ldots,a_{\phi(n)}\}-\{h_1,\ldots,h_N\}$，
    可以通过$a \sim a^{-1}$形成两两配对（注意到这个时候不会出现$a\equiv a^{-1}(\operatorname{mod}n)$），
    于是$a_1\ldots a_{\phi(n)}\equiv h_1\ldots h_N(\operatorname{mod}n)$.
\end{proof}

\begin{exercise}
    $p,q$为不同的奇素数使得$p-1|q-1$，
    若$(n,pq)=1$，求证：$n^{q-1}\equiv1(\operatorname{mod}pq)$
\end{exercise}
\begin{proof}
    Fermat小定理的简单应用.
\end{proof}

\begin{exercise}
    用中国剩余定理求解\begin{align*}
        \left\{ 
        \begin{aligned}
            &x\equiv1(\operatorname{mod}7)\\
            &x\equiv4(\operatorname{mod}9)\\
            &x\equiv3(\operatorname{mod}5)
        \end{aligned}
         \right.
    \end{align*}
\end{exercise}
\begin{proof}
    \begin{align*}
        \left\{ 
        \begin{aligned}
            &225,280,441\equiv1,0,0(\operatorname{mod}7)\\
            &225,280,441\equiv0,1,0(\operatorname{mod}9)\\
            &225,280,441\equiv0,0,1(\operatorname{mod}5)
        \end{aligned}
         \right.
    \end{align*}
    得到$x\equiv148(\operatorname{mod}315)$
\end{proof}

\begin{exercise}\label{2.5}
    $N$是$f(x)\equiv0(\operatorname{mod}n)$的解的个数，
    $n=p_1^{a_1}\ldots p_t^{a_t}$素因子分解，
    $N_i$是$f(x)\equiv0(\operatorname{mod}p_i^{a_i})$的解的个数，
    求证：$N=N_1 N_2\ldots N_t$.
\end{exercise}
\begin{proof}
    容易说明$\{x\in[0,n-1]|f(x)\equiv0(\operatorname{mod}n)\}$和
    $\{x\in[0,p_1^{a_1}-1]|f(x)\equiv0(\operatorname{mod}p_1^{a_1})\}\times\ldots
    \times\{x\in[0,p_t^{a_t}-1]|f(x)\equiv0(\operatorname{mod}p_t^{a_t})\}$
    是一一对应，比较元素个数即可。
\end{proof}

\begin{exercise}\label{2.6}
    若$p$是奇素数，求证：$1,-1$是$x^2\equiv1(\operatorname{mod}p^\alpha)$的唯二解。
\end{exercise}
\begin{proof}
    略。
\end{proof}

\begin{exercise}\label{2.7}
    求证：$x^2\equiv1(\operatorname{mod}p=2^b)$有一个解当且仅当$b=1$；两个解当且仅当$b=2$；四个解当且仅当$b\geqslant3$.
\end{exercise}
\begin{proof}
    略。
\end{proof}

\begin{exercise}
 用\ref{2.5}, \ref{2.6}, \ref{2.7}求出满足$x^2\equiv1(\operatorname{mod}n)$的解数$N$。
\end{exercise}
\begin{proof}
 $n=2^bp_1^{\alpha_1}\ldots p_t^{\alpha_t}$，
 则\begin{align*}
    N=\left\{ 
    \begin{aligned}
        &2^t\quad&b=0,1\\
        &2^{t+1}\quad&b=2\\
        &2^{t+2}\quad&b\geqslant3\\
    \end{aligned}
     \right.
 \end{align*}
\end{proof}

\begin{exercise}
    求证：任何$a+bi\in\bbZ[i]$，都有$a+bi\equiv0$或$1(\operatorname{mod}1+i)$.
\end{exercise}
\begin{proof}
    若$a\equiv b(\operatorname{mod}2)$，则$1+i|a+bi$；
    若$a\not\equiv b(\operatorname{mod}2)$，则$1+i|a+bi-1$.
\end{proof}

\begin{exercise}
    $\lambda=1-\omega\in\bbZ[\omega]$，
    其中$\omega$是$3$次单位根，
    若$\alpha\in\bbZ[\omega]$且$\alpha\equiv1(\operatorname{mod}\lambda)$，
    求证：$\alpha^3\equiv1(\operatorname{mod}9)$.
\end{exercise}
\begin{proof}
    记$\alpha=1+\beta\lambda$，$\beta\in\bbZ[\omega]$，可计算得$\alpha^3-1=3\beta(1-\beta\omega)(1+\beta)(1-\omega)$.
    注意到$-\omega^2\lambda^2=3$，代表$\lambda^2\equiv0(\operatorname{mod}3)$。记$\beta=a+b\omega$，$a,b\in\bbZ$，
    ``逐步去掉$\lambda^2$''得到：
    \begin{align*}
        \beta(1-\beta\omega)(1+\beta)(1-\omega)
        &=\beta^2(1+\beta)\lambda^2+\beta(1-\beta^2)\lambda\\
        &\equiv\beta(1-\beta^2)\lambda(\operatorname{mod}3)\\
        &=(a+b-b\lambda)(1-\beta^2)\lambda\\
        &\equiv(a+b)(1-\beta^2)\lambda(\operatorname{mod}3)\\
        &\equiv(a+b)(1-a-b)(1-a+b)\lambda(\operatorname{mod}3)\\
        &\equiv0(\operatorname{mod}3)
    \end{align*}
\end{proof}

\begin{exercise}
    求证：$2$是$\operatorname{mod}29$的原根。
\end{exercise}
\begin{proof}
    $\{2^n:n=1,\cdots,28\}=\{2,4,8,16,3,6,12,24,19,9,18,7,14,28,27,25,21,13,26,23,17,5,10,20,11,22,15,1\}$。
\end{proof}

\begin{exercise}
    考虑具有$4t+1$形式的素数$p$，
    求证：$a$是$\operatorname{mod}p$的原根当且仅当$-a$是$\operatorname{mod}p$的原根.
\end{exercise}
\begin{proof}
    若$a$是$\operatorname{mod}p$的原根，
    反证法，$r$是$-a$$\operatorname{mod}p$的阶，
    假设$r<p-1$，假设$r$为偶数，则直接矛盾，故$r$为奇数，
    有$r|(p-1/2)$，由$p$是$4t+1$型得$a^{p-1/2}\equiv(-a)^{p-1/2}\equiv1$矛盾。
\end{proof}

\begin{exercise}\label{2.13}
    考虑具有$4t+3$形式的素数$p$，求证：
    $a$是$\operatorname{mod}p$的原根当且仅当$-a$ $\operatorname{mod}p$的阶是$p-1/2$.
\end{exercise}
\begin{proof}
    $\Longleftarrow$：若$-a$ $\operatorname{mod}p$的阶是$(p-1)/2$，
    由$p$是$4t+3$型得$a^{(p-1)/2}\equiv-1(\operatorname{mod}p)$，
    $r$是$a$$\operatorname{mod}p$的阶，可发现$r$不能为奇数，否则$a^{(p-1)/2}\equiv1(\operatorname{mod}p)$矛盾，
    故$r$被$(p-1)/2$整除，只能是$p-1$，代表$a$是$\operatorname{mod}p$的原根.\\
    \qquad$\Longrightarrow$：若$a$是$\operatorname{mod}p$的原根，
    可推出$(-a)^{(p-1)/2}\equiv1(\operatorname{mod}p)$，
    $r$是$a$$\operatorname{mod}p$的阶，有$a^{2r}\equiv1(\operatorname{mod}p)$，
    只能$r=(p-1)/2$.
\end{proof}

\begin{exercise}
    设$p$是$8t+3$型素数，且$q=(p-1)/2$也是素数，
    求证：$2$是$\operatorname{mod}p$的原根。
\end{exercise}
\begin{proof}
    由\ref{2.13}，只要证$-2$ $\operatorname{mod}p$的阶是$q$：
    容易发现$-2\operatorname{mod}p$的阶只能是$1,2,q,2q$其中之一，
    $1,2$是不可能的，假设阶是$2q$，
    由Legendre符号相关知识：$1=-(-1)\equiv -(-2)^{(p-1)/2}=2^{(p-1)/2}
    \equiv \left( \frac{2}{p} \right) \equiv (-1)^{(p^2-1)/8}=-1$ 矛盾.
\end{proof}

\begin{exercise}
    求证：所有原根的乘积$\operatorname{mod}p$余$(-1)^{\phi(p-1)}$.
\end{exercise}
\begin{proof}
    $g$是$\operatorname{mod}p$原根，则$g^d$也是原根当且仅当$(d,\phi(p))=(d,p-1)=1$，
$\sum_{d\in[0,p-1],(d,p-1)=1}d=\phi(p-1)\cdot(p-1)/2$.
\end{proof}

\section{HW3}
以下默认$p$是奇素数。
\begin{exercise}
    求证：$1^k+\ldots+(p-1)^k\equiv
    \begin{cases}
        0(\operatorname{mod}p)\quad&若\ p-1\not|k\\
        -1(\operatorname{mod}p)\quad&若\ p-1|k
    \end{cases}$
\end{exercise}
\begin{proof}
    $p-1|k$则Fermat小定理，$p-1\nmid k$则取原根.
\end{proof}

\begin{exercise}
    $2$是$\operatorname{mod}29$的原根，求$x^7\equiv1(\operatorname{mod}29)$的解。
\end{exercise}
\begin{proof}
    全体解为$\{2^{4n}:n=1,\cdots,7\}=\{16,24,7,25,23,20,1\}$。
\end{proof}

\begin{exercise}
    求解：$1+x+x^2+\ldots+x^6\equiv0(\operatorname{mod}29)$
\end{exercise}
\begin{proof}
    上题去掉$1$，得$\{16,24,7,25,23,20\}$。
\end{proof}

\begin{exercise}
    如果$a\operatorname{mod}p$阶为$3$，求证：$1+a\operatorname{mod}p$阶为$3$
\end{exercise}
\begin{proof}
 验证$1+a$阶不为$1,2,3$即可，其中阶为$3$会推出$p=2$矛盾。
\end{proof}

\begin{exercise}
    求证：$x^2\equiv-1(\operatorname{mod}p)$有解当且仅当$p\equiv1(\operatorname{mod}4)$\\
    $x^4\equiv-1(\operatorname{mod}p)$有解当且仅当$p\equiv1(\operatorname{mod}8)$
\end{exercise}
\begin{proof}
    前者当且仅当$\frac{p-1}{(p-1,2)}$是偶数，后者当且仅当$\frac{p-1}{(p-1,4)}$是偶数。
\end{proof}

\begin{exercise}
    求证：$ax^m+by^n\equiv c(\operatorname{mod}p)$和$ax^{m'}+by^{n'}\equiv c(\operatorname{mod}p)$有相同个数的解，
    其中$m'=(m,p-1),n'=(n,p-1)$.
\end{exercise}
\begin{proof}
    对于存在$\operatorname{m}$原根的$m$，$m\nmid b$，熟知$x^n\equiv b(\operatorname{mod}m)$要么无解，要么有$(n,\phi(m))$个解。
    于是有：
    \begin{align*}
        N(ax^m+by^n\equiv c)
        &=\sum_{ai+bj\equiv c}N(x^m\equiv i)N(y^n\equiv j)\\
        &=\sum_{ai+bj\equiv c}N(x^{m'}\equiv i)N(y^{n'}\equiv j)\\
        &=N(ax^{m'}+by^{n'}\equiv c)
    \end{align*}
\end{proof}

