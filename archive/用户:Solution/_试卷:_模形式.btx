\setdisplaytitle{试卷：模形式}
\sethtmltitle{试卷：模形式}

\section{2025--2026秋}
You may use all the propositions that have been proved in the exercises directly.

Some \(q\)-expansions you may use:
    \[
        E_4(z) = 1 + 240 \sum_{n=1}^{\infin} \sigma_3 (n) q^n
    \]

    \[
        E_6(z) = 1 - 504 \sum_{n=1}^{\infin} \sigma_5 (n) q^n
    \]

    \[
        E_{14}(z) = 1 - 24 \sum_{n=1}^{\infin} \sigma_{13} (n) q^n
    \]

    \[
        \Delta = q - 24 q^2 + \dots
    \]


\begin{enumerate}

    \item

    (1) Let \(E_k\) be the weight-\(k\) normalized Eisenstein series. Prove that \(E_4^2 E_6 = E_{14}\).

    (2) For \(f \in M_k(\Gamma(1))\), \(g \in M_l(\Gamma(1))\), prove that \(kfg'-lf'g \in M_{k+l+2}(\Gamma(1))\).

    (3) Prove that \(j' = -2 \pi i \frac{E_{14}}{\Delta}\), where \(j = \frac{E_4^3}{\Delta}\).

    \item

    Let \(K = \mathbb{Q}(\sqrt{-3})\), \(\mathcal{O}_K = \mathbb{Z}\big[\frac{1+\sqrt{-3}}{2}\big]\).

    (1) Find a lattice $ \Lambda \subseteq \mathbb{C} $, such that $E(\Lambda)$ has complex multiplication by $\mathcal{O}_K$.

    (2) Find $\mathrm{Aut}(E(\Lambda))$.

    (3) Use this elliptic curve to find \(\mathrm{Cl}(K)\).

    (4) Find an elliptic curve defined over \(\mathbb{Q}\) which is isomorphic to \(E(\Lambda)\).

    \item

    Solve the following moduli question: For a prime \(p\), prove that there is a one to one correspondence between
    \(S_0(p) = \{[E,C] , C \subseteq E[p] \text{ is a cyclic subgroup of order }p\} / \sim \)
    and \(Y_0(p) = \Gamma_0(p) \backslash \mathbb{H} \).

    \item

    (1) Prove that \(M_k(\Gamma_0(N)) = 0\) when \(k\) is odd.

    (2) Let \(p\) be a prime, \(S = \begin{bmatrix}
    0 & -1 \\
    1 & 0
    \end{bmatrix}\), \(T = \begin{bmatrix}
    1 & 1 \\
    0 & 1
    \end{bmatrix}\). Prove that 
    \[
        \Gamma(1) = \Gamma_0(p) \bigsqcup \bigsqcup^{p-1}_{k=0} \Gamma_0(p)ST^k.
    \]

    (3) Prove that \(M_2(\Gamma_0(2))\) is one-dimensional.








\end{enumerate}