== 引言：随机现象与概率论 ==

== 从古典概率模型、几何概率模型到概率论的公理 ==

\begin{itemize}
    \item[2.2]
    当 $A_n \nearrow A$ 时，即 $A_1 \subseteq A_2 \subseteq \cdots$ 且 $\bigcup\limits_{n=1}^\infty A_n = A$。

    上极限：
    $$\varlimsup_{n\to\infty} A_n = \bigcap_{n=1}^\infty \bigcup_{k=n}^\infty A_k = \bigcap_{n=1}^\infty A = A,$$

    下极限：
    $$\varliminf_{n\to\infty} A_n = \bigcup_{n=1}^\infty \bigcap_{k=n}^\infty A_k = \bigcup_{n=1}^\infty A_n = A.$$

    当 $A_n \searrow A$ 时，类似即证。
    
    \item[2.3]
    (1) $A_n\nearrow A\iff A_n\subset A_{n+1} \and \cu{n=1}A_n=A
    \iff A_n\subset A_{n+1} \and 
    \forall \o\in A, \exists N \st \o\in A_n, \forall n\ge N
    \iff 1_{A_n}\nearrow \and \lm1_{A_n}=1_A
    \iff 1_{A_n}\nearrow1_A$，\\
    \qquad\quad\ \ $A_n\searrow A\iff A_{n+1}\subset A_n \and \ca{n=1}A_n=A
    \iff A_{n+1}\subset A_n \and 
    \forall \o\in A, \exists N \st \o\in A_n, \forall n\ge N
    \iff 1_{A_n}\searrow \and \lm1_{A_n}=1_A
    \iff 1_{A_n}\nearrow1_A$.

    (2) $\o\in\ls A_n \iff \forall N, \exists n\ge N \st \o\in A_n
    \iff \forall N, \exists \text{ 无数个 }n\ge N \st \o\in A_n
    \iff \sm{n=1} 1_{A_n}(\o)=\infty$；\\
    \qquad$\o\in\ls A_n \iff \forall N, \exists n\ge N \st \o\in A_n
    \iff \forall N, \exists n\ge N \st 1_{A_n}(\o)=1
    \iff \ls 1_{A_n}(\o)=1$，\\
    \qquad$\o\notin\ls A_n \iff \exists N \st \forall n\ge N, \o\notin A_n
    \iff \exists N \st \forall n\ge N, 1_{A_n}(\o)=0
    \iff \ls 1_{A_n}(\o)=0$.

    (3) $\o\in\ls A_n \iff \exists N \st \forall n\ge N, \o\notin A_n^c
    \iff \text{ 只有有限个 }n \st \o\in A_n^c
    \iff \sm{n=1} 1_{A_n^c}(\o)<\infty$；\\
    \qquad$\li 1_{A_n}=\li (1-1_{A_n^c})=1-\ls 1_{A_n^c}
    =1-1_{\ls A_n^c}=1_{\big(\ls A_n^c\big)^c}=1_{\li A_n}$.

    (4) $A_n\to A \iff \ls A_n=\li A_n=A
    \iff \ls 1_{A_n}=\li 1_{A_n}=1_A \iff \lm 1_{A_n}=1_A$.

    (5) $\o\in\ls(A_n\Delta A_{n+1})
    \iff \o\in\text{ 无数个 } A_n\Delta A_{n+1}
    \iff \o\in\text{ 无数个 } A_n\cup A_{n+1}
    \text{ 不过不能 }\forall n\ge\text{某个 }N, \o\in A_n\cap A_{n+1}
    \iff \o\in\text{ 无数个 } A_n
    \text{ 不过不能 }\forall n\ge\text{某个 }N, \o\in A_n
    \iff \o\in\Big(\ls A_n\Big)\Big\backslash\Big(\li A_n\Big)$.

    (6) $\o\in\ls\{f_n\ge C\}\iff \exists N \st \forall n\ge N, f_n(\o)\ge C
    \implies \forall N, \exists n\ge N \st f_n(\o)\ge C
    \iff \o\in\Big\{\ls f_n\ge C\Big\}$，后面三个一样。

    \item[2.4]
    (1) 对于集合$\Sigma_{n+1}$，首先给元素$n+1$找同伴，
    它们是确定的$n-k$个数（$0\le k\le n$），
    有$\binom{n}{n-k}=\binom{n}{k}$个取法，接下来剩下的$k$个数作分划，于是
    $$T_{n+1}=\sum_{k=0}^n\binom{n}{k}T_k.$$

    (2) $T_0=B_0$，设$T_m=B_m$对$m\le n$成立，注意
    \begin{align*}B_{n+1}&=e^{-1}\sm{\ell=1}\frac{\ell^{n+1}}{\ell!}\\
    &=e^{-1}\sm{\ell=0}\frac{(\ell+1)^n}{\ell!}\\
    &=e^{-1}\sum_{k=0}^{n+1}\sm{\ell=1}\binom{n}{k}\frac{\ell^k}{\ell!}
    =e^{-1}\sum_{k=0}^{n+1}\binom{n}{k}B_k,\end{align*}
    故$T_{n+1}=B_{n+1}$。并且，
    \begin{align*}B&=B_0+\sm{n=1}\frac{B_n}{n!}x^n\\
    &=1+e^{-1}\sm{n=1}\sm{k=1}\frac{(kx)^n}{n!k!}\\
    &=e^{-1}\bigg(\sm{k=1}\frac{1}{k!}+\sm{k=1}\frac{e^{kx}-1}{k!}\bigg)
    =e^{e^x-1}.\end{align*}

    \item[2.5]
    $$|A|=\sum_{m\ge k}\binom{n}{m}.$$

    \item[2.6]
    $n^2$个人标上编号，有$(n^2)!$种方法；
    $n^2$个人分成不带编号的$n$组，有$C(n)$种方法，
    再给每组标上编号，每组$n$人标上编号，有$n!(n!)^n$种方法。
    所以$(n^2)!=C(n)(n!)^{n+1}$。

    数论的方法是，要说明对任何素数$p$，
    $$\sum_{0<\alpha\le\lf\log_p\!n\rf}\bigg\lf\frac{n^2}{p^\alpha}\bigg\rf
    =\sum_{0<\alpha\le\lf\log_p\!n\rf}\bigg\lf\frac{n^2}{p^\alpha}\bigg\rf
    +\sum_{\lf\log_p\!n\rf<\alpha\le\lf\log_p\!n^2\rf}\bigg\lf\frac{n^2}{p^\alpha}\bigg\rf
    \ge(n+1)\sum_{0<\alpha\le\lf\log_p\!n\rf}\bigg\lf\frac{n}{p^\alpha}\bigg\rf,$$
    这是因为
    $$\bigg\lf\frac{n^2}{p^\alpha}\bigg\rf
    \ge n\bigg\lf\frac{n}{p^\alpha}\bigg\rf,\quad
    \lf\log_p\!n^2\rf-\lf\log_p\!n\rf\ge\lf\log_p\!n\rf,\quad
    \frac{n^2}{p^{\alpha+\lf\log_p\!n\rf}}\ge\frac{n}{p^{\lf\log_p\!n\rf}}.$$

    \item[2.8]
    
    设 $\mathcal{F}$ 是样本空间 $\Omega$ 上的一个有限 $\sigma$-代数。
    由于 $\mathcal{F}$ 是有限的，对于每个 $x \in \Omega$，定义：
    $$A_x = \bigcap \{B \in \mathcal{F}: x \in B\}.$$
    由于 $\mathcal{F}$ 是有限的，这个交集实际上是有限交集，
    因此 $A_x \in \mathcal{F}$。称这样的 $A_x$ 为 $\mathcal{F}$ 的原子。

    可以证明：
    * 不同的原子互不相交；
    * 所有原子的并集等于 $\Omega$；
    * $\mathcal{F}$ 中的每个集合都是某些原子的并集。

    设这些原子为 $A_1, A_2, \cdots, A_n$，它们构成了 $\Omega$ 的一个分割。

    由于 $\mathcal{F}$ 中的每个集合都是某些 $A_i$ 的并集，且这些原子互不相交，
    因此 $\mathcal{F}$ 与 $\{A_1, \cdots, A_n\}$ 的幂集之间存在一一对应。
    具体地，对于每个子集 $I \subseteq \{1,2,\cdots,n\}$，
    对应的集合为 $\bigcup\limits_{i \in I} A_i$。

    因此，$\mathcal{F}$ 的元素个数等于 $n$ 元集合的子集个数，即 $|\mathcal{F}| = 2^n$。

    由原子构成的分割 $\{A_1, \cdots, A_n\}$ 生成的 $\sigma$-代数恰好包含所有这些原子的所有可能并集，
    这正是 $\mathcal{F}$ 本身。因此，该分割生成 $\mathcal{F}$。


    \item[2.9]
    一方面，集合$\mathcal{F}$可由$\mathcal{E}$通过可数并与取补集生成；
    另一方面，$\mathcal{F}$是一个$\sigma$-代数。

    \item[2.14]
    不是。令$A_i=(2^{2i-2},2^{2i-1}]\cap\Z,i\in\Z_+$，
    渐近密度均为$0$因而皆属于$\mathcal{E}$；而$A=\cu{i=1}A_i$不属于$\mathcal{E}$，因为
    \begin{align*}\lm\frac{|A\cap(0,2^{2n-1}]|}{2^{2n-1}}
    &=\lm\frac{2^0+2^2+\cdots+2^{2n-2}}{2^{2n-1}}=\frac{2}{3},\\
    \lm\frac{|A\cap(0,2^{2n}]|}{2^{2n}}
    &=\lm\frac{2^0+2^2+\cdots+2^{2n-2}}{2^{2n}}=\frac{1}{3}.\end{align*}

    \item[2.15]
    记$\mathcal{E}=\{A_{i_1}\cap\cdots\cap 
    A_{i_k}\cap A^c_{i_{k+1}}\cap\cdots\cap A^c_{i_n}:
    i_1,\cdots,i_n\text{ 是 }1,\cdots,n\text{ 的排列}\}$，
    有$$\mathcal{F}=\Big\{\bigcup\limits_{e\in E}e:
    E\subseteq\mathcal{E}-\{\varnothing\}\Big\},$$
    故$|\mathcal{F}|\le 2^{|\mathcal{E}|-1}\le 2^{2^n-1}$。

    \item[2.18]
    \begin{itemize}
        \item[(i)] $A_1\cap A_2^c\cap A_3^c$；
        \item[(ii)] $A_1\cap A_2\cap A_3^c$；
        \item[(iii)] $A_1\cap A_2\cap A_3$；
        \item[(iv)] $A_1\cup A_2\cup A_3$；
        \item[(v)] $(A_1\cap A_2)\cup(A_1\cap A_3)\cup(A_2\cap A_3)$；
        \item[(vi)] $(A_1\cap A_2^c\cap A_3^c)\cup
        (A_1^c\cap A_2\cap A_3^c)\cup(A_1^c\cap A_2^c\cap A_3)$；
        \item[(vii)] $(A_1^c\cap A_2\cap A_3)\cup
        (A_1\cap A_2^c\cap A_3)\cup(A_1\cap A_2\cap A_3^c)$；
        \item[(viii)] $(A_1\cap A_2\cap A_3)^c$.
    \end{itemize}
    
    \item[2.20]
    * 对于不等式$\mathbb{P}\big(\varliminf\limits_{n\to\infty}A_n\big) \leq \varliminf\limits_{n\to\infty}\mathbb{P}(A_n)$，
    令 $B_n = \bigcap\limits_{k=n}^\infty A_k$，则 $B_n \uparrow \varliminf\limits_{n\to\infty} A_n$。由概率的连续性，
    $$\mathbb{P}\big(\varliminf_{n\to\infty} A_n\big) = \lim_{n\to\infty} \mathbb{P}(B_n) 
    = \lim_{n\to\infty} \mathbb{P}\left(\bigcap_{k=n}^\infty A_k\right)
    \leq \lim_{n\to\infty} \inf_{k\geq n} \mathbb{P}(A_k) = \varliminf_{n\to\infty} \mathbb{P}(A_n).$$

    * 不等式$\varliminf\limits_{n\to\infty}\mathbb{P}(A_n) \leq \varlimsup\limits_{n\to\infty}\mathbb{P}(A_n)$
    是显然的，因为下极限不大于上极限。

    * 对于不等式$\varlimsup\limits_{n\to\infty}\mathbb{P}(A_n) \leq \mathbb{P}\big(\varlimsup\limits_{n\to\infty}A_n\big)$，
    令 $C_n = \bigcup\limits_{k=n}^\infty A_k$，则 $C_n \downarrow \varlimsup\limits_{n\to\infty} A_n$。由概率的连续性，
    $$\mathbb{P}\big(\varlimsup_{n\to\infty} A_n\big) = \lim_{n\to\infty} \mathbb{P}(C_n) 
    = \lim_{n\to\infty} \mathbb{P}\left(\bigcup_{k=n}^\infty A_k\right) 
    \geq \lim_{n\to\infty} \sup_{k\geq n} \mathbb{P}(A_k) = \varlimsup_{n\to\infty} \mathbb{P}(A_n).$$

    \item[2.21]
    简写$\p=\p(A\cap B)$，有$\p(A)+\p(B)\le1+\p$，得
    $$-\frac{1}{4}\le\frac{\p(2-\p)-1}{4}=\p-\left(\frac{1+\p}{2}\right)^2
    \le\p(A\cap B)-\p(A)\p(B)\le\p-\p^2\le\frac{1}{4}.$$
    
    \item[2.22]
    交换律： $A\Delta B = (A\setminus B)\cup(B\setminus A) = (B\setminus A)\cup(A\setminus B) = B\Delta A$。

    结合律： 直接验证 $(A\Delta B)\Delta C = A\Delta(B\Delta C)$
    两边都等于恰好在奇数个集合（$A,B,C$）中的元素组成的集合。

    分配律： $(A\Delta B)\cap C = (A\cap C)\Delta(B\cap C)$
    左边：$[(A\setminus B)\cup(B\setminus A)]\cap C = (A\cap C\setminus B)\cup(B\cap C\setminus A)$
    右边：$(A\cap C)\setminus(B\cap C)\cup(B\cap C)\setminus(A\cap C) = (A\cap C\setminus B)\cup(B\cap C\setminus A)$
    两边相等。

    概率公式：
    $$\mathbb{P}(A\Delta B) = \mathbb{P}(A\setminus B) + \mathbb{P}(B\setminus A) 
    = [\mathbb{P}(A) - \mathbb{P}(A\cap B)] + [\mathbb{P}(B) - \mathbb{P}(A\cap B)] 
    = \mathbb{P}(A) + \mathbb{P}(B) - 2\mathbb{P}(A\cap B).$$

    \item[2.23]
    即$\int|1_A-1_B|\le\int|1_A-1_C|+\int|1_C-1_B|$.
    \item[2.25]
    用归纳法。$n=3$时，由概率的次可加性，
    \[\mathbb{P}(A^c \cup B^c \cup C^c) \leq \mathbb{P}(A^c) + \mathbb{P}(B^c) + \mathbb{P}(C^c),\]
    即
    \[1 - \mathbb{P}(A\cap B\cap C) \leq [1-\mathbb{P}(A)] + [1-\mathbb{P}(B)] + [1-\mathbb{P}(C)],\]
    整理得
    \[\mathbb{P}(A\cap B\cap C) \geq \mathbb{P}(A) + \mathbb{P}(B) + \mathbb{P}(C) - 2.\]
    
    假设结论对$n$成立，证明对$n+1$成立。由于
    $$\mathbb{P}\left(\bigcap_{i=1}^{n+1} A_i\right) = \mathbb{P}\left(\bigcap_{i=1}^n A_i \cap A_{n+1}\right) \geq \mathbb{P}\left(\bigcap_{i=1}^n A_i\right) + \mathbb{P}(A_{n+1}) - 1,$$
    由归纳假设，
    \[\mathbb{P}\left(\bigcap_{i=1}^{n+1} A_i\right) \geq \left[\sum_{i=1}^n \mathbb{P}(A_i) - (n-1)\right] + \mathbb{P}(A_{n+1}) - 1 = \sum_{i=1}^{n+1} \mathbb{P}(A_i) - n.\]

    \item[2.28]
    性质(1),\,(2)是说$$A_i\cap A_j\cap A_k=\varnothing,
    \quad A_i=\biguplus_{j\ne i}(A_i\cap A_j).$$
    用Jordan公式
    $$\p\big(\bigcup_i A_i\big)=\sum_i\p(A_i)-\sum_{i<j}\p(A_i\cap A_j)
    +\cdots+(-1)^{n-1}\p\big(\bigcap_i A_i\big),$$
    得到\begin{align*}
        2\,\p\big(\bigcup_i A_i\big)&=2\sum_i\p(A_i)-\sum_{i\ne j}\p(A_i\cap A_j)\\
        &=2\sum_i\p(A_i)-\sum_i\sum_{j\ne\text{given }i}\p(A_i\cap A_j)\\
        &=2\sum_i\p(A_i)-\sum_i\p(A_i)=\sum_i\p(A_i).
    \end{align*}

    \item[2.32]
    能组成的四位数有$9\cdot9\cdot8\cdot7$个，按照末尾是$0$或$2,4,6,8$，得里面偶数有
    $9\cdot8\cdot7\cdot1+8\cdot8\cdot7\cdot4$个，
    概率为$\dis \frac{9\cdot1+8\cdot4}{9\cdot9}=\frac{41}{81}$。
    \item[2.33]
    四位数的范围是$1000$到$9999$，总共有$9000$个四位数。
    一个数是偶数当且仅当它的个位数字是偶数（即$0, 2, 4, 6, 8$），
    所以偶数四位数的个数为：$9 \times 10 \times 10 \times 5 = 4500$，故
    $\mathbb{P}(\text{四位数是偶数}) = \dfrac{4500}{9000} = \dfrac{1}{2}$。
    \item[2.35]
    $\dis 1-\frac{11\cdot10\cdot9}{12\cdot12\cdot12}=\frac{41}{96}$。（反直觉地大）
    \item[2.39]
    从$n$双不同的鞋中随机选取$2r$只鞋，总的选择方法数为$\dbinom{2n}{2r}$。
    
    (1)即选出的$2r$只鞋都来自不同的双。
    从$n$双中选出$2r$双，方法数为$\dbinom{n}{2r}$；
    再从每双中选$1$只，方法数$2^{2r}$。故概率为
    \[\mathbb{P}_1 = \frac{\dbinom{n}{2r} \cdot 2^{2r}}{\dbinom{2n}{2r}}.\]

    (2)即选出的鞋中恰好有一双是完整的，其余$2r-2$只鞋来自不同的双且不成双。
    选出一双完整的鞋，方法数为$\dbinom{n}{1}$，
    从剩下的$n-1$双中选出$2r-2$双，方法数为$\dbinom{n-1}{2r-2}$，
    从每双中选$1$只，方法数为$2^{2r-2}$。故概率为
    \[\mathbb{P}_2 = \frac{\dbinom{n}{1} \dbinom{n-1}{2r-2} \cdot 2^{2r-2}}{\dbinom{2n}{2r}}.\]

    (3) 即选出的鞋恰好组成$r$双完整的鞋。
    从$n$双中选出$r$双，方法数为$\dbinom{n}{r}$。故概率为
    \[\mathbb{P}_3 = \dfrac{\dbinom{n}{r}}{\dbinom{2n}{2r}}.\]

    \item[2.42]
    （1）前者大，$1-\big(1-\frac{1}{6}\big)^4>1-\big(1-\frac{1}{6^2}\big)^{6\cdot4}$。

    $1-\frac{1}{6}<\big(1-\frac{1}{6^2}\big)^6$
    是因为，对$n$归纳易有，对于$a_1,\cdots,a_n>0$，
    $$1-a_1-\cdots-a_n<(1-a_1)\cdots(1-a_n).$$

    （2）前者大。扔$6n$个骰子得到的$6$的数量写为$X_n$
    （这是个随机变量），那么$X_{n+1}=X_n+X_1$，且
    \begin{align*}
        \p(X_{n+1}\ge n+1)&=\sum_{i=0}^6\p(X_n\ge n+1-i)\p(X_1=i)\\
        &=\p(X_n\ge n)+\sum_{i=0}^6\big[\p(X_n\ge n+1-i)-\p(X_n\ge n)\big]\p(X_1=i).
    \end{align*}
    观察到$\p(X_n=n+1-6)<\cdots<\p(X_n=n+1)$，从而$i>1$时
    $$\p(X_n\ge n+1-i)-\p(X_n\ge n)<(i-1)\p(X_n=n).$$
    由此，最后一项小于
    $$\p(X_n=n)\sum_{i=0}^6(i-1)\p(X_1=i)=\p(X_n=n)\big(\e(X_1)-1\big)=0.$$
    \item[2.44]
    $10$男$5$女随机站一排，总排列数为$15!$。
    
    首先排列$10$个男生，有$10!$ 种方法；男生排列后产生$11$个空位（包括两端），
    从$11$个空位中选出$5$个给女士，有$\dbinom{11}{5}$ 种方法；
    $5$个女士在选定的位置上排列，有$5!$ 种方法。

    相乘得，女士互不相邻的排列数为$10! \times \dbinom{11}{5} \times 5!$。因此概率为
    \[\mathbb{P} = \frac{10! \times \dbinom{11}{5} \times 5!}{15!} = \frac{2}{13}.\]

    \item[2.55]
    有人找零困难等价于存在某时间排到的人里面$50$元的比$100$元的少$1$人。
    沿票数差为$-1$的直线反射这个时间后的图像，最终票数差为$n-m-2$（本来是$m-n$），
    相当于$n-1$人$50$元，$m+1$人$100$元。
    所以不发生找零困难的概率是
    $\dis 1-\frac{\binom{m+n}{m+1}}{\binom{m+n}{m}}=1-\frac{n}{m+1}$。

    \item[2.57]
    相当于随机选三条边不是同一条边的概率，是$\dis 1-\Big(\frac{1}{4}\Big)^2=\frac{15}{16}$。

    \item[2.63]
    本题说明，无法说：对任何正整数$a$，一个正整数是$a$的倍数的概率是$\frac{1}{a}$
    （尽管能说渐近密度是$\frac{1}{a}$）。

    假如概率测度$\p$存在，不妨令$\p$是完备的。对$a_1,\cdots,a_n\in\N$，有
    \begin{align*}
        \p(a_1\N\cup\cdots\cup a_n\N)
        &=\sum_i\p(a_i\N)-\sum_{i<j}\p(a_i\N\cap a_j\N)
        +\cdots+(-1)^{n-1}\p(a_1\N\cap\cdots\cap a_n\N)\\
        &=\sum_i\frac{1}{a_i}-\sum_{i<j}\frac{1}{[a_i,a_j]}
        +\cdots+(-1)^{n-1}\frac{1}{[a_1,\cdots,a_n]}.
    \end{align*}
    当$a_1,\cdots,a_n$互素时最小公倍数就是乘积，于是
    $$\p(a_1\N\cup\cdots\cup a_n\N)=1-\prod_{i=1}^n\Big(1-\frac{1}{a_i}\Big).$$
    对任意的$m\in\N$，取不是$m$的因数的不同素数$p_1,\cdots,p_n$，当$n\to\infty$时
    $$\p(p_1\N\cup\cdots\cup p_n\N)
    =1-\prod_{i=1}^n\Big(1-\frac{1}{p_i}\Big)\to1,$$
    于是$\p(\{m\})=0$，不成立。这里用了
    $$\prod_{p\text{ prime}}\Big(1-\frac{1}{p}\Big)
    \le\lim_{s\to1^+}\prod_{p\text{ prime}}\Big(1-\frac{1}{p^s}\Big)
    =\lim_{s\to1^+}\frac{1}{\zeta(s)}=0.$$
    
    \item[2.64]
    设$A$为圆周上红色点构成的集合，$A_j$表示$A$中的点顺时针旋转$\frac{j\pi}{2}$后得到的点集($j=0,1,2,3$)，
    只需证明
    $$\bigcap_{j=0}^{3}A_j\neq \varnothing.$$
    事实上，$$\left|\bigcup_{j=0}^{3}{A_j}^c\right| \le \sum_{j=0}^{3} \left|{A_j}^c\right|\le 4q < 1,$$
    因此$\left|\bigcap\limits_{j=0}^{3}A_j\right|> 0$，结论成立。
\end{itemize}

== 经典条件概率与事件独立性 ==
\begin{itemize}
    \item[3.1]
    由于 $|\Omega_k| < \infty$，$\mathcal{F}_k = 2^{\Omega_k}$ 是离散 $\sigma$-代数。

    一方面，$\mathcal{F}_1 \otimes \mathcal{F}_2$ 是由所有可测矩形 $A \times B$ 生成的 $\sigma$-代数，其中 $A \in \mathcal{F}_1$，$B \in \mathcal{F}_2$。  
    由于 $\mathcal{F}_1$ 和 $\mathcal{F}_2$ 是幂集，对任意 $A \subseteq \Omega_1$，$B \subseteq \Omega_2$，有 $A \times B \subseteq \Omega_1 \times \Omega_2$，即 $A \times B \in 2^{\Omega_1 \times \Omega_2}$。  
    因此，生成元包含于 $2^{\Omega_1 \times \Omega_2}$，而 $2^{\Omega_1 \times \Omega_2}$ 是一个 $\sigma$-代数，故生成的 $\sigma$-代数满足 $\mathcal{F}_1 \otimes \mathcal{F}_2 \subseteq 2^{\Omega_1 \times \Omega_2}$。

    另一方面，任取 $S \subseteq \Omega_1 \times \Omega_2$。由于 $\Omega_1 \times \Omega_2$ 是有限集，$S$ 可以表示为有限个单点集的并。  
    对任意点 $(x,y) \in \Omega_1 \times \Omega_2$，有 $\{(x,y)\} = \{x\} \times \{y\}$。  
    由于 $\{x\} \in \mathcal{F}_1$ 和 $\{y\} \in \mathcal{F}_2$（因为 $\mathcal{F}_k$ 是幂集），所以 $\{x\} \times \{y\} \in \mathcal{F}_1 \otimes \mathcal{F}_2$。  
    因此，每个单点集都在 $\mathcal{F}_1 \otimes \mathcal{F}_2$ 中。  
    由于 $\mathcal{F}_1 \otimes \mathcal{F}_2$ 是 $\sigma$-代数，它对有限并封闭，故 $S$ 作为单点集的有限并，也在 $\mathcal{F}_1 \otimes \mathcal{F}_2$ 中。  
    因此，$2^{\Omega_1 \times \Omega_2} \subseteq \mathcal{F}_1 \otimes \mathcal{F}_2$。

    综上，$\mathcal{F}_1 \otimes \mathcal{F}_2 = 2^{\Omega_1 \times \Omega_2}$。

    \item[3.2]
    设事件$\Gamma$使$\p(\Gamma)=0$且$\{A_n\setminus\Gamma\}$互不相交，有
    $$B=\biguplus_{n=1}^N\big((A_n\setminus\Gamma)\cap B\big)
    \uplus(\Gamma\cap B)\uplus\big(B\setminus(\bigcup_{n=1}^NA_n\cup\Gamma)\big),$$
    于是$\dis \p(B)=\sum_{n=1}^N\p(A_n\cap B)$同样成立，其余推理不变。

    \item[3.3]$\dis \frac{2}{3}$。

    \item[3.4]
    3.1就是。

    \item[3.5]
    \begin{itemize}
        \item[(1.a)]如果有无数个$x_n>0.5$，结论成立；
        如果$x_n>0.5$的个数有限，由(1.b)结论成立。
        \item[(1.b)]$0$附近$-x\sim\ln(1-x)$，
        得$[0,1-\delta]$上$-x,\ln(1-x)$相互控制，再用$\ln(x)$的连续性，有
        $$\sum_{n=1}^\infty x_n=\infty
        \Leftrightarrow\sum_{n=1}^\infty\ln(1-x_n)=-\infty
        \Leftrightarrow\prod_{n=1}^\infty(1-x_n)=0.$$
        \item[(2.a)]取$\dis x_n=\p(E_n^c\l\bigcap\limits_{k=1}^{n-1}E_k)$，
        成立$\dis \prod_{n=1}^\infty\p(E_n\l\bigcap\limits_{k=1}^{n-1}E_k)
        =\p(\ca{k=1}E_k)$。
        \item[(2.b)]同上。
    \end{itemize}

    \item[3.7]
    $A$与$A^c$独立，推出$0=\p(A\cap A^c)=\p(A)\p(A^c)$。
    \item[3.8]
    $\frac{\p(H\l E)}{\p(G\l E)}=\frac{\p(H\l E)\p(E)}{\p(G\l E)\p(E)}
    =\frac{\p(H\cap E)}{\p(G\cap E)}=\frac{\p(H)\p(E\l H)}{\p(G)\p(E\l G)}$.
    
    $\frac{\p(H\l E)}{\p(G\l E)}=3\cdot{\dis \frac{1}{2}}$
    表明$E$出现时$H$更可能成立。
    \item[3.9]
    $$\p(B\l\text{看成 }B)=\frac{\p(B\cap\text{看成 }B)}{\p(\text{看成 }B)}
    =\frac{15\%\cdot80\%}{85\%\cdot10\%+15\%\cdot80\%}=\frac{24}{41}.$$
    
    \item[3.10]
    由\[\left\{\begin{aligned}
        p(A\cup B\cup C)&=3p-3p^2\le1,\\
        p(A\cap B\cap C)&=0\ne p^3,\\
        p(A\setminus(B\cup C))&=p-2p^2\ge0,
    \end{aligned}\right.\]
    解得$p\in\big(0,\frac{1}{2}\big]$.
    
    \item[3.14]
    \ \begin{align*}
        &\p(B\big|A)=\p(B\big|A^c)\\
        \Leftrightarrow\ \ &\p(A\cap B)/\p(A)=\p(A^c\cap B)/\p(A^c)\\
        \Leftrightarrow\ \ &\p(A\cap B)\big(1-\p(A)\big)=\big(\p(B)-\p(A\cap B)\big)\p(A)\\
        \Leftrightarrow\ \ &\p(A\cap B)=\p(A)\p(B).
    \end{align*}

    \item[3.15]
    由于$$\p(A\cap B)=\p(A)\p(B)\in\Big[0,\frac{1}{4}\Big],$$
    有$$\p(A\Delta B\big|A\cup B)=\frac{\p(A\Delta B)}{\p(A\cup B)}
    =\frac{\p(A)+\p(B)-2\,\p(A\cap B)}{\p(A)+\p(B)-\p(A\cap B)}
    =\frac{1-2\,\p(A\cap B)}{1-\p(A\cap B)}\in\Big[\frac{2}{3},1\Big].$$

    

    \item[3.16]
    $\sigma(\{A_n:1\le n\le N\})$的元素形如$\biguplus\limits_{n\in I}A_n$
    与$\Omega\setminus\biguplus\limits_{n\in I}A_n$，
    其中$I$是$\{1,\cdots,N\}$的子集. 对任意的$I$，
    \begin{align*}
        \p\big(\biguplus_{n\in I}A_n\big)\p(B)&=\sum_{n\in I}\p(A_n)\p(B)
        =\sum_{n\in I}\p(A_n\cap B)=\p\big(\biguplus_{n\in I}A_n\cap B\big),\\
        \p\big(\Omega\setminus\biguplus_{n\in I}A_n\big)\p(B)
        &=\Big(\p(\Omega)-\p\big(\biguplus_{n\in I}A_n\big)\Big)\p(B)
        =\p(B)-\p\big(\biguplus_{n\in I}A_n\cap B\big)
        =\p\big((\Omega\setminus\biguplus_{n\in I}A_n)\cap B\big).
    \end{align*}

    \item[3.19]
    设概率为$\p(a,b)$。按第一局的输赢，
    $$\p(a,b)=\big(\p(a+1,b-1)+\p(a-1,b+1)\big)/2,$$
    即$\p(a+\cdot\,,b-\cdot\,)$是等差数列。
    由于$\p(a+b,0)=1,\p(0,a+b)=0$，有$\p(a,b)=\dfrac{a}{a+b}$。

    
    
    
    \item[3.22]
    $$\sum_{n=1}^\infty\big(1-\p(A_1\uplus A_2)\big)^{n-1}\p(A_1)
    =\p(A_1)/\p(A_1\uplus A_2).$$

    \item[3.25]
    \begin{itemize}
        \item[(1)]
        $$\dis \p(患病\l检出患病)=\frac{\p(患病\cap检出患病)}{\p(检出患病)}
        =\frac{10^{-4}}{10^{-4}+(1-10^{-4})5\%}=\frac{20}{10019}.$$
        \item[(2)]
        $$\dis \p(患病\l两次检出患病)=\frac{\p(患病\cap两次检出患病)}{\p(两次检出患病)}
        =\frac{10^{-4}}{10^{-4}+(1-10^{-4})(5\%)^2}=\frac{400}{10399}.$$
    \end{itemize}
     
    \item[3.32]
    由于骰子$B$和$C$相同，只需证明 $\p(2A > B+C) > 1/2$ 和 $\p(2B > A+C) > 1/2$。

    计算 $\p(2A > B+C)$:
    \begin{itemize}
        \item 当 $A=3$ 时，$2A=6$。需 $B+C < 6$。$B+C$ 可能值为 $2,5,8$，其中 $B+C=2$ 或 $5$ 时满足：
        $$
        \p(2A > B+C \mid A=3) = \p(B+C=2) + \p(B+C=5) = \frac{1}{9} + \frac{4}{9} = \frac{5}{9}.
        $$
        \item 当 $A=5$ 时，$2A=10$。总是满足 $10 > B+C$（因为 $B+C \leq 8$)，所以 $\p(2A > B+C \mid A=5) = 1$。
        \item 整体：
        $$
        \p(2A > B+C) = \frac{5}{6} \times \frac{5}{9} + \frac{1}{6} \times 1 
        = \frac{25}{54} + \frac{9}{54} = \frac{34}{54} = \frac{17}{27} \approx 0.6296 > \frac{1}{2}.
        $$
    \end{itemize}

    计算 $\p(2B > A+C)$:
    \begin{itemize}
        \item 当 $B=1$ 时，$2B=2$。总是 $A+C \geq 4 > 2$，所以 $\p(2B > A+C \mid B=1) = 0$。
        \item 当 $B=4$ 时，$2B=8$。需 $A+C < 8$。$A+C$ 可能值为 $4,7,6,9$，其中 $A+C=9$ 时不满足：
        $$
        \p(2B > A+C \mid B=4) = 1 - \p(A+C=9) 
        = 1 - \frac{1}{6} \times \frac{2}{3} = 1 - \frac{1}{9} = \frac{8}{9}.
        $$
        \item 整体：
        $$
        \p(2B > A+C) = \frac{1}{3} \times 0 + \frac{2}{3} \times \frac{8}{9} 
        = \frac{16}{27} \approx 0.5926 > \frac{1}{2}.
        $$
    \end{itemize}
    由对称性，$\p(2C > A+B) = \frac{16}{27} > \frac{1}{2}$。

    综上，所有概率均大于 $1/2$。证毕。

    \item[3.50]
    设 $\{A_{ij}\}_{i, j = 1}^n$ 是一些相互独立的事件矩阵, 满足 $\p(A_{ij}) = p_{ij}$.

    设事件 $M$ 为“每列至少有一个事件不发生”的事件,
    事件 $N$ 为“每行至少有一个事件发生”的事件，则
    \[\p(M) = \prod_{j=1}^n \left( 1 - \displaystyle \prod_{i=1}^n p_{ij} \right), \quad
    \p(N) = \prod_{i=1}^n \left( 1 - \displaystyle \prod_{j=1}^n (1 - p_{ij}) \right).\]

    假设 $M, N$ 都不发生, 则意味着 $A$ 中至少有一列全发生，且至少有一行全不发生，这是不可能的.

    因此 $\p(M^c \cap N^c) = 0$. 从而 $\p(M) + \p(N) \ge 1$, 即
    \[
        \displaystyle \prod_{j=1}^n \left( 1 - \displaystyle \prod_{i=1}^n p_{ij} \right)
        + \displaystyle \prod_{i=1}^n \left( 1 - \displaystyle \prod_{j=1}^n (1 - p_{ij}) \right)
        \ge 1.
    \]
    \item[3.51]
    我们使用概率方法证明。考虑从每个集合 $A_i$ 中独立随机选取一个元素 $a_i$，
    其中每个元素被选中的概率均匀，即对于每个 $i$，$a_i$ 在 $A_i$ 上均匀分布。

    设事件 $E$ 表示“$a_1, a_2, \ldots, a_n$ 互不相同”。我们需要证明 $\p(E) > 0$。

    考虑事件 $E$ 的补事件，即至少存在一对 $i < j$ 使得 $a_i = a_j$。由联合界（union bound）有：
    $$
    \p(\text{存在 } i < j \text{ 使得 } a_i = a_j) 
    \leq \sum_{1 \leq i < j \leq n} \p(a_i = a_j).
    $$

    对于固定的 $i < j$，计算 $\p(a_i = a_j)$。由于 $a_i$ 和 $a_j$ 独立选取，
    $$
    \p(a_i = a_j) = \sum_{x \in A_i \cap A_j} \p(a_i = x \text{ 且 } a_j = x) 
    = \sum_{x \in A_i \cap A_j} \frac{1}{|A_i|} \cdot \frac{1}{|A_j|} 
    = \frac{|A_i \cap A_j|}{|A_i| \cdot |A_j|}.
    $$

    因此，
    $$
    \p(\text{存在 } i < j \text{ 使得 } a_i = a_j) 
    \leq \sum_{1 \leq i < j \leq n} \frac{|A_i \cap A_j|}{|A_i| \cdot |A_j|} < 1.
    $$

    于是，
    $$
    \p(E) = 1 - \p(\text{存在 } i < j \text{ 使得 } a_i = a_j) > 1 - 1 = 0.
    $$

    由于 $\p(E) > 0$，故事件 $E$ 可能发生，即存在一种选择方式使得 $a_1, \cdots, a_n$ 互不相同。证毕。
\end{itemize}

== Lebesgue积分理论简介 ==

== 随机变量及其分布律(I) ==
\begin{itemize}
    \item[5.1]
    $1_A$是随机变量$\iff \forall x\in\R,\{1_A\le x\}\in\mathcal{F}
    \iff \varnothing,A^c,\Omega\in\mathcal{F} \iff A\in\mathcal{F}$.
    
    \item[5.2]
    $\big\{\sup\limits_{n\ge1}X_n\le x\big\}=\bigcap\limits_{n\ge1}\{X_n\le x\}$，
    $\big\{\inf\limits_{n\ge1}X_n<x\big\}=\bigcup\limits_{n\ge1}\{X_n<x\}$，

    $\ls X_n=\inf\limits_{N\ge1}\sup\limits_{n\ge N}X_n$，
    $\li X_n=\sup\limits_{N\ge1}\inf\limits_{n\ge N}X_n$.

    \item[5.4]
    $\forall\delta>0$，取$N$大使得$F(-N)<\delta,1-F(N)<\delta$，
    并且$F$在$[-N,N]$一致连续。

    \item[5.5]
    事实上$\p(\xi=a)=\p(\xi\le a)
    -\p\big(\bigcup\limits_{n\ge1}\{\xi\le a-\frac{1}{n}\}\big)
    =\p(\xi\le a)-\lm\p(\xi\le a-\frac{1}{n})=F(a)-F(a^-)$，
    于是，$F$在$x=a$处连续$\iff F(a^-)=F(a) \iff \p(\xi=a)=0$.

    \item[5.8]
    $\forall x<y$，$\p(X\le x<Y\le y)
    =\p(X\le x,Y\le y)-\p(X\le x,Y\le x)=F(x)-F(x)=0$，
    故$\p(X<Y)=\p\big(\bigcup\limits_{x,y\in\mathbb{Q}}X\le x<Y\le y\big)=0$，
    同理$\p(X>Y)=0$.

    \item[5.9]
    注意$S_F^c=\big\{x:\text{存在 }n\ge1\text{ 使 }\p(\|X-x\|\le\frac{1}{n})=0\big\}$
    是开集，毕竟对$x\in S_F^c$，$B_\frac{1}{n(x)}(x)\subset S_F^c$，
    其中$n(x)$为$x$对应的$n$。
    第二可数空间$S_F^c$有开覆盖$\bigcup\limits_{x\in S_F^c}B_\frac{1}{n(x)}(x)$，
    从而存在可数子覆盖，每个开集都零测，得$\p(X\in S_F^c)=0$.

    \item[5.12]
    \[F(x)=\begin{cases}0,&x<0\\1-p,&0\le x<1\\1,&x\ge1\end{cases}.\]
    \[Y\sim\p(F(X)\le x)
    =\begin{cases}0,&x<F(0)\\\p(X=0),&F(0)\le x<F(1)\\1,&x\ge F(1)\end{cases}
    =\begin{cases}0,&x<1-p\\1-p,&1-p\le x<1\\1,&x\ge 1\end{cases}.\]

    \item[5.14]
    $X_I\sim\p(X_I\le\cdot\,)=\p(I=0)\p(X_0\le\cdot\,)+\p(I=1)\p(X_1\le\cdot\,)
    =(1-p)F_0+pF_1$.

    \item[5.21]
    \[
        \p(X = n+1 | X > n) = \frac 2 3, \quad \forall n \ge 1,
    \]
    $X$ 满足无记忆性, 因此 $X \sim \g\left( \dfrac 2 3 \right)$.

    \item[5.23]
    $Y_k\sim\begin{pmatrix}(-1)^2&(-1)\cdot1&1\cdot(-1)&1^2\\
        \big(\frac{1}{2}\big)^2&\big(\frac{1}{2}\big)^2&
        \big(\frac{1}{2}\big)^2&\big(\frac{1}{2}\big)^2
    \end{pmatrix}=\begin{pmatrix}-1&1\\
        \frac{1}{2}&\frac{1}{2}
    \end{pmatrix}$.

    $\p(Y_1=\varepsilon_1,Y_2=\varepsilon_2)
    =\p(X_2=\varepsilon_1/X_3,X_1=\varepsilon_2/X_3)
    =\p(X_2=\varepsilon_1/X_3)\p(X_1=\varepsilon_2/X_3)
    =\p(Y_1=\varepsilon_1)\p(Y_2=\varepsilon_2)$，
    这里$\varepsilon_1,\varepsilon_2=\pm1$.

    $\p(Y_1=Y_2=Y_3=-1)=0\ne\big(\frac{1}{2}\big)^3
    =\p(Y_1=-1)\p(Y_2=-1)\p(Y_3=-1)$.

    \item[5.26]
    设$\{X_N^{(k)}\}_{N=1}^\infty$是相互独立的概率为$p_k$的事件列，
    $\p(\tau=\ell)=\p\big(\min\limits_{1\le k\le n}\tau_k=\ell\big)
    =\p\big(\min\limits_{1\le k\le n}\inf\{N:X_N^{(k)}=1\}=\ell\big)
    =\p\big(\inf\{N:\bigcup\limits_{1\le k\le n}X_N^{(k)}=1\}=\ell\big)$，
    且$\p\big(\bigcup\limits_{1\le k\le n}X_N^{(k)}\big)=1-q_1\cdots q_n$.

    \item[$\boxed{习题}$]
    已知$f\colon(\Omega,\mathcal{F},\p)\to
    (\Omega_1,\mathcal{F}_1,\p_1)\otimes(\Omega_2,\mathcal{F}_2,\p_2)$
    是概率空间之间的同构。记$\tilde{\omega}=(\omega_1,\omega_2)\in\Omega_1\times\Omega_2,
    \pi_1(\tilde{\omega}):=\omega_1,\pi_2(\tilde{\omega}):=\omega_2$。
    又设$\xi_k$为$(\Omega_k,\mathcal{F}_k,\p_k)$上的随机变量($k=1,2$)。
    令$\hat{\xi}_k=\xi_k\circ\pi_k\circ f$，求证：\\
    \ \ (1) $\xi_k\xlongequal{\rm d}\hat{\xi}_k$，$k=1,2$。\\
    \ \ (2) $\hat{\xi}_1$与$\hat{\xi}_2$相互独立。

    \item[$\boxed{解答}$]
    (1) $f$是同构是说$\p(A)=\p_1\otimes\p_2(f(A)),\,\forall A\in\mathcal{F}$.
    \begin{tikzcd}
        & &\Omega_1\ar[r,"\xi_1"']&\mathbb{R}\\
        \Omega\ar[r,"f"]
        \ar[urrr,bend left=40,"\hat{\xi}_1" description]
        \ar[drrr,bend right=40,"\hat{\xi}_2" description]
        &\Omega_1\times\Omega_2\ar[ur,"\pi_1"']\ar[dr,"\pi_2"]& & \\
        & &\Omega_2\ar[r,"\xi_2"]&\mathbb{R}
    \end{tikzcd}
    \begin{align*}&\p(\hat{\xi}_1\le x)=\p(\xi_1\circ\pi_1\circ f\le x)\\
    &=\p(f^{-1}(\{\xi_1\le x\}\times\Omega_2))\\
    &=\p_1\otimes\p_2(\{\xi_1\le x\}\times\Omega_2)\\
    &=\p_1(\xi_1\le x)\p_2(\Omega_2)=\p_1(\xi_1\le x).\end{align*}

    (2)\begin{align*}&\p(\hat{\xi}_1\le x)\p(\hat{\xi}_2\le y)
    =\p_1(\xi_1\le x)\p_2(\xi_2\le y)\\
    &=\p_1\otimes\p_2(\xi_1\le x,\xi_2\le y)
    =\p(f^{-1}(\xi_1\le x,\xi_2\le y))\\
    &=\p(\xi_1\circ\pi_1\circ f\le x,\xi_2\circ\pi_2\circ f\le y)\\
    &=\p(\hat{\xi}_1\le x,\hat{\xi}_2\le y).\end{align*}

    \item[$\boxed{习题}$]
    设$X,Y$是一维随机变量，$f$是二元可测函数。求证：$f(X,Y)$是随机变量。

    \item[$\boxed{解答}$]
    只需证明对任意二维可测集$A$，$\{(X,Y)\in A\}$还是可测集，要使用单调类定理：
    对$A=$开集$O_1\times$开集$O_2$，由$X,Y$是可测函数，
    $X^{-1}(O_1)\times Y^{-1}(O_2)$可测；
    这类$A$生成的$\sigma$-代数是二维可测集，二维可测集又是单调系。

    \item[5.27]
    (1) 取事件$X_k=\begin{cases}1,&\text{第 }k\text{ 次 }A\text{ 出现}\\
        0,&\text{第 }k\text{ 次 }A\text{ 未出现}\end{cases}
    \sim B(1,p_A)$，则$\tau_A\sim\g(p_A)$.

    (2) 见5.26，当$A,B$互斥时$p_Ap_B=p_{A\cap B}=0$，$\p(A\uplus B)=p_A+p_B$.

    (3) $\tau_A,\tau_B$相互独立
    $\iff \p(\tau_A>\ell_A)\p(\tau_B>\ell_B)=\p(\tau_A>\ell_A,\tau_B>\ell_B)$
    
    $\iff q_A^{\ell_A}q_B^{\ell_B}=q_{A\cup B}^{\ell_A}q_B^{\ell_B-\ell_A}$
    当$\ell_A\le\ell_B$，
    \ $q_A^{\ell_A}q_B^{\ell_B}=q_{A\cup B}^{\ell_B}q_B^{\ell_A-\ell_B}$
    当$\ell_A\ge\ell_B$

    $\iff q_Aq_B=q_{A\cup B} \iff p_Ap_B=p_{A\cap B} \iff A,B\text{ 相互独立}$.

    (5) \begin{align*}
        \p(\tau_{[2]}=\ell)
        &=\p(\tau_A-\tau_B=\ell)+\p(\tau_B-\tau_A=\ell)\\
        &=\p(B\text{ 先出现})\p(\text{再过 }\ell\text{ 次 }A\text{ 才出现})
        +\p(A\text{ 先出现})\p(\text{再过 }\ell\text{ 次 }B\text{ 才出现})\\
        &=\frac{p_B}{p_A+p_B}\g(p_A,\ell)+\frac{p_A}{p_A+p_B}\g(p_B,\ell),
    \end{align*}
    即\[\tau_{[2]}\sim\dfrac{p_B}{p_A+p_B}\g(p_A)+\dfrac{p_A}{p_A+p_B}\g(p_B).\]
    特别地，$p_A=p_B\coloneqq p$时，$\tau_{[2]}\sim\g(p)$.
    
    $\tau_{[1]},\tau_{[2]}$相互独立是因为
    \begin{align*}
        \p(\tau_{[1]}=\ell_1,\tau_{[2]}=\ell_2)
        &=\p(\tau_A=\ell_1+\ell_2,\tau_B=\ell_1)
        +\p(\tau_A=\ell_1,\tau_B=\ell_1+\ell_2)\\
        &=p_{A\uplus B}^{\ell_1-1}p_B\g(p_A,\ell_2)
        +p_{A\uplus B}^{\ell_1-1}p_A\g(p_B,\ell_2)\\
        &=\frac{\g(p_{A\uplus B},\ell_1)}{p_A+p_B}p_B\g(p_A,\ell_2)
        +\frac{\g(p_{A\uplus B},\ell_1)}{p_A+p_B}p_A\g(p_B,\ell_2)\\
        &=\g(p_{A\uplus B},\ell_1)
        \Big(\frac{p_B}{p_A+p_B}\g(p_A,\ell_2)
        +\frac{p_A}{p_A+p_B}\g(p_B,\ell_2)\Big)\\
        &=\p(\tau_{[1]}=\ell_1)\p(\tau_{[2]}=\ell_2).
    \end{align*}

    (6) \[\p(\tau_{[k]}=\ell)=\sum_{i_1,\cdots,i_{k-1}}
        \p(\text{已出现的是 }A_{i_1},\cdots,A_{i_{k-1}})
        \p(\tau_{A_k\uplus\cdots\uplus A_n}=\ell)
        =\g((n-k+1)p,\ell).\]
    \begin{align*}
        \p(\tau_{[1]}=\ell_1,\cdots,\tau_{[n]}=\ell_n)
        &=\sum_{i_1,\cdots,i_n}\p(\tau_{i_1}=\ell_1,\cdots,
        \tau_{i_n}=\ell_1+\cdots+\ell_n)\\
        &=n!(1-np)^{\ell_1-1}p\cdots(1-p)^{\ell_n-1}p\\
        &=\g(np,\ell_1)\cdots\g(p,\ell_n)
        =\p(\tau_{[1]}=\ell_1)\cdots\p(\tau_{[n]}=\ell_n).
    \end{align*}

    \item[5.30]
    对所有$1\le k\le n-1$，各
    \begin{align*}\p(X=k,X+Y=n)&=\p(X=k,Y=n-k)\\
    &=\p(X=k)\p(Y=n-k)\\&=pq^{k-1}pq^{n-k-1}=p^2q^{n-2}\end{align*}
    相同，又
    $$\sum_{k=1}^{n-1}\p(X=k,X+Y=n)=\p(X+Y=n),$$
    故$$\p(X=k\big|X+Y=n)=\frac{\p(X=k,X+Y=n)}{\p(X+Y=n)}=\frac{1}{n-1}.$$
    
    \item[5.31]
    注：熵（entropy）是反映分布为$p_1,\cdots,p_N$的随机变量的不确定性的值。
    例如，分布为$1,0,\cdots,0$的随机变量不具有任何不确定性，熵为$0$；
    分布为$\frac1N,\cdots,\frac1N$的随机变量具有最大的不确定性，
    毕竟都不能说哪个事件的可能性更大些，熵最大。

    (1) $(x\ln x)''=(\ln x+1)'>0$得$x\ln x$是凸函数，由Jensen不等式，
    \[H(X)\le-N_X\cdot\frac{1}{N_X}\ln\frac{1}{N_X}=\ln N_X;\]

    (2) 用$\ln x\le x-1$，等号当且仅当$x=1$。由
    $$H(X,Y)=-\sum_{x,y}\p(X=x,Y=y)\ln\p(X=x,Y=y),$$
    \begin{align*}
        H(X)+H(Y)&=-\sum_x\p(X=x)\ln\p(X=x)-\sum_y\p(Y=y)\ln\p(Y=y)\\
        &=-\sum_{x,y}\p(X=x,Y=y)\ln\p(X=x)-\sum_{x,y}\p(X=x,Y=y)\ln\p(Y=y),
    \end{align*}
    有\begin{align*}
        H(X)+H(Y)-H(X,Y)
        &=-\sum_{x,y}\p(X=x,Y=y)\ln\frac{\p(X=x)\p(Y=y)}{\p(X=x,Y=y)}\\
        &\ge-\sum_{x,y}\p(X=x,Y=y)\bigg(\frac{\p(X=x)\p(Y=y)}{\p(X=x,Y=y)}-1\bigg)\\
        &=-\sum_{x,y}\p(X=x)\p(Y=y)-\p(X=x,Y=y)=0,
    \end{align*}
    等号成立当且仅当$\p(X=x)\p(Y=y)/\p(X=x,Y=y)=1$对任意的$x,y$，即$X,Y$相互独立；

    (3) \begin{align*}
        H(X,Y)&=-\sum_{x,y}\p(X=x,Y=y)\ln\p(X=x,Y=y)\\
        &=-\sum_{x,y}\p(X=x,Y=y)\big(\ln\p(X=x)+\ln\p(Y=y\big|X=x)\big)\\
        &=H(X)+H(Y\big|X).
    \end{align*}

    \item[5.34]
    \[
        L(p) = \p \left(
        \begin{pmatrix} X_1 \\ \vdots \\ X_n \end{pmatrix}
        = \begin{pmatrix} x_1 \\ \vdots \\ x_n \end{pmatrix}
        \right) = p^n (1-p)^{x_1 + \cdots + x_n - n},
    \]
    令 $\dfrac {\partial \ln L(p)} {\partial p} = \dfrac n p + \dfrac {x_1 + \cdots + x_n - n} {p-1} = 0$,
    解得 $\hat p = \dfrac n {x_1 + \cdots + x_n}$.
\end{itemize}

== 数学期望与分布律 ==
\begin{itemize}
    \item[6.5]
    $\e[\tau]=\sm{k=1}kpq^{k-1}=p\sm{k=1}(x^k)'\big|_{x=q}
    =p\left(\frac{1}{1-x}\right)'\big|_{x=q}=p\frac{1}{(1-q)^2}=\frac{1}{p}$，

    $\e[\tau(\tau-1)]=\sm{k=1}k(k-1)pq^{k-1}=pq\sm{k=1}(x^k)''\big|_{x=q}
    =pq\left(\frac{1}{1-x}\right)''\big|_{x=q}=pq\frac{2}{(1-q)^3}=\frac{2q}{p^2}$，

    $\v(\tau)=\e[\tau^2]-(\e\tau)^2
    =\frac{2q}{p^2}+\frac{1}{p}-\frac{1}{p^2}=\frac{q}{p^2}$.

    \item[6.8]
    $\dis \int F(x+a)-F(x)\,{\rm d}x=\int\int_{(x,x+a]}{\rm d}\p{\rm d}x
    =\int\int_{[x,x+a)}{\rm d}x{\rm d}\p=a$.

    \item[6.9]
    注意\[[F(x+a)-F(x)]^{2023}\leqslant F(x+a)-F(x),\]
    等号成立当且仅当\[\p(x,x+a]=F(x+a)-F(x)=0\text{ 或 }1.\]
    明显的是，不能对所有的$x$都$\p(x-a,x]=0$，
    从而存在$b^*$使$\p(b^*-a,b^*]=1$。令
    \[b=\inf\{x\mid\p(x-a,x]=1\}\leqslant b^*.\]
    首先，$\forall b^-\!<b,\p(b^-\!-a,b^-]=0$，
    不然$\p(b^-\!-a,b^-]=1$，与$b$的最小性矛盾。

    并且，$\forall b^+\!>b,\p(b^+,\infty)=0$，
    不然对任何$b'\in[b,b^+)$有
    \[\p(b'-a,b']\leqslant\p(-\infty,b^+)=1-\p(b^+,\infty)<1,\]
    从而$\p(b'-a,b']=0$，同样与$b$的定义矛盾。结合这两点得
    \[\p(X=b)=\p(b^*-a,b^*]-\p(b^*-a,b)-\p(b,b^*]=1.\]
    反过来，\[\p(x-a,x]=\begin{cases}1,&b\in(x-a,x],\\
    0,&b\notin(x-a,x],\end{cases}\]
    从而\[F(x+a)-F(x)=\begin{cases}1,&x\in[b,a+b),\\
    0,&x\notin[b,a+b),\end{cases}\]
    因而积分值是$a$。

    \item[6.10]
    分部积分有
    $$aF(a)-\int_0^{F(a)}x\,{\rm d}F(x)=-a(1-F(a))-\int_{F(a)}^1x\,{\rm d}(1-F(x)),$$
    得
    $$a=\int_0^1x\,{\rm d}F(x)=\e X.$$

    \item[6.12]
    由于$$\e X^+\!+\e X^-
    =\int_0^\infty\p(X^+\!>x)\,{\rm d}x+\int_0^\infty\p(X^-\!>x)\,{\rm d}x
    =\int_0^\infty\p(|X|>x)\,{\rm d}x,$$
    且
    $$\sm{n=1}\p(|X|\ge n)\le\int_0^\infty\p(|X|>x)\,{\rm d}x\le\sm{n=0}\p(|X|\ge n).$$

    \item[6.19]
    即要证
    $$\bigg(\sum_{k=1}^n\e(X_k-\e X_k)(Y_k-\e Y_k)\bigg)^2
    \le\sum_{k=1}^n\e(X_k-\e X_k)^2\sum_{k=1}^n\e(Y_k-\e Y_k)^2,$$
    交换$\dis \sum_{k=1}^n$和$\e$并用Cauchy不等式即可。

    \item[6.34]
    对$\{1,\cdots,n\}$的各种排列$\{i_1,\cdots,i_n\}$，
    $(X_{i_1},\cdots,X_{i_n})$相互独立且同分布，由推论5.1.1，
    $\dfrac{X_{i_1}+\cdots+X_{i_m}}{X_{i_1}+\cdots+X_{i_n}}$同分布故同期望，
    其平均值是（从而平均期望也是）$\dfrac{m}{n}$，故期望都是$\dfrac{m}{n}$。

    \item[6.35]
    即$$\sum_{k=0}^\infty\frac{\lambda^k}{k!}e^{-\lambda}kg(k)
    =\lambda\sum_{k=0}^\infty\frac{\lambda^k}{k!}e^{-\lambda}g(k+1),$$
    左右皆是$\dis \sum_{k=1}^\infty\frac{\lambda^k}{(k-1)!}e^{-\lambda}g(k)$。

    \item[6.38]
    $f(X)-f(X'),g(X)-g(X')$均与$X-X'$同号，所以
    $$2\big(\e[f(X)g(X)]-\e[f(X)]\e[g(X)]\big)
    =\e[(f(X)-f(X'))(g(X)-g(X'))]\ge0.$$
\end{itemize}

== 条件数学期望与条件分布律 ==
\begin{itemize}
    \item[7.1]
    当$\e[X^2]<\infty$，$\e[(X-Y)^2]=2(\e[X^2]-\e[XY])\le4\e[X^2]<\infty$。

    当$\e[(X-Y)^2]<\infty$，即$\int\e[(X-y)^2]\,{\rm d}F(y)<\infty$，
    那么对某个$y$有$\e[(X-y)^2]<\infty$，
    于是$\e[X^2]\le\e[2((X-y)^2+y^2)]<\infty$。

    \item[7.3]
    由定理 6.3.4, 对于任意的 $y$,
    \begin{align*}
        \e|X-y| &= \int_0^{+\infty} \p (|X-y| > x ) \,{\rm d}x \\
        &= \int_0^{+\infty} \left( \p (X > y+x) + \p (X < y-x) \right) {\rm d}x \\
        &= \int_0^{+\infty} (1 - F(y+x)) \,{\rm d}x + \int_0^{+\infty} F(y-x) \,{\rm d}x \\
        &= \int_y^{+\infty} \left( 1 - F(x) \right) {\rm d}x + \int_{-\infty}^y F(x) \,{\rm d}x \\
        &= \int_{-\infty}^{+\infty} \left( \left( 1 - F(x) \right) 1_{\{y \le x\}} + F(x) 1_{\{y \ge x\}} \right) \mathrm dx ,
    \end{align*}
    然后用定理 7.3.3, 以及 Fubini 定理,
    \begin{align*}
        \e|X-Y| &= \e\left[ \e|X-y| \middle| _{y=Y} \right] \\
        &= \e\left[ \int_{-\infty}^{+\infty} \left( (1 - F(x)) 1_{\{Y \le x\}} + F(x) 1_{\{Y \ge x\}} \right) {\rm d}x \right] \\
        &= \int_{-\infty}^{+\infty} \left( (1 - F(x)) \e\left[ 1_{\{Y \le x\}} \right] + F(x) \e\left[ 1_{\{Y \ge x\}} \right] \right) {\rm d}x \\
        &= \int_{-\infty}^{+\infty} \big[ (1 - F(x)) F(x) + F(x) (1 - F(x)) \big] \,{\rm d}x \\
        &= 2 \int_{-\infty}^{+\infty} F(x) (1 - F(x)) \,{\rm d}x.
    \end{align*}

    \begin{align*}
        \e[|X-m|]&=-\int_{\{x-m<0\}}x-m\,{\rm d}F(x)-\int_{\{x-m\ge0\}}x-m\,{\rm d}(1-F(x))\\
        &=\int_{(-\infty,0)} F(x)\,{\rm d}(x-m)+\int_{[0,\infty)} 1-F(x)\,{\rm d}(x-m)\\
        &\le\int_{(-\infty,0)} 2[1-F(x)]F(x)\,{\rm d}(x-m)
        +\int_{[0,\infty)} 2F(x)[1-F(x)]\,{\rm d}(x-m)\\
        &=\e[|X-Y|].
    \end{align*}

    \item[7.5]
    与习题 7.3 相同，对于任意的 $y$, 有
    $$ \e|X-y| = \int_y^{+\infty} \left( 1 - F(x) \right) \mathrm dx + \int_{-\infty}^y F(x) \mathrm dx, $$
    从而
    $$ \e| X-m_X | = \int_{m_X}^{+\infty} \left( 1 - F(x) \right) \mathrm dx + \int_{-\infty}^{m_X} F(x) \mathrm dx. $$
    若 $y \ge m_X$,
    \begin{align*}
        \e|X-y| - \e| X-m_X | &= -\int_{m_X}^y (1 - F(x)) \mathrm dx + \int_{m_X}^y F(x) \mathrm dx \\
        &= \int_{m_X}^y (2F(x) - 1) \mathrm dx \ge 0,
    \end{align*}
    若 $y < m_X$,
    \begin{align*}
        \e|X-y| - \e| X-m_X | &= \int_y^{m_X} (1 - F(x)) \mathrm dx - \int_y^{m_X} F(x) \mathrm dx \\
        &= \int_y^{m_X} (1 - 2F(x)) \mathrm dx \ge 0.
    \end{align*}
    综上, 有 $\e| X-m_X | \le \e|X-y|$.

    由定理 7.3.3,
    $$ \e|X-Y| = \e\left[ \e|X-y| \middle| _{y=Y} \right] \ge \e\left[ \e| X-m_X | \middle| _{y=Y} \right] = \e| X-m_X | .$$

    \item[7.12]
    \begin{itemize}
    \item[(1)] $$\e S_\tau=\int\e(S_t)\,{\rm d}F(t)
    =\int t\,\e X_1\,{\rm d}F(t)=(\e\tau)\cdot\e X_1.$$
    \item[(2)] \begin{align*}
        \e[S_\tau^2]&=\int\e(S_t^2)\,{\rm d}F(t)
        =\int t\,\e[X_1^2]+(t^2-t)\e(X_1X_2)\,{\rm d}F(t)\\
        &=(\e\tau)\cdot\e[X_1^2]+\big(\e[\tau^2]-\e\tau\big)(\e X_1)^2,
    \end{align*}
    于是$$\v(S_\tau)=\e[S_\tau^2]-(\e S_\tau)^2
    =(\e\tau)\cdot\big(\e[X_1^2]-(\e X_1)^2\big)
    +(\e X_1)^2\big(\e[\tau^2]-(\e\tau)^2\big).$$
    \end{itemize}

    \item[7.23]
    知道！
    \begin{align*}\varphi(\e[\xi|\G])&=\varphi\left(\int_B\xi\,{\rm d}\p|_\G\right)\\
    &=\sup_{(a,b)\in S}a\int_B\xi\,{\rm d}\p|_\G+b\\
    &=\sup_{(a,b)\in S}\int_Ba\xi+b\,{\rm d}\p|_\G\\
    &\le\int_B\varphi(\xi)\,{\rm d}\p|_\G=\e[\varphi(\xi)|\G].\end{align*}
\end{itemize}

== 随机变量及其分布律(II) ==
\begin{itemize}
    \item[例8.19]
    基于$X_1=\frac{T_1/m}{T_2/n},X_2=T_2$得到
    \[\iint\rho_{1,2}(x_1,x_2)\,{\rm d}x_1{\rm d}x_2
    =\iint\frac{(\frac12)^{\frac m2}(\frac mn x_1x_2)^{\frac m2-1}}
    {\Gamma\big(\frac m2\big)}e^{-\frac mn\cdot\frac{x_1x_2}{2}}1_{(0,\infty)}
    \Big(\frac mn x_1x_2\Big)
    \frac{(\frac12)^{\frac n2}x_2^{\frac n2-1}}
    {\Gamma\big(\frac n2\big)}e^{-\frac{x_2}{2}}1_{(0,\infty)}(x_2)
    \,{\rm d}\Big(\frac mn x_1x_2\Big){\rm d}x_2,\]
    从而
    \[\rho_{1,2}(x_1,x_2)
    =\frac{(\frac12)^{\frac m2}(\frac mn x_1x_2)^{\frac m2-1}}
    {\Gamma\big(\frac m2\big)}e^{-\frac mn\frac{x_1x_2}{2}}1_{(0,\infty)}(x_1)
    \frac{(\frac12)^{\frac n2}x_2^{\frac n2-1}}
    {\Gamma\big(\frac n2\big)}e^{-\frac{x_2}{2}}1_{(0,\infty)}(x_2)\frac mn x_2.\]
    进而
    \begin{align*}
        f_{m,n}(x)&=\int\rho_{1,2}(x,x_2)\,{\rm d}x_2\\
        &=\int_0^\infty\frac{(\frac mn\frac{xx_2}{2})^{\frac m2-1}}
        {\Gamma\big(\frac m2\big)}e^{-\frac mn\frac{xx_2}{2}}1_{(0,\infty)}(x)
        \frac{{(\frac{x_2}{2})}^{\frac n2-1}}{\Gamma\big(\frac n2\big)}
        e^{-\frac{x_2}{2}}x_2\,{\rm d}\Big(\frac mn\frac{x_2}{2}\Big)\\
        &=\frac{1}{\Gamma\big(\frac m2\big)\Gamma\big(\frac n2\big)}
        \Big(\frac mn\Big)^{\frac m2}
        x^{\frac m2-1}\int_0^\infty\Big(\frac{x_2}{2}\Big)^{\frac{m+n}{2}-1}
        e^{-(1+\frac mn x)\frac{x_2}{2}}
        x_2\,{\rm d}\Big(\frac{x_2}{2}\Big)1_{(0,\infty)}(x)\\
        &=\frac{\Gamma\big(\frac{m+n}{2}\big)}{\Gamma\big(\frac m2\big)\Gamma\big(\frac n2\big)}
        \Big(\frac mn\Big)^{\frac m2}
        x^{\frac m2-1}\Big(1+\frac mn x\Big)^{-\frac{m+n}{2}}1_{(0,\infty)}(x).
    \end{align*}

    \item[$\boxed{思考题}$]
    设$X_1,X_2$独立同分布于$N(0,1)$。证明：$(X_1,X_2)\stackrel{\mathrm{d}}{=}(X_1\operatorname{sgn}(X_2),X_2)$。

    \begin{align*}
        &\p(X_1\operatorname{sgn}(X_2)\le x,X_2\le y)\\
        &=\p(X_1\le x,0<X_2\le y)+\p(0\le x,X_2=0)+\p(-X_1\le x,X_2<0)\\
        &=\p(X_1\le x)\p(0<X_2\le y)+0+\p(-X_1\le x)\p(X_2<0)\\
        &=\p(X_1\le x)\big(\p(0<X_2\le y)+0+\p(X_2<0)\big)\\
        &=\p(X_1\le x,X_2\le y).
    \end{align*}

\item[$\boxed{\textbf{一个引理}}$]
设$X,Y$为连续型变量,且其联合分布的概率密度函数$\rho_{X,Y}$可以分离变量，
i.e. $\rho_{X,Y}(x,y) = \rho_1(x) \cdot \rho_2(y)$，
并且$\int_{\R} \rho_1 = \int_{\R} \rho_2 = 1$，
那么$X,Y$独立，且$\rho_1,\rho_2$分别为$X,Y$的密度函数。

\begin{proof}
    由于$X,Y$是连续型变量,故由其边缘分布性质可得
    \[\rho_X(x) = \int_{-\infty}^{+\infty} \rho_{X,Y}(x,y)\,\mathrm{d}y 
    = \rho_1(x)\int_{-\infty}^{+\infty}\rho_2(y)\,\mathrm{d}y = \rho_1(x).\]
    同理$\rho_2 = \rho_Y$，因此由$\rho_{X,Y} = \rho_X \cdot \rho_Y$知$X,Y$独立。
\end{proof}

\item[8.1]
(1)  由$\Gamma$的半生成性直接得到$Y_1 \sim \Gamma(\alpha_1 + \alpha_2, \lambda)$,

考虑变换
\[\phi:(X_1,X_2) \to (Y_1, Y_2), \quad (x_1, x_2) \mapsto \left(x_1+x_2, \frac{x_1}{x_1+x_2}\right),\]

则$|\det(D\phi^{-1})| = |-(x_1+x_2)|$，因此
\begin{align}
    \rho_{Y_1, Y_2} (y_1, y_2) &= \rho_{X_1, X_2}(\phi^{-1}(y_1, y_2)) \cdot |\det(D\phi^{-1})|\\
&= \rho_{X_1, X_2}(y_1y_2, y_1(1-y_2))  \cdot |y_1| \\
&= \rho_{X_1}(y_1y_2) \cdot \rho_{X_2} (y_1(1-y_2)) \cdot |y_1| \\
&= \frac{\lambda^{\alpha_1 + \alpha_2}}{\Gamma(\alpha_1)\Gamma(\alpha_2)} y_1^{\alpha_1 + \alpha_2 - 1} \cdot e^{-\lambda y_1} \cdot y_2^{\alpha_1-1} \cdot (1-y_2)^{\alpha_2 -1}\\
&= \left[\frac{\lambda^{\alpha_1 + \alpha_2}}{\Gamma(\alpha_1+\alpha_2)}y_1^{\alpha_1 + \alpha_2 - 1} \cdot e^{-\lambda y_1}\right] 
\cdot \frac{y_2^{\alpha_1 - 1}(1-y_2)^{\alpha_2 - 1}}{\Beta(\alpha_1, \alpha_2)}.
\end{align}
并且容易注意到
\[\int_{\R} \frac{\lambda^{\alpha_1 + \alpha_2}}{\Gamma(\alpha_1+\alpha_2)}y_1^{\alpha_1 + \alpha_2 - 1} \cdot e^{-\lambda y_1} \mathrm{d} y_1 = 1, 
\quad \int_{\R}\frac{y_2^{\alpha_1 - 1}(1-y_2)^{\alpha_2 - 1}}{\Beta(\alpha_1, \alpha_2)}\mathrm{d}y_2 = 1.\]

因此由引理可知$Y_1, Y_2$独立且$Y_2 \sim \mathrm{Beta}(\alpha_1, \alpha_2)$.

(2)
考虑变换\[\phi:(X_1,X_2) \to (Y_1, Z_2), (x_1, x_2) \mapsto \left(x_1+x_2, \frac{x_1}{x_2}\right),\]

则\[D\phi = \begin{bmatrix}
1 & 1 \\ \\
\frac{1}{x_2} & -\frac{x_1}{x_2^2}
\end{bmatrix},\]
从而
\[|\det (D\phi^{-1})| = |-\frac{x_1+x_2}{x_2^2}|,\]
因此
\begin{align}
    \rho_{Y_1, Z_2}(y_1, z_2) &= \rho_{X_1, X_2}(\phi^{-1}(y_1, z_2)) \cdot |\det(D\phi^{-1})| \\
    &= \rho_{X_1, X_2}\left(\frac{z_2 y_1}{z_2+1}, \frac{y_1}{z_2+1}\right) \cdot \frac{y_1}{(z_2+1)^2} \\
    &= \rho_{X_1}\left(\frac{z_2 y_1}{z_2+1}\right) \cdot \rho_{X_2}\left(\frac{y_1}{z_2+1}\right) \cdot \frac{y_1}{(z_2+1)^2} \\
    &= \frac{\lambda^{\alpha_1}\big(\frac{z_2y_1}{z_2+1}\big)^{\alpha_1-1}}{\Gamma(\alpha_1)} 
    \cdot \frac{\lambda^{\alpha_2}\big(\frac{y_1}{z_2+1}\big)^{\alpha_2 - 1}}{\Gamma(\alpha_2)} 
    \cdot e^{\lambda y_1} \cdot \frac{y_1}{(z_2+1)^2}\\
    &= \frac{\lambda^{\alpha_1 + \alpha_2} \cdot y_1^{\alpha_1 + \alpha_2 - 1}\cdot e^{\lambda y_1}}{\Gamma{(\alpha_1)} \Gamma{(\alpha_2)}} 
    \cdot \frac{z_2^{\alpha_1 - 1}}{\Beta(\alpha_1, \alpha_2) \cdot (1+z_2)^{\alpha_1+ \alpha_2}}.
\end{align}

并且容易注意到:
\[\int_{\R} \frac{\lambda^{\alpha_1 + \alpha_2} \cdot y_1^{\alpha_1 + \alpha_2 - 1}\cdot e^{\lambda y_1}}{\Gamma{(\alpha_1)} \Gamma{(\alpha_2)}} \mathrm{d}y_1 = 1, \quad
\int_{\R} \frac{z_2^{\alpha_1 - 1}}{\Beta(\alpha_1, \alpha_2) \cdot (1+z_2)^{\alpha_1+ \alpha_2}} \mathrm{d} z_2= 1.\]

因此由引理可知$Y_1, Z_2$独立，并且$Z_2 \sim \operatorname{Beta}(\alpha_1, \alpha_2).$

\item[8.2]
(1)利用定义容易得到:
\begin{align}
    \rho_{X^2}(t) &= \rho_{X}(\sqrt{t}) \cdot \frac{1}{2\sqrt{t}} \cdot 2\\
&= \frac{e^{\frac{t}{2}}}{\sqrt{2\pi t}} \\
&= \frac{\sqrt{\frac12} \cdot e^{-\frac{t}{2}}}{\Gamma\big(\frac{1}{2}\big) \cdot \sqrt{t}}.
\end{align}
因此$X^2 \sim \Gamma\big(\frac12,\frac12\big)$,
利用$\Gamma$的半生成性得到$\chi^2(n) \sim \Gamma\big(\frac n2, \frac12\big)$。

(2)此时
\[\rho_{X^2}(t) = \frac{2\rho(\sqrt t; \mu_1, 1)}{2\sqrt t} 
= \frac{-e^{\frac{(\sqrt{t}-\mu_1)^2}{2}}}{\sqrt{2\pi t}}.\]
\end{itemize}



== 随机变量及其分布律(III) ==
\begin{itemize}
    \item[9.4]
    只需对任意$M>0$,有$\mathbb{P}(x_1=x_2\in [-M,M]) = 0$。(在此基础上,利用
    \[\{x_1 = x_2\} = \bigcup_{M=1}^{\infty} \{x_1 = x_2 \in [-M,M]\}\]即可得证!)

    由于$F_1$连续,得知$F_1$在$[-M,M]$中一致连续,因此$\forall \varepsilon > 0$，存在一个对$[-M,M]$的剖分
    $$-M = m_0 < m_1 < \cdots < m_N = M$$
    使得$F_1(m_{i}) - F_1(m_{i-1}) < \varepsilon, \forall i = 1,2,\cdots,N$,那么:
    \begin{align}
        \p(x_1 = x_2 \in [-M,M]) &= \p\left(x_1=x_2 \in \bigcup_{i=1}^N [m_{i-1}, m_i)\right) \\
        &\leq \sum_{i=1}^N \p (x_1 \in [m_{i-1}, m_i) \text{ 且 } x_2 \in [m_{i-1}, m_i)) \\
       &= \sum_{i=1}^N \p (x_1 \in [m_{i-1}, m_i)) \cdot \p(x_2 \in [m_{i-1}, m_i))\\
        &\leq \sum_{i=1}^N \varepsilon \cdot \p(x_2 \in [m_{i-1}, m_i)) = \varepsilon \cdot \p(x_2 \in [-M,M]).
    \end{align}
    然后令$\varepsilon \to 0$,得到$\p(x_1 = x_2 \in [-M,M]) = 0$.因而得证!
    
    另证:
    
    \begin{align*}
        \mathbb{P}(X_1=X_2)&=\mathbb{E}[\mathbb{E}[1_{\{X_1-X_2=0\}}|X_2]],\mathbb{E}[1_{\{X_1-X_2=0\}}|X_2]\\
        &=\mathbb{E}[1_{\{X_1-a=0\}}|X_2]\big|_{a=X_2}=\mathbb{E}[1_{\{X_1-a=0\}}]\big|_{a=X_2}=0.
    \end{align*}

    注:定理7.3.3可以叙述成不需要独立性假设的形式(由于正则条件分布存在,正则条件分布的相关结论可以参考《测度论讲义》(严加安) 7.3节,不过书中使用“混合条件分布”这一术语).
    
    给定随机向量$\mathbb{X},\mathbb{Y}$,可测函数$\varphi$使得$\mathbb{E}[\varphi(\mathbb{X},\mathbb{Y})]$存在.
    记正则条件分布$\mathbb{X}\,|\,\mathbb{Y}\!=\mathbf{y}\sim \mu( \cdot \, |\mathbf{y})$, $\mathbb{E}[\varphi(\mathbb{X},\mathbb{Y})|\mathbb{Y}=\mathbf{y}]=\int \varphi(\mathbf{x},\mathbf{y})d\mu(\mathbf{x}|\mathbf{y}),
     \mathbb{E}[\varphi(\mathbb{X},\mathbf{y}')|\mathbb{Y}=\mathbf{y}]=\int \varphi(\mathbf{x},\mathbf{y}')d\mu(\mathbf{x}|\mathbf{y})$,则知$\mathbb{E}[\varphi(\mathbb{X},\mathbb{Y})|\mathbb{Y}]=\mathbb{E}
     [\varphi(\mathbb{X},\mathbf{y}')|\mathbb{Y}]\big|_{\mathbf{y}'=\mathbb{Y}}$.

    \item[9.7]
    即说明对$(0,1)$的所有Borel子集$A$有
    \[\p\Big(\sum_{n=1}^\infty\frac{X_n}{2^n}\in A\Big)=|A|.\]
    此式对二进制区间$A=\big[a,a+\frac{1}{2^m}\big)$成立，
    其中$\displaystyle a=\sum\limits_{n=1}^m\frac{a_n}{2^n}$，这是因为
    \[\p\Big(\sum_{n=1}^\infty\frac{X_n}{2^n}\in\Big[a,a+\frac{1}{2^m}\Big)\Big)
    =\p(X_1=a_1,\cdots,X_m=a_m)=\Big(\frac12\Big)^m
    =\Big|\Big[a,a+\frac{1}{2^m}\Big)\Big|.\]
    对一般的$A$，对任何$\varepsilon>0$，存在二进制区间的有限组合$A^+,A^-$，
    使得$A^-\subset A\subset A^+$
    且$|A^+\setminus A|,|A\setminus A^-|<\varepsilon$，用下式完成逼近
    \[|A|-\varepsilon<|A^-|<\p\Big(\sum_{n=1}^\infty\frac{X_n}{2^n}\in A\Big)
    <|A^+|<|A|+\varepsilon.\]


    \item[9.11]
    由习题8.12,可以设$\begin{cases}
        X_1 = R \cos \Theta \\
        X_2 = R \sin \Theta 
    \end{cases},$那么有$R, \Theta$互相独立。记
    \[Y = \frac{X_1 X_2}{\sqrt{X_1^2 + X_2^2}} 
    = R \cos \Theta \sin\Theta = \frac{R\sin2\Theta}{2},\]
    由于$R$与$\sin\Theta$独立,那么$R$与$\sin 2\Theta$也独立，
    并且$\sin \Theta$和$\sin 2 \Theta$同分布
    (由于$[0,1)$的均匀分布乘$2$再取小数部分还是$[0,1)$均匀分布)，故
    $$\frac{R\sin 2 \Theta}{2}\sim \frac{R \sin\Theta}{2} \sim \frac12X_1 \sim N\Big(0,\frac{1}{4}\Big).$$

    \item[定理9.2.3] 使用概率微元法的形式演算:
    \begin{align*}
        &\p(\cdots,U_{(k)}\in(x_k,x_k+dx_k],
        \frac{U_{(k+1)}-U_{(k)}}{U_{(\ell)}-U_{(k)}}\in(t_{k+1},t_{k+1}+dt_{k+1}],\\
        &\quad\ \cdots,\frac{U_{(\ell-1)}-U_{(k)}}{U_{(\ell)}-U_{(k)}}\in(t_{\ell-1},t_{\ell-1}+dt_{\ell-1}],
        U_{(\ell)}\in(x_\ell,x_\ell+dx_\ell],\cdots)\\
        &=\p(\cdots,U_{(k)}\in(x_k,x_k+dx_k],
        U_{(k+1)}\in(t_{k+1}U_{(\ell)}+(1-t_{k+1})U_{(k)},
        (t_{k+1}+dt_{k+1})U_{(\ell)}+(1-t_{k+1}-dt_{k+1})U_{(k)}],\\
        &\quad\ \cdots,U_{(\ell-1)}\in(t_{\ell-1}U_{(\ell)}+(1-t_{\ell-1})U_{(k)},
        (t_{\ell-1}+dt_{\ell-1})U_{(\ell)}+(1-t_{\ell-1}-dt_{\ell-1})U_{(k)}],
        U_{(\ell)}\in(x_\ell,x_\ell+dx_\ell],\cdots)\\
        &=\big(\rho_{(1,\cdots,n)}(x_1,\cdots,x_k,
        t_{k+1}x_{\ell}+(1-t_{k+1})x_k,\cdots,
        t_{\ell-1}x_{\ell}+(1-t_{\ell-1})x_k,x_\ell,\cdots,x_n)+o(1)\big)\\
        &\quad\ dx_1\cdots dx_k(x_\ell-x_k)dx_{k+1}\cdots(x_\ell-x_k)dx_{\ell-1}
        dx_\ell\cdots dx_n\\
        &=n!(x_\ell-x_k)^{\ell-k-1}
        1_{\{0<x_1<\cdots<x_k<t_{k+1}x_{\ell}+(1-t_{k+1})x_k<\cdots
        <t_{\ell-1}x_{\ell}+(1-t_{\ell-1})x_k<x_\ell<\cdots<x_n<1\}}
        dx_1\cdots dx_n\\
        &=\frac{n!}{(\ell-k-1)!}(\ell-k-1)!(x_\ell-x_k)^{\ell-k-1}
        1_{\{0<x_1<\cdots<x_k<x_\ell<\cdots<x_n<1\}}
        1_{\{0<t_{k+1}<\cdots<t_{\ell-1}<1\}}dx_1\cdots dx_n\\
        &=\rho_{(1,\cdots,k,\ell,\cdots,n)}(x_1,\cdots,x_k,x_\ell,\cdots,x_n)
        \rho_{(1,\cdots,\ell-k-1)}(t_{k+1},\cdots,t_{\ell-1})dx_1\cdots dx_n.
    \end{align*}

    注(关于9.2节中使用的“概率微元法”的数学严格性以及例8.3中(8.10)式的说明):
    记$n$维Lebesgue测度为$m$,若$\mu\ll m$, Radon-Nikodym导数$\frac{d\mu}{dm}$的计算方法参考\textit{Integration and Modern Analysis} by John Benedetto 一书中的Definition 8.4.2, Corollary 8.4.5.
    
    使用该结论然后注意到连续型分布的密度函数就是分布测度关于Lebesgue测度的Radon-Nikodym导数,不难将9.2节中$n$个服从连续型分布的i.i.d.样本的次序统计量的密度函数的相关结论的推导严格化,
    例8.3中的(8.10)也可以给出证明(这里推广到了随机向量,并且$X,Y$的分布可以是任意的,不需要具有联合密度):

    定义 \(g(\mathbf{y}):= \mathbb{E}[f(\mathbb{X},\mathbb{Y})| \mathbb{Y} = \mathbf{y}]\),对任意Borel集 \(A\), 
    \[\int_{\{\mathbb{Y} \in A\}} f(\mathbb{X},\mathbb{Y}) d\mathbb{P} = \int_A g(\mathbf{y}) \, d\mu_{\mathbb{Y}}(\mathbf{y}).\]
    令 \(\nu(A) = \int_A g \, d\mu_{\mathbb{Y}}\),则 \(\nu \ll \mu_{\mathbb{Y}}\) 且 \(\frac{d\nu}{d\mu_{\mathbb{Y}}} = g,\) \(\mu_{\mathbb{Y}}\)-a.e.

    令\(B_\delta = (\mathbf{y} - \delta \cdot \mathbf{1}, \mathbf{y}]\),其中 \(\delta > 0\). $\lim\limits_{\delta \to 0^+} \dfrac{\nu(B_\delta)}{\mu_{\mathbb{Y}}(B_\delta)} = g(\mathbf{y})$, \(\mu_{\mathbb{Y}}\)-a.e.

    注意到

    \[\nu(B_\delta) = \int_{B_\delta} g \, d\mu_{\mathbb{Y}} = \int_{\{\mathbb{Y} \in B_\delta\}} f(\mathbb{X},\mathbb{Y}) d\mathbb{P},\]
    \[\mu_{\mathbb{Y}}(B_\delta) = \mathbb{P}(\mathbb{Y} \in B_\delta).\]
    
    因此,

    \[\frac{\nu(B_\delta)}{\mu_{\mathbb{Y}}(B_\delta)} 
    = \dfrac{\int_{\{\mathbb{Y} \in B_\delta\}} f(\mathbb{X},\mathbb{Y}) d\mathbb{P}}{\mathbb{P}(\mathbb{Y} \in B_\delta)} 
    = \mathbb{E}[f(\mathbb{X},\mathbb{Y}) | \mathbb{Y} \in B_\delta],\]

     即$\mathbb{E}[f(\mathbb{X},\mathbb{Y}) | \mathbb{Y} = \mathbf{y}]=
     \lim\limits_{\delta \to 0^+} \mathbb{E}[f(\mathbb{X},\mathbb{Y}) | \mathbb{Y} \in (\mathbf{y} - \delta \cdot \mathbf{1}, \mathbf{y}]],$\,\(\mu_{\mathbb{Y}}\)-a.e.
    
    定理9.2.3本身的严格证明并不困难,由于已有定理9.2.2(iii)中的结论,那么可以利用定理8.2.2构造一个双射$\varphi$去计算$(U_{(1)},\ldots,U_{(k)},\frac{U_{(k+1)}-U_{(k)}}{U_{(\ell)}-U_{(k)}},\ldots,\frac{U_{(\ell-1)}-U_{(k)}}{U_{(\ell)}-U_{(k)}} , U_{(\ell)},\ldots,U_{(n)} )$的联合密度函数,不难发现$\varphi^{-1}$的Jacobi行列式其实形式简单.
    
\end{itemize}

== 随机变量列的收敛与大数律 ==
\begin{itemize}
    \item[10.2]设$X_n\stackrel{\p}{\longrightarrow}0$，则
    $$\e\Big[\frac{|X_n|}{1+|X_n|}\Big]
    =\int_{|X_n|\ge\varepsilon}\frac{|X_n|}{1+|X_n|}\,{\rm d}\p
    +\int_{|X_n|<\varepsilon}\frac{|X_n|}{1+|X_n|}\,{\rm d}\p
    \le\p(|X_n|\ge\varepsilon)+\frac{\varepsilon}{1+\varepsilon},$$
    令$\varepsilon$小再令$n$大，上式就任意小。
    反过来，设$X_n\stackrel{\p}{\longrightarrow}0$不成立，
    即存在$\varepsilon,\delta$使得存在任意大的$n$
    使$\p(|X_n|\ge\varepsilon)\ge\delta$，则
    $$\e\Big[\frac{|X_n|}{1+|X_n|}\Big]
    \ge\delta\frac{\varepsilon}{1+\varepsilon}.$$

    \item[10.3]
    $$x\e\Big[\frac{1}{X}\cdot1_{\{X>x\}}\Big]
    =x\int_{\{X>x\}}\frac{{\rm d}\p(X)}{X}
    \le\int_{\{X>x\}}{\rm d}\p(X)=\p(X>x)\to0.$$

    \item[10.20]
    (i) 对$\xi_n\stackrel{\p}{\longrightarrow}0$，对任意$\varepsilon>0$，
    取$N$使$\forall n>N,\p(|\xi_n|\ge1)<\varepsilon$，
    对$k=1,\cdots,N$，取$M_k$使$\p(|\xi_k|\ge M_k)<\varepsilon$，
    令$M=\max(1,M_1,\cdots,M_N)$。

    (ii) $\p(|\xi_n+\eta_n|\ge\varepsilon)
    \le\p(|\xi_n|\ge\frac{\varepsilon}{2})
    +\p(|\eta_n|\ge\frac{\varepsilon}{2})\to0$。

    \quad\ \ $\sup_n\p(|\xi_n+\eta_n|\ge2M)
    \le\sup_n\p(|\xi_n|\ge M)+\sup_n\p(|\eta_n|\ge M)$充分小。

    (iii) $\p(|\xi_n\eta_n|\ge\varepsilon)
    \le\p(|\xi_n|\ge\frac{\varepsilon}{M})+\sup_n\p(|\eta_n|\ge M)$，
    令$M$大再令$n$大。

    \quad\ \ \ $\sup_n\p(|\xi_n\eta_n|\ge M^2)
    \le\sup_n\p(|\xi_n|\ge M)+\sup_n\p(|\eta_n|\ge M)$充分小。
    
    \item[10.28]
   
    先证明一个引理： $N$ 个人至少有一个人拿对了信封的概率是
    $\displaystyle \sum_{k=1}^{N} \frac{(-1)^{(k-1)}}{k!}$。
    
    
    记 $A_{i}$ 表示第 $i$ 个人拿到对的信封，$\mathbb{P}(A_{i})=\frac{1}{N}, \mathbb{P}(A_{i} A_{j})=\frac{1}{N(N-1)}$，
    其余同理，则引理所求事件的概率为(用容斥原理)
    \[\mathbb{P}\left(\bigcup_{i=1}^{N} A_{i}\right)=\sum_{i=1}^{N} \frac{(-1)^{(i-1)}}{i!}.\]
    
    接下来考虑  $N_{n}=k$，$n$ 封信中挑出 $k$ 封有 $\binom{n}{k}$ 种取法，
    对于指定的 $k$ 个人拿对信封的概率为  $\frac{1}{n(n-1) \cdots(n-k+1)}$，
    对于剩下的  $n-k$ 个人，利用引理，可知他们都没拿对的概率为
    \[1-\sum_{i=1}^{n-k} \frac{(-1)^{(i-1)}}{i!}=\sum_{i=0}^{n-k} \frac{(-1)^{i}}{i!}.\]
    
    于是
    \[\mathbb{P}(N_{n}=k)=\binom{n}{k} \frac{1}{n(n-1) \cdots(n-k+1)} \sum_{i=0}^{n-k} \frac{(-1)^{i}}{i!},\]
    令 $n \rightarrow \infty$，
    $\mathbb{P}(N_{n}=k) \rightarrow \frac{e^{-1}}{k!}$，从而得证！


    \item[10.31]
考虑  $A_{n,t}=\{X_{n} \geq t a_{n}\}$，其中  $a_{n}=-\log_{q} n$。由于
\[\sum_{n=1}^{\infty} \mathbb{P}(A_{n, t})=q^{\left[t a_{n}\right]},\]
将 $a_{n}$ 写成以 $e$ 为底的形式，可以发现当 $t>1$ 时级数收敛；当  $t \leq 1 $ 时，级数发散。
根据 Borel--Cantelli 引理，再结合 10.30 的结论可得到关于上极限的结论。

接下来，因为 $\max \left\{X_{1}, X_{2}, \cdots, X_{n}\right\} \geq X_{n}$，
因此同除 $a_{n}$，再令 $n \rightarrow \infty$，得到下极限对应的结论。

    \item[10.40]
   
先注意到一个事实: $a,b \in [0,1]$，则 $(1-a-b)^{n} \leq (1-a)^{n}(1-b)^{n}$.

设离散型分布的值域为 $S$ (为一个至多可列集合)，
记 $p_{x}=\mathbb{P}(X_{1}=x)$，则
\[R_{n}=\sum_{x \in S} 1_{x \in\{X_{1}, \cdots X_{n}\}},\quad
\mathbb{E} R_{n}=\sum_{x \in S}\big(1-(1-p_{x})^{n}\big),\]
\begin{align*}
\operatorname{Var}(R_{n})&=\sum_{x \in S, y \in S} \operatorname{Cov}\left(1_{x \in\left\{X_{1}, \cdots, X_{n}\right\}}, 1_{y \in\left\{X_{1} \ldots X_{n}\right\}}\right) \\
&=\sum_{x \in S} \operatorname{Var}\left(1_{x \in \{X_{1}, \cdots, X_{n}\}}\right)
+\sum_{x \neq y} \operatorname{Cov}\left(1_{x \in \{X_{1}, \cdots, X_{n}\}}, 1_{y \in \{X_{1}, \cdots, X_{n}\}}\right).
\end{align*}


记 $A_{x}=\left\{x \notin \{X_{1}, \cdots, X_{n}\}\right\}$，
下面利用注意到的事实和 $n=2$ 的容斥原理，易证交叉项非正（不严谨地说，交叉项的两个事件是负相关的）。
由  $\mathbb{E} R_{n}$ 的表达式，易验证满足定理10.3.2条件。
\end{itemize}