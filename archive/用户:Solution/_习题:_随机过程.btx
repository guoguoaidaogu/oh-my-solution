\newcommand{\F}{\mathcal{F}}
\newcommand{\G}{\mathcal{G}}
\renewcommand{\P}{\mathbb{P}}
\newcommand{\W}{\mathcal{W}}
\newcommand{\eps}{\varepsilon}
\newcommand{\bE}{\overline{\E}}
\newcommand{\bp}{\bar{p}}
\newcommand{\bP}{\overline{\P}}
