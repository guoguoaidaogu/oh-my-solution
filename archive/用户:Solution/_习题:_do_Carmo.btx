\end{itemize}

== The Rauch Comparison Theorem ==

\begin{itemize}
    \item[2.] Take $K_0>0$ arbitrarily small in Klingenberg's lemma 
    and show that if $M$ is simply connected, 
    there exists a unique geodesic joining the two points $p,q\in M$. 
    This is because were there to exist two such geodesics $\alpha_0$ 
    and $\alpha_1$, they would be homotopic by the simple connectedness, 
    and by Klingenberg's lemma, there would exist a sequence of curves 
    $\alpha_t$ in this homotopy of lengths $\ge\pi/\sqrt{K_0}$, 
    which would be arbitrarily big; however, $\ell(\alpha_t)$ 
    as a continuous function of $t\in[0,1]$ is bounded, a contradiction.

    This asserts that $\exp_p\colon T_pM\to M$ is a one-one map. 
    That is, it has an inverse $\exp_p^{-1}$. 
    It suffices to show that $\exp_p$ is a local diffeomorphism then, 
    as this will imply that $\exp_p^{-1}$ is continuous locally, 
    and hence globally. This is a consequence of Rauch's Theorem, 
    in combination with Chapter 5 Proposition 3.5 (p.117) 
    (and Chapter 0 Theorem 2.10, p.10).

    \item[3.] Note that $\tilde{\gamma}(t)=tv$ is a geodesic on $T_pM$, 
    and $\tilde{J}(t)=tw$ is a Jacobi field along $\tilde{\gamma}$; 
    further, $J(t)=(d\exp_p)_{tv}(tw)$ is a Jacobi field along $\gamma$. As
    \[J(0)=\tilde{J}(0)=0,\quad J'(0)=\tilde{J}'(0)=w,
    \quad \gamma'(0)=\tilde{\gamma}'(0)=v,\]
    and $K\le0=\tilde{K}$, we have $|J(1)|\ge|\tilde{J}(1)|$, 
    which is $|(d\exp_p)_v(w)|\ge|w|$.

    \item[5.] a) For all $t\in[0,\ell]$, integration by parts gives
    \begin{align*}
        0&=\int_0^t\tilde{f}(f''+Kf)-f(\tilde{f}''+\tilde{K}\tilde{f})\\
        &=[\tilde{f}f'-f\tilde{f}']_0^t+\int_0^t(K-\tilde{K})f\tilde{f}.
    \end{align*}
    From the initial conditions $f(0)=0$ and $f'(0)=1$, 
    $f$ is positive in a neighborhood of $0$. Assume that $f(t_1)=0$ 
    for certain $t_1<t_0$. Then take $t=t_1$ and get
    \[0=\big(\underbrace{\tilde{f}(t_1)}_{>0}\underbrace{f'(t_1)}_{\le0}
    -\underbrace{f(t_1)}_{=0}{\tilde{f}'(t_1)}\big)
    -\big(\underbrace{\tilde{f}(0)}_{=0}f'(0)
    -\underbrace{f(0)}_{=0}\tilde{f}'(0)\big)
    +\int_0^{t_1}(\underbrace{K-\tilde{K}}_{\le0})\underbrace{f\tilde{f}}_{>0},\]
    forcing $K\equiv\tilde{K}$. 
    Then $f$ and $\tilde{f}$ satisfy exactly the same ode, 
    with the same initial conditions 
    $f(0)=\tilde{f}(0)=0$ and $f'(0)=\tilde{f}'(0)=1$, 
    and for this reason $f\equiv\tilde{f}$.

    b) Again, examine
    \[0=\big(\tilde{f}(t)f'(t)-f(t)\tilde{f}'(t)\big)
    -\big(\underbrace{\tilde{f}(0)}_{=0}f'(0)
    -\underbrace{f(0)}_{=0}\tilde{f}'(0)\big)
    +\int_0^t(\underbrace{K-\tilde{K}}_{\le0})\underbrace{f\tilde{f}}_{>0}.\]
    It follows that $\tilde{f}f'-f\tilde{f}'\ge0$, that is, 
    $(f/\tilde{f})'=(\tilde{f}f'-f\tilde{f}')/(\tilde{f}^2)\ge0$. 
    Conclude by
    \[f/\tilde{f}\ge\lim_{t\to0}(f/\tilde{f})=\lim_{t\to0}(f'/\tilde{f}')=1.\]
    For equality, $\tilde{f}f'-f\tilde{f}'\equiv0$ 
    forces $K\equiv\tilde{K}$ as a).
    
    To verify the Theorem of Rauch in dimension two as an application, 
    first reduce the Jacobi fields in question to normal Jacobi fields 
    as the proof in the book does, and hence suppose that $J(t)=f(t)e_2(t)$ 
    where $e_2(t)$ is the parallel transport of a unit vector 
    $e_2\in T_{\gamma(0)}M$ with $e_2\perp\gamma'(0)$. 
    Then $\frac{D^2J}{dt^2}=f''e_2$, 
    so the Jacobi equation is equivalent to 
    \[\langle f''e_2+R(\gamma',fe_2)\gamma',\gamma'\rangle=0\,\]
    and
    \[\langle f''e_2+R(\gamma',fe_2)\gamma',e_2\rangle=0,\]
    since $\{\gamma',e_2\}$ spans $T_{\gamma(t)}M$. 
    The first equation trivially holds, 
    and the second is $f''+Kf=0$. Similarly for $\tilde{J}(t)$.

    \item[6.] Suppose that $\tilde{f}(t)\ne0$ for all $t\in[0,t_0]$. 
    Using the expression from the last exercise,
    \[\int_0^{t_0}\underbrace{(K-L)}_{\le0}\underbrace{f\tilde{f}}_{<0}
    +\underbrace{\tilde{f}(t_0)}_{>0}\underbrace{f'(t_0)}_{\ge0}
    -\underbrace{\tilde{f}(0)}_{>0}\underbrace{f'(0)}_{\le0}=0.\]
    This forces $K\equiv L$, as well as $f'(0)=f'(t_0)=0$. 
    Then the initial conditions $f(0)=f'(0)=0$ 
    imply that $f\equiv0$, contradicting that $J\ne0$ on $(0,t_0)$.

    \item[7.] A correction: it should be
    \[\bigg|\int_t^\infty K(s)ds\bigg|\le\frac{1}{4(t+1)}.\]

    a) \[\omega^2\le\bigg(\frac{1}{4(t+1)}+\frac{1}{4(t+1)}\bigg)^2
    =\bigg(-\frac{1}{4(t+1)}\bigg)'=-\omega'-K.\]
    b) $\tilde{f}'=\omega\tilde{f}$, and $\tilde{f}''
    =\omega'\tilde{f}+\omega\tilde{f}'=(\omega'+\omega^2)\tilde{f}=-L\tilde{f}$. 
    $\tilde{f}(0)=\exp0=1$.

    c) $-L=\omega'+\omega^2\le-K$, which is $K\le L$. 
    Then the oscillation theorem of Sturm yields that 
    $\tilde{f}$ has a zero on $[0,s_0]$. But $\tilde{f}>0$.
\end{itemize}

== The Morse Index Theorem ==

\begin{itemize}
    \item[2.] Expand $f$ and $f'$ into the Fourier series
    \[f(t)=\sum_{n=1}^\infty a_n\sin nt,\quad 
    f'(t)=\sum_{n=1}^\infty na_n\cos nt.\]
    Then the inequality follows from
    \[\int_0^\pi f^2=\frac{\pi}{2}\sum_{n=1}^\infty a_n^2,\quad 
    \int_0^\pi f'^2=\frac{\pi}{2}\sum_{n=1}^\infty n^2a_n^2.\] 
    Yet we need to justify that differentiating $f$ by terms 
    does produce $f'$, which relies on the decay of the coefficients $a_n$. 
    Indeed, integrating by parts, we find
    \[\frac{\pi}{2}a_n=\int_0^\pi f\sin nt=\int_0^\pi f'\frac{\cos nt}{n}
    =-\int_0^\pi f''\frac{\sin nt}{n^2}.\]
    Then
    \begin{align*}&\bigg(\sum_{n=1}^\infty na_n\bigg)^2
    \le\sum_{n=1}^\infty(n^2a_n)^2\sum_{n=1}^\infty\frac{1}{n^2}\\
    &=\Big(\frac{\pi}{2}\Big)^{-2}\sum_{n=1}^\infty\bigg(\int_0^\pi f''\sin nt\bigg)^2\frac{\pi^2}{6}
    =\frac{2}{3}\int_0^\pi f''^2<\infty,\end{align*}
    yielding the uniform convergence of the series of $f'$, 
    and consequently the justification.

    \item[3.] It follows that $K(t)\equiv0$ for $t\in(0,\pi)$. 
    Let $t\to0$, we get $K(p)=1$. Then use Theorem 4.1 of Chapter 8 (p.163).

    \item[4.] $\varphi'(0)=0,\varphi''(0)=-a(0)<0$ implies that 
    $\varphi'(t_0)<0$ for some $t_0>0$. Suppose that $\varphi$ 
    has no positive zero, then $\varphi''=-a\varphi\le0$ on $(0,+\infty)$. 
    Hence $\varphi'(t)\le\varphi'(t_0)$ for $t>t_0$. 
    But then $\varphi(t)\le\varphi(t_0)+(t-t_0)\varphi'(t_0)\to-\infty$ 
    as $t\to+\infty$, a contradiction.

    \item[5.] Since $\varphi(-t_1)=\varphi(t_2)=0$, 
    and $\varphi_Y\ge K\ge a$ with strict inequality at $0$,
    \begin{align*}
        I_{[-t_1,t_2]}(X,X)&=\int_{-t_1}^{t_2}\varphi'^2-\varphi^2\varphi_Y\\
        =(\varphi\varphi')\big|_{-t_1}^{t_2}
        &-\int_{-t_1}^{t_2}\varphi\varphi''+\varphi^2\varphi_Y
        <-\int_{-t_1}^{t_2}\varphi\varphi''+\varphi^2a=0.
    \end{align*}

    \item[6.] From Exercise 5, there exists $t_0>0$ 
    and a vector field $Y$ along the segment $\gamma([-t_0,t_0])$ 
    such that $I(Y,Y)<0$. Let $f$ be a proper variation that generates $Y$, 
    then $\frac{1}{2}E''(0)=I(Y,Y)<0$, which is, 
    $\gamma([-t_0,t_0])$ does not minimize the length between its endpoints.

    If $K\ge0$ instead, $M=\R\times S^{n-1}$ violates the theorem.

    Remark: Cf. \cite{YS} 1.2 (pp.13--7) for the proof of 
    the splitting theorem (Cheeger--Gromoll, 1971) below.

    Let $M$ be an $n$-dimensional complete Riemannian manifold 
    with $\operatorname{Ric}(M)\ge0$. Suppose that $M$ has a line. 
    Then $M$ is isometric to $\R\times N$, where $N$ is 
    an $(n-1)$-dimensional Riemannian manifold with the product metric.
    \end{itemize}

