\begin{enumerate}
    \item (10分, 5+5) $K_1, K_2$是单纯复形 $K$的子复形。
    \begin{itemize}
        \item [(1)] 证明： $K_1\cap K_2, K_1\cup K_2$仍然是单纯复形。
        \item [(2)] 证明： $\chi(K_1\cup K_2)+\chi(K_1\cap K_2)=\chi(K_1)+\chi(K_2)$，这里 $\chi(\cdot)$是Euler数。
    \end{itemize}

    \item (20分, 10+10) 
    \begin{itemize}
        \item [(1)] 证明： $\mathbb{R}P^n$每个维数 $p$ 有一个 $p$维胞腔，并且$\mathbb{R}P^n$的$p$维骨架是 $\mathbb{R}P^p$。
        \item [(2)] $f:\mathbb{R}P^n\to\mathbb{R}P^n$是连续映射，$f$有不动点吗？证明你的结论。
    \end{itemize}

    \item (12分, 6+6) $f:S^n\to S^n$是连续映射。
    \begin{itemize}
        \item [(1)] 写出映射度 $\deg f$的定义。
        \item [(2)] $g:S^n\to S^n$是连续映射，且 $f(x)\neq g(x), \forall x\in S^n$，
        给出$\deg f,\deg g$之间满足的方程，证明你的结论。
    \end{itemize}

    \item (12分, 6+6) $T:\Delta_p\to X$是奇异单形。
    \begin{itemize}
        \item [(1)] 给出 $\partial$的定义。
        \item [(2)] 证明 $\partial^2=0$。
    \end{itemize}

    \item (10分) 设$q,r>p$, $X^p$是CW复形$X$的$p$维骨架，证明： $H_p(X^q)\cong H_p(X^r)$。

    下面开始本科生做第1题，研究生 2选1
    \item (6-1, 12分) 设 $0\to\mathcal{C}\to{\mathcal D}\to\mathcal{E}\to0$是自由链复形，
    $\varphi:\mathcal{C}\to\mathcal{D}$，证明:若 $\varphi_*$ 是同构，则 $\varphi^*$ 亦是同构.
    \item (6-2, 12分) 设 $h \in C(|K|,|L|)$，其中 $K$ 是一个有限单纯复形。
求证：存在正整数 $m$ 以及一个单纯映射 $\phi: \operatorname{sd}^{m}\!K \longrightarrow L$，
使得对 $\operatorname{sd}^{m}\!K$ 的任意顶点 $v$ 满足
$$
h(\operatorname{Star}(v, \operatorname{sd}^{m}\!K)) \subset \operatorname{Star}(\phi(v), L) .
$$
此时，称 $\phi$ 为 $h$ 的从 $\operatorname{sd}^{m}\!K$ 到 $L$ 的一个单纯逼近。

    \item (7-1, 12分, 6+6) 
    \begin{itemize}
        \item [(1)] 给出环面$T^2,X=S^1\vee S^1\vee  S^2$的上同调环结构。
        \item [(2)] 设 $f: X \longrightarrow T^{2}$ 是 $X$到 $2$ 维环面的一个连续映射。
        证明： $f^{*}: H^{2}(T^{2}) \longrightarrow H^{2}(X)$ 是平凡同态。
    \end{itemize}
    
    \item (7-2, 12分, 4+4+4)
    \begin{itemize}
        \item [(1)] 构造只有$0,1,2$维胞腔各$1$个的胞腔复形$X$，使得$H_1(X)=\Z/n\Z$。
        \item [(2)] $X$是$2$维流形吗，请证明。
        \item [(3)] 证明 $f:X\to T^2$诱导的 $f_*:H_p(X)\to H_p(T^2)$在 $p=1,2$是平凡的。
    \end{itemize}

    \item (8-1, 12分) $H^p(X)$是 $X$的$\Z$系数上同调群，证明： $H_p(X)$自由部分的秩$=H^p(X)$自由部分的秩。
    \item (8-2, 12分) 假设有限单纯复形上的某自同态的不动点都是孤立的，证明：该自同态的不动点数量是它的Lefschetz数。
\end{enumerate}


