        \item[(2)]证明上述的杯积诱导上同调群之间的杯积.
        \item[(3)]证明任何从$S^1\vee S^1\vee S^1\vee S^2$到$T^2$
        的映射诱导的$2$维上同调群的映射是零映射.
    \end{itemize}
\end{enumerate}


