\setdisplaytitle{代数拓扑(H)试卷}
\sethtmltitle{代数拓扑(H)试卷}

== 2025--2026学年期末（研, 12.26）==

注.考试时间2小时15分钟.

\begin{enumerate}
    \item[一.] (20分)
    \begin{itemize}
        \item[1.] (10分)设$m,n$都是正整数,请构造一个道路连通的3维CW复形$X$,使得
        $H_1(X)=\mathbb{Z}/m,H_2(X)=\underbrace{\mathbb{Z}\oplus\cdots\oplus\mathbb{Z}}_{n},H_3(X)=\mathbb{Z}$.
        \item[2.] 对上述构造的$X$,求解上同调群$H^p(X;\mathbb{Z})$及$H^p(X;\mathbb{Z}/6)$.
    \end{itemize}
    \item[二.] (26分)
    \begin{itemize}
        \item[1.] (8分)证明$\mathbb{R} P^n$是可三角剖分的CW复形.
        \item[2.] (10分)设$h:|K|\to|K|$是连续映射, $K$是有限复形.设$n>0$是偶数.\\
        (a) (5分)若$|K|=\mathbb{R} P^n$,证明$h$必有不动点.\\
        (b) (5分)若$|K|=S^n$,证明$h\circ h$必有不动点.
        \item[3.] (8分)证明Lefschetz数也可以用对应的上同调表达.即,记上同调群$H^p(K)$的挠子群为$T^p(K)$,则\[\begin{aligned}
        \Lambda(h)&=\sum_p(-1)^p\operatorname{Trace}(h_*:H_p(K)/T_p(K)\to H_p(K)/T_p(K))\\
        &=\sum_p(-1)^p\operatorname{Trace}(h^*:H^p(K)/T^p(K)\to H^p(K)/T^p(K)).
        \end{aligned}\]
    \end{itemize}
    \item[三.] (16分)设$h\in C(|K|,|L|)$, $K$是有限复形.
    \begin{itemize}
        \item[1.] (8分)举例说明,可以不存在任何单纯映射$\phi:K\to L$逼近$h$.
        \item[2.] (8分)证明:存在正整数$m$,使得存在$h$的单纯逼近$\phi:\operatorname{sd}^mK\to L$.
    \end{itemize}
    \item[四.] (20分)
    \begin{itemize}
        \item[1.] (10分)设$K$是单纯复形.\\
        (a) (5分)证明$|K|$是CW复形.\\
        (b) (5分)假设已知$H_*(\mathcal{C}(K))\cong H_*(\mathcal{S}(|K|))$,
        证明$H_*(\mathcal{C}(K))\cong H_*(\mathcal{D}(|K|))$.
        \item[2.] (10分)设$X$是拓扑空间,有一族滤子$X_0\subset X_1\subset\cdots\subset X_p\subset\cdots$,
        满足$X=\bigcup_pX_p$.又设$i\neq p$时$H_i(X_p,X_{p-1})=0$.\\
        (c) (5分)对正整数$q,r>p$,证明$H_p(X_q)\cong H_p(X_r,X_{p-2})$.（注：这里需要$X_0$是零调的，否则取非零调的$X_i = X, \forall i$是一个反例）\\
        (d) (5分)若存在$i\neq p$满足$H_i(X_p,X_{p-1})\neq0$,上面同构是否仍然成立?此时对于$H_p(X)$的计算,说说你的想法.
    \end{itemize}
    \item[五.] (18分)
    \begin{itemize}
        \item[1.] (8分)对链复形$\mathcal{C}$,考虑上下同调群的Kronecker积\[\begin{aligned}
        H^p(\mathcal{C};G)\times H_p(\mathcal{C})&\longrightarrow G,\\
        (\alpha^p,\beta_p)&\longmapsto\langle\alpha^p,\beta_p\rangle,
        \end{aligned}\]其中$G$是Abel群.给出$\langle\alpha^p,\beta_p\rangle$的定义,
        并证明上下同调群的Kronecker积是良定义的.
        \item[2.] (8分)对自由链复形$\mathcal{C}$,上下同调群的Kronecker积提供给我们一个同态\[\begin{aligned}
        \kappa:H^q(\mathcal{C};G)&\longrightarrow\operatorname{Hom}(H_q(\mathcal{C}),G),\\
        \alpha&\longmapsto\langle\alpha,\cdot\rangle.
        \end{aligned}\]证明存在同态$\lambda:\operatorname{Hom}(H_q(\mathcal{C}),G)\longrightarrow H^q(\mathcal{C};G)$,
        使得$\kappa\circ\lambda=\operatorname{id}_{\operatorname{Hom}(H_q(\mathcal{C}),G)}$.
        \item[3.] (2分)举例说明$\kappa$不总是同构.
    \end{itemize}
\end{enumerate}


== 2025--2026学年期末 ==

\begin{enumerate}
    \item \begin{itemize}
        \item [(1)] 给出一个道路连通的$4$维CW复形$X$，使得$H_1(X) = \mathbb{Z}/6\mathbb{Z}$，$H_2(X) \cong H_3(X) = \mathbb{Z}^4$，$H_4(X) = \mathbb{Z}$; 
        \item [(2)] 对上题的$X$，计算上同调群$H^p(X; \mathbb{Z})$与$H^p(X; \mathbb{Z}/3\mathbb{Z})$。
    \end{itemize}

    \item \begin{itemize}
        \item [(1)] 设 $K$ 是有限单纯复形，且 $h \in C(|K|,|K|)$。请写出 $h$ 的Lefschetz数 $\Lambda(h)$ 的定义;
        \item [(2)] 设 $f \in C(S^{n}, S^{n})$，
且 $\overline{f}$ 是被 $f$ 经由 $p: S^{n} \longrightarrow \mathbb{R} P^{n}(=S^{n} / x \sim-x)$ 所诱导的 $\mathbb{R} P^{n}$ 到自身的连续映射，即下图可换：
\begin{cd}
S^{n} \ar[r,"f"] \ar[d,"p"'] & S^{n} \ar[d,"p"']\\
\mathbb{R}P^{n} \ar[r,"\overline{f}"] & \mathbb{R}P^{n}.
\end{cd}
求证:

(i) 若 $n$ 为偶数，则 $\overline{f}$ 必有不动点;

(ii) 若 $n$ 为奇数，且 $\text{deg} f \neq (-1)^{n+1}$, 则 $\overline{f}$ 必有不动点; 而若 $\text{deg} f = (-1)^{n+1}$, $\overline{f}$是否有不动点? 请给出理由。
    \end{itemize}

    \item \begin{itemize}
        \item [(1)] 设$K, L$是单纯复形，$h: |K| \rightarrow |L|$是连续映射，$\phi, \psi$均为$h$的单纯逼近。证明$\phi_{\#} \simeq \psi_{\#}$；
        \item [(2)] 设$f \simeq g: |K| \rightarrow |L|$是连续映射，且$K$为有限单纯复形。证明$f_* = g_*$。
    \end{itemize}

    \item 设$X$是CW复形，记$X^p$为$X$的$p$维骨架。\begin{itemize}
        \item [(1)] 对正整数$l > q > r \geqslant 0$，证明我们有如下长正合列：
        \begin{center}
            \begin{tikzcd}
\cdots \arrow[r] & {H_p(X^q, X^r)} \arrow[r] & {H_p(X^l, X^r)} \arrow[r] & {H_p(X^l, X^q)} \arrow[r] & {H_{p-1}(X^q, X^r)} \arrow[r] & \cdots
\end{tikzcd}
        \end{center}
        \item [(2)] 设$l, q >p$为正整数，证明$H_p(X^l, X^{p-2}) \cong H_p(X^q, X^{p-2})$。
    \end{itemize}

    \item \begin{itemize}
        \item [(1)] 设$X$为单点拓扑空间，证明$\widetilde{H}_p(X) = 0$且对任意交换群$G$, $\widetilde{H}^p(X; G) = 0$，
        \item [(2)] 设$f: X \rightarrow Y$为拓扑空间之间的连续映射，证明：
        \begin{center}
            $\langle f^*(\alpha), \beta \rangle = \langle \alpha, f_*(\beta) \rangle$，
        \end{center}
        其中$\alpha \in H^p(Y; G), \beta \in H_p(X)$。
    \end{itemize}

    \item  设$K$为有限单纯复形, 证明:
    \begin{center}
        $\chi(K) = \sum_p (-1)^pf_p(K)$,
    \end{center}
    其中$\chi(K)$为$K$的Euler数, $f_p(K)$为$K$的$p$阶整系数上同调群自由部分的秩.
\end{enumerate}

