一(30分）、填空题(每题6分)
\begin{enumerate}[label=(\arabic*)]
\item 设$x_{n+1}=x_n-x_n^4\ (n\ge0)$。若实数$a$和正数$b$使得$\lim\limits_{n\to+\infty}n^\alpha x_n=b$，则$b=\underline{\qquad\quad}$.\\
\item 设$f(x)=\begin{cases}ae^x+b\sin 2x,&x<0\\cx^2+\ln(1+x)+x,&x\ge0\end{cases}$是$\R$上二阶连续可导函数，则$a=\underline{\qquad\quad}$，$b=\underline{\qquad\quad}$，$c=\underline{\qquad\quad}$.\\
\item 设$\R$上的二阶可导函数$f(x)$满足$x+\pi e^{xf(x)}+f(x)-\sin f(x)=0$。则$f''(0)=\underline{\qquad\quad}$.\\
\item 使得级数$\displaystyle \sum\limits_{n=1}^{\infty} n^\alpha\Big[\Big(1+\frac{1}{n}\Big)^n-1\Big]$收敛的实数$\alpha$满足的充要条件是：$\underline{\qquad\quad}$.\\
\item 设$f(x)=x^{2019}e^{2020x}\sin x$，则$f^{(2021)}(0)=\underline{\qquad\quad}$.\\
\end{enumerate}
~\\
二(10分)、试构造$\R$上的实函数$f$使得它仅在$0,1$两点连续，且$f'(0)=1$，$f'(1)=0$。

~\\
三(20分)、设$f$为$\R$上可导的实函数，恒成立$|f'(x)|\le1$，且$\{x\in\R\,\big|\,f'(x)=1\}$无内点。
记$f_n(x)$为$\overbrace{f\circ f\circ \cdots\circ f}^{n\text{ 次}}(x)$，$\{f_n(0)\}$收敛于$\xi$。
\begin{enumerate}[label=(\arabic*)]
\item 证明：对任意$x<y$，$|f(x)-f(y)|<|x-y|$。
\item 对于确定的$x\in\R$，若$\{f_n(x)\}$的子列$\{f_{n_k}(x)\}$收敛，证明：$\{f_{(n_{k}+1)}(x)\}$收敛。
\item 证明：对任何$x\in\R$，$\{f_n(x)\}$收敛于$\xi$。
\end{enumerate}

~\\
四(20分)、\\
（1）对于给定的$\alpha>0$，构造数列$\{a_n\},\{b_n\}$满足$\displaystyle a_n\le\sum_{k=n}^\infty\frac{1}{k^{1+\alpha}}\le b_n$，且$\displaystyle \lim_{n\to\infty}\frac{b_n}{a_n}=1$.\\
（2）证明：$\displaystyle \lim_{\alpha\to0^+}\sum_{n=1}^\infty\frac{\alpha}{n^\alpha}\ln\Big(1+\frac{1}{n}\Big)=\lim_{\alpha\to0^+}\sum_{n=1}^\infty\frac{\alpha}{n^{\alpha+1}}$.\\
（3）计算：$\displaystyle \lim_{\alpha\to0^+}\sum_{n=1}^\infty\frac{\alpha}{n^\alpha}\ln\Big(1+\frac{2}{n}+\frac{3}{n^2}\Big)$.

~\\
