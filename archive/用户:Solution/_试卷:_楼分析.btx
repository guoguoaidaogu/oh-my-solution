\setdisplaytitle{试卷：楼分析}
\sethtmltitle{试卷：楼分析}
\newcommand{\x}{\mathbf{x}}\newcommand{\y}{\mathbf{y}}
\newcommand{\U}{\mathbf{u}}\newcommand{\F}{\mathscr{F}}

== 2025--2026春期末 ==
\textbf{一、填空题（30分，每题6分）}

\begin{enumerate}[label=(\arabic*)]
    \item $D:=\{(x,y)|0\leq y\leq x^3,\,x\in[1,2]\}$ 绕 $x$ 轴旋转一周形成的旋转体的表面积为 $\underline{\qquad\quad}$.
    \item $\displaystyle\iiint_{x^2+y^2+3z^2\leq1}|3x+4y|\mathrm dx\mathrm dy\mathrm dz=\underline{\qquad\quad}$.
    \item 设 $S_n(x):=n|\ln(4x-4x^2)|^a\sin^n(\pi x)$，函数列 $S_n(\cdot)$ 在 $(0,1)$ 内一致收敛，则 $a\in\mathbb R$ 的取值范围为 $\underline{\qquad\quad}$.
    \item $f$ 为以 $2\pi$ 为周期的函数，且 $\displaystyle f(x)=\frac{x^{\frac25}+x}{\ln(x+\sqrt{1+x^2})}\,(x\in(-\pi,\pi))$，则 $f$ 的 Fourier 级数在 $0$ 点处的部分和的极限为 $\underline{\qquad\quad}$.
    \item 记 $\displaystyle\mathscr F(f)(x)=\int_{\mathbb R}f(t)e^{-2\pi itx}\mathrm dt, \mathscr F^n=\overbrace{\mathscr F\circ\mathscr F\circ\cdots\circ\mathscr F}^{n个}$，则对 $g(x):=x^2e^{-x^2}\,(x\in\mathbb R)$，$\displaystyle\int_{\mathbb R}\sum_{n=0}^{+\infty}\frac{\mathscr F^n(g)(x)}{n!}\mathrm dx=\underline{\quad\qquad}$.
\end{enumerate}

\\

\textbf{二、（16分）}
计算 $\displaystyle\lim_{n\to+\infty}\int_0^{+\infty}\frac{n^2\sin(nx^2)+n\sin^2(n^2x)}{(1+nx^2)^n}\mathrm dx$ 并说明理由.

\\

\textbf{三、（18分）}
$f$ 为 $n$ 维单位球内的可积函数，证明：
$$\displaystyle\int_{B_1(\mathbf 0)}\mathrm d\mathbf x\int_0^1f(s\mathbf x)s^{n+1}\mathrm ds=\int_{B_1(\mathbf 0)}\frac{1-|\mathbf x|^2}2f(\mathbf x)\mathrm d\mathbf x$$

\\

\textbf{四、（18分）}
设 $\displaystyle F(x):=\int_{\mathbb R}\frac{e^{-2\pi xy}}{\mathrm{ch}(\pi y)}\mathrm dy$.
\begin{enumerate}
    \item 考察 $F$ 在 $\mathbb R$ 上的自然定义域并求其值.
    \item 对于 $\displaystyle f(x)=\frac1{\mathrm{ch}(\pi x)}\,(x\in\mathbb R)$，证明：$f$ 的 Fourier 变换等于自身.
\end{enumerate}

\\

\textbf{五、（18分）}
$n\geq2$，$A,C$ 是 $n$ 阶实方阵，$C$ 正定，$A$ 可逆，$A,\,A^T,\,C$ 两两可交换. 考察矩阵方程：
$$(\mathrm R):\left\{\begin{array}{l}
    Y'(t)+AY(t)+Y(t)A^T+Y(t)CY(t)=0\\
    Y(0)=I
\end{array}\right.$$
其中 $I$ 为单位阵. 证明：
\begin{enumerate}
    \item $e^{A+A^T},\,Ce^{A+A^T}$ 均正定.
    \item $(\mathrm R)$ 的解 $Y(\cdot)$ 局部存在且在存在区间内唯一.
    \item $Y(\cdot)$ 对称且与 $A,\,A^T,\,C$ 均可交换.
    \item $Y(\cdot)$ 正定，且对于任意的 $t\geq0$，有 $e^{-t(A+A^T)}-Y(t)$ 半正定.
    \item 设 $(\mathrm R)$ 的解的最大存在区间为 $(\alpha,\beta)$，则 $\beta=+\infty$.
\end{enumerate}

== 2025--2026春期中 ==
\textbf{一、填空题（30分，每题6分）}

\begin{enumerate}[label=(\arabic*)]
    \item 计算 $\displaystyle\lim_{n\to+\infty}n\int_0^1\frac{x\sin^2n^2x+\arctan x}{x(1+x)^n}\mathrm{d}x=\underline{\qquad\quad}$.
    \item $Oxy$ 平面中的 $y=\sin x\;(x\in[0,\pi])$ 图像与 $x$ 轴围成的区域$D$ 绕 $y$ 轴旋转一周形成的旋转体的体积为 $\underline{\qquad\quad}$.
    \item 设实解析函数 $f$ 满足常微分方程 $(1-x^2)f'''(x)-3xf''(x)-f'(x)=0$ 以及初值条件 $f(0)=f''(0)=0,\;f'(0)=1$，则 $f$ 的MacLaurin 级数为（尽可能简洁）$\underline{\qquad\quad}$.
    \item 设 $a$ 为实常数. 若函数项级数 $\displaystyle\sum_{n=2}^{\infty}\frac{\sin nx}{n^{a}+\cos nx}$ 关于 $x\in(0,2\pi)$ 内闭一致收敛，则 $a$ 的取值范围为 $\underline{\quad\qquad}$.
    \item 计算 $\displaystyle\lim_{n\to+\infty}\prod_{k=1}^n\left(\cos\left(\frac1n\sin\frac{k\pi}n\right)+\sin\left(\frac1n\sin\frac{k\pi}n\right)\right)=\underline{\quad\qquad}$.
\end{enumerate}

\\

\textbf{二、（16分）}
设 $f\in L_{loc}^1(\mathbb R)$，对于任何 $\varphi\in C_c^{\infty}(\mathbb R)$，有 $\displaystyle\int_{\mathbb R} f(x)\varphi'(x)\mathrm dx=0$，依次证明（若直接证明 $4$，则不必证明 $1\sim3$）
\begin{enumerate}
    \item 对于任何 $\varphi\in C_c^1(\mathbb R)$，有 $\displaystyle\int_{\mathbb R} f(x)\varphi'(x)\mathrm dx=0$.
    \item 若 $\psi\in C[a,b]$，且 $\displaystyle\int_a^b\psi(x)\mathrm dx=0$，则 $\displaystyle\int_a^b f(x)\psi(x)\mathrm dx=0$.
    \item 记 $\displaystyle\bar f_{a,b}=\frac1{b-a}\int_a^bf(x)\mathrm dx$，则对于任何 $\psi\in C[a,b]$，有 $\displaystyle\int_a^b (f(x)-\bar f_{a,b})\psi(x)\mathrm dx=0$.
    \item $f$ 几乎处处恒等于常数.
\end{enumerate}

\\

\textbf{三、（18分）}
给定 $a,b,c>0$，$\Omega$ 为闭区域 $\displaystyle\frac{x^2}{a^2}+\frac{y^2}{b^2}+\frac{z^2}{c^2}\leq1$，$f,g\in C^2(\bar\Omega)$ 且 $f,g$ 在 $\partial\Omega$ 上为零.
\begin{enumerate}
    \item 若 $\displaystyle f(x,-y,z)=\frac{x^2}{a^2}+\frac{y^2}{b^2}+\frac{z^2}{c^2}-1-f(x,y,z)$，计算 $\displaystyle\iiint_\Omega x\frac{\partial f(x,y,z)}{\partial x}\mathrm dx\mathrm dy\mathrm dz$.
    \item 证明：$\displaystyle\iiint_\Omega\left(g(x,y,z)\Delta f(x,y,z)-f(x,y,z)\Delta g(x,y,z)\right)\mathrm dx\mathrm dy\mathrm dz=0$，其中 $\displaystyle\Delta F:=\frac{\partial^2 F}{\partial x^2}+\frac{\partial^2 F}{\partial y^2}+\frac{\partial^2 F}{\partial z^2}$.
\end{enumerate}

\\

\textbf{四、（18分）}
已知 $\displaystyle\sum_{n=1}^\infty A_n\cos(nx+\theta_n)$ 在 $[a,b]$ 上绝对收敛.
\begin{enumerate}
    \item 设 $\displaystyle f(x):=\sum_{n=1}^\infty\left|A_n\cos(nx+\theta_n)\right|$，证明存在测度大于 $0$ 的集合 $F\in[a,b]$，使得 $f$ 在 $F$ 上有界.
    \item 证明：存在 $N\geq1$，使得 $\displaystyle|F|\sum_{n=N}^\infty|A_n|\leq3\int_F f(x)\mathrm dx$，从而 $\displaystyle\sum_{n=1}^\infty|A_n|$ 收敛.
\end{enumerate}

\\

\textbf{五、（18分）}
$f\in C^\infty(\mathbb R)$，$\{f^{(n)}\}$ 在 $\mathbb R$ 上逐点收敛于 $\varphi$. 证明：
\begin{enumerate}
    \item 若 $\{f^{(n)}\}$ 在 $(a,b)$ 上一致收敛，则在 $(a,b)$ 上有 $\varphi'=\varphi$.
    \item 对于 $\mathbb R$ 的任何非空闭子集 $E$，存在 $x_0\in E,\;\delta>0$，使得 $\{f^{(n)}\}$ 在 $E\cap(x_0-\delta,x_0+\delta)$ 上一致有界.
    \item 任何 $\mathbb R$ 中的开区间都存在一个子区间，使得 $\{f^{(n)}\}$ 在这个子区间上一致收敛.
    \item 存在常数 $C$ 使得 $\varphi(x)=Ce^x\;(\forall x\in\mathbb R)$.
\end{enumerate}
提示忘记抄下来了（划掉）

== 2025--2026秋期末 ==
\textbf{一、填空题（每题6分）}

\begin{enumerate}
    \item 已知函数 $f(x)$ 在 $0$ 附近二阶可导，$\displaystyle\lim_{x\to0}\frac{f(x)-\left(\frac{1+\tan x}{1+\arctan x}\right)^{1/\sin^2x}}{x^2}=1$，则 $\left(f(0),f'(0),f''(0)\right)=(\underline{\qquad},\underline{\qquad},\underline{\qquad})$.
    \item $\displaystyle\int x\mathrm e^{2x}\sin^2x\,\mathrm dx=\underline{\qquad}\underline{\qquad}\underline{\qquad}$.
    \item 函数 $f(x,y):=x^4+2x^3y+3x^2y^2+2xy^3+y^4$ 在 $x^4+y^4=1$ 的约束条件下的最小值和最大值分别为 $\underline{\qquad},\underline{\qquad}$.
    \item 记 $F(x;f,g)=(f(x))^{(2g(x))^{(3f(x))^{\cdots^{(2025f(x))}}}},\psi(x)=\sin x,\varphi(x)=\cos x$，则极限 $\lim\limits_{x\to0^+}(F(x;\psi,\psi),F(x;\psi,\varphi),F(x;\varphi,\psi),F(x;\varphi,\varphi))=(\underline{\qquad},\underline{\qquad},\underline{\qquad},\underline{\qquad})$.
    \item 方程 $\begin{cases}
        x+2y+3u+4v=0\\
        4x^2+3y^2+2u^4+v^4=7
    \end{cases}$ 在 $(x,y,u,v)=(1,0,1,-1)$ 附近确定一个隐函数 $\begin{pmatrix}y\\u\end{pmatrix}=\begin{pmatrix}y(x,v)\\u(x,v)\end{pmatrix}$，则 $u_{xx}(1,-1)=\underline{\qquad}$.
\end{enumerate} 
\\
\textbf{二、（16分）}
定义在 $[1,+\infty)$ 上的函数 $f(x),g(x)$ 满足 $f''(x)+f'(x)+f(x)=2x^2-3x,g''(x)+g'(x)+g(x)=x^3\ln\left(1+\frac1{1+x}\right)+2\cos\frac1x$.

\begin{enumerate}[label=(\arabic*)]
    \item 写出 $f$ 的解析式.
    \item 证明以下极限存在并求值：$A:=\lim\limits_{x\to+\infty}g''(x),B:=\lim\limits_{x\to+\infty}\left(g'(x)-Ax\right),C:=\lim\limits_{x\to+\infty}\left(g(x)-\frac A2x^2-Bx\right)$.
\end{enumerate}
\\
\textbf{三、（18分）}
已知 $f\in C^4[0,1]$ 是方程 $f^{(4)}(x)-10f''(x)+9f(x)=2\mathrm e^{x^2}-1$ 满足 $f(0)=f(1)=f''(0)=f''(1)=0$ 的解，证明：对于任意的 $x\in(0,1)$，有 $f(x)>0$.

\\
\textbf{四、（18分）}
已知 $\Omega$ 是 $\mathbb R^n$ 中的区域，$\mathbf F\in C^1(\Omega;\mathbb R^n)$，
求证：对于所有 $\Omega$ 的紧子集 $E$，存在连续模 $\omega\equiv\omega_E$ 
(即 $\omega:[0,+\infty)\to[0,+\infty)$ 单调增加，且满足 $\omega(0^+)=\omega(0)=0$)，使得

$$|\mathbf F(\boldsymbol{v})-\mathbf F(\boldsymbol{u})
-\mathbf F_{\boldsymbol{x}}(\boldsymbol{u})(\boldsymbol{v}-\boldsymbol{u})|
\leq|\boldsymbol{v}-\boldsymbol{u}|\omega(|\boldsymbol{v}-\boldsymbol{u}|),
\quad\forall \boldsymbol{u},\boldsymbol{v}\in E.$$

其中 $\mathbf F_{\boldsymbol{x}}$ 使用课程配套教材中的定义.

\\
\textbf{五、（18分）}
给定整数 $m\geq1$，已知 $g\in C(\mathbb R),f\in C^{m+1}(\mathbb R)$，且满足 $f(x)=xg(x)$.

\begin{enumerate}[label=(\arabic*)]
    \item 证明：存在 $M>0$，使得 $\forall x\neq0$，有 $\displaystyle\left|g^{(m)}(x)\right|\leq M\cdot\max_{0\leq k\leq m}\left|\frac{f^{(k)}(x)}{x^{m-k+1}}\right|$.
    \item 若 $f^{(k)}(0)=0$ $(0\leq k\leq m+1)$，证明：$g\in C^m(\mathbb R)$.
    \item 一般地，证明 $g\in C^m(\mathbb R)$.
    \item 已知 $g^2,g^3\in C^\infty(\mathbb R)$，且对任意实数 $x_0$，总存在非负整数 $k$ 及非零实数 $c$，
    满足 $\displaystyle\lim_{x\to x_0}\frac{g(x)}{(x-x_0)^k}=c$，证明 $g\in C^\infty(\mathbb R)$.
\end{enumerate}

\textbf{注：}本题使用定积分将判零分.

== 2025--2026秋期中 ==
一、填空题(每空 6 分)
\begin{enumerate}
    \item[(1)]  已知正项数列 $a_n$ 满足 $a_n=\displaystyle\frac{a_{n+1}}{\sqrt[4]{1-a_{n+1}}}$，$A \equiv \displaystyle\lim _{n \to \infty} n a_n = \underline{\qquad}$，
                $\displaystyle\lim_{n \to \infty} \frac{n}{\ln n} (n a_n - A) = \underline{\qquad}$.
    \item[(2)] 
    $f(x)= \begin{cases}e^{\frac{A}{x}+B} & x>0 \\ \alpha x^{2}+\beta x+\gamma & x \leq0\end{cases}$
    在$\mathbb{R}$上连续、可导、连续可导的充要条件分别是$\underline{\qquad},\underline{\qquad},\underline{\qquad}$.
    \item[(3)] $x, y \in [0,+\infty)$满足关系$e^{y}-1-y=x-\ln (x+1)$，求$y(0)=\underline{\qquad},y'_+(0)=\underline{\qquad}$.
    \item[(4)] 级数$\displaystyle\sum_{n=2}^{\infty} \frac{(-1)^{n}}{n^{\alpha}+(-1)^{n}}$收敛、绝对收敛的充要条件分别是$\underline{\qquad},\underline{\qquad}$.
    \item[(5)] $f(x) = x^{2023} \ln(1 + \sin x)$，求$f^{(2025)}(0) = \underline{\qquad\qquad}$.
\end{enumerate}
~\\
二(15分)、我们称函数$f(x)$在$[a, b]$上局部满足Hölder 条件，
如果$\forall x \in[a, b]$，$\exists \delta_{x}>0$，$M_{x}>0$，$\alpha_{x} \in(0,1)$
使得$\forall s, t \in[x-\delta_{x}, x+\delta_{x}]\cap[a,b]$，$|f(s)-f(t)| \leq M_{x}|s-t|^{\alpha_{x}}$，
由此条件证明：$f(x)$在$[a, b]$上满足Hölder 条件.

~\\
三(20分)、$x_{0}$，$x_{1}>0$，数列$\{x_{n}\}$满足$x_{n+2}=\displaystyle\frac{2}{x_{n}}+\displaystyle\frac{4}{x_{n}+x_{n+1}}$ $(n \geq0)$，证明$\{x_{n}\}$收敛并求出该极限.

~\\
四(20分)、$a>0$，$a^{2}+4 b<0$，$f(x):\mathbb{R}\to\mathbb{R}$具有介值性，且$f(f(x))=a f(x)+b x$，证明：
\begin{enumerate}
    \item [(1)] $f(x)$为单射且严格单增；
    \item [(2)] $f(x)$为满射且连续；
    \item [(3)] $\displaystyle\lim _{x \to \infty} \frac{f(x)}{x}$存在；
    \item [(4)] 满足上述条件的$f(x)$不存在。
\end{enumerate}
~\\
五(20分)、记$B_{\delta}(x) = \{ y \in \mathbb{R}^n \mid |x - y| < \delta,\ \delta \in \mathbb{R} \}$，
$\mathcal{T} \coloneqq \{ B_{\delta}(x) \mid x \in \mathbb{Q}^n,\ \delta \in \mathbb{Q} \}$.
设 $E$ 是 $\mathbb R^n$ 的一个不可列子集，称 $x_0$ 为 $E$ 的凝聚点，
若 $\forall\delta>0,B_\delta(x_0)\cap E$ 均为不可列集合. $E$ 的凝聚点全体记为 $E^\Delta$. 证明：
\begin{enumerate}
    \item [(1)] $\mathcal{T}$为可列集；
    \item [(2)]$V \subseteq \mathbb{R}^{n}$为开集，则$V=\bigcup\{A \in \mathcal{T} \mid A \subseteq V\}$；
    \item [(3)] $E \setminus E^{\Delta}$为至多可列集；
    \item [(4)] 存在$F \subseteq E$，使得 $F$ 不可列且没有孤立点.
\end{enumerate}

== 2024--2025春期末 ==
一(30分)、填空题(每题 6 分)
\begin{enumerate}[label=(\arabic*)]
    \item 曲线 $x^6 + y^{\frac 6 5} = 1$围成的面积为$\underline{\qquad\quad}$.
    \item $\displaystyle \iiint_{x^4+y^4+z^4\le1} \sqrt{|x^4 - y^4|} \, dx dy dz=\underline{\qquad\quad}$.
    \item 设$f(x)=\displaystyle\int_0^1 e^{-s^3x^3}\sin(s^3x^3) \, ds$, 
    则$f$的Maclaurin级数中$x^{2025}$的系数为$\underline{\qquad\quad}$.
    \item 设$f(x):=\displaystyle\sum_{n=0}^{+\infty}\sum_{k=0}^n \dfrac{(-1)^kx^{n+k}}{(n-k)!(2k+1)!}$, 
    则$\displaystyle\int_0^{\pi} xf(x) \,dx=\underline{\qquad\quad}$.
    \item 极限$\displaystyle\lim_{n\to +\infty}\int_0^n \frac{|\cos x^2|}{x}\ln \Big(1-\frac{x^4}{n^4}\Big)\, dx=\underline{\qquad\quad}$.
\end{enumerate}
~\\
二(14分)、设$f$以$2\pi$为周期，$\displaystyle f\big|_{(-\pi,\pi)}(x)=
\operatorname{sgn}(x)\ln \Big(1-\cos \dfrac{x}{2-\operatorname{sgn}(x)}\Big)$. 
证明：$f$的Fourier级数在$x=0$处收敛并求其和.
~\\

三(18分)、设$f\in C(\mathbb{R})$以$2\pi$为周期，
$\{a_n\}, \{b_n\}$为$f$的Fourier系数.
\begin{enumerate}[label=(\arabic*)]
\item 进一步，若$f$连续可微，证明：$\lim \limits_{n\to +\infty}na_n
=\lim \limits_{n\to +\infty}nb_n=0$.
\item 若$f$是两个单调函数之和，证明它也是两个连续的单调函数之和.
\item 设$g$在$\mathbb{R}$上连续、单增，证明：$\forall \, \varepsilon > 0$, 存在$h\in C^1[0,2\pi]$
使得$g-h$在$[0,2\pi]$上单增，且$\max \limits_{x\in [0,2\pi]}|g(x)-h(x)|<\varepsilon$.
\item 若$f$是两个单调函数之和，证明：$\lim \limits_{n\to +\infty}na_n
=\lim \limits_{n\to +\infty}nb_n=0$.
\end{enumerate}
~\\
四(18分)、设$n\ge 3$, $\displaystyle F(\mathbf{x}):=\int_{\mathbb{R}^n}f(\mathbf{x}-\mathbf{y})\psi(\mathbf{y})\, d\mathbf{y}$, 
其中$f$是$\mathbb{R}^n$中的速降函数, $\psi(\mathbf{x})=|\mathbf{x}|^{2-n}$. 证明：
\begin{enumerate}[label=(\arabic*)]
    \item $\Delta \psi (\mathbf{x})=0$ $(\mathbf{x}\ne 0)$.
    \item $\forall \, \mathbf{x}\in \mathbb{R}^n$, 有$\displaystyle
    \Delta F(\mathbf{x})=\int_{\mathbb{R}^n}\nabla f(\mathbf{x}-\mathbf{y})\cdot \nabla
    \psi (\mathbf{y}) \, d\mathbf{y}$.
    \item $\forall \, \mathbf{x}\in \mathbb{R}^n$，有$\displaystyle \Delta F(\mathbf{x})=
    n(n-2)\omega_n f(\mathbf{x})$, 其中$\omega_n$为$n$维单位球体积.
\end{enumerate}
~\\
五(20分)、设$\mathbb{R}^2$上的连续函数$f$是$\{(x,y)\,\big|\,y\ne 0 \}$内的调和函数. 
请给出以下问题的反例或证明.
\begin{enumerate}[label=(\arabic*)]
    \item 对于$x\in \mathbb{R}$及$r>0$, 是否必有$f(x,0)=\displaystyle \dfrac{1}{\pi r^2}\iint _{(t-x)^2+s^2\le r^2}f(t,s)\, dtds$?
    \item $f$是否为整个$\mathbb{R}^2$上的调和函数？
    \item 若$f\in C^1(\mathbb{R}^2)$, 则$f$是否为整个$\mathbb{R}^2$上的调和函数？
    \item 若$f\in C^2(\mathbb{R}^2)$, 则$f$是否为整个$\mathbb{R}^2$上的调和函数？
\end{enumerate}

== 2024--2025春期中 ==
一(30分)、填空题(每题 6 分)
\begin{enumerate}[label=(\arabic*)]
\item 计算$\displaystyle\lim_{n\to \infty}n^2\int_0^{\infty}\frac{n^2\sin x+\sin(n^2x)}{(1+n^2x^2)^2}\,\mathrm{d}x=\underline{\qquad\quad}$.
\item 设物体$D=\left\{ (x,y,z) \,\big|\, 0 \le z\le \sqrt{x^2+y^2} \le 1\right\}$，它在$(x,y,z)\in D$处的密度为$\sqrt{x^2+y^2}e^{x^2+y^2}$,则其质量为$\underline{\qquad\quad}$.
\item 设实函数$f$满足常微分方程$(1-x^2)f''(x)-xf'(x)-2=0$. 则$f$的MacLaurin 级数为$\underline{\qquad\quad}$.
\item 设$a$为实常数.若函数项级数$\displaystyle\sum_{n=2}^{\infty}\frac{\sin nx}{n^{a}+(-1)^n+\sin nx}$关于$x\in (0,2\pi)$内闭一致收敛，则$a$的取值范围为$\underline{\quad\qquad}$.
\item 计算$\displaystyle\lim_{n\to \infty}\prod_{k=1}^n\left(1+\dfrac{1}{n}\cos^2 \dfrac{2k\pi}{n}\right)=\underline{\quad\qquad}$.
\end{enumerate}
~\\
二(12分)、设$E\subset \mathbb{R}^n$是可测集，$E$上的非负可测函数列$\{f_k\}$依测度收敛于$f\in L^1(E)$，且$\lim\limits_{k\to +\infty}\int_{E}f_k(x)\,\mathrm{d}x=\int_Ef(x)\,\mathrm{d}x$，
求证：对于$E$的任何可测子集$F$，成立$\lim\limits_{k\to +\infty}\int_{F}f_k(x)\,\mathrm{d}x=\int_Ff(x)\,\mathrm{d}x$.

~\\
三(18分)、平面$\Sigma_1:x+2y+3z=0,\Sigma_2:3x+4y+7z=0,\Sigma_3:5x+6y+9z=0$以及$\Sigma_4:5x+4y+3z=12$交出了一个四面体$\Delta$，求$\Delta$的体积以及三角形$\Delta \cap \Sigma_4$的面积.

~\\
四(20分)、设$R>0$，实解析函数列$\{f_n\}$在$[-R,R]$上一致收敛于$f$.同时对于一切$n$，$f_n$的收敛半径大于$R$.
\begin{enumerate}
    \item 对于一切$n$，$f_n$的MacLaurin 级数在$[-R,R]$上等于$f_n$.
    \item 证明或给出反例，$f$的MacLaurin级数在$0$的一个邻域内等于$f$.
    \item 我们加强$2$的假设：如果$\{f_n\}$满足$\{f_n^{(k)}\}$在$[-R,R]$上一致收敛到$f^{(k)}$，判断此时2是否成立.
\end{enumerate}
注：若给出2的肯定证明，则不必做3；若给出3的反例，则不必做2.

~\\
五(20分)、对于矩阵$A$，定义矩阵范数$\|A\|=\max\limits_{\mathbf{|x|}=1}|A\mathbf{x}|$.当$\|A\|<1$时，定义$\ln (I+A)=\sum\limits_{k=0}^{\infty}\dfrac{(-1)^k}{k+1}A^{k+1}$.给定$k\ge 1,n\ge 2$，矩阵值函数$F(\cdot)\in C^k([0,1];\mathbb{R}^{n\times n})$满足$\|F(t)\|<1$对任意$t\in [0,1]$均成立.
\begin{enumerate}
    \item 已知对于一切$s,t\in[0,1]$，有$F(t),F(s)$可交换.求证：
    $(\ln(I+F(t))'=(I+F(t))^{-1}F'(t)$对一切$t\in [0,1]$成立.
    \item 已知$A,B$可交换，$\|A\|+\|B\|<\dfrac{4}{5}$，求证：$\ln(I+A)(I+B)=\ln(I+A)+\ln(I+B)$.
    \item 对于$\|A\|<1$，求证：$e^{\ln (I+A)}=I+A$.
    \item 尽你所能，给出矩阵$B$的充分条件，使得存在矩阵$A$，满足$e^A=B$.
\end{enumerate}

== 2024--2025秋期末 ==
一(30分）、填空题(每题6分)
\begin{enumerate}[label=(\arabic*)]
\item 设$f(x)$在$0$点附近有两阶导数，$\displaystyle\lim_{x\rightarrow 0}\frac{f(x)-(1+\sin x)^{1/\sin x}}{x^2}=1$,
则$\big(f(0),f'(0),f''(0)\big)=\underline{\qquad\quad}$.
\item $\displaystyle\int\frac{\ln x}{(1+\ln x)^2}\mathrm{d}x=\underline{\qquad\quad}$.
\item 设有$f$的测量值$f(0)=3.1,f(1)=3.1,f(2)=-2.05,f(3)=-0.9,f(4)=4$.
现用函数$\varphi(x)\equiv\varphi(x;a,b,c):=a\sin\frac{\pi x}{2}+b\cos\frac{\pi x}{2}+c$去拟合$f(x)$,
则使得$\displaystyle\sum_{k=0}^4|f(k)-\varphi(k)|^2$取得最小值的$(a,b,c)=\underline{\qquad\quad}$.
\item 方程$f''(x)+3f'(x)+2f(x)=x+1$的通解是$\underline{\qquad\quad}$.
\item 设$f$在$(0,+\infty)$上满足$f''(x)+3f'(x)+2f(x)=(x^2+x+1)\sin\dfrac{1}{x}$，
则$\lim\limits_{x\rightarrow+\infty}f'(x)=\underline{\qquad\quad}$,
$\lim\limits_{x\rightarrow+\infty}f''(x)=\underline{\qquad\quad}$.
\end{enumerate}
~\\
二(14分)、设$f$在$\mathbb{R}$上连续可微，$g(x)=\sin f(x)$ $(x\in\R)$。若$|f'|\leq1$，证明：
\begin{enumerate}[label=(\arabic*)]
\item 对任何$x\neq y$，成立$|g(x)-g(y)|<|x-y|$.
\item 对任何$x_0\in\R$，数列$\{g_n(x_0)\}$收敛，其中$g_n$表示$\overbrace{g\circ g\circ \cdots\circ g}^{n\text{ 个}}$。
\end{enumerate}
~\\
三(14分)、设$\alpha\in(0,1)$为常数，$x_0\in\R$，非负函数$f$在$\R$上可导，
满足：$\forall\,x>y$，有$f'(x)-f'(y)<x-y$，且$f'(x_0)>\sqrt{2\alpha f(x_0)}$。证明：

(1) $f$在$\R$上连续可微.\qquad\qquad\qquad\qquad\qquad\quad
(2) 存在$\xi<x_0$，使得$f'(\xi)=\sqrt{2\alpha f(\xi)}$.

(3) 存在$\eta<x_0$，使得$\dfrac{f'(x_0)-f'(\eta)}{x_0-\eta}>\alpha$.\qquad
(4) $f'\leq\sqrt{2f}$.

~\\
四(14分)、设数列$\{a_n\}$取值于$\{0,1\}$，设$\displaystyle S_n=\sum_{k=1}^n a_k$.
证明：$\displaystyle\sum_{n=1}^\infty \frac{a_n}{\sqrt{n}}$收敛的充要条件是
$\displaystyle\sum\limits_{n=1}^\infty \frac{S_n}{n\sqrt{n}}$收敛。

~\\
五(14分)、设实数列$\{x_n\},\{y_n\}$满足：
$\begin{cases}
    x_n^2+y_n^2+ny_n\sin\dfrac2n=2-\cos\dfrac1n,\\ \\
    x_n+n^{\frac1n}y_n=1+e^{-n}.
\end{cases}$\\
证明：$\{x_n\},\{y_n\}$收敛，并求其极限.

~\\
六(14分)、设$f$在$\R^2$上二阶连续可微，$\lim\limits_{(x,y)\rightarrow\infty}f(x,y)=0$，且$\forall\,(x,y)\in\R^2$，有
$$y^2f_{xx}(x,y)+x^2f_{yy}(x,y)-2xf_{x}(x,y)-2yf_{y}(x,y)=\big((x-1)^2+(y-1)^2+c\big)f(x,y).$$
(1) 若$c=1$，证明：$f$恒等于零.\\
(2) 若$c=0$，证明：$f$恒等于零.

== 2023--2024春期末 ==
一（30 分）、填空题（每题6分）：
\begin{enumerate}[label=(\arabic*)]
\item 设 $L$ 为曲线 $(x, y, z)=\left(-2t-\cos(t\pi), \cos(2t\pi)+t^{2}-t, t \sin \dfrac{5t\pi}{2}\right)$ 从 $t=0$ 到 $t=1$ 的那一段，
则积分 $\displaystyle\int_{L} P \, dx+Q \, dy+R \, dz=\underline{\qquad\qquad}$，
其中 $(P, Q, R)=e^{-y-z}\big(z \sin (x+y), z \sin (x+y)+z \cos (x+y),(z-1) \cos (x+y)\big)$。
\item 考虑牟合方盖 $W:=\left\{(x, y, z) \,\big|\, x^{2}+y^{2} \leq 1, y^{2}+z^{2} \leq 1\right\}$，
其表面积为 $\underline{\qquad\qquad}$。
\item 设 $\displaystyle f(x)=\int_{0}^{x} \frac{x-t}{\sqrt{1-t^{3}}} \, dt$，
则 $f$ 的 Maclaurin 级数中 $x^{2024}$ 的系数为 $\underline{\qquad\qquad}$。
\item 设 $\alpha$ 为非零实数，$f$ 以 $2\pi$ 为周期，
对于 $x \in[0,2\pi)$，$f(x)=|\sin (\alpha x)|^{\frac{1}{\alpha}}$。
则 $f$的 Fourier 级数在 $[0,2\pi)$ 上一致收敛的充要条件是 $\alpha \in \underline{\qquad\qquad}$。
\item 极限 $\displaystyle\lim_{n \rightarrow+\infty} \int_{0}^{1} \frac{|\sin nx|}{x} \ln (1-x) \, dx=\underline{\qquad\qquad}$。
\end{enumerate}
~\\
二（14 分）、设 $f, g$ 是 $\mathbb{R}$ 上的速降函数，证明：$f * g$ 也是 $\mathbb{R}$ 上的速降函数。
进一步，试给出一个较弱的条件，使得 $f * g$ 是速降函数。

~\\
三（14 分）、设 $\Sigma$ 为曲面 $x^{2}+x y+y^{2}+z^{2}=4$，取外侧。计算
$$\iint\limits_{\Sigma} \frac{x \, dy dz+y \, dz dx+z \, dx dy}{(x^{2}+xy+y^{2}+z^{2})^{\frac{1}{2}}(x^{2}+y^{2}+z^{2})^{\frac{3}{2}}}.$$

~\\
四（14 分）、幂级数 $\displaystyle\sum_{n=0}^{\infty} a_{n} x^{n}$ 
在 $[-1,1]$ 上绝对收敛与一致收敛的关系如何？请给出必要的证明或反例。

~\\
五（14 分）、证明或否定：
$$\lim_{n \rightarrow+\infty} \sup_{x \in[0,1]}\left|\int_{0}^{\pi} \ln (x+t)\left(\frac{\sin \big(n+\frac{1}{20}\big) t}{\sin \frac{t}{24}}-\frac{24 \sin \big(n+\frac{1}{20}\big) t}{t}\right) d t\right|=0.$$

~\\
六（14 分）、设 $f(x)=e^{-x^{4}}, g(x)=e^{-x^{2}}(x \in \mathbb{R}), F=f+\widehat{f}$。
\begin{enumerate}[label=(\arabic*)]
\item 证明 $\widehat{F}=F$。
\item 推导 $\widehat{f}$ 所满足的常微分方程。
\item 证明不存在常数 $C$，使得 $F \equiv Cg$。
\end{enumerate}

