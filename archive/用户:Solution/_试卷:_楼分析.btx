\item 对于任何$\alpha>0$以及非负整数$m$，级数$\displaystyle \sum_{n=1}^\infty\frac{(-1)^{n-1}}{(n+m)^\alpha}$收敛.
\item 对于任何非负整数$m$，级数$\displaystyle \varliminf_{\alpha\to0^+}\sum_{n=1}^\infty\frac{(-1)^{n-1}}{(n+m)^\alpha}\ge\frac{1}{2}$.
\item $\displaystyle \lim_{\alpha\to0^+}\sum_{n=1}^\infty\frac{(-1)^{n-1}}{n^\alpha}=\frac{1}{2}$.
\end{enumerate}
