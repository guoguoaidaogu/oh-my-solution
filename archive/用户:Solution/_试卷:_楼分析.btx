六（14 分）、设 $f$ 以 $1$ 为周期，$f(x)=x^{2}(1-x)^{2}$ $(x \in[0,1])$，
$f$ 的 Fourier 级数为 $\displaystyle\frac{a_{0}}{2}+\sum_{n=1}^{\infty}(a_{n} \cos 2n \pi x+b_{n} \sin 2n \pi x)$。
考虑方程 $H: \begin{cases}u_{t}(t,x)=u_{xx}(t,x), & t \geq 0,\ x \in \mathbb{R}, \\ \\ u(0, x)=f(x), & x \in \mathbb{R}.\end{cases}$
\begin{enumerate}
\item 若方程 $H$ 的解 $u$ 存在且 $u, u_{t}, u_{x}, u_{xx} \in C([0,+\infty) \times \mathbb{R})$，
证明：$F(t):=\int_{0}^{1} u^{2}(t,x) \, dx$ 在 $[0,+\infty)$ 上单减。
\item 令 $u(t, x)=a_{0}+\sum\limits_{n=1}^{\infty} e^{-4n^{2}\pi^{2}t}(a_{n} \cos 2n \pi x+b_{n} \sin 2n \pi x)$，
证明：$u$ 为方程 $H$ 满足 $u, u_{t}, u_{x}, u_{xx} \in C([0,+\infty) \times \mathbb{R})$ 的唯一解。
\end{enumerate}


