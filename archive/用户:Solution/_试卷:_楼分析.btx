~\\
四（18 分）、设 $k \geq 1, n \geq 2$，矩阵值函数 $A(\cdot) \in C^{k}([0,1] ; \mathbb{R}^{n \times n})$ 满足 $\|A(\cdot)\|<1$。
证明：存在矩阵值函数 $G(\cdot) \in C^{k}([0,1];\mathbb{R}^{n \times n})$ 使得：$G^{2}(\cdot)=I-A(\cdot)$ 以及 $\|G(\cdot)\| \geq \sqrt{1-\|A(\cdot)\|}$，其中 $I$ 是 $n$ 阶单位矩阵。

~\\
五（18 分）、设 $h_{n}(x)=\sin (nx) \chi_{[0,2\pi]}(x)$ $(n \geq 1)$。
\begin{enumerate}[label=(\arabic*)]
\item 若 $L^{2}(\mathbb{R})$ 中函数列 $\{f_{n}\}$ 收敛于 $f$，
则 $\|f\|_{2}=\lim\limits_{n \rightarrow+\infty}\|f_{n}\|_{2}$，且对任何 $g \in L^{2}(\mathbb{R})$，
有 $\lim\limits_{n \rightarrow+\infty} \int_{\mathbb{R}} f_{n}(x) g(x) \, dx=\int_{\mathbb{R}} f(x) g(x) \, dx$。
\item 证明：$\{h_{n}\}$ 是 $L^{2}(\mathbb{R})$ 中有界列，但没有收敛子列。
\end{enumerate}

~\\
附加题（20 分）、设 $X=\bigcup\limits_{n=1}^{\infty}\left\{f \chi_{[-n,n]} \,\big|\, f \in \mathscr{P}\right\}$，
其中 $\mathscr{P}$ 为 $\mathbb{R}$ 上的有理系数多项式全体。
\begin{enumerate}[label=(\arabic*)]
\item 证明：对任何 $f \in L^{2}(\mathbb{R})$，
成立 $\inf\limits_{g \in X}\|g-f\|_{L^{2}(\mathbb{R})}=0$。
\item 设 $\{f_{n}\}$ 是 $L^{2}(\mathbb{R})$ 中的有界列。
证明存在 $\{f_{n}\}$ 的子列 $\{f_{n_{k}}\}$ 使得对任何 $g \in L^{2}(\mathbb{R})$，
$\displaystyle\lim_{k \rightarrow+\infty} \int_{\mathbb{R}} f_{n_{k}}(x)g(x) \, dx$ 存在。
\end{enumerate}

