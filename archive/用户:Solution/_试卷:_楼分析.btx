\begin{enumerate}[label=(\arabic*)]
\item $\lim\limits_{x \rightarrow 0} \dfrac{\arctan (1+\tan \arcsin x)-\arctan (1+x)}{x^{3}}=\underline{\qquad\qquad}$。
\item $\displaystyle\int\frac{2x^{3}+3x^{2}-4x+5}{(x+1)(2x^{2}+x+1)(x^{2}+x+2)}\,dx=\underline{\qquad\qquad}$。
\item 在约束条件 $x^{2}+y^{2}+z^{2}=1$ 下，函数 $f(x, y, z)=x^{2}+4y^{2}+6z^{2}+4xy+10yz+6zx$的最大值落在区间 $[n, n+1)$ 中，则 $n=\underline{\qquad\qquad}$。
\item 设 $f(x)=\dfrac{1}{(x^{2}+x+1)^{2}}$，则 $f^{(100)}(0)=\underline{\qquad\qquad}$。
\item 常微分方程 $y^{(4)}-4y^{\prime \prime \prime}+5y^{\prime \prime}-4y^{\prime}+4 y=e^{2x}+x \cos x$ 的通解是 $\underline{\qquad\qquad\qquad\qquad}$。
\end{enumerate}
