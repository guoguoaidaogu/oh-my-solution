        \draw[->](1,1)--(1,0);\draw(1,0)--(1,-1);
        \draw[->](-1,-1)--(-1,0);\draw(-1,0)--(-1,1);
        \draw[->](-1,1)--(-0.3,1);\draw(-0.3,1)--(-0.12,1);
