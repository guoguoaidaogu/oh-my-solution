    \item[38.]
    只需验证全纯函数作为复变量的实部与虚部的函数的Jacobi行列式大于$0$。
    \\
    设$f(x+iy)\triangleq F(x,y)=u(x,y)+iv(x,y)$是全纯函数，由Cauchy-Riemann方程，
    \[
    J_F=\left|\begin{array}{cc}
     \frac{\partial u}{\partial x} & \frac{\partial u}{\partial y} \\
    \frac{\partial v}{\partial x} & \frac{\partial v}{\partial y}
    \end{array}\right|
    =\left|\begin{array}{cc}
     \frac{\partial u}{\partial x} & \frac{\partial u}{\partial y} \\
    -\frac{\partial u}{\partial y} & \frac{\partial u}{\partial x}
    \end{array}\right|
    =\Big(\frac{\partial u}{\partial x}\Big)^2
    +\Big(\frac{\partial u}{\partial y}\Big)^2>0.
    \]

    \item[39.]
    \begin{enumerate}
    \item[(1)] 对于使$g(q)>c$的$q\in\mathbf{R}^n$，
    由$g$的连续性得存在$q$的邻域$U$使得$g|_U>c$，
    即$U\subset\operatorname{Int}M$；
    \\
    对于$q\in g^{-1}(c)$，由$\triangledown g(q)\neq0$，
    可取合适的光滑函数$y^1=y^1(x),\cdots, y^{n-1}=y^{n-1}(x)$
    使得对$y^n=g(x)-c$有$\det\big(\frac{\partial y^i}{\partial x^j}\big)|_q\neq0$，
    由隐函数定理，存在$\mathbf{R}^n$在$q$的邻域$U$使得$(U,y^i)$
    是与原坐标系$(M,x^j)$ $C^\infty$- 相关的坐标卡。
    在这一坐标卡下，$p\in M$等价于$y_n(p)=g(p)-c\geq0$，即$p$的坐标属于$H^n$，
    所以$M$在$q$的邻域$U\cap M$光滑同胚于$H^n$的一个开子集，且$q\in\partial M$。
    \\
    因此，$M$是一个$n$维带边流形。
    
    \item[(2)] 由推论5.5（P103）得到$g^{-1}(c)$是$n-1$维无边流形；
    \\
    由（1）知$g^{-1}(c)=\partial M$，所以$M$上的定向
    （可由$\mathbf{R}^n$的定向限制得到）诱导出$\partial M$上的定向。
    \end{enumerate}

    \item[40.]
    \begin{enumerate}
        \item[(1)] 设$\left\{(U_\alpha,\varphi_\alpha)\right\}$是$M$的一个定向，
    $\left\{(V_\beta,\phi_\beta)\right\}$是$N$的一个定向，
    那么$\left\{(U_\alpha\times V_\beta,(\varphi_\alpha,\phi_\beta))\right\}$
    （包含于的定向相符的极大容许坐标卡集）就是$M\times N$的一个定向，
    这是因为当$(U_\alpha\times V_\beta)\cap(U_{\alpha'}\times V_{\beta'})\neq\varnothing$时，
    \[
    \det\Big(\frac{\partial((\varphi_{\alpha'},\phi_{\beta'})
    \circ((\varphi_\alpha,\phi_\beta)^{-1})^{i}}
    {\partial (x_{\alpha}^j,y_{\beta}^k)}\Big)
    =\det\Big(\frac{\partial(\varphi_{\alpha'}\circ\varphi_\alpha^{-1})^{i}}{\partial x_\alpha^j}\Big)
    \det\Big(\frac{\partial(\phi_{\beta'}\circ\phi_\beta^{-1})^{i}}{\partial y_\beta^k}\Big)>0.
    \]

    \item[(2)] 即证明若$M\times N$是可定向的，则$M,N$都是可定向的。
    \\
    设$\left\{(W_\gamma,\psi_\gamma)\right\}$是$M\times N$的一个定向，
    $\left\{(U_\alpha\times V_\beta,(\varphi_\alpha,\phi_\beta))\right\}$
    为其中全体这种形式的元素，显然有$M=
    \bigcup\limits_{\alpha}U_\alpha,N=\bigcup\limits_{\beta}V_\beta$。
    注意到当$U_\alpha\cap U_{\alpha'}\neq\varnothing$时，任取一个$\beta$，
    $$\det\Big(\frac{\partial(\varphi_{\alpha'}
    \circ\varphi_\alpha^{-1})^{i}}{\partial x_{\alpha}^j}\Big)
    =\det\Big(\frac{\partial((\varphi_{\alpha'},\phi_\beta)
    \circ(\varphi_\alpha,\phi_\beta)^{-1})^{i}}
    {\partial(x_\alpha^j,y_\beta^k)}\Big)>0,$$
    所以$\left\{(U_\alpha,\varphi_\alpha)\right\}$是$M$的一个定向，
    同理$\left\{(V_\beta,\phi_\beta)\right\}$是$N$的一个定向。
    
    \item[(3)] 设$\left\{(U_\alpha,\varphi_\alpha)\right\}$是带边流形$M$的微分结构，
    $\left\{(V_\beta,\phi_\beta)\right\}$是流形$N$的微分结构，
    那么$\left\{(U_\alpha\times V_\beta,(\varphi_\alpha,\phi_\beta))\right\}$
    是带边流形$M\times N$的微分结构，
    这是因为$(\varphi_\alpha,\phi_\beta)$是$U_\alpha\times V_\beta$
    到$H^m\times\mathbf{R}^n=H^{m+n}$的开子集的同胚
    （这里$m=\dim M,n=\dim N$，$H^{m+n}=\left\{x\in\mathbf{R}^{m+n}\mid x_m\geq0\right\}$），
    且$(p,q)\in\partial(M\times N)$当且仅当
    存在坐标卡使$(\varphi_\alpha(p),\phi_\beta(q))\in\partial H^{m+n}$，
    当且仅当$\varphi_\alpha(p)\in\partial H^m$，当且仅当$p\in\partial M$，
    所以$\partial(M\times N)= \partial M\times N$。
    \end{enumerate}

    \item[41.]
    称为光滑Urysohn定理，是单位分解定理（定理2.7，P66）的一个推论。
    \\
    $\left\{M\backslash A,M\backslash B\right\}$是$M$的一个开覆盖，
    根据单位分解定理，存在局部有限的加细开覆盖
    $\left\{V_i\right\}_{i=1}^\infty$
    以及光滑函数$\left\{f_i\right\}_{i=1}^\infty$使得
    $0\leq f_i\leq1$，$\sum\limits_{i=1}^\infty f_i=1$，
    且$\operatorname{supp}f_i\subset V_i\subset M\backslash A$或$M\backslash B$，
    也就是说$f_i|_A\equiv0$或$f_i|_B\equiv0$。
    \\
    令$\psi=\sum\limits_{f_i|_B\equiv0}f_i$，则$0\leq\psi\leq1$，$\psi|_B\equiv0$，
    且由于若$f_i|_B\not\equiv0$就有$f_i|_A\equiv0$，
    得
    \[
    \psi|_A=\Big(\sum_i f_i-\sum_{f_i|_B\not\equiv0}f_i\Big)\Big|_A\equiv1,
    \]
    而且$\left\{V_i\right\}_{i=1}^\infty$局部有限表明
    $\psi=\sum\limits_{f_i|_B\equiv0}f_i$局部为有限个非零$f_i$之和，所以$\psi$也光滑。
\end{itemize}