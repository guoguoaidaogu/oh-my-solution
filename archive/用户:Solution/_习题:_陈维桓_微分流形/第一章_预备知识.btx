	\item[43.] \begin{align*}
			\varphi \wedge \psi(v_1,\cdots,v_{r+s})
			&=\frac{1}{r!s!} \sum\limits_{\sigma}\operatorname{sign}(\sigma)\varphi \otimes \psi(v_{\sigma(1)},\cdots,v_{\sigma(r+s)})\\
			&=\frac{1}{r!s!} \sum\limits_{i_1,\cdots,i_r}\varphi(v_{i_1},\cdots,v_{i_r})\sum\limits_{\sigma(k)=i_k}\operatorname{sign}(\sigma)\psi(v_{\sigma(r+1)},\cdots,v_{\sigma(r+s)})\\
			&=\sum_{\substack{i_1<\cdots<i_r\\ i_{r+1}<\cdots<i_{r+s}}}\operatorname{sign}(\sigma_{i_1,\cdots,i_r})\varphi(v_{i_1},\cdots,v_{i_r})\psi(v_{i_{r+1}},\cdots,v_{i_{r+s}}),
		\end{align*}
	其中$\sigma_{i_1,\cdots,i_r}(1,2,\cdots,r+s)=(i_1,\cdots,i_r,i_{r+1},\cdots,i_{r+s})$, 
    故$\operatorname{sign}(\sigma_{i_1,\cdots,i_r})=\delta_{1,\cdots,r+s}^{i_1,\cdots,i_{r+s}}$, 代入即证.
	
	\item[44.] 
	\begin{enumerate}
        \item[(1)]
	易证.
	
	\item[(2)]
		\begin{align*}
			i(u_1)(\varphi\wedge\psi)&(u_2,\cdots,u_{r+s})
			=\sum_{\substack{i_1<\cdots<i_r\\ i_{r+1}<\cdots<i_{r+s}}}\delta_{1,\cdots,r+s}^{i_1,\cdots,i_{r+s}} 				\varphi(u_{i_1},\cdots,u_{i_r})\psi(u_{i_{r+1}},\cdots,u_{i_{r+s}})\\
			&=\sum_{\substack{i_1<\cdots<i_r\\ i_{r+1}<\cdots<i_{r+s}}} \Big[\sum\limits_{1\in \{i_1,\cdots,i_r\}}					\delta_{1,2,\cdots,r+s}^{1,i_2,\cdots,i_{r+s}}\varphi(u_1,u_{i_2},\cdots,u_{i_r})\psi(u_{i_{r+1}},\cdots,u_{i_{r+s}})\\
			&\ \ \ \ +\sum\limits_{1\notin \{i_1,\cdots,i_r\}} \delta_{1,\cdots,r,r+1,r+2,\cdots,r+s}^{i_1,\cdots,i_r,1,i_{r+2},\cdots,i_{r+s}}\varphi(u_{i_1},\cdots,u_{i_r})\psi(u_1,u_{i_{r+2}},\cdots,u_{i_{r+s}})\Big]\\
			&=\sum_{\substack{i_2<\cdots<i_r\\ i_{r+1}<\cdots<i_{r+s}}} \delta_{2,\cdots,r+s}^{i_2,\cdots,i_{r+s}}(i(u_1)\varphi)(u_{i_2},\cdots,u_{i_r})\psi(u_{i_{r+1}},\cdots,u_{i_{r+s}})\\
			&\ \ \ \ +(-1)^r\sum_{\substack{i_1<\cdots<i_r\\ i_{r+2}<\cdots<i_{r+s}}} \delta_{2,\cdots,r+1,r+2,\cdots,r+s}^{i_1,\cdots,i_r,i_{r+2},\cdots,i_{r+s}}\varphi(u_{i_1},\cdots,u_{i_r})(i(u_1)\psi)(u_{i_{r+2}},\cdots,u_{i_{r+s}})\\
			&=((i(u_1)\varphi)\wedge \psi+(-1)^r\varphi \wedge (i(u_1)\psi))(u_2,\cdots,u_{r+s}).
		\end{align*}
	
	\end{enumerate}
	
	
	\item[45.]
	\begin{enumerate}
	\item[(1)]
		易证.
		
	\item[(2)]
		\begin{align*}
			e(\alpha)(\varphi\wedge \psi)&=\alpha\wedge(\varphi\wedge \psi)\\
			&=(\alpha\wedge\varphi)\wedge\psi\\
			&=(e(\alpha)\varphi)\wedge\psi,
		\end{align*}

        \begin{align*}
            (\alpha\wedge\varphi\wedge\psi)(u_1,\cdots,u_{r+s+1})s
								&=(\varphi\wedge\alpha\wedge\psi)(u_2,\cdots,u_{r+1},u_1,u_{r+2},\cdots,u_{r+s+1})\\
								&=(-1)^r(\varphi\wedge\alpha\wedge\psi)(u_1,\cdots,u_{r+s+1}),
		\end{align*}
	故$e(\alpha)(\varphi\wedge\psi)=(-1)^r\varphi\wedge(\alpha\wedge\psi)=(-1)^r\varphi\wedge (e(\alpha)(\psi)).$
	
	
	
	
	\end{enumerate}
	
	
    \item[46.]
   由第44、45题，
   \begin{align*}
    i(u)\circ e(\alpha)\varphi+e(\alpha)\circ i(u)\varphi&=(i(u)\alpha)\wedge\varphi-\alpha\wedge(i(u)\varphi)+\alpha\wedge(i(u)\varphi)\\
    &=\alpha(u)\varphi.
    \end{align*}
    即证.

    \item[47.]
    (1)(2)我们直接证明(2)的$n\geq 1$的情形.\\
    $n=1$显然成立.对$n$归纳：
    假设$n$已成立，对于$\dim V=n+1$中的$n$次外形式
    $$\Omega=\sum\limits_{i=1}^{n+1}a_i\delta^1\wedge\cdots\wedge\hat{\delta^i}\wedge\cdots\wedge\delta^{n+1},$$
    $a_i$不全为$0$，$\{\delta_i\}$为$V$的一组基.\\
    考虑$\psi=\sum b_i\delta^i$,则$\psi\wedge\Omega=(\sum a_ib_i(-1)^{i+1})\delta^1\wedge\cdots\wedge\delta^{n+1},$\\
    易见存在$\{b_i\}$使得$\sum a_ib_i(-1)^{i+1}=0$.\\
    即存在$\psi$使得$\psi\wedge\Omega=0$.\\
    由定理5.8（P43），存在$\varphi$使得$\Omega=\psi\wedge\varphi$.\\
    注意到存在$W,\dim W=n$使得$V^*=\mathbf{R}\psi\oplus W^*$,\\
    考虑$\varphi$在$W^*$的投影$\tilde{\varphi}$,可见$\Omega=\psi\wedge\tilde{\varphi}$.\\
    由归纳假设，$\tilde{\varphi}$可分解，于是$\Omega$可分解.\\
    
    (3)
    当$\dim V=4$时$\delta^1\wedge\delta^2+\delta^3\wedge\delta^4$不可分解,\\
    否则存在$\sum\limits_{i=1}^4 a_i\delta^i\neq0$
    使得$\Big(\sum\limits_{i=1}^4 a_i\delta^i\Big)\wedge(\delta^1\wedge\delta^2+\delta^3\wedge\delta^4)=0$,\\
    展开得$a_1=a_2=a_3=a_4=0$，矛盾.

    \item[48.]
    设$V^* $ 的基底为$\{  \delta^i  \}$，$2$次外形式 $ \alpha $ 可表为\\
    $$ \alpha =  \sum _ {i<j} \alpha_{ij}\delta^i \wedge  \delta^j .$$
    
    假定 $ \alpha_{ij} $不全为$0$ ,不妨设 $ \alpha_ {12} \neq 0$ ,于是\\
     \begin{align*}\alpha&=( \alpha_ {12} \delta ^ {1}  +  \alpha _ {32}  \delta ^ {3}  +  \cdots +  \alpha _ {n2}  \delta^ {n}  )  \wedge  (\delta ^ {2}+\frac{\alpha _ {13}}{\alpha _ {12}}\delta^3 + \cdots  + \frac{\alpha _{1n}}{\alpha _{12}}\delta^ {n}) + \sum \limits_{3\leq i<j\leq n}\alpha '_ {ij} \delta^i \wedge  \delta^j\\
     &=  \sigma ^ {1} \wedge \sigma ^ {2}  +  \sum _{3\leq i<j\leq n} \alpha'_{ij} \delta^i \wedge  \delta ^j,\end{align*}
     其中
    $\displaystyle{\sigma ^ {1} = \alpha_ {12} \delta ^ {1}  +  \alpha _ {32}  \delta ^ {3}  +  \cdots +  \alpha _ {n2}  \delta^ {n}, 
    \sigma^2=\delta ^ {2}+\frac{\alpha _ {13}}{\alpha _ {12}}\delta^3 + \cdots  + \frac{\alpha _ {1n}}{\alpha _ {12}}\delta^ {n}}$.

     若 $ \alpha'_{ij} $不全为零，不妨设 $ \alpha '_{34} \neq  0$，继续上面的过程。
     因$n$是有限数,故上述步骤必在有限步之后终止, 即$\alpha$可表成
     $$ \alpha= \sigma ^ {1}  \wedge \sigma ^ {2}  +  \cdots + \sigma ^ {2r-1} \wedge  \sigma ^ {2r} ,$$ 
     易见 $ \sigma ^ {1} ,\cdots , \sigma ^ {2r} $ 是线性无关的$1$次形式.\\
     由$\sigma^{2i-1}\wedge\sigma^{2i}\wedge\sigma^{2j-1}\wedge\sigma^{2j}
     =\sigma^{2j-1}\wedge\sigma^{2j}\wedge\sigma^{2i-1}\wedge\sigma^{2i}$
     可得$\alpha^r=r!\sigma^1\wedge\sigma^2\wedge\cdots\wedge\sigma^{2r-1}\wedge\sigma^{2r}\neq0$，
     由$\alpha^{r+1}$为高于$2r$次的外形式得$\alpha^{r+1}=0$，
     所以$2r$只与$\alpha$有关.
     
     Remark:可以直接通过反对称二次型的合同标准型说明.

    \item[49.]
    (1)对称性和双线性是显然的.\\
    由于$(\langle v_\alpha,v_\beta\rangle)_{\alpha,\beta}$为内积的Gram矩阵，于是正定性成立.\\
    (2)$\langle\delta _ {i_1}\wedge\cdots\wedge \delta_{i_p},\delta_{j_1}\wedge\cdots\wedge \delta_{j_p}\rangle
    =\det(\delta_{i_\alpha}^{j_\beta})
    =\delta_{j_1\cdots j_p}^{i_1\cdots i_p}.$\\

    \item[50.]
    (1)注意到映射$ \wedge^pA:\prod\limits_{i=1}^pV \rightarrow W$为交错多线性映射，\\
    由$ \wedge ^pV$  的泛性质，$ \wedge^pA:\prod\limits_{i=1}^pV \rightarrow W$诱导了$ \wedge  ^pA:\wedge^pV \rightarrow W$.\\
    
    (2)$\wedge^pA(\delta_{i_1}\wedge\cdots\wedge\delta_{i_p})=
    \delta_{\alpha_1\cdots\alpha_p}^{i_1\cdots i_p}a_{i_1}^{\alpha_1}\cdots a_{i_p}^{\alpha_p}.$\\
    
    (3)$\wedge^p(AB)(z_1,\cdots,z_p)=(ABz_1)\wedge\cdots\wedge(ABz_p)=\wedge^pA(Bz_1,\cdots,Bz_p)=\wedge^pA\circ\wedge ^pB(z_1,\cdots ,z_p).$
\end{itemize}