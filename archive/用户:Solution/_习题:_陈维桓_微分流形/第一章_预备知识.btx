        =\frac{1}{r!}\delta^{k_1\dots k_r}_{j_1\dots j_r}\delta^{i_1\dots i_r}_{k_1\dots k_r}\delta^{i_{r+1}\dots i_{r+s}}_{j_{r+1}\dots j_{r+s}}\\
		&=\frac{|\mathscr{S}(r)|}{r!}\delta^{i_1\dots i_r}_{j_1\dots j_r}\delta^{i_{r+1}\dots i_{r+s}}_{j_{r+1}\dots j_{r+s}}\\
		&=\delta^{i_1\dots i_{r+s}}_{j_1\dots j_{r+s}}.
	\end{align*}\par
	(2)
