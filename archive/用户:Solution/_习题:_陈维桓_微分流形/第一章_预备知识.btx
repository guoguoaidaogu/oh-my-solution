	\item[33.]
    对于任意的$\sigma\in\mathscr{S}$有
    \[
        \det a=\operatorname{sign}(\sigma)a_{i_1}^{\sigma(i_1)}\cdots a_{i_n}^{\sigma(i_n)},
    \]
    因此
    \[
        \det a=\frac{1}{n!}\sum_{\sigma\in\mathscr{S}}\operatorname{sign}(\sigma)a_{i_1}^{\sigma(i_1)}\cdots a_{i_n}^{\sigma(i_n)}
    =\frac{1}{n!}\delta_{j_1\cdots j_n}^{i_1\cdots i_n}a_{i_1}^{j_1}\cdots a_{i_n}^{j_n}.
    \]

    \item[34.] 构造$(r,r)$型张量$f(\alpha^1,\cdots,\alpha^r,v_1,\cdots,v_r):= \sum_{\sigma\in \mathscr{S}(r)} \operatorname{sign}(\sigma) \alpha^1(v_{\sigma(1))}) \cdots \alpha^r(v_{\sigma(r)})$
    取定$V$的一组基$\{e_i\}$和对偶基$\{e^i\}$，则$f$在这组基下的分量
    \begin{align*}
        f_{j_1\cdots j_r}^{i_1\cdots i_r} & = f(e^{i_1},\cdots, e^{i_r},e_{j_1},\cdots,e_{j_r})\\
        & = \sum_{\sigma \in \mathscr{S}(r)} \operatorname{sign}(\sigma) e^{i_1}(e_{j_{\sigma(1))}}) \cdots e^{i_r}(e_{j_{\sigma(r)}})\\
        & = \sum_{\sigma \in \mathscr{S}(r)} \operatorname{sign}(\sigma) \delta^{i_1}_{j_{\sigma(1)}}\cdots \delta^{i_r}_{j_{\sigma(r)}}=\delta^{i_1 \cdots i_r}_{j_1 \cdots j_r}.
    \end{align*}

