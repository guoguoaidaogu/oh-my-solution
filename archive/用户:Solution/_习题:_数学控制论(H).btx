    \fill (0.5,-0.5) circle (0.02);
    \fill (-0.5,0.5) circle (0.02);
    \fill (-0.5,-0.5) circle (0.02);
    \draw[->,>=stealth] (-2.2,0) to (2.2,0);
    \draw[->,>=stealth] (0,-2.2,0) to (0,2.2);
    \draw[->,>=stealth] (-1,0)arc(-135:-85:0.707);
    \draw (0,0)arc(-45:-90:0.707);
    \draw[->,>=stealth] (0,1)arc(135:185:0.707);
    \draw (0,0)arc(-135:-180:0.707);
    \draw[->,>=stealth] (1,0)arc(45:95:0.707);
    \draw (0,0)arc(135:90:0.707);
    \draw[->,>=stealth] (0,-1)arc(-45:5:0.707);
    \draw (0,0)arc(45:0:0.707);
    \draw (2.4,0) node {$x$};
    \draw (0,2.4) node {$y$};
    \draw (-0.2,1) node {$2$};
    \draw (-0.3,-1) node {$-2$};
    \draw (1,-0.2) node {$2$};
    \draw (-1,-0.2) node {$-2$};
    \end{tikzpicture}
\end{itemize}

=== 第4章\ 非线性系统最优控制的存在性 ===

\begin{itemize}
    \item[2.] 正面的结果：若进一步要求$J_\alpha\ge0$，由Fatou引理，
    \[\sum_{\alpha\in A}J_\alpha(\bar{u})
    \le\sum_{\alpha\in A}\varliminf_{k\to\infty}J_\alpha(u_k)
    \le\varliminf_{k\to\infty}\sum_{\alpha\in A}J_\alpha(u_k).\]
    负面的结果：对$\alpha\in\Z^+$，取$J_\alpha(u)=u^\alpha-u^{\alpha-1}$，
    $u\in(0,1]$是反例，见下一题。

    \item[3.] 对$\alpha\in\Z^+$，$J_\alpha(u)=u^\alpha$
    都是$u\in(0,1]$上的连续函数，而
    \[\inf\limits_{\alpha\in\Z^+}u^\alpha
    =\begin{cases}0,&u\in(0,1)\\1,&u=1\end{cases}\]
    在$1$处不下半连续。
\end{itemize}

