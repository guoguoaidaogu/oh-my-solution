\end{enumerate}
\end{proof}
\end{enumerate}

\section{Sylow子群和Sylow定理}

\begin{enumerate}
\item 证明 $35$ 阶群为循环群.
\begin{proof}
    $m_5$整除$7$且模$5$余$1$，从而$m_5=1$，其Sylow $5$-子群是唯一的从而正规；
    $m_7$整除$5$且模$7$余$1$，从而$m_7=1$，其Sylow $7$-子群是唯一的从而正规。
    这样，本节例6和定理6.1说明$35$阶群必为$\Z_5\times\Z_7\cong\Z_{35}$。
\end{proof}
\item 证明 $40$ 阶群和 $3 \cdot 7^{1905}$ 阶群不是单群.
\begin{proof}
    对于$40$阶群，$m_5$整除$8$且模$5$余$1$，从而$m_5=1$。
    对于$3\cdot7^{1905}$阶群，$m_7$整除$3$且模$7$余$1$，从而$m_7=1$。
\end{proof}
\item 讨论 $14$ 阶群中 Sylow $2$-子群, Sylow $7$-子群的个数.
\item 计算 $A_6$ 中 $9$ 阶子群的个数.
\begin{proof}[解答]
    $9$阶非循环群的结构必为$\Z_3\times\Z_3$，
    即由两个不相交的$3$-轮换$(ijk)$和$(\ell mn)$生成，
    从而本题求的就是$6$个数划分成两组$3$个数有几种方法，答案是$\binom{6}{3}/2=10$。
\end{proof}
\item 设 $n$ 为正整数, $p$ 为奇素数,满足 $2^n > (p-1)!$.证明阶为 $2^n p$ 的群不是单群.
\begin{proof}
    设$G$为$2^np$阶群，由Sylow定理，$m_2$整除$p$，若$m_2=1$的话就完事了，下面设$m_2=p$。
    这时$G$可迁地共轭作用在其$p$个Sylow $2$-子群上，带来群同态$\rho:G \to S_p$，
    由于$|G|=2^np>p!=|S_p|$，可知$\rho$不是单射，从而$\ker\rho$是非平凡的正规子群。
\end{proof}
\item 证明 $24$ 阶群, $36$ 阶群, $48$ 阶群不是单群.
\begin{proof}
    只要说明$36$阶群不是单群即可，其余两个是上题的特殊情况。
    套路是差不多的，设$G$为$36$阶群，由Sylow定理，$m_3$整除$4$且模$3$余$1$，
    若$m_3=1$的话就完事了，下面设$m_3=4$。
    这时$G$可迁地共轭作用在其$4$个Sylow $3$-子群上，带来群同态$\rho:G \to S_4$，
    由于$|G|=36>24=|S_4|$，可知$\rho$不是单射，从而$\ker\rho$是非平凡的正规子群。
\end{proof}
\item 证明 $56$ 阶群和 $pqr$ 阶群($p<q<r$ 均为素数)不是单群.
\begin{proof}
    设$G$为$56$阶群，由Sylow定理，$m_7$整除$8$且模$7$余$1$，
    若$m_2=1$的话就完事了，下面设$m_7=8$。
    这时，$G$的$8$个Sylow $7$-子群两两之间的共用元素只有单位元$e$ 
    (这里能看出为何要优先考察Sylow $7$-子群而不是Sylow $2$-子群)，
    这些子群占据了除了$e$外的$8(7-1)=48$个元素。
    这样一来，Sylow $2$-子群的原材料就只有余下的$56-48=8$个元素了，
    这恰好说明$m_2=1$，系Sylow $2$-子群正规。

    设$G$为$pqr$阶群，由Sylow定理，(i) $m_r$整除$pq$且模$r$余$1$，则$m_r=1$或$pq$，
    (ii) $m_q$整除$pr$且模$q$余$1$，则$m_q=1$或$r$或$pr$，
    (iii) $m_p$整除$qr$，则$m_p=1$或$q$或$r$或$pr$。
    若$m_r,m_q,m_p$中有哪个是$1$就完事了，下面假定三者都大于$1$，要推出矛盾。

    首先，$G$的$pq$个Sylow $r$-子群两两之间的共用元素只有单位元$e$，
    这些子群占据了除了$e$外的$pq(r-1)$个元素；
    接着，Sylow $q$-子群不少于$r$个，占据了除了$e$外的不少于$r(q-1)$个元素；
    再者，Sylow $p$-子群不少于$q$个，占据了除了$e$外的不少于$q(p-1)$个元素。
    这样一来，$G$起码要有$pq(r-1)+r(q-1)+q(p-1)+1=pqr+(r-1)(q-1)>pqr$个元素，
    再精打细算也不够用。

    本题至此就做出来了，不过上面的放缩是比较宽松的，改进后能得出更确切的结果。
    事实上假定$m_r,m_q$都大于$1$就能推出矛盾了，
    这时$G$起码有$pq(r-1)+r(q-1)+p=pqr+(r-p)(q-1)>pqr$个元素。
    这也就是说，$G$的Sylow $r$-子群和Sylow $q$-子群至少有一个是正规的。

    更进一步，甚至能说明$G$的Sylow $r$-子群必定正规。
    记$R$是$G$的某个$r$阶子群，$Q$是$G$的某个$q$阶子群，
    现在已知$R,Q$之一是正规子群，那么只需要考虑$Q$正规的情况。
    这时商去$Q$得到$pr$阶群$G/Q$，由Cauchy定理知$G/Q$有$r$阶子群$H/Q$，
    则$H$是$G$的$qr$阶子群，进而第7节习题4说明$H$是$G$的正规子群。
    接着$H$又有$r$阶子群$N$，可以说明$N$是$G$的正规Sylow $r$-子群。
    这是因为对$g \in G$，注意到$gNg^{-1}$同样是$gHg^{-1}=H$的子群，
    并且$H$的Sylow $r$-子群是唯一的，从而有$gNg^{-1}=N$。
\end{proof}
\item 设 $G$ 是 $715$ 阶群, $P$ 是 $G$ 的 Sylow $13$-子群.证明: $P < C(G)$.
\begin{proof}
    由Sylow定理，$m_{13}$整除$55$且模$13$余$1$，从而$m_{13}=1$，即$P$是$G$的正规子群。
    那么$G$中的元素可以通过共轭作用带来$P$的自同构，即
    \[\theta:G\to\operatorname{Aut}(P), \quad g\mapsto\theta_g(p)=g^{-1}pg,\]
    故$G/\ker\theta$同构于$\operatorname{Aut}(P)$的一个子群。
    $P$身为$13$阶群是循环的，其自同构群为$(\Z_{13})^*\cong\Z_{12}$，
    从而$[G:\ker\theta]$整除$|\operatorname{Aut}(P)|=12$。
    不过$[G:\ker\theta]$也整除$|G|=715$，因此$[G:\ker\theta]=1$，
    即$\ker\theta$是整个$G$。这就是说$G$的元素都和$P$的元素交换，也就是$P<C(G)$。
\end{proof}
\item 在有限群 $G$ 中, $H$ 为 $G$ 的一个 Sylow $p$-子群.设 $L<G$ 且 $p \mid |L|$.证明:存在 $g \in G$ 使得 $gHg^{-1} \cap L$ 是 $L$ 的一个 Sylow $p$-子群.
\begin{proof}
    容易说明下述为$G$上的等价关系：$g \sim g'$是说存在$\ell \in L,h \in H$
    使得$g'=\ell gh$。据此把$G$拆成等价类的无交并$\coprod\limits_{g\in\varLambda}LgH$，
    其中$LgH=\{\ell gh\mid\ell \in L,h \in H\}$，$\varLambda$是$g$的代表元集。

    对任意固定的$g\in\varLambda$，设$LgH$是$H$的多个左陪集$gH,\ell gH,\ell'gH,\cdots$的无交并，即
    \[\textstyle LgH=gH\coprod\ell gH\coprod\ell'gH\coprod\cdots.\]
    考察$L$在集合$O=\{gH,\ell gH,\ell'gH,\cdots\}$上可迁的左乘作用，$gH$的稳定子群为
    \[\operatorname{Stab}(gH)=\{a \in L \mid agH=gH\}=gHg^{-1} \cap L,\]
    注意$H$是$p$-群意味着$gHg^{-1} \cap L$也是$p$-群。对轨道$O$的长度进行算两次，可知
    \[\frac{|LgH|}{|H|}=[L:\operatorname{Stab}(gH)]=\frac{|L|}{|gHg^{-1} \cap L|},\]
    接着对$g\in\varLambda$求和，得出
    \[\frac{|G|}{|H|}=\sum_{g\in\varLambda}\frac{|L|}{|gHg^{-1} \cap L|},\]
    上式左边不整除$p$，则右边有项不整除$p$，
    即存在$g\in\varLambda$使得$|gHg^{-1} \cap L|$穷尽了$|L|$中$p$的幂次，
    从而$gHg^{-1} \cap L$是$L$的Sylow $p$-子群。
\end{proof}
\item 设 $G$ 为 $p^2 q$ 阶群,其中 $p,q$ 为素数且 $p<q$.证明 $G$ 有正规的 Sylow $q$-子群,或者 $G \cong A_4$.
\begin{proof}
    由Sylow定理，$m_q$整除$p^2$且模$q$余$1$，
    当$m_q=1$时$G$的Sylow $q$-子群是正规的，并且$m_q=p$是不可能的，
    这样一来本题的目标其实是证明$m_q=p^2$时$G \cong A_4$。
    群的阶数是容易求出的，$p^2$模$q$余$1$表明$p$模$q$余$\pm1$，
    唯一的可能是$p=q-1$，即$p=2,q=3$，关键在于求出$12$阶群$G$的结构。

    设$H$是$G$的$4$个Sylow $3$-子群之一，$G$左乘作用在$H$的$4$个左陪集上，
    带来了同态$\pi:G \to S_4$，且$\ker\pi$是$H$的子群。
    注意$\ker\pi=H$的假定下$H$会是正规的Sylow $3$-子群，不符合条件；
    因此$\ker\pi=\{e\}$，即$G$同构于$S_4$的某个子群。
    不难说明$S_4$的$12$阶子群只有$A_4$，故$G \cong A_4$。
\end{proof}
\item 设 $G$ 是 $60$ 阶单群,证明 $G$ 同构于 $A_5$. (提示:可以假设 $G$ 不同构于 $A_5$,证明存在 $G$ 的两个不同的 Sylow $2$-子群 $P,Q$ 满足 $|N_{G} (P \cap Q)| \geqslant 12$,从而导出矛盾.)

结合 1.7 节的例 6, 1.8 节例 3 的结论,习题 1.8 中的第 2,6,7 题以及 1.9 节的例 2 中的结论,
可知阶最小的非素数阶循环群的单群一定是 $60$ 阶群,且同构于 $A_5$.
\begin{proof}
    第一步，先来看一个值得记住的小结论：设有限阶单群$G$有真子群$H$，
    则$|G|$整除$[G:H]!$。特别地，$60$阶单群的真子群的指数不小于$5$。

    这是因为$G$通过左乘可迁地作用在$G/H$上，
    带来了同态$\pi:G\to\operatorname{Sym}(G/H)$，
    可知$\ker\pi$作为$G$的正规子群只能是$\{e\}$，
    从而$G$同构于$\operatorname{Sym}(G/H)$的一个子群，故两者的阶有整除关系。
    特别地，$60$整除$[G:H]!$说明$[G:H]\geqslant5$。

    第二步，对$m_2$分类讨论来说明$60$阶单群$G$必有指数为$5$的子群。

    由Sylow定理有$m_2$整除$15$，且$G$是单群要求$m_2$不是$1$或$3$ 
    (当$m_2=3$时，$G$在这$3$个Sylow $2$-子群上的共轭作用带来的到$S_3$的同态不是单射)，
    从而$m_2=5$或$15$。如果$m_2=5$，取一个Sylow $2$-子群$H$，
    则其正规化子的指数为$[G:N_G(H)]=m_2=5$。下面处理难度更大的$m_2=15$的情形。

    这时存在两个不同的Sylow $2$-子群$P,Q$的交不止于单位元$e$。
    不然的话Sylow $2$-子群用了除$e$外的$15(4-1)=45$个元素，
    并且因为$m_5$整除$12$且模$5$余$1$且不是$1$，有$m_5=6$，
    这些Sylow $5$-子群用了除$e$外的$6(5-1)=24$个元素，
    截至目前$G$的元素个数已起码是$24+45+1=70>60$，超过上限了。

    现在来看$N_G(P \cap Q)$，简写$n=|N_G(P \cap Q)|$。
    首先，$P \cap Q$是其正规子群，从而$N_G(P \cap Q)$不是整个$G$，
    进而根据第一步有$60/n\geqslant5$，即$n\leqslant12$；
    接着，$P$和$Q$是其$4$阶子群，从而$4$整除$n$；
    再者，由$P,Q$生成的群亦为其子群且阶数大于$4$，从而$n>4$。
    因此$n=12$，指数$60/n$为$5$。

    第三步，通过指数为$5$的子群$N$的存在得出$G$同构于$A_5$。

    $G$通过左乘可迁地作用在$G/N$上，带来了同态$\rho:G \to S_5$，
    可知$\ker\rho=\{e\}$，这样$G$同构于$S_5$的子群，且指数为$5!/60=2$，
    从而其为正规子群 (第3节例3的(1))，只能是$A_5$。
\end{proof}
\item 设 $G$ 是 $360$ 阶单群,下面我们用反证法求 $G$ 的 Sylow $3$-子群的个数:
\begin{enumerate}[label=(\arabic*)]
\item 假设 $G$ 有 $40$ 个 Sylow $3$-子群,证明存在 $G$ 的两个 Sylow $3$-子群 $P \neq Q$,使 $|P \cap Q| > 1$;
\item 在 (1) 的假设下,记 $H = P \cap Q$.证明 $C_G(H)/H \cong A_4$, 以及$C_{G}(H)$ 有正规的 Sylow $2$-子群 $K$,
其中 $C_{G}(H) = \left\{g \in G \mid \forall\,h \in H, hg = gh\right\}$ 是 $H$ 在 $G$ 中的中心化子;
\item 在 (1) 的假设下,证明 $|N_{G}(K)| \geqslant 72$,导出矛盾;
\item 求 $G$ 的 Sylow $3$-子群的个数.
\end{enumerate}
\begin{proof}[解答]
    实际上$360$阶单群的结构必定是交错群$A_6$，参考\cite{Wa}命题2.4.6。
    \begin{enumerate}[label=(\arabic*)]
    \item 由Sylow定理，$m_5$模$5$余$1$且整除$72$，则$m_5=6$或$36$。
    如果$m_5=6$，令$G$共轭作用在其$6$个Sylow $5$-子群上，可知$G$同构于$S_6$的一个子群，
    且指数为$6!/360=2$，只能$G \cong A_6$；
    然而$A_6$的Sylow $3$-子群的数量为$10$个，不是题目说的$40$个。
    因此$m_5=36$，那么这些Sylow $5$-子群占据了除了$e$外的$36(5-1)=144$个元素；
    假定$G$的各个Sylow $3$-子群的交也仅限于$e$，
    则这些子群还要占据除了$e$外的$40(9-1)=320$个元素，实在是太多了。
    这说明$G$有两个Sylow $3$-子群$P,Q$使得$|P \cap Q|=3$。
    \item 简写$n=|C_G(H)|$，显然$C_G(H)$不是整个$G$ (不然$H$是$G$的正规子群)，
    由上一题的第一步有$|G|$整除$[G:C_G(H)]!$，得出$360/n\geqslant6$，即$n\leqslant60$；
    由于$9$阶群$P,Q$必定交换，可知两者是$C_G(H)$的子群，从而$9$整除$n$。

    接着，记$C_G(H)$的Sylow $p$-子群的数量为$s_p$。
    首先，$P,Q$都是$C_G(H)$的Sylow $3$-子群，从而$s_3>1$。
    接着，由Sylow定理，$s_3$模$3$余$1$且整除$n/9$继而整除$40$，则$s_3=4$或$10$或$40$。
    $s_3=10$或$40$的话$10$整除$n/9$，同$n\leqslant60$矛盾；因此$s_3=4$，推出$n=36$。

    这表明$C_G(H)/H$是$12$阶群，并且$P/H,Q/H$都是其Sylow $3$-子群，
    用第10题可知$C_G(H)/H \cong A_4$。假定$C_G(H)$的Sylow $2$-子群不正规，即$s_2>1$，
    商掉$H$后$A_4$就有不止$1$个Sylow $2$-子群，这当然是不可能的，
    因此$C_G(H)$有正规的Sylow $2$-子群$K$。
    \item 注意到$4$阶群$K$包含于$G$的某个Sylow $2$-子群$T$中且指数为$2$，
    从而$T$是$N_G(K)$的子群，那么$8$整除$|N_G(K)|$；
    $C_G(H)$也是$N_G(K)$的子群，从而$36$整除$|N_G(K)|$。
    结合两者得到$|N_G(K)|\geqslant72$；
    然而$N_G(K)$不是整个$G$ (不然$K$是$G$的正规子群)，这要求$|N_G(K)|\leqslant60$，矛盾。
    \item 由Sylow定理，$m_3$模$3$余$1$且整除$40$，则$m_3=4$或$10$或$40$。
    由于$G \to S_4$不能是单射，可知$m_3$不是$4$，
    并且前三问排除了$m_3=40$的可能性，因此$m_3=10$。\qedhere
    \end{enumerate}
\end{proof}
\end{enumerate}

\section{可解群,半直积及群的进一步讨论}

\begin{enumerate}
\item 请验证 (1.4) 式可导出合成群列 (1.5).
\item 证明有限 Abel 单群必是素数阶循环群.
\item 证明命题 9.4 中的映射 $f$ 是群同态.
\item 验证 ${\rm GL}_{3}(\mathbb{C})$ 中三阶可逆上三角形矩阵全体构成的子群是可解群.
\begin{proof}
    记$G_0$为${\rm GL}_3(\mathbb{C})$中的上三角阵全体构成的群，以及其子群
    \[G_1=\left\{\begin{pmatrix}1&*&*\\ &1&*\\ & &1\end{pmatrix}\right\},
    \quad G_2=\left\{\begin{pmatrix}1& &*\\ &1& \\ & &1\end{pmatrix}\right\},\]
    那么可以验证$G_0 \triangleright G_1 \triangleright G_2 \triangleright \{e\}$，并且
    \[G_0/G_1\cong\left\{\begin{pmatrix}*& & \\ &*& \\ & &*\end{pmatrix}\in{\rm GL}_3(\mathbb{C})\right\}, \quad G_1/G_2\cong\left\{\begin{pmatrix}1&*& \\ &1&*\\ & &1\end{pmatrix}\right\}\]
    都是交换群。这固然可以通过计算方阵的乘法来验证，不过会掩盖掉背后本质的原理。
    
    事实上，想到如上的$G_1,G_2$的真正理由在于，如果令
    \[V_0=\left\{\begin{pmatrix}*\\*\\*\end{pmatrix}\right\},
    \quad V_1=\left\{\begin{pmatrix}*\\*\\0\end{pmatrix}\right\},
    \quad V_2=\left\{\begin{pmatrix}*\\0\\0\end{pmatrix}\right\},
    \quad V_3=\left\{\begin{pmatrix}0\\0\\0\end{pmatrix}\right\}\]
    (其中引入$V_3$是为了后续的表述中能更好地保持队形)，再令$e$为单位方阵，则
    \begin{align*}
    (G_1-e)V_0&=\left\{\begin{pmatrix} &*&*\\ & &*\\ & & \end{pmatrix}\right\}\left\{\begin{pmatrix}*\\*\\*\end{pmatrix}\right\}=\left\{\begin{pmatrix}*\\*\\0\end{pmatrix}\right\}=V_1,\\
    (G_1-e)V_1&=\left\{\begin{pmatrix} &*&*\\ & &*\\ & & \end{pmatrix}\right\}\left\{\begin{pmatrix}*\\*\\0\end{pmatrix}\right\}=\left\{\begin{pmatrix}*\\0\\0\end{pmatrix}\right\}=V_2,\\
    (G_1-e)V_2&=\left\{\begin{pmatrix} &*&*\\ & &*\\ & & \end{pmatrix}\right\}\left\{\begin{pmatrix}*\\0\\0\end{pmatrix}\right\}=\left\{\begin{pmatrix}0\\0\\0\end{pmatrix}\right\}=V_3,\\
    (G_2-e)V_0&=\left\{\begin{pmatrix}\ &\ &*\\ & & \\ & & \end{pmatrix}\right\}\left\{\begin{pmatrix}*\\*\\*\end{pmatrix}\right\}=\left\{\begin{pmatrix}*\\0\\0\end{pmatrix}\right\}=V_2,\\
    (G_2-e)V_1&=\left\{\begin{pmatrix}\ &\ &*\\ & & \\ & & \end{pmatrix}\right\}\left\{\begin{pmatrix}*\\*\\0\end{pmatrix}\right\}=\left\{\begin{pmatrix}0\\0\\0\end{pmatrix}\right\}=V_3,\\
    \end{align*}
    换句话说，$G_1,G_2$中的元素在合适的子空间的商空间下其实是恒同映射，这才是其为正规子群的根源所在。
    
    下面避开矩阵的表述来重写一遍过程，这在变得更加抽象的同时，也成为了一个完全无需运算的做法。令
    \[\mathbb{C}^3=V_0 \supset V_1 \supset V_2 \supset V_3=\{0\}\]
    为一列子空间的降链，任何两个相邻空间的维数均相差$1$。考察
    \[G_0=\{g\in{\rm GL}(V_0) \mid g(V_1) \subset V_1,\,g(V_2) \subset V_2\}\]
    和同态
    \[\varphi_0:G_0\to{\rm GL}(V_0/V_1)\oplus{\rm GL}(V_1/V_2)\oplus{\rm GL}(V_2/V_3)\cong(\mathbb{C}^*)^3,\]
    $\varphi_0$把$G_0$中的元素$g$映成其在相应的空间上的限制兼商映射，从而
    \[\ker\varphi_0=\{g \in G_0\mid(g-e)(V_0) \subset V_1,\,(g-e)(V_1) \subset V_2,\,(g-e)(V_2) \subset V_3\}.\]
    接下来取$G_1=\ker\varphi_0$，再令同态
    \[\varphi_1:G_1\to{\rm GL}(V_0/V_1,V_1/V_2)\oplus{\rm GL}(V_1/V_2,V_2/V_3)\cong(\mathbb{C}^*)^2\]
    (其中非标准的记号${\rm GL}(V_i/V_{i+1},V_j/V_{j+1})$是指在对同构的线性空间
    \[V_i/V_{i+1} \cong V_j/V_{j+1} \cong \mathbb{C}\]
    三者不加区分时形成的$1$维一般线性群${\rm GL}(\mathbb{C})\cong\mathbb{C}^*$)，
    $\varphi_1$把$G_1$中的元素$g$映成其在相应的空间上的限制兼商映射，从而
    \[\ker\varphi_1=\{g \in G_1\mid(g-e)(V_0) \subset V_2,\,(g-e)(V_1) \subset V_3\}.\]
    最后取$G_2=\ker\varphi_1$，可知合成群列$G_0 \triangleright G_1 \triangleright G_2 \triangleright \{e\}$的每个商因子均交换，这是因为
    \[G_0/G_1\cong\operatorname{im}\varphi_0\cong(\mathbb{C}^*)^3,
    \quad G_1/G_2\cong\operatorname{im}\varphi_1\cong(\mathbb{C}^*)^2\]
    以及
    \[G_2\cong{\rm GL}(V_0/V_1,V_2/V_3)\cong\mathbb{C}^*.\qedhere\]
\end{proof}
\item 证明可解群的子群和商群还是可解群.
\begin{proof}
    设可解群$G$有子群$H$和可解群列
    \[G=G_0 \triangleright G_1 \triangleright\cdots\triangleright G_n=\{e\},\]
    那么
    \[H \triangleright H \cap G_1 \triangleright\cdots\triangleright H \cap G_n\]
    就是$H$的可解群列。这是因为对于同态
    \[\varphi:H \cap G_i \to G_i/G_{i+1}, \quad h \mapsto hG_{i+1}\]
    来说，有
    \[\ker\varphi=(H \cap G_i) \cap G_{i+1}=H \cap G_{i+1},\]
    得出商群$H \cap G_i/H \cap G_{i+1}$同构于交换群$G_i/G_{i+1}$的某个子群，从而亦交换。

    设可解群$G$有正规子群$N$和记号同上的可解群列，
    那么$G/N$可解是因为第一同构定理表明其有可解群列
    $G/N \triangleright G_1/N \triangleright\cdots\triangleright G_n/N$。
\end{proof}
\item 设 $G$ 是一个群, $N \triangleleft G$.若 $N$ 与 $G/N$ 都是可解群,证明 $G$ 是可解群.
\begin{proof}
    设$N$和$G/N$分别有可解群列
    \[N \triangleright N_1 \triangleright\cdots\triangleright N_m=\{e\}\]
    和
    \[G/N \triangleright G_1/N \triangleright\cdots\triangleright G_n/N=\{e\},\]
    那么第一同构定理表明
    \[G \triangleright G_1 \triangleright\cdots\triangleright G_n
    =N \triangleright N_1 \triangleright\cdots\triangleright N_m=\{e\}\]
    是$G$的可解群列。
\end{proof}
\item 设 $G$ 是有限群.
\begin{enumerate}[label=(\arabic*)]
\item 证明 $G$ 包含唯一的最大可解正规子群;
\item 若任取 $G$ 的子群 $A,B$,均有 $AB$ 是 $G$ 的子群,证明 $G$ 是可解群.
\end{enumerate}
\begin{proof}
    \begin{enumerate}[label=(\arabic*)]
    \item 关键在于如果$H,K$都是$G$的可解正规子群，那么$HK$也是$G$的可解正规子群。
    这是因为第二同构定理表明$HK$是$G$的子群且$HK/H \cong K/(H \cap K)$，
    通过上面两题可得$HK$是可解群，另外非常容易说明$HK$也是正规的。
    有了这个结论，设$H_1,\cdots,H_n$是$G$的所有可解正规子群，
    那么$H_1 \cdots H_n$同样是$G$的可解正规子群，由其构造显然是唯一最大的。
    \item 有个著名的定理是说$p$-群都是可解群。
    这是因为可以对其阶数进行归纳，记这个群为$P$，由1.7节例6有$|C(P)|>1$，
    从而按照归纳假设，阶数更小的$P/C(P)$就是可解群，
    而$C(P)$是交换的当然也可解，进而由上一题有$P$可解。
    回到本题，可以发现$G$的Sylow $p$-子群必然是唯一的，
    不然的话假如$G$有不同的Sylow $p$-子群$P$和$Q$，
    根据条件，$PQ$理应也是$G$的子群，可是$|PQ|=|P||Q|/|P \cap Q|>|P|$，
    即$PQ$是$G$的阶数更大的$p$-子群了，矛盾；
    那么由1.8节例6，$G$是其Sylow $p$-子群的直积，从而亦可解。\qedhere
\end{enumerate}
\end{proof}
\item 设 $G,H$ 是群, $\alpha : G \rightarrow H$ 是群同态,
设存在群同态 $\beta : H \rightarrow G$ 满足 $\alpha \circ \beta = \operatorname{id}_{H}$,
证明: $G = \operatorname{Ker} \alpha \rtimes \operatorname{Im} \beta$.
\begin{proof}
    $\operatorname{Ker}\alpha$是$G$的正规子群是显然的，
    $\operatorname{Ker}\alpha\cap\operatorname{Im}\beta=\{e_G\}$也是容易的，
    因为如果$\beta(h)$满足$\alpha(\beta(h))=e_H$，那么$h=e_H$，从而$\beta(h)=e_G$。
    由于$\alpha(g)=\alpha(\beta(\alpha(g)))$，
    得到$g\,\big(\beta(\alpha(g))\big)^{-1}\in\operatorname{Ker}\alpha$，
    从而通过$G$中的元素$g$能写成$g\,\big(\beta(\alpha(g))\big)^{-1}$
    和$\beta(\alpha(g))$的乘积得出$G=\operatorname{Ker}\alpha\,\operatorname{Im}\beta$。
\end{proof}
\item 求解下列问题:
\begin{enumerate}[label=(\arabic*)]
\item 给定群 $N,H$ 及群同态 $f: H \rightarrow \operatorname{Aut}(N)$, $f(x) = f_x$.
在 $N \times H$ 上定义二元运算 $(x_1 , y_1)(x_2 , y_2) = (x_1 f_{y_1}(x_2), y_1 y_2)$,
证明 $N \times H$ 在此运算下构成一个群,称为 $N$ 与 $H$ 关于 $f$ 的外半直积,记作 $N \rtimes_{f} H$;
\item 仿照 1.6 节关于内外直积结构的讨论,说明外半直积结构和本节正文定义的半直积结构一致.
\end{enumerate}
\begin{proof}[解答]
    \begin{enumerate}[label=(\arabic*)]
    \item 为了简化符号，把群$N,H$的单位元皆写成$e$ (尽管严格来说要用$e_N,e_H$来区分开)。首先，由于
    \begin{align*}
        (x,y)(e,e)=(xf_y(e),ye)=(x,y),\\
        (e,e)(x,y)=(ef_e(x),ey)=(x,y),
    \end{align*}
    得出$(e,e)$是$N\rtimes_fH$的单位元。接着，$(x,y)$的逆元是$\big(f_{y^{-1}}(x^{-1}),y^{-1}\big)$，这是因为\begin{align*}
        (x,y)\big(f_{y^{-1}}(x^{-1}),y^{-1}\big)&=\big(xf_y(f_{y^{-1}}(x^{-1})),yy^{-1}\big)=(e,e),\\
        \big(f_{y^{-1}}(x^{-1}),y^{-1}\big)(x,y)&=\big(f_{y^{-1}}(x^{-1})f_{y^{-1}}(x),y^{-1}y\big)=(e,e).
    \end{align*}
    再来验证结合律，即
    \begin{align*}
        \big[(x_1,y_1)(x_2,y_2)\big](x_3,y_3)&=\big(x_1f_{y_1}(x_2),y_1y_2\big)(x_3,y_3)
        =\big(x_1f_{y_1}(x_2)f_{y_1y_2}(x_3),y_1y_2y_3\big),\\
        (x_1,y_1)\big[(x_2,y_2)(x_3,y_3)\big]&=(x_1,y_1)\big(x_2f_{y_2}(x_3),y_2y_3\big)
        =\big(x_1f_{y_1}(x_2f_{y_2}(x_3)),y_1y_2y_3\big).
    \end{align*}
    \item 设$G=N \rtimes H$是$N$和$H$的半直积，对于命题9.4中的同态
    \[f:H\to\operatorname{Aut}(N), \quad y \mapsto r_y(x)=yxy^{-1},\]
    映射
    \[\varphi:N\rtimes_fH \to G,\quad(x,y) \mapsto xy\]
    是同构，这是因为显然$\varphi$是双射，只需再检验$\varphi$是同态，即
    \begin{align*}
        &\varphi(x_1,y_1)\varphi(x_2,y_2)=(x_1y_1)(x_2y_2)\\
        &=x_1\big(y_1x_2y_1^{-1}\big)y_1y_2=x_1r_{y_1}(x_2)y_1y_2\\
        &=\varphi(x_1r_{y_1}(x_2),y_1y_2)=\varphi((x_1,y_1)(x_2,y_2)),
    \end{align*}
    从而半直积在上述意义下成为了外半直积。
    
    反过来，外半直积亦可视为半直积，换句话说$N\rtimes_fH$有
    同构于$N$的正规子群$\underline{N}$和同构于$H$的子群$\underline{H}$，使得
    \[\underline{N}\cap\underline{H}=\{e\},
    \quad\underline{N}\underline{H}=N\rtimes_fH.\]
    事实上，令
    \[\underline{N}=\{(x,e) \mid x \in N\},
    \quad\underline{H}=\{(e,y) \mid y \in H\},\]
    通过
    \[(x_1,e)(x_2,e)=(x_1x_2,e),\quad(e,y_1)(e,y_2)=(e,y_1y_2)\]
    可知$\underline{N}$是同构于$N$的子群且$\underline{H}$是同构于$H$的子群。
    要说明$\underline{N}$正规，只需发现对于投影
    \[\pi:N\rtimes_fH \to H,\quad(n,h) \mapsto h\]
    有$\underline{N}=\ker\pi$。
    显然有$\underline{N}\cap\underline{H}=\{(e,e)\}$，最后
    \[(x,e)(e,y)=(x,y)\]
    说明$\underline{N}\underline{H}=N\rtimes_fH$。
    本质上这就把$f$变成了$\underline{H}$在$\underline{N}$上的共轭作用，这是因为
    \[(e,y)(x,e)(e,y)^{-1}=(f_y(x),y)(e,y^{-1})=(f_y(x),e).\qedhere\]
    \end{enumerate}
\end{proof}
\item 设 $G$ 是由两个元素 $x,y$ 生成的群,且 $x,y$ 满足下列关系式:
\[x^8 = x^4 y^2 = xy^{-1}xy = e,\]
$e \in G$ 为恒等元.证明 $|G| \leqslant 16$.
\begin{proof}
    $G$中的元素都形如$x^ay^bx^cy^d\cdots$，其中$a,b,c,d,\cdots$是整数。通过
    \begin{align*}
        y^{-1}x^k&=(y^{-1}x^ky)y^{-1}=(y^{-1}xy)^ky^{-1}=x^{-k}y^{-1},\\
        yx^k&=y^2(y^{-1}x^k)=x^4(x^{-k}y^{-1})=x^{4-k}y^{-1}
    \end{align*}
    把出现在$x^k$左边的$y^{\pm1}$一个个挪到右边去，那么$G$中元素就形如$x^my^n$了；
    再把$y^{\pm2}$换成$x^4$，最后把$x^{\pm8}$消掉，
    可以限定$n=0,1$和$m=0,1,\cdots,7$。因此$|G|\leqslant2\cdot8=16$。
\end{proof}
\item $1183$ 阶群是否一定是交换群?说明理由.
\begin{proof}[解答]
    不一定。令$V$为$2$维$\mathbb{F}_{13}$-向量空间，视作$13^2$阶加法群，
    那么$\operatorname{Aut}(V)$就是${\rm GL}_2(\mathbb{F}_{13})$，
    这个群的阶是$(13^2-1)(13^2-13)$ (参考2.8节例9或3.7节习题8的解答)，
    由Cauchy定理知其中有$7$阶元$a$，
    则外半直积$V\rtimes\langle a \rangle$是$1183=13^2\cdot7$阶非交换群。
\end{proof}
\item 设群 $G = \langle x,y \mid x^5 = y^4 = e , yx = x^2 y \rangle$,
即由两个元素 $x,y$ 在关系 $yx = x^2 y$ 下生成的群.求解下列问题:
\begin{enumerate}[label=(\arabic*)]
\item 证明 $G$ 是其两个真子群的半直积;
\item 求出 $G$ 的所有子群.
\end{enumerate}
\begin{proof}[解答]
    这个群常称为 \href{https://groupprops.subwiki.org/wiki/General_affine_group:GA(1,5)}{$20$阶Frobenius群}，更多性质参考蓝色的链接。

    (1) 易知$G$是其$5$阶子群$\langle x \rangle$和$4$阶子群$\langle y \rangle$的半直积。
    直观地看，$G$其实是$\mathbb{F}_5$上的$1$阶可逆仿射变换全体在复合运算下构成的群，记为
    \[{\rm AGL}(1,\mathbb{F}_5)=\big\{f(t)=at+b \mid a\in\mathbb{F}_5^*,b\in\mathbb{F}_5\big\},\]
    其中$x$对应于$x(t)=t+1$，$y$对应于$y(t)=2t$，相应地，$yx=x^2y$就是
    \[(y \circ x)(t)=(x \circ x \circ y)(t)=2t+2.\]
    
    (2) $G$中的元素可按阶分类为
    \[\begin{array}{|c|c|c|c|}
        \hline \text{阶数} & \text{元素} & \text{对应的仿射变换} & \text{数目}\\
        \hline 1 & e & \!\!\!\!\!\!e(t)=t & 1\\ \\
        2 & \ \ x^by^2\ (b\in\mathbb{F}_5) & x^by^2(t)=-t+b & 5\\ \\
        4 & x^by^{\pm1}\ (b\in\mathbb{F}_5) & x^by^{\pm1}(t)=\pm2t+b & 10\\ \\
        5 & \ \ \ \ \ \ x^b\ (b\in\mathbb{F}_5^*) & \,x^b(t)=t+b & 4\\
    \hline\end{array}\]
    容易说明，对于$G$的子群$H$来说，
    \begin{itemize}
        \item 如果$H$含有$x$，那么$H$是$5$阶循环群$\langle x \rangle$或二面体群$\langle x,y^2 \rangle$或者是$G$本身，
        \item 如果$H$不含$x$，那么$H$是$4$阶循环群$\langle x^by \rangle$或$2$阶循环群$\langle x^by^2 \rangle$或者是$\{e\}$，
    \end{itemize}
    其包含关系可用下图表示
    \[\begin{cd}
    & G \ar[dl,dash]\ar[dr,dash] &\\
    \langle x^by \rangle\cong\Z_4 \ar[dd,dash] & & \langle x,y^2 \rangle \cong D_5 \ar[dd,dash]\\ \\
    \langle x^{3b}y^2 \rangle\cong\Z_2 \ar[uurr,dash] & & \langle x \rangle\cong\Z_5\\
    & \{e\} \ar[ul,dash]\ar[ur,dash] &
    \end{cd}\]
    其中$b\in\mathbb{F}_5$，且
    \[(x^by)^2=x^b\big(yx^b\big)y=x^b\big(x^{2b}y\big)y=x^{3b}y^2,\]
    共有$5\cdot2+4=14$个子群。
\end{proof}
\item 设 $G$ 为 $105$ 阶群,证明:
\begin{enumerate}[label=(\arabic*)]
\item $G$ 是可解群;
\item $G$ 有一个正规 Sylow $7$-子群和一个正规 Sylow $5$-子群.
\end{enumerate}
\begin{proof}
    \begin{enumerate}[label=(\arabic*)]
    \item 由第8节习题7，$G$有正规的Sylow $7$-子群$R$，
    那么$G/R$是$15$阶群，同第8节习题1可得$15$阶群为循环群，从而$G$可解。
    \item 设$Q$是$G$的一个Sylow $5$-子群，只需说明$Q$是正规子群即可。
    注意到$QR$是$G$的指数为$3$的子群，由第7节习题4得到$QR$正规，
    并且第8节习题1表明这个$35$阶群是循环群，
    记其生成元为$a$，那么其$5$阶子群$Q$就是由$a^7$生成的。
    由于对于$g \in G$有$ga^7g^{-1}=(gag^{-1})^7$，
    其中$gag^{-1} \in QR$，得出$(gag^{-1})^7 \in Q$，这说明$Q$正规。\qedhere
    \end{enumerate}
\end{proof}
\item 设 $p,q$ 为互异素数,利用 Sylow 定理和群的半直积理论分类 $pq$ 阶群.
\begin{proof}[解答]
    不妨设$p<q$，由Sylow定理$m_q$整除$p$且模$q$余$1$，则$m_q=1$，
    即$G$有个正规的$q$阶子群$Q$。记$P$为$G$的一个$p$阶子群，
    那么$P,Q$就能生成整个$G$，从而$G$的结构可以由$P$在$Q$上的共轭作用
    \[\theta:P\to\operatorname{Aut}(Q), \quad h\mapsto\theta_h(g)=h^{-1}gh\]
    唯一决定。由于$q$阶循环群$Q$的自同构群同构于$(\Z_q)^*\cong\Z_{q-1}$，
    可知当$p$不整除$q-1$时$\theta$只能把整个$P$映成$\{e\}$，
    因此$G \cong P \times Q$；下面设$p$整除$q-1$。
    
    这时，在同构的意义下$\theta$就是加法群$\Z_p\to\Z_{pk}$的同态，
    其中$k=(q-1)/p$，映射$\theta$只取决于$\theta([1])$，
    唯一需要满足的条件是$\theta([p])=[0]$，即$pk$整除$p\theta([1])$，
    也就是说$\theta([1])=jk$，其中$j=0,1,\cdots,p-1$。
    不过这并不意味着$G$就有$p$种不同的结构：

    * $j=0$时，$G$依然是$P,Q$的直积；
    * $j=1$时，$G$是$P,Q$的半直积；
    * $j=2,\cdots,p-1$时，$P\cong\Z_p$的生成元可以改为$[j]$，
    从而$P,Q$的半直积同构于$j=1$的情形。
    
    总之，当$p$整除$q-1$时$G$有$2$种群结构。
\end{proof}
\end{enumerate}

