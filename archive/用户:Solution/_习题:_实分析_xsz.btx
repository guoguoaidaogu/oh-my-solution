\begin{4}
用区间运算表达标准$3$进制小数表示中含数字$1$的$x \in [0, 1) $全体$A$和$3$进制小数表示中不含数字$1$的$x \in (0, 1) $全体$B$（如$0.1=0.022\cdots$和$0.122\cdots=0.2$不含$1$）.
\end{4}
\begin{solution}
对于标准三进制表示$x = (0.a_1a_2\cdots)_3 (\forall n,  \exists i \geqslant n : a_i \neq 2)$,

$x \in A \iff (\exists n:a_n=1)\land (\forall i<n:a_i\neq1)$,

即$x \in [0.a_1 \cdots a_{n-1}1, 0.a_1 \cdots a_{n-1}2)$,

所以$A=\coprod\limits_{n \geqslant 1}\coprod\limits_{a_i \neq 1}[0.a_1 \cdots a_{n-1}1, 0.a_1 \cdots a_{n-1}2)$,


$x\in (0, 1)\setminus B \iff x$有个$3$进制小数表示含数字$1$,

但由约定, $\exists n:0.a_1 \cdots a_{n-1}1<x<0.a_1 \cdots a_{n-1}2$ $(a_i\neq 1)$,

所以$(0, 1)\setminus B=\coprod\limits_{n \geqslant 1}\coprod\limits_{a_i \neq 1}(0.a_1 \cdots a_{n-1}1, 0.a_1 \cdots a_{n-1}2)$,

由此$B=(0, 1)\setminus\coprod\limits_{n \geqslant 1}\coprod\limits_{a_i \neq 1}(0.a_1 \cdots a_{n-1}1, 0.a_1 \cdots a_{n-1}2)$.
\end{solution}


\subsection{二元关系}
\begin{2}
证明： $f_{\bullet}$可逆当且仅当$f$可逆.

\end{2}

\begin{solution}
充分性显然,因此只证必要性.

$f$是单射：$f(x_1)=f(x_2)$时, $f_{\bullet}(\{x_1\})=f_{\bullet}(\{x_2\})$, 故$\{x_1\}=\{x_2\}$, $x_1=x_2$,

$f$是满射：对于$y\in Y$, 设$f_{\bullet}(A)=\{y\}$, 则$x\in A$使得$f(x)=y$.
\end{solution}

\begin{3}
证明： $f^{\bullet}$可逆当且仅当$f$可逆.
\end{3}
\begin{solution}
只证必要性.

$f$是满射：设$f^{\bullet}(\{y\})=A$, 又$f^{\bullet}(\varnothing)=\varnothing$, 故$A\neq \varnothing$, 从而$x\in A$使$f(x)=y$,

$f$是单射：要证$A$是单点集.当$A$有分解$A_1\uplus A_2$时, $A_i=f^{\bullet}(B_i)$, 
由$\varnothing=A_1 \cap A_2=f^{\bullet}(B_1 \cap B_2)$及$f$的满性可知, 
$B=\varnothing$.又$f^{\bullet}(B_1 \uplus B_2)=$$f^{\bullet}(B_1 )\uplus f^{\bullet}(B_2)=A=f^{\bullet}(\{y\})$, 
故$\{y\}=B_1 \uplus B_2$, 可设$B_2=\varnothing$, 则$A_2=\varnothing$, 可见$A$只含一点$x$.
\end{solution}


\begin{6}
形式地命$A(m, n)=\{[a_{ij}]_{m\times n}|a_{ij}\in A\}$且$A(n)=A(n, n)$. 
当$A$是个环且有幺元 $1$ 时, 某个$x\in A(m, n)$可逆指有个$y\in A(n, m)$使$xy$和$yx$各是$m$阶幺阵 $1_m$和$n$ 阶幺阵$1_n$. 
将$n$阶可逆阵全体记为$\mathrm{GL}_n(A)$. 称方阵$a$和$b$相似指有可逆阵$x$使$xax^{-1}=b$.

(1)设$n$阶方阵$p$是幂等阵(即$p^2=p)$, 则$p^\perp:=1_n-p$也是幂等的.

(2)（任意阶）幂等阵全体$E$上有等价关系使$p \sim q$表示有矩阵$u$和$v$使得$vu=p$且$uv=q$.此时可要求$u=up=qu$且$v=pv=vq$.

(3)两个幂等阵$p$与$q$相似当且仅当$p \sim q$且$p^{\perp}\sim q^{\perp}$.
\end{6}
\begin{solution}

(2)$vu=p$且$uv=q$时, 令$v_1=pvq, u_{1}=qup$,
则$v_{1}u_{1}=pvq^{2}up=pvuvup=p^4=p$, $u_{1}v_{1}=qup^{2}vq=quvuvq=q^{4}=q$,

又$pv_{1}=p^{2}vq=pvq=v_{1}, v_{1}q=pvq^{2}=pvq=v_1$,

类似知$qu_{1}=u_{1}=u_{1}p$.以$u_{1}v_{1}$各替代$u, v$即可.

(3)必要性：设$xpx^{-1}=q$, $q$为$n$阶的, 则$(xp)(px^{-1})=q$, $(px^{-1})(xp)=p$, $p \sim q$.又$xp^{\perp}x^{-1}=q^{\perp}$, 故$p^{\perp}\sim q^{\perp}$,

充分性：设$vu=p, uv=q, v=pvq, u=qup.$

$v^{\prime}u^{\prime}=p^{\perp}, u^{\prime}v^{\prime}=q^{\perp}, v^{\prime}=p^{\perp}v^{\prime}q^{\perp}, u^{\prime}=q^{\perp}u^{\prime}p^{\perp}. $

令$x=u+u^{\prime}$且$y=v+v^{\prime}$, 则
$$xy=uv+uv^{\prime}+u^{\prime}v+u^{\prime}v^{\prime}=
q+0+0+q^{\perp}=1_m. $$

类似知$yx=1_n$, 又
$xpy=\left(up+u^{\prime}p\right)\left(v+v^{\prime}\right)$
$=upv+upv^{\prime}=uv=q.$

$uv^{\prime}=upp^{\perp}v^{\prime}=0, u^{\prime}v=0, vu^{\prime}=0, v^{\prime}u=0.$

$u^{\prime}p=u^{\prime}p^{\perp}p=0, pv^{\prime}=pp^{\perp}v^{\prime}=0.$

\end{solution}

\begin{10}用Zorn引理证明线性空间$X$的线性集$L$都有个线性补$M$
（它是线性集使$L\cap M=\{0\}$且$X=L+M$.此时记$X=L\oplus M$）, 它不必唯一.
\end{10}

\begin{solution}
令$\mathfrak{M}=\{\text{线性集 }N\subseteq X\mid L\cap N=\{0\}\}$, 
它依“$\subseteq$”为偏序集, 所找$M$应是$\mathfrak{M}$中极大成员.

任取$\mathfrak{M}$的全序子集$\mathfrak{N}$, 令$N_{0}=\bigcup_{N\in \mathfrak{N}}N$.
对于$x_{i}\in N_{0}$及$a_i\in\mathbb{K}$, 有$N_{i}\in \mathfrak{N}$使得$x_i\in N_i.$可设$N_1\subseteq N_2$, 故$x_1a_1+x_2a_2\in N_1+N_2 \subseteq N_2.$

又$L\cap N_0=\bigcup\{L\cap N | N\in \mathfrak{N}\}$$=\bigcup\{\{0\}| N\in \mathfrak{N}\}$$=\{0\}.$故$N_0 \in \mathfrak{M}$是$\mathfrak{N}$的一个上界.

用Zorn引理得$\mathfrak{M}$的一个极大成员$M.$若$X\neq L+M$, 取$x_1\in X\setminus (L+M).$令$M_1=M+x_1\mathbb{K}  .$诸$x\in L\cap M_1$形如$x^{\prime}+x_1a$使$x^{\prime}\in M, a\in \mathbb{K}.$若$a\neq 0$, 则$X_1=\frac{x-x^{\prime}}{a}\in L-M=L+M_1$, 矛盾, 故$a=0$, $x\in L\cap M=\{0\}.$因此$M_1\in \mathfrak{M}$, 与$M$的最大性矛盾.

在$\mathbb{K}^2$中, 令$L=\mathbb{K}\times\{0\}$, $M_a=[a, 1]^T\mathbb{K}(a\in\mathbb{K})$, 则$\mathbb{K}^2=L\oplus M_a$, $a\neq a^{\prime}$, 所以$M_a\neq M_{a^{\prime}}$
\end{solution}


\subsection{基数算术}
\begin{1}
证明以下各集可列：

(1)有理系数多项式环$\mathbb{Q}[x]$.系数为有理数的有理函数域$\mathbb{Q}(x).$
\end{1}
\begin{solution}
$\mathbb{Q}(x)=\{\frac{f(x)}{g(x)}\vert f(x), g(x)\in\mathbb{Q}[x], g\neq0\}=\{\frac{f(x)}{g(x)}|f(x), g(x)\in\mathbb{Z}[x], f$与$g$互素, $g$的首系数$>0\}$

令$A=\{(f(x), g(x))|f(x), g(x)\in\mathbb{Z}[x]\text{ 互素}, g(x)\text{ 的首系数}>0\}$, 
那么$\mathbb{Z}[x]\times\{1\}\subset A\subset\mathbb{Z}[x]\times\mathbb{Z}[x]$, 
因$\mathbb{Z}[x]$可列, 故 $A$可列, 
从$A$到$\mathbb{Q}(x)$有双射$(f(x), g(x))\mapsto f(x)/g(x)$, 因此$\mathbb{Q}(x)$可列.
\end{solution}


\begin{4}
以下陈述是否正确？对于错误者, 请举反例.

(1)如果$A\simeq B, C\simeq D$且$A\subset C, B\subset D$, 则$C\setminus A\simeq D\setminus B.$

(2)如果$A\simeq B$且$A\cup B\subset C$, 则$C\setminus A\simeq C\setminus B$

(3)如果$A\simeq B$且$C\subseteq A\cap B$, 则$A\setminus C\simeq B\setminus C.$

(4)如果$A\times B\simeq A\times C$或$B^A\simeq C^A$或$A^B\simeq A^C$, 则$B\simeq C.$

(5)可数集$X$上有个偏序$\preceq$使$X$的非空子集都有最小元.
   \end{4}
\begin{solution}
(1)$\times$
(2)$\times$
(3)$\times$
(4)$\times$:令$A=\varnothing, B=\{1\}, C=\{1, 2\}$, 
则$A\times B\simeq A\times C$, $B^{A}\simeq  C^{A}$, 
$\varnothing =A^{B}\simeq A^{C}=\varnothing$, 但$B\ncong  C$.

(5)存在单射$f:X\rightarrow \mathbb{N}$, 因此可以定义$X$上偏序：$x\leq x^{\prime}$表示$f(x)\leq f(x^{\prime})$. 
对于$\varnothing\neq S\subseteq X$, $f(S)(\subseteq \mathbb{N})$有最小数$f(x_0)$, 故$x_0$是$S$的最小元.
\end{solution}

\begin{5}
求以下集合的基数:

(1) $10$进制有限小数全体, $10$ 进制无限小数全体和 $10$ 进制无限循环小数全体.

(2) $10$进制无限小数中没有数字 $7$ 的小数全体和有数字 $7$ 的小数全体.

(3) 严格递增的正整数列全体与严格递减的有理数列全体.

(4) 至少有两项不同的序列$(x_n)_{n\geqslant1}$的子列全体$\{(x_{k_n})_{n\geqslant1}|1\leqslant k_1<k_2<\cdots\}.$

(5)连续函数 $f:\mathbb{R}\to\mathbb{R}$ 全体和连续函数列 $(f_n:\mathbb{R}\to\mathbb{R})_n\geqslant1$ 全体.

(6) 实系数多项式全体和系数为超越数的多项式全体.

(7) 连续统的有限子集全体与可列子集全体.
\end{5}

\begin{solution}

(3) $A=\{(k_{n\geqslant1})|k_n\in \mathbb{Z}_+, k_1<k_2<\cdots\}$

令$A_1=\{(k_{n\geqslant1})|k_n\in \mathbb{Z}_+\}=\mathbb{Z}_+^{\mathbb{Z}_+}$

从$A$至$A_1$有个双射$(k_{n\geqslant1})\mapsto(k_1, k_2-k_1, \cdots, k_n-k_{n-1}, \cdots)$, 故$|A|=|A_1|=\aleph_0^{\aleph_0}=\aleph.$

(5) $C(\mathbb{R}, \mathbb{R})=\{$连续$f:\mathbb{R}\rightarrow\mathbb{R}\}$

它至$\mathbb{R}^{\mathbb{Q}}=\{$函数$g:\mathbb{Q}\rightarrow\mathbb{R}\}$有个单射$f\rightarrow f|_{\mathbb{Q}}.$

$f_1|_{\mathbb{Q}}=f_2|_{\mathbb{Q}}$时, 任取$x\in \mathbb{R}$, 有列$x_n\in\mathbb{Q}$趋近于$x$.

由$f_{1}(x_{n})=f_{2}(x_{n})$得$f_{1}(x)=f_{2}(x)$,
因此$|C(\mathbb{R}, \mathbb{R})|\leqslant|\mathbb{R}^{\mathbb{Q}}|=\aleph^{\aleph_0}=\aleph.$

又由$C(\mathbb{R}, \mathbb{R})\supseteq\{a+\exp|a\in\mathbb{R}\}$知$|C(\mathbb{R}, \mathbb{R})|\geqslant|\mathbb{R}|=\aleph.$

可见$|\{(f_{n\geqslant1})|f_{n}\in C(\mathbb{R}, \mathbb{R})\}=C(\mathbb{R}, \mathbb{R})^{\mathbb{Z}_+}|=\aleph^{\aleph_0}=\aleph.$

(6)令$A=\left\{\sum\limits_{n\geqslant0}a_{n}x^{n}\Big|a_{n}\in\mathbb{R}, \left\{n|a_{n}\neq 0\right\}\text{有限}\right\}$,

$A$至$\mathbb{R}^{\mathbb{N}}$有个单射$\sum\limits_{n\geqslant0}a_{n}x^{n}1\mapsto(a_{n\geqslant0})$, 故$|A|\leqslant\aleph^{\aleph_0}=\aleph.$

又$A\supseteq\mathbb{R}$, 故$|A|\geqslant\aleph$.

(7)
$F_{1}=\{\text{有限 }A\subseteq \mathbb{R}\}=\{\{x_{1}<\cdots<x_{n}\}|x_{k}\in \mathbb{R}, n\geqslant 1\}$,

$F=\{\text{有限 }A\subset \mathbb{R} \}=F_1\cup\{\varnothing\}$.

有单射$F_1\to\mathbb{R}^{\mathbb{Z}_+}:\{x_1<\cdots<x_n\}\mapsto(x_1, \cdots, x_n, x_n, \cdots)$, 从而$|F_1|\leqslant\aleph^{\aleph_0}=\aleph.$

又由$F_1\supseteq\{\{x\}|x\in \mathbb{R}\}$知$|F_1|\geqslant\aleph$, 可见$|F|=|F_1|+1=\aleph+1=\aleph$.

令$G=\{\text{可列集 }A\subset\mathbb{R}\}$, 从$\mathbb{R}^{\mathbb{N}}\to A$有个满射$(x_{n\geqslant 0})\mapsto\{x_{n\geqslant0}\}$, 从而$|G|\leqslant\aleph^{\aleph_0}=\aleph$.

又$G\supseteq\{a+\mathbb{Z}|0<a<1\}$, 故$|G|\geqslant \aleph$. 所以$|G|=\aleph$.
\end{solution}

\begin{8}
Euclid 空间$\mathbb{R}^n$ 共有多少个开集? 多少个闭集? 多少个紧集?
\end{8}   
\begin{solution}
令$T=\left\{\text{开集 }B\subseteq \mathbb{R}^{n}\right\}$, 且$\psi(B)=\left\{\left(x,r\right)\in\left(\mathbb{Q}^{n}\times \mathbb{Q}_{+}\right)|O(x,r)\subseteq B\right\}$,

则$B=\bigcup\left\{O(x,r)\right|\left(x,r\right)\in\psi(B)\}$,

$\forall x^{\prime}\in B,\exists r^{\prime}>0:O(x^{\prime},r^{\prime})\subseteq B$
$;\exists x\in\mathbb{Q}^{n},r\in\mathbb{Q}_+:|x^{\prime}-x|<r\leqslant\frac{r^{\prime}}{2}$

故$x^{\prime}\in O(x,r)\subseteq O(x^{\prime},r^{\prime})\subseteq B$.

可见$\psi:T\to 2^{\mathbb{Q}^n\times\mathbb{Q}_+}$是个单射,从而$|T|\leqslant 2^{\aleph_0^n\aleph_0}=2^{\aleph_0}=\aleph.$

又$T\supseteq\{O(x,1)|x\in\mathbb{R}^n\}$,则$|T|\geqslant\aleph$, 所以$|T|=\aleph$.
\end{solution}

\begin{10}
将$\mathbb{R}$自然地视为$\mathbb{Q}$上线性空间,求其维数.
以$M$记$\mathbb{Q}$-线性函数$f:\mathbb{R}\to\mathbb{Q}$
依通常如法与数乘所成的$\mathbb{Q}$上线性空间,求其维数.
   \end{10}
\begin{solution}
首先, $|\mathbb{Q}|\leqslant \dim_{\mathbb{Q}}\mathbb{R}$, 
否则$\mathbb{R}$是有限维$\mathbb{Q}$-线性空间,即$\mathbb{R}\simeq\mathbb{Q}^n(n\in\mathbb{Z}_+),|\mathbb{R}|=\aleph_0^n=\aleph_0,$矛盾.

其次, $\dim_{\mathbb{Q}}\mathbb{R}=|\mathbb{R}|=\aleph.$

令$M=\{$有理线性$f:\mathbb{R}\to\mathbb{Q}\},$则$|\mathbb{Q}|\leqslant\dim_{\mathbb{Q}}M.$故$\dim_{\mathbb{Q}}M=|M|.$

取$\mathbb{R}$的一个基$B$, 诸$f\in\mathbb{R}$由$f|_B$唯一确定.故$M$至$\mathbb{Q}_B$有个双射$f\mapsto f|_B.$

从而$|M|=\aleph_0^{|B|}=\aleph_0^{\dim_{\mathbb{Q}}\mathbb{R}}=\aleph_0^{\aleph}=2^{\aleph}.$

\end{solution}

