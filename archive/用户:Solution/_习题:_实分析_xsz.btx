\begin{4}
函数$f:[a,b]\to\mathbb{R}$是下凸函数当且仅当$(\overline Df)(x_1)\leqslant(\underline{D}f)(x_2)$在$x_1<x_2$时成
立. 进而,连续下凸函数$f:[a,b]\to\mathbb{R}$都是绝对连续函数.
  \end{4} 
\begin{solution}
 必要性：
下凸$\iff \forall x_1<x_0<x_2,$有$\Delta(x_1,x_0)\leqslant\Delta(x_2,x_0)$. (这里$\Delta(x,y)=\frac{f(x)-f(y)}{x-y})$

$(\overline D f)(x_1)=D^+f(x_1)\lor D^-f(x_1)=\varlimsup\limits_{\hat{x}\to x_1+}\Delta(x_1,\hat{x})\lor\varlimsup\limits_{\hat{x}\to x_1-}\Delta(x_1,\hat{x})$

$(\underline D f)(x_2)=D_+f(x_2)\lor D_-f(x_2)=\varliminf\limits_{\hat{x}\to x_2+}\Delta(x_2,\hat{x})\lor\varliminf\limits_{\hat{x}\to x_2-}\Delta(x_2,\hat{x})$

由于函数下凸,不难看出$(\overline D f)(x_1)=D^+f(x_1),(\underline D f)(x_2)=D_-f(x_2).$

令$x_0$分别靠近$x_1+,x_2-$,得到$D^+f(x_1)\leqslant \Delta(x_1,x_2)\leqslant D_-f(x_2)$,得证.

充分性:令$g=f+\epsilon x^2(\epsilon>0)$,

则有$(\overline D g)(x_1)=2x_1+(\overline D f)(x_1)$,
$(\underline D g)(x_2)=2x_2+(\underline D f)(x_2)$,

所以$(\overline D g)(x_1)<(\underline D g)(x_2).$

反设$g$不是下凸的,则存在$x_0\in(a,b)$满足$\frac{g(x_0)-g(a_0)}{x_0-a_0}>\frac{g(x_0)-g(b_0)}{x_0-b_0}$. (之后都用$a_0,b_0$来表示$a,b)$

取$c_0$为$a_0,x_0$的中点,则有

\begin{align*}
    LHS&=\frac{g(x_0)-g(c_0)+g(c_0)-g(a_0)}{x_0-a_0}\\
    &=\frac{g(x_0)-g(c_0)}{x_0-a_0}+\frac{g(c_0)-g(a_0)}{x_0-a_0}\\
    &\leqslant 2\max \left\{\frac{g(x_0)-g(c_0)}{x_0-a_0},\frac{g(c_0)-g(a_0)}{x_0-a_0}\right\}\\
    &\overset{\rm def}{=}2\cdot\frac{g(c_1)-g(a_1)}{c_1-a_1}
    \qquad\text{(这里用 }[a_1,c_1]\text{ 代替那个较大的区间.)}
\end{align*}

同理,取$d_0$为$x_0,b_0$的中点,则有

\begin{align*}
    RHS&\geqslant 2\min \left\{\frac{g(x_0)-g(d_0)}{x_0-d_0},\frac{g(d_0)-g(b_0)}{d_0-b_0}\right\}\\
    &\overset{\rm def}{=}2\cdot\frac{g(d_1)-g(b_1)}{d_1-b_1}
    \qquad\text{(这里用 }[d_1,b_1]\text{ 代替那个较小的区间.)}
\end{align*}

两边重复取中点,取斜率较大（小）的二分区间代替整个区间,如此重复下去,
由闭区间套定理,两边的闭区间套各有唯一极限点$c,d$,
使得$(\overline D g)(c)<(\underline D g)(d)$(注意这里极限有上下的区分),
由此,与假设矛盾.因此$f$应当是下凸函数.

绝对连续:事实上,下凸性质使得存在某个$\delta>0$满足$|f(y)-f(x)|<\delta|y-x|$,进一步结合连续性便可得到绝对连续性,请自行证明.
\end{solution}

\subsection{非匀测度}
  {4.3.7}

   
\begin{solution}

\end{solution}