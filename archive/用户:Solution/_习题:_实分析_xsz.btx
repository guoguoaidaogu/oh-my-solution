\begin{6}
设概率空间$(X,\mu)$上实值可测函数$f$使$\sup f(X)<+\infty$,证明:
\begin{equation*}
    \lim_{p\to0+}\|\exp f\|_{p}=\exp\left(\int_{X}fd\mu\right).
\end{equation*}
   \end{6}
\begin{solution}

    \begin{align*}
        LHS&= \lim_{p\to 0^+} \left(\int_X(\exp f)^pd\mu\right)^{\frac{1}{p}}\\
        &= \lim_{p\to 0^+} \left(\int_X\left(1+f+o(f)\right)^pd\mu\right)^{\frac{1}{p}}\\
        &= \lim_{p\to 0^+} \left(\int_X(1+pf+o(f))d\mu\right)^{\frac{1}{p}}\\
        &= \lim_{p\to 0^+} \left(1+p\int_Xfd\mu+o(f)\right)^{\frac{1}{p}}\\
        &= \lim_{p\to 0^+} \left(1+p\int_Xfd\mu\right)^{\frac{1}{p}}\\
        &=\exp\left(\int_{X}fd\mu\right)=RHS
    \end{align*}
\end{solution}


