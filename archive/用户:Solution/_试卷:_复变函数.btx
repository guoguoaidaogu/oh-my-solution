\setdisplaytitle{试卷：复变函数}
\sethtmltitle{试卷：复变函数}
\newcommand{\ii}{\mathrm{i}}

\section{2026春复变函数(H)期末考试(沈维孝)}
\begin{enumerate}
    \item 设$f_{1}, f_{2}$在$\mathbb{D}$上全纯，且$|f_{1}|^{2}+|f_{2}|^{2}\equiv 1$，证明它们为常值函数.
    \item 考虑函数
    $$
    f(z)=\frac{\sin z\cos z}{z^{7}-z^{5}+z^{3}-z}.
    $$
    \begin{itemize}
        \item[(1)] 求$f$的所有零点和极点，并确定其阶数；
        \item[(2)] 计算积分$\displaystyle\int_{|z|=2}\frac{f'(z)}{f(z)}\,dz$.
    \end{itemize}
    \item 设$f$为$\mathbb{C}$上的半纯函数，且满足
    $$
    f\left(\frac{1}{n}\right)=\frac{n^{6}-1}{16n^{4}-1},\qquad n=1,2,\cdots
    $$
    \begin{itemize}
        \item[(1)] 求$f$的解析表达式；
        \item[(2)] 设$f$在$z=\ii$处的Taylor展开为$f(z)=\sum a_{n}(z-\ii)^{n}$，求$\limsup\limits_{n\to\infty}|a_{n}|^{1/n}$.
    \end{itemize}
    \item 设$f:\mathbb{C}\setminus[-1,1]\to\mathbb{C}$为全纯函数，满足
    $$
    f(z)^{2}=z^{2}-1,\qquad f(2)=\sqrt{3}.
    $$
    \begin{itemize}
        \item[(1)] 证明这样的$f$存在；
        \item[(2)] 求$f(-2)$；
        \item[(3)] 求$f$在$\infty$处的留数.
    \end{itemize}
    \item 设$f:\mathbb{D}\to\mathbb{D}$全纯，定义
    $$
    g_{n}(t)=f(r_{n}e^{\ii t}),\qquad r_{n}=\frac{n-1}{n},\quad n=1,2,\cdots
    $$
    已知$g_{n}$在$t\in[0,\pi/2]$上一致收敛到$0$，证明$f\equiv 0$.
    \item 考虑半圆盘
    $$
    \Omega=\mathbb{D}\cap\{z\in\mathbb{C}:\Im z>0\}.
    $$
    设$\mathcal{F}$为所有满足$f(0)=\ii/2$的全纯函数$f:\mathbb{D}\to\Omega$的集合，求 $\sup_{f\in\mathcal{F}}|f'(0)|$.
\end{enumerate}


\section{2026春复变函数期末考试(贺丹青，王珺)}
\begin{enumerate}
    \item 判断(15分)\\
    \begin{itemize}
        \item[(1)]若函数$f(z)$在区域$\Omega$上全纯，则$f$必有原函数
        \item[(2)]设$f$在区域$\Omega$上全纯，若存在$\Omega$上互不相同的点列$\{z_k\}_n^{\infty}$使得$f(z_k)=0,k\in\mathbb{N}$，则$f(z)=0$
        \item[(3)]设$z=x+iy$，则$f(z)=e^x(3\sin y+3\sin x)$是全纯函数
        \item[(4)]$\{z:\operatorname{Re} z\geqslant0\}$不是$\mathbb{C}_{\infty}$中闭集
        \item[(5)]存在在$z=0$全纯的函数$f$使得对所有充分大的自然数$n$有$f\big(\frac1n\big)=\frac{1}{n^2}$
    \end{itemize}
    \item 计算(30分)
    \begin{itemize}
        \item[(1)]$\int_{|z|=1}\frac{1}{z^2(z^2-4)e^z}dz$.
        \item[(2)]计算$p(z)=z^4+6z^3+2z+2$在$\{z:|z|<1\}$内的零点个数.
        \item[(3)]求函数$f(z)=\frac{z^2-2z+5}{(z-2)(z^2+1)}$在圆环$\{1<|z|<2\}$上的Laurent展开式.
    \end{itemize}
    \item (15分)求双全纯函数$F:\mathbb{D}\cap\mathbb{H}\to L(0,\pi),L(0,\pi)=\{z\in\mathbb{C},0<\operatorname{Im} z<\pi\}$且$F(i(\sqrt2-1))=\frac{\pi i}{2}$，要求写出$F$的准确表达式，求说明这是由哪些初等共形映射复合而来.
    \item (15分)设$f$在$D^*(z_0,r)$上全纯，$z_0$是$f$的$n$阶极点，且是唯一极点，证明：存在$D^*(z_0,r)$上全纯函数$g$使得$z_0$是$g$的唯一的单极点，且满足$g^n(z)=f(z),z\in D^*(z_0,r)$.
    \item (10分)证明幂级数$\sum_{n=1}^{\infty}\frac{z^n}{n}$在$\{z\in\mathbb{C},|z|<1\}$上内闭一致收敛，但不一致收敛.
    \item (15分)设$f$在$\mathbb{D}=\mathbb{D}(0,1)$上解析，且满足$f(0)=f'(0)=f''(0)=0,|f''(z)|\leqslant 1,\forall z\in \mathbb{D}(0,1)$，证明$|f(z)|\leqslant\frac{|z|^3}{6},\forall z\in\mathbb{D}(0,1)$.
\end{enumerate}

\section{2026春复变函数(H)期中试卷（沈维孝）}
\begin{enumerate}
\item[一]（20分）设\(C : |z| = 4\)为逆时针定向圆周，计算
\[
    \int_C \frac{z^3 + 3z + 1}{(z - 1)^3(z + 2\mathrm{i})^2}\mathrm{d}z.
\]
\item[二]（20分）设\(U, V\)是复平面上区域，\(f : U \to V\)是连续函数，\(g : V \to 
\mathbb{C}\)是非常值全纯函数，使得\(F = g \circ f : U \to \mathbb{C}\)也是全纯函数. 
证明\(f\)是全纯函数。
\item[三]（20分）
将\(f(z) = (1 - z)^{-2}\)在\(z = 0\)处展开成幂级数，并求出该幂级数的收敛半径。
\item[四]（20分）求满足如下条件的\(\mathbb{C}\)上的半纯函数\(f\):
\[
    f\left( \frac{1}{n} \right) = \frac{n^3}{n-1},\quad n = 1, 2, \dots
\]
并求出\(f\)在\(\mathbb{C}\)中所有孤立奇点处的留数。
\item[五]（20分）设\(f\)是定义在\(0 < |z| < 1\)上的全纯函数，且存在常数\(C > 0\)和
正整数\(k\)使得
\[
    \int_{|z| = r}\left| z^k f(z) \right||\mathrm{d}z| \le C
\]
对所有的\(r \in (0, 1)\)成立. 证明\(0\)是\(f\)的可去奇点或极点.
\end{enumerate}

\section{2025秋复变函数(英才班)期末试卷(姚一隽、石荣刚)}
\begin{enumerate}
\item[1.] $f(z)$ 是 $\mathbb{D} \to \mathbb{D}$ 的全纯函数, 且 $f(0) = \frac{1}{2}, f'(0) = \frac{3}{4}$. 这样的 $f(z)$ 是否存在？若存在，是否唯一？(10 分)

\item[2.] $f(z)$ 是在 $\overline{D(0, R)}$ 的一个邻域内的全纯函数. 设 $f(z)$ 的 $z = 0$ 处的 Taylor 展开为 \[
   f(z) = \sum_{n=0}^\infty a_n z^n
\]
\begin{itemize}
    \item[(1)] 证明对于所有 $n \ge 1$有以下估计：
    \[|a_n| R^n \le 4 \left( \max_{|z|=R} \operatorname{Re} f(z) + |f(0)| \right).\]
    \item[(2)] 设 $f(z)$ 是整函数且处处不为零。若存在实数 $\alpha, \beta$ 使得对于任意 $z \in \mathbb{C}$，都有：
    \[|f(z)| \le e^{\alpha|z| + \beta}.\]
    证明：$f(z)$ 具有形式 $f(z) = e^{P(z)}$，其中 $P(z)$ 是一个多项式，且其次数 $\deg P \le [\alpha]$。（$[\,\cdot\,]$表示高斯函数）
    \item[(3$^*$)] 设 $f(z)$ 在 $\overline{D(0,R)}$ 的一个邻域内全纯。证明对于任意 $r$ 满足 $0 < r < R$，以下不等式成立：
    \[\max_{|z|=r} |f(z)| \le \frac{2r}{R-r} \max_{|z|=R} \operatorname{Re} f(z) + \frac{R+r}{R-r} |f(0)|.\]
\end{itemize}
\begin{proofc}[(3) 的解答]
    记$a=\max\limits_{|z|=R}\operatorname{Re}f(z)$，
    不妨设$a>0$ (不然$f$是常数；这是为了避免下面出现$2a-f=0$的可能)。
    先考察$f(0)=0$的情形，当$|z| \leqslant R$时$|f|\leqslant|2a-f|$，
    即$f/(2a-f)$是从$D(0,R)$到$D(0,1)$的映射，
    由Schwarz定理知$|f/(2a-f)|\leqslant|z|/R$。
    限定$|z| \leqslant r$后进而有$|f/(2a-f)| \leqslant r/R$，
    推出$|f|\leqslant\dfrac{2r}{R-r}a$。
    
    接下来不要求$f(0)=0$，来考察$f(z)-f(0)$，根据上述有
    \[|f(z)-f(0)|\leqslant\frac{2r}{R-r}\max_{|z|=R}\operatorname{Re}(f(z)-f(0))
    \leqslant\frac{2r}{R-r}(a+|f(0)|).\qedhere\]
\end{proofc}

\item[3.] 设 $\mathcal{S} = \{ f(z) : f(z) \text{ 是 $\mathbb{D}$ 上的单叶函数}, f(0) = 0, f'(0) = 1 \}$. 取 $f(z) \in \mathcal{S}$.
\begin{itemize}
    \item[(1)] 证明存在 $g \in \mathcal{S}$ 使得 $g(z)^2 = f(z^2)$, 且 $g$ 在 $z = 0$ 处的 Taylor 展开的偶次项的系数均为 $0$. (10 分)
    \item[(2)] 设 $f(z) = z + a_2 z^2 + \cdots$, $g(z) = z + a'_3 z^3 + \cdots$. 证明 $2 a_2 = a'_3$. (10 分)
    \item[(3$^*$)] 考虑 $F(z) = \frac{1}{g(1 / z)}$. 证明 $F$ 是 $\{ z : |z| > 1 \}$ 上的单叶函数, 
    且有 Laurent 展开式 $F(z) = z + b_0 + \frac{b_1}{z} + \cdots$.
    证明 $\sum \limits_{n=1}^\infty n |b_n|^2 \leq 1$, 并由此给出 $|a_2|$ 的上界. (10 分)
\end{itemize}

\item[4.] 设 $s = \sigma + it$, $\zeta(s) = \sum \limits_{n=1}^\infty \frac{1}{n^s}$.
\begin{itemize}
    \item[(1)] 证明对 $\sigma > 1$, $(1 - 2^{1 - s}) \zeta(s) = \sum \limits_{n=1}^\infty \frac{(-1)^{n-1}}{n^s}$. (10 分)
    \item[(2)] 证明 $\sum \limits_{n=1}^\infty \frac{(-1)^{n-1}}{n^s}$ 在 $\{ s : \sigma > 0 \}$ 上收敛到一个全纯函数. (15 分)
    \item[(3)] 证明对 $0 < \sigma < 1$, $\zeta(\sigma) < 0$. (15 分)
\end{itemize}

\item[5.] 已知\[\Gamma(z) = \int_0^{+\infty} t^{z-1} e^{-t} \, \mathrm{d}t, 
\quad\sin z = z \prod \limits_{n=1}^\infty \left( 1 - \frac{z^2}{\pi^2 n^2} \right).\]
设围道 $\gamma_{\epsilon, R} = \{ x - i \epsilon : -\infty \leq x \leq -\sqrt{R^2 - \epsilon^2} \} 
\cup \{ z : |z| = R, \operatorname{Re} z \geq -\sqrt{R^2 - \epsilon^2} \} 
\cup \{ x + i \epsilon : 0 \geq x \geq -\infty \}$.
考虑积分 $\displaystyle\int_{\gamma_{\epsilon, R}} e^{w} w^{-z} \, \mathrm{d}w$.
\begin{itemize}
    \item[(1)] 证明题述积分绝对可积. (10 分)
    \item[(2)] 证明 $z$ 为整数且 $z \leq 0$ 时, 题述积分为 $0$. (5 分)
    \item[(3)] 证明 $z = -1$ 时题述积分为 $2 \pi i$. (5 分)
    \item[(4)] 证明
    \[\int_{\gamma_{\epsilon,R}} w^{z-1} e^w \, dw = 2i \sin(\pi z) \Gamma(z).\]
    \item[(5$^*$)] 证明
    \[\frac{1}{\Gamma(z)} = \frac{1}{2\pi i} \int_{\gamma_{\epsilon,R}} w^{-z} e^w \, dw.\]
\end{itemize}
\end{enumerate}

\section{2025秋复变函数(英才班)期中作业(姚一隽)}
\begin{enumerate}
\item [1.]考虑复平面上的集合
\[
A = \left\{ z = re^{i\theta}, r \in [0, +\infty), \theta \in \left[ -\frac{\pi}{4}, \frac{\pi}{4} \right] \right\},
\]
\[
B = \left\{ z = a + ib, a \in (-\infty, +\infty), a^2 - b^2 > 1 \right\}.
\]
求所有的复系数多项式 \( p(z) \)，使得 \(\{p(z), z \in A\} \subset B\)。


\item [2.]设实数 \(a, b > 0\)，且 \(\theta = a/b\) 是无理数。设
\[
f(z) = \frac{1}{z^3 \sin(\pi az) \sin(\pi bz)}.
\]
\item[(1)] 对于整数 \(n \neq 0\)，求\(f\)关于 \(\dfrac{n}{a}\) 和 \(\dfrac{n}{b}\) 的留数。
\item[(2)] 证明，\(\operatorname{Res}[f, 0] = \dfrac{\pi^2}{360ab}(7(a^4 + b^4) + 10a^2b^2)\)。
\item[(3)] 证明，存在一列收敛到 \(+\infty\) 的实数 \((r_N)_{N \geqslant 1}\)，和一个与 \(N\) 无关的 \(d > 0\)，使得
\[
\inf_{n \in \mathbb{Z}} \left| r_N - \frac{n}{a} \right| \geqslant d, \quad \inf_{n \in \mathbb{Z}} \left| r_N - \frac{n}{b} \right| \geqslant d.
\]
\item[(4)] 设 \(S_N = \{z, \operatorname{Re} z \in \{-r_N, r_N\}\)，或 \(\operatorname{Im} z \in \{-r_N, r_N\}\}\)。
证明，存在 \(\delta > 0\)，使得对于任意 \(z \in S_N\)，都成立 \(|\sin \pi az| \geqslant \delta, |\sin \pi bz| \geqslant \delta\)。
\item[(5)] 利用留数定理，证明
\[
\lim_{N \to \infty} \left( \theta^2 \sum_{1 \leqslant n < a r_N} \frac{(-1)^n}{n^3 \sin(n \pi / \theta)} 
+ \sum_{1 \leqslant n < b r_N} \frac{(-1)^n}{n^3 \sin(n \pi \theta)} \right) 
= \frac{-\pi^3}{720} \left( 7 \theta^3 + \frac{7}{\theta} + 10 \theta \right).
\]
\item[(6)] 取 \(a = 1 + \sqrt{2}, b = 1\), 证明, \(\displaystyle\sum_{n=1}^{\infty} \frac{1}{n^3 \sin(n \pi \sqrt{2})} = \frac{-13 \sqrt{2} \pi^3}{720}\).


\item[3.]
\item[(a)] 是否存在从 \(\mathbb{C} \setminus \{0\}\) 到 \(\mathbb{D}\) 的全纯满射？
\item[(b)] 证明, 存在从 \(\mathbb{D}\) 到 \(\mathbb{C}\) 的全纯满射。这能不能同时是一个单射？能不能满足: 对于任意 \(w \in \mathbb{C}\), \(f^{-1}(w)\) 恰有两个元素？
\item[(c)] 设 \(\Omega\) 是一个凸开集, \(f\) 是 \(\Omega\) 上的一个全纯函数, 满足 \(\operatorname{Re} f'(z) > 0\) 对于任意 \(z \in \Omega\) 成立。
设 \(a, b \in \Omega\) 是区域中两个点，我们记 \(b - a = re^{i\theta}\)，\(r > 0\)，\(\theta \in \mathbb{R}\)。
证明，\(\operatorname{Re} \big( e^{-i\theta}(f(b) - f(a)) \big) > 0\)。证明，\(f\) 是单射。


\item[4.]
构造一个从开单位圆盘到开圆环 \(\{a < |z| < b\}\) 的全纯满射。


\item[5.]
考虑映射 \( z \mapsto f(z) = \dfrac{az + b}{cz + d} \)，其中 \(a, b, c, d \in \mathbb{C}\)，\(ad - bc = 1\) 且 \(c \neq 0\)。
\item[(1)] 证明，\(I_f = \{z \mid |f'(z)| = 1\}\) 是一个圆。刻画圆内部和 \(|f'(z)|\) 的关系。
\item[(2)] 证明，\(f\) 把 \(I_f\) 的内部（相应地，外部）映到 \(I_{f^{-1}}\) 的外部（相应地，内部）。
\item[(3)] 证明，
\begin{center}
    若 \(a + d \in \mathbb{R}\) 且 \(|a + d| > 2\)，则 \(I_f \cap I_{f^{-1}} = \varnothing\)；

    若 \(a + d = \pm 2\)，\(f(z) \not\equiv z\)对任意 \(z \in \mathbb{C}\)成立，且\(f(\infty) \neq \infty\)，则 \(I_f\) 和 \(I_{f^{-1}}\) 有一个公共点；

    若 \(a + d \in (-2, 2)\) 且 \(f(f(\infty)) \neq \infty\)，则 \(I_f\) 和 \(I_{f^{-1}}\) 有两个公共点；
\end{center}
\item[(4)] 设 \(f(f(\infty)) \neq \infty\) 且 \(a + d \neq 0\)。记 \(I_f\) 的圆心为 \(z_0\)，半径为 \(r_0\)，
\[
R_f(z) = z_0 + \frac{r_0^2}{\bar{z} - \overline{z_0}}.
\]
记 \(K\) 为复平面上关于 \(I_f\) 和 \(I_{f^{-1}}\) 的圆心的垂直平分线的对称作用。
证明，存在某个 \(\theta \in [0, 2\pi)\) 使得 \(f = K \circ R_f \circ E_\theta\)，
其中 \(E_\theta\) 是关于 \(f^{-1}(\infty)\) 的角度为 \(\theta\) 的旋转。
\item[(5)] 证明，\(\theta = 0\) 当且仅当 \(a + d \in \mathbb{R}\)。

\item[6.] 给定正整数 \(k\)，复数 \(z\) 和一个实数 \(0 < \varepsilon < 1/2\)。证明，有无穷多个正整数 \(n\) 使得下述不等式成立：
\[
\left| \sum_{0 \leqslant \ell \leqslant \frac{n}{k+1}} \binom{n - k \ell}{\ell} z^\ell \right| 
\geqslant \left( \frac{1}{2} - \varepsilon \right)^n.
\]
\end{enumerate}

\section{2025春复变函数(H)期末试卷(沈维孝)}
\begin{enumerate}
\item 设$f:\mathbb{C}\rightarrow\mathbb{C}$连续，
$U=\{z\in\mathbb{C}\ \big|\ |\operatorname{Re}z|<1,|\operatorname{Im}z|<1\}$，
且对于所有$\lambda>0,a\in\mathbb{C}$都有
$$\int_{\partial U}f(\lambda z+a)dz=0.$$
证明$f(z)$是全纯函数。
\item 设$f(z,w):\mathbb{D}\times\mathbb{D}\rightarrow\mathbb{C}$连续，
对任意$w\in\mathbb{C}$，$z \mapsto f(z,w)$全纯，且$f(0,0)=0$。
证明存在一列$(z_n,w_n)$，满足$0<|z_n|^2+|w_n|^2<\frac{1}{n}$，且$f(z_n,w_n)=0$。
\item 设$f(z)$为$\frac{1}{\sqrt{z(z-2)(z-a)}}$在$\mathbb{H}$上的单值支，其中$a>2$，
满足$\lim\limits_{x\rightarrow1,y\searrow0}f(z)>0$。
\begin{enumerate}[label=(\roman*)]
\item 求$f(-1)$。
\item 用围道积分的方法证明$\lim\limits_{y\rightarrow0}\int_{-\infty}^{+\infty}f(x+yi)dx=0$。
\item $F(z)$为$f(z)$在$\mathbb{H}$上的一个原函数，证明$F(z)$是单叶函数。
\end{enumerate}
\item 设$f_n:\mathbb{D}\rightarrow\mathbb{D}$全纯，满足
$$f_n(0)=f_n'(0)=\dots=f_n^{(n)}(0)=0.$$
证明$\sum_{n=1}^{\infty}f_n$在$\mathbb{D}$上内闭一致收敛.
\item 设${f_n}$是$\mathbb{D}$上的全纯函数，对于所有$n$，满足
$$\int_{\mathbb{D}}|f_n|^2dxdy\leqslant 1,$$
且$f_n$在$\big\{|z|\leqslant\frac{1}{2}\big\}$内至少有$n$个零点(计重数)，
证明${f_n}$在$\mathbb{D}$上内闭一致收敛到$0$。
\item 设$\Omega=\{|z|>1,|z-1|<3\},A_R=\{1<|z|<R\}$，
求所有$R>1$使得存在$\Omega$到$A_R$的双全纯映射，并求所有双全纯映射。
\end{enumerate}

\section{2025春复变函数期末试卷(贺丹青、王珺)}
\begin{enumerate}
    \item[1.]    判断
        \begin{enumerate}
            \item[(i)] 设 $z = x + iy$, 则 $f(z) = e^{x}(\cos y + 2i\sin y)$ 全纯.
            \item[(ii)] 闭曲线 $\gamma(t) = e^{2it}\cos t, 0\le t\le 2\pi$ 关于 $z_0=2$ 的绕数为 $1$.
            \item[(iii)] 存在在 $z=0$ 处全纯的函数 $f$ 使得对于充分大的自然数 $n$, 
            有 $f\big(\frac{1}{n}\big)=f\big(\!-\frac{1}{n}\big)=\frac{1}{n}$.
            \item[(iv)] 设 $f$ 是区域 $\Omega \subset \mathbb{C}$上的全纯函数, 
            令 $m=\min_{z\in \Omega}|f(z)|$, 则对于任意 $z \in \Omega$, 有 $|f(z)| > m$.
            \item[(v)] 设 $f(z)$ 为定义在 $\mathbb{C}$ 上的全纯函数. 
            若 $\operatorname{Re}f(z)$ 在 $\mathbb{C}$ 上恒为常数, 
            则 $f(z)$ 在 $\mathbb{C}$ 上恒为常数.
        \end{enumerate}
    
    \item[2.]    计算
        \begin{enumerate}
            \item[(i)] $f(z)= \frac{1}{\cos z}$ 在 $z=0$ 处的收敛半径.
            \item[(ii)] $f(z) = (1+z^{2})^{-2}$ 在 $z_0=i$ 处的留数.
            \item[(iii)] 积分 $\int_{-\infty}^{\infty} e^{-\pi x^{2}}e^{-2\pi itx}dx.$
        \end{enumerate}
    
    \item[3.]    设 $z_0$ 是 $f(z)$ 的孤立奇点, 但不是可去奇点, 证明: $z_0$ 是 $e^{f(z)}$ 的本性奇点.
    \item[4.]    求将三个点 $1,0,-1$ 分别映射成 $i,1+i,1$ 的分式线性变换.
    \item[5.]    设 $P(X,Y,Z)$ 是复数 $z = x+iy$ 在球极投影下的像点, 证明:
        \begin{enumerate}
            \item[(i)] 点 $P$ 的坐标为
                $$
                P(X,Y,Z)=\left(\frac{2X}{1+|z|^{2}},\frac{2Y}{1+|z|^{2}},\frac{|z|^{2}-1}{1+|z|^{2}}\right).
                $$
            \item[(ii)] 证明 $N(0,0,1)$ 到 $P(X,Y,Z)$ 和 $N$ 到 $Q(x,y,0)$ 的距离之积等于 $2$.
        \end{enumerate}
    \item[6.]    设 $\Omega \subseteq \mathbb{C}$ 是有界区域, 
    $f:\overline{\Omega}\to \mathbb{C}$ 是非常值的连续函数, 且 $f$ 在 $\Omega$ 上全纯. 
    若 $|f(z)| =1,\forall \, z\in \partial \Omega$, 证明: $f(\Omega)=D(0,1)$.
\end{enumerate}

\section{2025春复变函数(H)期中试卷（沈维孝）}
\begin{enumerate}
\item[一]（20分）设 $f: \mathbb{C} \rightarrow \mathbb{C}$ 是实连续可微函数，
且对于任意 $a \in \mathbb{C}$ 和 $r>0$，都成立
$$\int_{|z-a|=r} f(z) dz=0.$$
证明 $f$ 是全纯函数。
\item[二]（20分）设 $\Omega=\{z \in \mathbb{C}: \operatorname{Im}(z)>0\} \setminus \{i y: y \geq 1\}$。
找一个从 $\Omega$ 到单位圆盘 $\mathbb{D}=\{z \in \mathbb{C}:|z|<1\}$ 的双全纯映射。
\item[三]（20分）
\begin{enumerate}[label=(\arabic*)]
\item 证明：存在全纯函数 $f: \mathbb{C} \setminus [-1,1] \rightarrow \mathbb{C}$，使得 $f(z)^2=(z^2-1)^{-1}$。
\item 利用围道积分计算 $\displaystyle\int_{-1}^1 \frac{x^2+1}{\sqrt{1-x^2}}\,{\rm d}x$。
\end{enumerate}
\item[四]（20分）设 $f: \mathbb{C} \rightarrow \mathbb{C}$ 是全纯函数，且对任意 $z \in \mathbb{C}$，
$$\operatorname{Re} f(z)<(\operatorname{Im} f(z))^2.$$
证明 $f$ 是常值函数。
\item[五]（20分）求满足如下条件的 $\mathbb{C}$ 上的半纯函数 $f$：
$$f\left(\frac{1}{n}\right)=\frac{n^3}{n-1},\ \ n=1,2, \ldots.$$
并求出 $f$ 在 $\mathbb{C}$ 中所有孤立奇点处的留数。
\end{enumerate}

\section{2024秋复变函数期末试卷（姚一隽）}
\begin{enumerate}
\item[一] 填空：
\begin{enumerate}[label=(\arabic*)]
\item (5 分) $\mathbb{C} \setminus [-1,1]$ 上取 $\sqrt[3]{z(z+1)(z-1)}$ 的单值支 $f(z)$ 使得 $f(2)$ 为正实数 $\sqrt[3]{6}$，
则 $f(i \sqrt{3})=\underline{\qquad\qquad}$。
\item (5 分) 考虑去心复平面上的函数 $f(z)=(z-\pi) \exp \dfrac{1}{\pi-z}$，
则 $\lim\limits_{z \rightarrow \pi} f(z)=\underline{\qquad\qquad}$。
\item 考虑多项式 $P(z)=3z^{15}+4z^{8}+6z^{5}+19z^{4}+3z+2$。\\
(i) (5 分) 在 $\{|z|<1\}$ 中 $P$ 有 $\underline{\qquad\qquad}$个根。\\
(ii) (5 分) 在 $\{1<|z|<2\}$ 中 $P$ 有 $\underline{\qquad\qquad}$个根。
\end{enumerate}

\item[二]
\begin{enumerate}[label=(\arabic*)]
\item (10 分) 计算 $\displaystyle I_{1}=\int_{\mathbb{R}} \frac{x dx}{(x^{2}+x+1)^{2}}$。
\item (10 分) 计算 $\displaystyle I_{2}=\int_{0}^{\infty} \frac{x^{1/3}}{x^{2}+1} dx$。
\item (15 分) 计算 $\displaystyle I_{3}=\int_{0}^{\infty} \frac{\log x}{(x+a)^{2}+b^{2}} dx$。（其中 $a, b>0$ 是常数）
\end{enumerate}

\item[三]
\begin{enumerate}[label=(\arabic*)]
\item (5 分) 有没有从 $\mathbb{C}$ 到 $\mathbb{D}=\{|z|<1\}$ 的全纯满射？说明理由。
\item (10 分) 证明，存在从 $\mathbb{D}$ 到 $\mathbb{C}$ 的全纯满射 $f$。它可能同时是单射么？
是否可能对于任意 $w \in \mathbb{C}$，$f^{-1}(\{w\})$ 都恰好包含 $2$ 个点？
\begin{proofc}[解答]
    $\Big(\dfrac{z}{1+z}\Big)^2$即是一例。单位圆盘通过$z\mapsto\dfrac{1}{1+z}$变成了$\{\operatorname{Re}z>1/2\}$，
    用$1$减去其（即关于直线$\operatorname{Re}z=1/2$对称）后包含了闭左半平面，平方以后就覆盖了整个复平面。
    不可能同时是单射，不然它的逆映射有界。
\end{proofc}
\item (10 分) 设 $\Omega$ 是一个凸开集，$f$ 是 $\Omega$ 的全纯函数，
且对于任意 $z \in \Omega$，$\operatorname{Re} f^{\prime}(z)> 0$。
设 $a, b$ 是 $\Omega$ 中的两个不同点，记 $b-a=r e^{i\theta}(r>0, \theta \in \mathbb{R})$。证明，
\[\operatorname{Re}\left(e^{-i\theta}(f(b)-f(a))\right)>0,\]
并由此证明 $f$ 是单射。
\end{enumerate}

\item[四] (20 分) 设 $\mathbb{D}$ 是开单位圆盘，$f(z): \overline{\mathbb{D}} \rightarrow \overline{\mathbb{D}}$ 在 $\overline{\mathbb{D}}$ 上连续，在 $\mathbb{D}$ 上全纯。
如果 $z=1/2$ 为 $f(z)$ 的 $2$ 阶零点，请证明：$|f^{\prime \prime}(1/2)| \leqslant 32/9$。
\begin{proofc}
记$\alpha=-1/2$，$\varphi_\alpha(z)=\dfrac{z-\alpha}{1-\bar{\alpha}z}$，则有
\[\varphi_\alpha(0)=-\alpha,\quad\varphi'_\alpha(0)=1-|\alpha|^2.\]
考察复合映射\[g:\mathbb{D}\stackrel{\varphi_\alpha}{\longrightarrow}
\mathbb{D}\stackrel{f}{\longrightarrow}\mathbb{D},\quad0\mapsto-\alpha\mapsto0.\]
一方面，$0$为$g(z)$的$2$阶零点，从而是$g(z)/z^2$的可去奇点，
在$D(0,r)$上对$g(z)/z^2$用最大模原理并令$r\to1^-$，就有
\[\left|\frac{g''(0)}{2}\right|=\lim_{z\to0}\left|\frac{g(z)}{z^2}\right|\leqslant1.\]
另一方面，算出\[g'(z)=(f\circ\varphi_\alpha)'(z)=f'(\varphi_\alpha(z))\varphi'_\alpha(z),\]
进而有\[g''(z)=f''(\varphi_\alpha(z))\varphi'_\alpha(z)^2+f'(\varphi_\alpha(z))\varphi''_\alpha(z),\]
从而$g''(0)=f''(-\alpha)(1-|\alpha|^2)^2$。因此，
\[|f''(-\alpha)|\leqslant\frac{2}{(1-|\alpha|^2)^2}=\frac{2}{(1-1/4)^2}=\frac{32}{9}.\qedhere\]
\end{proofc}

\item[五]
\begin{enumerate}[label=(\arabic*)]
\item (8 分) 设 $z=x+iy$ 是方程
\[\tan z=z \tag{$*$}\]
的根。证明，$x \sinh 2y=y \sin 2x$。由此证明，方程$(*)$的所有根都是实数，
\item (6 分) 把方程$(*)$的所有 $>0$ 的根从小到大排成一列 $\lambda_{1}<\lambda_{2}<\cdots$。
证明， $n \pi<\lambda_{n}<n \pi+\dfrac{\pi}{2}$。
\item (4 分) 记 $f(z)=\sin z-z \cos z, g(z)=\dfrac{1}{z^{2}} \dfrac{f^{\prime}(z)}{f(z)}$。
证明，$\dfrac{1}{\lambda_{n}^{2}}=\operatorname{Res}[g, \lambda_{n}]$。
\item (12 分) 证明，$\displaystyle\sum_{n=1}^{\infty} \frac{1}{\lambda_{n}^{2}}=-\frac{1}{2} \operatorname{Res}[g, 0]$，并求出这个值。
\end{enumerate}

\item[六]
\begin{enumerate}[label=(\arabic*)]
\item (8 分) 设整函数 $f, g$ 满足 $f^{2}+g^{2}=1$。
证明，存在整函数 $h$，使得 $f=\cos h$，$g=\sin h$。
\item (12 分) 设整函数 $f, g$ 满足 $f^{3}+g^{3}=1$。证明，$f$ 和 $g$ 都是常数。
（提示：可利用Picard小定理（课本第 322 页））
\end{enumerate}
\begin{proofc}
\begin{enumerate}[label=(\arabic*)]
\item $f+ig$非零从而可写为$e^{ih}$，这样$f-ig=e^{-ih}$，解出$f,g$即可。
\item 因式分解为$(f+g)(f+\omega g)(f+\omega^2 g)=1$，
易知亚纯函数$f/g$不取$-1,-\omega,-\omega^2$三个值，由Picard小定理，$f/g$是常数。\qedhere
\end{enumerate}
\end{proofc}
\end{enumerate}

\section{2024秋复变函数期中作业（姚一隽）}
\begin{itemize}
\item[1.] 考虑裂纹平面 $\Omega = \mathbb{C} \setminus (-\infty, 0]$。证明下述两个命题:

\begin{enumerate}
    \item[(i)] 设 $f$ 是某个非空区域 $D$ 上的全纯函数，满足 $f(D)$ 是 $\Omega$ 的子集，则存在 $D$ 上的全纯函数 $g$ 使得 $g^2 = f$。
    \item[(ii)] 设 $f$ 是 $\Omega$ 上的没有零点的全纯函数，则存在 $\Omega$ 上的全纯函数 $g$ 使得 $g^2 = f$。
\end{enumerate}

\item[2.] 设紧集 $K \subset \mathbb{R}$, $\mu(K) > 0$。
对于 $z \in \mathbb{C} \setminus K$, 定义 $\mathbb{C} \setminus K$ 上的全纯函数
\[ f(z) = \int_K \frac{dt}{t - z}. \]

\begin{enumerate}[label=(\arabic*)]
    \item 设 $R > 0$, $K \subset (-R, R)$. 求 $f$ 在 $\{|z| > R\}$ 上的 Laurent 展式.
    \item 极限 $\lim\limits_{z \to \infty} z f(z)$ 存在吗? 如果存在的话, 等于多少?
    \item 是否存在 $\mathbb{C} \setminus K$ 上的全纯函数 $g(z)$, 使得 $f(z) = g(z)^2$?
    \item 计算 $\displaystyle\oint_{|z|=R} f(z) \, dz$.
    \item $f$ 能不能延拓成一个整函数?
    \item 当 $K = [-1, 1]$ 的时候, 给出 $f$ 的具体表达式.
\end{enumerate}

\item[3.] 设实数 $a, b > 0$, 且 $\theta = a/b$ 是无理数. 设
\[ f(z) = \frac{1}{z^3 \sin(\pi az) \sin(\pi bz)}. \]

\begin{enumerate}[label=(\arabic*)]
    \item 对于整数 $n \neq 0$, 求 $f$ 关于 $\dfrac{n}{a}$ 和 $\dfrac{n}{b}$ 的留数.
    \item 证明, $\operatorname{Res}[f, 0] = \dfrac{\pi^2}{360ab}(7(a^4 + b^4) + 10a^2b^2)$.
    \item 证明, 存在一列收敛到 $+\infty$ 的实数 $(r_N)_{N \geqslant 1}$, 和一个与 $N$ 无关的 $d > 0$, 使得
    \[ \inf_{n \in \mathbb{Z}} \left| r_N - \frac{n}{a} \right| \geqslant d, \quad \text{且} \quad \inf_{n \in \mathbb{Z}} \left| r_N - \frac{n}{b} \right| \geqslant d. \]
    \item 设 $S_N = \{z \mid \operatorname{Re} z \in \{-r_N, r_N\}, \text{或 } \operatorname{Im} z \in \{-r_N, r_N\}\}$. 
    证明, 存在 $\delta > 0$, 使得对于任意 $z \in S_N$, 都成立 $| \sin \pi az | \geqslant \delta$, $| \sin \pi bz | \geqslant \delta$.
    \item 利用留数定理, 证明
    \[ \lim_{N \to \infty} \left( \theta^2 \sum_{1 \leqslant n < ar_N} \frac{(-1)^n}{n^3 \sin(n\pi/\theta)} + \sum_{1 \leqslant n < br_N} \frac{(-1)^n}{n^3 \sin(n\pi\theta)} \right) = -\frac{\pi^3}{720} \left( 7\theta^3 + \frac{7}{\theta} + 10\theta \right). \]
    \item 取 $a = 1 + \sqrt{2}$, $b = 1$, 证明,
    \[ \sum_{n=1}^\infty \frac{1}{n^3 \sin(n\pi(1 + \sqrt{2}))} = \frac{-13\sqrt{2}\pi^3}{720}. \]
\end{enumerate}

\item[4.] 考虑函数 $\dfrac{e^{2\pi i z^2/n}}{e^{2\pi i z} - 1}$ 在下述两个围道上的积分:
\begin{center}
{{image|围道.jpg|500px}}
\end{center}
由此给出 Gauss 和 $G_n := \sum_{k=0}^{n-1} e^{2\pi i k^2/n}$ 的值.
\item[5.] 设幂级数 $f(z) = \sum_{k=0}^\infty a_k z^k$ 的各项系数都是实数, $a_0 \neq 0$, 且收敛半径 $> 1$. 并假设在 $\{|z| = 1\}$ 上 $|f(z)| \leqslant 1$. 证明:
\begin{enumerate}
    \item[(1)] 对于 $k = 1, 2, \ldots$, $|a_k| \leqslant 1 - a_0^2$.
    \item[(2)] 对于 $k = 1, 2, \ldots$, 
    \[ -\left(1 - a_0^2 - \frac{a_k^2}{1 + a_0}\right) \leqslant a_k^2 \leqslant 1 - a_0^2 - \frac{a_k^2}{1 - a_0}. \]
\end{enumerate}

\item[6.] 设 $a > 0$, $f$ 是带状区域 $\{z \mid |\operatorname{Im} z| < a\}$ 上的解析函数, 且 $f$ 和 $z^2 f$ 在这个区域上都是有界的.
\begin{enumerate}
    \item[(a)] 求函数 $g(z) = \dfrac{f(z)}{e^{iz} - 1}$ 的极点和相应的留数.
    \item[(b)] 对于 $0 < b < a$, 证明
    \[ \sum_{n=-\infty}^\infty f(2\pi n) = \frac{1}{2\pi} \int_{-\infty}^\infty [g(x - ib) - g(x + ib)] \, dx. \]
    \item[(c)] 证明, 对于任意 $0 < b < a$ 和 $k \in \mathbb{R}$, 有
    \[ \int_{-\infty}^\infty f(x + i \operatorname{sgn}(k) b) e^{ik(x + i \operatorname{sgn}(k) b)} \, dx = \int_{-\infty}^\infty f(x) e^{ikx} \, dx. \]
    \item[(d)] 对于 $f$, 记 $\hat{f}(k) = (2\pi)^{-1/2} \int_{-\infty}^\infty f(x) e^{-ikx} \, dx$. 证明,
    \[ \sum_{n=-\infty}^\infty f(2\pi n) = (2\pi)^{-1/2} \sum_{n=-\infty}^\infty \hat{f}(n). \]
\end{enumerate}
\end{itemize}


\section{2024春 复变函数(H)期末试卷（沈维孝）}

\begin{enumerate}
    \item 设$U,V,W$为$\mathbb{C}$中区域，$f:U\to V,g:V\to W$
    满足$g\circ f:U\to W$是全纯函数，$g$是非常值全纯函数.求证$f$是全纯函数.(题目有误，不过原题也是通过类似条件证明某函数全纯.)
    
    \item 设$0<r<R,A=\{z\in\mathbb{C}:r<|z|<R\}$，求$A$的全体全纯自同构.

    \item 用留数定理计算积分(此题和平行班一样)\\
    设$f(z)=\dfrac{z^2+1}{\sqrt{z^2-1}}$在$\mathbb{C}\setminus [-1,1]$上全纯，满足$x>1$时$f(x)>0$.\\
    (1)求$f(i)$ (记不清了，大概是求$f$什么东西).\\
    (2)计算$f(z)$在$\infty$的留数.\\
    (3)计算积分$$\int_{-1}^{1}\frac{x^2+1}{\sqrt{1-x^2}}dx.$$

    \item设$f$是$\overline{\mathbb{D}}$的某个邻域上的半纯函数，且$f$只在$\partial\mathbb{D}$上有有限个极点.\\
    设$f$在$0$的幂级数展开为$f(z)=\sum\limits_{n=0}^{\infty}a_nz^n$，求证$a_n$有界.

    \item 与调和函数和Schwarz公式有关的题，要证明给定的$\mathbb{D}$上全纯函数列内闭一致收敛，记不清了.

    \item 设$A=\{z\in \mathbb{C}:\operatorname{Re}(z)>0,|z|<2\},\mathscr{M}=\{f:A\to \mathbb{D}\text{ 全纯}\}.$\\
    (1)求$M=\sup\limits_{f\in\mathscr{M}}|f'(1)|$.\\
    (2)求$f\in\mathscr{M}$，满足$f'(1)=M$.
\end{enumerate}

\section{2024春复变函数期中试卷（沈维孝）}
（沈维孝的期中成绩取为$\max\{\text{期中成绩},\text{期末成绩}\}$，期末成绩仍取为期末成绩.）

\begin{enumerate}
    \item 设$\varphi$是非常值整函数，且存在两个复数$c,\lambda$ 满足$|\lambda|>1$，以及
    $$\varphi(z)^2+c=\varphi(\lambda z).$$
    证明：$\infty$是$\varphi$的本性奇点.

    \item 设
    $$\Omega_1=\{z\in \mathbb{C}:|z|<1,|z-1|<1\},\ \ \Omega_2=\{z\in \mathbb{C}:0<\text{Im}(z)<1\}.$$
    写出一个从$\Omega_1$到$\Omega_2$的双全纯映射.

    \item 用留数定理计算积分
    $$\int_0^{\infty}\frac{\cos x}{1+x^4}dx.$$

    \item 设$f$是整函数，满足
    $$f(z)\in\mathbb{R}\iff z\in\mathbb{R}.$$
    证明：$f$至多只有一个零点(记重数).

    \item 设$f:\mathbb{D}\to \mathbb{D}$是全纯函数，满足$r=|f(0)|>0$.证明：当$|z|<r$时，$f(z)\neq 0$.
\end{enumerate}

\section{2023春复变函数期末试卷（邱维元）}

(注：平行班和荣誉课使用同一张卷子.)

\begin{enumerate}
\item 填空题(非常基础，共10题*3分)

\item $f$为单位圆$\mathbb{D}$上的全纯函数，满足$\displaystyle|f(z)|
\leq\frac{1}{1-|z|}\ ,\ \forall\, z\in\mathbb{D}$。
证明：$\forall\, n\in\mathbb{N}^{*}$，
\[|f^{(n)}(0)|\leq (n+1)!e.\]

\item 求将$S=\{z:0<\operatorname{Im}z<\pi\}$映为单位圆$\mathbb{D}$的全体
双全纯映射，并给出证明.

\item 区域$\Omega\subset\mathbb{C}$，$f:\Omega\to\Omega$为全纯映射，
且$\forall\, z\in\Omega,\ f(f(z))=f(z)$.
证明：$f(z)\equiv z$或$f(z)$为常数.

\item 用留数定理计算$\displaystyle\int_{0}^{+\infty}
\frac{x^{\alpha}}{1+x^{\beta}}\,dx$，其中$0<\alpha+1<\beta,\ \beta>1$.

\item $f:\mathbb{D}\to\mathbb{D}$为全纯映射，
满足$f(0)=0,\ f'(0)=a\in(0,1)$. 证明：
\[|z|\frac{a-|z|}{1-|z|a}\leq |f(z)|
\leq |z|\frac{a+|z|}{1+|z|a},\quad\forall\, z\in\mathbb{D}.\]
\begin{proof}{ }
    [第一步] 对$|a|<1,|b|<1$，有
    \[\frac{|a|-|b|}{1-|ab|}\leq\left|\frac{a+b}{1+ab}\right|\leq\frac{|a|+|b|}{1+|ab|}.\]
    这是因为
    \[\left|\frac{a+b}{1+ab}\right|^2=1-\frac{(1-|a|^2)(1-|b|^2)}{|1+ab|^2}
    \begin{cases}\leq1-\dfrac{(1-|a|^2)(1-|b|^2)}{(1+|ab|)^2}=\left(\dfrac{|a|+|b|}{1+|ab|}\right)^2,\\ \\
    \geq1-\dfrac{(1-|a|^2)(1-|b|^2)}{(1-|ab|)^2}=\left(\dfrac{|a|-|b|}{1-|ab|}\right)^2.\end{cases}\]
    [第二步] 取$g(z)=f(z)/z$，有可去奇点$g(0)=a$，且由Schwarz引理，$|g(z)|\leq1$。题目转变为说明
    \[\frac{a-|z|}{1-|z|a}\leq|g(z)|\leq\frac{a+|z|}{1+|z|a}.\]
    [第三步] 取同样是$\mathbb{D}\to\mathbb{D}$的映射
    \[h(z)=\frac{g(z)-a}{1-g(z)a},\]
    反解出\[g(z)=\frac{h(z)+a}{1+h(z)a}.\]
    用第一步得出\[\frac{a-|h(z)|}{1-|h(z)|a}\leq|g(z)|\leq\frac{a+|h(z)|}{1+|h(z)|a},\]
    接着由$h(0)=0$和Schwarz引理，$|h(z)|\leq|z|$，从而有
    \[\frac{a-|z|}{1-|z|a}\leq|g(z)|\leq\frac{a+|z|}{1+|z|a}.\qedhere\]
\end{proof}
\end{enumerate}

\section{2022春复变函数期末试卷（邱维元、王珺）}
\subsection*{2022 春《复变函数》试卷 A}
\begin{itemize}
\item[一、]（每小题5分，共30分）填空题：
\begin{enumerate}[label=(\arabic*)]
\item 计算$\displaystyle\frac{(\cos(3\pi/5)+\ii\sin(3\pi/5))^9}
{(\cos(2\pi/5)+\ii\sin(2\pi/5))^{11}}=\underline{\qquad\qquad}$.
\item 计算积分$\displaystyle\frac{1}{2\pi\ii}
\int_{|z|=1}\frac{|z|+\sin z}{z}\,\mathrm{d}z=\underline{\qquad\qquad}$.
\item 若$u(x,y)=\mathrm{e}^{px}\cos y$是调和函数，则$p=\underline{\qquad\qquad}$.
\item 设$f(z)$是将区域$\bigg\{z:\Big|\dfrac{z-\ii}{z+\ii}\Big|<1\bigg\}$
映成单位圆，且满足$f(2\ii)=0$的双全纯映射（共形映射），则$f(z)=\underline{\qquad\qquad}$.
\item 设$\Omega$是复平面挖去原点和负虚轴后的区域，$f(z)$是$\dfrac{1}{2}\log z$
在$\Omega$上满足$f(1)=0$的单值支，则$f(-1)=\underline{\qquad\qquad}$.
\item 设级数$\sum\limits_{n=1}^{+\infty}c_n$收敛，
$\sum\limits_{n=1}^{+\infty}|c_n|$发散，
则幂级数$\sum\limits_{n=1}^{+\infty}c_nz^n$的收敛半径为$\underline{\qquad\qquad}$.
\end{enumerate}
\item[二、]（每小题8分，共24分）完整叙述下列定理：
\begin{enumerate}[label=(\arabic*)]
    \item 辐角原理.
    \item 调和函数的Poisson公式.
    \item Riemann映射定理.
\end{enumerate}
\item[三、]（10分）已知
\[f(z)=\frac{\mathrm{e}^z}{(z+1)^2(z-2)}
-\frac{a}{(z+1)^2}-\frac{b}{z+1}-\frac{c}{z-2}\]
为整函数（即$\mathbb{C}$中奇点都是可去奇点），求常数$a,b,c$的值。
\item[四、]（12分）利用留数计算积分
\[\int_0^{+\infty}\frac{x\sin x}{x^2+1}\,\mathrm{d}x.\]
\item[五、]（12分）设$f(z)$是单位圆$\mathbb{D}$上的全纯映射，满足
\[f(0)=0,\quad|\operatorname{Re}f(z)|<1,\quad\forall\,z\in\mathbb{D}.\]
证明：
\[|\operatorname{Im}f(z)|\le\frac{2}{\pi}\ln\frac{1+|z|}{1-|z|},\quad\forall\,z\in\mathbb{D}.\]
\item[六、]（12分）设$f(z)$是整函数，满足当$|z|=1$时，$|f(z)|=1$。
证明：$f(z)={\rm e}^{\ii\theta}z^n$，其中$\theta$是实数，$n$是非负整数。
\end{itemize}

\subsection*{2022 春《复变函数》试卷 A 分析}
\begin{itemize}
\item[一、]填空题
\begin{itemize}
\item[(2)] 被积函数 $\dfrac{|z|+\sin z}{z}$ 分子不是全纯函数，不能直接用 Cauchy 积分公式. 
事实上，在积分曲线上 $|z|=1$。有不少答案为 $0$ 的同学应该是将被积函数当作全纯函数，
接着用 Cauchy 公式了，这说明对 Cauchy 公式的掌握不到位。
\item[(6)] 此题要证明要说清楚也许要花点功夫，
但 $z=1$ 是幂级数收敛和绝对收敛的分界点，按收敛半径的性质，只能是$1$.
\end{itemize}

\item[二、]要求将定理完整写正确，缺条件或条件不正确会扣分。

\item[三、]此题主要是参数 $b$ 的计算错误较多。答案是 $b=-4 / 9 e$.

标准做法是对 $\dfrac{e^{z}}{(z+1)^{2}(z-2)}$ 分别在 $z=-1$ 和 $z=2$ 处 Laurent 展开，
取参数 $a, b, c$ 为其主要部分相应项的系数。

同学们在做此题时的典型错误是在 $z=-1$ 作 Laurent 展开时，
要么对 $e^{z}$ 作幂级数展开，但对 $1 /(z-2)$ 直接用 $z=-1$ 代入得到 $-1 / 3$；
要么对 $1 /(z-2)$ 在 $z=-1$ 处幂级数展开，但 $e^{z}$ 直接用 $z=-1$ 代入得到 $e^{-1}$。
两者都导致 $1 /(z+1)$ 的系数错误。
事实上 $e^{z}$ 和 $1 /(z-2)$ 在 $z=-1$ 的幂级数展开都会有 $(z+1)$ 项，
整个函数在 $z=-1$ 处的 Laurent 展开的 $1 /(z+1)$ 的系数是两者之和，
其中之一不展开直接用 $z=-1$ 代入将会少掉一个 $(z+1)$ 项。
一个简单的做法是令 $g(z)=(z+1)^{2}(z-2)f(z)$，
则 $-1$ 是 $g(z)$ 的二阶零点、$2$ 是 $g(z)$ 的一阶零点，
故解方程组 $g(-1)=0, g^{\prime}(-1)=0, g(2)=0$ 即可.

\item[四、]此题的主要错误是很多同学化为围道积分时被积函数取为 $\dfrac{z \sin z}{z^{2}+1}$，但此时在大半圆弧上的积分将出现
$$\int_{0}^{\pi}\left(e^{-R \sin \theta}+e^{R \sin \theta}\right) d \theta$$
这儿出现 $e^{R \sin \theta}$ 是没法用 Jordan 引理的.
正确的做法是 $\sin x=\dfrac{e^{i x}-e^{-i x}}{2i}$ 或 $\sin x=\operatorname{Im} e^{i x}$，
围道积分的被积函数是 $\dfrac{z e^{i z}}{z^{2}+1}$。请看讲义例题。

\item[五、]如果做过教材§6.1 习题 4 (布置过习题) 且会做的话应该会做此题，
不过也有一个典型错误：利用变换以及 Schwarz 引理，得到
$$\left|\frac{e^{i \pi f(z) / 2}-1}{e^{i \pi f(z) / 2}+1}\right| \leq|z|$$
后估算 $\operatorname{Im} f(z)$ 时，出现两个错误：

(1) 直接得到
$$\frac{e^{\pi|f(z)|/2}-1}{e^{\pi|f(z)|/2}+1} \leq|z|.$$
错误在于想当然地认为 $\left|e^{i \pi f(z) / 2}\right|=e^{\pi|f(z)| / 2}$，
但实际是 $\left|e^{i \pi f(z) / 2}\right|=e^{\pi \operatorname{Im} f(z) / 2}$。
此时，只能得到一半不等式，另一半应利用
$$\left|\frac{e^{i \pi f(z) / 2}-1}{e^{i \pi f(z) / 2}+1}\right|
=\left|\frac{e^{-i \pi f(z) / 2}-1}{e^{-i \pi f(z) / 2}+1}\right|.$$
(2) 化为
$$|f(z)| \leq \frac{2}{\pi}\left|\log \frac{1+z}{1-z}\right| 
\leq \frac{2}{\pi} \log \frac{1+|z|}{1-|z|}.$$
这是想当然地认为 $|\log z| \leq \log |z|$，
但实际上 $|\log z|=\sqrt{\log^{2}|z|+(\arg z)^{2}} \geq \log |z|$。

\item[六、]此题的关键是说明单位圆内除了原点外没有其他零点. 
如果单位圆内零点为 $a_{1}, \cdots, a_{n}$ (计重数，必定有限多个），作
$$g(z)=f(z) \prod_{k=1}^{n} \frac{1-\bar{a}_{k} z}{z-a_{k}},$$
则 $g(z)$ 在单位圆内没有零点, $|g(z)|=1$ $(|z|=1)$. 
由最大最小模定理 $g(z) \equiv e^{i \theta}$. 此时
$$f(z)=e^{i \theta} \prod_{k=1}^{n} \frac{z-a_{k}}{1-\bar{a}_{k} z}$$
为有理函数，只有当所有 $a_{k}=0$ 时才是整函数.
也可以用对称原理，单位圆内不是原点的零点关于单位圆周的对称点是极点，与整函数矛盾。
故至多在原点有零点。原点如果是 $n$ 阶零点 ($n=0$ 为非零点)，
则 $f(z) / z^{n}$在单位圆内无零点，单位圆周上模恒为 $1$，同上，由最大最小模定理即得其为常数。

另一种很好的做法是：如果 $0$ 不是 $f(z)$ 的零点，
则其关于单位圆周的对称点 $\infty$ 不是极点，极限存在，
这样是有界整函数，由 Liouville 定理是常数。
如果 $0$ 是 $n$ 阶零点，考虑 $f(z) / z^{n}$。
\end{itemize}

\section{2021春复变函数期末试卷}
一、\ \ 填空题

二、\ \ 解答题
\begin{enumerate}
    \item 求$\displaystyle\int_0^{+\infty}\frac{x^3}{1+x^5}\,dx$。
    \item 记$D_1=\{|z-1|<2\}\cup\{|z+1|<2\}$，
    $D_2=\{-1<\operatorname{Im}z<1\}$，$\mathbb{D}$为单位圆盘。\\
    (1) 写出$D_1$到$\mathbb{D}$的双全纯映射$f$，满足$f(0)=0$。\\
    (2) 写出$D_2$到$\mathbb{D}$的双全纯映射$f$，满足$f(0)=0$。\\
    (3) 设$f$是$D_1$到$D_2$的双全纯映射，写出$f'(0)$的所有可能值。
    \item 记$E=\mathbb{C}\setminus\{0,1\}$，设$f:E \to E$是双全纯映射。\\
    (1) 证明：$f$是分式线性变换。\\
    (2) 写出所有可能的$f$。
    \item 设$f$是单位圆盘$\mathbb{D}$上的全纯函数，
    对任意$c\in\mathbb{D}$，$f(z)-c$在$\mathbb{D}$上恰有两个零点（计重数）。\\
    (1) 证明：$|z|\to1$时，$|f(z)|\to1$。\\
    (2) 证明：存在$a_1,a_2\in\mathbb{D},\alpha\in[0,2\pi)$，
    使得$f(z)=e^{i\alpha}\dfrac{a_1-z}{1-\bar{a}_1z}\dfrac{a_2-z}{1-\bar{a}_2z}$。
\end{enumerate}

\section{2020春复变函数期中试卷}
\begin{enumerate}
\item 设 $f: U \rightarrow \mathbb{C}$ 是全纯函数，其中 $U$ 是 $\mathbb{C}$ 中区域，
对任意 $z \in U$，都成立 $\operatorname{Re} f(z)=(\operatorname{Im} f(z))^2$。
证明 $f$ 是常值函数。
\item 设 $g: U \rightarrow V$ 是全纯满射，其中 $U, V$ 是 $\mathbb{C}$ 中区域。
设 $f: V \rightarrow \mathbb{C}$ 是连续函数，使得 $f \circ g$ 是 $U$ 上的全纯函数。
证明 $f$ 是 $V$ 上的全纯函数。
\item 用留数定理计算积分
\[\int_0^{\infty} \frac{1}{1+x^4} dx.\]
\item 设 $\Omega$ 是由分段光滑的简单闭曲线围成的区域，
$f, \varphi$ 在 $\bar{\Omega}$ 的某个邻域内全纯。
假设 $f$ 在 $\partial \Omega$ 上没有零点。证明
\[\frac{1}{2 \pi i} \int_{\partial \Omega} \varphi(z) \frac{f^{\prime}(z)}{f(z)} d z
=\sum_{j=1}^N k_j \varphi(a_j)\]
其中 $a_1, a_2, \ldots, a_N$ 是 $f$ 在 $\Omega$ 中的全部（两两不同）零点，$k_j$ 是 $a_j$ 的阶。
\item 设 $\Omega=\{z \in \mathbb{C}:|z|<1,|z-1|<1\}$。
求从单位圆盘 $\mathbb{D}=\{z \in \mathbb{C}:|z|<$ $1\}$ 到 $\Omega$ 的双全纯映射。
\end{enumerate}
附加题。求出圆环 $A=\{1<|z|<2\}$ 的所有全纯自同构。

\section{2017春复变函数期末试卷解答}
\begin{enumerate}
\item[一]（每小题 3 分，共 30 分）填空题：
\begin{enumerate}[label=(\arabic*)]
\item 计算 $\cos (\mathrm{i} \log 3)=\underline{\ 5 / 3\ }$．
\item 设 $z=x+\mathrm{i} y, u(z)=\mathrm{e}^{x} \sin y$，
则 $u(z)$ 的共轭调和函数 $v(z)=\underline{\ -\mathrm{e}^{x} \cos y\ }$．
\item 将单位圆 $\mathbb{D}$ 映成右半平面 $\{w: \operatorname{Re} w>0\}$，
并且 $f(0)=1$ 的共形映射全体是 $\underline{\ f(z)=\dfrac{1-\mathrm{e}^{\mathrm{i} \theta} z}{1+\mathrm{e}^{\mathrm{i} \theta} z},\ \theta \in \mathbb{R}\ }$。
\item 积分 $\displaystyle \frac{1}{2 \pi \mathrm{i}} \int_{|z-1|=1} \frac{\sin (\pi z/4)}{z^{2}-1} {\rm d} z=\underline{\ \sqrt{2}/4\ }$．
\item 函数 $f(z)=z \mathrm{e}^{1/z}$ 在 $\infty$ 处的留数 $\operatorname{Res}(f, \infty)=\underline{\ -1/2\ }$．
\item 将函数 $f(z)=\dfrac{z}{(z-1)(z-\mathrm{i})}$ 在 $z=-1$ 处展开成幂级数，其收敛半径为 $\underline{\ \sqrt{2}\ }$．
\item 设函数 $f(z)$ 是 $z^{1 / 3}$ 在 $\mathbb{C} \setminus (-\infty, 0]$ 上的单值支，满足 $f(1)=1$，
则 $f(\mathrm{i})=\underline{\ \mathrm{e}^{\mathrm{i}\pi/6}\ }$．
\item 函数 $f(z)=\dfrac{z}{1-z}$ 在 $\infty$ 处的 Laurent 展开的主要部分是 $\underline{\ 0\text{ 或 消失}\ }$．
\item 单位圆 $\mathbb{D}$ 内 $0$ 和 $1 / 2$ 之间的双曲距离 $d_{\mathbb{D}}(0,1 / 2)=\underline{\ \log 3\ }$．
\item 设 $v(z)$ 在 $D(a, r)$ 上调和，$u(z)=\log \dfrac{1}{|z-a|}+v(z), z \in D(a, r) \setminus \{a\}$，
则 $u(z)$ 在 $a$ 点的积分周期 $P=\underline{\ -2\pi\ }$.
\end{enumerate}

\item[二]（每小题 4 分，共 12 分）完整正确地叙述下列定义或定理。

（1）Morera 定理.

答：设函数 $f(z)$ 在区域 $\Omega$ 上连续，且对任意闭三角形 $\Delta \subset \Omega$，积分
$$\int_{\partial \Delta} f(z) dz=0,$$
则 $f(z)$ 在 $\Omega$ 上解析．

（2）Riemann 映射定理.

答：设 $\Omega \subset \mathbb{C}$ 是单连通区域，且 $\Omega \neq \mathbb{C}$，
则对任意 $a \in \Omega$，存在唯一的共形映射 $f: \Omega \rightarrow \mathbb{D}$ 
使得 $f(a)=0, f^{\prime}(a)>0$．

（3）次调和函数.

答：设 $u(z)$ 是区域 $\Omega$ 上实值连续函数，
对任意 $z_{0} \in \Omega$，存在 $\rho>0$，使得圆盘 $D(z_{0}, \rho) \subset \Omega$，
且对任意 $0<r<\rho$，满足如下次均值不等式
$$u(z_{0}) \leq \frac{1}{2 \pi} \int_{0}^{2 \pi} u(z_{0}+r \mathrm{e}^{\mathrm{i} \theta}) d \theta,$$
则称 $u(z)$ 是 $\Omega$ 上次调和函数.

或

设 $u(z)$ 是区域 $\Omega$ 上实值连续函数，对任意圆盘 $D(z_{0}, r) \subset \Omega$ 以及 $D(z_{0}, r)$ 上的调和函数 $v(z)$，
函数 $u(z)-v(z)$ 在 $D(z_{0}, r)$ 满足最大值原理，则称 $u(z)$为 $\Omega$ 上次调和函数。

\item[三]（10 分）设 $f(t)$ 是定义在 $[0,1]$ 上的连续复值函数。定义
$$g(z)=\int_{0}^{1} f(t) \mathrm{e}^{tz} dt, \quad z \in \mathbb{C}.$$

证明：$g(z)$ 是 $\mathbb{C}$ 上解析函数。

证一：
幂级数 $\displaystyle \mathrm{e}^{tz}=\sum_{n=0}^{\infty} \frac{(tz)^{n}}{n!}$ 对给定的 $z \in \mathbb{C}$ 关于 $t \in[0,1]$ 一致收敛. 
又 $f(t)$ 连续，$|f(t)| \leq M$。故积分和求和可交换，即
$$g(z)=\int_{0}^{1} \sum_{n=0}^{\infty} f(t) \frac{t^{n} z^{n}}{n!} dt
=\sum_{n=0}^{\infty} z^{n}\left(\frac{1}{n!} \int_{0}^{1} f(t) t^{n} dt\right).$$
上述幂级数的系数
$$a_{n}=\frac{1}{n!} \int_{0}^{1} f(t) t^{n} dt$$
满足
$$|a_{n}| \leq \frac{1}{n!} \int_{0}^{1}|f(t)| dt \leq \frac{M}{n!},$$
故收敛半径为无穷大. 因此，$g(z)$ 是 $\mathbb{C}$ 上解析函数.

证二：
对任意 $z, z^{\prime} \in \mathbb{C}$，
$$\frac{g(z^{\prime})-g(z)}{z^{\prime}-z}
=\int_{0}^{1} f(t) \frac{\mathrm{e}^{tz^{\prime}}-\mathrm{e}^{tz}}{z^{\prime}-z} dt
=\int_{0}^{1} f(t) t \mathrm{e}^{tz}\left(\frac{\mathrm{e}^{t(z^{\prime}-z)}-1}{t(z^{\prime}-z)}\right) dt.$$
因此，当 $z^{\prime} \rightarrow z$ 时，被积函数关于 $t \in[0,1]$ 一致收敛于 $f(t) t \mathrm{e}^{tz}$，极限和积分可交换. 因此，
$$\lim_{z^{\prime} \rightarrow z} \frac{g(z^{\prime})-g(z)}{z^{\prime}-z}
=\int_{0}^{1} f(t) t \mathrm{e}^{t z} dt$$
存在，即 $g(z)$ 对任意 $z \in \mathbb{C}$ 可导.
由 Goursat 定理，$g(z)$ 是 $\mathbb{C}$ 上解析函数.

证三：
由于当 $z^{\prime} \rightarrow z \in \mathbb{C}$ 时， 
$\mathrm{e}^{tz^{\prime}} \rightarrow \mathrm{e}^{tz}$ 关于 $t \in[0,1]$ 一致收敛，
故极限和积分可交换，$\lim_{z^{\prime} \rightarrow z} g(z^{\prime})=g(z)$, $g(z)$ 连续。

又对任意闭三角形 $\Delta \subset \mathbb{C}$，
由于 $f(t) \mathrm{e}^{t z}$ 在 $[0,1] \times \Delta$ 上一致连续，故
$$\int_{\partial \Delta} g(z) dz
=\int_{\partial \Delta} \int_{0}^{1} f(t) \mathrm{e}^{t z} dt dz
=\int_{0}^{1} f(t) \int_{\partial \Delta} \mathrm{e}^{t z} dz dt=0.$$
由 Morera 定理，$g(z)$ 是 $\mathbb{C}$ 上解析函数.

\item[四]（12 分）设 $u(z)$ 是区域 $\Omega$ 上的实值调和函数，
$\dfrac{\partial u(z)}{\partial z}$ 的零点集在 $\Omega$ 中有聚点，证明：$u(z)$ 为常数。

证一：由 $\Delta u(z)=\dfrac{\partial}{\partial \bar{z}} \dfrac{\partial u(z)}{\partial z}=0$ 知，
$\dfrac{\partial u(z)}{\partial z}$ 是 $\Omega$ 上解析函数. 
由唯一性定理，$\dfrac{\partial u(z)}{\partial z}$在 $\Omega$ 上恒为 $0$. 
又若记 $z=x+\mathrm{i} y$，
$$\frac{\partial u(z)}{\partial z}
=\frac{1}{2}\left(\frac{\partial u(z)}{\partial x}
-\mathrm{i} \frac{\partial u(z)}{\partial y}\right)=0,$$
由 $u(z)$ 为实值函数得
$$\frac{\partial u(z)}{\partial x}=0, \quad \frac{\partial u(z)}{\partial y}=0, 
\quad \forall z \in \Omega.$$
因此，$u(z)$ 为常数.

证二：设 $E \subset \Omega$ 是 $\dfrac{\partial u(z)}{\partial z}$ 的零点集，
$z_{0}$ 是 $E$ 在 $\Omega$ 内的一个聚点。由连续性，$z_{0} \in E$。
作圆 $D(z_{0}, \rho) \subset \Omega$，
则 $u(z)$ 在 $D(z_{0}, \rho)$ 上有共轭调和函数 $v(z)$，
使得 $f(z)=u(z)+\mathrm{i} v(z)$ 是 $D(z_{0}, \rho)$ 上解析函数. 由于
$$\frac{\partial u(z)}{\partial z}
=\frac{1}{2}\left(\frac{\partial u(z)}{\partial x}
-\mathrm{i} \frac{\partial u(z)}{\partial y}\right)$$
以及 $u(z)$ 是实函数，
$$\frac{\partial u(z)}{\partial z}=0 \Longleftrightarrow 
\frac{\partial u(z)}{\partial x}=\frac{\partial u(z)}{\partial y}=0, 
\quad z \in E.$$

由 Cauchy--Riemann 方程，
$$\frac{\partial v(z)}{\partial x}=\frac{\partial v(z)}{\partial y}=0, \quad 
z \in E \cap D(z_{0}, \rho).$$

因此，$f^{\prime}(z)=0, z \in E \cap D(z_{0}, \rho)$。
由唯一性定理，$f(z)=c, z \in D(z_{0}, \rho)$ 为常数.
从而 $u(z)=\operatorname{Re} c, z \in D(z_{0}, \rho)$ 为常数。
由调和函数的唯一性定理， $u(z)=\operatorname{Re} c, z \in \Omega$ 为常数.

\item[五]（12 分）设 $\Omega$ 是单连通区域，且 $\Omega \neq \mathbb{C}$, 
$f: \Omega \rightarrow \Omega^{\prime}=f(\Omega)$ 是共形映射.
记 $d(z, E)=\min_{\zeta \in E}|\zeta-z|$ 表示点 $z$ 到闭集 $E$ 的欧氏距离.
证明：对任意 $z \in \Omega$，
$$\frac{1}{4}\left|f^{\prime}(z)\right| d(z, \partial \Omega) 
\leq d(f(z), \partial \Omega^{\prime}) 
\leq 4\left|f^{\prime}(z)\right| d(z, \partial \Omega).$$

证一：
给定 $z \in \Omega$，由 Riemann 映射定理，
存在共形映射 $g: \mathbb{D} \rightarrow \Omega$，使得 $g(0)=z$. 
由 Koebe $1 / 4$ 定理和 Schwarz 引理的推论，
$$\frac{1}{4}\left|g^{\prime}(0)\right| \leq d(z, \partial \Omega) 
\leq\left|g^{\prime}(0)\right|. \tag{1}$$

又 $h=f \circ g: \mathbb{D} \rightarrow \Omega^{\prime}$ 共形，且 $h(0)=f(z)$. 因此，同理得
$$\frac{1}{4}\left|h^{\prime}(0)\right| 
\leq d(f(z), \partial \Omega^{\prime}) 
\leq\left|h^{\prime}(0)\right|. \tag{2}$$

而 $h^{\prime}(0)=f^{\prime}(z) \cdot g^{\prime}(0)$，
代入$(2)$式，并除以$(1)$式即得
$$\frac{1}{4}\left|f^{\prime}(z)\right| d(z, \partial \Omega) 
\leq d(f(z), \partial \Omega^{\prime}) 
\leq 4\left|f^{\prime}(z)\right| d(z, \partial \Omega).$$

证二：
对给定 $z_{0} \in \Omega$，记 $\delta=d(z_0, \partial \Omega)$.
则圆盘 $D(z_{0}, \delta) \subset \Omega$, 
$f(z)$ 是 $D(z_{0}, \delta)$ 到 $\tilde{\Omega}=f(D(z_{0}, \delta)) \subset \Omega^{\prime}$ 的共形映射。
由 Koebe $1/4$ 定理，
$$d(f(z_{0}), \partial \Omega^{\prime}) 
\geq d(f(z_{0}), \partial \tilde{\Omega}) 
\geq \frac{1}{4}\left|f^{\prime}(z_{0})\right| \delta
=\frac{1}{4}\left|f^{\prime}(z_{0})\right| d(z_{0}, \partial \Omega).$$
将 $z_{0}$ 换为 $z \in \Omega$，得到不等式的左边一半.
利用 $f^{-1}$ 也为共形映射得到不等式的另一半.

\item[六]（12 分）设区域 $A=\left\{z: R_{1}<|z|<R_{2}\right\}$ 为圆环，
函数 $u(z)$ 在 $A$ 上调和，在 $\bar{A}$ 上连续，满足当 $|z|=R_{1}$ 时，$u(z)=0$；
当 $|z|=R_{2}$ 时，$u(z)=1$. 证明： $u(z)$ 在区域 $A$ 上不存在共轭调和函数。

证一：反证. 设 $u(z)$ 在 $A$ 上有共轭调和函数 $v(z)$，
则 $f(z)=u(z)+\mathrm{i} v(z)$ 为 $A$ 上解析函数. 
当 $|z| \rightarrow R_{1}$ 时，$\operatorname{Re} f(z) \rightarrow 0$; 
$|z| \rightarrow R_{2}$ 时，$\operatorname{Re} f(z) \rightarrow 1$，
且收敛关于 $\arg z$ 是一致的. 由此 $f(z)$ 不是常值函数.

对任意给定 $w \in \mathbb{C} \setminus (\{\operatorname{Re} w=0\} \cup\{\operatorname{Re} w=1\})$，
$w$ 到 $\{\operatorname{Re} w=0\} \cup\{\operatorname{Re} w=1\}$ 的距离 $d>0$.
对任意 $r_{1}>R_{1}$，当 $r_{1}$ 充分靠近 $R_{1}$ 时，
如果 $|z|=r_{1}$，就有 $|\operatorname{Re} f(z)-0|<d$；
同理，对任意 $r_{2}<R_{2}$ 且充分靠近 $R_{2}$，
如果 $|z|=r_{2}$，有 $|\operatorname{Re} f(z)-1|<d$.
这样，圆周 $|z|=r_{1}$ 和 $|z|=r_{2}$ 在 $f(z)$ 下的像曲线关于 $w$ 的绕数均为 $0$.
由辐角原理，$f(z)$ 在 $\left\{z: r_{1}<|z|<r_{2}\right\}$ 内不取 $w$ 值.
由 $r_{1}, r_{2}$ 的任意性，$f(z)$ 在 $A$ 内不取 $w$ 值.
因此，$f(z)$ 的像只能包含在直线 $\operatorname{Re} w=0$ 和 $\operatorname{Re} w=1$ 内，
由开映射原理，$f(z)$ 为常值函数，矛盾.

证二：反证。设 $u(z)$ 在 $A$ 上有共轭调和函数 $v(z)$，
使得 $f(z)=u(z)+\mathrm{i} v(z)$ 为 $A$上解析函数. 
由 Cauchy 定理，对任意 $R_{1}<r_{1}<r_{2}<R_{2}$，
$$\int_{|z|=r_{1}} \frac{f(z)}{z} d z=\int_{|z|=r_{2}} \frac{f(z)}{z} d z,$$
即$$\int_{0}^{2 \pi} f(r_{1} \mathrm{e}^{\mathrm{i} \theta}) d \theta
=\int_{0}^{2 \pi} f(r_{2} \mathrm{e}^{\mathrm{i} \theta}) d \theta.$$
两边取实部得
$$\int_{0}^{2 \pi} u(r_{1} \mathrm{e}^{\mathrm{i} \theta}) d \theta
=\int_{0}^{2 \pi} u(r_{2} \mathrm{e}^{\mathrm{i} \theta}) d \theta.$$
由于 $u(z)$ 在 $\bar{A}$ 连续，令 $r_{1} \rightarrow R_{1}, r_{2} \rightarrow R_{2}$ 得
$$\int_{0}^{2 \pi} u(R_{1} \mathrm{e}^{\mathrm{i} \theta}) d \theta
=\int_{0}^{2 \pi} u(R_{2} \mathrm{e}^{\mathrm{i} \theta}) d \theta.$$
但由 $u(z)=0,|z|=R_{1} ; u(z)=1,|z|=R_{2}$ 知，上式左边为 $0$，右边为 $2 \pi$，矛盾。

证三：令
$$\tilde{u}(z)=\frac{\log |z|-\log R_{1}}{\log R_{2}-\log R_{1}},$$
则 $\tilde{u}(z)$ 在 $A$ 上调和，在 $\bar{A}$ 上连续，
且当 $|z|=R_{1}$ 时，$\tilde{u}(z)=0$；当 $|z|=R_{2}$时，$\tilde{u}(z)=1$. 
由最大最小值原理 $u(z)=\tilde{u}(z)$.

在 $A \setminus [R_{1}, R_{2}]$ 上，
$\tilde{u}(z)$ 有共轭调和函数 $\tilde{v}(z)=\dfrac{\arg z}{\log R_{2}-\log R_{1}}$．
如果 $u(z)$有共轭调和函数 $v(z)$，则限制在 $A \setminus [R_{1}, R_{2}]$ 上，
$v(z)=\tilde{v}(z)+c, c \in \mathbb{R}$ 为常数. 这样 $v(z)$ 在 $A$ 上不连续，矛盾.

证四（利用 Schwarz 对称原理）：
设 $u(z)$ 有共轭调和函数 $v(z)$，则 $f(z)=u(z)+\mathrm{i} v(z)$ 在 $A$ 上解析，
当 $|z| \rightarrow R_{1}$时， $\operatorname{Re} f(z) \rightarrow 0$，
当 $|z| \rightarrow R_{2}$ 时， $\operatorname{Re} f(z) \rightarrow 1$. 
反复利用 Schwarz 对称原理， $f(z)$ 可以解析延拓成 $\mathbb{C} \setminus\{0\}$ 上的解析函数，
从而 $u(z)$ 可以延拓成 $\mathbb{C} \setminus \{0\}$上调和函数，
且当 $z \rightarrow 0$ 时，$u(z)=\operatorname{Re} f(z) \rightarrow-\infty$，
即 $0$ 是 $u(z)$ 的对数奇点，$u(z)$ 可以表示为
$$u(z)=\alpha \log |z|+\tilde{u}(z),$$
其中，$\tilde{u}(z)$ 在 $\mathbb{C}$ 上调和. 
与证三类似，$u(z)$ 的共轭调和函数必定有形式 $v(z)=\alpha \arg z+\tilde{v}(z)$，
其中 $\tilde{v}(z)$ 是 $\tilde{u}(z)$ 在 $\mathbb{C}$ 上的一个共轭调和函数，
不可能在 $A$（或整个 $\mathbb{C}$）上连续，矛盾.

也可以令 $f(z)=\mathrm{e}^{u(z)+\mathrm{i} v(z)}$ 在 $A$ 上解析，
且当 $|z| \rightarrow R_{1}$ 时，$|f(z)| \rightarrow 1$；
当 $|z| \rightarrow R_{2}$ 时，$|f(z)| \rightarrow e$. 
反复利用 Schwarz 对称原理，$f(z)$ 可解析延拓成 $\mathbb{C} \setminus \{0\}$ 上解析函数，
且当 $z \rightarrow 0$ 时，$f(z) \rightarrow 0$；
当 $z \rightarrow \infty$ 时， $f(z) \rightarrow \infty$，
即 $0$ 是 $f(z)$ 的零点（唯一零点），$\infty$ 是 $f(z)$ 的极点（唯一极点）。
因此，$f(z)=c z^{n}, c \neq 0$. 因此，$u(z)=n \log |z|+\log c$，同样导出矛盾.

（注：按讲义或课堂讲授，Schwarz 对称延拓要求 $f(z)$ 在 $\bar{A}$ 上连续，
但这儿没有证明这一点（因为，$v(z)$ 并不知道是否在 $\bar{A}$ 上连续）.
所以按讲义要求，上述证明有 bug。但教材上没有连续到边界这个要求，按教材上述证明没有问题。
事实上，按教材，调和函数 $u(z)$ 可以直接延拓成 $\mathbb{C} \setminus \{0\}$ 上调和函数，
使得 $0$ 是 $u(z)$ 的对数奇点.）

\item[七]（12 分）设 $f(z)$ 是单位圆 $\mathbb{D}$ 上解析函数，满足 $f(0)=0$，
以及 $|f(z)|<1$， $\forall z \in \mathbb{D}$。证明：

（1）对任意 $z \in \mathbb{D}$ 成立 $|f(z)+f(-z)| \leq 2|z|^{2}$，

（2）上式中等号成立，当且仅当 $f(z)=\mathrm{e}^{\mathrm{i} \theta} z^{2}, \theta \in \mathbb{R}$.

证：（1）令 $g(z)=\dfrac{f(z)+f(-z)}{2}$，则当 $|z|<1$ 时，$|g(z)|<1$. 
且 $g(0)=0$，$g^{\prime}(0)=\dfrac{1}{2}(f^{\prime}(0)-f^{\prime}(0))=0$.

方法一：令 $\varphi(z)=\dfrac{g(z)}{z^{2}}$，则 $0$ 是 $\varphi(z)$ 的可去奇点，
从而 $\varphi(z)$ 在 $\mathbb{D}$ 内全纯. 对任意 $0<r<1$，当 $|z|=r$ 时，
$$|\varphi(z)|=\frac{|g(z)|}{r^{2}}<\frac{1}{r^{2}}.$$
由最大模原理，对任意 $|z|<r$, $|\varphi(z)|<1/r^{2}$。
令 $r \rightarrow 1$，得到对任意 $z \in \mathbb{D}$，$|\varphi(z)| \leq 1$. 即
$$|f(z)+f(-z)| \leq 2|z|^{2}.$$

方法二：由 Schwarz 引理，$|g(z)| \leq|z|$。
令 $\varphi(z)=g(z) / z$，则 $|\varphi(z)| \leq 1$，且 $\varphi(0)=g^{\prime}(0)=0$。
由最大模原理，$|\varphi(z)|<1$。再由 Schwarz 引理，$|\varphi(z)| \leq|z|$，即得
$$|f(z)+f(-z)| \leq 2|z|^{2}.$$

（2）如果上式对某个 $z \neq 0$ 成为等式，则 $|\varphi(z)|=1$。
由最大模原理，$\varphi(z)=\mathrm{e}^{\mathrm{i} \theta}$。即
$$f(z)+f(-z)=2 \mathrm{e}^{\mathrm{i} \theta} z^{2} \tag{$*$}.$$

方法一：设
$$f(z)=\sum_{n=1}^{+\infty} a_{n} z^{n},$$
则有
$$f(z)+f(-z)=\sum_{k=1}^{+\infty} 2 a_{2k} z^{2k}. \tag{$**$}$$
比较 $(*)$ 和 $(**)$ 得 $a_{2}=\mathrm{e}^{\mathrm{i} \theta}$。

又由于 $|f(z)|<1$，得到
$$\frac{1}{2 \pi} \int_{0}^{2 \pi}|f(r \mathrm{e}^{\mathrm{i} \theta})|^{2} {\rm d} \theta
=\sum_{n=1}^{+\infty}|a_{n}|^{2} r^{2 n}<1.$$
令 $r \rightarrow 1$，得到
$$\sum_{n=1}^{+\infty}|a_{n}|^{2} \leq 1.$$
由于 $\left|a_{2}\right|=1$，所以对任意 $n \neq 2$, $a_{n}=0$. 于是
$$f(z)=\mathrm{e}^{\mathrm{i} \theta} z^{2}.$$
如果 $f(z)=\mathrm{e}^{\mathrm{i} \theta} z^{2}$，则题中不等式显然是等式.

方法二：
令 $f(z)=\mathrm{e}^{\mathrm{i} \theta} z^{2}+h(z)$，则由 $(*)$ 得
$$h(z)+h(-z)=0,$$
即 $h(z)$ 为奇函数. 我们要证当 $|z| \rightarrow 1$ 时，$h(z) \rightarrow 0$，
从而由最大模原理，$h(z) \equiv 0$，得到 $f(z)=\mathrm{e}^{\mathrm{i} \theta} z^{2}$.

首先 $|h(z)| \leq\left|\mathrm{e}^{\mathrm{i} \theta} z^{2}\right|+|f(z)| \leq 2$ 为有界函数.
如果当 $|z| \rightarrow 0$ 时，$h(z) \nrightarrow 0$, 
则存在 $z_{n} \in \mathbb{D}, z_{n} \rightarrow z^{*},|z^{*}|=1$，
使得 $h(z_{n}) \rightarrow A \neq 0$. 
这样 $h(-z_{n}) \rightarrow-A$. 因此，
$$f(z_{n}) \rightarrow \mathrm{e}^{\mathrm{i} \theta} z^{* 2}+A, \qquad 
f(-z_{n}) \rightarrow \mathrm{e}^{\mathrm{i} \theta} z^{* 2}-A.$$
两者必有一个的模长大于 $1$. 矛盾.
\end{enumerate}