== 2022--2023秋期中（猛班）==
\begin{itemize}
    \item[(一)]单项选择题
    \begin{itemize}
        \item[(a)]下列四个环中哪个是PID？
        \begin{itemize}
            \item[(A).]$\Z[x]$；
            \item[(B).]$\Z_n , n\ge 2$；
            \item[(C).]$\Q [x,y]$；
            \item[(D).]$\Z_p[x]$，$p$为素数。
        \end{itemize}
        \item[(b)]下列哪对Abel群$\textbf{不}$同构？
        \begin{itemize}
            \item[(A).]$\Z_6,\Z_2 \times \Z_3$；
            \item[(B).]$(\Z_6)^*,(\Z_2)^* \times (\Z_3)^*$；
            \item[(C).]$\Z_8,\Z_2 \times \Z_4$；
            \item[(D).]$(\Z_8)^*,(\Z_3)^* \times (\Z_3)^*$。
        \end{itemize}
        \item[(c)]考虑下面两个命题
        \begin{itemize}
            \item[(I).]设$f(x) \in \Z[x], 0 \neq g(x) \in \Z[x]$，
            则存在$q(x),r(x) \in \Z[x]$使得$f(x) = g(x)q(x) + r(x)$，
            且$\deg r(x) < \deg g(x)$。
            \item[(II).]设$A,B,C$是Abel群，若$A \times B \cong A \times C$，则$B \cong C$。
        \end{itemize}
        下面关于它们的判断$\textbf{正确}$的是？
        \begin{itemize}
            \item[(A).](I)错误，(II)正确；
            \item[(B).](I)正确，(II)错误；
            \item[(C).](I)错误，(II)错误；
            \item[(D).](I)正确，(II)正确。
        \end{itemize}
        \item[(d)]设$f:R \to S$是含幺交换环之间的非零环同态，则下列命题中$\textbf{正确}$的是？
        \begin{itemize}
            \item[(A).]若$R$是整区，则$f(R)$也是整区；
            \item[(B).]若$f$是满同态，且$I$是$R$的理想，则$f(I)$也是$S$的理想；
            \item[(C).]若$\mathfrak{p}$是$R$的素理想，则$f(\mathfrak{p})$也是$S$的素理想；
            \item[(D).]若$\mathfrak{m}$是$R$的极大理想，则$f(\mathfrak{m})$也是$S$的极大理想。
        \end{itemize}
    \end{itemize}
    \item[(二)]填空题
    \begin{itemize}
        \item[(a)]设$\sigma = (12345)(1234) \in S_5$，
        则$\sigma$的阶是 $\underline{\qquad\quad}$，
        $\sigma$是 $\underline{\qquad\quad}$ （填“奇”或“偶”）置换。
        设$\tau = (321)(21)(514) \in S_5$，则$\tau \sigma \tau^{-1}=\underline{\qquad\qquad\qquad}$。
        \item[(b)]$S_9$中与$(12345)(67)(89)$共轭的元素有 $\underline{\qquad\quad}$ 个，
        $S_9$中有 $\underline{\qquad\quad}$ 个$10$阶元。
        \item[(c)]$\Z_{54000}$有 $\underline{\qquad\quad}$ 个子群，
        $\Z_7 \times \Z_7 \times \Z_7$有 $\underline{\qquad\quad}$ 个子群。
    \end{itemize}
    \item[(三)]设$R$是含幺环。若$R$无非零幂零元，则称$R$是约化的。
    \begin{itemize}
        \item[(1)]证明$R$是约化的当且仅当$\forall x \neq 0,x^2 \neq 0$。
        \item[(2)]设$R$是约化的，$x,y \in R$使得$xy = 0$。证明：$yRx = \{0\}$。
        \item[(3)]设$R$是约化的，$x \in R$是幂等元，即$x^2 = x$。证明：$\forall y \in R,xy = yx$。
    \end{itemize}
    \item[(四)]考虑交换群$(\Q,+)$及其商群$\Q/\Z$，证明：
    \begin{itemize}
        \item[(1)]设$r \in \Z\setminus\{0\},s \in \N$，有$o(\frac{r}{s} + \Z) = \frac{s}{\operatorname{gcd}(r,s)}$；
        \item[(2)]对于任意的正整数$n$，$\Q/\Z$有且仅有一个$n$阶子群；
        \item[(3)]$\Q/\Z$中有限个元素生成的群均为循环群。
    \end{itemize}
    \item[(五)]设$R$为含幺交换环，$a,b \in R$。记$\bar{a} = a + (b)$为$a$在自然同态$R \to R/(b)$下的像。证明：
    \begin{itemize}
        \item[(1)]$(\bar{a}) = (a,b)/(b)$；
        \item[(2)]$(R/(b))/(\bar{a}) \cong R/(a,b)$，$(R/(b))/(\bar{a}) \cong (R/(a))/(\tilde{b})$，其中$\tilde{b} = b + (a)$是$b$在自然同态$R \to R/(a)$下的像；
        \item[(3)]记$\Z[\sqrt{-5}] = \{ a+b\sqrt{-5} \mid a,b \in \Z \} \subseteq \C$。定义环同态
        $$ \varphi :\Z[x]/(x+1) \to \Z[\sqrt{-5}]/(\sqrt{-5}+1)$$
        $$ \varphi (\overline{a+bx}) = \overline{a+b\sqrt{-5}},\ \ \forall a,b \in \Z$$
        请问$\varphi$是否为环同构？若是，请证明之；若否，请给出理由；
        \item[(4)]证明$\Z[\sqrt{-5}]/(2,\sqrt{-5}+1)$环同构于$\Z/2\Z$。
    \end{itemize}
    \item[(六)]设$G$是阶数为$2^n\cdot m$的群，其中$n \ge 1,m$为奇数。若$G$中含有$2^n$阶元，则$G$含有一个指数为$2^n$的正规子群。
\end{itemize}

== 2022--2023秋期末（猛班）==

一、\ 填空题
\begin{itemize}
\item[1.]设$\sigma=(12345)\in S_6$,则$\sigma^{-2}=\underline{\qquad\quad},\sigma^{-1}(126)\sigma=\underline{\qquad\quad}$.
\item[2.]已知$a=\bar{x}\in\mathbb{Q}[x]/(x^3+x+2)$,则$a^5$是否可逆？$\underline{\qquad\quad}$ (填“是”或“否”.)
若可逆,用$1,a,a^2$的线性组合表示之$\underline{\qquad\quad}$.
\item[3.]写出两个$\mathbb{F}_2$上的三次不可约多项式.
\item[4.]$833$阶群是否为Abel群？$\underline{\qquad\quad}$ (填“是”或“否”.)
\item[5.]$\mathbb{F}_8$中，$x^6+x^4+x^3+x-1$根的个数为$\underline{\qquad\quad}$.
\item[6.]写出$3996$阶Abel群的所有可能结构.
\item[7.]$x^4+2\in\mathbb{Q}[x]$在$\mathbb{Q}$上的分裂域(记为$E$)是$\underline{\qquad\quad}$.
$[E:\mathbb{Q}]=\underline{\qquad\quad}$.
$E/\mathbb{Q}$ $\underline{\qquad\quad}$ (填“是”或“否”.)为Galois扩张.
\end{itemize}
二、\ 解答题
\begin{itemize}
\item[1.]若$R_1,R_2$是两个同构的整区，$F_1,F_2$是对应的分式域. 证明：$F_1,F_2$同构.\\
\item[2.]$E/F$是域扩张，$u\in E$，$[F(u):F]=p$，其中$p$是素数.
证明：$\forall m\in \mathbb{N},0<m<p$，$F(u^m)=F(u).$\\
\item[3.]求$f(x)=(x^2-5)(x^3+1)$在$\mathbb{Q}$上的分裂域$E$,描述$\operatorname{Gal}(E/\mathbb{Q})$的结构.\\
\item[4.]构造一个$\mathbb{F}_5[x]/(x^2+2)$到$\mathbb{F}_5[x]/(x^2+3)$的具体域同构并证明它是同构.\\
\item[5.]证明：$715$阶群的中心包含该群的一个Sylow-$13$子群.
\end{itemize}

== 2022--2023秋期末（雪班）==
\begin{itemize}
\item[1.]（20分）设$G$是一个群，$A,B$是$G$的子群，记$AB=\{ab|a\in A,b\in B\}$。\\
\begin{itemize}
    \item[(a)]如果$G$是Abel群，证明$AB$是$G$的子群；
    \item[(b)]设$G=S_3$，$A=\{1,(13)\}$，$B=\{1,(12)\}$。问：$AB$是否是$S_3$的子群，说明理由。
\end{itemize}
\item[2.]（20分）设$R=\{m+n\sqrt{11}i\in\mathbb{C}|m,n\in\Z\}$是$\mathbb{C}$的子环，
$i^2=-1$。定义映射$N:R\to\Z$如下：$N(m+n\sqrt{11}i)=m^2+11n^2$。
\begin{itemize}
    \item[(a)]证明：对任意$x,y\in R$，都有$N(xy)=N(x)N(y)$；
    \item[(b)]求$R^*=\{x\in R|\text{存在 }y\in R\text{ 使得 }xy=yx=1\}$，说明理由；
    \item[(c)]$R$是否是唯一分解整区（U.F.D.）？说明理由。
\end{itemize}
\item[3.]（15分）设$G$是一个有限群，$|G|=48$。证明：$G$有$16$阶或$8$阶的正规子群。

\item[4.]（15分）设$f(x)=x^6+\sqrt{5}x^5+\sqrt{7}x^3+\sqrt[3]{11}x+1\in\R[x]$，
$\alpha\in\mathbb{C}$是$f(x)$的一个零点。证明：$\alpha$是$\Q$上的代数元。

\item[5.]（15分）设$\mathbb{F}_{81}$为$81$元的有限域。
$T=\{\alpha\in\mathbb{F}_{81}|\mathbb{F}_{81}=\mathbb{F}_3(\alpha)\}$。
求$T$中元素的个数，说明理由。

\item[6.]（15分）设$E/\Q$是一个有限Galois扩张且$[E:\Q]=4$。
若$\operatorname{Gal}(E/\Q)$不是循环群，证明存在$\alpha,\beta\in E$
使得$E=\Q(\alpha,\beta)$且$\alpha^2,\beta^2\in\Q$。

\end{itemize}

== 2020--2021秋期中（猛班） ==

\begin{itemize}
    \item[(一)]单项选择题（共30分）
    \begin{itemize}
        \item[(a)]$A_3$，$A_4$，$A_5$，$M_n(F)$（矩阵环；$F$为一个域）中
        哪些是单群或单环？\  $\underline{\qquad\quad}$
        \begin{itemize}
            \item[(A).]$A_4$，$A_5$，$M_n(F)$；
            \item[(B).]$A_3$，$A_5$，$M_n(F)$；
            \item[(C).]$A_3$，$A_4$，$M_n(F)$；
            \item[(D).]$A_3$，$A_4$，$A_5$。
        \end{itemize}
        \item[(b)]下列哪个环是整环？\  $\underline{\qquad\quad}$
        \begin{itemize}
            \item[(A).]$\Z_4$；
            \item[(B).]$\Z[i]$，$i$是虚数单位；
            \item[(C).]二元多项式环的商$R[x,y]/I$，$I=\langle xy\rangle$；
            \item[(D).]$n$元实矩阵环$M_n(\R)$。
        \end{itemize}
        \item[(c)]设$R_1,R_2$是带$1$的环，$f:R_1\to R_2$是非零环同态。考虑下面两个命题：
        \begin{itemize}
            \item[(I).]设$S$是$R_1$的子环，则$f(S)$是$R_2$的子环。
            \item[(II).]设$J$是$R_2$的素理想，
            则$f^{-1}(J)=\{x\in R_1|f(x)\in J\}$是$R_1$的素理想。
        \end{itemize}
        下面关于它们的判断$\textbf{正确}$的是？\  $\underline{\qquad\quad}$
        \begin{itemize}
            \item[(A).](I)错误，(II)正确；
            \item[(B).](I)正确，(II)错误；
            \item[(C).](I)与(II)都错误；
            \item[(D).](I)与(II)都正确。
        \end{itemize}
        \item[(d)]设$R$是整区，下列命题中，哪个$\textbf{正确}$？ \ $\underline{\qquad\quad}$
        \begin{itemize}
            \item[(A).]设$I$是$R$的一个非平凡理想，则$R/I$必为整区；
            \item[(B).]$R$完全有可能包含一个非整子环；
            \item[(C).]设$S$是一个交换环，$f:R\to S$是一个非零环同态，则其像$f(R)$必为整区；
            \item[(D).]即使$R$不是域，$R$完全有可能包含一个子环且该子环为域。
        \end{itemize}
        \item[(e)]设$G$是乘法群，下列哪个命题$\textbf{正确}$？\  $\underline{\qquad\quad}$
        \begin{itemize}
            \item[(A).]$G$的任何一个循环子群都是单群；
            \item[(B).]如$G$是Abel群，则$G$的任何子群、商群必为Abel群；
            \item[(C).]如$G$是无限群，则$G$中至少有一个元素的阶(order)非有限；
            \item[(D).]除了幺元以外，$G$至少有一个有限阶元素。
        \end{itemize}
        \item[(f)]设$R$为整区，$R[x,y]$为$R$上的二元多项式环，
        下列哪个命题$\textbf{正确}$？ \ $\underline{\qquad\quad}$
        \begin{itemize}
            \item[(A).]如$R[x,y]$是UFD，则$R$必为UFD；
            \item[(B).]如$R[x,y]$是UFD，则$R[x]$不一定是UFD；
            \item[(C).]如$R$是PID，则$R[x,y]$也是PID；
            \item[(D).]以上命题都不对。
        \end{itemize}
    \end{itemize}
    \item[(二)]（15分）设$p$为素数，试证明：
    \begin{itemize}
            \item[(1)]群$\Z_{p^3}$与群$\Z_p\oplus\Z_p\oplus\Z_p$不同构；
            \item[(2)]求出$\Z_{p^3}$的所有子群；
            \item[(3)]求出$\Z_p\oplus\Z_p\oplus\Z_p$的所有子群。
    \end{itemize}

    \item[(三)]（15分）设$F_2$是含两个元素的域，$n\ge4$为正整数，
    $$R=\{(a_{ij})\in M_n(F_2)|a_{ij}=0,\forall\ 1\le j<i\le n\}.$$
    试分别举例说明：
    \begin{itemize}
            \item[(1)]环$R$不是交换环；
            \item[(2)]环$R$不是整环；
            \item[(3)]设理想$I\subseteq R$含有矩阵$E_{23}$
            （即在$(2,3)$位置为$1$且其余位置为$0$的矩阵），则$I$至少含有多少个元素。
    \end{itemize}

    \item[(四)]（15分）设$G$为一个群，$H$和$K$分别为$G$的有限指数子群，
    即$[G:H]<+\infty$，$[G:K]<+\infty$。如果$G=HK$，试证明$[G:H\cap K]=[G:H][G:K]$。

    \item[(五)]（15分）设$D$为可除环，$K$为$D$的可除子环，记$D^*,K^*$分别为$D,K$的乘法群。
    设$N=N_{D^*}(K^*),C=C_{D^*}(K^*)$分别为$K^*$在$D^*$中的正规化子和中心化子。
    对任意$h\in D\setminus\{0,1\}$，证明$h,1-h\in N$当且仅当$h\in K\cup C$。

    \item[(六)]（10分）设$f(x)=a_nx^n+a_{n-1}x^{n-1}+\cdots+a_0$
    为一个$n$次实系数多项式，$x_1,x_2,\cdots,x_n$为给定的$n$个实数，
    令$S=\{I|I\subseteq\{1,2,\cdots,n\}\}$。
    求$\sum_{I\in S}(-1)^{|I|}f(\sum_{i\in I}x_i)$的值，其中$|I|$表示$I$中的元素个数。
    若$I$是空集，则规定$(-1)^{|I|}f(\sum_{i\in I}x_i)=f(0)=a_0$。

\end{itemize}
\begin{proofc}[（六）\ 解答]
    设$F(x_1,\cdots,x_n)=\sum_{I\in S}(-1)^{|I|}f(\sum_{i\in I}x_i)$，
    注意\begin{align*}
        &\textstyle F(x_1,\cdots,x_{j-1},0,x_{j+1},\cdots,x_n)\\
        &\textstyle =\sum_{I\notni x_j}(-1)^{|I|}f(\sum_{i\in I}x_i)
        +\sum_{I\ni x_j}(-1)^{|I|}f(\sum_{i\in I}x_i)\\
        &\textstyle =\sum_{I\notni x_j}(-1)^{|I|}f(\sum_{i\in I}x_i)
        +\sum_{I\notni x_j}(-1)^{|I\cup\{x_j\}|}f(\sum_{i\in I}x_i+0)=0,
    \end{align*}
    于是$x_j|F(x_1,\cdots,x_n)$。
    因为$\deg F\le n$，所以$F(x_1,\cdots,x_n)=Cx_1\cdots x_n$。

    观察到$F$的表达式中唯一出现$x_1\cdots x_n$一项的是$(-1)^na_n(x_1+\cdots+x_n)^n$，
    故$C=(-1)^na_nn!$。
\end{proofc}

== 2020--2021秋期末（雪班、远班） ==
\begin{itemize}
\item[（一）]（20分）填空题
\begin{itemize}
\item[1.] 方程$x^2-1=0$在环$R=\Z/8\Z$中有 $\underline{\qquad\quad}$ 个不同的解。
\item[2.] 设$u=\sqrt{2}-\sqrt{3}$，写出$u$在有理数域$\Q$上的首一极小多项式：$\underline{\qquad\qquad\qquad\quad}$。
\item[3.] 写出对称群$S_4$的一个Sylow $3$子群：$\underline{\qquad\qquad\qquad\quad}$。
\item[4.] 设$f(x)=x^4+x^2+1$。在$\mathbb{F}_2[x]$中将$f(x)$分解成不可约多项式的乘积：$\underline{\qquad\qquad\qquad\quad}$。\\
          在$\mathbb{F}_3[x]$中将$f(x)$分解成不可约多项式的乘积：$\underline{\qquad\qquad\qquad\quad}$。
\item[5.] 设$f(x)\in\Q[x]$是一个$3$次不可约多项式，$r_1,r_2,r_3$是$f(x)$在$\mathbb{C}$中的零点，
          满足条件$r_1\in \R,r_2\notin \R,r_3\notin \R$。
          设$E=\Q(r_1,r_2,r_3)$，则扩张次数$[E:\Q]=\underline{\qquad\quad}$。
\end{itemize}

\item[（二）]（20分）选择题（单选）
\begin{itemize}
\item[6.] 下列关于群的命题，哪个正确？$\underline{\qquad\quad}$
\begin{itemize}
    \item[A.] 最小的有限单群是$60$阶群；
    \item[B.] 如果一个群没有非平凡子群，则该群为循环群；
    \item[C.] 如果一个群的每个非平凡子群都是循环群，则该群为Abel群；
    \item[D.] 无限阶的Abel群不是有限生成的。
\end{itemize}
\item[7.] 多项式$f(x)=x^4+1$在域$\mathbb{F}_9$上有几个不同的零点？$\underline{\qquad\quad}$\\
\,\,A. $1$;\qquad\qquad B. $2$;\qquad\qquad C. $3$;\qquad\qquad D. $4$.
\item[8.] 下列环中，不是域的是 $\underline{\qquad\quad}$.
\begin{itemize}
    \item[A.] $\mathbb{F}_3[x]/(x^2+1)$；
    \item[B.] $\Q[x]/(x^4-x^2+1)$；
    \item[C.] $\Z[x]/(x^2+2)$；
    \item[D.] $\Z/31\Z$。
\end{itemize}
\item[9.] 设$G$为一个$24$阶的Abel群。设$n_4$为$G$中$4$阶子群的个数，则$n_4$不可能等于 $\underline{\qquad\quad}$.\\
\,\,A. $4$;\qquad\qquad B. $3$;\qquad\qquad C. $2$;\qquad\qquad D. $1$.
\item[10.] 设$E/F$为有限Galois扩张且$\operatorname{Gal}(E/F)$同构于交错群$A_4$。则下列命题不成立的是 $\underline{\qquad\quad}$.
\begin{itemize}
    \item[A.] 存在一个中间域$K$且$[E:K]=3$，使得$E/K$为Galois扩张；
    \item[B.] 存在一个中间域$K$且$[E:K]=4$，使得$E/K$为Galois扩张；
    \item[C.] 存在一个中间域$K$且$[E:K]=4$，使得$K/F$为Galois扩张；
    \item[D.] 存在一个中间域$K$且$[E:K]=6$，使得$K/F$为Galois扩张。
\end{itemize}
\end{itemize}

\item[（三）]（18分）设$\Z[i]=\{a+bi\in\mathbb{C}|a,b\in\Z\}$是高斯整数环，$i^2=-1$。
定义映射$N:\Z[i]\to\Z$如下：$N(a+bi)=a^2+b^2$。
\begin{itemize}
    \item[(i)] 证明：对任意$x,y\in\Z[i]$，都有$N(xy)=N(x)N(y)$；
    \item[(ii)] 证明：$x\in\Z[i]$是乘法可逆元当且仅当$N(x)=1$。
    \item[(iii)] $11$是否是$\Z[i]$的不可约元？说明理由。
\end{itemize}

\item[（四）]（12分）设$G$是有限群，$|G|=132$。证明：$G$不是单群。

\item[（五）]（15分）设$r_1,r_2,r_3$为多项式$f(x)=x^3-2x+1\in\Q[x]$在$\mathbb{C}$
中的三个根，设$E=\Q(r_1,r_2,r_3)$。求$\operatorname{Aut}(E/\Q)$，说明理由。

\item[（六）]（15分）设$F$是一个域且其特征为素数$p$。设$a\in F$，$f(x)=x^p-x-a\in F[x]$。
设$\overline{F}$是$F$的代数闭包，$u\in\overline{F}$是$f(x)$的一个零点。
\begin{itemize}
    \item[(i)] 证明：$u+1$是$f(x)$的零点；
    \item[(ii)] 设$E=F(u)$，证明$E/F$是Galois扩张。
\end{itemize}
\end{itemize}