\setdisplaytitle{试卷：抽象代数}
\sethtmltitle{试卷：抽象代数}
\def\Q{\mathbb{Q}}
\def\C{\mathbb{C}}

== 2025--2026秋期末 （平行班） ==
\begin{enumerate}
\item 判断题 (15分)
\begin{enumerate}
    \item 忘了。
    \item 特征为零的域都是完全域。
    \item 一个交换环是整环当且仅当零理想是素理想。
    \item 特征非零的域都是有限域。
    \item 交换幺环上的 $n$ 次多项式最多有 $n$ 个互异根。
\end{enumerate}
\item （10分）
定义集合 $R = \left\{ \begin{pmatrix}z & w \\ -\overline{w} & \overline{z}\end{pmatrix} \mid z, w \in \mathbb{C} \right\}$，证明：
\begin{enumerate}
    \item $R$ 在 $M_{2}(\mathbb{C})$ 的加法和乘法下成环；
    \item $R$ 与 Hamilton 四元数体同构。
\end{enumerate}

\item （15分）
考虑 $\mathbb{F}_{3}$ 上的多项式 $f(X) = X^{4} + X^{3} + X - 1$，
设 $\alpha \in \overline{\mathbb{F}}_{3}$ 是 $f(X)$ 的一个根。
\begin{enumerate}
    \item 列出 $\mathbb{F}_{3}$ 上所有的二次首一不可约多项式；
    \item $f(X)$ 是否是不可约多项式？请说明理由；
    \item 求 $\mathbb{F}_{3}(\alpha)$ 的元素个数；
    \item $f(X)$ 在 $\mathbb{F}_{3}(\alpha)$ 上有几个不同根？
\end{enumerate}

\item （20分）
考虑实数子集 $R = \{ a + b\sqrt{10} \mid a, b \in \mathbb{Z} \}$，
定义 $N: R \rightarrow \mathbb{Z}$ 为 $N(a + b\sqrt{10}) = a^{2} - 10b^{2}$
\begin{enumerate}
    \item 证明：$\alpha \in R^{*}$ 当且仅当 $N(\alpha) = \pm 1$；
    \item $R^{*}$ 是否是有限群？说明理由；
    \item 证明：$R$ 中每个非零非单位元都可分解为有限个不可约元的乘积；
    \item $2$ 是否是 $R$ 中的不可约元？是否是 $R$ 中的素元？给出理由；
    \item $R$ 是否是 UFD？说明理由.
\end{enumerate}

\item （20分）
\begin{enumerate}
    \item 求 $[\mathbb{Q}(\sqrt{5}, \sqrt{-5}): \mathbb{Q}]$；
    \item 证明 $\mathbb{Q}(\sqrt{5}, \sqrt{-5}) = \mathbb{Q}(\sqrt{5} + \sqrt{-5})$。
    \item $\mathbb{Q}(\sqrt{5})$和$\mathbb{Q}(\sqrt{-5})$是否同构？说明理由.
\end{enumerate}

\item （20分）
设 $\alpha = \sqrt{1 + \sqrt{2}}$。
\begin{enumerate}
    \item 求 $\alpha$ 在 $\mathbb{Q}$ 上的极小多项式 $f(X)$；
    \item 求 $f(X)$ 在 $\mathbb{Q}$ 上的分裂域 $E$，并求 $[E: \mathbb{Q}]$；
    \item 证明 $E/\mathbb{Q}$ 是 Galois 扩张，并求 $\mathrm{Gal}(E/\mathbb{Q})$；
    \item $\text{Gal}(E/\mathbb{Q})$中有几个$4$阶元，有几个$2$阶元？
    \item 求 $E/\mathbb{Q}$ 所有的中间域 $M$，使得 $M/\mathbb{Q}$ 是 Galois 扩张。
\end{enumerate}
\end{enumerate}

== 2025--2026秋期末（远班）==
\begin{itemize}
\item[(一)] 选择题
    \item[1.] 设 $G$ 为 $2026$ 阶群, 以下 $G$ 一定有的性质是 ().
    \begin{itemize}
        \item[(A)] $G$ 是 Abel 群;
        \item[(B)] $G$ 是单群;
        \item[(C)] $G$ 中有一个正规循环子群;
        \item[(D)] $G$ 中有唯一的二阶元.
    \end{itemize}
    \item[2.] $\mathbb{F}_9$ 中 $x^4 + x^3 - x + 1$ 的根的个数为 ().
    \begin{itemize}
        \item[(A)] $0$ 个;
        \item[(B)] $1$ 个;
        \item[(C)] $2$ 个;
        \item[(D)] $3$ 个;
    \end{itemize}
    \item[3.] 下列扩张中不是 Galois 扩张的有 ().
    \begin{itemize}
        \item[(A)] $\mathbb{Q}(\sqrt{2}, \sqrt{3}) / \mathbb{Q}$;
        \item[(B)] $\mathbb{Q}(\sqrt[3]{2}, \sqrt[3]{6}) / \mathbb{Q}$;
        \item[(C)] $\mathbb{Q}(\sqrt{2026})/\mathbb{Q}$;
        \item[(D)] $\mathbb{Q}(\sqrt[3]{5}, i) / \mathbb{Q}$.
    \end{itemize}
    \item[4.] $600$ 阶 Abel 群的不同的种类数为 ().
    \begin{itemize}
        \item[(A)] $3$ 个;
        \item[(B)] $4$ 个;
        \item[(C)] $5$ 个;
        \item[(D)] $6$ 个;
    \end{itemize}
    \item[5.] 下列命题中正确的有 ().
    \begin{itemize}
        \item[(A)] 整区的商环还是整区;
        \item[(B)] 整区到一个环的非零环同态的像还是整区;
        \item[(C)] 无限域的非平凡子环还是域;
        \item[(D)] 无限域到一个环的非零环同态的像还是域.
    \end{itemize}
    \item[6.] 下列命题中正确的有 ().
    \begin{itemize}
        \item[(A)] 主理想整区一定是欧氏整区;
        \item[(B)] 欧氏整区一定是唯一分解整区;
        \item[(C)] 唯一分解整区一定是主理想整区;
        \item[(D)] 欧氏整区一定是主理想整区.
    \end{itemize}
\item[(二)] 设有群 $G$, $a \in G$. 定义 $T(a) = \{ gag^{-1} \mid g \in G \}$.
若 $H$ 是 $G$ 的子群, $b_1, b_2 \in T(a)$, $b_1 \in H$, $b_2 \notin H$, $H$ 是否是 $G$ 的正规子群? 说明理由.
\item[(三)] 设 $F$ 是域, \[
    R = \left\{ \sum_{i=0}^n a_i x^i \in F[x]\Bigm| a_1 = 0 \right\}.
\]

证明以下命题:
\begin{itemize}
    \item[(1)] $R$ 是 $F[x]$ 的子环;
    \item[(2)] $x^2$ 是 $R$ 中的不可约元, 但 $(x^2)$ 不是 $R$ 中的素理想;
    \item[(3)] $(x^2, x^3)$ 不是 $R$ 中的主理想;
    \item[(4)] $R$ 中的任何理想最多由两个元素生成.
\end{itemize}

\item[(四)] 设 $p$ 是奇素数, $n$ 是大于 $2$ 的正整数且 $p \nmid n$.
设 $E = \mathbb{F}_{p^n}$. 设 $c \in E$ 满足 $c^{p^2} = c$. 考虑 \[
    f(x) = x^{p^2} - x - c \in E[x].
\]
\begin{itemize}
    \item[(1)] $x^{p^2} - x$ 在 $E$ 上是否分裂? 说明理由;
    \item[(2)] 证明 $f(x)$ 在 $E$ 中没有根;
    \item[(3)] 证明 $f(x)$ 在 $E$ 中是可约的;
    \item[(4)] 若 $g(x) \in E[x]$ 是不可约多项式, $g(x) | f(x)$, 求 $\deg g(x)$ 的可能取值.
\end{itemize}

\item[(五)]
设 $K$ 是任意域, 正整数 $n$ 大于 $3$ . 令 $E = K(x_1, x_2, \dots, x_n)$ 是 $K$ 上的 $n$ 元有理函数域.
设 $\sigma \in \operatorname{Aut}(E)$ 是满足 \[
    \sigma(x_k) = x_{k+1}\ (k = 1, 2, \dots, n, x_{n+1} = x_1), \sigma|_K = \mathrm{id}_K
\]
的 $E$ 的自同构. 设 $F = E^{\langle \sigma \rangle}$ 是所有在由 $\sigma$ 生成的子群 $\langle \sigma \rangle$ 下保持不变的元素构成的 $E$ 的子域.
\begin{itemize}
    \item[(1)] 证明 $E/F$ 是 Galois 扩张;
    \item[(2)] 证明 $F(x_1^2 + x_2^2) / F$ 是 Galois 扩张;
    \item[(3)] 证明 $F(x_1^2 + x_2^2) = E$.
\end{itemize}
\end{itemize}

== 2025--2026秋期中 （平行班） ==
\begin{enumerate}
\item 判断题 (15分)
\begin{enumerate}
    \item 在 $n$ 阶群中一定存在 $n$ 阶元;
    \item 任意有限群均同构于某个 $S_n$ 的子群;
    \item 在群中两个有限阶元的乘积的阶还是有限的;
    \item 整数集 $\mathbb{Z}$ 关于减法构成群;
    \item 在域中乘法消去律成立.
\end{enumerate}

\item （12分）
\begin{enumerate}
    \item 在 $S_n$ 中计算 $(12)(123)(1234)$;
    \item 在 $S_6$ 中计算 $(123456)^{2025}$;
    \item 请问 $S_6$ 中有多少个元素 $a$ 满足 $a^{2025} = e$.
\end{enumerate}

\item （18分）
设 $d \in \mathbb{Z}$.令 $R = \mathbb{Q}[\sqrt{d}] := \left\{a + b \sqrt{d} \in \mathbb{C} \mid a,b \in \mathbb{Q}\right\}$.
\begin{enumerate}
    \item 证明 $R$ 关于数的加法和乘法构成幺环.请问 $R$ 是否构成域,并说明理由;
    \item 请问当 $d$ 满足什么条件时,加群 $(R,+)$ 同构于 $\mathbb{Q} \times \mathbb{Q}$;
    \item 令 $S = \left\{\frac{a+b\sqrt{-3}}{2} \in \mathbb{C} \mid a,b \in \mathbb{Z}, a+b \in 2\mathbb{Z}\right\}$.证明 $S$ 是 $\mathbb{Q}[\sqrt{-3}]$ 的子环;
    \item 求 $S$ 的单位群 $S^*$.
\end{enumerate}

\item （20分）
设 $\mathbb{Z}_{21}^{*} := \left\{\bar{a} \in \mathbb{Z}_{21} \mid (a,21)=1\right\}$ 是模 $21$ 的乘法群.
\begin{enumerate}
    \item 求 $|\mathbb{Z}_{21}^{*}|$;
    \item 求 $\langle \bar{2} \rangle$ 和 $\langle \overline{20} \rangle$;
    \item 请问 $\mathbb{Z}_{21}^{*}$ 是否是 $\langle \bar{2} \rangle$ 和 $\langle \overline{20} \rangle$ 的内直积?证明你的结论;
    \item 请问是否存在满同态 $\mathbb{Z}_{24} \to \mathbb{Z}_{21}^{*}$?证明你的结论.
\end{enumerate}

\item （20分）
设 $G = \mathrm{GL}_{2}(\mathbb{F}_{3})$.考虑 $G$ 按矩阵乘法作用于列向量空间 $\mathbb{F}_{3}^{2} := \mathbb{F}_{3} \times \mathbb{F}_{3}$ 上.
\begin{enumerate}
    \item 请问该作用有几个轨道?写出每一个轨道;
    \item 令 $x = (\bar{1},\bar{0})^{t}$,求稳定子群 $\mathrm{Stab}_{G}(x)$;
    \item 求 $G$ 的阶 $|G|$;
    \item 在 $G$ 中所有的非平凡正规子群中,最大的阶是多少?
\end{enumerate}

\item （15分）
设 $G$ 为 $2025$ 阶群.
\begin{enumerate}
    \item 若 $G$ 为 Abel 群,请问 $G$ 的同构类有多少种,并分类 $G$ 所有可能的同构类;
    \item 若 $P$ 和 $Q$ 是 $G$ 的两个不同的 Sylow $5$-子群,证明 $P \cap Q$ 是 $G$ 的正规子群;
    \item 证明 $2025$ 阶群一定不是单群.
\end{enumerate}
\end{enumerate}

== 2025--2026秋期中（远班、猛班）==
\begin{itemize}
\item[(一)] (20分) 设$G$为群，考虑子群列：$K \triangleleft H \triangleleft G$，求解下列问题：
    \item[(a)] 举例说明：一般情况下$K \triangleleft G$ 不一定成立； \\
    \item[(b)]若 $|G| = p_1p_2\cdots p_n$，其中 $ p_1,p_2,\cdots, p_n $ 为互不相同的素数，证明 $K \triangleleft G$。

\item[(二)] (20分) 设 $H$ 是群 $G$ 的子群，定义 $K := \bigcap_{g \in G} gHg^{-1}$ 为 $H$ 所有共轭的交。 \\
   \item[(a)]证明：$K$ 是 $G$ 的正规子群； \\
   \item[(b)]若 $[G:H]$ 有限，证明 $\{ gHg^{-1} \mid g \in G \}$ 为有限集合； \\
   \item[(c)]若 $[G:H]$ 有限，证明 $[G:K]$ 有限。

\item[(三)] (20分) 设$R$ 为交换环，$I$ 是 $R$ 的一个理想，定义 $I$ 的根理想为：
    \[
    \sqrt{I} = \{ x \in R \mid \exists\, n \in \mathbb{Z}_{>0} \text{ 使得 } x^n \in I \}.
    \]
    回答下列问题：
    \item[(a)]证明：$\sqrt{I} \subseteq \bigcap_{P \supseteq I,P\text{ 是素理想}} P$。 \\
    \item[(b)]求出 $\mathbb{Z}_6$ 的所有素理想，求出这个例子中的理想 $\sqrt{0}$ 和 $\bigcap_{P\text{ 是素理想}} P$。

\item[(四)] (20分) 设 $G$ 是一个$24$阶有限群。若$G$的中心平凡，试证 \\
   \item[(1)]$G$ 没有正规的 Sylow-$3$子群； \\
   \item[(2)]利用(1)证明 $G \cong S_4$。

\item[(五)] (20分) 令 $p>2$ 为素数。设$G$ 是一个 $p(p+1)$ 阶群，且没有正规的 Sylow-$p$ 子群。考虑集合
    \[
    X = \{ a \in G \mid \mathrm{ord}(a) \nmid p \}.
    \]
   \item[(a)]求集合 $X$ 中元素的个数； \\
   \item[(b)]对于一个 Sylow-$p$ 子群 $P$，对任意 $a \in X$，我们有 $aP \neq Pa$； \\
   \item[(c)]对于 $X$ 中的任意两个元素 $a,b$，存在元素 $g \in P$ 使得 $a = g^{-1} b g$； \\
   \item[(d)]证明：$p + 1$ 是 $2$ 的幂。
\end{itemize}

== 2024--2025秋期末（猛班）==

一、\ 填空题
\begin{itemize}
\item[1.]设$\sigma=(1357)\in S_8$,则$\sigma^{-3}=\underline{\qquad\quad},\sigma^{-1}(2468)\sigma=\underline{\qquad\quad}$.
\item[2.]已知$a=\bar{x}\in\mathbb{Q}[x]/(x^3+x+2)$,则$a^5$是否可逆？$\underline{\qquad\quad}$ (填“是”或“否”.)若可逆,用$1,a,a^2$的线性组合表示之$\underline{\qquad\quad}$.（待修正）
\item[3.]写出一个$\mathbb{F}_3$上的四次不可约多项式.
\item[4.]$833$阶群是否为Abel群？$\underline{\qquad\quad}$ (填“是”或“否”.)（待修正）\\
\item[5.]$\mathbb{F}_9$中，$x^6+x^4+x^3+x-1$根的个数为$\underline{\qquad\quad}$.（待修正）
\item[6.]写出$2025$阶Abel群的所有可能结构，请用书中形式写.
\item[7.]$x^4+5\in\mathbb{Q}[x]$在$\mathbb{Q}$上的分裂域(记为$E$)是$\underline{\qquad\quad}$.
$[E:\mathbb{Q}]=\underline{\qquad\quad}$.
$E/\mathbb{Q}$ $\underline{\qquad\quad}$(填“是”或“否”.)为Galois扩张.
\end{itemize}
二、\ 解答题
\begin{itemize}
\item[1.]对于群$G$，$C(G)$是其中心，证明：$C(G/C(G))$不可能是非平凡循环群.\\
\item[2.]对于环$\mathbb{Z}[i]$，$I=(3)$是其理想，请问$I$是素理想吗？请问$I$是极大理想吗？\\
\item[3.]令$S=\{n \in \mathbb{Z} \bigm| p|n\}$，在$\mathbb{Z}\times S$上建立“关系”，
$(n_1,s_1) \sim(n_2,s_2) \Leftrightarrow n_1s_2=n_2s_1.$
    \begin{itemize}
        \item[(1)] 证明$\sim$是等价关系。
        \item[(2)] 在$\mathbb{Z}_{(p)}=\mathbb{Z}\times S/\sim$上定义加法和乘法：
        $$[(n_1,s_1)]+[(n_2,s_2)]=[(n_1s_2+n_2s_1,s_1s_2)],\ [(n_1,s_1)] \cdot [(n_2,s_2)]=[(n_1n_2,s_1s_2)].$$
        证明其良定且使$\mathbb{Z}_{(p)}$成为环。
        \item[(3)] 证明$\mathbb{Z}_{(p)}$为PID.
        \item[(4)] 求$\mathbb{Z}_{(p)}$的分式域。
    \end{itemize}
\item[4.]令$R=\{a+3b\sqrt{10}|a,b \in \mathbb{Z}\}$.
    \begin{itemize}
        \item[(1)] 证明$R$是一个整区。
        \item[(2)] 举出$R$的一列（无限可列）可逆元。
        \item[(3)] 证明$2$是$R$中不可逆元。
    \end{itemize}
\item[5.]$K=\mathbb{Q}(\sqrt{2}+\sqrt{3}),\theta=\sqrt{(2-\sqrt{2})(9-6\sqrt{3})},E=K(\theta)\neq K$.
问$E/\mathbb{Q}$是不是Galois扩张？如果是，求$\operatorname{Gal}(E/\mathbb{Q})$.
\end{itemize}

== 2024--2025秋样卷（芬班）==

\begin{enumerate}
    \item (15分) 设$R$是含幺环，$I$是$R$的理想，$\pi:R \to R/I$是商映射，$T$是$R/I$的理想。
    \begin{enumerate}[label=(\alph*)]
        \item 若$T$是$R/I$的素理想，证明$\pi^{-1}(T)$是$R$的素理想。
        \item 反之，若$\pi^{-1}(T)$是$R$的素理想，$T$是否一定是$R/I$的素理想？说明理由。
    \end{enumerate}
    \item (20分) 设$R=\{m+n\sqrt{-11}\in\mathbb{C}|m,n\in\Z\}$是$\mathbb{C}$的子环。
    定义映射$N:R\to\Z$如下：$N(m+n\sqrt{-11})=m^2+11n^2$。
    \begin{enumerate}[label=(\alph*)]
        \item 证明：对任意$x,y \in R$，都有$N(xy)=N(x)N(y)$；
        \item 求$R^*=\{x \in R|\text{存在 }y \in R\text{ 使得 }xy=yx=1\}$，说明理由；
        \item $R$是否为唯一分解整区（UFD）？说明理由。
    \end{enumerate}
    \item (20分) 令$f(x)=x^4-5x^3-2x^2+2x-2\in\mathbb{Q}[x]$。
    \begin{enumerate}[label=(\arabic*)]
        \item 求$f(x)$的一个有理数根；
        \item 设$u\in\R$为$f(x)$的一个非有理数根，求域扩张次数$[\mathbb{Q}(u):\mathbb{Q}]$；
        \item 将$(1+u)^{-1}$表示成$1,u$和$u^2$的$\mathbb{Q}$-线性组合。
    \end{enumerate}
    \item (20分) 设$F\subset\mathbb{C}$为$x^3-2$在$\mathbb{Q}$上的分裂域。
    \begin{enumerate}[label=(\arabic*)]
        \item 验证$\omega=\frac{-1+\sqrt{3}i}{2} \in F$，并求出扩张次数$[\mathbb{Q}(\omega):\mathbb{Q}]$；
        \item 计算$[F:\mathbb{Q}]$(请写出严格的计算过程)，并给出域扩张$F/\mathbb{Q}$的一组基。
    \end{enumerate}
    \item (15分) 设$p$是一个素数，$K=\mathbb{F}_p(t)$为多项式环$\mathbb{F}_p[t]$的分式域。
    \begin{enumerate}[label=(\arabic*)]
        \item 证明$x^p-t$在多项式环$K[x]$中不可约，并且在$K$的代数闭包$\bar{K}$中有一个$p$-重根；
        \item 构造一个$p$次首一不可约多项式$f(x) \in K[x]$，满足$f$在$\bar{K}$中没有重根(解释理由)。
    \end{enumerate}
    \item (10分) 设$G$为Galois群$\operatorname{Gal}(\mathbb{F}_{q^n}/\mathbb{F}_q)$。对于每个$a\in\mathbb{F}_{q^n}$，令
    \[T(a)=\sum_{\sigma \in G}\sigma(a), \qquad N(a)=\prod_{\sigma \in G}\sigma(a).\]
    求证：
    \begin{enumerate}[label=(\arabic*)]
        \item $T:\mathbb{F}_{q^n}\to\mathbb{F}_q$是$\mathbb{F}_q$-线性满射；
        \item $N(\mathbb{F}^*_{q^n})\subset\mathbb{F}^*_q$且$N:\mathbb{F}^*_{q^n}\to\mathbb{F}^*_q$是乘法群的满同态。
    \end{enumerate}
\end{enumerate}

== 2024--2025秋期中（猛班）==
\begin{itemize}
    \item[(一)]（共20分）分别举出满足下列条件的群$G$各一例：
    \begin{enumerate}[label=(\arabic*)]
        \item $G$ 是一个不可交换的无限群；
        \item $G$ 是一个阶可被 $2^{10}$ 整除的有限单群；
        \item $G$ 中每个元素的阶均有限，但 $G$ 是无限群；
        \item $G$ 中除了子群 $\{e\}$ 外，每个子群都有无限多个正规子群；
        \item $G$ 是这样一个 $m(m > 1)$ 阶群，对 $m$ 的每个因子 $n$，
        $G$ 都有唯一的一个 $n$ 阶子群。
    \end{enumerate}
    \item[(二)]（20分）设$G$是有限阶群， $K\triangleleft H \triangleleft G$，
    且 $\gcd(|K|, |H/K|)=1$，证明：$K \triangleleft G$。
    \item[(三)]（20分）设 $R$ 是一个非零环，且 $R$ 除了零理想外没有其他理想，
    证明：$R$ 的中心 $Z(R)$ 是一个域。
    \item[(四)]（20分）叙述欧氏整区的定义，并证明每一个欧氏整区都是主理想整区(PID)。
    \item[(五)]（20分）设 $G$ 是有限群，$P$ 是 $G$ 的 Sylow-$p$ 子群 ($p$ 为素数)，
    $H \lhd G$，$p \mid |H|$。记 $n_p(G)$ 为 $G$ 的 Sylow-$p$ 子群的个数。证明：
    \begin{itemize}
        \item[(1)] $P \cap H$ 是 $H$ 的一个 Sylow-$p$ 子群;
        \item[(2)] $n_p(G) = [G : N_G(P)]$;
        \item[(3)] $n_p(H) \mid n_p(G)$。
    \end{itemize}
\end{itemize}


== 2023--2024秋期中（猛班）==
\begin{itemize}
    \item[(一)]单项选择题（共30分）
    \begin{itemize}
        \item[(a)]$\mathbb{Z},A_2,A_4,A_6,M_n(F)$（矩阵环；$F$为一个域）中哪些是单群或单环？
        \begin{itemize}
            \item[(A).]$\mathbb{Z},A_4,A_6,M_n(F)$；
            \item[(B).]$\mathbb{Z},A_2,A_6,M_n(F)$；
            \item[(C).]$\mathbb{Z},A_2,A_4,M_n(F)$；
            \item[(D).]$A_2,A_4,A_6$；
            \item[(E).]以上都不对。
        \end{itemize}
        \item[(b)]下列哪个环是主理想整环？
        \begin{itemize}
            \item[(A).]$\mathbb{Z}_{25}$；
            \item[(B).]$\mathbb{Z}[x]$；
            \item[(C).]二元多项式环的商$\mathbb{R}[x,y]/I,I=\langle x^2+1,y^2-2\rangle$；
            \item[(D).]$\mathbb{R}[x,y]/I,I=\langle x^2+1\rangle$。
        \end{itemize}
        \item[(c)]设$R_1,R_2$是带$1$的环，$f:R_1\to R_2$是非零环同态.考虑下面两个命题：
        \begin{itemize}
            \item[(I).]设$I$是$R_1$的理想，则$f(I)$是$R_2$的理想.
            \item[(II).]设$J$是$R_2$的极大理想，则$f^{-1}(J)=\{x\in R_1|f(x)\in J\}$是$R_1$的素理想.
        \end{itemize}
        下面关于它们的判断$\textbf{正确}$的是？
        \begin{itemize}
            \item[(A).](I)错误，(II)正确；
            \item[(B).](I)正确，(II)错误；
            \item[(C).](I)与(II)都正确；
            \item[(D).](I)与(II)都错误。
        \end{itemize}
        \item[(d)]设$R$是整区，下列命题中，哪个$\textbf{正确}$？
        \begin{itemize}
            \item[(A).]设$I$是$R$的一个非平凡理想，则$R/I$必为整区；
            \item[(B).]$R$不可能包含一个非整子环；
            \item[(C).]设$S$是一个交换环，$f:R\to S$是一个非零环同态，则其像$f(R)$必为整区；
            \item[(D).]如果$R$不是域，$R$不可能包含任何非零子域。
        \end{itemize}
        \item[(e)]设$G$是一个群，下列哪个命题$\textbf{正确}$？
        \begin{itemize}
            \item[(A).]$G$的任何一个循环子群都是有限群；
            \item[(B).]如$G$是Abel群，则$G$的任何子群、商群必为Abel群；
            \item[(C).]如$G$是无限群，则$G$中至少有一个元素的阶(order)非有限；
            \item[(D).]除了幺元以外，$G$至少有一个素数阶元素。
        \end{itemize}
    \end{itemize}
    \item[(二)]（15分）设$S_5$中的两个元素$\sigma=(12)(45),\tau=(12345)$，试证明：
    \begin{itemize}
        \item[(1)]子群$H=\langle\sigma,\tau\rangle$满足$|H|\geq30$；
        \item[(2)]$A_5=\langle\sigma,\tau\rangle$。
    \end{itemize}
    \item[(三)]（15分）设$G$为群，$H$为$G$的正规子群，$K$为$G$的子群，
    若对于任意元素$x\in G/H$，都存在唯一的$k\in K$使$kH=x$，证明$K\cong G/H$。
    \item[(四)]（15分）设$P$是有限群$G$的Sylow $p$-子群，
    $H$为$G$的子群且$N_G(P)\subseteq H$，证明：$H=N_G(H)$。
    \item[(五)]（15分）设$G$为一个群，$H$为$G$的一个子群。
    \begin{itemize}
        \item[(1)]令$H_G=\bigcap_{g\in G}g^{-1}Hg$，
        证明$H_G$是$G$的包含于$H$的最大正规子群；
        \item[(2)]设从$G$到$S_n$只有有限多个不同的群同态，
        证明$G$只有有限多个指数为$n$的子群。
    \end{itemize}
    \item[(六)]（10分）设$R_1,R_2$为两个带$1$的环，
    如果映射$\varphi:R_1\to R_2$满足$\varphi(1_{R_1})=1_{R_2}$，且(1), (2)成立：
    \begin{itemize}
        \item[(1)]$\varphi:(R_1,+)\to(R_2,+)$是群同态；
        \item[(2)]对任意$a,b\in R_1$，$\varphi(ab)=\varphi(b)\varphi(a)$，
        则称$\varphi$是一个反同态。又，如果$\varphi$满足(1), (2)$'$：
        \item[(2)$'$]对任意$a,b\in R_1$，$\varphi(ab)=\varphi(a)\varphi(b)$
        或$\varphi(b)\varphi(a)$，则称$\varphi$是一个半同态。
    \end{itemize}
    试证明：若映射$\varphi$是半同态，则$\varphi$是同态或反同态。
\end{itemize}

