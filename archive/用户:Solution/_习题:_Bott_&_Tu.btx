\subsection{纤维化的同伦序列}

\textbf{补充练习2.} 当$q\geq 2$时，对$t\in [0,1]$定义微分同胚$h_t:S^q\rightarrow S^q$,
        $$h_t(x)=(x_0\cos(t\pi)-x_1\sin(t\pi), x_0\sin(t\pi)+x_1\cos(t\pi),x_2,\cdots,x_q).$$
试用$h_t$直接证明$\pi_q(X)$是一个Abel群，$q\geq 2$.\par
\textbf{证明：}
    重定义$I=[-\frac{1}{2},\frac{1}{2}]^q$，
    设$\varphi:S^q\rightarrow \mathbb{R}^q$是以$(0,0,\cdots,1)$为极点的球极投影，
    $\psi:\mathbb{R}^q\rightarrow I^q$是只改变到原点距离的光滑同胚.\par
    \qquad $h_t$给出了$\operatorname{id}$与$(x_0,x_1,x_2,\cdots,x_q)
    \mapsto (-x_1,-x_0,x_2,\cdots,x_q)$的光滑同伦，故
    \[\psi\circ \varphi \circ h_t \circ \varphi^{-1} \circ \psi^{-1}: I^q\rightarrow I^q\]
    给出了$\operatorname{id}$与$(x_1,x_2,x_3, \cdots,x_q)\mapsto (-x_2,-x_1,x_3, \cdots, x_q)$光滑同伦.\par
    \qquad 故
    $$\gamma(t_1,\cdots,t_q)=\begin{cases} \alpha(2t_1+\frac{1}{2},t_2,\cdots,t_q), &-\frac{1}{2}\leq t_1\leq 0\\
            \beta(2t_1-\frac{1}{2},t_2,\cdots,t_q), &0\leq t_1\leq \frac{1}{2}\end{cases}$$
        光滑同伦于
            \begin{align*}
                \tilde{\gamma}(t_1,t_2,\cdots,t_q)&=\gamma(-t_1,-t_2,t_3,\cdots,t_q)\\
                &=\begin{cases} \alpha(-2t_1+\frac{1}{2},-t_2,t_3,\cdots,t_q), &-\frac{1}{2}\leq -t_1\leq 0\\
                    \beta(-2t_1-\frac{1}{2},-t_2,t_3\cdots,t_q), &0\leq -t_1\leq \frac{1}{2}\end{cases}\\
                &=\begin{cases} \beta(-2t_1-\frac{1}{2},-t_2,t_3,\cdots,t_q), &-\frac{1}{2}\leq t_1\leq 0\\
                    \alpha(-2t_1+\frac{1}{2},-t_2,t_3\cdots,t_q), &0\leq t_1\leq \frac{1}{2}\end{cases}\\
                &\sim \begin{cases} \beta(2t_1+\frac{1}{2},t_2,t_3,\cdots,t_q), &-\frac{1}{2}\leq t_1\leq 0\\
                    \alpha(2t_1-\frac{1}{2},t_2,t_3\cdots,t_q), &0\leq t_1\leq \frac{1}{2}\end{cases}\\
            \end{align*}
        最后一步是对$\beta,\alpha$分别应用同伦. 故有$[\alpha][\beta]=[\beta][\alpha]$.
\subsection{Hurewicz同构定理}
\begin{itemize}
    \item[17.3] 设$(X,d)$是紧度量空间，$f:X \to X$满足$d(f(x),f(y))=d(x,y)$对任意$x,y \in X$成立。证明$f$是满射。

    \textbf{证明：} 对任何的$x \in X$，反复作用$f$所得的序列写为$\{f^{n}(x)\}$。
    其必有子列$\{f^{n_k}(x)\}$收敛，则有
    \[\lim_{k\to\infty}d(f^{n_k}(x),f^{n_{k+1}}(x))=0,\]
    换句话说\[\lim_{k\to\infty}d(x,f^{n_{k+1}-n_k}(x))=0,\]
    从而$d(x,f(X))=0$，结合$f(X)$亦为紧集得出$x \in f(X)$。
\end{itemize}

