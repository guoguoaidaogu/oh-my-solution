待补充.
\end{proofc}

\subsection{分式理想}

\begin{exercise}
    环$R$中的任何可逆分式理想都是投射$R$-模.
\end{exercise}

\begin{exercise}
    Dedekind整环中的任一理想类都可由一个整理想作为代表元.
\end{exercise}


\section{整数环}

\subsection{幂整基}
\begin{exercise}
    令$\alpha \in \C$满足方程$x^{3}-x^{2}-2x-8 = 0$. 
    考虑$K = \Q(\alpha)$.

    \begin{itemize}
        \item[(1)] 证明：$\mathscr{O}_{K} = \Z + \Z \alpha + \Z \dfrac{4}{\alpha}$.
        \item[(2)] 证明：对于任意$\omega \in \mathscr{O}_{K}$，
        $\mathscr{O}_{K} \neq \Z[\omega]$.
    \end{itemize}
\end{exercise}

\subsection{纯三次域的整基}

\begin{exercise}
    对于$K = \Q(\sqrt[3]{n})$，其中$n \in \Z$无三次因子.
    设$n = ab^{2}$，其中$a,b \in \Z$，且$a$无平方因子，则$\mathscr{O}_{K}$的一组整基为

    \begin{equation*}\begin{aligned}
        \mathscr{O}_{K} :=
        \begin{cases}
            \Z + \Z \sqrt[3]{n} + \Z \dfrac{\sqrt[3]{n^{2}}}{b},
            & \text{若 } m^{2} \not\equiv 1 \mod 9, \\
            \Z + \Z \sqrt[3]{n} + \Z \dfrac{b^{2} + b^{2}\sqrt[3]{n}
             +\sqrt[3]{n^{2}}}{3b},
            & \text{若 } m \equiv \pm 1 \mod 9.
        \end{cases}
    \end{aligned}\end{equation*}

\end{exercise}

\begin{exercise}
证明：$Q(\sqrt[3]{175})$的一组整基为$\{1,\sqrt[3]{175},\sqrt[3]{245}\}$.
\end{exercise}

\subsection{分圆域}
\begin{exercise}
    若$\zeta_{n}$是$\Q$上的$n$次本原单位根，则$\Q[\zeta_{n}+\zeta_{n}^{-1}]$
    的整数环为$\Z[\zeta_{n} + \zeta_{n}^{-1}]$.
\end{exercise}

\subsection{差分理想}

\begin{exercise}
    考虑$n$次单扩张$K = \Q(\alpha)$，且整数环恰为$\Z[\alpha]$.
    令$f(x)$为$\alpha$在$\Q$上的极小多项式.
    令$f(x) = (x-\alpha)(b_{0} + b_{1}x + \cdots +b_{n-2}x^{n-2} + b_{n-1}x^{n-1})$，
    则$\{1,\alpha,\cdots,\alpha^{n-1}\}$的对偶基为
    \[\{\frac{b_{0}}{f'(\alpha)},\cdots,\frac{b_{n-2}}{f'(\alpha)},\frac{1}{f'(\alpha)}\}.\]
    从而$\mathscr{D}^{-1} = \dfrac{1}{f'(\alpha)}(\Z + \Z b_{0} + \cdots + \Z b_{n-2})$.
\end{exercise}

\begin{exercise}
    若$K = \Q(\alpha)$，且整数环恰为$\Z[\alpha]$.
    令$f(x)$为$\alpha$在$\Q$上的极小多项式. 则$\mathscr{D} = (f'(\alpha))$.

    由此计算$\Q(\sqrt{d})$与$\Q[\zeta_{p}]$的差分理想，
    其中$d$为无平方因子整数，而$\zeta_{p}$为$p$次单位根.
\end{exercise}

\subsection{判别式与理想类群}
\begin{exercise}
    计算下列域的整数环与理想类群：
    \begin{itemize}
        \item $\Q(\sqrt{14})$.
        \item $\Q(\sqrt{105})$.
        \item $\Q(\sqrt[3]{2})$.
        \item $\Q(\alpha)$，其中$\alpha$为$x^{5}-x+1=0$的一根.
    \end{itemize}
\end{exercise}

\begin{exercise}
    若素数$p \equiv 11 \mod 12$，则$\mathrm{Cl}(\Q(\sqrt{-p}))$中含有
    大于$\log_{3}(p)$的元.
\end{exercise}

\begin{exercise}
    给定正整数$d_{K}$，则只能找到有限多个数域，使得其判别式为$d_{K}$.
    从而数域（对于$\Q$）的扩张次数趋于$\infty$时，判别式$d_{K}$也趋于$\infty$.
\end{exercise}

\begin{exercise}
    若数域$K/\Q$的判别式无平方因子，则$K$无非平凡子域.
\end{exercise}

