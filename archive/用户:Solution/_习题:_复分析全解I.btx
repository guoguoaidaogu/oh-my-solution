    \item[4.3.5]

此即讲义 (4.10)对应文段所述事实, 不再赘述.

    \item[4.3.6]容易验证 $\frac{\partial^2g(z,w)}{\partial z\partial\overline{w}}$ 
    是 $\Omega$ 上关于 $z$ 和 $\zeta=\overline{w}$ 的全纯函数.
    令 $\omega= \frac {\partial g( z, w) }{\partial z}\mathrm{d}w$,那么
$$\operatorname{d}(f\omega) = \mathrm{d}f\wedge\omega+f \mathrm{d}\omega 
= - f(w)\frac{\partial^{2}g(z,w)}{\partial z\partial\overline{w}} 
\mathrm{d}w\wedge \mathrm{d}\overline{w}.$$

    对给定 $z\in\Omega,\ \varepsilon>0$,
    作 $U_\varepsilon=\{|w-z|<\varepsilon\}\subset\Omega,
    \ \tilde{\Omega}=\Omega\setminus\overline{U}_\varepsilon$.
    由 Stokes 公式以及 $g(z,w)|_{w\in\partial\Omega}=0$,
    当$\varepsilon>0$ 充分小时有
    $$g(z,w)=-\log|z-w|+u(z,w),$$
    
    其中 $u(z,w)$ 关于 $z,w$ 在 $|z-w|\leq\varepsilon$ 时调和.因此
    $$
    \frac{\partial g(z,w)}{\partial z}
    =-\frac{1}{2}\frac{1}{z-w}+\frac{\partial u(z,w)}{\partial z}.
    $$
    于是
    $$
    \begin{gathered}
    \frac{1}{\pi i} \int _ { | w - z | = \varepsilon }
    f(w)\frac{\partial g(z,w)}{\partial z} \mathrm{d}w \\
    \begin{aligned}&=\frac{1}{2\pi i}\int_{|w-z|=\varepsilon}
        \frac{f(w)}{w-z} \mathrm{d}w+\frac{1}{\pi i}\int_{|w-z|=\varepsilon}
        f(w)\frac{\partial u(z,w)}{\partial z} \mathrm{d}w.\end{aligned} 
    \end{gathered}
    $$
    
    上式右端第二个积分的被积函数有界，当 $\varepsilon\to0$ 时积分极限为 $0$. 
    令$\varepsilon\to0$ 并利用 Cauchy 积分公式即得结论.
\end{itemize} 

 \subsection*{4.4 多连通 Riemann 映射定理}

 \begin{itemize}
    \item[4.4.1]

 假若存在题中所述解析函数 $f(z)$, 则对任一 $w  \not = 0,1 $, 
 由辐角定理, 都有 \begin{align*}N(w, f(A(r,R)))&=n(w, \partial f(A(r,R))) \\
 &= n(w, f|_{\{|z| = r\}})+ n(w, f|_{\{|z| = R\}}) = 0,\end{align*} 
 故 $f(A(r,R))\subseteq \{0,1\}$. 由开映射定理知 $f$是常数, 矛盾.

    \item[4.4.2]

 取区域 $\Omega$的同调基 $\{\gamma_i\}$, 由 $d^*\omega(z,E_i)$ 是闭形式, 
 由其道路积分的同伦不变性以及  $\lim_{z \to \partial E_i} \omega_j(z) 
 =\lim_{z \to \partial E_i} \omega_{\Omega}(z,E_{j}) = \delta_{ij} $, 得
 $$\int_{\gamma_{i}}\mathrm{d}^*\sum_{k=1}^{n-1}\lambda_k\omega_k 
 = \lambda_i\int_{\gamma_{i}}\mathrm{d}^*\omega_i = \lambda_i P_{i},$$
 此即  $\sum_{k=1}^{n-1}\lambda_k\omega_k$关于  $\gamma_i$的积分周期. 
 要使其具备共轭调和函数,  其积分周期均为$0$, 即 $\lambda_i P_{i} = 0$. 
 由定理4.17的证明过程可知 $P_i \not=0$, 因此  
 $\lambda_i=0,\ \forall i \in \{1, \ldots ,n-1\}$.

    \item[4.4.3]

 只需证明,若对  $R,R'>1$有双全纯映射$f: A(1,R) \to A(1,R')$, 必有  $R' = R$. 
 不妨设 $\lim_{|z| \to 1}|f(z)| = 1$（否则考虑 $\frac{R'}{f}$即可）, 
 则定义 $f^{(1)}$为
 $$f^{(1)}(z) = \begin{cases} (\overline{f(\overline{z}^{-1})})^{-1},  & z \in A(\frac{1}{R},1), \\ 
    f(z),&  z \in A(1,R).\end{cases}$$
 
 由反射原理, 知$f^{(1)}$可以连续延拓为 $A(\frac{1}{R},R)$
 到 $A(\frac{1}{R'},R')$的双全纯映射. 
 则 $f^{(1)}$ 是$A(\frac{1}{R},R)$到 $A(\frac{1}{R'},R')$的双全纯映射, 
 并且 $\lim_{|z| \to \frac{1}{R}}|f(z)| = \frac{1}{R'}$,类似上述定义
 $$f^{(2)}(z) = \begin{cases}  (R'^2\overline{f((R^2\overline{z})^{-1})})^{-1},  & z \in A(\frac{1}{R^3},\frac{1}{R}), \\ 
    f^{(1)}(z),&  z \in A(\frac{1}{R},R),\end{cases}$$

 同样可以利用  $\lim_{|z| \to R}|f(z)| =R'$向外延拓, 如此归纳定义 $f^{(n)}$,
 令  $n\to \infty$就得到了 $\mathbb{C}\backslash\{0\}$上的全纯自同构 $f^*$, 
 并且 $\lim_{z \to 0} f^{*}(z) = 0,\ \lim_{|z| \to \infty}f^{*}(z) = \infty$. 
 这就意味着 $f$可以延拓为  $\mathbb{C}$上的全纯自同构,  $f^*(z)  = az +b$. 
 由$\lim_{|z| \to 1}|f(z)| = 1$和  $f^*(0) = 0$得到  $f^{*}(z) = e^{i\theta}z$, 
 从而 $R = R'$.
\end{itemize} 

== Zeta函数和素数定理 ==

 \subsection*{5.1 $\Gamma$函数}
 \begin{itemize}
    \item[5.1.1]

直接计算可得
$$a_n(s) = \frac{1}{n !}\frac{\mathrm{d}^n}{\mathrm{d}z^n} 
\frac{1}{(1-z)^s}\Big|_{z = 0} = \frac{s(s+1)\cdots(s+n-1)}{n!}.$$

由此在 $n\to \infty$时有
$$a_n(s) \sim \frac{s(s+1)\cdots(s+n)}{n!n}
\sim \frac{n! n^{s}}{\Gamma_{n}(s)n!n}  
=  \frac{n^{s-1}}{\Gamma_{n}(s)}\sim \frac{n^{s-1}}{\Gamma(s)}. $$

    \item[5.1.2]

按定义有 $\overline{\Gamma(s)} =\Gamma(\overline{s})$, 由余元公式

$$\Big|\Gamma\Big(\frac{1}{2}+it\Big)\Big|^2 
= \Gamma\Big(\frac{1}{2}+it\Big)\Gamma\Big(\frac{1}{2}-it\Big) 
= \frac{\pi}{\sin\left( \frac{\pi}{2}-i\pi t \right)} 
= \frac{\pi}{\cosh (\pi t)}.$$

    \item[5.1.3]

需要用Wallis乘积公式
$$\lim_{n \to \infty}\frac{(2n-1)!!\sqrt{n}}{(2n)!!} = \frac{1}{\sqrt{\pi}},$$
可利用 $I_n = \int_0^{\frac{\pi}{2}}\sin^n x \mathrm{d}x$的递推式得到该式证明.

现在使用乘积公式证明倍乘公式.

\begin{align*}
    \Gamma(s)\Gamma\Big( s+\frac{1}{2} \Big)
    & = \lim_{n \to \infty}\frac{n^{2s+\frac{1}{2}}(n!)^2}
    {s(s+1)\cdots(s+n)(s+\frac{1}{2})(s+\frac{3}{2})\cdots (s+\frac{2n+1}{2})}\\
    & = \lim_{n \to \infty}\frac{n^{2s+\frac{1}{2}}2^{2n+2}(n!)^2}
    {2s(2s+1)\cdots(2s+2n+1)}.
\end{align*}

同样地
$$\Gamma(2s) = \lim_{n \to \infty}\frac{(2n)^{2s}(2n)!}{2s(2s+1)\cdots(2s+2n)}.$$

因此
\begin{align*}
    \frac{\Gamma(2s)}{\Gamma(s)\Gamma\left( s+\frac{1}{2} \right)} 
    &= \lim_{n \to \infty} \frac{(2n)^{2s}(2n)! (2s+2n+1)}
    {n^{2s+\frac{1}{2}}2^{2n+2}(n!)^2} 
    =\lim_{n \to \infty} \frac{2^{2s-1} \sqrt{n}(2n-1)!!}{(2n)!!} 
    =  \frac{2^{2s-1}}{\sqrt{\pi}}.
\end{align*}


    \item[5.1.4]
     (1)对 $0<s<1$, 考虑函数 $f(z) = z^{s-1}e^{-z}$在下图围道上的积分,得到      
        
