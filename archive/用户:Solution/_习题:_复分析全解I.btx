    作图如上,现要求 $f(0) = 0, f(1) = A_1, f(\infty)=B$. 
    记 $\frac{1}{r} = f^{-1}(A_2)$, 显然 $0<r<1$. 
    可见 $f$将 $y$轴正半轴也映至$y$轴正半轴, 于是矩形的左半部分 $OBA_3 A_4$
    可以看作是 右半部分 $OB A_2A_1$沿 $y$轴正半轴反射延拓而成, 
    因此得到 $f^{-1}(A_3) = -\frac{1}{r},\ f^{-1}(A_4) = -1$. 
    现在取 $z_0=0$, 由 $f(0)=0$得到 $C_0 =0$, 则 $f$的表达式可进一步写为
    $$f(z) = C_1 \int^z_{0}(\zeta-1)^{-\frac{1}{2}}(\zeta+1)^{-\frac{1}{2}}
    (\zeta-\frac{1}{r})^{-\frac{1}{2}}(\zeta+\frac{1}{r})^{-\frac{1}{2}}\mathrm{d}\zeta 
    = C_1 \int^z_{0}\frac{\mathrm{d}\zeta}{\sqrt{(1-\zeta^2)(1-r^2 \zeta^2)}}.$$

    代入顶点对应关系就得到
    $$K = C_1 \int^1_{0}\frac{\mathrm{d}\zeta}{\sqrt{(1-\zeta^2)(1-r^2 \zeta^2)}},
    \ K' = C_1 \int^1_{0}\frac{\mathrm{d}\zeta}{\sqrt{(1-\zeta^2)(1-(1-r^2) \zeta^2)}}. $$

    若合适选取 $K,K',r$使得 $C_1=1$,此即(6.5)所述事实.

    \item[6.2.2]若有第二个共形映射将 $Q(z_1,z_2,z_3,z_4)$映至 $R(ib',0,1,1+ib')$, 
    则可以得到从$R(ib ,0,1,1+ib )$映至 $R(ib',0,1,1+ib')$的共形映射.
    下面利用Schwarz反射原理将其沿着矩形的边翻折延拓. 
    先沿着 $[0,1]$和 $[ib',1+ib]$上下翻折延拓, 
    得到 $\{0\le |z|\le 1\}$至$\{0\le |z|\le 1\}$的共形映射, 
    而后左右延拓得到 $\mathbb{C}\to \mathbb{C}$的共形映射. 
    复平面上的共形变换只可能是相似变换, 这样得到 $b=b'$.

    \item[6.2.3]  考虑曲线 $\gamma_r = r e^{i\theta},\,\theta \in [0,2\pi]$, 则知
     $$\ell_\rho(\gamma_r) = \int_0^{2\pi} \rho(r e^{i\theta})r\mathrm{d}\theta. $$

     若  $\ell_\rho(\gamma_r)^2> \frac{A_\rho(\Omega)}{\tmod\Omega}$, 则有
     \begin{align*}
        2 \pi A_\rho(\Omega) &= \log R \frac{A_\rho(\Omega)}{\tmod\Omega} 
        <\int_1^R \frac{\ell_\rho(\gamma_r)^2}{r}\mathrm{d}r\\
        & \le2\pi  \int_1^R \frac{1}{r}\mathrm{d}r \int_0^{2\pi} r^2 \rho^2 \mathrm{d}\theta 
        = 2\pi \int_1^R\int_0^{2\pi} \rho^2 r\mathrm{d}r\mathrm{d}\theta 
        = 2\pi A_\rho(\Omega),
     \end{align*}
     矛盾! 因此存在 $r_0$使得 $\ell_\rho(\gamma_{r_0})^2
     \le  \frac{A_\rho(\Omega)}{\tmod\Omega}$.

    \item[6.2.4] (1)充分性: 此时记 $d_1,d_2$分别为 
    $\gamma$到 $[z_2,z_3]$与 $[z_1,z_4]$的距离,
    显然有 $\tmod R = d_1 + d_2 = \tmod R_1+ \tmod R_2$.
    
    (2)必要性: 依次将 $\tmod R_1,\tmod R_2,\tmod R$记为 $b_1,b_2,b$.
    施加适当的伸缩和旋转变换后, 将矩形 $R(z_1,z_2,z_3,z_4)$ 映成$R(ib,0,1,1+ib) $ , 
    记连接 $w_1 \in [0,ib]$和 $w_2 \in [1,1+ib]$的一条若当弧为$\gamma$.
    现已知 $b = b_1+ b_2$,由Rengel不等式, 
    $b = b_1 + b_2 = \tmod R_1+\tmod R_2\le A(R_1)+A(R_2)= b $. 
    于是Rengel不等式里的等号成立, 这说明 $R_1,R_2$都是矩形, 
    显然此时 $\gamma$平行于对边 $[z_2,z_3]$.
    

    \item[6.2.5]  (1)充分性:此时有 $\tmod\Omega 
    = \frac{1}{2\pi}\log \frac{r_1}{r_2} 
    =\frac{1}{2\pi}\log \frac{r_1}{r} + \frac{1}{2\pi}\log \frac{r}{r_2} 
    =\tmod\Omega_1 + \tmod\Omega_2$.
    
    (2)必要性:不妨设 $r_1=1$. 由例6.2容易得到 
    $\tmod\Omega_i\le \frac{A_\rho(\Omega_i)}{2\pi},
    \ \rho(z) = \frac{1}{|z|}$, 并且等号成立当且仅当 $\rho$是极值度量, 
    下面说明此时 $\Omega_i$均为标准环域. 由对称性只需说明 $\Omega_1$是标准环域. 
    由定理4.17存在共形映射 $\varphi: \Omega_1\to \{1<|z|<R\}$, 
    其中 $\tmod\Omega_1 = \frac{\log R}{2\pi}$. 
    此时 $\rho^*(z) = \rho(\varphi(z))|\varphi'(z)| 
    =\frac{ |\varphi'(z)|}{|\varphi(z)|}.$

    记 $\Gamma_1$是连接 $\varphi(\Omega_1)$两个边界分支的可求长曲线族.
    考虑到对极值度量 $\rho^*$, 有 $\tmod\Omega_1 
    =\frac{\ell_{\rho^*}(\Gamma_1)^2}{ A_{\rho^*}(\varphi(\Omega_1))}$,
    从而
    \begin{align*}
        A_{\rho^*}(\varphi(\Omega_1)) \log R 
        &= \int_0^{2\pi}\mathrm{d}\theta\int_1^{R}\rho^*(re^{i\theta})^2 r\mathrm{d}r \int_1^R \frac{1}{r}\mathrm{d}r\\
        & \ge \int_0^{2\pi}\mathrm{d}\theta  \bigg(\int_1^{R}\rho^*(re^{i\theta}) \mathrm{d}r\bigg)^2
        \ge 2\pi \ell_{\rho^*}(\Gamma_1)^2\\
        & = A_{\rho^*}(\varphi(\Omega_1)) \log R.
    \end{align*}
    于是上面等号全部成立, 其中Schwarz 不等式等号成立说明 
    $\rho^*(re^{i\theta})^2r = \frac{1}{r}$, 
    也就是 $\rho^*(re^{i\theta}) = \frac{1}{r}$. 
    这就说明 $|\varphi'(z)|\equiv 1$, 从而  $\varphi(z)= e^{i\theta_0}z$, 
    这就推出 $\Omega_1$是标准环域.
    又因为$\tmod\Omega = \tmod\Omega_1+\tmod\Omega_2
    \le \frac{A_\rho(\Omega_1)}{(2\pi)^2}+\frac{A_\rho(\Omega_2)}{(2\pi)^2} 
    = \frac{A_\rho(\Omega)}{(2\pi)^2} = \tmod\Omega$, 
    于是等号成立, 说明 $\gamma$是圆周.
\end{itemize}

\subsection*{6.3 共形模的极值问题}
\begin{itemize}
    
    \item[6.3.1] 记 $\Gamma_1,\Gamma_2$分别为 连接和分隔两个边界分支的曲线族,
    则 $\tmod G_r = \lambda(\Gamma_1) $. 
    其单调递减性由极值长度的比较与合成定理可得. 
    
    对 $\lambda(\Gamma_1)$, 取 $\rho_1(z)=\frac{1_{\{|z|\ge r\}}}{|z|}$, 
    则类似例6.2推理可知
    $$\mu(r) = \lambda(\Gamma_1)
    \ge \frac{\ell_{\rho_1}(\Gamma_1)^2}{A_{\rho_1}(G_r)}
    \ge \frac{\log \frac{1}{r}}{2\pi}\to \infty,\ r\to 0.$$

   由 $$\mu\Big(\sqrt{\frac{1}{1+\rho}}\Big) 
   = \frac{1}{16}\mu\Big(\sqrt{\frac{1}{1+\rho}}\Big)^{-1}$$
   得到 $$\mu(r) = \frac{1}{16}\mu(\sqrt{1-r^2})^{-1},$$
   由此说明 $r\to 1$时 $\mu(r)\to 0$.

\item[6.3.2] 取圆盘上自同构 $\varphi(z) = \frac{z+a}{1+az}$, 
由共形模不变性,在作用共形映射 $ \varphi$变为分离 
$\partial \mathbb{D}$和 $\big\{0,\frac{2a}{1+a^2}\big\}$的极值问题. 
因此题中极值问题的解是区域 $\varphi^{-1}\big(G_{\frac{2a}{1+a^2}}\big) 
=\mathbb{D}\backslash[-a,a] $, 共形模为  $\mu\big(\frac{2a}{1+a^2}\big)$.

\item[6.3.3] 对 $\varepsilon>0$,存在 $z_1,z_2 \in E$
使得 $\text{diam}(E) < |z_1-z_2|+\varepsilon$. 
取圆盘上自同构 $\varphi(z) = e^{i\theta}\frac{z-z_1}{1-\overline{z}_1z}$, 
使得 $\varphi(z_2) = \big|\frac{z_2-z_1}{1-\overline{z}_1z_2}\big|$. 
则 $\varphi(\Omega)$ 是分离 $\{0, \big|\frac{z_2-z_1}{1-\overline{z}_1z_2}\big|\}$ 
和 $\partial \mathbb{D}$的二连通区域. 因此
 $$M\le \tmod\Omega = \tmod\varphi(\Omega) 
 \le \mu\Big( \Big|\frac{z_2-z_1}{1-\overline{z}_1z_2}\Big|\Big).$$

 这说明
 $$\text{diam}(E) < |z_1-z_2|+\varepsilon
 \le |1-\overline{z}_1z_2| \mu^{-1}(M)+\varepsilon\le 2\mu^{-1}(M)+\varepsilon,$$

 或者 
 $$\text{diam}(E) < |z_1-z_2|+\varepsilon
 \le |1-\overline{z}_1z_2| \mu^{-1}(M)+\varepsilon\le (1+\text{diam}(E))\mu^{-1}(M)+\varepsilon .$$
 令 $\varepsilon\to 0$得到 $\text{diam}(E)\le \min\{ 2\mu^{-1}(M), 
 \frac{\mu^{-1}(M)}{1-\mu^{-1}(M)}\}$.

\item[6.3.4] 取共形映射 $\varphi(z) = -\frac{z}{z_1}$,  
则 $\varphi(\Omega)$ 是分隔 $\{-1,0\}$和  $\{w,\infty\}$的区域, 
其中 $w = -\frac{z_2}{z_1}$. 
仿定理6.12, 取Riemann映射的逆 $\varphi': \mathbb{D}\to \tilde{\Omega}$, 
其中 $\tilde{\Omega}$是区域和有界余分支的并,同时要求$\varphi'(0)=0$. 
记$z_0 = \varphi'^{-1}(e^{-\theta}),\ R = |w|$, 
由偏差定理和 $\frac{1}{4}$-定理得到
$\frac{1}{|f'(0)|} = \frac{|f(z_0)|}{|f'(0)|}\le \frac{|z_0|}{(1-|z_0|)^2},
\ R = |w|\ge \frac{1}{4}|f'(0)|$, 综合得到 $\frac{4R|z_0|}{(1-|z_0|)^2}\ge 1$. 
同时 $\varphi'^{-1}(\Omega)$是分离 ${0,z_0}$和 $\partial\mathbb{D}$的二连通区域,
由定理6.11得到 $\tmod\Omega\le \mu(|z_0|)$. 
余下和定理6.12相同: 取 $r$使得 $\frac{4Rr}{(1-r)^2}=1$, 
则映射 $g:G_r\to T_R,\ z\mapsto -\frac{4Rz}{(1-z)^2}$是共形的, 
从而有 $\tmod T_R = \tmod G_r = \mu(r)$. 
注意到 $\frac{4Rr}{(1-r)^2}=1\le\frac{4R|z_0|}{(1-|z_0|)^2}$,  
说明 $r\le |z_0|$. 进而 $\tmod\Omega\le \mu(|z_0|)
\le \mu(r) = \tmod T_R = 2\mu\Big(\sqrt{\frac{1}{1+R}}\Big) 
= 2\mu\Big(\sqrt{\frac{|z_1|}{|z_1|+|z_2|}}\Big).$
    \end{itemize}