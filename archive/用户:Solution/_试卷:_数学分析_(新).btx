== 25--26春数学分析AII (H)期末 (杜恺)==

\begin{center}
课程代码：MATH10011h.03&04 \quad 考试形式：闭卷
\end{center}

\textbf{一、\ 填空题}(共 6 题，每题分值相同，\textbf{选择得分最高的 5 题计分}，满分 30 分.)
\begin{enumerate}
\item 设 $f(x,y)\in C^1(\R^2),\,\displaystyle F(x)=\int_{x^2}^{2x^2}\mathrm{d} s\int_s^{x^2}f(s,t)\,\mathrm{d} t$,
则 $F'(x)=\underline{\hspace{2cm}}$.

\item 计算三重积分 $\displaystyle I=\iiint_V\left(\sqrt{x^2+y^2+z^2}+x^5+y^2\sin y\right)\mathrm{d} V$,
其中 \(V\) 为 \(x^2+y^2+z^2=2z\) 所围成的闭区域，则 \(I=\underline{\hspace{2cm}}\).

\item 函数 $\displaystyle f(x,y)=y\left(x^2+y^2+\sqrt{2}\,x-2\right)$ 在 \(D=\{(x,y)\mid x^2+y^2\le 3\}\) 上的最大值为 
$f_{\max}=\underline{\hspace{2cm}}$，最小值为 $f_{\min}=\underline{\hspace{2cm}}$.

\item 判断积分的敛散性：$\displaystyle \int_0^1\int_0^1\frac{1}{x^{1-y}(1-x)^y}\,\mathrm{d} x\,\mathrm{d} y$，
该积分 $\underline{\hspace{2cm}}$（填“收敛”或“发散”）.

\item 在 \(\R^3\setminus\{0\}\) 上定义 \(2\)-形式 $\displaystyle \varphi=
\frac{x\,\mathrm{d}y\wedge \mathrm{d}z+y\,\mathrm{d}z\wedge\mathrm{d}x+z\,\mathrm{d}x\wedge \mathrm{d}y}
{\left(x^2+y^2+z^2\right)^{3/2}}$.
设 \(S\) 是中心在 \((1,1,1)\)、半径 \(R\ne\sqrt{3}\) 的球面，以外法向量定向，则
\[
\int_S\varphi=\underline{\hspace{2cm}} \quad \text{（按 \(R<\sqrt{3}\) 与 \(R>\sqrt{3}\) 分段写出）}.
\]

\item 已知 $\displaystyle \sum_{n=0}^{+\infty}\frac{\cos\left[(2n+1)\pi x\right]}{(2n+1)^2}
=\frac{\pi^2}{8}-\frac{\pi^2}{4}|x|\ \ (|x|\le 1)$，利用此等式计算
\[
\sum_{n=1}^{+\infty}\frac{1}{n^2}=\underline{\hspace{2cm}},
\quad
\sum_{n=1}^{+\infty}\frac{1}{n^4}=\underline{\hspace{2cm}}.
\]
\end{enumerate}

\textbf{二、\ 解答题}(要求叙述完整的证明或推导过程，4$\times$15' + 1$\times$30'=90')
\begin{enumerate}
\item (15') 设 \(K\subset\R^n\) 为紧集. 称 \(f:K\to\R\) 为\textbf{上半连续}，
如果对每个 \(x_0\in K\) 和任意 \(\varepsilon>0\)，存在 \(\delta>0\)，
使得只要 \(x\in K\) 且 \(\|x-x_0\|<\delta\)，就有 $f(x)<f(x_0)+\varepsilon$.
\begin{enumerate}
\item[(a)]证明：\(f\) 在 \(K\) 上取到最大值，即存在 \(x_0\in K\) 使得 $\displaystyle f(x_0)=\sup_{x\in K}f(x)$.
\item[(b)] 构造一个在 \([0,1]\) 上上半连续但取不到最小值的函数，并指出 (a) 的证明为何对最小值无效.
\end{enumerate}

\item (15') 设 \(f:\R^n\to\R^n\) 为 \(C^1\) 映射，
且其 Jacobi 矩阵 \(Df(x)\) 对每个 \(x\in\R^n\) 均为对称正定矩阵，
且其所有特征值均不小于给定正常数 \(\varepsilon>0\). 证明：
\begin{enumerate}
\item[(a)] \(f\) 是单射.
\item[(b)] \(\R^n\setminus f(\R^n)\) 既是开集也是闭集，由此得出 \(f\) 是满射.
\end{enumerate}

\item (15') 设 \(n\ge1\)，\(f:\R^n\to\R\) 有界可测，
且 $\displaystyle\lim_{\|x\|\to+\infty}f(x)=L$. 证明：
\[
\lim_{t\to+\infty}
\frac{1}{(4\pi t)^{n/2}}
\int_{\R^n}e^{-\frac{\|x\|^2}{4t}}f(x)\,\mathrm{d} x=L.
\]

\item (15') 从以下两小题中任选一题作答\textbf{(二选一，多做不加分)}：
\begin{enumerate}
\item[(A)]设 \(D\subset\R^2\) 为有界闭区域，
函数 \(f(x,y),g(x,y)\) 在 \(D\) 上连续且恒正. 证明：
\[
\iint_D f\ln\frac{f}{g}\,\mathrm{d}x\,\mathrm{d}y
\ge\left(\iint_D f\,\mathrm{d}x\,\mathrm{d}y\right)
\ln\frac{\displaystyle\iint_D f\,\mathrm{d}x\,\mathrm{d}y}
{\displaystyle\iint_D g\,\mathrm{d}x\,\mathrm{d}y}.
\]
\item[(B)]设 \(f(x,y)\) 是矩形 \(D=[0,1]\times[0,1]\) 上的非负连续函数. 证明：
\[
\left(\int_0^1\left(\int_0^1 f(x,y)\,\mathrm{d}y\right)^2\mathrm{d}x\right)^{1/2}
\le\int_0^1\left(\int_0^1f(x,y)^2\,\mathrm{d}x\right)^{1/2}\mathrm{d}y.
\]
\end{enumerate}

\item \textbf{曲面上的调和函数、最大值原理与 Dirichlet 问题}(30')

设 \(S\) 是 \(\R^3\) 中一个紧致连通带边光滑曲面，
其边界 \(\partial S\) 非空且光滑，曲面内部记为 \(S^\circ\).

请先阅读下面材料，然后回答问题.

\textbf{阅读材料.}
设 \(S\) 在局部由参数方程 $\displaystyle X=X(\xi_1,\xi_2),\,(\xi_1,\xi_2)\in U\subset\R^2$
给出. 记
\[
X_i=\frac{\partial X}{\partial\xi_i}, \quad i=1,2,
\]
定义矩阵 \((g_{ij}): g_{ij}=X_i\cdot X_j,\ i,j=1,2\). 
记 $\displaystyle g=\det(g_{ij}),\,(g^{ij})=(g_{ij})^{-1}$.

曲面的面积元为 $\displaystyle\mathrm{d}A=\sqrt g\,\mathrm{d}\xi_1\,\mathrm{d}\xi_2$.

若 \(u:S\to\R\) 是光滑函数，在局部参数中仍记 $\displaystyle u(\xi_1,\xi_2)=u\bigl(X(\xi_1,\xi_2)\bigr)$.
定义曲面梯度
\[
\nabla_Su=\sum_{i,j=1}^{2}g^{ij}\frac{\partial u}{\partial\xi_j}X_i,
\qquad
|\nabla_Su|^2=
\sum_{i,j=1}^{2}g^{ij}
\frac{\partial u}{\partial\xi_i}
\frac{\partial u}{\partial\xi_j}.
\]

若 \(V=v_1X_1+v_2X_2\) 是曲面上的切向量场，定义曲面散度
\[
\operatorname{div}_S V=
\frac{1}{\sqrt g}\sum_{i=1}^{2}
\frac{\partial}{\partial\xi_i}\left(\sqrt g\,v_i\right).
\]

曲面上的 Laplace 算子定义为 $\displaystyle\Delta_Su=\operatorname{div}_S(\nabla_Su)$，
即
\[
\Delta_Su=\frac{1}{\sqrt g}\sum_{i,j=1}^{2}\frac{\partial}{\partial\xi_i}
\left(\sqrt g\,g^{ij}\frac{\partial u}{\partial\xi_j}\right).
\]
若 \(\Delta_Su=0\)，则称 \(u\) 是曲面 \(S\) 上的调和函数.

以下两个结论可以直接使用：
\begin{itemize}
\item[$\bullet$] \textbf{结论一（曲面散度定理）.} 若 \(V\) 是曲面上的光滑切向量场，则
\[
\int_S\operatorname{div}_S V\,\mathrm{d}A
=\int_{\partial S}V\cdot\nu\,\mathrm{d} s,
\]
其中 \(\nu\) 是沿 \(\partial S\)、在曲面切平面内且与边界曲线垂直的单位向量，指向曲面外部.

\item[$\bullet$] \textbf{结论二（曲面最大值原理）.} 若
$\displaystyle u\in C^2(S^\circ)\cap C(S)$，$\Delta_Su\ge0$ 在 $S^\circ$ 内，则
\[
\max_Su=\max_{\partial S}u.
\]
\end{itemize}
\textbf{回答下列问题：}
\begin{enumerate}
\item[(a)] (6') \textbf{图形曲面上的 Laplace 算子.}\quad 设 \(D\subset\R^2\) 是区域，
\(\varphi\in C^2(D)\)，曲面 \(S_\varphi\) 是函数 \(z=\varphi(x,y)\) 的图像，即
$\displaystyle X(x,y)=(x,y,\varphi(x,y))$. 记 $\displaystyle W=\sqrt{1+\varphi_x^2+\varphi_y^2}$. 
证明：对光滑函数 \(u=u(x,y)\)，有
\[
\Delta_{S_\varphi}u=\frac1W\frac{\partial}{\partial x}
\left[\frac{(1+\varphi_y^2)u_x-\varphi_x\varphi_yu_y}{W}\right]
+\frac1W\frac{\partial}{\partial y}
\left[\frac{(1+\varphi_x^2)u_y-\varphi_x\varphi_yu_x}{W}\right].
\]
\item[(b)] (6') \textbf{Green 第一公式.} \quad 设 $h\in C^2(S^\circ)\cap C^1(S),\, \psi\in C^1(S)$.
证明：
\[
\int_S\nabla_S\psi\cdot\nabla_Sh\,\mathrm{d}A
=-\int_S\psi\Delta_Sh\,\mathrm{d}A+\int_{\partial S}\psi\frac{\partial h}{\partial\nu}\,\mathrm{d} s,
\]
其中 $\displaystyle\frac{\partial h}{\partial\nu}=\nabla_Sh\cdot\nu$.
\item[(c)](6') \textbf{Dirichlet 能量最小性.} \quad 设 $h\in C^2(S^\circ)\cap C^1(S)$，$\Delta_Sh=0$ 在 $S^\circ$ 内.
设 \(v\in C^2(S^\circ)\cap C^1(S)\)，且 \(v=h\) 在 \(\partial S\) 上. 定义曲面上的 Dirichlet 能量
\[
E(w)=\int_S|\nabla_Sw|^2\,\mathrm{d}A.
\]
证明：$\displaystyle E(v)=E(h)+\int_S|\nabla_S(v-h)|^2\,\mathrm{d}A$，并由此说明：
在所有具有相同边界值的光滑函数中，曲面调和函数 \(h\) 使 Dirichlet 能量达到最小.
\item[(d)](6') \textbf{Dirichlet 问题的唯一性.} \quad 考虑曲面上的 Dirichlet 问题
\[
\left\{
\begin{aligned}
\Delta_Su&=f, &&\text{in }S^\circ,\\
u&=g, &&\text{on }\partial S.
\end{aligned}
\right.
\]
证明：该问题至多有一个 \(C^2(S^\circ)\cap C(S)\) 解.
\item[(e)](6') \textbf{闭曲面上的 Liouville 定理.} \quad 设 \(\widetilde S\) 是紧致无边的连通光滑曲面. 若 
$u\in C^2(\widetilde S)$，$\Delta_{\widetilde S}u=0$ 在 $\widetilde S$ 上，证明：\(u\) 必为常数.
\end{enumerate}
\end{enumerate}

== 24--25 年春季学期期末(数学分析 AII 梁振国，吴昊) ==

\begin{center}
课程代码：MATH10011 \quad 考试形式：闭卷
\end{center}

\begin{enumerate}
\item 填空题（每空格6分，共30分）

(1) 若数项级数 \(\displaystyle\sum_{n=1}^{\infty}\left(\tan\frac{1}{n}-\frac{1}{n}\right)^{p}\) 收敛，则指数 \(p\) 的范围是 $\underline{\hspace{4cm}}$。

(2) 计算 \(\displaystyle\sum_{n=0}^{\infty}\frac{(-1)^{n}}{3n+1} =\) $\underline{\hspace{4cm}}$。

(3) 计算 
\[
\log_2\left(
\frac{\displaystyle\int_0^1 \frac{dx}{\sqrt{1-x^4}}}{\displaystyle\int_0^1 \frac{dx}{\sqrt{1+x^4}}}
\right)= \underline{\hspace{4cm}} .
\]

(4) 设 \(f\) 是 \([1,\infty)\) 上严格正的函数，并且广义积分 \(\displaystyle\int_1^\infty f(x)\,dx\) 收敛。
判断广义积分 \(\displaystyle\int_1^\infty \frac{1}{x^2 f(x)}\,dx\) 的敛散性：$\underline{\hspace{4cm}}$。

(5) 设一元函数 \(f\) 在 \((0,2)\) 内连续可导。定义 \((0,2)^2\) 上的二元函数
\[
F(x,y)=
\begin{cases}
\dfrac{f(x)-f(y)}{x-y}, & x\neq y,\\[6pt]
f'(x), & x=y.
\end{cases}
\]
求极限 \(\displaystyle\lim_{(x,y)\to(1,1)} F(x,y) =\) $\underline{\hspace{4cm}}$。

解答题（共70分）

\item (10分)
考察广义积分 \(\displaystyle \int_{0}^{\infty} \frac{\ln x}{x^{2}+2025^{2}}\,dx\)。

(1) 判断广义积分的敛散性并给出理由。（5分）

(2) 计算广义积分的值。（5分）

\item (10分)
设 \(f\) 是定义在 \([0,1]\) 上的连续函数，求极限
\[
\lim_{n\to+\infty} n\int_{0}^{1}x^{n}f(x)\,dx .
\]

\item (20分)
考虑函数项级数 \(\displaystyle \sum_{n=1}^{\infty} x^{2n}\ln x,\quad x\in(0,1]\)。

(1) 判断上述级数在 \((0,1]\) 上的敛散性（包括点态收敛以及一致收敛）并给出理由。（10分）

(2) 证明：
\[
\int_{0}^{1}\left(\sum_{n=1}^{\infty}x^{2n}\ln x\right)dx
=
\sum_{n=1}^{\infty}\left(\int_{0}^{1}x^{2n}\ln x\,dx\right).
\]
（10分）

\item (10分)
设 \(f\) 是定义在单位圆周
\[
S=\{(x,y)\in\mathbb{R}^2 \mid x^2+y^2=1\}
\]
上的二元连续函数。证明：存在 \(S\) 的一条直径的两个端点 \((x_1,y_1), (x_2,y_2)\)，使得
\[
f(x_1,y_1)=f(x_2,y_2).
\]

\item (10分)
设 \(f\) 是定义在 \([0,\pi]\) 上的连续函数，满足
\[
\int_{0}^{\pi} f(x)\sin x\,dx = \int_{0}^{\pi} f(x)\cos x\,dx = 0.
\]
证明：\(f\) 在 \((0,\pi)\) 中至少有两个零点。

\item (10分)
设 \(g\) 是定义在 \([1,\infty)\) 上的函数，
对任意满足 \(\displaystyle\int_{1}^{\infty} f^{2}(x)\,dx\) 收敛的函数 \(f\)，
广义积分 \(\displaystyle\int_{1}^{\infty} f(x)g(x)\,dx\) 也收敛。
判断广义积分 \(\displaystyle\int_{1}^{\infty} g^{2}(x)\,dx\) 的敛散性并给出理由。
\end{enumerate}

== 25--26年春季学期期中(数学分析 AII 梁振国，吴昊) ==

\begin{center}
课程代码：MATH10011 \quad 考试形式：闭卷
\end{center}

\textbf{一、\ 计算与简答题（共$10$分 $\times 4 = 40$ 分）}

\begin{enumerate}
    \item 令
    \[
    a_n = \frac{1}{\sqrt{2n^2 - 1^2}} + \frac{1}{\sqrt{2n^2 - 2^2}} + \cdots + \frac{1}{\sqrt{2n^2 - n^2}},
    \]
    求极限 $\displaystyle \lim_{n\to+\infty} a_n$.

    \item 计算定积分
    \[
    \int_0^{\frac{\pi}{2}} \frac{\mathrm{d}x}{1 + \tan^{11}x}.
    \]

    \item 设 $f$ 在 $[0,1]$ 上连续可导，满足 $f(1)=2$ 且 $\displaystyle \int_0^1 f^2(x)\,\mathrm{d}x = 1$。计算：
    \[
    \int_0^1 x f(x) f'(x)\,\mathrm{d}x.
    \]

    \item 设 $f$ 在 $[0,\infty)$ 上连续、非负，且 $\displaystyle \int_0^\infty f(x)\,\mathrm{d}x$ 收敛。计算极限：
    \[
    \lim_{n\to\infty} \frac{1}{n} \int_0^n x f(x)\,\mathrm{d}x.
    \]
\end{enumerate}

\bigskip

\textbf{二、\ 证明与综合分析题（共$12$分 $\times 5 = 60$ 分）}

\begin{enumerate}
    \item 考虑平面曲线 $y = \dfrac{1}{1 + x^2}$ $(-\infty < x < +\infty)$ 绕 $x$ 轴旋转一周所得几何体。求其体积 $V$。

    \item 考虑函数
    \[
    f(x) = \int_0^x \sin \frac{1}{t}\,\mathrm{d}t, \quad x \neq 0; \qquad f(0) = 0.
    \]
    说明 $f$ 是 $\mathbb{R}$ 上有良定义的函数并计算 $f'(0)$。

    \item 设函数 $f$ 在 $[0,1]$ 上连续，满足 $1 \leq f(x) \leq 2025$。证明：
    \[
    \int_0^1 f(x)\,\mathrm{d}x \int_0^1 \frac{1}{f(x)}\,\mathrm{d}x \leq \frac{1013^2}{2025}.
    \]

    \item 设函数 $f$ 在 $[0,1]$ 上连续，并且存在正常数 $M > 0$，$a > 0$，使得对任意区间 $[\alpha, \beta] \subset [0,1]$ 成立
    \[
    \left|\int_\alpha^\beta f(x)\,\mathrm{d}x\right| \leq M(\beta - \alpha)^{1 + a}.
    \]
    求所有可能的 $f$。

    \item 判断如下广义积分的敛散性（条件收敛、绝对收敛）并给出理由：
    \[
    \int_0^\infty \left[ \left(1 - \frac{\sin x}{x}\right)^{-\frac{1}{2026}} - 1 \right] \mathrm{d}x.
    \]
\end{enumerate}

答案

\bigskip

\textbf{一、\ 计算与简答题}

\begin{enumerate}
    \item 注意到
    \[
    a_n = \frac{1}{n\sqrt{2}} \sum_{i=1}^n \frac{1}{\sqrt{1 - (i/n)^2/2}}.
    \]
    取
    \[
    f(x) = \frac{1}{\sqrt{1 - x^2}},
    \]
    则
    \[
    \lim_{n\to\infty} a_n
    = \lim_{n\to\infty} \frac{1}{n\sqrt{2}} \sum_{i=1}^n f\!\left(\frac{i}{n\sqrt{2}}\right)
    = \int_0^{1/\sqrt{2}} \frac{1}{\sqrt{1 - x^2}}\,\mathrm{d}x
    = \arcsin x \Big|_0^{1/\sqrt{2}}
    = \frac{\pi}{4}.
    \]

    \item 利用变量代换 $t = \dfrac{\pi}{2} - x$，
    \[
    \int_0^{\pi/2} \frac{\mathrm{d}x}{1 + \tan^{11}x}
    = \int_0^{\pi/2} \frac{\mathrm{d}t}{1 + \cot^{11}t}
    = \int_0^{\pi/2} \frac{\tan^{11}t}{1 + \tan^{11}t}\,\mathrm{d}t.
    \]
    两式相加得
    \[
    2I = \int_0^{\pi/2} 1\,\mathrm{d}x = \frac{\pi}{2},
    \]
    故
    \[
    I = \frac{\pi}{4}.
    \]

    \item 利用分部积分：
    \[
    \int_0^1 x f(x) f'(x)\,\mathrm{d}x
    = \frac{x}{2} f^2(x) \Big|_0^1 - \frac{1}{2} \int_0^1 f^2(x)\,\mathrm{d}x
    = \frac{1}{2} \cdot 2^2 - \frac{1}{2} \cdot 1
    = 2 - \frac{1}{2}
    = \frac{3}{2}.
    \]

    \item 对任意 $\varepsilon > 0$，存在 $A > 0$，当 $A_1 > A$ 时，
    \[
    0 \leq \int_{A_1}^\infty f(x)\,\mathrm{d}x < \frac{\varepsilon}{2}.
    \]
    当 $n > A + 1$ 时，
    \[
    \frac{1}{n} \int_0^n x f(x)\,\mathrm{d}x
    = \frac{1}{n} \int_0^{A+1} x f(x)\,\mathrm{d}x
    + \frac{1}{n} \int_{A+1}^n x f(x)\,\mathrm{d}x.
    \]
    存在 $N > A + 1$，当 $n > N$ 时，
    \[
    \frac{1}{n} \int_0^{A+1} x f(x)\,\mathrm{d}x < \frac{\varepsilon}{2},
    \]
    且
    \[
    0 \leq \frac{1}{n} \int_{A+1}^n x f(x)\,\mathrm{d}x
    \leq \int_{A+1}^n f(x)\,\mathrm{d}x < \frac{\varepsilon}{2}.
    \]
    因此 $\displaystyle \lim_{n\to\infty} \frac{1}{n} \int_0^n x f(x)\,\mathrm{d}x = 0$。
\end{enumerate}

\bigskip

\textbf{二、\ 证明与综合分析题}

\begin{enumerate}
    \item 旋转体体积
    \[
    V = \int_{-\infty}^{+\infty} \pi \left(\frac{1}{1 + x^2}\right)^2 \mathrm{d}x
    = 2\pi \int_0^{+\infty} \frac{1}{(1 + x^2)^2}\,\mathrm{d}x.
    \]
    因为
    \[
    \int \frac{1}{(1 + x^2)^2}\,\mathrm{d}x
    = \frac{1}{2} \arctan x + \frac{x}{2(1 + x^2)} + C,
    \]
    所以
    \[
    V = 2\pi \cdot \frac{\pi}{4} = \frac{\pi^2}{2}.
    \]

    \item 对 $x \in (0,1)$，
    \[
    \int_0^x \sin \frac{1}{t}\,\mathrm{d}t
    = \lim_{a \to 0} \int_a^x \sin \frac{1}{t}\,\mathrm{d}t.
    \]
    令 $u = t^{-1}$，由积分第二中值定理，
    \[
    \left| \int_a^x \sin \frac{1}{t}\,\mathrm{d}t \right| \leq 2x^2,
    \]
    故广义积分收敛，且
    \[
    \left| f(x) - f(0) \right| \leq 2x^2.
    \]
    于是
    \[
    \left| \frac{f(x) - f(0)}{x} \right| \leq 2|x| \to 0 \quad (x \to 0),
    \]
    因此 $f'(0) = 0$。

    \item 由题设，
    \[
    (f(x) - 1)(f(x) - 2025) \leq 0,
    \]
    即
    \[
    f(x) + \frac{2025}{f(x)} \leq 2026.
    \]
    积分得
    \[
    \int_0^1 f(x)\,\mathrm{d}x + 2025 \int_0^1 \frac{1}{f(x)}\,\mathrm{d}x \leq 2026.
    \]
    由均值不等式，
    \[
    2 \left( 2025 \int_0^1 f(x)\,\mathrm{d}x \int_0^1 \frac{1}{f(x)}\,\mathrm{d}x \right)^{1/2}
    \leq 2026,
    \]
    故
    \[
    \int_0^1 f(x)\,\mathrm{d}x \int_0^1 \frac{1}{f(x)}\,\mathrm{d}x
    \leq \frac{1013^2}{2025}.
    \]

    \item 答案为 $f \equiv 0$。\\
    反证：若存在 $\xi \in (0,1)$ 使 $f(\xi) > 0$，由连续性，存在 $\delta_0 > 0$ 使在 $[\xi - \delta_0, \xi + \delta_0]$ 上 $f(x) > 0$。取
    \[
    \alpha_n = \xi - \frac{\delta_0}{n}, \quad \beta_n = \xi + \frac{\delta_0}{n}.
    \]
    由积分第一中值定理，
    \[
    \int_{\alpha_n}^{\beta_n} f(x)\,\mathrm{d}x = \frac{2\delta_0}{n} f(\zeta_n).
    \]
    由题设，
    \[
    \frac{2\delta_0}{n} f(\zeta_n) \leq M \left( \frac{2\delta_0}{n} \right)^{1+a},
    \]
    即
    \[
    f(\zeta_n) \leq M \left( \frac{2\delta_0}{n} \right)^a \to 0.
    \]
    但 $\zeta_n \to \xi$，由连续性得 $f(\xi) \leq 0$，矛盾。故 $f \equiv 0$。

    \item 令
    \[
    I_1 = \int_0^1 \left[ \left(1 - \frac{\sin x}{x}\right)^{-\frac{1}{2026}} - 1 \right] \mathrm{d}x,
    \]
    \[
    I_2 = \int_1^\infty \left[ \left(1 - \frac{\sin x}{x}\right)^{-\frac{1}{2026}} - 1 \right] \mathrm{d}x.
    \]
    当 $x \to 0$ 时，
    \[
    1 - \frac{\sin x}{x} \sim \frac{x^2}{6},
    \]
    故
    \[
    \left(1 - \frac{\sin x}{x}\right)^{-\frac{1}{2026}}
    \sim 6^{\frac{1}{2026}} x^{-\frac{1}{1013}},
    \]
    因此 $I_1$ 绝对收敛。

    当 $x \to \infty$ 时，
    \[
    \left(1 - \frac{\sin x}{x}\right)^{-\frac{1}{2026}}
    = 1 + \frac{1}{2026} \frac{\sin x}{x} + O\left(\frac{1}{x^2}\right),
    \]
    所以被积函数为
    \[
    \frac{1}{2026} \frac{\sin x}{x} + O\left(\frac{1}{x^2}\right).
    \]
    又 $\displaystyle \int_1^\infty \frac{\sin x}{x}\,\mathrm{d}x$ 条件收敛，$\displaystyle \int_1^\infty O\left(\frac{1}{x^2}\right)\mathrm{d}x$ 绝对收敛，故 $I_2$ 条件收敛。

    综上，原广义积分条件收敛。
\end{enumerate}

== 24--25年春季学期期中(数学分析 AII 梁振国，吴昊) ==
\textbf{一、\,计算题（每小题10分，共40分）}

\begin{enumerate}
    \item 计算定积分 $\displaystyle\int_{1}^{2025} \frac{\sqrt[3]{\ln(2+\cos x)}}{\sqrt[3]{\ln(2+\cos x)}+\sqrt[3]{\ln(2+\cos(2026-x))}} \,dx$.

    \item 椭圆 $\displaystyle x^{2}+\frac{y^{2}}{4}=1$ 的周长与正弦曲线 $y = a \sin x\ (a>0)$ 一个周期的长度相等，试求实数 $a$.

    \item 计算广义积分 $\displaystyle\int_{0}^{\infty}\frac{1}{(1+x^{2})(1+x^{6})}\,dx$.

    \item 求极限 $\displaystyle\lim_{a\to+\infty}\frac{\displaystyle\int_{0}^{\pi/2}x^{a}\sin x \,dx}{\displaystyle a\int_{0}^{\pi/2}x^{a}\cos x \,dx}$.
\end{enumerate}

\textbf{二、\,(15分)}

设 $f_{0}(x)=\ln x$, $\displaystyle f_{n+1}(x)=\int_{0}^{x}f_{n}(t)\,dt$, $n\in\mathbb{N},$ $x>0$.
\begin{enumerate}
    \item[(1)] 求 $f_{n}(x)$ 的表达式. (10分)
    \item[(2)] 求极限 $\displaystyle\lim_{n\to\infty}\frac{n!f_{n}(1)}{\ln n}$. (5分)
\end{enumerate}

\textbf{三、\,(15分)}

设 $a, b$ 为正实数，讨论下列广义积分的敛散性：
\[
\int_{b}^{\infty} \left( \sqrt{\sqrt{x+a}-\sqrt{x}} - \sqrt{\sqrt{x}-\sqrt{x-b}} \right) \mathrm{d}x.
\]

\textbf{四、\,(15分)}

设 $f$ 是 $[0,1]$ 上连续可微的函数，满足 $\displaystyle\int_{0}^{1}f(x)\,dx=0$. 证明：对 $\forall y\in[0,1]$，都有
\[
\left|\int_{0}^{y}f(x)\,dx\right| \le \frac{1}{8}\max_{x\in[0,1]}|f^{\prime}(x)|.
\]

\textbf{五、\,(15分)}

设函数 $f: \mathbb{R} \to \mathbb{R}$ 满足
\[
f(x)=\begin{cases}
    x, & \text{若 } x \le e, \\
    x f(\ln x), & \text{若 } x > e.
\end{cases}
\]
讨论广义积分 $\displaystyle\int_{1}^{\infty}\frac{1}{f(x)}\,dx$ 的敛散性.

== 23--24年春季学期期中(数学分析 AII 梁振国，吴昊) ==
\textbf{一、\,计算题（每小题10分，共40分）}

\begin{enumerate}
    \item 计算 $\displaystyle\int_{0}^{\pi}\frac{x \sin x}{1+\cos^{2}x}\,dx$.

    \item 计算 $\displaystyle\int_{1}^{2024}\frac{dx}{\sqrt{(x-1)(2024-x)}}$.

    \item 计算 $\displaystyle\int_{0}^{2\pi}\frac{1}{3+\sin x}\,dx$.

    \item 考虑数列 $\{x_n\}$，其中 $\displaystyle x_n = \frac{1}{n} \sqrt[n]{\frac{(2n)!}{n!}}$，求极限 $\lim\limits_{n \to +\infty} x_n$.
\end{enumerate}

\textbf{二、\,(10分)}

求曲线 $(x^{2}+y^{2})^{2}=x^{2}+y^{2}-4xy$ 围成区域的面积.

\textbf{三、\,(10分)}

设函数 $f$ 在 $\mathbb{R}$ 上一次连续可微，满足：
\begin{enumerate}
    \item[(1)] $f(0)=0$;
    \item[(2)] 对任意 $x \in \mathbb{R}$，成立 $|f^{\prime}(x)|\le|f(x)|$.
\end{enumerate}
求所有可能的 $f$.

\textbf{四、\,(15分)}

设 $p>0$，讨论反常积分 $\displaystyle\int_{\pi}^{+\infty}\frac{\sin x}{x^p + \sin x}\,dx$ 的敛散性.

\textbf{五、\,(10分)}

设函数 $f$ 满足：
\begin{enumerate}
    \item[(1)] 对任意 $x\in[1,2023]$ 成立 $|f(x)|\le1$;
    \item[(2)] $\displaystyle\int_{1}^{2023}f(x)\,dx=0$.
\end{enumerate}
求 $\displaystyle\int_{1}^{2023}\frac{f(x)}{x}\,dx$ 的最大值.

\textbf{六、\,(15分)}

设 $0<a<b$，考虑椭圆 $\displaystyle\frac{x^{2}}{a^{2}}+\frac{y^{2}}{b^{2}}=1$.
\begin{enumerate}
    \item[(1)] 给出椭圆的周长公式. (3分)
    \item[(2)] $a\ne b$ 时，$2\pi\sqrt{ab}$ 和 $\pi(a+b)$ 都是椭圆周长的近似值. 问：当 $a, b$ 充分接近时，上述哪个近似值更优？给出证明. (12分)
\end{enumerate}




== 25--26春数学分析AII (H)期中 (杜恺)==

\textbf{一、\ 填空题(6'×10=60')}
\begin{enumerate}
    \item $\displaystyle\lim_{x\to0,\ y\to a}\frac{\sin xy}{y}=\underline{\hspace{8em}}$.
    \item 已知$u=e^{xyz}$, 则$u_{xyz}=\underline{\hspace{8em}}$.
    \item 已知$u=\dfrac{x+z}{y+z}$, $z$由隐函数$ze^z=xe^x+ye^y$确定, 则$\partial_xu=\underline{\hspace{8em}}$.
    \item 函数$z=1-\dfrac{x^2}{a^2}-\dfrac{y^2}{b^2}$在点$\left(\dfrac{a}{\sqrt{2}},\dfrac{b}{\sqrt{2}}\right)$处沿$\dfrac{x^2}{a^2}+\dfrac{y^2}{b^2}=1$的内法线方向(单位向量)的方向导数为$\underline{\hspace{8em}}$.
    \item 已知$\dfrac{\partial^2z}{\partial x\partial y}=x+y,\ z(x,0)=x,\ z(0,y)=y^2$, 则$z=\underline{\hspace{8em}}$ (用$x,y$表示).
    \item 已知光滑曲线$y=y(x)$在$x$处的曲率计算公式为
    $$\kappa=\frac{|y''|}{(1+|y'|^2)^{3/2}},$$
    则曲线$u(x,y)=0$在$(x,y)$处的曲率计算公式为$\underline{\hspace{16em}}$.
    \item 周长为$2a$的矩形沿一条边旋转得到旋转体, 则该旋转体体积最大时, 该矩形相邻两条边的边长分别为$\underline{\hspace{8em}}$和$\underline{\hspace{8em}}$.
    \item 椭圆$(x-2y+1)^2+(3x+y-2)^2=1$的面积为$\underline{\hspace{8em}}$.
    \item $\displaystyle\int_0^1dx\int_0^x\dfrac{dy}{\sqrt{(1-x)(x-y)}}=\underline{\hspace{8em}}$.
    \item $\displaystyle\iint_{x^4+y^4\leq1}(x^2+y^2)\,dxdy=\underline{\hspace{8em}}$.
\end{enumerate}

\textbf{二、\ 解答题(10'+15'+15'=40')}
\begin{enumerate}
    \item (10分)\ 在$[1,3]$内用线性函数$ax+b$近似代替$x^2$, 使绝对偏差最小:
    $$\Delta=\sup_{1\leq x\leq3}|x^2-(ax+b)|.$$
    \item (15分)\ 证明:
    $$\int\cdots\int_{0\leq\sum_{i=1}^{n}x_i\leq a,\ x_i\geq0,\ i=1,\cdots,n}f(x_1+\cdots+x_n)\,dx_1\cdots dx_n=\int_0^af(x)\dfrac{x^{n-1}}{(n-1)!}\,dx.$$
    \item (15分)\ 证明:\ $f(x,y)=\exp(-y^2+2xy)$能展成对$x,y$一切值都收敛的级数$\displaystyle\sum_{n=0}^{\infty}\frac{H_n(x)}{n!}y^n$, $H_n(x)$为Hermite多项式, 满足:
    \begin{enumerate}[label=(\arabic*)]
        \item $H_n(x)$是$n$次多项式;
        \item $H_n'(x)=2nH_{n-1}(x)$;
        \item $H_{n+1}-2xH_n+2nH_{n-1}=0$;
        \item $H_n''-2xH_n'+2nH_n=0$.
    \end{enumerate}
\end{enumerate}

== 25--26秋数学分析AI (H)期末 (杜恺)==

一、\ 填空（20分）
\begin{enumerate}
    \item $\displaystyle\lim_{x\to0}\frac{1}{x^5}\int_0^x(e^{t^2}-1-t^2)\,dt=\underline{\qquad\quad}$。
    \item 已知$1=xy+e^{x+y}$，则$y$在$x=0$的Taylor展开式为$y=\underline{\qquad\quad}+o(x^2)$。
    \item $\displaystyle\sum_{n=1}^{+\infty}\frac{1}{n}\Big(\!-\frac{1}{3}\Big)^n=\underline{\qquad\quad}$。
    \item 四舍五入保留三位小数，求$\sqrt{3.9}\approx\underline{\qquad\quad}$。
\end{enumerate}
二、\ 判断（20分）
\begin{enumerate}
    \item 若连续函数导数恒不为$0$，则其严格单调。
    \item 若一列可导函数一致收敛于$f$，则$f$可导。
    \item 若函数Riemann可积，则其必存在原函数。
    \item 若$\displaystyle\int_1^{+\infty}f(x)\,dx$存在且有限，则$\lim\limits_{x\to+\infty}xf(x)=0$。
    \item 若$\displaystyle\sum_{n=0}^{+\infty}a_n$存在且有限，则$\lim\limits_{n\to+\infty}na_n=0$。
\end{enumerate}
三、\ 解答（60分）
\begin{enumerate}
    \item 计算$\displaystyle\int_0^1\frac{\ln x}{1-x^2}\,dx$。(10分)
    \item $\Big(1+\dfrac{1}{x}\Big)^{x+a}>e$对一切$x\in\R^+$成立，求$a$的范围。(10分)
    \item 对一切$c>0$，$\displaystyle\int_0^{+\infty}\frac{f(x)}{x}\,dx$都存在且有限，$f(0+)$亦存在且有限，
    求证$\displaystyle\int_0^{+\infty}\frac{f(ax)-f(bx)}{x}\,dx$存在，且为$f(0+)\ln\dfrac{b}{a}$。(10分)
    \item 二选一（做一个即可，分数为$\min\{15,\text{两题总和}\}$）
    \begin{enumerate}[label=(\alph*)]
    \item 设数列$\{x_n\}$的首项$x_1=1$，递推关系为$x_{n+1}=x_n+\dfrac{1}{x_n}$，
    求$\lim\limits_{n\to+\infty}\dfrac{x_n^2-2n}{\ln n}$。(15分)
    \item { }[回忆缺失]
    \end{enumerate}
    \item 按以下脉络证明$\pi$为无理数。令(15分)
    \[F_n(x)=\frac{x^n(\pi-x)^n}{n!}, \qquad I_n=\int_0^\pi F_n(x)\sin x\,dx.\]
    \begin{enumerate}[label=(\arabic*)]
    \item 证明，对任意$n>0$，$I_n>0$，且存在不依赖于$n$的常数$c$，
    使得$\displaystyle I_n\leqslant\frac{c}{n!}\bigg(\frac{\pi^2}{4}\bigg)^n$。
    \item 记$\displaystyle G_n(x)=\sum_{k=0}^n(-1)^kF^{(2k)}_n(x)$，
    证明$G''_n(x)+G_n(x)=F_n(x)$，并由此推出$I_n=G_n(0)+G_n(\pi)$。
    \item 假设$\pi$能写成既约分数$\dfrac{p}{q}$ $(p,q\in\Z)$，证明$q^{2n}I_n\in\Z$。
    \item 证明$\pi$为无理数。
    \end{enumerate}
\end{enumerate}

== 25--26秋数学分析AⅢ期末（肖体俊）==
注：本卷为回忆版，题目中可能遗漏一些条件（如可微、可导和连续等）
\begin{enumerate}
    \item 判断题
    \begin{enumerate}[label=(\arabic*)]
        \item 函数在某点可偏导，则它在这点连续.
        \item 二元函数在一点处可微，则它在各方向的方向导数都存在.
        \item $L$是一条不经过原点的闭合曲线，若$\displaystyle\int_{L}\frac{y\text{d}y+x\text{d}x}{x^2+y^2}=2\pi$,则$L$包含原点.
        \item $f(x,y)$在$\Omega=[a,b]\times[c,d]$上可积，则$\displaystyle\iint_{\Omega}f(x,y)dxdy=\int_{a}^b\int_{c}^df(x,y)dxdy$。
        \item 
    \end{enumerate}
    \item \begin{enumerate}[label=(\arabic*)]
        \item 求$x^2+y^2+z^2=6$和$x+y+z=0$的交线在点$(1,-2,1)$的切向量和法平面.
        \item 有关于隐函数求偏导的计算题.
    \end{enumerate}
    \item 求$f(x)=|x|$在$[-\pi,\pi]$上的Fourier级数，并求和函数，以此求$\displaystyle\sum_{n=1}^\infty \frac{1}{n^4}$.
    \item 区域$D=\{(x,y,z)\in\R^3|x+y-z,x-y+z,y+z-x\in[0,1]\}$，证明：
    \[\iiint_{D}(x+y-z)(y+z-x)H(x-y+z)\text{d}x\text{d}y\text{d}z=\frac{1}{16}\int_{0}^1H(u)\text{d}u.\]
    \item 计算$f(x,y,z)=xy^2z^3\,(x,y,z>0)$在约束条件$x^2+y^2+z^2=1$下的最大值.
    \item 计算$\displaystyle\iint_{D}x\text{d}y\text{d}z+y\text{d}x\text{d}z+z\text{d}x\text{d}y$，区域$D$为$x^2+y^2+z^2=r^2\,(r>0)$的上半曲面，方向取上侧.
    \item $\alpha>2,D=\{(x,y)|x\geqslant0,y\geqslant0\}$，证明$\displaystyle\iint_{D}(1+x^{\alpha}+y^2)^{-1}\text{d}x\text{d}y=\frac{\sqrt{\pi}}{2\alpha}\Gamma\Big(\frac{1}{\alpha}\Big)\Gamma\Big(\frac{1}{2}-\frac{1}{\alpha}\Big)$.
    \item $\displaystyle H(a)=\int_{0}^{\infty}\frac{\cos 2x}{x^a}\text{d}x$的连续区间是什么，还有一个关于一致收敛的问题.
    \item 区域$D=\{(x,y,z)|x^2+y^2+z^2=b^2,b>0\}$，求$\displaystyle\iint_{D}(2x+y+\sqrt{2}z)^6\text{d}S$.
    \item $f(x,y)$可积，$B_r(x,y)$代表以$(x,y)$为圆心，$r$为半径的小邻域，且
    $$f(x,y)=\frac{1}{\pi r^2}\iint_{B_r(x,y)}f(u,v)\text{d}u\text{d}v,$$
    求证$f(x,y)$有连续偏导数.
\end{enumerate}

== 25--26秋数学分析AI (H)期中 (杜恺)==

一、\ 填空题(5'×8=40')
\begin{enumerate}
    \item 计算下列数列或函数极限（无需展示计算过程）：
    \begin{enumerate}[label=(\arabic*)]
        \item $\displaystyle\lim_{n\to+\infty}\frac{n^{-1}-(n+1)^{-1}}{n^{-2}}=\underline{\hspace{8em}}$.
        \item $\displaystyle\lim_{n\to+\infty}\frac{\big(1+\frac{1}{n}\big)^n-e}{\frac{1}{n}}=\underline{\hspace{8em}}$.
        \item $\displaystyle\lim_{x\to+\infty}\left[\sqrt[3]{x^3+x^2+x+1}-\sqrt{x^2+x+1}\cdot\frac{\ln(e^x+x)}{x}\right]=\underline{\hspace{8em}}$.
        \item $\displaystyle\lim_{x\to0}\frac{\ln\cos x+3(\sqrt[3]{2-\cos x}-1)}{1-x^2-e^{-x^2}}=\underline{\hspace{8em}}$.
    \end{enumerate}
    \item 设$f(x)=\sqrt{x+\sqrt{x+\sqrt{x}}}$, 则$f'(x)=\underline{\hspace{8em}}$.
    \item 设$\arctan\dfrac{y}{x}=\ln\sqrt{x^2+y^2}$, 则$\dfrac{\operatorname{d}x}{\operatorname{d}y}=\underline{\hspace{8em}}$(用$x,y$表示).
    \item 已知$\begin{cases}x=t^2-\sin t,\\y=1-\cos t,\end{cases}$计算$\dfrac{\operatorname{d^2}y}{\operatorname{d}x^2}=\underline{\hspace{8em}}$(用$t$表示).
    \item $\displaystyle\int\frac{\operatorname{d}x}{\sin x+2\cos x-5}=\underline{\hspace{8em}}$.
\end{enumerate}

二、\ 选择题(2'×8=16')

判断下列叙述是命题“实数列$(a_n)_{n\geq1}$收敛”的充分不必要条件(A), 必要不充分条件(B), 充分必要条件(C), 既不充分也不必要条件(D):
\begin{center}\begin{tabular}{ll}
    1. $(a_n)_{n\geq1}$是有界数列. & 5. $\lim\limits_{n\to+\infty}|a_n-a_{n+1}|=0$.\\
    2. $(a_n)_{n\geq1}$是Cauchy数列. & 6. $\lim\limits_{n\to+\infty}\sup\limits_{k\geq1}|a_n-a_{n+k}|=0$.\\
    3. $(a_n)_{n\geq1}$是单调数列. & 7. $\sup\limits_{k\geq1}\limsup\limits_{n\to+\infty}|a_n-a_{n+k}|=0$.\\
    4. $(a_n)_{n\geq1}$有收敛子列. & 8. $\sup\limits_{k\geq1}\liminf\limits_{n\to+\infty}|a_n-a_{n+k}|=0$.
\end{tabular}\end{center}

三、\ 证明题(44')
\begin{enumerate}
    \item (8')设$a_n\geq0$且对所有正整数$n\geq1$满足$a_{n+1}\leq a_n+\dfrac{1}{n^2}$. 证明: 数列$\{a_n\}_{n\geq1}$收敛.
    \item (8')证明: 当$x\in\Big[\dfrac{\pi}{4},\dfrac{3\pi}{4}\Big]$时, $\dfrac{2\sqrt{2}}{3\pi}\leq\dfrac{\sin x}{x}\leq\dfrac{2\sqrt2}{\pi}$.
    \item (8')设$f$是开区间$(a,b)$上的有界连续函数.
    \begin{enumerate}[label=(\alph*)]
        \item $f$一定一致连续吗? 若是, 给出证明; 若否, 提供一个反例并给出证明.
        \item “$f(a+)$和$f(b-)$均存在(且有限)”与“$f$一致连续”之间有何关系? 证明你的结论.
    \end{enumerate}
    \item (8')设$f$是闭区间$[a,b]$上的有界凸函数. 证明: $f$在开区间$(a,b)$内连续.
    \item (12')定义函数$f(x)=\begin{cases}e^{-\frac{1}{x^2}},&x\neq0,\\0,&x=0.\end{cases}$回答下列问题:
    \begin{enumerate}[label=(\alph*)]
        \item 证明: 对任意正整数$n$成立$\displaystyle\lim_{x\to0}\frac{f(x)}{x^n}=0$.
        \item 证明: 对任意正整数$n$, 存在多项式$P_n(x)$使得
        $$f^{(n)}(x)=P_n\Big(\frac{1}{x}\Big)e^{-\frac{1}{x^2}}, \quad x\neq0.$$
        \item 证明: $f$在$x=0$处任意次可导, 且各阶导数均为$0$.
    \end{enumerate}
\end{enumerate}

== 24--25秋数学分析AI期末 (吴昊)==

\begin{enumerate}

    \item 填空题 (每空格6分, 共30分)
        \begin{enumerate}
            \item[(1)] 求极限 
                $\displaystyle \lim_{n \rightarrow + \infty} n \left( \mathrm{e} - \left(1 + \frac{1}{n}\right) ^ n\right)=$______. 
            \item[(2)] 求极限
                $\displaystyle \lim_{x \rightarrow 0}\frac{\cos(\sin x) - \cos x}{x ^ 4} =$_____. 
            \item[(3)] 设 $f(x) = \arcsin x$, 计算 $f ^ {\left(2025\right)}(0) =$_____. 
            \item[(4)] 求不定积分 $\displaystyle\int\frac{\sin x \cos x}{\sin x + \cos x}\mathrm{d}x=$_____. 
            \item[(5)] 设直角坐标系 $xOy$ 中的函数 $y = f(x)$ 在极坐标 $(r , \theta)$ 下可表示为
                $$r = a \left( 1 + \cos \theta \right), \quad a > 0, \quad \theta \in \left( 0 , \frac{2\pi}{3} \right),$$
                则 $f'(x)|_ {\theta = \frac{\pi}{3}} =$_____. 
        \end{enumerate}
    
    \item (两小题，共10分) 考虑函数 $\displaystyle y = \frac{\ln x}{x}$. 
        \begin{enumerate}
            \item[(A)] 分析上述函数的性质; (8分)
            \item[(B)] 画出函数的图像. (2分)
        \end{enumerate}
    
    \item (12分) 设 $F$ 是函数 $f$ 在 $I = ( 0 , + \infty )$ 上的一个原函数, 并满足 $\displaystyle F ( 1 ) = \frac{\sqrt 2 \pi}{4}$ 以及 
        $$f ( x ) F ( x ) = \frac{\arctan \sqrt x}{\sqrt x \left( 1 + x \right)}, \qquad \forall \, x \in I. $$
        求函数 $f$. 
    
    \item (10分) 设 $1 < x < y$, 证明: $\dfrac{y}{x} > \dfrac{y ^ x}{x ^ y}$. 

    \item (12分) 设 $f$ 是 $[0,1]$ 上的连续函数, 且在 $(0,1)$ 内二次可导. 若有
        $$f ( 0 ) = f ( 1 ) = 0,$$
        $$f ^ {\prime \prime} ( x ) + 2 f ^ \prime ( x ) + f ( x ) \geq 0, \quad \forall \, x \in ( 0 , 1 ), $$
        证明: 当 $x \in [ 0 , 1 ]$ 时, 成立 $f ( x ) \leq 0$. 
    
    \item (12分) 设定义在闭区间 $[ a , b ]$ 上的两个函数 $f , g$ 满足 $f ( a ) > 0$, $f ( b ) < 0$, 且 $g$ 在 $[ a , b ]$ 上连续.  
    若 $f + g$ 在 $[ a , b ]$ 上单调增加, 证明: 存在 $\xi \in [ a , b ]$, 使得 $f ( \xi ) = 0$. 

    \item (两小题，共14分)
        \begin{enumerate}
            \item[(A)] 设函数 $f$ 在 $[ - 1 , 1 ]$ 上三阶连续可微,  且 $f ( - 1 ) = 0$, $f ( 1 ) = 1$, $f ^ \prime ( 0 ) = 0$. 
            证明: 存在 $\xi \in ( - 1 , 1 )$, 使得 $f ^ {\prime \prime \prime} ( \xi ) = 3$. (7分)
            \item[(B)] 设函数 $f$ 在 $\mathbb {R}$ 上二阶连续可微, 且 $| f ( x ) | \leq 1$, $| f ^ \prime ( 0 ) | > 1$. 
            证明: 存在 $\xi \in \mathbb {R}$ 使得 $f ^ {\prime \prime} ( \xi ) + f ( \xi ) = 0$. (7分)
        \end{enumerate}

\end{enumerate}