以下答案与解答除了最后一题的方法二以外均由助教提供.

\textbf{一、填空题（每题6分，共60分）}

\begin{enumerate}

\item
求极限 $\displaystyle \lim_{(x,y)\to(0,a)}\frac{\sin(xy)}{y}$.

\textbf{解：}
\begin{itemize}
\item[$\cdot$]若 $a\neq0$，直接代入得 $\displaystyle\frac{\sin0}{a}=0$;
\item[$\cdot$]若 $a=0$，利用等价无穷小 $\sin(xy)\sim xy$，原式化为
\[
\lim_{(x,y)\to(0,0)}\frac{xy}{y}=\lim_{(x,y)\to(0,0)}x=0.
\]
\end{itemize}
所以极限为 $\underline{0}$.

\item
设 $u=e^{xyz}$，求 $u_{xyz}$.

\textbf{解：}
先对 $x$ 求偏导：$u_x = yz e^{xyz}$. 再对 $y$ 求偏导：
\[
u_{xy} = \frac{\partial}{\partial y}(yz e^{xyz}) = z e^{xyz} + yz \cdot xz e^{xyz} = z e^{xyz}(1 + xyz).
\]
最后对 $z$ 求偏导：
\begin{align*}
u_{xyz} &= \frac{\partial}{\partial z}\bigl[ z e^{xyz}(1 + xyz) \bigr] 
= \frac{\partial}{\partial z}\bigl[ z e^{xyz} + xyz^2 e^{xyz} \bigr] \\
&= e^{xyz} + z \cdot xy e^{xyz} + 2xyz e^{xyz} + xyz^2 \cdot xy e^{xyz} \\
&= e^{xyz}(1 + xyz + 2xyz + x^2y^2z^2) \\
&= e^{xyz}(1 + 3xyz + x^2y^2z^2).
\end{align*}
故答案为 $\underline{e^{xyz}(1+3xyz+x^2y^2z^2)}$.

\item
设 $u=\dfrac{x+z}{y+z}$，其中 $z$ 由方程 $z e^z = x e^x + y e^y$ 确定，求 $\partial_x u$（用 $x,y,z$ 表示）.

\textbf{解：}
方程两边对 $x$ 求偏导（$y$ 视为常数）：
\[
e^z z_x + z e^z z_x = e^x + x e^x \quad\Longrightarrow\quad e^z(1+z)z_x = e^x(1+x),
\]
得到
\[
z_x = \frac{e^x(1+x)}{e^z(1+z)} = \frac{1+x}{1+z}e^{x-z}.
\]
直接对 $u$ 求偏导：
\[
u_x = \frac{(1+z_x)(y+z) - (x+z)z_x}{(y+z)^2}
= \frac{y+z + (y-x)z_x}{(y+z)^2}.
\]
代入 $z_x$ 即得
\[
\partial_x u = \underline{\frac{1}{y+z} + \frac{(y-x)(1+x)}{(y+z)^2(1+z)}e^{x-z}}.
\]

\item
函数 $z = 1 - \dfrac{x^2}{a^2} - \dfrac{y^2}{b^2}$ 在点 $\displaystyle\left(\frac{a}{\sqrt{2}},\frac{b}{\sqrt{2}}\right)$ 沿曲线
$\dfrac{x^2}{a^2}+\dfrac{y^2}{b^2}=1$ 在该点的内法线方向（单位方向）的方向导数.

\textbf{解：}
记 $\displaystyle F(x,y)=\frac{x^2}{a^2}+\frac{y^2}{b^2}-1$. 曲线在给定点处的梯度为
\[
\nabla F = \Bigl(\frac{2x}{a^2},\frac{2y}{b^2}\Bigr)
= \Bigl(\frac{\sqrt{2}}{a},\frac{\sqrt{2}}{b}\Bigr),
\]
其指向 $F$ 增加的方向, 即外法向. 单位内法向为
\[
\mathbf{n} = -\frac{\nabla F}{|\nabla F|}
= -\frac{1}{\sqrt{\frac{1}{a^2}+\frac{1}{b^2}}}\Bigl(\frac{1}{a},\frac{1}{b}\Bigr).
\]
函数 $z$ 的梯度为
\[
\nabla z = \Bigl(-\frac{2x}{a^2},-\frac{2y}{b^2}\Bigr)
= \Bigl(-\frac{\sqrt{2}}{a},-\frac{\sqrt{2}}{b}\Bigr).
\]
故方向导数为
\[
\frac{\partial z}{\partial \mathbf{n}} = \nabla z \cdot \mathbf{n}
= \frac{\frac{\sqrt{2}}{a^2}+\frac{\sqrt{2}}{b^2}}{\sqrt{\frac{1}{a^2}+\frac{1}{b^2}}}
= \sqrt{2}\,\sqrt{\frac{1}{a^2}+\frac{1}{b^2}}.
\]
由于 $\displaystyle \sqrt{\frac{1}{a^2}+\frac{1}{b^2}} = \frac{\sqrt{a^2+b^2}}{|ab|}$（注意 $ab$ 未必为正，此处需用绝对值），
故最终结果也可写为 $\dfrac{\sqrt{2(a^2+b^2)}}{|ab|}$。
答案填 $\underline{\dfrac{\sqrt{2(a^2+b^2)}}{|ab|}}$（或等价形式 $\displaystyle\sqrt{2}\sqrt{\frac{1}{a^2}+\frac{1}{b^2}}$）.

\item
设函数 $z=z(x,y)$ 满足 $\dfrac{\partial^2 z}{\partial x\partial y}=x+y$ 及条件
$z(x,0)=x,\;z(0,y)=y^2$，求 $z$ 的表达式.

\textbf{解：}
先对 $y$ 积分：
\[
\frac{\partial z}{\partial x} = \int (x+y)\,\mathrm{d}y = xy + \frac{y^2}{2} + \varphi(x).
\]
再对 $x$ 积分：
\[
z = \int \Bigl(xy + \frac{y^2}{2} + \varphi(x)\Bigr)\mathrm{d}x
= \frac{x^2y}{2} + \frac{xy^2}{2} + \Phi(x) + \psi(y),
\]
其中 $\Phi'(x)=\varphi(x)$.
代入条件：
\begin{align*}
z(x,0) &= \Phi(x) + \psi(0) = x,\\
z(0,y) &= \Phi(0) + \psi(y) = y^2.
\end{align*}
由第一式得 $\Phi(x) = x - \psi(0)$；代入第二式得
$\psi(y) = y^2 - \Phi(0) = y^2 + \psi(0)$.
于是
\[
z = \frac{x^2y}{2} + \frac{xy^2}{2} + \bigl(x - \psi(0)\bigr) + \bigl(y^2 + \psi(0)\bigr)
= \underline{\frac{x^2y}{2} + \frac{xy^2}{2} + x + y^2}.
\]
即 $z = x + y^2 + \dfrac{xy(x+y)}{2}$.

\item
若光滑曲线 $y=y(x)$ 在 $x$ 点处的曲率定义为 $\kappa = \dfrac{|y''|}{(1+|y'|^2)^{3/2}}$，
求由方程 $u(x,y)=0$ 表示的光滑曲线在 $(x,y)$ 点处的曲率计算公式.

\textbf{解：}
因为曲线光滑，故 $\nabla u = (u_x,u_y)\neq \mathbf{0}$。不妨设 $u_y\neq0$（若 $u_y=0$ 则必有 $u_x\neq0$，可利用 $x$ 对 $y$ 的隐函数类似推导，得到的公式在形式上关于 $x,y$ 对称）。

由隐函数求导法则：
\[
y' = -\frac{u_x}{u_y},\quad |y'| = \frac{|u_x|}{|u_y|}.
\]
继续求二阶导：
\[
y'' = -\frac{u_{xx}u_y^2 - 2u_{xy}u_xu_y + u_{yy}u_x^2}{u_y^3}.
\]
代入曲率公式：
\begin{align*}
\kappa &= \frac{|y''|}{(1+|y'|^2)^{3/2}}
= \frac{\bigl|u_{xx}u_y^2 - 2u_{xy}u_xu_y + u_{yy}u_x^2\bigr|}{|u_y|^3 \Bigl(1+\frac{u_x^2}{u_y^2}\Bigr)^{3/2}} \\
&= \frac{|u_{xx}u_y^2 - 2u_{xy}u_xu_y + u_{yy}u_x^2|}{(u_y^2+u_x^2)^{3/2}}.
\end{align*}
故答案为 $\underline{\dfrac{|u_{xx}u_y^2 - 2u_{xy}u_xu_y + u_{yy}u_x^2|}{(u_x^2+u_y^2)^{3/2}}}$。
（若 $u_y=0$，则由对称性公式不变。）

\item
将周长为 $2a\;(a>0)$ 的矩形绕其一边旋转，使其旋转体体积最大，
此时矩形的相邻边长分别为 $\underline{\dfrac{a}{3}}$ 和 $\underline{\dfrac{2a}{3}}$.

\textbf{解：}
设绕长度为 $x$ 的边旋转，另一边长为 $y$，则 $x+y=a$.

旋转体为圆柱，体积 $V = \pi y^2 x = \pi y^2(a-y),\ 0<y<a$.

令 $\displaystyle\frac{\mathrm{d}V}{\mathrm{d}y} = \pi(2ay - 3y^2)=0$，得 $\displaystyle y = \frac{2a}{3}$，此时 $\displaystyle x = \frac{a}{3}$。
故相邻边长分别为 $\displaystyle\frac{a}{3}$ (旋转轴) 和 $\displaystyle\frac{2a}{3}$（答案顺序可互换）。

\item
椭圆 $(x-2y+1)^2 + (3x+y-2)^2 = 1$ 的面积为 $\underline{\dfrac{\pi}{7}}$。

\textbf{解：}
令 $u = x-2y+1,\ v = 3x+y-2$，则 Jacobi 行列式为
\[
\frac{\partial(u,v)}{\partial(x,y)} = \begin{vmatrix} 1 & -2 \\ 3 & 1 \end{vmatrix} = 7.
\]
椭圆变为单位圆 $u^2+v^2\le 1$，其面积为 $\pi$。
故原椭圆面积 $\displaystyle S = \left|\frac{\partial(x,y)}{\partial(u,v)}\right|\cdot\pi = \underline{\dfrac{\pi}{7}}$。

\item
计算 $\displaystyle \int_{0}^{1}\mathrm{d}x\int_{0}^{x}\frac{\mathrm{d}y}{\sqrt{(1-x)(x-y)}} = \underline{\pi}$。

\textbf{解：}
先对 $y$ 积分，视 $x$ 为常数：
\[
\int_0^x \frac{\mathrm{d}y}{\sqrt{x-y}} = \bigl[-2\sqrt{x-y}\bigr]_{y=0}^{y=x} = 2\sqrt{x}.
\]
于是原式化为
\[
\int_0^1 \frac{2\sqrt{x}}{\sqrt{1-x}}\,\mathrm{d}x = 2\int_0^1 \sqrt{\frac{x}{1-x}}\,\mathrm{d}x.
\]
令 $x = \sin^2 t$，则 $\mathrm{d}x = 2\sin t\cos t\,\mathrm{d}t$，积分限：$x=0$ 对应 $t=0$，$x=1$ 对应 $\displaystyle t=\frac{\pi}{2}$.
代入得：
\begin{align*}
2\int_0^1 \sqrt{\frac{x}{1-x}}\,\mathrm{d}x
&= 2\int_0^{\pi/2} \frac{\sin t}{\cos t}\cdot 2\sin t\cos t\,\mathrm{d}t \\
&= 4\int_0^{\pi/2} \sin^2 t\,\mathrm{d}t
= 4\cdot\frac{\pi}{4} = \pi.
\end{align*}
故答案为 $\underline{\pi}$.

\item 计算 $\displaystyle \iint_{x^4+y^4\le 1}(x^2+y^2)\,\mathrm{d}x\mathrm{d}y$.

\textbf{解：（极坐标换元，二倍角公式）}

作极坐标变换 $x=r\cos\theta$, $y=r\sin\theta$，则 $x^2+y^2=r^2$，面积元 $\mathrm{d}x\mathrm{d}y=r\,\mathrm{d}r \mathrm{d}\theta$.

积分区域 $x^4+y^4\le 1$ 化为
\[
r^4(\cos^4\theta+\sin^4\theta)\le 1 \quad\Longrightarrow\quad 0\le r\le \frac{1}{\sqrt[4]{\cos^4\theta+\sin^4\theta}},\quad 0\le\theta\le 2\pi.
\]
于是
\begin{align*}
\iint_{x^4+y^4\le 1}(x^2+y^2)\,\mathrm{d}x\mathrm{d}y
&= \int_0^{2\pi} \mathrm{d}\theta \int_0^{(\cos^4\theta+\sin^4\theta)^{-1/4}} r^3\,\mathrm{d}r \\
&= \frac{1}{4}\int_0^{2\pi} \frac{\mathrm{d}\theta}{\cos^4\theta+\sin^4\theta}.
\end{align*}
利用三角恒等式化简分母：
\begin{align*}
\cos^4\theta+\sin^4\theta
&= (\cos^2\theta+\sin^2\theta)^2 - 2\sin^2\theta\cos^2\theta \\
&= 1 - \frac{1}{2}\sin^2 2\theta
= 1 - \frac{1}{4}(1-\cos 4\theta)
= \frac{3+\cos 4\theta}{4}.
\end{align*}
所以
\[
\frac{1}{\cos^4\theta+\sin^4\theta} = \frac{4}{3+\cos 4\theta}.
\]
代入得
\[
\iint_{x^4+y^4\le 1}(x^2+y^2)\,\mathrm{d}x\mathrm{d}y = \frac{1}{4}\int_0^{2\pi} \frac{4}{3+\cos 4\theta}\,\mathrm{d}\theta = \int_0^{2\pi} \frac{\mathrm{d}\theta}{3+\cos 4\theta}.
\]
令 $\phi = 4\theta$，则 $\displaystyle\mathrm{d}\theta = \frac{1}{4}\mathrm{d}\phi$，且当 $\theta$ 从 $0$ 到 $2\pi$ 时，$\phi$ 从 $0$ 到 $8\pi$. 因此
\[
\int_0^{2\pi} \frac{\mathrm{d}\theta}{3+\cos 4\theta} = \frac{1}{4}\int_0^{8\pi} \frac{\mathrm{d}\phi}{3+\cos\phi}.
\]
因为被积函数以 $2\pi$ 为周期，$\displaystyle\int_0^{8\pi} = 4\int_0^{2\pi}$，所以上式化为
\[
\frac{1}{4}\cdot 4\int_0^{2\pi} \frac{\mathrm{d}\phi}{3+\cos\phi} = \int_0^{2\pi} \frac{\mathrm{d}\phi}{3+\cos\phi}.
\]
对于积分 $\displaystyle \int_0^{2\pi} \frac{d\phi}{a+\cos\phi}\;(a>1)$，利用标准公式（或万能代换 $\displaystyle t=\tan\frac{\phi}{2}$）可得其值为 $\displaystyle\frac{2\pi}{\sqrt{a^2-1}}$.
此处 $a=3$，故
\[
\int_0^{2\pi} \frac{\mathrm{d}\phi}{3+\cos\phi} = \frac{2\pi}{\sqrt{3^2-1}} = \frac{2\pi}{\sqrt{8}} = \frac{\pi}{\sqrt{2}}.
\]
因此原积分为 $\underline{\displaystyle \frac{\pi}{\sqrt{2}}}$.
\end{enumerate}

\textbf{二、解答题（共40分）}
\begin{enumerate}

\item[1.]（10分）
在区间 $[1,3]$ 上用线性函数 $ax+b$ 近似代替 $x^2$，使得绝对偏差
\[
\Delta = \sup_{1\leq x\leq 3}|x^2-(ax+b)|
\]
最小，求 $a,b$ 及最小偏差.

\textbf{解：}
记 $f(x) = x^2 - (ax+b)$，则 $\Delta = \sup\limits_{1\le x\le 3}|f(x)|$.
因为 $1,2,3\in[1,3]$，所以
\[
\Delta \ge |f(1)|,\quad \Delta \ge |f(2)|,\quad \Delta \ge |f(3)|.
\]
利用绝对值不等式，
\[
4\Delta \ge |f(1)| + 2|f(2)| + |f(3)| \ge |f(1) - 2f(2) + f(3)|.
\]
计算组合：
\begin{align*}
f(1) - 2f(2) + f(3) 
&= \bigl[1 - (a+b)\bigr] - 2\bigl[4 - (2a+b)\bigr] + \bigl[9 - (3a+b)\bigr] \\
&= 1 - a - b - 8 + 4a + 2b + 9 - 3a - b = 2.
\end{align*}
于是 $\displaystyle 4\Delta \ge 2$，即 $\Delta \ge \dfrac{1}{2}$.
要使 $\Delta$ 取到下界 $\displaystyle\frac{1}{2}$，上述不等式必须全部成为等式，这要求
\[
|f(1)| = |f(2)| = |f(3)| = \frac{1}{2},\quad 
f(1),\; -2f(2),\; f(3)\ \text{同号}.
\]
观察待定系数，取 $\displaystyle f(1)=\frac{1}{2},\ f(2)=-\frac{1}{2},\ f(3)=\frac{1}{2}$ 即可满足（此时 $-2f(2)=1>0$ 与 $f(1),f(3)$ 同号）. 代入得方程组
\[
\begin{cases}
1 - a - b = \dfrac{1}{2}, \\
4 - 2a - b = -\dfrac{1}{2}, \\
9 - 3a - b = \dfrac{1}{2}.
\end{cases}
\]
由前两式相减得 $a=4$，回代得 $b=-\dfrac{7}{2}$. 经检验满足第三式.
此时 $\Delta = \dfrac{1}{2}$ 达到下界.

故 $a=4,\ b=-\dfrac{7}{2}$，最小偏差为 $\dfrac{1}{2}$.

\item[2.]（15分）
证明：
\[
\underset{\substack{x_i\ge 0\;(i=1,\cdots,n)\\ 
x_1+\cdots+x_n\le a}}{\int\int\cdots\int} f(x_1+\cdots+x_n)\,\mathrm{d}x_1\cdots \mathrm{d}x_n
= \int_0^a f(x)\,\frac{x^{n-1}}{(n-1)!}\,\mathrm{d}x.
\]

\textbf{证明：}
\textbf{方法一（变量变换）}
令
\[
y_1 = x_1,\quad y_2 = x_1+x_2,\quad \dots,\quad y_n = x_1+x_2+\cdots+x_n.
\]
则逆变换为
\[
x_1 = y_1,\quad x_2 = y_2-y_1,\quad \dots,\quad x_n = y_n-y_{n-1}.
\]
Jacobi 行列式为
\[
\frac{\partial(x_1,\dots,x_n)}{\partial(y_1,\dots,y_n)}
= \begin{vmatrix}
1 & 0 & 0 & \cdots & 0 \\
-1 & 1 & 0 & \cdots & 0 \\
0 & -1 & 1 & \cdots & 0 \\
\vdots & \vdots & \ddots & \ddots & \vdots \\
0 & 0 & \cdots & -1 & 1
\end{vmatrix} = 1.
\]
积分区域 $x_i\ge 0,\; \sum x_i\le a$ 变为
\[
0 \le y_1 \le y_2 \le \cdots \le y_n \le a.
\]
于是
\begin{align*}
\text{左端} &= \int_0^a \mathrm{d}y_n \int_0^{y_n} \mathrm{d}y_{n-1} \cdots \int_0^{y_2} f(y_n)\,\mathrm{d}y_1\cdots \mathrm{d}y_{n-1} \\
&= \int_0^a f(y_n) \Bigl( \int_{0\le y_1\le\cdots\le y_{n-1}\le y_n} \mathrm{d}y_1\cdots \mathrm{d}y_{n-1} \Bigr) \mathrm{d}y_n.
\end{align*}
括号内的积分是 $n-1$ 维标准单纯形的体积，其值为 $\dfrac{y_n^{n-1}}{(n-1)!}$.
代入即得所证等式. \qed

\textbf{方法二（数学归纳法）}
对 $n$ 进行归纳. 当 $n=1$ 时，等式显然成立.
假设 $n=k$ 时成立，对 $n=k+1$：
\begin{align*}
&\underset{\substack{x_i\ge 0\;(i=1,\cdots,k+1)\\ 
x_1+\cdots+x_{k+1}\le a}}{\int\int\cdots\int} f(x_1+\cdots+x_{k+1})\,\mathrm{d}x_1\cdots \mathrm{d}x_{k+1} \\
&= \int_0^a \mathrm{d}x_{k+1} \underset{\substack{x_i\ge 0\;(i=1,\cdots,k+1)\\ 
x_1+\cdots+x_k \le a - x_{k+1}}}{\int\int\cdots\int}
f(x_1+\cdots+x_k+x_{k+1})\,\mathrm{d}x_1\cdots \mathrm{d}x_k \\
&= \int_0^a \mathrm{d}x_{k+1} \int_0^{a-x_{k+1}} f(u+x_{k+1})\,\frac{u^{k-1}}{(k-1)!}\,\mathrm{d}u \quad\text{(归纳假设)} \\
&= \int_0^a f(v)\,\mathrm{d}v \int_0^v \frac{u^{k-1}}{(k-1)!}\,\mathrm{d}u \quad(\text{令 }v=u+x_{k+1},\; u=v-x_{k+1}) \\
&= \int_0^a f(v)\,\frac{v^k}{k!}\,\mathrm{d}v.
\end{align*}
由数学归纳法可知命题成立. \qed 

\item[3.]（15分）
证明：函数 $f(x,y) = \exp(-y^2+2xy)$ 能展成对 $x$ 和 $y$ 的一切值都收敛的级数
\[
\sum_{n=0}^\infty \frac{H_n(x)}{n!} y^n,
\]
其中多项式 $H_n(x)$ 称为 Hermite 多项式，满足
\begin{enumerate}[label=(\alph*)]
\item $H_n(x)$ 是一个 $n$ 次多项式；
\item $H_n'(x) = 2n H_{n-1}(x)$；
\item $H_{n+1}(x) - 2x H_n(x) + 2n H_{n-1}(x) = 0$；
\item $H_n''(x) - 2x H_n'(x) + 2n H_n(x) = 0$.
\end{enumerate}

\textbf{证明：}\\
\textbf{（方法一）}
\textbf{1. 级数展开的存在性与收敛性.}

对任意固定的 $x\in\mathbb{R}$，将 $f(x,y)$ 视为 $y$ 的函数。利用指数函数的幂级数展开
\[
e^{2xy} = \sum_{m=0}^\infty \frac{(2x)^m}{m!} y^m,\qquad
e^{-y^2} = \sum_{k=0}^\infty \frac{(-1)^k}{k!} y^{2k},
\]
这两个级数对一切实数 $x,y$ 均绝对收敛，从而它们的 Cauchy 乘积也绝对收敛，并可重排为关于 $y$ 的幂级数.

固定 $x$，两级数为 $y$ 的幂级数，绝对收敛保证了乘积级数可按任意方式求和。按 $y$ 的升幂排列：
\[
f(x,y) = \sum_{m=0}^\infty\sum_{k=0}^\infty \frac{(-1)^k (2x)^m}{m!k!} y^{m+2k}
= \sum_{n=0}^\infty \Bigl( \sum_{k=0}^{\lfloor n/2\rfloor} \frac{(-1)^k (2x)^{n-2k}}{k!(n-2k)!} \Bigr) y^n.
\]
令
\[
H_n(x) = n! \sum_{k=0}^{\lfloor n/2\rfloor} \frac{(-1)^k (2x)^{n-2k}}{k!(n-2k)!},
\]
则
\[
f(x,y) = \sum_{n=0}^\infty \frac{H_n(x)}{n!} y^n.
\]
因为两级数绝对收敛，重排求和次序是合法的，所得幂级数的收敛半径关于 $y$ 为无穷大，对一切实数 $x,y$ 均绝对收敛.

\textbf{2. $H_n(x)$ 是 $n$ 次多项式.}

在 $H_n(x)$ 的表达式中，$k=0$ 项为 $\dfrac{(2x)^n}{0!n!}$，乘以 $n!$ 得 $(2x)^n$，这是 $x$ 的最高次项；其余各项次数均低于 $n$.

故 $H_n(x)$ 是 $n$ 次多项式，(a) 得证.

\textbf{3. 递推关系与导数性质.}

由于幂级数 $\displaystyle\sum \frac{H_n(x)}{n!} y^n$ 的收敛半径为无穷大，它在其收敛域内对 $y$ 可逐项求导，且求导后级数仍处处收敛。对固定的 $y$，作为 $x$ 的函数的级数同样处处收敛且可逐项求导（因为 $H_n(x)$ 是多项式，
级数是 $x$ 的多项式级数乘以 $\displaystyle\frac{y^n}{n!}$，绝对收敛性继承了）.
对生成函数 $\displaystyle f(x,y) = e^{2xy-y^2}$ 关于 $y$ 求偏导：
\[
\frac{\partial f}{\partial y} = (2x-2y)f.
\]
将级数代入：
\[
\sum_{n=1}^\infty \frac{H_n(x)}{(n-1)!} y^{n-1}
= (2x-2y)\sum_{n=0}^\infty \frac{H_n(x)}{n!} y^n
= \sum_{n=0}^\infty \frac{2x H_n}{n!} y^n - \sum_{n=0}^\infty \frac{2 H_n}{n!} y^{n+1}.
\]
比较两边 $y^n$ 的系数（左侧级数中 $y^n$ 的项来自 $n+1$，系数为 $\displaystyle\frac{H_{n+1}}{n!}$；右侧第二项取 $n-1$ 得 $\displaystyle\frac{2H_{n-1}}{(n-1)!} = \frac{2n H_{n-1}}{n!}$）得
\[
\frac{H_{n+1}}{n!} = \frac{2x H_n}{n!} - \frac{2n H_{n-1}}{n!},
\]
即
\[
H_{n+1} - 2x H_n + 2n H_{n-1} = 0,
\]
此即性质 (c)。

对 $f$ 关于 $x$ 求偏导：
\[
\frac{\partial f}{\partial x} = 2y f.
\]
代入级数：
\[
\sum_{n=0}^\infty \frac{H_n'(x)}{n!} y^n
= 2y\sum_{n=0}^\infty \frac{H_n(x)}{n!} y^n
= 2\sum_{n=0}^\infty \frac{H_n}{n!} y^{n+1}
= 2\sum_{n=1}^\infty \frac{H_{n-1}}{(n-1)!} y^n.
\]
比较 $y^n$ 系数得
\[
\frac{H_n'}{n!} = \frac{2 H_{n-1}}{(n-1)!} \quad\Longrightarrow\quad H_n' = 2n H_{n-1},
\]
此即性质 (b)。（逐项求导的合法性由幂级数在收敛域内可逐项求导保证，且 $H_n(x)$ 是多项式，整个运算在实数范围内完全严格。）

最后推导性质 (d)。由性质 (b) 得 $\displaystyle H_{n-1} = \frac{1}{2n}H_n'$，代入性质 (c)：
\[
H_{n+1} - 2x H_n + 2n\cdot\frac{1}{2n}H_n' = 0
\quad\Longrightarrow\quad H_{n+1} = 2x H_n - H_n'.
\]
对两边求导，并再次利用 (b)：
\[
H_{n+1}' = 2H_n + 2x H_n' - H_n'',
\]
而由 (b) 知 $H_{n+1}' = 2(n+1)H_n$，故
\[
2(n+1)H_n = 2H_n + 2x H_n' - H_n'',
\]
整理即得
\[
H_n'' - 2x H_n' + 2n H_n = 0,
\]
这就是性质 (d). 证毕.\qed

\textbf{（方法二，由 木土_-_日月 提供）}

反过来思考，我们只需证明满足 (a)(b)(c)(d) 的一列 Hermite 多项式 $H_n(x)$ 参与构成的级数 $\displaystyle H(x,y)=\sum_{n=0}^{+\infty}\frac{H_n(x)}{n!}y^n$ 正是 $\displaystyle e^{-y^2+2xy}$. 

根据函数 $\displaystyle e^{-y^2+2xy}$ 的解析性，考虑利用 (a)(b)(c) 构造一个带初值条件的偏微分方程组. 

(事实上，(d)是(b)(c)的推论.) 

以下计算先在\textbf{形式幂级数}意义下进行.

先给出初值条件：$\displaystyle H(x,0)\equiv 1$. 
然后给出两个偏微分方程
\[
\begin{aligned}
H_x(x,y)
&\xlongequal{\mathrm{(b)}}\sum_{n=1}^{+\infty}\frac{2nH_{n-1}(x)}{n!}y^n
=\sum_{n=1}^{+\infty}\frac{2H_{n-1}(x)}{(n-1)!}y^n
=2y\sum_{n=1}^{+\infty}\frac{H_{n-1}(x)}{(n-1)!}y^{n-1}
=2yH(x,y).\\
H_y(x,y)&=\sum_{n=0}^{+\infty}\frac{H_{n+1}(x)}{n!}y^{n}\xlongequal{\mathrm{(c)}}\sum_{n=0}^{+\infty}\frac{2xH_n(x)}{n!}y^n-\sum_{n=0}^{+\infty}\frac{2(n+1)H_{n}(x)}{(n+1)!}y^{n+1}=(2x-2y)H(x,y).
\end{aligned}
\]
求解这个带有初值条件的偏微分方程组即得 $\displaystyle H(x,y)\equiv e^{-y^2+2xy}$，从而 $\displaystyle \frac{H_n(x)}{n!}$ 正是
$e^{-y^2+2xy}$ 关于 $y$ 的 Taylor 系数.
又由于 $e^{-y^2+2xy}$ 关于 $y$ 是整函数，故该 Taylor 级数的确对任意 $x,y\in\mathbb R$ 收敛，从而 $e^{-y^2+2xy}$ 确实可以展开成题目所要求的级数形式.
\qed

\textbf{附：(d) 是 (b)(c) 的推论.}

已知
\[
\begin{aligned}
& \mathrm{(b)} \quad H_n'(x) = 2n H_{n-1}(x) \\
& \mathrm{(c)} \quad H_{n+1}(x) - 2x H_n(x) + 2n H_{n-1}(x) = 0 
\end{aligned}
\]
对 (b) 关于 $x$ 求导可得 $H_n''(x) = 2n H_{n-1}'(x)\xlongequal{\mathrm{(b)}}2n \cdot 2(n-1) H_{n-2}(x) = 4n(n-1) H_{n-2}(x)$.

将 (c) 中的 $n$ 替换为 $n-1$ 可得
$H_n(x) - 2x H_{n-1}(x) + 2(n-1) H_{n-2}(x) = 0\,(n\geq 2)$，

从而有$ 2(n-1) H_{n-2}(x) = 2x H_{n-1}(x) - H_n(x)$.
故
\[
\begin{aligned}
H_n''(x) &= 2n\bigl[2(n-1) H_{n-2}(x)\bigr] = 2n\bigl(2x H_{n-1}(x) - H_n(x)\bigr) = 4nx H_{n-1}(x) - 2n H_n(x)\\ &\xlongequal{\mathrm{(b)}} 2x H_n'(x) - 2n H_n(x).
\end{aligned}
\]
从而移项即得性质 (d).
此外，由初值 $H_0=1$ 以及 (c) 中 $n=0$ 的情形可得 $H_1=2x$，故直接代入可知 $n=0,1$ 时 (d) 也成立.
故 (d) 为 (b)(c) 推论. \qed
\end{enumerate}