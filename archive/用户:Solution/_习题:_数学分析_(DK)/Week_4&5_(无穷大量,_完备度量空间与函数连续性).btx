\newenvironment{solution}{\begin{proofc}[解答]}{\end{proofc}}

== 习题A ==

\begin{enumerate}
    \item[1.]对下列无穷大量(其中 $\displaystyle x\rightarrow +\infty$)从低阶到高阶进行排序,并说明理由:

    \[\displaystyle a^{x}(a > 1), \quad x^{x}, \quad x^{\alpha}(\alpha >0), \quad (\ln x)^{k}(k > 0), \quad \lfloor x\rfloor !\]

    \item[2.]对下列无穷小量(其中 $\displaystyle x\rightarrow 0+$)从高阶到低阶进行排序,并说明理由:

    \[\displaystyle x^{\alpha}(\alpha >0),\quad \frac{1}{\lfloor \frac{1}{x}\rfloor !},\quad a^{-\frac{1}{x}}(a > 1),\quad \left(\frac{1}{x}\right)^{-\frac{1}{x}},\quad \left(\ln \frac{1}{x}\right)^{-k}(k > 0).\]

    \item[3.]用二分法给出 $\sqrt[3]{6}$ 的一个估算值,要求初始的估计上下界为1和2,且误差不超过 $\displaystyle\frac{1}{8}$.

    \item[4.]已知 $a,b > 0$, 证明:方程 $\displaystyle x = a\sin x + b$ 至少有一个正实数解.

    \item[5.]已知 $p\geq 0$, 问方程 $\displaystyle x^{3} + px + q = 0$ 有多少不相等的实根(不计重数)?

    \item[6.]已知函数 $f(x)$ 在 $[0,2]$ 上连续, 且 $f(0)=f(2)$. 证明:存在 $x,y\in [0,2]$, 满足 $y - x = 1$ 且 $f(x) = f(y)$.

    \item[7.]证明:
    \begin{enumerate}
        \item[(a)]$\displaystyle \sin \frac{1}{x}$ 在 $(0,1)$ 上不一致连续,但在 $(a,1)$ 上一致连续(其中 $0< a< 1$);
        \item[(b)]$\displaystyle \sin (x^{2})$ 在 $(- \infty ,+ \infty)$ 上不一致连续,但在 $[0,A]$ 上一致连续(其中 $A > 0$);
        \item[(c)]$\displaystyle \sqrt{x}$ 在 $[0,+ \infty)$ 上一致连续;
        \item[(d)]$\ln x$ 在 $[1,+ \infty)$ 上一致连续;
        \item[(e)]$\displaystyle \cos \sqrt{x}$ 在 $[0,+ \infty)$ 上一致连续.
    \end{enumerate}
\end{enumerate}

== 习题B ==

\begin{enumerate}
    \item[1.]我们称定义在某区间 $I$ 内的函数 $f(x)$ 是一个 \textbf{Lipschitz 连续函数},如果 $L > 0$ ,使得对任意 $x,y\in I$, 总有 $\displaystyle|f(x) - f(y)|\leq L|x - y|$. 
    证明:若 $f(x)$ 是定义在区间 $I$ 上的一个 Lipschitz 连续函数,则其在 $I$ 上一致连续.
    \item[2.]我们称定义在某区间 $I$ 内的函数 $f(x)$ 是一个 \textbf{Hölder 连续函数},如果存在 $\alpha \in (0,1)$ 与 $C > 0$, 使得对任意 $x,y\in I$, 总有 $\displaystyle|f(x) - f(y)|\leq C|x - y|^{\alpha}$. 
    证明:若 $f(x)$ 是定义在区间 $I$ 上的一个 Hölder 连续函数, 则其在 $I$ 上一致连续.
    \item[3.]已知函数 $f(x)$ 在开区间 $(a,b)$ 上连续, 且极限 $f(a + )$ 与 $f(b - )$ 均存在, 证明: $f(x)$ 可以在 $(a,b)$ 上取到介于 $f(a + )$ 与 $f(b - )$ 之间的一切中间值.
    \item[4.]已知定义在闭区间 $[a, b]$ 上的单调有界函数 $f(x)$ 能够取到 $f(a)$ 和 $f(b)$ 之间的一切值, 证明: $f(x)$ 在 $[a, b]$ 上连续.
    \item[5.]给定椭圆 $\Gamma$ 与其内部一点 $P$, 证明:存在一条过 $P$ 且以 $P$ 为中点的椭圆 $\Gamma$ 的弦.
    \item[6.]已知定义在 $\mathbb{R}$ 上的连续函数 $f(x)$ 在有理数集 $\mathbb{Q}$ 上单调增, 证明: $f(x)$ 在 $\mathbb{R}$ 上也单调增.
    \begin{solution}
        设 $x,\,y\in\mathbb{R},\,x<y$. 只需证明 $f(x)\leq f(y)$.\\
        由于 $\mathbb{Q}$ 在 $\mathbb{R}$ 上稠密，因此存在有理数序列 $\{p_{n}\}$ 和 $\{q_{n}\}$ 满足：\\
        $p_{n}$ 为大于 $x$ 且小于 $y$ 的有理数，使得 $p_{n}$ 严格递减趋于$x$；\\
        $q_{n}$ 为大于 $p_{n}$ 且小于 $y$ 的有理数，使得 $q_{n}$ 严格递增趋于$y$.\\
        由于 $f$ 在 $\mathbb{Q}$ 上单调递增，且 $p_{n}<q_{n}$，从而有：
        \[
        \forall n\in\mathbb{N}_{+},\,f(p_{n})\leq f(q_{n}).
        \]
        由于 $f(x)$ 连续，且 $p_{n}\to x,\,q_{n}\to y(n\to +\infty)$，故有：
        \[
        \lim_{n\to+\infty}f(p_{n})=f(x),\,\lim_{n\to+\infty}f(q_{n})=f(y).
        \]
        对不等式 $f(p_{n})<f(q_{n})$，令 $n\to +\infty$ 有 $f(x)\leq f(y)$.\\
        因此对任意实数 $x<y$，有 $f(x)<f(y)$，即 $f$ 在 $\mathbb{R}$ 上单调递增.
    \end{solution}
    \item[7.]证明:
    \begin{enumerate}
        \item[(a)]某区间上两个一致连续函数之和必定一致连续;
        \item[(b)]某区间上两个一致连续函数之积不一定一致连续.
    \end{enumerate}
    \item[8.]设 $f \in C(-\infty , +\infty)$ 且

    \[\displaystyle \lim_{x\to -\infty}f(x) = A,\quad \lim_{x\to +\infty}f(x) = B.\]

    证明: $f$ 在 $(-\infty , +\infty)$ 上一致连续.
    \item[9.]已知函数 $f(x)$ 在 $[a, b]$ 上连续, $\displaystyle a \leq x_1 < x_2 < \cdots < x_n \leq b$, 证明:存在 $\xi \in [a, b]$, 使得

    \[\displaystyle f(\xi) = \frac{f(x_1) + f(x_2) + \cdots + f(x_n)}{n}.\]

    \item[10.]用闭区间套定理(可以查阅并直接使用其高维版本) 证明:三角形的三条中线交于一点. (提示:考虑三角形三边中点围成的小三角形,并迭代.)
    \item[11.]设 $f$ 在 $[a, b]$ 上是\textbf{下半连续}的, 即对任意 $z \in [a, b]$ 成立

    \[\displaystyle\liminf_{x\to z} f(x)\geq f(z).\]

    证明:在 $[a, b]$ 上 $f(x)$ 存在最小值点.
    \begin{solution}
        假设$f$无下界，则 $\forall M\in\mathbb{N}_{+}$，存在点 $x_{M}\in[a,b]$ 使得 $f(x_{M})<-M$.\\
        考虑序列 $\{x_{M}\}$，由于 $[a,b]$ 是有界闭区间，由 Bolzano-Weierstrass 定理可知存在收敛子列 $\{x_{M_{k}}\}$ 收敛到某点 $z\in[a,b]$.\\
        由 $f$ 的下半连续性，在点 $z$ 处有
        \[
        \liminf_{x\to z}f(x)\geq f(z).
        \]
        特别地，对于子列 $\{x_{M_{k}}\}$，有
        \[
        \liminf_{k\to +\infty}f(x_{M_{k}})\geq f(z).
        \]
        但由序列的构造可知 $f(x_{M_{k}})<-M_{k}$ 且 $M_{k}\to +\infty(k\to+\infty)$，所以
        \[
        \liminf_{k\to+\infty}f(x_{M_{k}})=-\infty.
        \]
        从而 $-\infty\geq f(z)$，与 $f(z)$ 是实数值矛盾. 故假设不成立，即 $f$ 在 $[a,b]$ 上有下界.\\
        由 $f$ 在 $[a,b]$ 上有下界，设
        \[
        m=\inf_{x\in[a,b]}f(x).
        \]
        由下确界的定义，存在序列 $\{x_{n}\}\subset[a,b]$ 使得
        \[
        \lim_{n\to+\infty}f(x_{n})=m.
        \]
        由于 $[a,b]$ 为有界闭区间，由 Bolzano-Weierstrass 定理可知，序列 $\{x_{n}\}$ 存在收敛子列 $\{x_{n_{k}}\}$ 收敛到某点 $x_{0}\in[a,b]$，即
        \[
        \lim_{k\to +\infty}x_{n_{k}}=x_{0}.
        \]
        由 $f$ 的下半连续性可知在点 $x_{0}$ 处有
        \[
        \liminf_{x\to x_{0}}\geq f(x_{0}).
        \]
        特别地，对于子列$\{x_{n_{k}}\}$，有
        \[
        \liminf_{k\to +\infty}f(x_{n_{k}})\geq f(x_{0}).
        \]
        但由序列的构造，
        \[
        \lim_{k\to +\infty}f(x_{n_{k}})=m
        \]
        所以
        \[
        \liminf_{k\to +\infty}f(x_{n_{k}})=m.
        \]
        因此 $f(x_{0})\leq m$.
        又 $m$ 为下确界，所以 $f(x_{0})\geq m$.
        从而 $m=f(x_{0})$，这意味着 $x_{0}$ 是 $f$ 在 $[a,b]$ 上的最小值点.
    \end{solution}
\end{enumerate}

== 习题C ==

单因素 0.618 优选法可以用来逼近先增后减连续函数的最大值点. 我们考虑定义在[0,1]上的连续函数 $f(x)$,
已知其在 $[0,x^{*}]$ 上增而在 $[x^{*},1]$ 上减,其中 $x^{*}\in [0,1]$, 且若 $x^{*}\in \{0,1\}$, 
则函数 $f(x)$ 退化为单调函数. 然而由于缺乏 $f(x)$ 的显式表达, 故难以通过求导等手段寻找最大值点 $x^{*}$.
单因素 0.618 优选法通过不断代入合适的自变量 $x$, 获得因变量 $y = f(x)$ 的值, 进而逼近函数的最大值点 $x^{*}$.

\begin{enumerate}
    \item[1.]优选法的第一步是选取四个自变量值, 分别是

    \[\displaystyle a_{1} = 0,\quad b_{1} = 1,\quad c_{1} = \frac{3 - \sqrt{5}}{2},\quad d_{1} = \frac{\sqrt{5} - 1}{2}.\]

    代入函数 $f(x)$, 求得 $f(a_{1})$, $f(b_{1})$, $f(c_{1})$, $f(d_{1})$ 四个值.
    其中由于 $\displaystyle\frac{\sqrt{5} - 1}{2} \approx 0.618$, 故该优选法被称为0.618优选法.对于先增后减的函数 $f(x)$,
    讨论所有 $f(a_{1})$, $f(b_{1})$, $f(c_{1})$, $f(d_{1})$ 的大小关系的可能性.
    \item[2.]在上一题中列举的各种可能性中, 逐一分析 $x^*$ 是否可能落于区间 $[a_1, c_1)$, $[c_1, d_1]$, $(d_1, b_1]$ 中.
    \item[3.]现舍去不可能包含 $x^*$ 的那个子区间, 并将剩余区间分成三份, 记作 $[a_2, c_2)$, $[c_2, d_2]$, $(d_2, b_2)$, 
    方法与比例同对初始 $[0, 1]$ 区间的分割. 问: 需要额外代入多少个新的自变量求函数 $f$ 的值?
    \item[4.]证明: 在进行迭代时, 每一步相应的区间 $[a_n, b_n]$ (可以看作一个区间列) 有唯一的一个公共点, 且该公共点为函数 $f(x)$ 的一个极大值点. 
    此外, 若函数 $f(x)$ 的最大值点不唯一, 则区间列 $[a_n, b_n]$ 的公共点是否必然为 $x^*$?
    \item[5.]给定一个最大容许误差 $\epsilon$, 需要多少次迭代, 可以确保获得一个与 $x^*$ 误差不超过 $\epsilon$ 的估算值? 
    (此处假设函数 $f(x)$ 的最大值点唯一)
    \item[6.]$(\star)$ 设函数 $f(x) = x(1 - x)$, 且最大容许误差 $\epsilon = 0.01$, 试通过编写程序 (语言不限) 给出一个 $f(x)$ 最大值点的估算值.
\end{enumerate}

== 习题D ==

设 $\displaystyle f, g \in C[a, b]$, 定义:

\[\displaystyle\operatorname {dist}(f, g) \coloneqq \max_{x \in [a, b]} |f(x) - g(x)|.\]

\begin{enumerate}
    \item[1.]证明: $\displaystyle\operatorname {dist}(\cdot , \cdot)$ 是 $C[a, b]$ 上的距离函数, 因此 $\displaystyle(C[a, b], \operatorname {dist})$ 是度量空间.
    \item[2.]证明: $\displaystyle(C[a, b], \operatorname {dist})$ 是完备度量空间.
    \begin{solution}
        设 $\{f_{n}\}$ 是 $(C[a,b],\mathrm{dist})$ 中的 Cauchy 序列，即
        \[
        \forall \epsilon>0,\,\exists N>0,\,\forall m,\,n>N:\,\mathrm{dist}(f_{m},\,f_{n})=\max_{x\in[a,b]}\left|f_{m}(x)-f_{n}(x)\right|<\epsilon.
        \]
        对任意固定的 $x_{0}\in [a,b]$，考虑序列 $\{f_{n}(x_{0})\}$.\\
        注意到
        \[
        \left|f_{m}(x_{0})-f_{n}(x_{0})\right|\leq \max_{x\in[a,b]}\left|f_{m}(x)-f_{n}(x_{0})\right|=\mathrm{dist}(f_{m},\,f_{n}).
        \]
        所以当 $m,\,n>N$ 时，$\left|f_{m}(x)-f_{n}(x)\right|\leq \mathrm{dist}(f_{m},\,f_{n})<\epsilon$，即 $\{f_{n}(x_{0})\}$ 是 $\mathbb{R}$ 中的 Cauchy 序列.\\
        由于 $\mathbb{R}$ 具有完备性，且 $\{f_{n}(x_{0})\}$ 收敛.\\
        定义函数 $f:\,[a,b]\to \mathbb{R},\,f(x)=\underset{n\to+\infty}{\lim}f_{n}(x)$.\\
        \[
        \forall \epsilon>0,\,\exists N>0,\,\forall m,\,n>N:\,\max_{x\in[a,b]}\left|f_{m}(x)-f_{n}(x)\right|<\frac{\epsilon}{2}.
        \]
        固定 $n>N$ 与 $x\in[a,b]$，令 $m\to+\infty$，从而
        \[
        \left|f(x)-f_{n}(x)\right|=\lim_{m\to+\infty}\left|f_{m}(x)-f_{n}(x)\right|\leq \frac{\epsilon}{2}<\epsilon.
        \]
        由于这对任意 $x\in[a,b]$ 成立，所以
        \[
        \max_{x\in[a,b]}\left|f(x)-f_{n}(x)\right|\leq \frac{\epsilon}{2}<\epsilon.
        \]
        即 $\{f_{n}\}$ 一致收敛于 $f$，且 $\mathrm{dist}(f_{n},f)=0$.\\
        由于每个 $f_{n}$ 在 $[a,b]$ 上连续，且 $\{f_{n}\}$ 一致收敛于 $f$.\\
        由一致收敛性，$\exists N>0$ 使得当 $n>N$ 时：
        \[
        \max_{x\in[a,b]}\left|f(x)-f_{n}(x)\right|<\frac{\epsilon}{3}.
        \]
        由 $f_{N}$ 在 $x_{0}$ 处连续，存在 $\delta>0$ 使得当 $\left|x-x_{0}\right|<\delta$时：
        \[
        \left|f_{N}(x_{0})-f_{N}(x_{0})\right|<\frac{\epsilon}{3}.
        \]
        于是当 $\left|x-x_{0}\right|<\delta$ 时：
        \[
        \left|f(x)-f(x_{0})\right|\leq \left|f(x)-f_{N}(x)\right|+\left|f_{N}(x)-f_{N}(x_{0})\right|+\left|f_{N}(x_{0})-f(x_{0})\right|\leq \frac{\epsilon}{3}+\frac{\epsilon}{3}+\frac{\epsilon}{3}=\epsilon.
        \]
        所以 $f$ 在 $x_{0}$ 处连续. 又由 $x_{0}$ 的任意性可知 $f$ 在 $[a,b]$ 上连续，即 $f\in C[a,b]$.\\
        $(C[a,b],\mathrm{dist})$ 中的任意 Cauchy 序列 $\{f_{n}\}$ 都收敛于某个 $f\in C[a,b]$，因此 $(C[a,b],\mathrm{dist})$ 是完备度量空间.
    \end{solution}
    \item[3.]$(\star)$ 问: $\displaystyle(C[a, b], \operatorname {dist})$ 是不是列紧空间, 即 Bolzano- Weiestrass 定理对在 $\displaystyle(C[a, b], \operatorname {dist})$ 中的任意一列有界函数是否成立?
        \begin{solution}
            并不是列紧空间. 反例：在 $(C[0,1],\mathrm{dist})$ 中，$f_n(x)=x^n,x\in[0,1]$ 显然为一列有界函数，但是其点态收敛到函数 
            $f(x)=
            \begin{cases}
                0 &, x\in[0,1)\\
                1 &, x=1
            \end{cases}$, 而 $f(x)$ 并不在 $(C[0,1],\mathrm{dist})$ 中.
        \end{solution}
\end{enumerate}
    

== 习题E ==
$\cdot$ 设 $(X, d)$ 是完备度量空间, 我们称一个子集 $F \subset X$ 是\textbf{开集}, 直观上说, 集合是没有边界点的, 换言之, 的每个点都是内部的点, 简称内点. 
内点的严格定义: 称 $x \in F$ 是 $F$ 的\textbf{内点}, 若在 $F$ 中包含 $x$ 的一个邻域 (或 $\delta$ -邻域). 
因此, 开集的严格定义: 若其内每个点均是内点. 称 $G \subset X$ 是\textbf{闭集}, 若它的补集 $G^c = E \setminus G$ 是开集.

$\cdot$ 设 $(X, d), (Y, \tilde{d})$ 是完备度量空间, 映射 $f: X \to Y$.

\begin{enumerate}
    \item[1.]用 $\epsilon$ - $\delta$ 语言描述 "$f$ 是连续的".
    \item[2.] 证明: $f$ 是连续的, 当且仅当开集的原像是开集, 即若 $G$ 是 $Y$ 中的开集, 则原像

    \[\displaystyle f^{-1}(G) = \{x \in X\mid f(x) \in G\}\]

    是 $X$ 中的开集.
    \item[3.]称集合 $A$ 在 $X$ 中是\textbf{连通}的, 若不存在两个不相交的开集 $G_1, G_2$ 使得 $A \subset G_1 \cup G_2$. 
    证明: 若 $f$ 是连续的, 则 $f$ 将 $X$ 中的连通集映射到 $Y$ 中的连通集.
\end{enumerate}