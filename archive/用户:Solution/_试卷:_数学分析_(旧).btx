\begin{enumerate}
\item 填空题（每空格6分，共36分）：
\end{enumerate}
\begin{enumerate}[label=(\arabic*)]
\item $\displaystyle\int_{0}^{n\pi} x|\sin x|\,{\rm d} x=\underline{\quad n^2\pi \quad}$。
\item 若 $\displaystyle\int_{0}^{+\infty} \frac{\cos^{p}x-\cos^{q}x}{x}\,{\rm d} x$ 收敛，
则自然数 $p, q$ 满足的条件为：$\underline{\quad p,q\text{ 均为奇数, 或者 }p,q\text{ 为相同的偶数} \quad}$。
\item $\displaystyle\sum_{n=1}^{\infty} \frac{1}{n(2n-1)}$ 的和为$\underline{\quad 2\ln 2 \quad}$。
\item 判断 $\displaystyle\prod_{n=1}^{\infty} \sum_{k=1}^{n} \frac{(-1)^{k-1}}{k\ln 2}$ 是收敛的还是发散的：$\underline{\quad\text{收敛}\quad}$。
\item 函数 $\dfrac{1+2x+3x^{2}}{(1+x+x^{2}+x^{3})^{2}}$ 的 Maclaurin 级数中 $x^{2019}$ 项的系数为：$\underline{\quad -2020 \quad}$。
\item $\displaystyle\sum_{n=1}^{\infty}\left(x-\frac{1}{n}\right)^{n}(1-x)^{a}$ 关于 $x \in[0,1]$ 一致收敛，
则参数 $a \in \mathbb{R}$ 满足的条件为：$\underline{\quad a>1 \quad}$。
\end{enumerate}
\begin{enumerate}\setcounter{enum-{list-level}}{1}
\item (15 分) 计算积分 $\displaystyle\int_{0}^{+\infty} \frac{\arctan x}{(1+x)^{2}}\,{\rm d} x$。[答案：$\dfrac{\pi}{4}$.]

\item (15 分) 将平面曲线：$(x-b)^{2}+y^{2}=a^{2}$ $(0<a<b)$
绕 $y$ 轴旋转一周，求所得旋转曲面的面积。[答案：$4\pi^2 ab$.]

\item (14 分) 证明一致收敛的连续性定理：设 $u_{n}(x)$ 在 $x \in[a, b]$ 上连续 $(n=1,2,3, \ldots)$，
且函数项级数 $\displaystyle\sum_{n=1}^{\infty} u_{n}(x)$ 关于 $x \in[a, b]$ 一致收敛，
证明函数项级数的和函数 $S(x)$ 在 $[a, b]$ 上连续。

\item (10 分) 设 $S_{k} \subset \mathbb{R}^{n}$ 是非空有界闭集且 $S_{k+1} \subset S_{k}$ $(k=1,2,3, \ldots)$。
证明：$\bigcap\limits_{k=1}^{\infty} S_{k}$ 仍是非空有界闭集。
又问，如果把有界性条件去掉结论应如何变化？

\item (10 分) 设 $\displaystyle\zeta(x)=\sum_{n=1}^{\infty} \frac{1}{n^{x}}$。\\
(1) 证明：$\zeta(x)$ 在 $(1,+\infty)$ 上有任意阶导函数；\\
(2) 问：$\forall x_{0}>1$ 是否存在 $\delta>0$ 
使 $\displaystyle\zeta(x)=\sum_{n=0}^{\infty} \frac{\zeta^{(n)}(x_{0})}{n!}(x-x_{0})^{n}$ 
当 $|x-x_{0}|<\delta$ 时成立？说明理由。[答案：(2)可以取$\delta=\dfrac{x_0-1}{2}$.]
\end{enumerate}

