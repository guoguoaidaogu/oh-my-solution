\begin{enumerate}
\item[一、] (10分）记 $S_r^2 \subset \mathbb{R}^3$ 为以原点为心、半径为 $r>0$ 的球面. 
若 $\triangle$ 为其上的一个球面三角形，其三个内角分别为 $0<\alpha, \beta, \gamma<\pi$。
利用数分 3 的知识求 $\triangle$ 的面积 $S_{\triangle}$ (需有计算过程)。

\item[二、] (5+5+5分) 令 $f(x, y, z)=\cos y\,e^{\sin x-x^2-y^2}$. 求外微分 $df$ 及
$$\lim_{T_0 \rightarrow+\infty} \int_{\Gamma_{T_0}} df+\frac{\sin 4z}{z}\,dz,$$
其中曲线 $\Gamma_{T_0}$ 为
$$x(t)=t\,e^{t^{2018}}, \quad y(t)=t^2 \sin \left(1+t^{2019}\right), \quad 
z(t)=\phi(t), \ \ t \text { 从 } 0 \text { 至 } T_0$$
且 $\phi$ 为直线上的光滑函数满足 $\phi(0)=0$、$\ \phi^{\prime} \geq 1$.

\item[三、] (7分) 假设 $\alpha>0$, $f \in C(\mathbb{R}^3)$. 求第二类曲面积分
$$\iint_{\Sigma}[f(x, y, z)+x]\ dy \wedge dz
+\left[\frac{2}{\alpha} f(x, y, z)+y\right] dz \wedge dx
+[f(x, y, z)+z]\ dx \wedge dy$$
其中 $\Sigma$ 为平面 $x-\alpha y+z=1$ 在第四象限部分 (即 $x, z \geq 0, y \leq 0$), 方向取上侧.

\item[四、] (5+8分) 计算积分：
$$\int_0^{\frac{\pi}{2}} \ln \left(\frac{a+b \sin \theta}{a-b \sin \theta}\right) \frac{d \theta}{\sin \theta} \quad(0 \leq b<a)$$
及
$$\int_{\frac{\pi}{2}-\alpha}^{\frac{\pi}{2}} \sin \theta \arccos \left(\frac{\cos \alpha}{\sin \theta}\right) d\theta \quad\left(0 \leq \alpha \leq \frac{\pi}{2}\right).$$

\item[五、] (5+5+3+5+5+2分) 假设 $\alpha>0$。考虑以 $2 \pi$ 为周期的函数 $f(x)=\cosh (\alpha x)$.

(1) 写出 $f$ 在 $[-\pi, \pi]$ 上的 Fourier 级数及其和函数.

(2) 利用所得结果，(a) 求
$$\sum_{n=1}^{+\infty} \frac{1}{\alpha^2+n^2}, \qquad 
\sum_{n=1}^{+\infty} \frac{1}{(\alpha^2+n^2)^2},$$
(b) 直接写出 $g(x)=\sinh (\alpha x)$ 在 $[-\pi, \pi]$ 上的 Fourier 级数并计算
$$\sum_{n=1}^{+\infty} \frac{(-1)^n}{n^2+1}.$$

\item[六、] (5+5分) 假设 $u \in C^2(\mathbb{R}^3)$ 为调和函数, 
即满足 $\Delta u=\frac{\partial^2 u}{\partial x^2}+\frac{\partial^2 u}{\partial y^2}+\frac{\partial^2 u}{\partial z^2}=0$. 
设 $P=(x_0, y_0, z_0) \in \mathbb{R}^3, r>0$. 记 $S(P, r)$ 为以 $P$ 点为心, $r$ 为半径的球面. 证明: (1)
$$\iint_{S(P, r)} \frac{\partial u}{\partial n}\,d S=0,$$
其中 $n$ 为 $S(P, r)$ 的单位外法向量.

(2) 平均值公式
$$u(P)=\frac{1}{4 \pi r^2} \iint_{S(P, r)} u\,d S.$$

\item[七、] (10+10分) 假设 $\lambda \geq 0, a>0$。(1) 求
$$R(\lambda)=\int_0^{\infty} \cdots \int_0^{\infty} 
e^{-\left(x_1+\cdots+x_{n-1}+\frac{\lambda^n}{x_1 \cdots x_{n-1}}\right)} 
x_1^{\frac{1}{n}-1} \cdots x_{n-1}^{\frac{n-1}{n}-1} dx_1 \cdots dx_{n-1}$$
(2) 试利用(1)的结果证明 $\Gamma$ 函数的高斯公式
$$\Gamma(a) \Gamma(a+\frac{1}{n}) \cdots \Gamma(a+\frac{n-1}{n})
=\frac{(2\pi)^{\frac{n-1}{2}}}{n^{na-\frac{1}{2}}} \Gamma(na).$$
\end{enumerate}

== 18秋数学分析III 期末 (李洪全) ==
\begin{enumerate}
\item[一、] 设 $D \subset \mathbb{R}^{2}$ 为有界闭区域, $u(x, y)$ 在 $D$ 上连续可导, 且
\begin{align*}
u(x, y)=\frac{\partial u}{\partial x}(x, y)&+\frac{\partial u}{\partial y}(x, y), \quad \forall\, (x, y) \in D, \\
&u|_{\partial D}=0.
\end{align*}
证明 $u$ 在 $D$ 上恒为 $0$.

\item[二、] 假设 $f: D=[0,1]^{n} \longrightarrow[-1,1](n \geq 2)$ 可积. 证明:
$$\lim_{k \rightarrow+\infty} \prod_{j=1}^{n} \prod_{\alpha_{j}=1}^{k}\left[1+\frac{1}{k^{n}} f\left(\frac{\alpha_{1}}{k}, \ldots, \frac{\alpha_{n}}{k}\right)\right]
=\exp \left\{\int_{D} f(x) d x\right\}.$$

\item[三、] 假设 $f \in C^{1}(\mathbb{R}^{2})$, 
且曲面 $z=f(x, y)$ 上的切平面均过一定点 $(a, b, c)$. 证明：
$$f(t(x-a)+a, t(y-b)+b)-c=t \cdot(f(x, y)-c).$$

\item[四、] 令 $\mathcal{M}_{n, n}$ 为所有 $n$ 阶实方阵全体，考虑光滑函数
\begin{align*}
\phi: \mathcal{M}_{n, n} &\longrightarrow \mathbb{R} \\
A=\left(a_{i, j}\right)_{1 \leq i, j \leq n} &\longmapsto \phi(A)=\det A
\end{align*}

1. 计算 $\frac{\partial}{\partial a_{i, j}} \phi(A)$ (可以用代数余子式表示).

2. 给定 $H_{1}, \ldots, H_{n}>0$，假设 $A_{0}$ 为 $\phi^{2}(A)$ 在约束条件
$$\sum_{j=1}^{n} a_{i, j}^{2}=H_{i}, \quad i=1, \ldots, n \tag{1}$$
下的极大值点. 证明 $A_{0}$ 的行向量在 $\mathbb{R}^{n}$ 中两两正交.

3. 记满足条件 $(1)$ 的方阵全体为 $\Sigma$。利用 $(\det A)^{2}=(\det A)\left(\det A^{T}\right)$，证明：
$$\max_{A \in \Sigma} \phi^{2}(A)=\prod_{i=1}^{n} H_{i}.$$

\item[五、] 若 $f: \mathbb{R}^{n} \longrightarrow \mathbb{R}$ $(n \geq 2)$ 为满足常数 $L>0$ 的 Lipschitz函数, 即
$$|f(x)-f(y)| \leq L|x-y|, \quad \forall\, x, y \in \mathbb{R}^{n}.$$
进一步假设在原点 $o$, $f$ 沿任意方向 $v \in \mathbb{S}^{n-1}$ 的方向导数 $\frac{\partial f}{\partial v}(o)$ 存在. 
将 $v$ 看成列向量，定义
$$Q(v ; t)=\frac{f(tv)-f(o)}{t}-f^{\prime}(o) v, \quad v \in \mathbb{S}^{n-1}, t \in \mathbb{R} \backslash\{0\}.$$

证明: 1. $\forall\, v, v^{\prime} \in \mathbb{S}^{n-1}$ 有 
$\left|Q(v ; t)-Q(v^{\prime} ; t)\right| 
\leq(\sqrt{n}+1) L\left|v-v^{\prime}\right|$.

2. 对于任意的 $\epsilon>0$ ，存在 $\delta_{\epsilon}>0$ 使得
$$|Q(v ; t)|<\epsilon, \quad \forall\, 0<|t|<\delta_{\epsilon}, v \in \mathbb{S}^{n-1}.$$

3. $f$ 在 $o$ 点可微。

\item[六、] 1. 求函数
$$H(x, y)=\frac{x(1-x) y(1-y)}{1-x y}$$
在区域 $0 \leq x \leq 1,0 \leq y \leq 1$ 上的最大值.

2. 记
$$L_{n}=\left(\int_{0}^{1} \int_{0}^{1} \frac{x^{n} y^{n}(1-x)^{n}(1-y)^{n}}{(1-xy)^{n+1}} dx dy\right)^{\frac{1}{n}},$$
求 $\lim_{n \rightarrow \infty} L_n$.

\item[七、] 设 $f \in C(\mathbb{R}), b \in \mathbb{R}, n \geq 2, v \in \mathbb{R}^{n} \backslash\{o\}$。
令 $C_{n-1}$ 表示 $\mathbb{R}^{n-1}$ 中单位球的体积。证明：
$$\int_{B(o, 1)} f(v \cdot x+b) d x=C_{n-1} \int_{-1}^{1} f(|v| s+b)\left(1-s^{2}\right)^{\frac{n-1}{2}} ds.$$

\item[八、] 假设 $n \geq 2, \alpha \in \mathbb{R}$. 给出重积分
$$\int_{B(o, 1)}\left(x_{1}-x_{n}\right)\left[\sin \left(\sum_{j=1}^{n} \frac{j}{100 n^{2}}\left|x_{j}\right|\right)\right]^{\alpha} dx$$
收敛的充要条件，并求其值。

\item[九、] 设 $a>0$. 试将积分
$$K=\int_{-\frac{\pi}{4}}^{\frac{\pi}{2}} d \theta 
\int_{0}^{2 a \cos \theta} f(r \cos \theta, r \sin \theta) r dr$$
交换积分顺序，再将它化为直角坐标，写出先对 $x$ 再对 $y$ 以及先对 $y$ 再对 $x$ 的两个累次积分。
\end{enumerate}

== 18秋数学分析III 期中（李洪全）==
\begin{enumerate}
\item[一、] (8分) 假设 $A$ 为 $n \times n$ 实可逆矩阵，记
$$\begin{aligned}
T_A:\ \ \mathbb{R}^n \longrightarrow \mathbb{R}^n \qquad\qquad\\
\ \ \qquad\qquad x \mapsto T_A(x)=A x .
\end{aligned}$$
若 $\phi: \mathbb{R}^n \rightarrow \mathbb{R}$ 为 $C^2$ 函数. 求
$$\nabla(\phi \circ T_A)(x)=\left(\frac{\partial(\phi \circ T_A)}{\partial x_1}, \cdots, \frac{\partial(\phi \circ T_A)}{\partial x_n}\right)(x)$$
以及
$$\operatorname{Hess}(\phi \circ T_A)(x)
=\left(\frac{\partial^2(\phi \circ T_A)}{\partial x_i \partial x_j}(x)\right)_{1 \leq i, j \leq n}.$$

\item[二、] (8+7分) 假设 $f \in C^2(\mathbb{R}^2)$ 满足
$$f(0,0)=|\nabla f(0,0)|=0.$$
(a) 若 $\frac{\partial^2 f}{\partial x \partial y}(0,0)=0, 
\frac{\partial^2 f}{\partial x^2}(0,0)>0$ 
且 $\frac{\partial^2 f}{\partial y^2}(0,0)<0$. 
证明在 $0$ 点附近, 存在两个不同的隐函数 $g_i(x), i=1,2$, 使得
$$g_i(0)=0, \quad f(x, g_i(x))=0, \quad g_i \in C^1 \text { 且 } g_1^{\prime}(0) \neq g_2^{\prime}(0).$$

(b) 更一般地, 若 $\frac{\partial^2 f}{\partial y^2}(0,0) \neq 0$ 且
$$\left(\frac{\partial^2 f}{\partial x \partial y}(0,0)\right)^2
-\frac{\partial^2 f}{\partial x^2}(0,0) \frac{\partial^2 f}{\partial y^2}(0,0)>0,$$
证明 (a) 中的结论依然成立.

\item[三、] (3+5+8分) 令 $n \geq 2$, $I_n=[0,1]^n$. 
假设 $u \in C^1(\mathbb{R}^n)$ 满足 $u(x)=0, \forall x \notin I_n$. 
记 $x=(x^{\prime}, x_n), x^{\prime}=(x_1, \cdots, x_{n-1})$.

(a) 证明 $u(x)=u(x^{\prime}, x_n)=\int_0^{x_n} \frac{\partial u}{\partial x_n}(x^{\prime}, t) dt$.

(b) 证明 $\int_{I_n}|u(x)|^2 dx \leq \int_{I_n}|\nabla u(x)|^2 dx$.

(c) 假设已知
$$\left(\int_{I_n}|u(x)|^{\frac{n}{n-1}} dx\right)^{\frac{n-1}{n}} 
\leq C_n \int_{I_n}|\nabla u(x)| dx,$$
其中 $C_n>0$ 与 $u$ 无关. 试利用上面不等式证明
$$\left(\int_{I_n}|u(x)|^{\frac{np}{n-p}} dx\right)^{\frac{n-p}{n}} 
\leq C(n, p) \int_{I_n}|\nabla u(x)|^p dx,$$
其中常数 $p>1$ 而 $C(n, p)>0$ 与 $u$ 无关.

\item[四、] (3+4+8分) 记 $n \times n$ 的所有对称正定矩阵集合为 $\Gamma$. 设定义在 $\Gamma$ 上的函数
$$f(A)=\operatorname{det}^{\frac{1}{n}}\!A, \quad \forall\, A \in \Gamma.$$
\begin{enumerate}[label=(\alph*)]
\item 求 $f$ 在 $A$ 的微分 $df_{(A)}$. (即求 $\frac{\partial f}{\partial A_{ij}}=df_{(A)}(E_{ij})$)
\item 求 $\frac{\partial^2 f}{\partial A_{ij} \partial A_{kl}}(A)$. (即 $f$ 在 $A$ 处的 Hessian 矩阵)
\item 证明
$$\frac{\partial^2 f}{\partial A_{ij} \partial A_{kl}}(A) \xi_{ij} \xi_{kl}<0, \quad 
\forall\, \xi=\left(\xi_{ij}\right)_{1 \leq i, j \leq n} \neq 0,$$
即 $f$ 为凹函数.
\end{enumerate}

\item[五、] (15分) 设 $\Omega \subset \mathbb{R}^n$ 是有界区域， 
$u$ 在 $\Omega$ 上二阶连续可微， $u$ 是非负函数，且满足
$$L(u)=\sum_{i, j=1}^n a_{ij}(x) \frac{\partial^2 u}{\partial x_i \partial x_j}+\sum_{k=1}^n b_k(x) \frac{\partial u}{\partial x_k}+c(x) u \geq 0,$$
其中 $a_{ij}, b_k, c$ 在 $\Omega$ 上一阶连续可微, $c(x) \leq 0$; 
$a_{ij}=a_{ji}$, 且 $\exists \alpha> 0$ 使对 $\forall x \in \overline{\Omega}$ 
和 $\xi=(\xi_1, \cdots, \xi_n) \in \mathbb{R}^n$ 成立
$$\sum_{i, j=1}^n a_{ij}(x) \xi_i \xi_j \geq \alpha \sum_{i=1}^n \xi_i^2.$$
证明
$$\max_{x \in \overline{\Omega}} u(x)=\max_{x \in \partial \Omega} u(x).$$

\item[六、] (15分) 设函数 $f$ 定义在 $\Omega=\left\{(x, y, z) \mid x^2+y^2 \leq z^2, 0 \leq z \leq 1\right\}$ 上且有界可积, 并在 $(0,0,0)$ 处连续。令
$$I_n=\int_{\Omega} e^{-nz} f(x, y, z) dx dy dz,$$
其中 $n$ 为正整数。试求：当 $n \rightarrow \infty$, $n^3 I_n$ 的极限。

\item[七、] (3+5+8分) 下面我们考虑积分
$$I_{p, q, r, s}=\int_D x^p y^q z^r(1-x-y-z)^s dx dy dz,$$
其中 $p, q, r, s$ 均为正整数, $D=\{(x, y, z) \mid x, y, z \geq 0, x+y+z \leq 1\}$。

若我们记 $D(t)=\{(x, y, z) \mid x, y, z \geq 0, x+y+z \leq t\}$, 以及
$$I_{p, q, r, s}(t)=\int_{D(t)} x^p y^q z^r(t-x-y-z)^s dx dy dz.$$

(1) 试说明 $\int_0^1 I_{p, q, r, s}(t) dt=\frac{I_{p, q, r, s}}{p+q+r+s+4}$。

(2) 试说明 $I_{p, q, r, s+1}=\frac{s+1}{p+q+r+s+4} I_{p, q, r, s}$。

(3) 从而计算得 $I_{p, q, r, s}=\frac{p!q!r!s!}{(p+q+r+s+3)!}$。
（已知 $\int_0^1 x^p(1-x)^{q+1} dx=$ $\frac{p!(q+1)!}{(p+q+2)!}$.）
\end{enumerate}

== 17秋数学分析I期末（楼红卫）==
一\ （30 分）填空题（每题5分）：
\begin{enumerate}[label=(\arabic*)]
\item 设 $f(x)=3 x^{4}-16 x^{3}-42 x^{2}+120 x$，则 $f(x)$ 在区间 $[-3,3]$ 上的最大值为 $\underline{\quad 65 \quad}$。
\item $\displaystyle\int\left(e^{x}\Big(\ln x+\frac{1}{x}\Big)+\ln x+1\right) dx=\underline{\quad \left(e^{x}+x\right) \ln x+C \quad}$。
\item 设函数 $f(x)$ 在 $x=1$ 有三阶导数，并满足 $f^{\prime}(x)=f(f(x))$ 以及 $f(1)=1$。
则 $f(x)$ 在 $x=1$ 处的带 Peano 型余项的三阶 Taylor 展式为：
$\underline{\quad 1+(x-1)+\frac{(x-1)^{2}}{2}+\frac{(x-1)^{3}}{3}+o((x-1)^{3}), \quad(x \rightarrow 1) \quad}$。
\item 对于 $n \geq 1$，设 $\xi_{n} \in\left(0, \dfrac{1}{n}\right)$ 
满足 $\sin \dfrac{1}{n}=\dfrac{1}{n} \cos \xi_{n}$，
则 $\lim\limits_{n \rightarrow \infty} n \xi_{n}=\underline{\quad\dfrac{\sqrt{3}}{3}\quad}$。
\item 设曲线 $y=x^{2}$ 在点 $A(x_{0}, x_{0}^{2})$ 处的切线与 $x$ 轴交于 $P$ 点。
若线段 $AP$ 的长度为 $1$，则 $x_{0}= \underline{\quad \pm \sqrt{\dfrac{\sqrt{65}-1}{8}} \quad}$。
\item 设 $f(x)=x^{1999} e^{x} \sin x$，
则 $f^{(2018)}(0)=\underline{\quad\dfrac{2018!}{19!} \cdot 2^{9}\quad}$。
\end{enumerate}
\begin{enumerate}
\item[二]（10 分）设 $f(x)$ 在 $[-1,1]$ 上连续，在 $(-1,0)$ 和 $(0,1)$ 内可导。
若 $\lim\limits_{x \rightarrow 0} f^{\prime}(x)$ 存在，证明：$f(x)$在 $x=0$ 处可导。

\item[三]（20 分）设 $y=y(x)$ 由参数方程 $\begin{cases}x=e^{t}+2 t, \\ y=\sin t-t,\end{cases}$ 确定。\\
（1）计算 $\dfrac{d^{2}y}{dx^{2}}$。\qquad\qquad
（2）计算 $\displaystyle\int y(x) \, dx$。\\
（3）任取 $x_{0} \in \mathbb{R}$，定义 $x_{n+1}=y(x_{n})$ $(n \geq 0)$。
证明：$\left\{x_{n}\right\}$ 收敛。

\item[四]（10 分）试构造 $\mathbb{R}$ 上二阶连续可导的凸函数 $f(x)$，满足
$$|f(x)| \leq |x|+1, \qquad \forall\, x \in \mathbb{R}.$$

\item[五]（10 分）设 $y=\sqrt[3]{\dfrac{x^{4}}{x+1}}$，
试讨论函数的单调性、极值、凸性、拐点，求出它的渐近线，并作出它的简图。

\item[六]（10 分）将区间 $(0,1)$ 内的实数用十进制小数 $0.a_{1}a_{2}a_{3} \ldots a_{n} \ldots$ 表示，约定不将 $9$ 作为循环节。定义
$$f(0.a_{1}a_{2}a_{3}\ldots a_{n}\ldots)
:=0.a_{1}0a_{2}0a_{3}0\ldots a_{n}0\ldots,$$
试问 $f(x)$ 在 $(0,1)$ 内的哪些点连续，哪些点不连续。

\item[七]（10 分）设 $f(x)$ 在 $[0,+\infty)$ 上有两阶的连续导数，
满足 $f(0)=f^{\prime}(0)=0$ 以及 $f^{\prime \prime}(x)+3 f^{\prime}(x)+2 f(x) \geq 0$。证明：$f(x) \geq 0$。
\end{enumerate}

== 17秋数学分析I期中==
\begin{enumerate}
\item 记函数\[R(x)=\begin{cases}
\frac{1}{q},&x\in\mathbb{Q}\setminus\{0\}, \, x=\pm\frac{p}{q}, \, p,q\text{ 为既约正整数}\\
0,&x=0\text{ 或 }x\in\R\setminus\mathbb{Q}
\end{cases}.\]求证$\lim\limits_{x\to0}R(x)=0$。
\item 设$f$为$[0,+\infty)$上的连续函数。\\
(1) $\lim\limits_{x\to+\infty}f(x)=0$，求证$f(x)$一致连续。\\
(2) $\lim\limits_{x\to+\infty}\dfrac{f(x)}{x}=+\infty$，求证$f(x)$非一致连续。\\
(3) $\lim\limits_{x\to+\infty}\dfrac{f(x)}{x}=1$，举例说明$f(x)$可能一致连续也可能非一致连续。
\item 设$x_0\in(0,1)$，$x_{n+1}=x_n(1-x_n^4)$，求$\lim\limits_{n\to\infty}n^\frac{1}{4}x_n$。
\item 求$\displaystyle\lim_{x\to0}\left(\frac{\sin x+\cos x}{1+2\tan x}\right)^\frac{1}{x}$。
\item 设$f,g$为$\R$上的连续函数，求证$h=\max\{f,g\}$为$\R$上的连续函数。
\item 设$a_1,a_2,\cdots,a_n>0$，求$\displaystyle\lim_{x\to+\infty}\frac{a_1^{x+1}+a_2^{x+1}+\cdots+a_n^{x+1}}{a_1^x+a_2^x+\cdots+a_n^x}$。
\item 设$f(x)$为$[a,b]$上的连续函数，
\[F(x)\triangleq\lim_{y \to x^+}\frac{f(y)-f(x)}{y-x},\quad\forall\, x\in(a,b).\]
证明：(1) 若恒有$F(x)$为正或$+\infty$，则$f$严格增。\\
\qquad\ \, (2) 若恒有$F(x)=0$，则$f$为常数。
\end{enumerate}

== 17春数学分析II期末（楼红卫）==
一\ （36 分）填空题（每题6分）：
\begin{enumerate}[label=(\arabic*)]
\item $\displaystyle\int_{0}^{2017}(-1)^{[x]}x\,dx=\underline{\quad\frac{2017}{2}\quad}$。
\item 若 $\displaystyle\int_{0}^{+\infty}(\ln x) \sin (x^{p})\,dx$ 收敛，
则参数 $p \in \mathbb{R}$ 满足的条件为：$\underline{\quad |p|>1 \quad}$。
\item $\displaystyle\sum_{n=0}^{\infty} \frac{(-1)^{n}}{2n+1}$ 的和为：
$\underline{\quad\dfrac{\pi}{4}\quad}$。
\item 判断 $\displaystyle\prod_{n=1}^{\infty} \frac{\sin \frac{1}{\sqrt{2 n-1}}}{\sin \frac{1}{\sqrt{2n}}}$ 是收敛的还是发散的：$\underline{\quad 发散的 \quad}$。
\item $\dfrac{x}{1-x^{2}}$ 在 $x=3$ 处展开成 Taylor 级数时的收敛半径为： $\underline{\quad 2 \quad}$。
\item 若 $\displaystyle\sum_{n=0}^{\infty} \frac{1}{n^{a}}\left[e^{x}-\left(1+\frac{x}{n}\right)^{n}\right]$ 在 $x \in(-\infty,+\infty)$ 上内闭一致收敛，
则参数 $a \in \mathbb{R}$ 满足的条件是 $\underline{\quad a>0\quad}$。
\end{enumerate}
\begin{enumerate}
\item[二]（15 分）计算积分：$\displaystyle\int_{0}^{\frac{\pi}{2}} \frac{1+\cos x}{1+\sin x}\,dx$。[答案：$1+\ln2$.]

\item[三]（15 分）求参数曲线段：$\begin{cases}x=t-\sin t, \\ y=1-\cos t,\end{cases} \quad(0 \leq t \leq 2 \pi)$ 
绕 $x$ 轴旋转一周，所得旋转曲面的面积。[答案：$\dfrac{64\pi}{3}$.]

\item[四]（10 分）证明函数列 $S_{n}(x)$ 在 $x \in D$ 一致收敛到 $S(x)$ 的充要条件是：
$\forall\, x_{n} \in D$，必有 $\lim\limits_{n \rightarrow \infty}(S_{n}(x_{n})-S(x_{n}))=0$。

\item[五]（14 分）设 $x=-a_{n}$ 是方程： $1+x+\dfrac{x^{2}}{2!}+\dfrac{x^{3}}{3!}+\cdots+\dfrac{x^{2n-1}}{(2n-1)!}=0$ 的解，
$\displaystyle f(x)=\sum_{n=1}^{\infty} a_{n} x^{p} e^{-a_{n} x}$，其中 $p \in \mathbb{R}$ 为常数。证明

（1）存在正常数 $C_{1}, C_{2}$ 使得 $C_{1} n \leq a_{n} \leq C_{2} n$ $(n=1,2, \ldots)$；

（2）$f(x)$ 在 $(0,+\infty)$ 上连续。
\begin{proofc}
对于 $n \geq 0$，记 $\displaystyle f_{n}(x)=\sum_{k=0}^{n} \frac{x^{k}}{k!}, x \in \mathbb{R}$。

首先，归纳易证 $f_{2n}(x)$ 在 $\mathbb{R}$ 上有正的最小值，
而 $f_{2n+1}(x)$ 在 $\mathbb{R}$ 上严格单增，有唯一的零点。
具体地，对于 $f_{0}(x)$ 与 $f_{1}(x)$，上述结论成立。
现归纳假设对于某个 $n \geq 0$, $f_{2n}(x)$ 在 $\mathbb{R}$ 上有正的最小值，
而 $f_{2n+1}(x)$ 在 $\mathbb{R}$ 上严格单增，且有唯一的零点 $t_{2n+1}$。
则注意到 $f_{2n+2}^{\prime}(x)=f_{2n+1}(x)$，我们知道
$$f_{2n+2}(x) \geq f_{2n+2}(t_{2n+1})
=f_{2n+1}(t_{2n+1})+\frac{t_{2n+1}^{2n+2}}{(2n+2)!}
=\frac{t_{2n+1}^{2n+2}}{(2n+2)!}>0, \qquad \forall\, x \in \mathbb{R}.$$
即 $f_{2n+2}(x)$ 在 $\mathbb{R}$ 上有正的最小值。
进一步，由 $f_{2n+3}^{\prime}(x)=f_{2n+2}(x)$，
得到而 $f_{2n+3}(x)$ 在 $\mathbb{R}$ 上严格单增，
结合 $f_{2n+3}(-\infty)=-\infty, f_{2n+3}(+\infty)=+\infty$ 
知 $f_{2n+3}(x)$ 在 $\mathbb{R}$ 上有唯一的零点。
当 $n \geq 1, x \geq 0$ 时，$f_{2n-1}(x)>0$，
可知满足 $f_{2n-1}(-a_{n})=0$的 $a_{n}$ 唯一且为正。

（1）法 I. 由 Taylor 展式，我们有 $\xi_{n} \in (0, a_{n})$ 使得
$$e^{-a_{n}}=f_{2n-1}(-a_{n})+\frac{e^{-\xi_{n}}}{(2n)!} a_{n}^{2n}
=\frac{e^{-\xi_{n}}}{(2n)!} a_{n}^{2n}.$$
于是
$$a_{n}=\left(\frac{(2n)!e^{\xi_{n}}}{e^{a_{n}}}\right)^{\frac{1}{2n}} 
\leq\big((2n)!\big)^{\frac{1}{2n}} \leq 2n.$$
即可取 $C_{2}=2$。进一步，又有
$$a_{n}=\left(\frac{(2n)!e^{\xi_{n}}}{e^{a_{n}}}\right)^{\frac{1}{2n}} 
\geq\left(\frac{(2n)!}{e^{2n}}\right)^{\frac{1}{2n}} 
\sim \frac{2n}{e^{2}}, \qquad(n \rightarrow \infty).$$
所以存在 $C_{1}>0$ 使得 $\forall\, n \geq 1, a_{n} \geq C_{1} n$。

法 II. 我们有 $a_{1}=1$。对于 $n \geq 2$，当 $x \leq-(2n-1)$ 时，
$$f_{2n-1}(x)=\sum_{k=0}^{n-1} \frac{x^{2k}}{(2k)!}\left(1+\frac{x}{2k+1}\right)<0.$$
因此，$a_{n}<2n-1$ $(n \geq 2)$。

另一方面，在 $(-(2n+1),+\infty)$ 内，$f_{2n+1}(x)>f_{2n-1}(x)$。因此，
$$f_{2n-1}(-a_{n+1})<f_{2n+1}(-a_{n+1})=0.$$
这表明 $a_{n}<a_{n+1}$ $(n \geq 1)$。

总之，有 $a_{n}<a_{n+1}<2n+1$。

注意到 $f_{2n}^{\prime}(x)=f_{2n-1}(x)$ 在 $(-\infty,-a_{n})$ 内为负，
从而在 $[-a_{n+1},-a_{n})$ 为负，所以
$$\begin{gathered}
f_{2n}(x) \geq f_{2n}(-a_{n})=\frac{a_{n}^{2n}}{(2n)!}, \qquad x \in [-a_{n+1},-a_{n}], \\
f_{2n}(x) \leq f_{2n}(-a_{n+1})=\frac{a_{n+1}^{2n+1}}{(2n+1)!}, \qquad x \in [-a_{n+1},-a_{n}].
\end{gathered}$$
由中值定理，我们有 $\xi_{n} \in (-a_{n+1},-a_{n})$ 使得
$$0=f_{2n+1}(-a_{n+1})=f_{2n+1}(-a_{n})-f_{2n}(\xi_{n})(a_{n+1}-a_{n}).$$
所以
\begin{align*}
0 & =\frac{a_{n}^{2n}}{(2n)!}-\frac{a_{n}^{2n+1}}{(2n+1)!}-f_{2n}(\xi_{n})(a_{n+1}-a_{n}) \\
& \leq \frac{a_{n}^{2n}}{(2n)!}-\frac{a_{n}^{2n+1}}{(2n+1)!}-\frac{a_{n}^{2n}}{(2n)!}(a_{n+1}-a_{n}).
\end{align*}
由此得到
$$a_{n+1}-a_{n} \leq 1-\frac{a_{n}}{2n+1} \leq 1.$$
从而
$$a_{n} \leq n, \qquad \forall\, n \geq 1.$$
另一方面，
\begin{align*}
0 & =\frac{a_{n}^{2n}}{(2n)!}-\frac{a_{n}^{2n+1}}{(2n+1)!}-f_{2n}(\xi_{n})(a_{n+1}-a_{n}) \\
& \geq \frac{a_{n}^{2n}}{(2n)!}-\frac{a_{n}^{2n+1}}{(2n+1)!}-\frac{a_{n+1}^{2n+1}}{(2n+1)!}(a_{n+1}-a_{n}).
\end{align*}
于是
\begin{align*}
& a_{n+1}-a_{n} \geq \frac{2n+1}{a_{n+1}}\left(\frac{a_{n}}{a_{n+1}}\right)^{2n}\left(1-\frac{a_{n}}{2n+1}\right) \\
& \geq 1 \cdot\left(\frac{a_{n}}{a_{n}+1}\right)^{2n} \cdot\left(1-\frac{n}{2n+1}\right) 
\geq \frac{1}{2\left(1+\frac{1}{n}\right)^{2n}} \geq \frac{1}{2e^{2}}.
\end{align*}
因此，
$$a_{n} \geq \frac{n}{2e^{2}}, \qquad \forall\, n \geq 1.$$
即取 $C_{1}=\dfrac{1}{2e^{2}}, C_{2}=1$ 时成立 $C_{1} n \leq a_{n} \leq C_{2} n$ $(n=1,2, \ldots)$。

（2）对于 $X>1$，
$$0<a_{n} x^{p} e^{-a_{n} x} \leq n X^{|p|} e^{-\frac{n}{2Xe^{2}}}, 
\qquad \forall\, x \in\Big[\frac{1}{X}, X\Big],$$
由此可得 $\displaystyle\sum_{n=1}^{\infty} a_{n} x^{p} e^{-a_{n} x}$ 在 $\left[\frac{1}{X}, X\right]$ 上一致收敛。
即 $\displaystyle\sum_{n=1}^{\infty} a_{n} x^{p} e^{-a_{n} x}$ 在 $(0,+\infty)$ 内闭一致收敛。
由于级数的一般项连续，因此 $f(x)$ 在 $(0,+\infty)$ 内连续。
\end{proofc}

\item[六]（10 分）题目条件同上一题，试关于 $p$ 讨论：

（3）广义积分 $\displaystyle\int_{0}^{+\infty} f(x)\,dx$ 的收敛性；

（4）在上述广义积分收敛时，它是否可以逐项积分？

\begin{proofc}[解答]
（3）我们有
\begin{align*}
f(x)& =\sum_{n=1}^{\infty} a_{n} x^{p} e^{-a_{n} x} 
\leq \sum_{n=1}^{\infty} n x^{p} e^{-\frac{nx}{2e^{2}}} \\
&= x^{p} \sum_{n=1}^{\infty} n\big(e^{-\frac{x}{2e^{2}}}\big)^{n}
= x^{p} \frac{e^{-\frac{x}{2e^{2}}}}{\big(1-e^{-\frac{x}{2e^{2}}}\big)^{2}},
\end{align*}
以及
\begin{align*}
f(x)& =\sum_{n=1}^{\infty} a_{n} x^{p} e^{-a_{n} x} \geq \frac{1}{2e^{2}} \sum_{n=1}^{\infty} n x^{p} e^{-nx} \\
& = x^{p} \frac{e^{-x}}{\left(1-e^{-x}\right)^{2}},
\end{align*}
由此不难看到 $\displaystyle\int_{0}^{+\infty} f(x)\,dx$ 当且仅当 $p>1$ 时收敛。

（4）事实上，在局部可积性成立且被积函数非负的情形下，积分与求和总可以交换次序。
（这是实分析中的标准结论，称为单调收敛定理。）

本题，我们在已知知识范围内证明如下．
\begin{align*}
& \sum_{n=1}^{\infty} \int_{0}^{+\infty} a_{n} x^{p} e^{-a_{n} x} dx
=\lim_{m \rightarrow+\infty} \sum_{n=1}^{m} \int_{0}^{+\infty} a_{n} x^{p} e^{-a_{n} x} dx \\
= & \lim_{m \rightarrow+\infty} \int_{0}^{+\infty} \sum_{n=1}^{m} a_{n} x^{p} e^{-a_{n} x} dx 
\leq \lim_{m \rightarrow+\infty} \int_{0}^{+\infty} \sum_{n=1}^{+\infty} a_{n} x^{p} e^{-a_{n} x} dx \\
= & \int_{0}^{+\infty} \sum_{n=1}^{+\infty} a_{n} x^{p} e^{-a_{n} x} dx.
\end{align*}
另一方面，由 $\displaystyle\sum_{n=1}^{+\infty} a_{n} x^{p} e^{-a_{n} x}$ 在 $(0,+\infty)$ 的内闭一致收敛性，得到
\begin{align*}
& \int_{0}^{+\infty} \sum_{n=1}^{+\infty} a_{n} x^{p} e^{-a_{n} x} dx
=\lim_{\substack{\delta \rightarrow 0^+\\A \rightarrow+\infty}} \int_{\delta}^{A} \sum_{n=1}^{+\infty} a_{n} x^{p} e^{-a_{n} x} dx \\
& = \lim _{\substack{\delta \rightarrow 0^+\\A \rightarrow+\infty}} \sum_{n=1}^{+\infty} \int_{\delta}^{A} a_{n} x^{p} e^{-a_{n} x} dx 
\leq \lim _{\substack{\delta \rightarrow 0^+\\A \rightarrow+\infty}} \sum_{n=1}^{+\infty} \int_{0}^{+\infty} a_{n} x^{p} e^{-a_{n} x} dx \\
& = \sum_{n=1}^{+\infty} \int_{0}^{+\infty} a_{n} x^{p} e^{-a_{n} x} dx.
\end{align*}
因此，可以逐项积分。
$$\int_{0}^{+\infty} \sum_{n=1}^{+\infty} a_{n} x^{p} e^{-a_{n} x} dx
=\sum_{n=1}^{\infty} \int_{0}^{+\infty} a_{n} x^{p} e^{-a_{n} x} dx.\qedhere$$
\end{proofc}
\end{enumerate}

== 16春数学分析II期末（楼红卫）==
\begin{enumerate}[label=\Roman*.]
\item 填空题（每空格6分，共36分）
\begin{enumerate}[label=(\arabic*)]
    \item 设$\displaystyle f(x)=\int_x^1\frac{\sin t}{t}\,dt$，则$\displaystyle \int_0^1f(x)\,dx=\underline{\quad 1-\cos1 \quad}$。
    \item 使积分$\displaystyle \int_0^{+\infty}\frac{\sin\pi x}{x^a|x-1|^b}\,dx$收敛，参数$a,b$满足的条件为：$\underline{a<2,b<2,a+b>0}$。
    \item $\displaystyle \sum_{n=0}^\infty\frac{1}{(2n)!}$为$\underline{\quad \frac{e+e^{-1}}{2} \quad}$。
    \item 判断$\displaystyle \prod_{n=1}^\infty n\sin\frac{1}{n}$是收敛的还是发散的：$\underline{\quad 收敛 \quad}$。
    \item $\dfrac{x}{1-x^2}$的Maclaurin级数中$x^n$（$n$是非负整数）项的系数为：$\underline{\quad \frac{1-(-1)^n}{2} \quad}$。
    \item 函数序列$\displaystyle S_n(x)=n|\ln x|^\alpha\Big(\sin\frac{\pi x}{2}\Big)^n$在$x\in(0,1)$上一致收敛，
    则$\alpha\in\R$满足的条件是$\underline{\quad a>2 \quad}$。
\end{enumerate}
\item 解答题（共64分）
\end{enumerate}
\begin{enumerate}[label=\arabic*]\setcounter{enum-{list-level}}{1}
\item (15分) 计算积分：$\displaystyle \int_0^\pi \frac{x}{1+\sin^2x}\,dx$。

\item (15分) 求参数曲线段：$\begin{cases}x=t-\sin t,\\y=1-\cos t\end{cases}(0 \le t \le 2\pi)$
与$x$轴之间所围区域绕$x$轴旋转一周，所得旋转体的体积。

\item (10分) 证明$\R^n$中的紧集必是有界闭集。

\item (14分) 设$\displaystyle S(x)=\sum_{n=0}^\infty x^\frac{3}{2}\sqrt{n}e^{-nx}$，
求$S(x)$的定义域并讨论其连续性、可微性。

\item (10分) 求极限：$\lim\limits_{n\to\infty}\frac{\displaystyle \int_0^1\Big(1-\frac{x}{2}\Big)^n\Big(1-\frac{x}{4}\Big)^ndx}{\displaystyle \int_0^1\Big(1-\frac{x}{2}\Big)^ndx}$。
\end{enumerate}
[答案] \quad 2. $\dfrac{\sqrt{2}\pi^2}{4}$ \qquad 3. $5\pi^2$ \qquad 4. 略\\
\qquad\qquad 5. 在$[0,+\infty)$上有定义，在$(0,+\infty)$内连续可微，在$0$点不连续。
\begin{proofc}[6 的解答] 对于 $\alpha\in(0,1)$，我们有
\[\lim_{n \rightarrow+\infty} \frac{\displaystyle \int_0^1(1-\alpha x)^n dx}{\displaystyle \int_0^1\left(1-\frac{x}{2}\right)^n dx}
=\lim _{n \rightarrow+\infty} \frac{\displaystyle \frac{1}{\alpha(n+1)}\left(1-(1-\alpha)^{n+1}\right)}{\displaystyle \frac{2}{n+1}\left(1-\frac{1}{2^{n+1}}\right)}=\frac{1}{2\alpha}.\]
对于 $\varepsilon\in(0,1)$，注意到 $\displaystyle \Big(1-\frac{x}{2}\Big)\Big(1-\frac{x}{4}\Big)=1-\frac{3}{4}x+\frac{x^2}{8}$，我们有
\begin{align*}
& \quad\frac{\displaystyle \int_0^1\Big(1-\frac{3}{4} x\Big)^n d x}{\displaystyle \int_0^1\left(1-\frac{x}{2}\right)^n dx} 
\leq \frac{\displaystyle \int_0^1\left(1-\frac{x}{2}\right)^n\left(1-\frac{x}{4}\right)^n dx}{\displaystyle \int_0^1\left(1-\frac{x}{2}\right)^n dx} \\
& \leq \frac{\displaystyle \int_{\varepsilon}^1\left(1-\frac{x}{2}\right)^n\left(1-\frac{\varepsilon}{4}\right)^n dx}{\displaystyle \int_0^1\left(1-\frac{x}{2}\right)^n dx}
+\frac{\displaystyle \int_0^{\varepsilon}\left(1-\frac{3}{4} x+\frac{\varepsilon}{4} x\right)^n dx}{\displaystyle \int_0^1\left(1-\frac{x}{2}\right)^n dx} \\
& \leq \left(1-\frac{\varepsilon}{4}\right)^n+\frac{\displaystyle \int_0^1\left(1-\frac{3-\varepsilon}{4} x\right)^n dx}{\displaystyle \int_0^1\left(1-\frac{x}{2}\right)^n dx}.
\end{align*}
令 $n \rightarrow+\infty$ 得到
\begin{align*}
\frac{2}{3} & \leq \lim_{n \rightarrow+\infty} \frac{\displaystyle \int_0^1\left(1-\frac{x}{2}\right)^n\left(1-\frac{x}{4}\right)^n dx}{\displaystyle \int_0^1\left(1-\frac{x}{2}\right)^n dx} \\
& \leq \varlimsup_{n \rightarrow+\infty} \frac{\displaystyle \int_0^1\left(1-\frac{x}{2}\right)^n\left(1-\frac{x}{4}\right)^n dx}{\displaystyle \int_0^1\left(1-\frac{x}{2}\right)^n dx} \leq \frac{2}{3-\varepsilon}, \quad \forall\,\varepsilon\in(0,1),
\end{align*}
因此，$\lim\limits_{n \rightarrow \infty} \frac{\displaystyle \int_0^1\left(1-\frac{x}{2}\right)^n\left(1-\frac{x}{4}\right)^n dx}{\displaystyle \int_0^1\left(1-\frac{x}{2}\right)^n dx}=\dfrac{2}{3}$.\end{proofc}

