一、\ \ (多元函数微分部分)
\begin{enumerate}
\item (6分) 假设 $F \in C^1(\mathbb{R}^3)$, 并满足
$$y^{2014}\left(\frac{\partial F}{\partial x}\right)^2
+x^{2015}\left(\frac{\partial F}{\partial y}\right)^2
+\left(\frac{\partial F}{\partial z}\right)^{2016} \geq 1.$$
证明 $F$ 在 $\mathbb{R}^3$ 上无界。
\item (6分) 假设 $n \geq 2$, 求
$$f(x_1, \cdots, x_n)=\sum_{1 \leq i<j \leq n} x_i x_j$$
在紧集
$$D=\{(x_1, \cdots, x_n) ; x_i \geq 0, \forall 1 \leq i \leq n, \sum_{i=1}^n x_i \leq 1\}$$
上的最大值(需有推导过程)。
\item (1+2+7分) 用 $\mathcal{M}_{n, n}$ 表示 $n \times n$ 实矩阵全体。
若 $A=(a_{i j})_{1 \leq i, j \leq n} \in$ $\mathcal{M}_{n, n}$，定义
$$\|A\|=\max_{1 \leq i, j \leq n}|a_{i, j}|.$$
\item[\bullet] 证明 $\forall A \in \mathcal{M}_{n, n}, m \in \mathbb{N}^{+}$有 $\left\|A^m\right\| \leq n^{m-1}\|A\|^m$ 且
$$I_n+\sum_{m=1}^{+\infty} \frac{A^m}{m!}$$
收敛。上述极限记为 $e^A$。
\item[\bullet] 证明
$$f(A)=e^{A A^T}$$
在 $I_n$ 点可微，并求其微分(即给出 $df(I_n)(B), B \in \mathcal{M}_{n, n}$ 的确切表达式)。
\item (7分) 假设 $f \in C^1(\mathbb{R}^2)$, 且 $f(1,0)=f(-1,0)$。
证明对任意给定的 $b>0$, $\{(x, y) ; y \neq 0\}$ 中存在至少两个点使得
$$y \frac{\partial f}{\partial x}(x, y)=b x \frac{\partial f}{\partial y}(x, y).$$
\item (7分) 设 $U \subset \mathbb{R}^2$ 为开区域, 
函数 $f, g \in C^1(U)$, 且在 $U$ 内任意点处均有
$$\frac{\partial f}{\partial x} \frac{\partial g}{\partial y}
-\frac{\partial f}{\partial y} \frac{\partial g}{\partial x} \neq 0.$$
又设有界闭区域 $D \subset U$. 试证在 $D$ 中满足方程组
$$\begin{cases}f(x, y)=0, \\g(x, y)=0\end{cases}$$
的点至多有有限个。
\item (10分) 设 $f \in C(\mathbb{R}^n)$ $(n \geq 2)$, 
在点 $P=(a_1, \cdots, a_n)$ 附近可偏导, 
但其偏导数在 $P$ 点均不连续, 则 $f$ 在 $P$ 处不可微。
判断这个命题是否正确, 若正确, 请给出证明, 若不正确, 请举出反例。
\item (4+3+3分)
\item[\bullet] 设
$$f(t, x)=\sum_{i=0}^n a_i(t) x^i, \quad t, x \in \mathbb{R},$$
其中 $a_i \in C^1(-1,1)$。假设多项式 $f(0, x)$ 有 $n$ 个不同的实根 $\lambda_1<$ $\lambda_2<\cdots<\lambda_n$。
证明: 存在 $\epsilon>0$, 对于任意的 $t \in(-\epsilon, \epsilon)$, 
$f(t, x)$ 有 $n$ 个实根 $\lambda_1(t)<\lambda_2(t)<\cdots<\lambda_n(t)$，
且它们关于 $t$ 是连续可导的。
\item[\bullet] 设 $(a_{i j}(t))_{n \times n}, t \in(-1,1)$, 
为 $n \times n$ 的函数矩阵, 且 $a_{i j} \in C^1(-1,1)$。
若矩阵 $(a_{i j}(0))_{n \times n}$ 是对称阵，
即 $a_{i j}(0)=a_{j i}(0), \forall 1 \leq i, j \leq n$, 且其特征值各不相同, 
证明: 存在 $\epsilon>0$, 使得 $t \in(-\epsilon, \epsilon)$ 时, 
$(a_{i j}(t))_{n \times n}$ 的特征值各不相同, 
记为 $\lambda_1(t)<\lambda_2(t)<\cdots<\lambda_n(t)$, 
且 $\lambda_i(t)$ 关于 $t$ 是连续可导的。
\item[\bullet] 同上, 证明: 存在 $e_i(t), 1 \leq i \leq n$, 
是矩阵 $(a_{i j}(t))_{n \times n}$ 对应 $\lambda_i(t)$ 的归一化特征向量, 
即其长度为 $1$, 且 $e_i(t)$ 关于 $t$ 也是连续可导的。
\item (12分) 记 $B:=\left\{(x, y) \mid x^2+y^2<1\right\}$。
假设 $f \in C^2(B)$ 为有界正值函数，且满足
$$\frac{\partial^2 \ln f(x, y)}{\partial x^2}
+\frac{\partial^2 \ln f(x, y)}{\partial y^2} \geq f^2(x, y),$$
证明
$$f(x, y) \leq \frac{2}{1-x^2-y^2}.$$
[上传者注：本题来自于复分析中的超双曲度量，是说对单位圆盘$B$上共形于Euclid度量的Riemann度量，
曲率$K\le-1$意味着其小于等于双曲度量。
证明见Lars V. Ahlfors, \textit{Conformal Invariants: Topics in Geometric Function Theory}, 
American Mathematical Society, 2010, Lemma 1-1, p.13.]
\end{enumerate}
二、\ \ (重积分部分) 
\begin{enumerate}
\setcounter{enum-{list-level}}{8}
\item (5分) 如果一元函数 $f$ 在 $[1, \infty)$ 上广义黎曼可积，
则二元函数 $\tilde{f}$ (定义为 $\tilde{f}(x, y)=f(x)$) 在 $[1, \infty) \times[0,1]$ 上广义黎曼可积。
判断这个命题是否正确，若正确，请给出证明，若不正确，请举出反例。
\item (7分) 给出下述（广义）重积分存在的充要条件：
$$\int_{x^2+y^2+z^2 \leq 1} \frac{x}{\ln^\alpha(1+|x|+|y|+|z|)}\, dx dy dz, 
\qquad \alpha \in \mathbb{R}.$$
\item (4+3+3分)
\item[\bullet] 证明：对于任意单位列向量 $(a, b, c)^T \in \mathbb{R}^3$，
即 $a^2+b^2+c^2=1$，存在一个正交线性变换 $A$ (作为矩阵 $A A^T=I_3$)使得
$$A\begin{pmatrix}a \\b \\c\end{pmatrix}
=\begin{pmatrix}0 \\0 \\1\end{pmatrix}.$$
\item[\bullet] 给定 $a, b, c \in \mathbb{R}$ 满足 $a^2+b^2+c^2=1$, 计算
$$\int_{x^2+y^2+z^2 \leq 1}\left(e^{a x+b y+c z}+x y^2\right) dx dy dz.$$
\item (10分) 求证
$$\int_0^1 \int_0^1(xy)^{xy} dx dy=\int_0^1 y^y dy.$$
（约定 $0^0=1$.）
\item (10分) 计算
$$\iint\limits_{0<y<x<\pi} \ln \sin (x-y) dx dy.$$

\end{enumerate}